---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { idioma, idiomas, ruta, sinIdioma, textos } from '../i18n';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = sinIdioma(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {idiomas.map((i) => (
      <link rel="alternate" hreflang={i.codigo} href={new URL(ruta(i.codigo, base), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/HelveticaNeue-LightCond.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/HelveticaNeue-BoldCond.otf" as="font" type="font/otf" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={t.meta.locale} />
  </head>
  <body>
    <Header />
    <div class="tab" aria-hidden="true">
      {t.meta.pestana}
    </div>
    <main id="inicio" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Pestaña roja vertical: el elemento de navegación más reconocible del catálogo */
  .tab {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: var(--red);
    color: #fff;
    writing-mode: vertical-rl;
    rotate: 180deg;
    padding: 18px 7px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  @media (max-width: 760px) {
    .tab {
      display: none;
    }
  }
</style>
