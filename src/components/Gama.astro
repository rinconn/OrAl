---
import GamaFiltro from './GamaFiltro';
import { productos, totalModelos } from '../data/productos';
---

<section class="sec" id="gama">
  <div class="wrap">
    <h2>
      La gama completa, <b>siempre en stock</b>
    </h2>
    <p class="lead">
      {totalModelos} modelos en {productos.length} series, de la minicentrífuga personal a los equipos de suelo, con
      series propias para clínica e industria.
    </p>
    <GamaFiltro client:visible productos={productos} />
  </div>
</section>

<script>
  // Entrada suave del titular, los filtros y las fichas la primera vez que se ve la sección
  const seccion = document.getElementById('gama');
  if (seccion && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        if (entradas.some((e) => e.isIntersecting)) {
          seccion.classList.add('vista');
          obs.disconnect();
        }
      },
      { threshold: 0.12 },
    );
    obs.observe(seccion);
  }
</script>

<style>
  h2 {
    max-width: 19ch;
    font-size: var(--t-titulo);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.015em;
  }
  .lead {
    margin-top: 28px;
    max-width: 52ch;
    font-size: var(--t-sub);
    color: var(--body);
  }
  h2,
  .lead {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  .lead {
    transition-delay: 0.1s;
  }
  :global(.js) #gama:not(.vista) h2,
  :global(.js) #gama:not(.vista) .lead {
    opacity: 0;
    transform: translateY(24px);
  }
</style>
