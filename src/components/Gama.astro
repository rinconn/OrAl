---
import GamaFiltro from './GamaFiltro';
import { productos, totalModelos } from '../data/productos';
import { contacto } from '../data/navegacion';
---

<section class="sec" id="gama">
  <div class="wrap">
    <div class="head">
      <div>
        <span class="eyebrow">La gama</span>
        <h2>
          Una centrífuga para <b>cada laboratorio</b>
        </h2>
      </div>
      <p>
        {totalModelos} modelos en {productos.length} series, de la minicentrífuga personal a los equipos de suelo, y
        series propias para petróleo, lácteos, citología, plasma y veterinaria.
      </p>
    </div>
    <GamaFiltro client:visible productos={productos} contacto={contacto.href} />
    <p class="otros">También fabricamos destiladores, molino de bolas y tamizadora.</p>
    <p class="why">
      <b>Antes:</b> una rejilla plana con parte de la gama, y el configurador, la guía y la comparativa en tres sitios.{' '}
      <b>Ahora:</b> las 17 series del catálogo con su foto y sus cifras, filtradas por familia y por temperatura en un
      solo sitio.
    </p>
  </div>
</section>

<style>
  h2 {
    margin-top: 16px;
  }
  .otros {
    margin-top: 48px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 15px;
    color: var(--muted);
  }
</style>
