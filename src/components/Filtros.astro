---
// Barra de filtros del catálogo, en su sitio debajo del hero (no baja al hacer scroll): una línea con bordes marcados.
// Buscador con sugerencias (foto, nombre y aplicación de cada máquina que coincide), temperatura con su icono,
// aplicación en un desplegable con el número de productos de cada una, el total y "Borrar filtros". En móvil,
// buscador y botón de filtros, que abre un panel desde abajo. Sin JS no aparece y se ve todo el catálogo.
// Los filtros se guardan en la dirección para poder compartir una búsqueda.
import type { Temperatura } from '../data/productos';
import { idioma, numero, textos } from '../i18n';

interface Props {
  /** Aplicaciones por grupo: generales, especiales y otros productos */
  grupos: { nombre: string; cats: { v: string; nombre: string }[] }[];
  /** Tubos que admite alguna máquina, agrupados por tipo ("tipo|medidas") */
  tubos: { nombre: string; items: { v: string; nombre: string; medidas: string }[] }[];
}

const { grupos, tubos } = Astro.props;
const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const f = t.catalogo.filtros;
const m = f.minimos;
const temperaturas: Temperatura[] = ['ventilada', 'refrigerada', 'calefactada'];
const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const cruz = 'M6 6l12 12M18 6 6 18';
// Iconos dibujados para la temperatura: ventilador, copo de nieve y llama
const iconos: Record<Temperatura, string> = {
  ventilada:
    'M12 10.2c-.6-2.9.2-6.2 2.9-6.2 2.2 0 2.8 2.8.9 4.5-1 .9-2.3 1.4-3.8 1.7ZM13.6 12.9c2.8.9 5.3 3.3 4 5.6-1.1 1.9-3.8 1-4.4-1.5-.3-1.3-.2-2.7.4-4.1ZM10.4 12.9c-2.2 2-5.5 2.9-6.8.6-1.1-1.9 1-3.8 3.5-3.1 1.3.4 2.4 1.2 3.3 2.5ZM12 13.6a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2Z',
  refrigerada:
    'M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M9.6 4.6 12 7l2.4-2.4M9.6 19.4 12 17l2.4 2.4M3.9 10.8l3.3-.9-.9-3.3M20.1 13.2l-3.3.9.9 3.3M6.3 17.4l.9-3.3-3.3-.9M17.7 6.6l-.9 3.3 3.3.9',
  calefactada:
    'M12 21c-3.5 0-6-2.5-6-5.8 0-3.4 2.5-5 3.3-8.5.4 1.9 1.3 3 2.4 3.5.3-3 1.6-5.4 3.8-7.2-.3 3.2 4.5 5.6 4.5 11 0 4.3-3 7-8 7Zm0 0c-1.7 0-2.8-1.2-2.8-2.8 0-1.8 1.5-2.6 2.2-4.4.9 1 3.4 2.2 3.4 4.4 0 1.6-1.1 2.8-2.8 2.8Z',
};
---

<form
  class="filtros"
  id="filtros"
  role="search"
  aria-label={f.titulo}
  data-uno={f.resultados(1)}
  data-varios={f.resultados(999)}
  data-ver-uno={f.ver(1)}
  data-ver-varios={f.ver(999)}
  hidden
>
  <div class="wrap">
    <div class="barra">
      <!-- Buscador con sugerencias -->
      <div class="buscar">
        <svg class="lupa" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
          <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        </svg>
        <input
          type="search"
          name="q"
          placeholder={f.buscar}
          aria-label={f.buscar}
          autocomplete="off"
          enterkeyhint="search"
          role="combobox"
          aria-expanded="false"
          aria-controls="sugerencias"
          aria-autocomplete="list"
        />
        <ul class="sugerencias" id="sugerencias" role="listbox" aria-label={f.buscar}></ul>
      </div>

      <!-- Vista: tarjetas por familia o una tabla con todos los modelos, ordenable por columnas -->
      <div class="vista" role="group" aria-label={f.vista.titulo}>
        <button type="button" data-vista="" aria-pressed="true" aria-label={f.vista.tarjetas} title={f.vista.tarjetas}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M4 4h6.5v6.5H4zM13.5 4H20v6.5h-6.5zM4 13.5h6.5V20H4zM13.5 13.5H20V20h-6.5z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            ></path>
          </svg>
        </button>
        <button type="button" data-vista="tabla" aria-pressed="false" aria-label={f.vista.tabla} title={f.vista.tabla}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M4 5h16M4 10h16M4 15h16M4 20h16" fill="none" stroke="currentColor" stroke-width="1.6"></path>
          </svg>
        </button>
      </div>

      <button type="button" class="abrir-panel" aria-expanded="false" aria-controls="panel-filtros">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M4 7h16M7 12h10M10 17h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <span class="sr-movil">{f.boton}</span>
        <span class="activos" hidden></span>
      </button>

      <div class="panel" id="panel-filtros" aria-label={f.titulo}>
        <div class="panel-cab">
          <p>{f.titulo}</p>
          <button type="button" class="cerrar-panel" aria-label={f.cerrar}>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path d={cruz} stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>

        <!-- Temperatura: tres botones con icono -->
        <div class="temps" role="group" aria-label={f.temperatura}>
          <span class="etq-movil">{f.temperatura}</span>
          {temperaturas.map((x) => (
            <button type="button" class:list={['temp', x]} data-temp={x} aria-pressed="false">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path
                  d={iconos[x]}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {may(t.temperatura[x])}
            </button>
          ))}
        </div>

        <!-- Aplicación: desplegable con el número de productos de cada una -->
        <div class="aplic">
          <span class="etq-movil">{f.aplicacion}</span>
          <button type="button" class="aplic-btn" aria-expanded="false" aria-controls="aplic-menu" data-todas={f.todas}>
            <span class="aplic-txt">{f.todas}</span>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8"></path>
            </svg>
          </button>
          <div class="aplic-menu" id="aplic-menu">
            <button type="button" class="opcion" data-aplic="" aria-pressed="true">
              <span>{f.todas}</span>
              <span class="n"></span>
            </button>
            {grupos.map((g) => (
              <div class="opciones" role="group" aria-label={g.nombre}>
                <p class="grupo">{g.nombre}</p>
                {g.cats.map((c) => (
                  <button type="button" class="opcion" data-aplic={c.v} data-nombre={c.nombre} aria-pressed="false">
                    <span>{c.nombre}</span>
                    <span class="n" />
                  </button>
                ))}
              </div>
            ))}
          </div>
        </div>

        <!-- Tu tubo: deja solo las máquinas que lo admiten; cada tarjeta dice en qué rotor y cuántos caben. Un panel
             como el de aplicación: un título por tipo de tubo y debajo sus medidas -->
        <div class="tubo">
          <span class="etq-movil">{f.tubo}</span>
          <input type="hidden" name="tubo" value="" />
          <button
            type="button"
            class="tubo-btn"
            aria-expanded="false"
            aria-controls="tubo-menu"
            data-todos={f.cualquierTubo}
          >
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M9 3h6M10 3v14a2 2 0 0 0 4 0V3" fill="none" stroke="currentColor" stroke-width="1.7"></path>
            </svg>
            <span class="tubo-txt">{f.cualquierTubo}</span>
            <svg class="flechita" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8"></path>
            </svg>
          </button>
          <div class="tubo-menu" id="tubo-menu" aria-label={f.tubo}>
            <button type="button" class="t-op t-todos" data-tubo="" aria-pressed="true">
              {f.cualquierTubo}
            </button>
            <div class="t-grupos">
              {tubos.map((g) => (
                <div class="t-grupo" role="group" aria-label={g.nombre}>
                  <p class="grupo">{g.nombre}</p>
                  <div class="t-medidas">
                    {g.items.map((x) => (
                      <button
                        type="button"
                        class="t-op"
                        data-tubo={x.v}
                        data-nombre={x.nombre}
                        aria-label={x.nombre}
                        aria-pressed="false"
                      >
                        {x.medidas}
                      </button>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Mínimos: el laboratorio pide un requisito, no un modelo. Fuerza, velocidad y cuántos tubos de cuántos ml a
             la vez; queda la máquina que llega a todo con alguna de sus versiones -->
        <div class="minimos">
          <span class="etq-movil">{m.boton}</span>
          <button
            type="button"
            class="min-btn"
            aria-expanded="false"
            aria-controls="min-menu"
            data-todos={m.boton}
            data-tubos={m.tubos}
          >
            <span class="min-txt">{m.boton}</span>
            <svg class="flechita" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8"></path>
            </svg>
          </button>
          <div class="min-menu" id="min-menu" role="group" aria-label={m.boton}>
            <p class="min-ayuda">{m.ayuda}</p>
            <label class="min-fila">
              <span class="min-etq">{m.fuerza}</span>
              <span class="min-campos">
                <span class="ge" aria-hidden="true">
                  ≥
                </span>
                <input name="xg" inputmode="numeric" autocomplete="off" placeholder={numero(lang, '15.000')} />
                <span class="ud">xg</span>
              </span>
            </label>
            <label class="min-fila">
              <span class="min-etq">{m.velocidad}</span>
              <span class="min-campos">
                <span class="ge" aria-hidden="true">
                  ≥
                </span>
                <input name="rpm" inputmode="numeric" autocomplete="off" placeholder={numero(lang, '10.000')} />
                <span class="ud">rpm</span>
              </span>
            </label>
            <div class="min-fila" role="group" aria-label={m.capacidad}>
              <span class="min-etq">{m.capacidad}</span>
              <span class="min-campos">
                <span class="ge" aria-hidden="true">
                  ≥
                </span>
                <input name="n" inputmode="numeric" autocomplete="off" placeholder="4" aria-label={m.tubos} />
                <span class="ud">
                  {m.tubos} {m.de}
                </span>
                <input
                  name="ml"
                  inputmode="decimal"
                  autocomplete="off"
                  placeholder="250"
                  aria-label={`${m.capacidad} (ml)`}
                />
                <span class="ud">ml</span>
              </span>
            </div>
            <button type="button" class="min-quitar">
              {m.quitar}
            </button>
          </div>
        </div>

        <!-- Ordenar: dentro de cada familia, por la cifra que se elija (de mayor a menor) -->
        <label class="orden">
          <span class="etq-movil">{f.ordenar}</span>
          <select name="o" aria-label={f.ordenar}>
            <option value="">{f.orden.catalogo}</option>
            <option value="cap">{f.orden.capacidad}</option>
            <option value="rpm">{f.orden.velocidad}</option>
            <option value="xg">{f.orden.fuerza}</option>
          </select>
        </label>

        <button type="button" class="ver-res"></button>
      </div>

      <div class="fin">
        <p class="cuenta" aria-live="polite"></p>
        <button type="button" class="limpiar borrar" hidden>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d={cruz} stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
          </svg>
          <span>{f.limpiar}</span>
        </button>
      </div>
    </div>
  </div>
  <div class="velo" aria-hidden="true"></div>
</form>

<script>
  const form = document.getElementById('filtros') as HTMLFormElement | null;
  const salasEl = document.getElementById('salas');
  if (form && salasEl) {
    form.hidden = false;
    const d = form.dataset;
    const cuenta = (n: number, uno: string, varios: string) => (n === 1 ? uno : varios.replace('999', String(n)));
    const fichas = [...salasEl.querySelectorAll<HTMLElement>('.ficha')];
    const salas = [...salasEl.querySelectorAll<HTMLElement>('.sala')];
    const de = (s: HTMLElement) => (el: HTMLElement) => s.contains(el);
    const vacio = salasEl.querySelector<HTMLElement>('.vacio');
    const temps = [...form.querySelectorAll<HTMLButtonElement>('.temp')];
    const opciones = [...form.querySelectorAll<HTMLButtonElement>('.opcion')];
    const aplicBtn = form.querySelector<HTMLButtonElement>('.aplic-btn')!;
    const aplicTxt = form.querySelector<HTMLElement>('.aplic-txt')!;
    const q = form.querySelector<HTMLInputElement>('input[name=q]')!;
    const sug = form.querySelector<HTMLUListElement>('.sugerencias')!;
    const cuentaEl = form.querySelector<HTMLElement>('.cuenta')!;
    const borrar = form.querySelector<HTMLElement>('.borrar')!;
    const activos = form.querySelector<HTMLElement>('.activos')!;
    const verRes = form.querySelector<HTMLButtonElement>('.ver-res')!;
    const quieto = matchMedia('(prefers-reduced-motion: reduce)');
    const movil = matchMedia('(max-width: 1024px)');
    const curva = 'cubic-bezier(0.23, 1, 0.32, 1)';

    let aplic = '';
    const elegidas = new Set<string>();
    const plano = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
    const casaTexto = (el: HTMLElement) => {
      const texto = plano(q.value);
      return !texto || texto.split(/\s+/).every((p) => (el.dataset.texto ?? '').includes(p));
    };
    // Tubo elegido: la tarjeta vale si alguna de sus versiones lo admite (datos que pone la página)
    const selTubo = form.querySelector<HTMLInputElement>('input[name=tubo]')!;
    const tuboBtn = form.querySelector<HTMLButtonElement>('.tubo-btn')!;
    const tuboTxt = form.querySelector<HTMLElement>('.tubo-txt')!;
    const opsTubo = [...form.querySelectorAll<HTMLButtonElement>('.t-op')];
    const datosTubos = JSON.parse(document.getElementById('datos-tubos')?.textContent ?? '{}') as {
      modelos?: Record<string, Record<string, unknown>>;
      cifras?: Record<string, { rpm: number; xg: number; cap: [number, number][] }>;
    };
    const tubosModelo = datosTubos.modelos ?? {};
    const admite = (el: HTMLElement) =>
      !selTubo.value || (el.dataset.slugs ?? '').split(' ').some((x) => tubosModelo[x]?.[selTubo.value]);
    // Mínimos: lo escrito en cada campo, solo la cifra ("15.000" o "15 000" son 15000; los ml admiten decimales)
    const camposMin = [...form.querySelectorAll<HTMLInputElement>('.min-menu input')];
    const campo = (k: string) => camposMin.find((x) => x.name === k)!;
    const leer = (k: string) => {
      const v = campo(k).value.trim();
      return k === 'ml' ? Number(v.replace(/[^\d.,]/g, '').replace(',', '.')) || 0 : Number(v.replace(/\D/g, '')) || 0;
    };
    const minBtn = form.querySelector<HTMLButtonElement>('.min-btn')!;
    const minTxt = form.querySelector<HTMLElement>('.min-txt')!;
    const hayMin = () => camposMin.some((x) => leer(x.name) > 0);
    // Una versión vale si llega a todos; la capacidad, en un mismo rotor: al menos n tubos de al menos esos ml
    const llega = (slug: string) => {
      const c = datosTubos.cifras?.[slug];
      if (!c) return false;
      const [xg, rpm, n, ml] = ['xg', 'rpm', 'n', 'ml'].map(leer);
      return c.xg >= xg && c.rpm >= rpm && (!n && !ml ? true : c.cap.some(([cn, cml]) => cn >= n && cml >= ml));
    };
    const alcanza = (el: HTMLElement) => !hayMin() || (el.dataset.slugs ?? '').split(' ').some(llega);
    const cumple = (el: HTMLElement, c = aplic, ts: Set<string> = elegidas) =>
      (!c || el.dataset.cat === c) &&
      (!ts.size || (el.dataset.t ?? '').split(' ').some((x) => ts.has(x))) &&
      admite(el) &&
      alcanza(el) &&
      casaTexto(el);

    // ——— Sugerencias del buscador: foto, nombre y aplicación de cada máquina que coincide ———
    const datos = fichas.map((el) => ({
      el,
      nombre: el.querySelector('.nombre')?.textContent?.trim() ?? '',
      uso: el.querySelector('.uso')?.textContent?.trim() ?? '',
      img: el.querySelector<HTMLImageElement>('.foto img')?.getAttribute('src') ?? '',
      href: el.querySelector<HTMLAnchorElement>('a.pieza')?.getAttribute('href') ?? '#',
    }));
    let marcada = -1;
    const cerrarSug = () => {
      sug.classList.remove('abierta');
      q.setAttribute('aria-expanded', 'false');
      q.removeAttribute('aria-activedescendant');
      marcada = -1;
    };
    const marcar = (i: number) => {
      const items = [...sug.querySelectorAll<HTMLElement>('[role=option]')];
      if (!items.length) return;
      marcada = (i + items.length) % items.length;
      items.forEach((it, j) => it.setAttribute('aria-selected', String(j === marcada)));
      q.setAttribute('aria-activedescendant', items[marcada].id);
      items[marcada].scrollIntoView({ block: 'nearest' });
    };
    const pintarSug = () => {
      const texto = plano(q.value);
      if (!texto) return cerrarSug();
      const hay = datos.filter((x) => casaTexto(x.el)).slice(0, 6);
      const partes = texto.split(/\s+/);
      sug.replaceChildren(
        ...hay.map((x, i) => {
          const li = document.createElement('li');
          li.id = `sug-${i}`;
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', 'false');
          const a = document.createElement('a');
          a.href = x.href;
          a.tabIndex = -1;
          const img = document.createElement('img');
          img.src = x.img;
          img.alt = '';
          const txt = document.createElement('span');
          const b = document.createElement('b');
          // Resalta en rojo lo escrito dentro del nombre
          const n = plano(x.nombre);
          const p = partes.find((s) => n.includes(s));
          if (p) {
            const k = n.indexOf(p);
            const m = document.createElement('mark');
            m.textContent = x.nombre.slice(k, k + p.length);
            b.append(x.nombre.slice(0, k), m, x.nombre.slice(k + p.length));
          } else b.textContent = x.nombre;
          const small = document.createElement('small');
          small.textContent = x.uso;
          txt.append(b, small);
          const flecha = document.createElement('i');
          flecha.textContent = '»';
          a.append(img, txt, flecha);
          li.append(a);
          return li;
        }),
      );
      if (!hay.length) {
        const li = document.createElement('li');
        li.className = 'nada';
        li.textContent = salasEl.querySelector('.vacio p')?.textContent ?? '';
        sug.append(li);
      }
      sug.classList.add('abierta');
      q.setAttribute('aria-expanded', 'true');
      marcada = -1;
    };
    q.addEventListener('keydown', (e) => {
      if (!sug.classList.contains('abierta')) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        marcar(marcada + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        marcar(marcada - 1);
      } else if (e.key === 'Escape') cerrarSug();
      else if (e.key === 'Enter' && marcada >= 0) {
        e.preventDefault();
        sug.querySelectorAll('a')[marcada]?.click();
      }
    });
    q.addEventListener('focus', pintarSug);
    q.addEventListener('blur', () => setTimeout(cerrarSug, 150));

    // ——— Aplicar los filtros ———
    const moviles = () => [...fichas, ...salas.map((s) => s.querySelector<HTMLElement>('.sala-cab')!)];
    // Orden: el del catálogo (guardado al cargar) o de mayor a menor por capacidad, velocidad o fuerza
    const orden = form.querySelector<HTMLSelectElement>('select[name=o]')!;
    fichas.forEach((el, i) => (el.dataset.orden = String(i)));
    // Tabla: una fila por modelo, con los mismos datos que las tarjetas. Desde sus columnas se ordena de mayor a menor
    // y, pulsando otra vez, de menor a mayor; lo que no tiene la cifra (capacidad sin ml) va siempre al final
    const tabla = salasEl.querySelector<HTMLElement>('.tabla-vista');
    const filas = [...(tabla?.querySelectorAll<HTMLElement>('tbody tr') ?? [])];
    filas.forEach((el, i) => (el.dataset.orden = String(i)));
    const cabs = [...(tabla?.querySelectorAll<HTMLButtonElement>('th button[data-o]') ?? [])];
    let asc = false;
    const ordenar = (els: HTMLElement[]) => {
      const k = orden.value;
      return els.sort((a, b) => {
        if (!k) return Number(a.dataset.orden) - Number(b.dataset.orden);
        const [x, y] = [Number(a.dataset[k] ?? 0), Number(b.dataset[k] ?? 0)];
        if (!x || !y) return y - x;
        return asc ? x - y : y - x;
      });
    };
    const reordenar = () => {
      for (const ul of salasEl.querySelectorAll<HTMLElement>('.piezas'))
        ul.append(...ordenar([...ul.querySelectorAll<HTMLElement>(':scope > .ficha')]));
      tabla?.querySelector('tbody')?.append(...ordenar([...filas]));
      for (const b of cabs) {
        const on = b.dataset.o === orden.value;
        b.closest('th')!.setAttribute('aria-sort', on ? (asc ? 'ascending' : 'descending') : 'none');
      }
      // Encima de la tabla, en palabras, qué orden se ve; la columna elegida se marca en rojo
      if (!tabla) return;
      tabla.dataset.o = orden.value;
      const cab = cabs.find((b) => b.dataset.o === orden.value);
      const nombre = cab?.firstChild?.textContent?.trim().toLowerCase() ?? '';
      const ds = estado!.dataset;
      const plantilla = asc ? ds.menor! : ds.mayor!;
      const k = plantilla.indexOf('{x}');
      if (cab)
        estado!.replaceChildren(
          plantilla.slice(0, k),
          Object.assign(document.createElement('b'), { textContent: nombre }),
          plantilla.slice(k + 3),
        );
      else estado!.textContent = ds.catalogo!;
      invertir!.hidden = !cab;
    };
    const estado = tabla?.querySelector<HTMLElement>('.tabla-estado p');
    const invertir = tabla?.querySelector<HTMLButtonElement>('.invertir');
    invertir?.addEventListener('click', () => {
      asc = !asc;
      aplicar(false);
    });
    // Vista elegida: tarjetas (por defecto) o tabla
    const vistas = [...form.querySelectorAll<HTMLButtonElement>('.vista button')];
    let vista = '';
    const enTabla = () => vista === 'tabla' && !!tabla;

    const aplicar = (animar = true) => {
      animar &&= !quieto.matches;
      const antes = new Map<HTMLElement, DOMRect>();
      if (animar) for (const el of moviles()) if (el.offsetParent) antes.set(el, el.getBoundingClientRect());
      reordenar();

      salasEl.closest('.catalogo')?.classList.toggle('en-tabla', enTabla());
      for (const b of vistas) b.setAttribute('aria-pressed', String((b.dataset.vista ?? '') === vista));
      const filasVis = filas.filter((el) => cumple(el));
      for (const el of filas) el.hidden = !filasVis.includes(el);
      const visibles = fichas.filter((el) => cumple(el));
      for (const el of fichas) el.hidden = !visibles.includes(el);
      // En la tabla, el total cuenta modelos; en las tarjetas, fichas
      const total = enTabla() ? filasVis.length : visibles.length;
      for (const s of salas) {
        const n = visibles.filter(de(s)).length;
        s.hidden = n === 0;
        s.querySelector('.sala-n')!.textContent = cuenta(n, d.uno!, d.varios!);
      }

      for (const b of temps) {
        const v = b.dataset.temp!;
        const on = elegidas.has(v);
        b.setAttribute('aria-pressed', String(on));
        b.disabled = !on && !fichas.some((el) => cumple(el, aplic, new Set([v])));
      }
      for (const b of opciones) {
        const v = b.dataset.aplic!;
        const n = fichas.filter((el) => cumple(el, v)).length;
        const on = aplic === v;
        b.setAttribute('aria-pressed', String(on));
        b.querySelector('.n')!.textContent = String(n);
        b.disabled = n === 0 && !on;
      }
      // Tubos: el elegido, marcado; los que no dejarían ninguna máquina con los demás filtros, apagados
      for (const b of opsTubo) {
        const v = b.dataset.tubo!;
        const on = selTubo.value === v;
        b.setAttribute('aria-pressed', String(on));
        if (v) {
          const antes = selTubo.value;
          selTubo.value = v;
          b.disabled = !on && !fichas.some((el) => cumple(el));
          selTubo.value = antes;
        }
      }
      const tuboElegido = opsTubo.find((b) => b.dataset.tubo && b.dataset.tubo === selTubo.value);
      tuboTxt.textContent = tuboElegido ? tuboElegido.dataset.nombre! : tuboBtn.dataset.todos!;
      tuboBtn.classList.toggle('on', !!tuboElegido);

      // Mínimos: el botón enseña el primero y cuántos más ("≥ 15.000 xg +1"); el resumen entero, al pasar por encima
      const resumen = [
        leer('xg') && `≥ ${campo('xg').value.trim()} xg`,
        leer('rpm') && `≥ ${campo('rpm').value.trim()} rpm`,
        (leer('n') || leer('ml')) &&
          `≥ ${[leer('n') && `${leer('n')}${leer('ml') ? '' : ` ${minBtn.dataset.tubos}`}`, leer('ml') && `${campo('ml').value.trim()} ml`].filter(Boolean).join(' × ')}`,
      ].filter(Boolean) as string[];
      minTxt.textContent = resumen.length
        ? resumen[0] + (resumen.length > 1 ? ` +${resumen.length - 1}` : '')
        : minBtn.dataset.todos!;
      minBtn.title = resumen.join(' · ');
      minBtn.classList.toggle('on', resumen.length > 0);

      const elegida = aplic ? opciones.find((b) => b.dataset.aplic === aplic) : undefined;
      aplicTxt.textContent = elegida ? elegida.dataset.nombre! : aplicBtn.dataset.todas!;
      aplicBtn.classList.toggle('on', !!elegida);

      const nActivos = (aplic ? 1 : 0) + elegidas.size + (selTubo.value ? 1 : 0) + (hayMin() ? 1 : 0);
      activos.hidden = nActivos === 0;
      activos.textContent = String(nActivos);
      borrar.hidden = nActivos === 0 && !q.value.trim();
      const txt = cuenta(total, d.uno!, d.varios!);
      const num = String(total);
      const i = txt.indexOf(num);
      cuentaEl.replaceChildren(
        txt.slice(0, i),
        Object.assign(document.createElement('b'), { textContent: num }),
        txt.slice(i + num.length),
      );
      verRes.textContent = cuenta(total, d.verUno!, d.verVarios!);
      if (vacio) vacio.hidden = total > 0;
      // Los atajos a cada familia, con lo que queda en ella
      for (const s of salas) {
        const a = document.querySelector<HTMLElement>(`.atajos [data-ir="${s.dataset.sala}"]`);
        if (!a) continue;
        a.hidden = s.hidden;
        a.querySelector('.n')!.textContent = String(visibles.filter(de(s)).length);
      }
      // Lo puesto, en palabras, para la cabecera de lo que se descarga (tabla en PDF o Excel)
      salasEl.dataset.resumen = JSON.stringify(
        [
          q.value.trim() && `"${q.value.trim()}"`,
          elegida?.dataset.nombre,
          ...temps.filter((b) => elegidas.has(b.dataset.temp!)).map((b) => b.textContent!.trim()),
          tuboElegido?.dataset.nombre,
          ...resumen,
        ].filter(Boolean),
      );
      // Cada tarjeta con versiones enseña la que cumple la temperatura elegida
      document.dispatchEvent(
        new CustomEvent('catalogo:filtrado', {
          detail: {
            temps: [...elegidas],
            tubo: selTubo.value,
            validos: hayMin() ? Object.keys(datosTubos.cifras ?? {}).filter(llega) : undefined,
          },
        }),
      );

      if (animar) {
        const alto = window.innerHeight;
        let nuevas = 0;
        for (const el of moviles()) {
          if (!el.offsetParent) continue;
          const r = el.getBoundingClientRect();
          const a = antes.get(el);
          if (!a) {
            if (r.bottom < 0 || r.top > alto) continue;
            el.animate(
              [
                { opacity: 0, transform: 'translateY(12px) scale(0.97)' },
                { opacity: 1, transform: 'none' },
              ],
              { duration: 360, delay: Math.min(nuevas++, 6) * 40, easing: curva, fill: 'backwards' },
            );
          } else {
            const dx = a.left - r.left;
            const dy = a.top - r.top;
            if ((!dx && !dy) || (Math.max(a.bottom, r.bottom) < 0 && Math.min(a.top, r.top) > alto)) continue;
            el.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], {
              duration: 460,
              easing: curva,
            });
          }
        }
      }

      const url = new URL(location.href);
      const poner = (k: string, v: string) => (v ? url.searchParams.set(k, v) : url.searchParams.delete(k));
      poner('c', aplic);
      poner('t', [...elegidas].join(','));
      poner('q', q.value.trim());
      poner('o', orden.value);
      poner('dir', orden.value && asc ? 'asc' : '');
      poner('v', vista);
      poner('tubo', selTubo.value);
      for (const x of camposMin) poner(x.name, leer(x.name) ? String(leer(x.name)) : '');
      history.replaceState(null, '', url);
    };

    // Estado inicial desde la dirección; si se llega a una ficha concreta (lupa, Tecnología), se ve todo
    const url = new URL(location.href);
    const aFicha = location.hash && document.getElementById(location.hash.slice(1))?.classList.contains('ficha');
    if (!aFicha) {
      const c = url.searchParams.get('c') ?? '';
      if (c && opciones.some((b) => b.dataset.aplic === c)) aplic = c;
      for (const v of url.searchParams.get('t')?.split(',') ?? [])
        if (temps.some((b) => b.dataset.temp === v)) elegidas.add(v);
      q.value = url.searchParams.get('q') ?? '';
      const o = url.searchParams.get('o') ?? '';
      if ([...orden.options].some((x) => x.value === o)) orden.value = o;
      asc = url.searchParams.get('dir') === 'asc';
      if (url.searchParams.get('v') === 'tabla') vista = 'tabla';
      const tu = url.searchParams.get('tubo') ?? '';
      if (tu && opsTubo.some((x) => x.dataset.tubo === tu)) selTubo.value = tu;
      for (const x of camposMin) x.value = url.searchParams.get(x.name) ?? '';
    }

    // ——— Desplegable de aplicación ———
    const menuAbierto = () => aplicBtn.getAttribute('aria-expanded') === 'true';
    const cerrarMenu = () => aplicBtn.setAttribute('aria-expanded', 'false');
    aplicBtn.addEventListener('click', () => {
      cerrarTubos();
      cerrarMin();
      aplicBtn.setAttribute('aria-expanded', String(!menuAbierto()));
    });
    // ——— Panel de tubos ———
    const tubosAbierto = () => tuboBtn.getAttribute('aria-expanded') === 'true';
    const cerrarTubos = () => tuboBtn.setAttribute('aria-expanded', 'false');
    tuboBtn.addEventListener('click', () => {
      cerrarMenu();
      cerrarMin();
      tuboBtn.setAttribute('aria-expanded', String(!tubosAbierto()));
    });
    // ——— Panel de mínimos: se filtra mientras se escribe; Intro o Esc lo cierran ———
    const minAbierto = () => minBtn.getAttribute('aria-expanded') === 'true';
    const cerrarMin = () => minBtn.setAttribute('aria-expanded', 'false');
    minBtn.addEventListener('click', () => {
      cerrarMenu();
      cerrarTubos();
      minBtn.setAttribute('aria-expanded', String(!minAbierto()));
      if (minAbierto() && !movil.matches) camposMin[0].focus();
    });
    let esperaMin = 0;
    // Al salir del campo, la cifra con su separador de miles (15000 → 15.000)
    const miles = new Intl.NumberFormat(document.documentElement.lang || 'es');
    const formatear = (x: HTMLInputElement) => {
      if (x.name !== 'ml' && leer(x.name)) x.value = miles.format(leer(x.name));
    };
    for (const x of camposMin) {
      formatear(x);
      x.addEventListener('blur', () => {
        formatear(x);
        aplicar(false);
      });
      x.addEventListener('input', () => {
        clearTimeout(esperaMin);
        esperaMin = window.setTimeout(aplicar, 200);
      });
      x.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        clearTimeout(esperaMin);
        aplicar();
        if (movil.matches) return;
        cerrarMin();
        minBtn.focus();
      });
    }
    form.querySelector('.min-quitar')!.addEventListener('click', () => {
      for (const x of camposMin) x.value = '';
      aplicar();
      if (!movil.matches) camposMin[0].focus();
    });
    for (const b of opsTubo) {
      b.addEventListener('click', () => {
        selTubo.value = b.dataset.tubo!;
        cerrarTubos();
        aplicar();
        if (!movil.matches) tuboBtn.focus();
      });
    }
    document.addEventListener('click', (e) => {
      const el = e.target as Element;
      if (menuAbierto() && !el.closest('.aplic')) cerrarMenu();
      if (tubosAbierto() && !el.closest('.tubo')) cerrarTubos();
      if (minAbierto() && !el.closest('.minimos')) cerrarMin();
      if (!el.closest('.buscar')) cerrarSug();
    });
    for (const b of opciones) {
      b.addEventListener('click', () => {
        aplic = b.dataset.aplic!;
        cerrarMenu();
        aplicar();
        if (!movil.matches) aplicBtn.focus();
      });
    }
    for (const b of temps) {
      b.addEventListener('click', () => {
        const v = b.dataset.temp!;
        if (elegidas.has(v)) elegidas.delete(v);
        else elegidas.add(v);
        aplicar();
      });
    }
    let espera = 0;
    q.addEventListener('input', () => {
      pintarSug();
      clearTimeout(espera);
      espera = window.setTimeout(aplicar, 140);
    });
    orden.addEventListener('change', () => {
      asc = false;
      aplicar();
    });
    for (const b of cabs) {
      b.addEventListener('click', () => {
        asc = orden.value === b.dataset.o ? !asc : false;
        orden.value = b.dataset.o!;
        aplicar(false);
      });
    }
    for (const b of vistas) {
      b.addEventListener('click', () => {
        vista = b.dataset.vista ?? '';
        aplicar(false);
      });
    }
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      cerrarSug();
      q.blur();
    });
    for (const b of document.querySelectorAll<HTMLButtonElement>('.limpiar')) {
      b.addEventListener('click', () => {
        aplic = '';
        elegidas.clear();
        q.value = '';
        orden.value = '';
        asc = false;
        selTubo.value = '';
        for (const x of camposMin) x.value = '';
        aplicar();
      });
    }

    // ——— Móvil: los filtros suben en un panel desde abajo ———
    const abrirPanel = form.querySelector<HTMLButtonElement>('.abrir-panel')!;
    const panel = form.querySelector<HTMLElement>('.panel')!;
    const panelAbierto = () => form.classList.contains('abierto');
    const cerrar = () => {
      if (!panelAbierto()) return;
      form.classList.remove('abierto');
      panel.removeAttribute('role');
      panel.removeAttribute('aria-modal');
      abrirPanel.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      abrirPanel.focus();
    };
    abrirPanel.addEventListener('click', () => {
      form.classList.add('abierto');
      panel.setAttribute('role', 'dialog');
      panel.setAttribute('aria-modal', 'true');
      abrirPanel.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      temps[0].focus();
    });
    form.querySelector('.cerrar-panel')!.addEventListener('click', cerrar);
    form.querySelector('.velo')!.addEventListener('click', cerrar);
    verRes.addEventListener('click', cerrar);
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (menuAbierto()) {
        cerrarMenu();
        aplicBtn.focus();
      } else if (tubosAbierto()) {
        cerrarTubos();
        tuboBtn.focus();
      } else if (minAbierto() && !movil.matches) {
        cerrarMin();
        minBtn.focus();
      } else cerrar();
    });
    panel.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !panelAbierto()) return;
      const focos = [...panel.querySelectorAll<HTMLButtonElement>('button')].filter(
        (el) => el.offsetParent && !el.disabled,
      );
      const [primero, ultimo] = [focos[0], focos[focos.length - 1]];
      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primero.focus();
      }
    });
    movil.addEventListener('change', (e) => !e.matches && cerrar());

    aplicar(false);
  }
</script>

<style>
  .filtros {
    --alto: 56px;
    --borde: #c9c9c9;
    position: relative;
    z-index: 20;
    margin-top: clamp(48px, 6vw, 88px);
  }

  /* ——— La barra: blanca con contorno fino y la raya roja arriba; los controles, con borde gris claro y lo elegido en gris muy claro con borde oscuro ——— */
  .barra {
    --osc: #d2d5d8;
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px;
    flex-wrap: wrap;
    background: #fff;
    border: 1px solid var(--line);
    border-top: 3px solid var(--red);
    box-shadow: 0 30px 60px -44px rgba(17, 19, 21, 0.35);
  }

  /* Buscador */
  .buscar {
    position: relative;
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    align-items: center;
    height: var(--alto);
    padding: 0 16px;
    background: #fff;
    border: 1px solid var(--osc);
    color: var(--muted);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .buscar:focus-within {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
    color: var(--ink);
  }
  .lupa {
    flex: none;
    margin-right: 12px;
  }
  .buscar input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: none;
    font: 400 19px var(--f);
    color: var(--ink);
  }
  .buscar input::placeholder {
    color: var(--muted);
  }

  /* Sugerencias: debajo del buscador, con foto y aplicación */
  .sugerencias {
    position: absolute;
    top: calc(100% + 6px);
    left: -1px;
    right: -1px;
    z-index: 5;
    max-height: 430px;
    overflow-y: auto;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: #fff;
    border: 1px solid var(--ink);
    box-shadow: 0 24px 50px -20px rgba(17, 19, 21, 0.35);
    opacity: 0;
    translate: 0 -6px;
    visibility: hidden;
    transition:
      opacity 0.18s ease,
      translate 0.25s cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s 0.25s;
  }
  .sugerencias.abierta {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
    transition:
      opacity 0.18s ease,
      translate 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .sugerencias :global(li + li) {
    border-top: 1px solid #efefef;
  }
  .sugerencias :global(a) {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 6px 12px 6px 6px;
    color: var(--ink);
    text-decoration: none;
  }
  .sugerencias :global(img) {
    width: 52px;
    height: 52px;
    object-fit: contain;
    background: #f1f1f1;
  }
  .sugerencias :global(span) {
    display: grid;
    gap: 2px;
  }
  .sugerencias :global(b) {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.1;
  }
  .sugerencias :global(mark) {
    background: none;
    color: var(--red);
  }
  .sugerencias :global(small) {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sugerencias :global(i) {
    font-style: normal;
    font-size: 20px;
    color: var(--red);
    opacity: 0;
    translate: -6px 0;
    transition:
      opacity 0.2s ease,
      translate 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .sugerencias :global([aria-selected='true'] a),
  .sugerencias :global(a:hover) {
    background: #f4f4f4;
  }
  .sugerencias :global([aria-selected='true'] i),
  .sugerencias :global(a:hover i) {
    opacity: 1;
    translate: 0 0;
  }
  .sugerencias :global(.nada) {
    padding: 14px 12px;
    font-size: 16px;
    color: var(--muted);
  }

  /* Temperatura y aplicación */
  /* Dos filas: arriba el buscador con el total y Borrar filtros; debajo, todos los filtros */
  .panel {
    order: 3;
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .panel-cab,
  .ver-res,
  .abrir-panel,
  .velo,
  .etq-movil {
    display: none;
  }
  .temps {
    display: flex;
    height: var(--alto);
  }
  .temp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    border: 1px solid var(--osc);
    background: none;
    font: 400 17px var(--f);
    color: var(--body);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
  }
  .temp + .temp {
    margin-left: -1px;
  }
  .temp svg {
    color: var(--tc);
    transition:
      color 0.2s ease,
      transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .ventilada {
    --tc: #6f7a81;
  }
  .refrigerada {
    --tc: #2a7fc4;
  }
  .calefactada {
    --tc: var(--red);
  }
  /* Elegida: gris muy claro con borde oscuro y la raya de su color debajo */
  .temp[aria-pressed='true'] {
    position: relative;
    z-index: 1;
    background: var(--panel);
    border-color: var(--ink);
    color: var(--ink);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--tc);
  }
  .temp:disabled {
    color: #b4b8bb;
    cursor: default;
  }
  .temp:disabled svg {
    opacity: 0.4;
  }

  .aplic {
    position: relative;
  }
  .aplic-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: var(--alto);
    padding: 0 16px;
    border: 1px solid var(--osc);
    background: none;
    font: 400 17px var(--f);
    color: var(--ink);
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .aplic-btn svg {
    transition: rotate 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .aplic-btn[aria-expanded='true'] {
    border-color: var(--ink);
  }
  .aplic-btn[aria-expanded='true'] svg {
    rotate: 180deg;
  }
  .aplic-btn.on {
    background: var(--panel);
    border-color: var(--ink);
    color: var(--ink);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--red);
  }
  .orden select {
    height: var(--alto);
    padding: 0 40px 0 16px;
    border: 1px solid var(--osc);
