---
// Cifras reales y comprobables (catálogo 2025 y web actual). Sin contadores animados.
const cifras = [
  { valor: '1949', texto: 'fabricando centrífugas' },
  { valor: '48 h', texto: 'respuesta y asesoramiento' },
  { valor: '1 semana', texto: 'plazo medio de entrega' },
  { valor: '3 años', texto: 'de garantía, sin sorpresas' },
  { valor: 'ISO 13485', texto: '9001 · 14001 · IVDR' },
];
---

<div class="proof">
  <div class="wrap grid">
    {
      cifras.map((c) => (
        <div>
          <strong>{c.valor}</strong>
          <span>{c.texto}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .proof {
    border-block: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .grid div {
    padding: 22px 18px;
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .grid div:first-child {
    border-left: 0;
    padding-left: 0;
  }
  strong {
    font-size: clamp(26px, 2.6vw, 36px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  span {
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid div {
      padding: 18px 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .grid div:nth-child(-n + 2) {
      border-top: 0;
    }
    .grid div:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
