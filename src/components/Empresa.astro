---
// Todo sale del Catálogo General 2025: la frase, la historia, la empresa familiar, la fábrica y las normas
const pompas = [
  {
    cifra: '1949',
    titulo: 'Fabricantes de centrífugas',
    texto: 'Más de 75 años después, somos referente entre los fabricantes europeos.',
  },
  {
    cifra: 'Familiar',
    titulo: 'Una empresa de familia',
    texto: 'Buscamos integrar a nuestros socios, usuarios y asociados.',
  },
  {
    cifra: 'Daganzo',
    titulo: 'Fábrica propia en Madrid',
    texto: 'Fabricamos y atendemos desde aquí, con ISO 9001, ISO 13485 e ISO 14001.',
  },
];

const certificados = [
  { nombre: 'ISO 9001', detalle: 'Calidad', texto: 'Gestión de la calidad en toda la empresa.' },
  {
    nombre: 'ISO 13485',
    detalle: 'Producto sanitario',
    texto: 'Sistema de calidad específico para productos sanitarios.',
  },
  { nombre: 'ISO 14001', detalle: 'Medio ambiente', texto: 'Gestión ambiental de la fábrica y de sus procesos.' },
  { nombre: 'IVDR', detalle: '(UE) 2017/746', texto: 'Conformes con el Reglamento europeo de diagnóstico in vitro.' },
  {
    nombre: 'CE',
    detalle: 'Marcado europeo',
    texto: 'Cumplen las directivas europeas de baja tensión y compatibilidad electromagnética.',
  },
  {
    nombre: 'EN 61010',
    detalle: 'Seguridad',
    texto: 'Seguridad de equipos de laboratorio, con su parte específica para centrífugas.',
  },
  {
    nombre: 'RoHS',
    detalle: '2011/65/UE',
    texto: 'Componentes sin las sustancias peligrosas que restringe la Unión Europea.',
  },
  { nombre: 'RAEE', detalle: '2012/19/UE', texto: 'El equipo se recoge y se recicla al final de su vida útil.' },
  {
    nombre: 'KC',
    detalle: 'Expedidor conocido',
    texto: 'Los envíos por avión salen con los controles de seguridad ya hechos.',
  },
];
const primero = certificados[1];
---

<section class="company" id="empresa">
  <div class="foto ap">
    <div class="ph" role="img" aria-label="Rotor de una centrífuga Orto Alresa cargado con tubos de tapón rojo"></div>
    <div class="wrap">
      <h2>
        Nuestro objetivo no es ser una opción más, sino ir <b>más allá de lo estándar</b>
      </h2>
    </div>
  </div>

  <div class="wrap cuerpo">
    <ul class="pompas ap">
      {pompas.map((p, i) => (
        <li style={`--i: ${i}`}>
          <div class="tubo" aria-hidden="true">
            <i class="tapon" />
            <i class="vidrio">
              <i class="celulas" />
              <i class="capa" />
              <i class="plasma" />
              <i class="burbuja" />
              <i class="burbuja" />
              <i class="burbuja" />
            </i>
          </div>
          <div class="txt">
            <b class="cifra" data-cifra={p.cifra}>
              <span>{p.cifra}</span>
            </b>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="cta ap">
      <a class="btn ghost grande" href="/empresa/">
        Conoce la empresa <span aria-hidden="true">»</span>
      </a>
    </div>
  </div>

  <div class="franja">
    <div class="sellos wrap ap">
      <h3 class="st">
        Certificados y normas que <b>cumplimos</b>
      </h3>
      <div class="rueda" data-rueda>
        <button class="flecha ant" type="button" aria-label="Certificado anterior">
          ‹
        </button>
        <ul>
          {certificados.map((c, i) => (
            <li>
              <button type="button" data-i={i} data-texto={c.texto} aria-label={`${c.nombre}: ${c.texto}`}>
                <span class="luz" aria-hidden="true" />
                <b>{c.nombre}</b>
                <span>{c.detalle}</span>
              </button>
            </li>
          ))}
        </ul>
        <button class="flecha sig" type="button" aria-label="Certificado siguiente">
          ›
        </button>
      </div>
      <p class="expl" aria-live="polite">
        <b>{primero?.nombre}</b>
        <span>{primero?.texto}</span>
      </p>
    </div>
  </div>
</section>

<script>
  // Entradas suaves la primera vez que se ve cada bloque
  const bloques = document.querySelectorAll('#empresa .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.25 },
    );
    bloques.forEach((b) => obs.observe(b));
  }

  // El 1949 cuenta desde 1900 al llegar el tubo, rápido; con menos movimiento se queda fijo
  const cifra = document.querySelector<HTMLElement>('#empresa [data-cifra="1949"] span');
  const lista = document.querySelector('#empresa .pompas');
  if (
    cifra &&
    lista &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    'IntersectionObserver' in window
  ) {
    const ver = new IntersectionObserver(
      ([e]) => {
        if (!e?.isIntersecting) return;
        ver.disconnect();
        const t0 = performance.now();
        const paso = (t: number) => {
          const k = Math.min((t - t0) / 1100, 1);
          cifra.textContent = String(Math.round(1900 + 49 * (1 - (1 - k) ** 3)));
          if (k < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
      },
      { threshold: 0.25 },
    );
    ver.observe(lista);
  }

  // Rueda de certificados: el del centro se enciende y se explica debajo; avanza sola y se para al pasar el ratón
  const rueda = document.querySelector<HTMLElement>('[data-rueda]');
  const expl = document.querySelector<HTMLElement>('#empresa .expl');
  if (rueda && expl) {
    const botones = [...rueda.querySelectorAll<HTMLButtonElement>('li button')];
    const n = botones.length;
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activo = 1;
    let reloj = 0;

    const pintar = () => {
      botones.forEach((b, i) => {
        let d = (((i - activo) % n) + n) % n;
        if (d > n / 2) d -= n;
        const li = b.parentElement as HTMLElement;
        li.style.setProperty('--d', String(d));
        li.style.setProperty('--a', String(Math.min(Math.abs(d), 3)));
        li.classList.toggle('activo', d === 0);
        li.classList.toggle('lejos', Math.abs(d) > 3);
        b.tabIndex = Math.abs(d) > 2 ? -1 : 0;
      });
      const b = botones[activo];
      const nombre = document.createElement('b');
      nombre.textContent = b?.querySelector('b')?.textContent ?? '';
      const texto = document.createElement('span');
      texto.textContent = b?.dataset.texto ?? '';
      expl.replaceChildren(nombre, texto);
      expl.classList.remove('cambio');
      void expl.offsetWidth;
      expl.classList.add('cambio');
    };
    const ir = (i: number) => {
      activo = (i + n) % n;
      pintar();
    };
    const arrancar = () => {
      if (quieto) return;
      clearInterval(reloj);
      reloj = window.setInterval(() => ir(activo + 1), 3600);
    };
    const parar = () => clearInterval(reloj);

    rueda.classList.add('viva');
    botones.forEach((b, i) => b.addEventListener('click', () => ir(i)));
    rueda.querySelector('.ant')?.addEventListener('click', () => ir(activo - 1));
    rueda.querySelector('.sig')?.addEventListener('click', () => ir(activo + 1));
    rueda.addEventListener('mouseenter', parar);
    rueda.addEventListener('mouseleave', arrancar);
    rueda.addEventListener('focusin', parar);
    rueda.addEventListener('focusout', arrancar);
    pintar();
    arrancar();
  }
</script>

<style>
  /* Sección en blanco: foto baja a lo ancho, tres tubos con los datos y certificados en una franja gris claro */
  .company {
    position: relative;
    overflow: hidden;
    background: #fff;
  }
  /* Foto del rotor a lo ancho, más baja que antes, con la frase en blanco encima */
  .foto {
    position: relative;
    overflow: hidden;
    height: clamp(320px, 27vw, 400px);
    color: #fff;
  }
  .ph {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(12, 14, 16, 0.72), rgba(12, 14, 16, 0.35) 70%, rgba(12, 14, 16, 0.2)),
      url('/img/fotos/empresa-tubos.webp') center 45% / cover;
    transition: transform 1.6s var(--ease);
  }
  .foto .wrap {
    position: relative;
    padding-top: clamp(44px, 5vw, 72px);
    text-align: center;
  }
  h2 {
    margin: 0 auto;
    max-width: 17em;
    font-weight: 300;
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1.08;
    text-wrap: balance;
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  h2 b {
    font-weight: 700;
    text-transform: uppercase;
    background: linear-gradient(var(--red), var(--red)) left bottom / 100% 3px no-repeat;
    padding-bottom: 2px;
  }
  .cuerpo,
  .sellos {
    position: relative;
    text-align: center;
  }

  /* Cada dato es un tubo de ensayo con tapón rojo: al llegar se llena de sangre y se separa en capas, como al
     centrifugar (glóbulos rojos abajo, una línea blanca y el plasma arriba) */
  .pompas {
    list-style: none;
    margin: clamp(56px, 6vw, 88px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 48px);
  }
  .pompas li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: clamp(18px, 2vw, 28px);
    text-align: left;
  }
  .tubo {
    --h: clamp(170px, 14vw, 210px);
    position: relative;
    width: 58px;
    height: var(--h);
    padding-top: 22px;
  }
  .tapon {
    position: absolute;
    top: 0;
    left: -6px;
    right: -6px;
    height: 30px;
    z-index: 2;
    border-radius: 3px;
    background: linear-gradient(90deg, #a10309, #e3070e 35%, #ff4a4f 48%, #c4050b 62%, #8c0307);
    box-shadow: inset 0 -5px 0 rgba(0, 0, 0, 0.18);
  }
  .vidrio {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border: 2px solid rgba(59, 64, 69, 0.28);
    border-top: 0;
    border-radius: 0 0 29px 29px;
    background: linear-gradient(90deg, rgba(240, 242, 244, 0.9), #fff 40%, rgba(232, 235, 238, 0.9));
  }
  /* Reflejo del cristal, encima de todo */
  .vidrio::after {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 14px;
    left: 9px;
    width: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.7);
  }
  .celulas,
  .capa,
  .plasma,
  .burbuja {
    position: absolute;
    left: 0;
    right: 0;
    display: block;
  }
  .celulas {
    bottom: 0;
    height: 42%;
    background: linear-gradient(90deg, #6e0205, #a8040a 45%, #7a0206);
    transform-origin: bottom;
  }
  .capa {
    bottom: 42%;
    height: 4px;
    background: #f4f1ea;
  }
  .plasma {
    bottom: calc(42% + 4px);
    height: 40%;
    background: linear-gradient(90deg, #e9c779, #f6dc9c 45%, #e5c06c);
  }
  .burbuja {
    left: 50%;
    bottom: 46%;
    width: 7px;
    height: 7px;
    margin-left: -3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    opacity: 0;
  }
  .burbuja:nth-child(5) {
    margin-left: -12px;
    width: 5px;
    height: 5px;
  }
  .burbuja:nth-child(6) {
    margin-left: 6px;
    width: 4px;
    height: 4px;
  }
  .cifra {
    display: block;
    margin-bottom: 6px;
    font-size: clamp(40px, 3.6vw, 56px);
    line-height: 1;
    transition: color 0.3s var(--ease);
  }
  .txt h3 {
    margin: 0 0 8px;
    font-size: clamp(21px, 1.6vw, 24px);
  }
  .txt p {
    margin: 0;
    max-width: 28ch;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.45;
    color: #3d3d3d;
  }

  .cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(36px, 4vw, 56px);
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
  }
  .btn.grande {
    padding: 18px 34px;
    font-size: 19px;
  }
  .btn span {
    transition: transform 0.25s var(--ease);
  }
  .btn:hover span {
    transform: translateX(5px);
  }

  /* Certificados: placas claras de cristal; la del centro se enciende con un borde rojo suave */
  .franja {
    margin-top: clamp(56px, 6vw, 88px);
    background: var(--band);
  }
  .sellos {
    padding-block: clamp(56px, 6vw, 88px) clamp(56px, 6vw, 80px);
  }
  .st {
    margin: 0 0 24px;
    font-weight: 300;
    font-size: clamp(24px, 2.4vw, 32px);
  }
  .st b,
  .expl :global(b) {
    color: var(--red);
  }
  .rueda {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
  }
  .rueda ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .rueda li button {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2px;
    width: 158px;
    padding: 16px 10px;
    font: inherit;
    color: var(--ink);
    cursor: pointer;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(59, 64, 69, 0.18);
    box-shadow: 0 10px 24px -18px rgba(0, 0, 0, 0.35);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
    transition:
      border-color 0.45s var(--ease),
      box-shadow 0.45s var(--ease),
      background 0.45s var(--ease);
  }
  .rueda li b {
    font-size: 21px;
  }
  .rueda li span {
    font-size: 13px;
    color: var(--muted);
  }
  .luz {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(221, 4, 10, 0.08) 50%, transparent 70%);
    translate: -110% 0;
    pointer-events: none;
  }
  .flecha {
    display: none;
  }
  .expl {
    display: none;
  }

  /* Con JS la lista se convierte en rueda: el del centro se enciende en rojo neón y le cruza un destello */
  .rueda.viva {
    height: 116px;
  }
  .rueda.viva ul {
    display: block;
    position: relative;
    height: 100%;
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }
  .rueda.viva li {
    --paso: 178px;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(calc(-50% + var(--d) * var(--paso)), -50%) scale(calc(1.08 - var(--a) * 0.08));
    opacity: calc(1 - var(--a) * 0.22);
    transition:
      transform 0.6s var(--ease),
      opacity 0.6s var(--ease);
  }
  .rueda.viva li.lejos {
    opacity: 0;
    pointer-events: none;
  }
  .rueda.viva li.activo button {
    background: #fff;
    border-color: rgba(221, 4, 10, 0.55);
    box-shadow:
      0 0 22px -8px rgba(221, 4, 10, 0.45),
      0 14px 28px -20px rgba(0, 0, 0, 0.4);
  }
  .rueda.viva .flecha {
    display: grid;
    place-items: center;
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 40px;
    height: 40px;
    transform: translateY(-50%);
    background: transparent;
    border: 0;
    font: 300 40px/1 var(--f);
    color: var(--ink);
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }
  .flecha:hover {
    color: var(--red);
  }
  .ant {
    left: 0;
  }
  .sig {
    right: 0;
  }
  .rueda.viva + .expl {
    display: flex;
    justify-content: center;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin: 24px auto 0;
    max-width: 60ch;
    min-height: 3em;
    font-size: 18px;
  }

  /* Al pasar el ratón, la cifra se pone roja y suben burbujas por el plasma */
  @media (hover: hover) {
    .pompas li:hover .cifra {
      color: var(--red);
    }
    .rueda.viva li:not(.activo) button:hover {
      border-color: rgba(221, 4, 10, 0.4);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pompas li:hover .burbuja {
      animation: burbuja 1.4s ease-in infinite;
    }
    .pompas li:hover .burbuja:nth-child(5) {
      animation-delay: 0.45s;
    }
    .pompas li:hover .burbuja:nth-child(6) {
      animation-delay: 0.9s;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rueda.viva li.activo .luz {
      translate: 110% 0;
      transition: translate 1s var(--ease);
    }
    .expl.cambio {
      animation: aparecer 0.5s var(--ease);
    }

    /* Entrada: la foto se asienta y la frase sube. Cada tubo, uno tras otro: se llena de sangre mezclada hasta
       arriba y en seguida los glóbulos bajan mientras aparece el plasma, con un leve vaivén del tubo */
    :global(.js) #empresa .foto:not(.vista) .ph {
      transform: scale(1.08);
    }
    :global(.js) #empresa .foto:not(.vista) h2 {
      opacity: 0;
      transform: translateY(24px);
    }
    :global(.js) #empresa .pompas:not(.vista) .celulas {
      transform: scaleY(0);
    }
    :global(.js) #empresa .pompas:not(.vista) .capa,
    :global(.js) #empresa .pompas:not(.vista) .plasma,
    :global(.js) #empresa .pompas:not(.vista) .txt {
      opacity: 0;
    }
    :global(.js) #empresa .pompas.vista .tubo {
      animation: vaiven 1.6s var(--ease) calc(var(--i) * 0.18s) both;
    }
    :global(.js) #empresa .pompas.vista .celulas {
      animation: llena 1.5s cubic-bezier(0.3, 0.7, 0.2, 1) calc(var(--i) * 0.18s) both;
    }
    :global(.js) #empresa .pompas.vista .plasma {
      animation: aparece 0.7s var(--ease) calc(var(--i) * 0.18s + 0.7s) both;
    }
    :global(.js) #empresa .pompas.vista .capa {
      animation: aparece 0.4s var(--ease) calc(var(--i) * 0.18s + 1.1s) both;
    }
    :global(.js) #empresa .pompas.vista .txt {
      animation: sube 0.6s var(--ease) calc(var(--i) * 0.18s + 0.35s) both;
    }
    :global(.js) #empresa .cta:not(.vista),
    :global(.js) #empresa .sellos:not(.vista) .rueda {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  @keyframes llena {
    0% {
      transform: scaleY(0);
      filter: saturate(0.85) brightness(1.15);
    }
    45% {
      transform: scaleY(2.05);
      filter: saturate(0.85) brightness(1.15);
    }
    100% {
      transform: scaleY(1);
      filter: none;
    }
  }
  @keyframes aparece {
    from {
      opacity: 0;
    }
  }
  @keyframes vaiven {
    0% {
      transform: rotate(-8deg);
    }
    55% {
      transform: rotate(3deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes burbuja {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(-60px);
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  /* Móvil: los tubos en columna, cada uno con su texto al lado */
  @media (max-width: 860px) {
    .foto {
      height: auto;
      min-height: 280px;
      padding-bottom: 48px;
    }
    .pompas {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 44px;
    }
    .tubo {
      --h: 150px;
      width: 50px;
    }
    .vidrio {
      border-radius: 0 0 25px 25px;
    }
    .rueda.viva li {
      --paso: 136px;
    }
    .rueda.viva li button {
      width: 124px;
    }
    .rueda.viva ul {
      mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
    }
    .rueda.viva .flecha {
      width: 32px;
    }
  }
</style>
