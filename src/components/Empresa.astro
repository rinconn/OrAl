---
// Todo sale del Catálogo General 2025: la frase, la historia, la empresa familiar, la fábrica y las normas
const pompas = [
  {
    cifra: '1949',
    titulo: 'Fabricantes de centrífugas',
    texto: 'Más de 75 años después, somos referente entre los fabricantes europeos.',
  },
  {
    cifra: 'Familiar',
    titulo: 'Una empresa de familia',
    texto: 'Buscamos integrar a nuestros socios, usuarios y asociados.',
  },
  {
    cifra: 'Daganzo',
    titulo: 'Fábrica propia en Madrid',
    texto: 'Fabricamos y atendemos desde aquí, con ISO 9001, ISO 13485 e ISO 14001.',
  },
];

const certificados = [
  { nombre: 'ISO 9001', detalle: 'Calidad', texto: 'Gestión de la calidad en toda la empresa.' },
  {
    nombre: 'ISO 13485',
    detalle: 'Producto sanitario',
    texto: 'Sistema de calidad específico para productos sanitarios.',
  },
  { nombre: 'ISO 14001', detalle: 'Medio ambiente', texto: 'Gestión ambiental de la fábrica y de sus procesos.' },
  { nombre: 'IVDR', detalle: '(UE) 2017/746', texto: 'Conformes con el Reglamento europeo de diagnóstico in vitro.' },
  {
    nombre: 'CE',
    detalle: 'Marcado europeo',
    texto: 'Cumplen las directivas europeas de baja tensión y compatibilidad electromagnética.',
  },
  {
    nombre: 'EN 61010',
    detalle: 'Seguridad',
    texto: 'Seguridad de equipos de laboratorio, con su parte específica para centrífugas.',
  },
  {
    nombre: 'RoHS',
    detalle: '2011/65/UE',
    texto: 'Componentes sin las sustancias peligrosas que restringe la Unión Europea.',
  },
  { nombre: 'RAEE', detalle: '2012/19/UE', texto: 'El equipo se recoge y se recicla al final de su vida útil.' },
  {
    nombre: 'KC',
    detalle: 'Expedidor conocido',
    texto: 'Los envíos por avión salen con los controles de seguridad ya hechos.',
  },
];
const primero = certificados[1];
---

<section class="company" id="empresa">
  <div class="foto ap">
    <div class="ph" role="img" aria-label="Rotor de una centrífuga Orto Alresa cargado con tubos de tapón rojo"></div>
    <div class="wrap">
      <h2>
        Nuestro objetivo no es ser una opción más, sino ir <b>más allá de lo estándar</b>
      </h2>
    </div>
  </div>

  <div class="wrap cuerpo">
    <ul class="pompas ap">
      {pompas.map((p, i) => (
        <li style={`--i: ${i}`}>
          <b class="pompa" data-cifra={p.cifra}>
            <span>{p.cifra}</span>
          </b>
          <div class="txt">
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="cta ap">
      <a class="btn ghost grande" href="/empresa/">
        Conoce la empresa <span aria-hidden="true">»</span>
      </a>
    </div>
  </div>

  <div class="franja">
    <div class="sellos wrap ap">
      <h3 class="st">
        Certificados y normas que <b>cumplimos</b>
      </h3>
      <div class="rueda" data-rueda>
        <button class="flecha ant" type="button" aria-label="Certificado anterior">
          ‹
        </button>
        <ul>
          {certificados.map((c, i) => (
            <li>
              <button type="button" data-i={i} data-texto={c.texto} aria-label={`${c.nombre}: ${c.texto}`}>
                <span class="luz" aria-hidden="true" />
                <b>{c.nombre}</b>
                <span>{c.detalle}</span>
              </button>
            </li>
          ))}
        </ul>
        <button class="flecha sig" type="button" aria-label="Certificado siguiente">
          ›
        </button>
      </div>
      <p class="expl" aria-live="polite">
        <b>{primero?.nombre}</b>
        <span>{primero?.texto}</span>
      </p>
    </div>
  </div>
</section>

<script>
  // Entradas suaves la primera vez que se ve cada bloque
  const bloques = document.querySelectorAll('#empresa .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.25 },
    );
    bloques.forEach((b) => obs.observe(b));
  }

  // El 1949 cuenta desde 1900 al llegar la pompa, rápido; con menos movimiento se queda fijo
  const cifra = document.querySelector<HTMLElement>('#empresa [data-cifra="1949"] span');
  const lista = document.querySelector('#empresa .pompas');
  if (
    cifra &&
    lista &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    'IntersectionObserver' in window
  ) {
    const ver = new IntersectionObserver(
      ([e]) => {
        if (!e?.isIntersecting) return;
        ver.disconnect();
        const t0 = performance.now();
        const paso = (t: number) => {
          const k = Math.min((t - t0) / 1100, 1);
          cifra.textContent = String(Math.round(1900 + 49 * (1 - (1 - k) ** 3)));
          if (k < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
      },
      { threshold: 0.25 },
    );
    ver.observe(lista);
  }

  // Rueda de certificados: el del centro se enciende y se explica debajo; avanza sola y se para al pasar el ratón
  const rueda = document.querySelector<HTMLElement>('[data-rueda]');
  const expl = document.querySelector<HTMLElement>('#empresa .expl');
  if (rueda && expl) {
    const botones = [...rueda.querySelectorAll<HTMLButtonElement>('li button')];
    const n = botones.length;
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activo = 1;
    let reloj = 0;

    const pintar = () => {
      botones.forEach((b, i) => {
        let d = (((i - activo) % n) + n) % n;
        if (d > n / 2) d -= n;
        const li = b.parentElement as HTMLElement;
        li.style.setProperty('--d', String(d));
        li.style.setProperty('--a', String(Math.min(Math.abs(d), 3)));
        li.classList.toggle('activo', d === 0);
        li.classList.toggle('lejos', Math.abs(d) > 3);
        b.tabIndex = Math.abs(d) > 2 ? -1 : 0;
      });
      const b = botones[activo];
      const nombre = document.createElement('b');
      nombre.textContent = b?.querySelector('b')?.textContent ?? '';
      const texto = document.createElement('span');
      texto.textContent = b?.dataset.texto ?? '';
      expl.replaceChildren(nombre, texto);
      expl.classList.remove('cambio');
      void expl.offsetWidth;
      expl.classList.add('cambio');
    };
    const ir = (i: number) => {
      activo = (i + n) % n;
      pintar();
    };
    const arrancar = () => {
      if (quieto) return;
      clearInterval(reloj);
      reloj = window.setInterval(() => ir(activo + 1), 3600);
    };
    const parar = () => clearInterval(reloj);

    rueda.classList.add('viva');
    botones.forEach((b, i) => b.addEventListener('click', () => ir(i)));
    rueda.querySelector('.ant')?.addEventListener('click', () => ir(activo - 1));
    rueda.querySelector('.sig')?.addEventListener('click', () => ir(activo + 1));
    rueda.addEventListener('mouseenter', parar);
    rueda.addEventListener('mouseleave', arrancar);
    rueda.addEventListener('focusin', parar);
    rueda.addEventListener('focusout', arrancar);
    pintar();
    arrancar();
  }
</script>

<style>
  /* Sección en blanco: foto baja a lo ancho, pompas montadas sobre su borde y certificados en una franja gris claro */
  .company {
    position: relative;
    overflow: hidden;
    background: #fff;
  }
  /* Foto del rotor a lo ancho, más baja que antes, con la frase en blanco encima */
  .foto {
    position: relative;
    overflow: hidden;
    height: clamp(320px, 27vw, 400px);
    color: #fff;
  }
  .ph {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(12, 14, 16, 0.72), rgba(12, 14, 16, 0.35) 70%, rgba(12, 14, 16, 0.2)),
      url('/img/fotos/empresa-tubos.webp') center 45% / cover;
    transition: transform 1.6s var(--ease);
  }
  .foto .wrap {
    position: relative;
    padding-top: clamp(44px, 5vw, 72px);
    text-align: center;
  }
  h2 {
    margin: 0 auto;
    max-width: 17em;
    font-weight: 300;
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1.08;
    text-wrap: balance;
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  h2 b {
    font-weight: 700;
    text-transform: uppercase;
    background: linear-gradient(var(--red), var(--red)) left bottom / 100% 3px no-repeat;
    padding-bottom: 2px;
  }
  .cuerpo,
  .sellos {
    position: relative;
    text-align: center;
  }

  /* Pompas: esferas de rojo a negro con un brillo blanco, montadas sobre el borde de la foto */
  .pompas {
    list-style: none;
    margin: calc(var(--s) * -0.55) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 48px);
    --s: clamp(176px, 14.5vw, 212px);
  }
  .pompas li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 22px;
  }
  .pompa {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--s);
    aspect-ratio: 1;
    border-radius: 50%;
    font-size: calc(var(--s) * 0.2);
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
    background:
      radial-gradient(ellipse 46% 26% at 40% 17%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 72%),
      linear-gradient(140deg, #e3070e 0%, #9a0308 28%, #3b0b0c 58%, #141618 86%);
    box-shadow:
      0 0 0 6px #fff,
      inset 0 0 0 1px rgba(255, 255, 255, 0.14),
      inset 0 -10px 22px rgba(0, 0, 0, 0.35),
      0 28px 44px -22px rgba(80, 0, 0, 0.6);
    transition:
      scale 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.45s var(--ease);
  }
  /* Brillo que cruza la esfera de lado a lado, recortado al círculo */
  .pompa::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.28) 50%, transparent 65%);
    background-size: 250% 100%;
    background-position: 120% 0;
    pointer-events: none;
  }
  /* Onda roja que se abre una vez cuando la pompa llega */
  .pompa::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--red);
    opacity: 0;
    pointer-events: none;
  }
  .pompa span {
    position: relative;
  }
  .txt h3 {
    margin: 0 0 8px;
    font-size: clamp(22px, 1.7vw, 25px);
  }
  .txt p {
    margin: 0 auto;
    max-width: 28ch;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.45;
    color: #3d3d3d;
  }

  .cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(36px, 4vw, 56px);
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
  }
  .btn.grande {
    padding: 18px 34px;
    font-size: 19px;
  }
  .btn span {
    transition: transform 0.25s var(--ease);
  }
  .btn:hover span {
    transform: translateX(5px);
  }

  /* Certificados: placas claras de cristal; la del centro se enciende con un borde rojo suave */
  .franja {
    margin-top: clamp(56px, 6vw, 88px);
    background: var(--band);
  }
  .sellos {
    padding-block: clamp(56px, 6vw, 88px) clamp(56px, 6vw, 80px);
  }
  .st {
    margin: 0 0 24px;
    font-weight: 300;
    font-size: clamp(24px, 2.4vw, 32px);
  }
  .st b,
  .expl :global(b) {
    color: var(--red);
  }
  .rueda {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
  }
  .rueda ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .rueda li button {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2px;
    width: 158px;
    padding: 16px 10px;
    font: inherit;
    color: var(--ink);
    cursor: pointer;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(59, 64, 69, 0.18);
    box-shadow: 0 10px 24px -18px rgba(0, 0, 0, 0.35);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
    transition:
      border-color 0.45s var(--ease),
      box-shadow 0.45s var(--ease),
      background 0.45s var(--ease);
  }
  .rueda li b {
    font-size: 21px;
  }
  .rueda li span {
    font-size: 13px;
    color: var(--muted);
  }
  .luz {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(221, 4, 10, 0.08) 50%, transparent 70%);
    translate: -110% 0;
    pointer-events: none;
  }
  .flecha {
    display: none;
  }
  .expl {
    display: none;
  }

  /* Con JS la lista se convierte en rueda: el del centro se enciende en rojo neón y le cruza un destello */
  .rueda.viva {
    height: 116px;
  }
  .rueda.viva ul {
    display: block;
    position: relative;
    height: 100%;
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }
  .rueda.viva li {
    --paso: 178px;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(calc(-50% + var(--d) * var(--paso)), -50%) scale(calc(1.08 - var(--a) * 0.08));
    opacity: calc(1 - var(--a) * 0.22);
    transition:
      transform 0.6s var(--ease),
      opacity 0.6s var(--ease);
  }
  .rueda.viva li.lejos {
    opacity: 0;
    pointer-events: none;
  }
  .rueda.viva li.activo button {
    background: #fff;
    border-color: rgba(221, 4, 10, 0.55);
    box-shadow:
      0 0 22px -8px rgba(221, 4, 10, 0.45),
      0 14px 28px -20px rgba(0, 0, 0, 0.4);
  }
  .rueda.viva .flecha {
    display: grid;
    place-items: center;
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 40px;
    height: 40px;
    transform: translateY(-50%);
    background: transparent;
    border: 0;
    font: 300 40px/1 var(--f);
    color: var(--ink);
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }
  .flecha:hover {
    color: var(--red);
  }
  .ant {
    left: 0;
  }
  .sig {
    right: 0;
  }
  .rueda.viva + .expl {
    display: flex;
    justify-content: center;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin: 24px auto 0;
    max-width: 60ch;
    min-height: 3em;
    font-size: 18px;
  }

  /* Al pasar el ratón, la pompa y la placa se encienden con el mismo neón rojo suave de la portada */
  /* Al pasar el ratón, la pompa crece un poco con rebote, se enciende en rojo neón y le cruza el brillo */
  @media (hover: hover) {
    .pompas li:hover .pompa {
      scale: 1.06;
      box-shadow:
        0 0 0 6px #fff,
        inset 0 0 0 1px rgba(255, 90, 90, 0.4),
        inset 0 -10px 22px rgba(0, 0, 0, 0.35),
        0 0 40px -4px rgba(221, 4, 10, 0.6),
        0 28px 44px -22px rgba(80, 0, 0, 0.6);
    }
    .pompas li:hover .pompa::before {
      background-position: -120% 0;
      transition: background-position 0.8s var(--ease);
    }
    .rueda.viva li:not(.activo) button:hover {
      border-color: rgba(221, 4, 10, 0.4);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rueda.viva li.activo .luz {
      translate: 110% 0;
      transition: translate 1s var(--ease);
    }
    .expl.cambio {
      animation: aparecer 0.5s var(--ease);
    }

    /* Entrada rápida: la foto se asienta, la frase sube y las pompas saltan una tras otra con un pequeño rebote,
       abren una onda roja y les cruza el brillo; el texto sube justo detrás. Después se mecen muy despacio */
    :global(.js) #empresa .foto:not(.vista) .ph {
      transform: scale(1.08);
    }
    :global(.js) #empresa .foto:not(.vista) h2 {
      opacity: 0;
      transform: translateY(24px);
    }
    :global(.js) #empresa .pompas:not(.vista) .pompa,
    :global(.js) #empresa .pompas:not(.vista) .txt {
      opacity: 0;
    }
    :global(.js) #empresa .pompas.vista .pompa {
      animation:
        llega 0.9s cubic-bezier(0.2, 0.8, 0.25, 1) calc(var(--i) * 0.14s) both,
        flota 7s ease-in-out calc(var(--i) * 0.14s + 0.9s) infinite;
    }
    :global(.js) #empresa .pompas.vista .pompa::after {
      animation: onda 1s var(--ease) calc(var(--i) * 0.14s + 0.55s) both;
    }
    :global(.js) #empresa .pompas.vista .pompa::before {
      animation: brillo 1.1s var(--ease) calc(var(--i) * 0.14s + 0.5s) both;
    }
    :global(.js) #empresa .pompas.vista .txt {
      animation: sube 0.6s var(--ease) calc(var(--i) * 0.14s + 0.45s) both;
    }
    :global(.js) #empresa .cta:not(.vista),
    :global(.js) #empresa .sellos:not(.vista) .rueda {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  @keyframes llega {
    0% {
      opacity: 0;
      transform: translateY(70px) scale(0.6);
    }
    60% {
      opacity: 1;
      transform: translateY(-8px) scale(1.05);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes onda {
    0% {
      opacity: 0.7;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }
  @keyframes brillo {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -120% 0;
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes flota {
    50% {
      translate: 0 -8px;
    }
  }
  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  /* Móvil: pompas en columna, alternando de lado, con su texto al lado */
  @media (max-width: 860px) {
    .pompas {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .pompas li {
      grid-template-columns: auto 1fr;
      justify-items: start;
      align-items: center;
      text-align: left;
      gap: 20px;
    }
    .pompas li:nth-child(2) {
      grid-template-columns: 1fr auto;
      text-align: right;
    }
    .pompas li:nth-child(2) .pompa {
      order: 2;
    }
    .foto {
      height: auto;
      min-height: 280px;
      padding-bottom: 48px;
    }
    .pompas {
      --s: 124px;
      margin-top: 40px;
    }
    .txt p {
      margin: 0;
    }
    .pompas li:nth-child(2) .txt p {
      margin-left: auto;
    }
    .rueda.viva li {
      --paso: 136px;
    }
    .rueda.viva li button {
      width: 124px;
    }
    .rueda.viva ul {
      mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
    }
    .rueda.viva .flecha {
      width: 32px;
    }
  }
</style>
