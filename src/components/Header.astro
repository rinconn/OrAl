---
// Cabecera: logo en dos líneas, menú, banderas de idioma, lupa y Contacto.
// Se aparta al bajar y vuelve al subir. En móvil el menú ocupa la pantalla, se cierra con Esc
// y mantiene el foco dentro mientras está abierto.
import Bandera from './ui/Bandera.astro';
import Buscador from './Buscador.astro';
import { principal, contacto } from '../data/navegacion';
import { idioma, idiomas, ruta, sinIdioma, textos } from '../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
// Cada bandera lleva a esta misma página en su idioma
const base = sinIdioma(Astro.url.pathname);
const actual = (href: string) => !href.startsWith('/#') && base.startsWith(href);
---

<a class="skip" href="#inicio">
  {t.meta.saltar}
</a>

<header class="top" id="top" data-portada={base === '/' ? '' : undefined}>
  <div class="wrap bar">
    <a class="marca" href={ruta(lang, '/')} aria-label={t.cabecera.inicio}>
      <img class="logo" src="/img/marca/logo-ortoalresa-2-lineas.svg" alt="orto alresa" width="132" height="44" />
    </a>

    <nav class="nav" id="nav" aria-label={t.cabecera.principal}>
      <ul>
        {principal.map((e) => (
          <li>
            <a href={ruta(lang, e.href)} aria-current={actual(e.href) ? 'page' : undefined}>
              {t.nav[e.clave]}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-extra">
        <a class="btn red" href={ruta(lang, contacto.href)}>
          {t.cabecera.contacto}
        </a>
        <a href={contacto.telefonoHref}>{contacto.telefono}</a>
        <a href={`mailto:${contacto.comercial}`}>{contacto.comercial}</a>
      </div>
    </nav>

    <div class="der">
      <div class="banderas" role="group" aria-label={t.cabecera.idioma}>
        {idiomas.map((i) =>
          i.codigo === lang ? (
            <span class="bandera" aria-current="true" title={i.nombre}>
              <Bandera codigo={i.codigo} />
              <span class="sr">{i.nombre}</span>
            </span>
          ) : (
            <a
              class="bandera"
              href={ruta(i.codigo, base)}
              hreflang={i.codigo}
              lang={i.codigo}
              title={i.nombre}
              data-idioma
            >
              <Bandera codigo={i.codigo} />
              <span class="sr">{i.nombre}</span>
            </a>
          ),
        )}
      </div>
      <Buscador />
      <a class="btn red contacto" href={ruta(lang, contacto.href)}>
        {t.cabecera.contacto}
      </a>
    </div>

    <button
      class="menu-btn"
      id="menuBtn"
      type="button"
      aria-expanded="false"
      aria-controls="nav"
      data-menu={t.cabecera.menu}
      data-cerrar={t.cabecera.cerrar}
    >
      <span class="ico" aria-hidden="true"></span>
      <span class="txt">{t.cabecera.menu}</span>
    </button>
  </div>
</header>

<script>
  const top = document.getElementById('top');
  const nav = document.getElementById('nav');
  const btn = document.getElementById('menuBtn');
  const movil = window.matchMedia('(max-width: 1220px)');

  // Menú móvil
  const abrir = (abierto: boolean) => {
    if (!nav || !btn) return;
    nav.classList.toggle('open', abierto);
    btn.setAttribute('aria-expanded', String(abierto));
    btn.querySelector('.txt')!.textContent = (abierto ? btn.dataset.cerrar : btn.dataset.menu) ?? '';
    document.documentElement.classList.toggle('menu-abierto', abierto);
    if (abierto) nav.querySelector('a')?.focus();
  };
  btn?.addEventListener('click', () => abrir(!nav?.classList.contains('open')));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) abrir(false);
  });
  document.addEventListener('keydown', (e) => {
    if (!nav?.classList.contains('open')) return;
    if (e.key === 'Escape') {
      abrir(false);
      btn?.focus();
    }
    // El foco no se escapa del menú mientras está abierto
    if (e.key === 'Tab') {
      const focos = [btn, ...nav.querySelectorAll<HTMLElement>('a[href]')].filter(Boolean) as HTMLElement[];
      const primero = focos[0];
      const ultimo = focos[focos.length - 1];
      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primero.focus();
      }
    }
  });
  movil.addEventListener('change', () => abrir(false));

  // Al bajar se aparta, al subir vuelve. Nunca se esconde con el menú abierto o con el foco dentro.
  let ultimaY = window.scrollY;
  let pendiente = false;
  const alHacerScroll = () => {
    const y = window.scrollY;
    const bajando = y > ultimaY;
    const ocupado = nav?.classList.contains('open') || top?.contains(document.activeElement);
    top?.classList.toggle('scrolled', y > 40);
    top?.classList.toggle('oculta', bajando && y > 360 && !ocupado);
    ultimaY = y;
    pendiente = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(alHacerScroll);
      }
    },
    { passive: true },
  );
  top?.addEventListener('focusin', () => top.classList.remove('oculta'));

  // Al cambiar de idioma se sigue en la misma sección de la portada
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-idioma]')) {
    a.addEventListener('click', () => {
      if (location.hash) a.hash = location.hash;
    });
  }

  // En la portada, marca en el menú la sección que se está viendo. Si un enlace apunta a un panel dentro de una
  // sección (SmartConnect, REI System, Configurador), cuenta su sección y se marca el del panel abierto.
  const enlaces = [...(nav?.querySelectorAll<HTMLAnchorElement>('ul a[href*="/#"]') ?? [])];
  const porSeccion = new Map<HTMLElement, HTMLAnchorElement[]>();
  for (const a of enlaces) {
    const destino = document.getElementById(a.hash.slice(1));
    const seccion = destino?.closest<HTMLElement>('section[id]') ?? destino;
    if (seccion) porSeccion.set(seccion, [...(porSeccion.get(seccion) ?? []), a]);
  }
  if (top?.hasAttribute('data-portada')) {
    const visibles = new Set<Element>();
    const marcar = () => {
      const activa = [...porSeccion.keys()].find((s) => visibles.has(s));
      const candidatos = activa ? porSeccion.get(activa)! : [];
      const elegido =
        candidatos.find((a) => document.getElementById(a.hash.slice(1))?.closest('.abierto')) ?? candidatos[0];
      for (const a of enlaces) a.removeAttribute('aria-current');
      elegido?.setAttribute('aria-current', 'location');
    };
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const en of entradas) {
          if (en.isIntersecting) visibles.add(en.target);
          else visibles.delete(en.target);
        }
        marcar();
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    for (const s of porSeccion.keys()) obs.observe(s);
    document.addEventListener('panel-abierto', marcar);
  }
</script>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    padding: 12px 16px;
    font-weight: 700;
    text-decoration: none;
  }
  .skip:focus {
    top: 12px;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid var(--line);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .top.scrolled {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.07);
  }
  .top.oculta {
    transform: translateY(-100%);
    box-shadow: none;
  }
  /* A todo el ancho de la pantalla, como la cabecera de la web actual: logo pegado a la izquierda y banderas,
     lupa y Contacto a la derecha, sin el ancho máximo del resto de la página */
  .bar {
    display: flex;
    align-items: center;
    gap: 40px;
    height: 76px;
    max-width: none;
    padding-inline: clamp(16px, 2.6vw, 48px);
  }
  .marca {
    flex: none;
  }
  .logo {
    height: 42px;
    width: auto;
  }

  .nav {
    margin-left: auto;
  }
  /* Escritorio: el mismo hueco a cada lado del menú, entre el logo y las banderas */
  @media (min-width: 1221px) {
    .bar {
      justify-content: space-between;
    }
    .nav {
      margin-left: 0;
    }
  }
  .nav ul {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 17px;
    font-weight: 400;
  }
  .nav ul a {
    display: block;
    white-space: nowrap;
    text-decoration: none;
    padding-block: 26px;
    box-shadow: inset 0 -3px 0 transparent;
    transition: box-shadow 0.2s var(--ease);
  }
  .nav ul a:hover,
  .nav ul a[aria-current] {
    box-shadow: inset 0 -3px 0 var(--red);
  }
  .nav-extra {
    display: none;
  }

  .der {
    flex: none;
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .banderas {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .bandera {
    display: block;
    padding-block: 5px;
    border-bottom: 2px solid transparent;
  }
  .bandera[aria-current] {
    border-color: var(--red);
  }
  .bandera :global(svg) {
    display: block;
    width: 30px;
    height: 20px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
  }
  span.bandera:not([aria-current]) {
    cursor: default;
  }
  .menu-btn {
    display: none;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    background: none;
    border: 1px solid var(--ink);
    color: var(--ink);
    font: 700 14px var(--f);
    padding: 9px 12px;
    cursor: pointer;
  }
  .ico {
    position: relative;
    width: 18px;
    height: 10px;
    border-block: 2px solid currentColor;
    transition: border-color 0.2s var(--ease);
  }
  .ico::before,
  .ico::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 2px;
    height: 2px;
    background: currentColor;
    opacity: 0;
    transition:
      transform 0.25s var(--ease),
      opacity 0.2s;
  }
  [aria-expanded='true'] .ico {
    border-color: transparent;
  }
  [aria-expanded='true'] .ico::before {
    opacity: 1;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .ico::after {
    opacity: 1;
    transform: rotate(-45deg);
  }

  /* Portátiles: menos hueco entre elementos para que el menú respire */
  @media (max-width: 1360px) {
    .bar {
      gap: 32px;
    }
    .nav ul {
      gap: 24px;
    }
  }

  @media (max-width: 1220px) {
    .bar {
      height: 60px;
      gap: 20px;
    }
    .logo {
      height: 36px;
    }
    /* En móvil solo quedan las banderas a la vista; Contacto va dentro del menú */
    .der {
      margin-left: auto;
      gap: 12px;
    }
    .der .contacto {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
      margin-left: 0;
    }
    .nav {
      display: none;
      position: fixed;
      inset: 60px 0 0;
      overflow-y: auto;
      background: #fff;
      padding: 8px var(--gut) calc(32px + env(safe-area-inset-bottom, 0px));
      flex-direction: column;
      gap: 28px;
    }
    .nav.open {
      display: flex;
      animation: entra 0.25s var(--ease);
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
      font-size: 26px;
      font-weight: 300;
    }
    .nav ul a {
      padding: 16px 0;
      border-bottom: 1px solid var(--line);
      box-shadow: none;
      display: flex;
      justify-content: space-between;
    }
    .nav ul a::after {
      content: '»';
      color: var(--red);
    }
    .nav ul a[aria-current] {
      color: var(--red);
    }
    .nav-extra {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      font-size: 17px;
    }
    .nav-extra > a:not(.btn) {
      text-decoration: none;
    }
    .nav-extra .btn {
      align-self: stretch;
      justify-content: center;
      margin-bottom: 8px;
    }
    :global(html.menu-abierto) {
      overflow: hidden;
    }
  }

  /* Móviles: el botón de menú se queda en icono para que quepan banderas y lupa */
  @media (max-width: 480px) {
    .bar {
      gap: 12px;
    }
    .der {
      gap: 4px;
    }
    .der .banderas {
      gap: 8px;
    }
    .bandera :global(svg) {
      width: 24px;
      height: 16px;
    }
    .menu-btn {
      padding: 9px 10px;
    }
    .menu-btn .txt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>
