---
// Cabecera: logo en dos líneas, menú, banderas de idioma, sellos y Contacto.
// Se aparta al bajar y vuelve al subir. En móvil el menú ocupa la pantalla, se cierra con Esc
// y mantiene el foco dentro mientras está abierto.
import Bandera from './ui/Bandera.astro';
import { principal, contacto, idiomas, sellos } from '../data/navegacion';

const ruta = Astro.url.pathname;
const actual = (href: string) => !href.startsWith('/#') && ruta.startsWith(href);
---

<a class="skip" href="#inicio">
  Saltar al contenido
</a>

<header class="top" id="top">
  <div class="wrap bar">
    <a class="marca" href="/" aria-label="Orto Alresa, inicio">
      <img class="logo" src="/img/marca/logo-ortoalresa-2-lineas.svg" alt="orto alresa" width="132" height="44" />
    </a>

    <nav class="nav" id="nav" aria-label="Principal">
      <ul>
        {principal.map((e) => (
          <li>
            <a href={e.href} aria-current={actual(e.href) ? 'page' : undefined}>
              {e.texto}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-extra">
        <a class="btn red" href={contacto.href}>
          Contacto
        </a>
        <a href={contacto.telefonoHref}>{contacto.telefono}</a>
        <a href={`mailto:${contacto.comercial}`}>{contacto.comercial}</a>
      </div>
    </nav>

    <div class="der">
      <div class="banderas" role="group" aria-label="Idioma">
        {idiomas.map((i) =>
          i.codigo === 'es' ? (
            <span class="bandera" aria-current="true" title={i.nombre}>
              <Bandera codigo={i.codigo} />
              <span class="sr">{i.nombre}</span>
            </span>
          ) : i.publicado ? (
            <a class="bandera" href={i.href} hreflang={i.codigo} title={i.nombre}>
              <Bandera codigo={i.codigo} />
              <span class="sr">{i.nombre}</span>
            </a>
          ) : (
            <span class="bandera" title={`${i.nombre}: próximamente`}>
              <Bandera codigo={i.codigo} />
              <span class="sr">{i.nombre}: próximamente</span>
            </span>
          ),
        )}
      </div>
      <a class="sellos" href="/#empresa">
        {sellos.map((s) => (
          <img src={s.src} alt={s.alt} width={s.ancho} height={s.alto} />
        ))}
      </a>
      <a class="btn red contacto" href={contacto.href}>
        Contacto
      </a>
    </div>

    <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="nav">
      <span class="ico" aria-hidden="true"></span>
      <span class="txt">Menú</span>
    </button>
  </div>
  <div class="wrap">
    <p class="why">
      <b>Antes:</b> diez entradas de menú al mismo nivel y, en móvil, el titular de la portada tapado por la cabecera.
      <b>Ahora:</b> seis entradas claras, el mismo logo, banderas y sellos que ya conocéis, más aire, y una cabecera que
      se aparta mientras lees y vuelve en cuanto subes.
    </p>
  </div>
</header>

<script>
  const top = document.getElementById('top');
  const nav = document.getElementById('nav');
  const btn = document.getElementById('menuBtn');
  const movil = window.matchMedia('(max-width: 1080px)');

  // Menú móvil
  const abrir = (abierto: boolean) => {
    if (!nav || !btn) return;
    nav.classList.toggle('open', abierto);
    btn.setAttribute('aria-expanded', String(abierto));
    btn.querySelector('.txt')!.textContent = abierto ? 'Cerrar' : 'Menú';
    document.documentElement.classList.toggle('menu-abierto', abierto);
    if (abierto) nav.querySelector('a')?.focus();
  };
  btn?.addEventListener('click', () => abrir(!nav?.classList.contains('open')));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) abrir(false);
  });
  document.addEventListener('keydown', (e) => {
    if (!nav?.classList.contains('open')) return;
    if (e.key === 'Escape') {
      abrir(false);
      btn?.focus();
    }
    // El foco no se escapa del menú mientras está abierto
    if (e.key === 'Tab') {
      const focos = [btn, ...nav.querySelectorAll<HTMLElement>('a[href]')].filter(Boolean) as HTMLElement[];
      const primero = focos[0];
      const ultimo = focos[focos.length - 1];
      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primero.focus();
      }
    }
  });
  movil.addEventListener('change', () => abrir(false));

  // Al bajar se aparta, al subir vuelve. Nunca se esconde con el menú abierto o con el foco dentro.
  let ultimaY = window.scrollY;
  let pendiente = false;
  const alHacerScroll = () => {
    const y = window.scrollY;
    const bajando = y > ultimaY;
    const ocupado = nav?.classList.contains('open') || top?.contains(document.activeElement);
    top?.classList.toggle('scrolled', y > 40);
    top?.classList.toggle('oculta', bajando && y > 360 && !ocupado);
    ultimaY = y;
    pendiente = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(alHacerScroll);
      }
    },
    { passive: true },
  );
  top?.addEventListener('focusin', () => top.classList.remove('oculta'));

  // En la portada, marca en el menú la sección que se está viendo
  const enlaces = [...(nav?.querySelectorAll<HTMLAnchorElement>('ul a[href^="/#"]') ?? [])];
  const porSeccion = new Map<string, HTMLAnchorElement>();
  for (const a of enlaces) {
    const id = a.hash.slice(1);
    if (!porSeccion.has(id)) porSeccion.set(id, a);
  }
  if (location.pathname === '/') {
    const visibles = new Set<string>();
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const en of entradas) {
          if (en.isIntersecting) visibles.add(en.target.id);
          else visibles.delete(en.target.id);
        }
        const activa = [...porSeccion.keys()].find((id) => visibles.has(id));
        for (const a of enlaces) a.removeAttribute('aria-current');
        if (activa) porSeccion.get(activa)?.setAttribute('aria-current', 'location');
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    for (const id of porSeccion.keys()) {
      const s = document.getElementById(id);
      if (s) obs.observe(s);
    }
  }
</script>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    padding: 12px 16px;
    font-weight: 700;
    text-decoration: none;
  }
  .skip:focus {
    top: 12px;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid var(--line);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .top.scrolled {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.07);
  }
  .top.oculta {
    transform: translateY(-100%);
    box-shadow: none;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 40px;
    height: 96px;
  }
  .marca {
    flex: none;
  }
  .logo {
    height: 52px;
    width: auto;
  }

  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 17px;
    font-weight: 400;
  }
  .nav ul a {
    display: block;
    white-space: nowrap;
    text-decoration: none;
    padding-block: 36px;
    box-shadow: inset 0 -3px 0 transparent;
    transition: box-shadow 0.2s var(--ease);
  }
  .nav ul a:hover,
  .nav ul a[aria-current] {
    box-shadow: inset 0 -3px 0 var(--red);
  }
  .nav-extra {
    display: none;
  }

  .der {
    flex: none;
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .banderas {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .bandera {
    display: block;
    padding-block: 5px;
    border-bottom: 2px solid transparent;
  }
  .bandera[aria-current] {
    border-color: var(--red);
  }
  .bandera :global(svg) {
    display: block;
    width: 24px;
    height: 16px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
  }
  span.bandera:not([aria-current]) {
    cursor: default;
  }
  .sellos {
    display: flex;
    gap: 12px;
    align-items: center;
    padding-left: 22px;
    border-left: 1px solid var(--line);
  }
  .sellos img {
    flex: none;
    height: 34px;
    width: auto;
  }

  .menu-btn {
    display: none;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    background: none;
    border: 1px solid var(--ink);
    color: var(--ink);
    font: 700 14px var(--f);
    padding: 9px 12px;
    cursor: pointer;
  }
  .ico {
    position: relative;
    width: 18px;
    height: 10px;
    border-block: 2px solid currentColor;
    transition: border-color 0.2s var(--ease);
  }
  .ico::before,
  .ico::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 2px;
    height: 2px;
    background: currentColor;
    opacity: 0;
    transition:
      transform 0.25s var(--ease),
      opacity 0.2s;
  }
  [aria-expanded='true'] .ico {
    border-color: transparent;
  }
  [aria-expanded='true'] .ico::before {
    opacity: 1;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .ico::after {
    opacity: 1;
    transform: rotate(-45deg);
  }
  .top .why {
    margin: 0 0 14px;
  }

  /* Portátiles: los sellos se quedan solo en el pie para que el menú respire */
  @media (max-width: 1500px) {
    .der .sellos {
      display: none;
    }
    .bar {
      gap: 32px;
    }
    .nav ul {
      gap: 24px;
    }
  }

  @media (max-width: 1080px) {
    .bar {
      height: 72px;
      gap: 20px;
    }
    .logo {
      height: 42px;
    }
    /* En móvil solo quedan las banderas a la vista; los sellos van al pie */
    .der {
      margin-left: auto;
      gap: 0;
    }
    .der .sellos,
    .der .contacto {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
      margin-left: 0;
    }
    .nav {
      display: none;
      position: fixed;
      inset: 72px 0 0;
      overflow-y: auto;
      background: #fff;
      padding: 8px var(--gut) calc(32px + env(safe-area-inset-bottom, 0px));
      flex-direction: column;
      gap: 28px;
    }
    .nav.open {
      display: flex;
      animation: entra 0.25s var(--ease);
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
      font-size: 26px;
      font-weight: 300;
    }
    .nav ul a {
      padding: 16px 0;
      border-bottom: 1px solid var(--line);
      box-shadow: none;
      display: flex;
      justify-content: space-between;
    }
    .nav ul a::after {
      content: '»';
      color: var(--red);
    }
    .nav ul a[aria-current] {
      color: var(--red);
    }
    .nav-extra {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      font-size: 17px;
    }
    .nav-extra > a:not(.btn) {
      text-decoration: none;
    }
    .nav-extra .btn {
      align-self: stretch;
      justify-content: center;
      margin-bottom: 8px;
    }
    :global(html.menu-abierto) {
      overflow: hidden;
    }
    :global(html.menu-abierto .notas-btn) {
      display: none;
    }
  }

  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>
