---
import { rei, smartconnect, sistemas, ademas } from '../data/tecnologia';
---

<section class="tech" id="tecnologia">
  <div class="wrap">
    <div class="cab ap">
      <h2>
        Tecnología <b>propia</b>
      </h2>
      <p>
        Lo que diferencia a una centrífuga Orto Alresa está dentro. Estos son los sistemas que desarrollamos nosotros.
      </p>
    </div>

    <!-- Los dos que más os diferencian, a lo grande y con foto real del catálogo -->
    <article class="gran rei ap">
      <div class="foto">
        <img
          src="/img/tecnologia/rei-system.webp"
          alt="Rotores con REI System: una mano levanta el tirador rojo para sacar el rotor"
          width="1400"
          height="856"
          loading="lazy"
        />
      </div>
      <div class="txt">
        <h3>{rei.nombre}</h3>
        <p class="frase">
          {rei.frase[0]}
          <b>{rei.frase[1]}</b>
          {rei.frase[2]}
        </p>
        <ol class="pasos">
          {rei.pasos.map((p) => (
            <li>{p}</li>
          ))}
        </ol>
        <a class="arrow video" href={rei.video} target="_blank" rel="noopener">
          Ver el vídeo
        </a>
        <p class="modelos">
          <b>Lo llevan</b>
          {rei.modelos.map((m, i) => (
            <>
              {i > 0 && ' · '}
              <a href={m.href}>{m.nombre}</a>
            </>
          ))}
        </p>
      </div>
    </article>

    <article class="gran sc ap">
      <div class="txt">
        <h3>{smartconnect.nombre}</h3>
        <p class="frase">
          {smartconnect.frase[0]}
          <b>{smartconnect.frase[1]}</b>
          {smartconnect.frase[2]}
        </p>
        <ul class="puntos">
          {smartconnect.puntos.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
        <p class="modelos">
          <b>Lo llevan</b>
          {smartconnect.modelos.map((m, i) => (
            <>
              {i > 0 && ' · '}
              <a href={m.href}>{m.nombre}</a>
            </>
          ))}
        </p>
      </div>
      <div class="foto negra">
        <img
          src="/img/tecnologia/smartconnect.webp"
          alt="La app SmartConnect en varias tablets: acceso, gráfica del programa y listados"
          width="1400"
          height="715"
          loading="lazy"
        />
      </div>
    </article>

    <!-- El resto: una imagen o un esquema técnico cada uno -->
    <div class="tres">
      {sistemas.map((s) => (
        <article class="sis ap">
          <div class={`vis ${s.id === 'pantalla' ? 'foto' : 'plano'}`}>
            {s.id === 'pantalla' && (
              <img
                src="/img/tecnologia/pantalla-tactil.webp"
                alt="Pantalla táctil de una Consul 22 con rotor, velocidad, FCR y rampas"
                width="1000"
                height="495"
                loading="lazy"
              />
            )}
            {s.id === 'pcbs' && (
              <svg
                viewBox="0 0 600 360"
                role="img"
                aria-label="Esquema: velocidad frente a tiempo con un frenado brusco y otro progresivo"
              >
                <path class="eje" d="M60 40 V300 H570" />
                <text x="60" y="30">
                  rpm
                </text>
                <text x="570" y="332" text-anchor="end">
                  tiempo
                </text>
                <path class="curva" pathLength="1" d="M60 300 C95 300 110 90 150 80 H330" />
                <path class="brusca" d="M330 80 C345 90 352 300 372 300" />
                <path class="media" pathLength="1" d="M330 80 C380 100 410 300 450 300" />
                <path class="suave" pathLength="1" d="M330 80 C430 110 500 300 555 300" />
                <text x="300" y="200" text-anchor="end">
                  brusco
                </text>
                <path class="guia" d="M306 194 H352" />
                <text class="rojo" x="430" y="128">
                  progresivo
                </text>
              </svg>
            )}
            {s.id === 'uls' && (
              <svg
                viewBox="0 0 600 360"
                role="img"
                aria-label="Esquema: rotor visto desde arriba con el vaso 3 señalado por desequilibrio"
              >
                <g transform="translate(220 180)">
                  <circle class="orbita" r="150" />
                  <path class="brazo" d="M-78 -78 L78 78 M78 -78 L-78 78" />
                  <circle class="eje-rotor" r="26" />
                  <circle class="centro" r="9" />
                  <circle class="vaso" cx="-92" cy="-92" r="40" />
                  <circle class="vaso" cx="92" cy="-92" r="40" />
                  <circle class="vaso" cx="-92" cy="92" r="40" />
                  <circle class="vaso mal" cx="92" cy="92" r="40" />
                  <circle class="halo" cx="92" cy="92" r="52" />
                  <text class="n" x="-92" y="-83">
                    1
                  </text>
                  <text class="n" x="92" y="-83">
                    2
                  </text>
                  <text class="n" x="-92" y="101">
                    4
                  </text>
                  <text class="n rojo" x="92" y="101">
                    3
                  </text>
                </g>
                <path class="guia roja" d="M366 272 H410" />
                <rect class="aviso" x="410" y="238" width="170" height="68" />
                <text class="aviso-t" x="424" y="265">
                  Desequilibrio
                </text>
                <text class="aviso-v" x="424" y="290">
                  Vaso 3
                </text>
              </svg>
            )}
          </div>
          <div class="t">
            <h3>{s.nombre}</h3>
            <p>{s.texto}</p>
            <p class="cifra">
              {s.cifra}
              <small>{s.unidad}</small>
            </p>
            <p class="modelos">
              <b>{s.id === 'pantalla' ? 'La llevan' : 'Lo llevan'}</b>
              {'antes' in s && `${s.antes} `}
              {s.modelos.map((m, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={m.href}>{m.nombre}</a>
                </>
              ))}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="ap">
      <p class="frase mas-t">
        Y además, <b>según el modelo</b>:
      </p>
      <dl class="mas">
        {ademas.map((a) => (
          <div>
            <dt>{a.titulo}</dt>
            <dd>{a.texto}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  // Cada bloque entra suave la primera vez que se ve; los esquemas se dibujan solos
  const bloques = document.querySelectorAll('#tecnologia .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    bloques.forEach((b) => obs.observe(b));
  }
</script>

<style>
  .tech {
    --oscuro: #3b4045;
    --mas-oscuro: #2c3034;
    --texto: #c9ced2;
    --raya: #4a5055;
    background: var(--mas-oscuro);
    color: #fff;
    padding-block: clamp(64px, 9vw, 128px);
  }

  .cab {
    display: grid;
    grid-template-columns: 1fr minmax(0, 420px);
    gap: 32px;
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  h2 {
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.94;
  }
  .cab p {
    color: var(--texto);
    font-size: var(--t-sub);
  }

  .frase {
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 300;
    line-height: 1.1;
  }

  /* REI y SmartConnect: foto grande + texto, alternando lados */
  .gran {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    background: var(--oscuro);
  }
  .gran.sc {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    margin-top: clamp(20px, 2vw, 28px);
  }
  .gran .txt {
    padding: clamp(28px, 4vw, 56px);
    background: #33383c;
  }
  .gran h3 {
    font-size: clamp(36px, 3.6vw, 56px);
    line-height: 0.95;
    margin-bottom: 12px;
  }
  .foto {
    position: relative;
    overflow: hidden;
    min-height: 320px;
  }
  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .gran:hover .foto img,
  .sis:hover .foto img {
    transform: scale(1.03);
  }
  .foto.negra {
    background: #000;
  }
  .foto.negra img {
    object-fit: contain;
  }

  .pasos {
    list-style: none;
    margin-top: 22px;
    display: grid;
    gap: 14px;
    counter-reset: paso;
  }
  .pasos li {
    counter-increment: paso;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    align-items: baseline;
    color: #e7eaec;
    font-size: 17px;
  }
  .pasos li::before {
    content: counter(paso);
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
    color: var(--red);
  }
  .puntos {
    list-style: none;
    margin-top: 20px;
    display: grid;
    gap: 10px;
  }
  .puntos li {
    position: relative;
    padding-left: 22px;
    color: #e7eaec;
  }
  .puntos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 2px;
    background: var(--red);
  }
  .video {
    display: inline-block;
    margin-top: 20px;
    color: #fff;
  }

  .modelos {
    margin-top: 22px;
    padding-top: 12px;
    border-top: 1px solid var(--raya);
    font-size: 14px;
    color: var(--texto);
  }
  .modelos b {
    color: #fff;
    margin-right: 6px;
  }
  .modelos a {
    color: var(--texto);
    text-decoration: none;
    padding-bottom: 2px;
    background: linear-gradient(var(--red), var(--red)) 0 100% / 0 2px no-repeat;
    transition:
      color 0.2s,
      background-size 0.3s var(--ease);
  }
  .modelos a:hover,
  .modelos a:focus-visible {
    color: #fff;
    background-size: 100% 2px;
  }

  /* Pantalla, PCBS y ULS */
  .tres {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 28px);
    margin-top: clamp(20px, 2vw, 28px);
  }
  .sis {
    display: flex;
    flex-direction: column;
    background: #33383c;
  }
  .vis {
    position: relative;
    height: 260px;
  }
  .plano {
    background-color: var(--oscuro);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  .plano svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .t {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 24px 26px 26px;
  }
  .t h3 {
    font-size: 28px;
    line-height: 1;
  }
  .t > p:not(.cifra):not(.modelos) {
    margin-top: 10px;
    color: #e7eaec;
  }
  .cifra {
    margin-top: 14px;
    font-weight: 700;
    font-size: 48px;
    line-height: 1;
  }
  .cifra small {
    margin-left: 6px;
    font-size: 16px;
    font-weight: 400;
    color: var(--texto);
  }
  .t .modelos {
    margin-top: auto;
  }
  .t .cifra + .modelos {
    margin-top: 16px;
  }

  /* Esquemas (estilo plano) */
  svg text {
    font-family: var(--f);
    fill: var(--texto);
    font-size: 22px;
  }
  svg .rojo {
    fill: var(--red);
    font-weight: 700;
    font-size: 24px;
  }
  .eje {
    fill: none;
    stroke: #8d949a;
    stroke-width: 1.5;
  }
  .curva {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
  }
  .brusca {
    fill: none;
    stroke: #8d949a;
    stroke-width: 2;
    stroke-dasharray: 5 5;
  }
  .media {
    fill: none;
    stroke: var(--texto);
    stroke-width: 2;
  }
  .suave {
    fill: none;
    stroke: var(--red);
    stroke-width: 3.5;
  }
  .guia {
    stroke: #8d949a;
    stroke-width: 1.5;
  }
  .guia.roja {
    stroke: var(--red);
  }
  .orbita {
    fill: none;
    stroke: #8d949a;
    stroke-width: 1.5;
    stroke-dasharray: 4 6;
  }
  .brazo {
    stroke: var(--texto);
    stroke-width: 10;
    stroke-linecap: round;
  }
  .eje-rotor {
    fill: var(--mas-oscuro);
    stroke: #fff;
    stroke-width: 2;
  }
  .centro {
    fill: var(--red);
  }
  .vaso {
    fill: var(--oscuro);
    stroke: #fff;
    stroke-width: 2;
  }
  .vaso.mal {
    fill: var(--red);
    stroke: var(--red);
  }
  .halo {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.5;
    opacity: 0.6;
  }
  svg .n {
    fill: #fff;
    font-size: 26px;
    font-weight: 700;
    text-anchor: middle;
  }
  svg .n.rojo {
    fill: #fff;
  }
  .aviso {
    fill: #fff;
  }
  svg .aviso-t {
    fill: var(--ink);
    font-size: 18px;
    font-weight: 700;
  }
  svg .aviso-v {
    fill: var(--red);
    font-size: 18px;
    font-weight: 700;
  }

  /* Lo demás */
  .mas-t {
    margin-top: clamp(40px, 4vw, 56px);
  }
  .mas {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 24px;
    border-top: 1px solid var(--raya);
  }
  .mas div {
    padding-top: 18px;
  }
  .mas dt {
    font-weight: 700;
    font-size: 18px;
  }
  .mas dd {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--texto);
  }

  /* ---- Movimiento: entradas, esquemas que se dibujan y efectos al pasar el ratón ---- */
  .ap {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  :global(.js) .tech .ap:not(.vista) {
    opacity: 0;
    transform: translateY(28px);
  }
  .tres .ap:nth-child(2) {
    transition-delay: 0.1s;
  }
  .tres .ap:nth-child(3) {
    transition-delay: 0.2s;
  }
  /* Los pasos del REI aparecen uno detrás de otro */
  .pasos li {
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  .pasos li:nth-child(2) {
    transition-delay: 0.15s;
  }
  .pasos li:nth-child(3) {
    transition-delay: 0.3s;
  }
  :global(.js) .rei:not(.vista) .pasos li {
    opacity: 0;
    transform: translateX(-12px);
  }
  /* PCBS: la curva se dibuja y el frenado progresivo llega el último */
  .curva,
  .media,
  .suave {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.1s var(--ease);
  }
  .media {
    transition-delay: 0.9s;
  }
  .suave {
    transition-duration: 1.4s;
    transition-delay: 1.1s;
  }
  :global(.js) .sis:not(.vista) :is(.curva, .media, .suave) {
    stroke-dashoffset: 1;
  }
  .brusca,
  .rojo,
  .aviso,
  .aviso-t,
  .aviso-v,
  .guia {
    transition: opacity 0.5s var(--ease);
  }
  .brusca,
  svg > text:not(.rojo) {
    transition-delay: 0.8s;
  }
  svg .rojo:not(.n) {
    transition-delay: 2.1s;
  }
  :global(.js) .sis:not(.vista) :is(.brusca, .guia, .rojo, .aviso, .aviso-t, .aviso-v) {
    opacity: 0;
  }
  /* ULS: el vaso con desequilibrio late dos veces y sale el aviso */
  .guia.roja,
  .aviso,
  .aviso-t,
  .aviso-v {
    transition-delay: 0.9s;
  }
  .halo {
    transform-box: fill-box;
    transform-origin: center;
  }
  .sis.vista .halo {
    animation: late 1.2s var(--ease) 0.4s 2;
  }
  @keyframes late {
    0% {
      transform: scale(0.8);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  /* Tarjetas: suben un poco y una raya roja crece arriba, como la barra del filtro de la gama */
  .sis {
    position: relative;
    transition:
      opacity 0.7s var(--ease),
      transform 0.35s var(--ease);
  }
  .sis::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: 0;
    top: 0;
    height: 4px;
    width: 0;
    background: var(--red);
    transition: width 0.4s var(--ease);
  }
  .sis.vista:hover {
    transform: translateY(-4px);
  }
  .sis:hover::before {
    width: 100%;
  }
  /* "Ver el vídeo" y los modelos se subrayan en rojo al pasar el ratón, como "Ver en la gama" */
  .video {
    position: relative;
    padding-bottom: 3px;
  }
  .video::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--red);
    transition: width 0.3s var(--ease);
  }
  .video:hover::before,
  .video:focus-visible::before {
    width: calc(100% - 16px);
  }
  .mas div {
    position: relative;
  }
  .mas div::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 0;
    height: 2px;
    background: var(--red);
    transition: width 0.4s var(--ease);
  }
  .mas div:hover::before {
    width: 48px;
  }

  @media (max-width: 1000px) {
    .cab,
    .gran,
    .gran.sc {
      grid-template-columns: 1fr;
    }
    .gran .foto {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
    .tres {
      grid-template-columns: 1fr;
    }
    .mas {
      grid-template-columns: 1fr 1fr;
      gap: 0 20px;
    }
    .mas div {
      padding-bottom: 6px;
    }
  }
  @media (max-width: 480px) {
    .mas {
      grid-template-columns: 1fr;
    }
  }
</style>
