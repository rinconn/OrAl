---
import { configurador, rei, smartconnect, sistemas } from '../data/tecnologia';
import Borde from './ui/Borde.astro';
import Paso from './Paso.astro';
import { idioma, ruta, textos, unir } from '../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang).tecnologia;
const enlace = (href: string) => ruta(lang, href);
---

<section class="tech" id="tecnologia">
  <Paso desde="#111315" />
  <div class="wrap">
    <div class="cab ap">
      <h2>
        {t.titulo[0]}
        <b>{t.titulo[1]}</b>
      </h2>
      <p>{t.intro}</p>
    </div>

    <!-- Los dos que más os diferencian, a lo grande y con foto real del catálogo -->
    <article class="gran rei ap">
      <Borde lado="arriba" />
      <div class="foto">
        <img src="/img/tecnologia/rei-system.webp" alt={t.rei.alt} width="1400" height="856" loading="lazy" />
      </div>
      <div class="txt">
        <h3>{rei.nombre}</h3>
        <p class="frase">
          {t.rei.frase[0]}
          <b>{t.rei.frase[1]}</b>
          {t.rei.frase[2]}
        </p>
        <ol class="pasos">
          {t.rei.pasos.map((p) => (
            <li>{p}</li>
          ))}
        </ol>
        <a class="arrow video" href={rei.video} target="_blank" rel="noopener">
          {t.rei.video}
        </a>
        <p class="modelos">
          <b>{t.lollevan}</b>
          {rei.modelos.map((m, i) => (
            <>
              {i > 0 && ' · '}
              <a href={enlace(m.href)}>{unir(lang, m.nombres)}</a>
            </>
          ))}
        </p>
      </div>
    </article>

    <!-- SmartConnect y el Configurador, a la par: cada uno con su botón para entrar -->
    <div class="dos">
      <article class="par sc ap">
        <Borde lado="izquierda" />
        <div class="foto negra">
          <img
            src="/img/tecnologia/smartconnect.webp"
            alt={t.smartconnect.alt}
            width="1400"
            height="715"
            loading="lazy"
          />
        </div>
        <div class="txt">
          <h3>{smartconnect.nombre}</h3>
          <p class="frase">
            {t.smartconnect.frase[0]}
            <b>{t.smartconnect.frase[1]}</b>
            {t.smartconnect.frase[2]}
          </p>
          <ul class="puntos">
            {t.smartconnect.puntos.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
          <p class="modelos">
            <b>{t.lollevan}</b>
            {smartconnect.modelos.map((m, i) => (
              <>
                {i > 0 && ' · '}
                <a href={enlace(m.href)}>{unir(lang, m.nombres)}</a>
              </>
            ))}
          </p>
          <a class="btn red entrar" href={smartconnect.acceso} target="_blank" rel="noopener">
            {t.smartconnect.entrar}
          </a>
        </div>
      </article>

      <article class="par cfg ap" id="configurador">
        <Borde lado="derecha" retraso={1.3} />
        <div class="foto">
          <img
            src="/img/tecnologia/configurador.webp"
            alt={t.configurador.alt}
            width="786"
            height="862"
            loading="lazy"
          />
          <p class="seis">
            {t.configurador.cifra}
            <small>{t.configurador.cifraTexto}</small>
          </p>
        </div>
        <div class="txt">
          <h3>{t.configurador.nombre}</h3>
          <p class="frase">
            {t.configurador.frase[0]}
            <b>{t.configurador.frase[1]}</b>
            {t.configurador.frase[2]}
          </p>
          <ol class="seis-pasos">
            {t.configurador.pasos.map((p, i) => (
              <li>
                <span class="ico">
                  <i style={`--ico: url(/img/iconos/${configurador.iconos[i]}.svg)`} />
                </span>
                <span class="paso-t">
                  <b>{i + 1}</b>
                  {p}
                </span>
                <span class="luz" aria-hidden="true" />
              </li>
            ))}
          </ol>
          <a class="btn red entrar" href={configurador.href}>
            {t.configurador.empezar}
          </a>
        </div>
      </article>
    </div>

    <!-- El resto: una imagen o un esquema técnico cada uno -->
    <div class="tres">
      {sistemas.map((s) => (
        <article class="sis ap">
          <Borde
            lado={s.id === 'pantalla' ? 'izquierda' : s.id === 'pcbs' ? 'abajo' : 'derecha'}
            retraso={s.id === 'pantalla' ? 0 : s.id === 'pcbs' ? 0.9 : 1.8}
          />
          <div class={`vis ${s.id === 'pantalla' ? 'foto' : 'plano'}`}>
            {s.id === 'pantalla' && (
              <img
                src="/img/tecnologia/pantalla-tactil.webp"
                alt={t.pantalla.alt}
                width="1000"
                height="495"
                loading="lazy"
              />
            )}
            {s.id === 'pcbs' && (
              <svg viewBox="0 0 600 360" role="img" aria-label={t.pcbs.esquema}>
                <path class="eje" d="M60 40 V300 H570" />
                <text x="60" y="30">
                  rpm
                </text>
                <text x="570" y="332" text-anchor="end">
                  {t.pcbs.tiempo}
                </text>
                <path class="curva" pathLength="1" d="M60 300 C95 300 110 90 150 80 H330" />
                <path class="brusca" d="M330 80 C345 90 352 300 372 300" />
                <path class="media" pathLength="1" d="M330 80 C380 100 410 300 450 300" />
                <path class="suave" pathLength="1" d="M330 80 C430 110 500 300 555 300" />
                <text x="300" y="200" text-anchor="end">
                  {t.pcbs.brusco}
                </text>
                <path class="guia" d="M306 194 H352" />
                <text class="rojo" x="430" y="128">
                  {t.pcbs.progresivo}
                </text>
              </svg>
            )}
            {s.id === 'uls' && (
              <svg viewBox="0 0 600 360" role="img" aria-label={t.uls.esquema}>
                <g transform="translate(220 180)">
                  <circle class="orbita" r="150" />
                  <path class="brazo" d="M-78 -78 L78 78 M78 -78 L-78 78" />
                  <circle class="eje-rotor" r="26" />
                  <circle class="centro" r="9" />
                  <circle class="vaso" cx="-92" cy="-92" r="40" />
                  <circle class="vaso" cx="92" cy="-92" r="40" />
                  <circle class="vaso" cx="-92" cy="92" r="40" />
                  <circle class="vaso mal" cx="92" cy="92" r="40" />
                  <circle class="halo" cx="92" cy="92" r="52" />
                  <text class="n" x="-92" y="-83">
                    1
                  </text>
                  <text class="n" x="92" y="-83">
                    2
                  </text>
                  <text class="n" x="-92" y="101">
                    4
                  </text>
                  <text class="n rojo" x="92" y="101">
                    3
                  </text>
                </g>
                <path class="guia roja" d="M366 272 H410" />
                <rect class="aviso" x="410" y="238" width="170" height="68" />
                <text class="aviso-t" x="424" y="265">
                  {t.uls.desequilibrio}
                </text>
                <text class="aviso-v" x="424" y="290">
                  {t.uls.vaso}
                </text>
              </svg>
            )}
          </div>
          <div class="t">
            <h3>{t[s.id].nombre}</h3>
            <p>{t[s.id].texto}</p>
            <p class="cifra">
              {t[s.id].cifra}
              <small>{t[s.id].unidad}</small>
            </p>
            <p class="modelos">
              <b>{s.id === 'pantalla' ? t.lallevan : t.lollevan}</b>
              {s.id === 'pcbs' && `${t.pcbs.antes} `}
              {s.modelos.map((m, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={enlace(m.href)}>{unir(lang, m.nombres)}</a>
                </>
              ))}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="ap">
      <p class="frase mas-t">
        {t.ademasTitulo[0]}
        <b>{t.ademasTitulo[1]}</b>
        {t.ademasTitulo[2]}
      </p>
      <dl class="mas">
        {t.ademas.map((a) => (
          <div>
            <dt>{a.titulo}</dt>
            <dd>{a.texto}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  // Cada bloque entra suave la primera vez que se ve; los esquemas se dibujan solos
  const bloques = document.querySelectorAll('#tecnologia .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    bloques.forEach((b) => obs.observe(b));
  }
</script>

<style>
  .tech {
    --oscuro: #3b4045;
    --mas-oscuro: #2c3034;
    --texto: #c9ced2;
    --raya: #4a5055;
    position: relative;
    background: var(--mas-oscuro);
    color: #fff;
    padding-block: clamp(64px, 9vw, 128px);
  }
  .tech > .wrap {
    position: relative;
  }

  .cab {
    display: grid;
    grid-template-columns: 1fr minmax(0, 420px);
    gap: 32px;
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  h2 {
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.94;
  }
  .cab p {
    color: var(--texto);
    font-size: var(--t-sub);
  }

  .frase {
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 300;
    line-height: 1.1;
  }

  /* REI y SmartConnect: foto grande + texto, alternando lados */
  .gran {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    background: var(--oscuro);
  }
  .gran {
    position: relative;
  }

  /* SmartConnect y Configurador: dos tarjetas iguales, foto arriba y botón al pie */
  .dos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 28px);
    margin-top: clamp(20px, 2vw, 28px);
  }
  .par {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #33383c;
  }
  .par .foto {
    min-height: 0;
    aspect-ratio: 16 / 8.5;
  }
  .par .txt {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(28px, 3.4vw, 48px);
  }
  .par h3 {
    font-size: clamp(36px, 3.6vw, 56px);
    line-height: 0.95;
    margin-bottom: 12px;
  }
  .par .modelos {
    align-self: stretch;
    margin-bottom: 28px;
  }
  .entrar {
    margin-top: auto;
  }
  .entrar::after {
    content: '»';
    transition: transform 0.2s var(--ease);
  }
  .entrar:hover::after {
    transform: translateX(4px);
  }
  .cfg .foto img {
    object-position: 50% 30%;
  }
  .cfg .foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20, 22, 24, 0.85), rgba(20, 22, 24, 0.2) 60%, transparent);
  }
  .seis {
    position: absolute;
    z-index: 1;
    left: clamp(28px, 3.4vw, 48px);
    bottom: 24px;
    font-weight: 700;
    font-size: clamp(56px, 6vw, 96px);
    line-height: 0.85;
  }
  .seis small {
    display: block;
    margin-top: 8px;
    font-size: 22px;
    font-weight: 300;
  }
  .seis-pasos {
    list-style: none;
    padding: 0;
    align-self: stretch;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 20px;
    margin: 24px 0 28px;
  }
  /* Cada paso, como las placas del inicio: cristal, icono de la marca en un círculo rojo y, al pasar el ratón,
     raya roja arriba, esquina roja, destello de luz y un rojo neón suave */
  .seis-pasos li {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #e7eaec;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.45s var(--ease),
      border-color 0.45s var(--ease);
  }
  .seis-pasos .ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    transition: box-shadow 0.45s var(--ease);
  }
  .seis-pasos .ico i {
    width: 22px;
    height: 22px;
    background: currentColor;
    -webkit-mask: var(--ico) center / contain no-repeat;
    mask: var(--ico) center / contain no-repeat;
  }
  .paso-t b {
    margin-right: 8px;
    color: var(--red);
  }
  .seis-pasos li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--red);
    transition: width 0.4s var(--ease);
  }
  .seis-pasos li::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 14px;
    height: 14px;
    background: rgba(255, 255, 255, 0.22);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
    transition: background 0.3s var(--ease);
  }
  .seis-pasos .luz {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.2) 50%, transparent 70%);
    translate: -110% 0;
    pointer-events: none;
  }
  @media (hover: hover) {
    .seis-pasos li:hover {
      transform: translateY(-3px);
      border-color: rgba(255, 64, 64, 0.5);
      box-shadow:
        0 0 22px -6px rgba(221, 4, 10, 0.55),
        inset 0 0 18px -10px rgba(255, 64, 64, 0.5),
        0 18px 36px -20px rgba(0, 0, 0, 0.8);
    }
    .seis-pasos li:hover::before {
      width: 100%;
    }
    .seis-pasos li:hover::after {
      background: var(--red);
    }
    .seis-pasos li:hover .ico {
      box-shadow: 0 0 16px -2px rgba(255, 40, 40, 0.6);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .seis-pasos li:hover .luz {
      translate: 110% 0;
      transition: translate 0.9s var(--ease);
    }
    .seis-pasos li:hover .ico i {
      animation: salta 0.6s var(--ease);
    }
  }
  @keyframes salta {
    40% {
      transform: scale(1.14) rotate(-6deg);
    }
    70% {
      transform: scale(0.96) rotate(2deg);
    }
  }
  .gran .txt {
    padding: clamp(28px, 4vw, 56px);
    background: #33383c;
  }
  .gran h3 {
    font-size: clamp(36px, 3.6vw, 56px);
    line-height: 0.95;
    margin-bottom: 12px;
  }
  .foto {
    position: relative;
    overflow: hidden;
    min-height: 320px;
  }
  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .gran:hover .foto img,
  .sis:hover .foto img {
    transform: scale(1.03);
  }
  .foto.negra {
    background: #000;
  }
  .foto.negra img {
    object-fit: contain;
  }

  .pasos {
    list-style: none;
    margin-top: 22px;
    display: grid;
    gap: 14px;
    counter-reset: paso;
  }
  .pasos li {
    counter-increment: paso;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    align-items: baseline;
    color: #e7eaec;
    font-size: 17px;
  }
  .pasos li::before {
    content: counter(paso);
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
    color: var(--red);
  }
  .puntos {
    list-style: none;
    margin-top: 20px;
    display: grid;
    gap: 10px;
  }
  .puntos li {
    position: relative;
    padding-left: 22px;
    color: #e7eaec;
  }
  .puntos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 2px;
    background: var(--red);
  }
  .video {
    display: inline-block;
    margin-top: 20px;
    color: #fff;
  }

  .modelos {
    margin-top: 22px;
    padding-top: 12px;
    border-top: 1px solid var(--raya);
    font-size: 14px;
    color: var(--texto);
  }
  .modelos b {
    color: #fff;
    margin-right: 6px;
  }
  .modelos a {
    color: var(--texto);
    text-decoration: none;
    padding-bottom: 2px;
    background: linear-gradient(var(--red), var(--red)) 0 100% / 0 2px no-repeat;
    transition:
      color 0.2s,
      background-size 0.3s var(--ease);
  }
  .modelos a:hover,
  .modelos a:focus-visible {
    color: #fff;
    background-size: 100% 2px;
  }

  /* Pantalla, PCBS y ULS */
  .tres {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 28px);
    margin-top: clamp(20px, 2vw, 28px);
  }
  .sis {
    display: flex;
    flex-direction: column;
    background: #33383c;
  }
  .vis {
    position: relative;
    height: 260px;
  }
  .plano {
    background-color: var(--oscuro);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  .plano svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .t {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 24px 26px 26px;
  }
  .t h3 {
    font-size: 28px;
    line-height: 1;
  }
  .t > p:not(.cifra):not(.modelos) {
    margin-top: 10px;
    color: #e7eaec;
  }
  .cifra {
    margin-top: 14px;
    font-weight: 700;
    font-size: 48px;
    line-height: 1;
  }
  .cifra small {
    margin-left: 6px;
    font-size: 16px;
    font-weight: 400;
    color: var(--texto);
  }
  .t .modelos {
    margin-top: auto;
  }
  .t .cifra + .modelos {
    margin-top: 16px;
  }

  /* Esquemas (estilo plano) */
  svg text {
    font-family: var(--f);
    fill: var(--texto);
    font-size: 22px;
  }
  svg .rojo {
    fill: var(--red);
    font-weight: 700;
    font-size: 24px;
  }
  .eje {
    fill: none;
    stroke: #8d949a;
    stroke-width: 1.5;
  }
  .curva {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
  }
  .brusca {
    fill: none;
    stroke: #8d949a;
    stroke-width: 2;
    stroke-dasharray: 5 5;
  }
  .media {
    fill: none;
    stroke: var(--texto);
    stroke-width: 2;
  }
  .suave {
    fill: none;
    stroke: var(--red);
    stroke-width: 3.5;
  }
  .guia {
    stroke: #8d949a;
    stroke-width: 1.5;
  }
  .guia.roja {
    stroke: var(--red);
  }
  .orbita {
    fill: none;
    stroke: #8d949a;
    stroke-width: 1.5;
    stroke-dasharray: 4 6;
  }
  .brazo {
    stroke: var(--texto);
    stroke-width: 10;
    stroke-linecap: round;
  }
  .eje-rotor {
    fill: var(--mas-oscuro);
    stroke: #fff;
    stroke-width: 2;
  }
  .centro {
    fill: var(--red);
  }
  .vaso {
    fill: var(--oscuro);
    stroke: #fff;
    stroke-width: 2;
  }
  .vaso.mal {
    fill: var(--red);
    stroke: var(--red);
  }
  .halo {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.5;
    opacity: 0.6;
  }
  svg .n {
    fill: #fff;
    font-size: 26px;
    font-weight: 700;
    text-anchor: middle;
  }
  svg .n.rojo {
    fill: #fff;
  }
  .aviso {
    fill: #fff;
  }
  svg .aviso-t {
    fill: var(--ink);
    font-size: 18px;
    font-weight: 700;
  }
  svg .aviso-v {
    fill: var(--red);
    font-size: 18px;
    font-weight: 700;
  }

  /* Lo demás */
  .mas-t {
    margin-top: clamp(40px, 4vw, 56px);
  }
  .mas {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 24px;
    border-top: 1px solid var(--raya);
  }
  .mas div {
    padding-top: 18px;
  }
  .mas dt {
    font-weight: 700;
    font-size: 18px;
  }
  .mas dd {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--texto);
  }

  /* ---- Movimiento: entradas, esquemas que se dibujan y efectos al pasar el ratón ---- */
  .ap {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
