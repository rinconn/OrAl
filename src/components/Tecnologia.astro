---
import { configurador, rei, smartconnect } from '../data/tecnologia';
import Borde from './ui/Borde.astro';
import Paso from './Paso.astro';
import { idioma, ruta, textos, unir } from '../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang).tecnologia;
const enlace = (href: string) => ruta(lang, href);
---

<section class="tech" id="tecnologia">
  <Paso desde="#111315" />
  <div class="wrap">
    <div class="cab ap">
      <h2>
        {t.titulo[0]}
        <b>{t.titulo[1]}</b>
      </h2>
      <p>{t.intro}</p>
    </div>

    <!-- Acordeón: tres franjas; la abierta enseña foto y texto, las cerradas son tiras con número y nombre en
         vertical. Al abrir una, una cortina roja barre la foto y la descubre -->
    <div class="acordeon ap">
      <Borde lado="arriba" />
      {[rei.nombre, smartconnect.nombre, t.configurador.nombre].map((nombre, i) => (
        <article class:list={['panel', ['rei', 'sc', 'cfg'][i], { abierto: i === 0 }]}>
          <span id={['rei-system', 'smartconnect', 'configurador'][i]} class="ancla" />

          <button
            class="lomo"
            type="button"
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`tec-${i}`}
            tabindex={i === 0 ? -1 : undefined}
          >
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="nombre">{nombre}</span>
            <span class="mas" aria-hidden="true" />
          </button>

          <div class="contenido" id={`tec-${i}`} inert={i !== 0}>
            {i === 0 && (
              <>
                <div class="foto">
                  <img src="/img/tecnologia/rei-system.webp" alt={t.rei.alt} width="1400" height="856" loading="lazy" />
                </div>
                <div class="txt">
                  <h3>{rei.nombre}</h3>
                  <p class="frase">
                    {t.rei.frase[0]}
                    <b>{t.rei.frase[1]}</b>
                    {t.rei.frase[2]}
                  </p>
                  <ol class="pasos">
                    {t.rei.pasos.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ol>
                  <a class="arrow video" href={rei.video} target="_blank" rel="noopener">
                    {t.rei.video}
                  </a>
                  <p class="modelos">
                    <b>{t.lollevan}</b>
                    {rei.modelos.map((m, j) => (
                      <>
                        {j > 0 && ' · '}
                        <a href={enlace(m.href)}>{unir(lang, m.nombres)}</a>
                      </>
                    ))}
                  </p>
                </div>
              </>
            )}

            {i === 1 && (
              <>
                <div class="foto negra">
                  <img
                    src="/img/tecnologia/smartconnect.webp"
                    alt={t.smartconnect.alt}
                    width="1400"
                    height="715"
                    loading="lazy"
                  />
                </div>
                <div class="txt">
                  <h3>{smartconnect.nombre}</h3>
                  <p class="frase">
                    {t.smartconnect.frase[0]}
                    <b>{t.smartconnect.frase[1]}</b>
                    {t.smartconnect.frase[2]}
                  </p>
                  <ul class="puntos">
                    {t.smartconnect.puntos.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                  <p class="modelos">
                    <b>{t.lollevan}</b>
                    {smartconnect.modelos.map((m, j) => (
                      <>
                        {j > 0 && ' · '}
                        <a href={enlace(m.href)}>{unir(lang, m.nombres)}</a>
                      </>
                    ))}
                  </p>
                  <a class="btn red entrar" href={smartconnect.acceso} target="_blank" rel="noopener">
                    {t.smartconnect.entrar}
                  </a>
                </div>
              </>
            )}

            {i === 2 && (
              <>
                <div class="foto">
                  <img
                    src="/img/tecnologia/configurador.webp"
                    alt={t.configurador.alt}
                    width="786"
                    height="862"
                    loading="lazy"
                  />
                  <p class="seis">
                    {t.configurador.cifra}
                    <small>{t.configurador.cifraTexto}</small>
                  </p>
                </div>
                <div class="txt">
                  <h3>{t.configurador.nombre}</h3>
                  <p class="frase">
                    {t.configurador.frase[0]}
                    <b>{t.configurador.frase[1]}</b>
                    {t.configurador.frase[2]}
                  </p>
                  <ol class="seis-pasos">
                    {t.configurador.pasos.map((p, j) => (
                      <li>
                        <span class="ico">
                          <i style={`--ico: url(/img/iconos/${configurador.iconos[j]}.svg)`} />
                        </span>
                        <span class="paso-t">
                          <b>{j + 1}</b>
                          {p}
                        </span>
                        <span class="luz" aria-hidden="true" />
                      </li>
                    ))}
                  </ol>
                  <a class="btn red entrar" href={configurador.href}>
                    {t.configurador.empezar}
                  </a>
                </div>
              </>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Cada bloque entra suave la primera vez que se ve
  const bloques = document.querySelectorAll('#tecnologia .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    bloques.forEach((b) => obs.observe(b));
  }

  // Acordeón: al pulsar una tira se abre su panel y se cierra el que estaba abierto. Lo cerrado queda inerte para
  // que el tabulador no se meta en texto que no se ve.
  const acordeon = document.querySelector<HTMLElement>('#tecnologia .acordeon');
  if (acordeon) {
    const paneles = [...acordeon.querySelectorAll<HTMLElement>('.panel')];
    const abrir = (i: number) => {
      paneles.forEach((p, j) => {
        const si = j === i;
        p.classList.toggle('abierto', si);
        const lomo = p.querySelector<HTMLButtonElement>('.lomo');
        if (lomo) {
          lomo.setAttribute('aria-expanded', String(si));
          lomo.tabIndex = si ? -1 : 0;
        }
        p.querySelector('.contenido')?.toggleAttribute('inert', !si);
      });
      // La cabecera marca en el menú el enlace del panel abierto
      document.dispatchEvent(new Event('panel-abierto'));
    };
    paneles.forEach((p, i) => p.querySelector('.lomo')?.addEventListener('click', () => abrir(i)));
    // Los enlaces del menú (#rei-system, #smartconnect, #configurador) y "Empezar" abren su panel, también si se
    // pulsan con ese mismo ancla ya en la dirección
    const anclas = paneles.map((p) => p.querySelector('.ancla')?.id);
    const alAncla = (hash: string) => {
      const i = anclas.indexOf(hash.slice(1));
      if (i >= 0) abrir(i);
    };
    window.addEventListener('hashchange', () => alAncla(location.hash));
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]');
      if (a && a.pathname === location.pathname) alAncla(a.hash);
    });
    alAncla(location.hash);
  }
</script>

<style>
  .tech {
    --oscuro: #3b4045;
    --mas-oscuro: #2c3034;
    --texto: #c9ced2;
    --raya: #4a5055;
    position: relative;
    background: var(--mas-oscuro);
    color: #fff;
    padding-block: clamp(64px, 9vw, 128px);
  }
  .tech > .wrap {
    position: relative;
  }

  .cab {
    display: grid;
    grid-template-columns: 1fr minmax(0, 420px);
    gap: 32px;
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  h2 {
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.94;
  }
  /* "propia" en rojo, como "ción" en el titular del inicio */
  h2 b {
    color: var(--red);
  }
  .cab p {
    color: var(--texto);
    font-size: var(--t-sub);
  }

  .frase {
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 300;
    line-height: 1.1;
  }

  /* Acordeón: tres franjas en fila. La abierta crece y enseña foto y texto; las cerradas se quedan en tiras
     con su número, el nombre en vertical y un "+" */
  .acordeon {
    --lomo: 92px;
    --hueco: 12px;
    position: relative;
    display: flex;
    gap: var(--hueco);
    height: clamp(560px, 44vw, 620px);
    container-type: inline-size;
  }
  .panel {
    position: relative;
    flex: 0 0 var(--lomo);
    overflow: hidden;
    background: #33383c;
    transition: flex-grow 0.7s var(--ease);
  }
  .panel.abierto {
    flex-grow: 1;
  }
  .ancla {
    position: absolute;
    top: -120px;
  }
  /* El contenido tiene siempre el ancho del panel abierto: al abrirse no se recoloca, solo se destapa */
  .contenido {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(100cqw - 2 * (var(--lomo) + var(--hueco)));
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }
  .contenido .foto {
    min-height: 0;
  }
  .contenido .txt {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(28px, 3vw, 48px);
    transition: opacity 0.35s var(--ease) 0.35s;
  }
  .panel:not(.abierto) .txt,
  .panel:not(.abierto) .seis {
    opacity: 0;
    transition-delay: 0s;
  }
  .panel h3 {
    font-size: clamp(36px, 3.4vw, 52px);
    line-height: 0.95;
    margin-bottom: 12px;
  }
  .panel .modelos {
    align-self: stretch;
    margin-bottom: 26px;
  }
  .rei .modelos {
    margin-bottom: 0;
  }

  /* Tira de un panel cerrado: deja ver un trozo de su foto por debajo */
  .lomo {
    position: absolute;
    z-index: 4;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 26px 0;
    border: 0;
    background: linear-gradient(180deg, rgba(36, 39, 42, 0.7), rgba(36, 39, 42, 0.94));
    color: #fff;
    font: inherit;
    cursor: pointer;
    transition:
      opacity 0.3s var(--ease),
      background 0.3s var(--ease);
  }
  .lomo::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: 0;
    background: var(--red);
    transition: height 0.4s var(--ease);
  }
  .lomo:hover,
  .lomo:focus-visible {
    background: linear-gradient(180deg, rgba(36, 39, 42, 0.45), rgba(36, 39, 42, 0.85));
  }
  .lomo:hover::before,
  .lomo:focus-visible::before {
    height: 100%;
  }
  .lomo .num {
    font-size: 15px;
    font-weight: 700;
    color: var(--red);
  }
  .lomo .nombre {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-size: 26px;
    font-weight: 700;
    white-space: nowrap;
  }
  .lomo .mas {
    position: relative;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    transition:
      background 0.3s,
      border-color 0.3s;
  }
  .lomo .mas::before,
  .lomo .mas::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    background: #fff;
    translate: -50% -50%;
    transition: rotate 0.3s var(--ease);
  }
  .lomo .mas::after {
    rotate: 90deg;
  }
  .lomo:hover .mas,
  .lomo:focus-visible .mas {
    background: var(--red);
    border-color: var(--red);
  }
  .abierto .lomo {
    opacity: 0;
    pointer-events: none;
  }

  /* Cortina roja: barre la foto del panel que se abre y, al retirarse, la descubre */
  .contenido .foto::before {
    content: '';
    position: absolute;
    z-index: 3;
    inset: 0;
    background: var(--red);
    transform: scaleX(0);
    pointer-events: none;
  }
  .entrar {
    margin-top: auto;
  }
  .entrar::after {
    content: '»';
    transition: transform 0.2s var(--ease);
  }
  .entrar:hover::after {
    transform: translateX(4px);
  }
  .cfg .foto img {
    object-position: 50% 30%;
  }
  .cfg .foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20, 22, 24, 0.85), rgba(20, 22, 24, 0.2) 60%, transparent);
  }
  .seis {
    position: absolute;
    z-index: 1;
    left: clamp(28px, 3.4vw, 48px);
    bottom: 28px;
    font-weight: 700;
    font-size: clamp(56px, 6vw, 96px);
    line-height: 0.85;
  }
  .seis small {
    display: block;
    margin-top: 8px;
    font-size: 22px;
    font-weight: 300;
  }
  .seis-pasos {
    list-style: none;
    padding: 0;
    align-self: stretch;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 14px;
    margin: 22px 0 26px;
  }
  /* Cada paso, como las placas del inicio: cristal, icono de la marca en un círculo rojo y, al pasar el ratón,
     raya roja arriba, esquina roja, destello de luz y un rojo neón suave */
  .seis-pasos li {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    font-size: 15px;
    line-height: 1.2;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #e7eaec;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.45s var(--ease),
      border-color 0.45s var(--ease);
  }
  .seis-pasos .ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    transition: box-shadow 0.45s var(--ease);
  }
  .seis-pasos .ico i {
    width: 20px;
    height: 20px;
    background: currentColor;
    -webkit-mask: var(--ico) center / contain no-repeat;
    mask: var(--ico) center / contain no-repeat;
  }
  .paso-t b {
    margin-right: 6px;
    color: var(--red);
  }
  .seis-pasos li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--red);
    transition: width 0.4s var(--ease);
  }
  .seis-pasos li::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 14px;
    height: 14px;
    background: rgba(255, 255, 255, 0.22);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
    transition: background 0.3s var(--ease);
  }
  .seis-pasos .luz {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.2) 50%, transparent 70%);
    translate: -110% 0;
    pointer-events: none;
  }
  @media (hover: hover) {
    .seis-pasos li:hover {
      transform: translateY(-3px);
      border-color: rgba(255, 64, 64, 0.5);
      box-shadow:
        0 0 22px -6px rgba(221, 4, 10, 0.55),
        inset 0 0 18px -10px rgba(255, 64, 64, 0.5),
        0 18px 36px -20px rgba(0, 0, 0, 0.8);
    }
    .seis-pasos li:hover::before {
      width: 100%;
    }
    .seis-pasos li:hover::after {
      background: var(--red);
    }
    .seis-pasos li:hover .ico {
      box-shadow: 0 0 16px -2px rgba(255, 40, 40, 0.6);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .seis-pasos li:hover .luz {
      translate: 110% 0;
      transition: translate 0.9s var(--ease);
    }
    .seis-pasos li:hover .ico i {
      animation: salta 0.6s var(--ease);
    }
  }
  @keyframes salta {
    40% {
      transform: scale(1.14) rotate(-6deg);
    }
    70% {
      transform: scale(0.96) rotate(2deg);
    }
  }
  .foto {
    position: relative;
    overflow: hidden;
    min-height: 320px;
  }
  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .abierto:hover .foto img {
    transform: scale(1.03);
  }
  .foto.negra {
    background: #000;
  }
  .foto.negra img {
    object-fit: contain;
  }

  .pasos {
    list-style: none;
    margin-top: 22px;
    display: grid;
    gap: 14px;
    counter-reset: paso;
  }
  .pasos li {
    counter-increment: paso;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    align-items: baseline;
    color: #e7eaec;
    font-size: 17px;
  }
  .pasos li::before {
    content: counter(paso);
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
    color: var(--red);
  }
  .puntos {
    list-style: none;
    margin-top: 20px;
    display: grid;
    gap: 10px;
  }
  .puntos li {
    position: relative;
    padding-left: 22px;
    color: #e7eaec;
  }
  .puntos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 2px;
    background: var(--red);
  }
  .video {
    display: inline-block;
    margin-top: 20px;
    color: #fff;
  }

  .modelos {
    margin-top: 22px;
    padding-top: 12px;
    border-top: 1px solid var(--raya);
    font-size: 14px;
    color: var(--texto);
  }
  .modelos b {
    color: #fff;
    margin-right: 6px;
  }
  .modelos a {
    color: var(--texto);
    text-decoration: none;
    padding-bottom: 2px;
    background: linear-gradient(var(--red), var(--red)) 0 100% / 0 2px no-repeat;
    transition:
      color 0.2s,
      background-size 0.3s var(--ease);
  }
  .modelos a:hover,
  .modelos a:focus-visible {
    color: #fff;
    background-size: 100% 2px;
  }

  /* ---- Movimiento: entradas, esquemas que se dibujan y efectos al pasar el ratón ---- */
  .ap {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  :global(.js) .tech .ap:not(.vista) {
    opacity: 0;
    transform: translateY(28px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .acordeon.vista .abierto .foto::before {
      animation: cortina 1.1s var(--ease) 0.15s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel,
    .contenido .txt {
      transition: none;
    }
  }
  @keyframes cortina {
    0% {
      transform: scaleX(0);
      transform-origin: left;
    }
    45% {
      transform: scaleX(1);
      transform-origin: left;
    }
    55% {
      transform: scaleX(1);
      transform-origin: right;
    }
    100% {
      transform: scaleX(0);
      transform-origin: right;
    }
  }
  /* Los pasos del REI aparecen uno detrás de otro */
  .pasos li {
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  .pasos li:nth-child(2) {
    transition-delay: 0.15s;
  }
  .pasos li:nth-child(3) {
    transition-delay: 0.3s;
  }
  :global(.js) .acordeon:not(.vista) .rei .pasos li {
    opacity: 0;
    transform: translateX(-12px);
  }
  /* "Ver el vídeo" y los modelos se subrayan en rojo al pasar el ratón, como "Ver en la gama" */
  .video {
    position: relative;
    padding-bottom: 3px;
  }
  .video::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--red);
    transition: width 0.3s var(--ease);
  }
  .video:hover::before,
  .video:focus-visible::before {
    width: calc(100% - 16px);
  }

  @media (max-width: 1000px) {
    .cab {
      grid-template-columns: 1fr;
    }
  }
  /* Tablet y móvil: las franjas, una encima de otra; la tira pasa a cabecera y el panel abierto, foto y texto */
  @media (max-width: 1000px) {
    .acordeon {
      flex-direction: column;
      height: auto;
      gap: 10px;
    }
    .panel {
      flex: none;
    }
    .lomo {
      position: relative;
      inset: auto;
      width: 100%;
      flex-direction: row;
      justify-content: flex-start;
      gap: 14px;
      padding: 18px 20px;
      background: #33383c;
    }
    .lomo .nombre {
      writing-mode: horizontal-tb;
      rotate: none;
      font-size: 20px;
    }
    .lomo .mas {
      margin-left: auto;
    }
    .abierto .lomo {
      opacity: 1;
    }
    .abierto .lomo .mas::after {
      rotate: 0deg;
    }
    .contenido {
      position: static;
      width: auto;
      display: none;
      grid-template-columns: 1fr;
    }
    .abierto .contenido {
      display: grid;
    }
    .contenido .foto {
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 480px) {
    .seis-pasos {
      grid-template-columns: 1fr;
    }
  }
</style>
