---
// Las razones para el distribuidor, contadas como el recorrido de un pedido.
// Fuentes: catálogo 2025 ("¿Qué nos diferencia?", garantía, OEM) y web actual (plazo de entrega).
// Cada parada proyecta un rotor; cada rotor lleva más tubos que el anterior, como el pedido que avanza.
// Hueco preparado: cuando la empresa pase los CAD, el dibujo de cada rotor se cambia por su modelo real
// (ver docs/pendiente-empresa.md) sin tocar la ruta ni los textos.
const pasos = [
  {
    cuando: 'Haces el pedido',
    cifra: 'Stock',
    titulo: 'Siempre disponible',
    texto: 'Stock continuo de toda la gama.',
    tubos: 4,
  },
  {
    cuando: 'Llega a tu almacén en',
    cifra: '1',
    unidad: 'semana',
    titulo: 'Entrega rápida',
    texto: 'Plazo medio de entrega, gracias al stock continuo.',
    tubos: 6,
  },
  {
    cuando: 'Si tienes una duda, respuesta en',
    cifra: '48',
    unidad: 'h',
    titulo: 'Asesoramiento',
    texto: 'Puesta en marcha, incidencias, reparaciones y formación técnica online.',
    tubos: 8,
  },
  {
    cuando: 'Tu cliente, cubierto durante',
    cifra: '3',
    unidad: 'años',
    titulo: 'Garantía sin sorpresas',
    texto: 'En todas las centrífugas nuevas, salvo la Minicen (14 meses).',
    tubos: 12,
  },
];

// La ruta (lienzo de 1200 x 640: el ancho se estira, el alto es fijo en píxeles) y el punto exacto de cada parada sobre ella.
// Las paradas están al 16, 39, 63 y 84 % del recorrido; la línea se dibuja a ritmo constante,
// así que cada rotor sale justo cuando la línea llega a él.
const ruta =
  'M0,300 C120,300 150,300 190,300 C340,300 360,345 470,345 C580,345 600,300 760,300 C880,300 900,345 1010,345 C1100,345 1150,335 1200,325';
const paradas = [
  { x: 196.7, y: 300, t: 0.16 },
  { x: 470.9, y: 345, t: 0.39 },
  { x: 757.6, y: 300, t: 0.63 },
  { x: 1006.3, y: 345, t: 0.84 },
];
const DIBUJO = 2.6; // segundos que tarda la línea

// Rotor visto desde arriba: aro, radios, tubos y eje rojo.
function rotor(n: number) {
  const r = n > 8 ? 6 : 8;
  const d = n > 8 ? 31 : 29;
  let s =
    '<circle cx="50" cy="50" r="48" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.85)" stroke-width="1.6"/>' +
    '<circle cx="50" cy="50" r="41" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1"/>';
  for (let i = 0; i < n; i++) {
    const a = (i / n) * 2 * Math.PI;
    const c = Math.cos(a);
    const sn = Math.sin(a);
    s +=
      `<line x1="50" y1="50" x2="${(50 + 40 * c).toFixed(1)}" y2="${(50 + 40 * sn).toFixed(1)}" stroke="rgba(255,255,255,.18)"/>` +
      `<circle cx="${(50 + d * c).toFixed(1)}" cy="${(50 + d * sn).toFixed(1)}" r="${r}" fill="rgba(21,24,27,.6)" stroke="#fff" stroke-width="1.4"/>`;
  }
  return s + '<circle cx="50" cy="50" r="11" fill="#dd040a"/><circle cx="50" cy="50" r="4" fill="#fff"/>';
}

// Siluetas de rotor del fondo: una grande a la derecha (12 tubos) y otra menor a la izquierda (6 tubos)
// que gira al revés. Aro, eje y uno de cada tres tubos en rojo.
function silueta(n: number) {
  let s =
    '<circle class="aro" cx="50" cy="50" r="49"/><circle cx="50" cy="50" r="45"/>' +
    '<circle class="eje" cx="50" cy="50" r="9"/><circle cx="50" cy="50" r="4"/>';
  for (let i = 0; i < n; i++) {
    const a = (i / n) * 2 * Math.PI;
    const c = Math.cos(a);
    const sn = Math.sin(a);
    s +=
      `<circle${i % 3 ? '' : ' class="tubo"'} cx="${(50 + 32 * c).toFixed(2)}" cy="${(50 + 32 * sn).toFixed(2)}" r="${n > 8 ? 6.5 : 8}"/>` +
      `<line x1="${(50 + 11 * c).toFixed(2)}" y1="${(50 + 11 * sn).toFixed(2)}" x2="${(50 + 24 * c).toFixed(2)}" y2="${(50 + 24 * sn).toFixed(2)}"/>`;
  }
  return s;
}
---

<section class="sec dist" id="distribuidores">
  <div class="fondo" aria-hidden="true"></div>
  <svg class="silueta dcha" viewBox="0 0 100 100" aria-hidden="true" set:html={silueta(12)} />
  <svg class="silueta izq" viewBox="0 0 100 100" aria-hidden="true" set:html={silueta(6)} />
  <div class="wrap">
    <div class="cab ap">
      <h2>
        Crece con <b>nosotros</b>
      </h2>
      <div>
        <p class="lead">
          Una empresa familiar que trata a cada distribuidor como socio. Así funciona un pedido con Orto Alresa.
        </p>
        <a class="lab" href="#contacto">
          ¿Eres un laboratorio? Encuentra tu distribuidor <i aria-hidden="true">»</i>
        </a>
      </div>
    </div>

    <div class="ruta" style={`--dibujo:${DIBUJO}s`}>
      <svg class="linea" viewBox="0 0 1200 640" preserveAspectRatio="none" aria-hidden="true">
        <path class="guia" d={ruta}></path>
        <path class="traz" d={ruta}></path>
      </svg>
      <ol>
        {pasos.map((p, i) => {
          const q = paradas[i];
          const t = (DIBUJO * q.t - 0.1).toFixed(2);
          return (
            <li
              class={i % 2 ? 'abajo' : 'arriba'}
              style={`--x:${((q.x / 1200) * 100).toFixed(2)}%;--y:${q.y}px;--t:${t}s;--w:${84 + i * 8}px;--i:${i}`}
            >
              <div class="rotor" aria-hidden="true" data-tubos={p.tubos}>
                <div class="haz" />
                <div class="suelo" />
                <div class="escena">
                  <div class="plato">
                    <svg class="bajo" viewBox="0 0 100 100" set:html={rotor(p.tubos)} />
                    <svg viewBox="0 0 100 100" set:html={rotor(p.tubos)} />
                  </div>
                </div>
              </div>
              <div class="texto">
                <span class="cuando">{p.cuando}</span>
                <strong>
                  {p.cifra}
                  {p.unidad && <small>{p.unidad}</small>}
                </strong>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>

    <div class="pie ap">
      <div>
        <h3>
          ¿Necesitas un equipo <b>a medida</b>?
        </h3>
        <p>Fabricación OEM a medida, con análisis de riesgos y trazabilidad de origen a usuario.</p>
      </div>
      <a class="btn red" href="#contacto">
        Hazte distribuidor <span aria-hidden="true">»</span>
      </a>
    </div>

    <p class="why">
      <b>Antes:</b> no había nada para distribuidores y el formulario ponía "Cliente final" primero.
      <b>Ahora:</b> una sección que habla al cliente real: el recorrido de su pedido se dibuja sobre un fondo de
      laboratorio y cada parada proyecta un rotor, con un solo botón claro.
    </p>
  </div>
</section>

<script>
  const sec = document.getElementById('distribuidores');
  if (sec && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');

    // Cada bloque entra la primera vez que se ve; la ruta se dibuja y proyecta sus rotores
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    sec.querySelectorAll('.ap, .ruta').forEach((b) => obs.observe(b));
    // Las siluetas del fondo solo giran mientras la sección se ve
    new IntersectionObserver(([e]) => sec.classList.toggle('activa', e.isIntersecting)).observe(sec);
  }
</script>

<style>
  /* Sección oscura: foto de laboratorio, dos siluetas de rotor girando despacio y el contenido delante */
  .dist {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #15181b;
    color: #fff;
  }
  .fondo {
    position: absolute;
    inset: -20px;
    z-index: -1;
    background: url('/img/fotos/lab-235.webp') center / cover;
    filter: blur(4px) grayscale(0.4) brightness(0.5);
  }
  .dist::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 70% 45%, rgba(21, 24, 27, 0.35), rgba(21, 24, 27, 0.85));
  }
  .silueta {
    position: absolute;
    aspect-ratio: 1;
    fill: none;
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 0.14;
    will-change: transform;
    animation: gira 240s linear infinite;
  }
  .silueta :global(.aro),
  .silueta :global(.tubo) {
    stroke: rgba(221, 4, 10, 0.38);
    stroke-width: 0.22;
  }
  .silueta :global(.eje) {
    stroke: rgba(221, 4, 10, 0.5);
  }
  /* Solo gira mientras la sección está a la vista */
  .dist:not(:global(.activa)) .silueta {
    animation-play-state: paused;
  }
  .dcha {
    top: 50%;
    right: -16%;
    width: clamp(560px, 70vw, 1100px);
    translate: 0 -50%;
  }
  .izq {
    left: -9%;
    bottom: -6%;
    width: clamp(260px, 30vw, 460px);
    animation-direction: reverse;
    animation-duration: 160s;
  }
  .wrap {
    position: relative;
    z-index: 1;
  }

  /* Cabecera: título grande a la izquierda, entradilla a la derecha */
  .cab {
    display: grid;
    grid-template-columns: 1fr minmax(0, 440px);
    gap: 24px 64px;
    align-items: end;
  }
  h2 {
    margin: 0;
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.95;
    text-wrap: balance;
  }
  h2 b {
    color: var(--red);
  }
  .lead {
    margin: 0;
    color: #c9ced2;
    font-size: var(--t-sub);
    max-width: 44ch;
  }

  /* La ruta: 640 px de alto; en horizontal, rotores y textos colocados en porcentajes */
  .ruta {
    position: relative;
    margin-top: clamp(24px, 3vw, 40px);
  }
  @media (min-width: 901px) {
    .ruta {
      height: 640px;
    }
    li {
      display: contents;
    }
    .rotor {
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: var(--w);
      transform: translate(-50%, -100%);
    }
    .abajo .rotor {
      transform: translate(-50%, 0);
    }
    .texto {
      position: absolute;
      width: 22%;
    }
    li:nth-child(1) .texto {
      left: 3%;
      top: 0;
    }
    li:nth-child(2) .texto {
      left: 30%;
      top: 455px;
    }
    li:nth-child(3) .texto {
      left: 56%;
      top: 0;
    }
    li:nth-child(4) .texto {
      left: 77%;
      top: 455px;
    }
  }
  .linea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .guia,
  .traz {
    fill: none;
    stroke-linecap: round;
  }
  .guia {
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 2;
  }
  .traz {
    stroke: var(--red);
    stroke-width: 2.5;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Rotor proyectado: haz de luz desde la línea, brillo en el suelo y el rotor girando en 3D */
  .haz {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 70%;
    height: 100%;
    transform: translateX(-50%);
    transform-origin: bottom;
    background: linear-gradient(to top, rgba(221, 4, 10, 0.55), rgba(221, 4, 10, 0.12) 55%, transparent);
    clip-path: polygon(44% 100%, 56% 100%, 100% 42%, 0 42%);
  }
  .suelo {
    position: absolute;
    left: 50%;
    bottom: -7px;
    width: 44px;
    height: 14px;
    margin-left: -22px;
    border-radius: 50%;
    background: radial-gradient(rgba(255, 80, 80, 0.9), rgba(221, 4, 10, 0) 70%);
  }
  .escena {
    position: relative;
    aspect-ratio: 1;
    margin-bottom: 20%;
    perspective: 500px;
  }
  .plato {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(64deg);
  }
  .plato svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: gira 7s linear infinite;
  }
  /* Una segunda capa más abajo y más tenue da el grosor del rotor */
  .plato .bajo {
    transform: translateZ(-9px);
    opacity: 0.35;
  }
  .abajo .haz {
    top: 0;
    bottom: auto;
    transform-origin: top;
    background: linear-gradient(to bottom, rgba(221, 4, 10, 0.55), rgba(221, 4, 10, 0.12) 55%, transparent);
    clip-path: polygon(44% 0, 56% 0, 100% 58%, 0 58%);
  }
  .abajo .suelo {
    top: -7px;
    bottom: auto;
  }
  .abajo .escena {
    margin: 20% 0 0;
  }
  li:hover .haz {
    filter: brightness(1.35);
  }

  .cuando {
    font-size: 15px;
    color: #b9bfc4;
  }
  strong {
    display: block;
    margin-top: 4px;
    font-size: clamp(40px, 4vw, 60px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  strong small {
    margin-left: 6px;
    font-size: 0.38em;
    font-weight: 300;
    letter-spacing: 0;
  }
  .texto h3 {
    margin: 10px 0 4px;
    font-size: 18px;
  }
  .texto p {
    margin: 0;
    color: #d6dadd;
    max-width: 28ch;
  }

  /* Remate: OEM y el botón, en un panel gris translúcido sobre el fondo */
  .pie {
    margin-top: clamp(40px, 5vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    padding: clamp(28px, 4vw, 48px);
    background: rgba(59, 64, 69, 0.72);
    color: #fff;
  }
  .pie h3 {
    margin: 0;
    font-weight: 300;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.05;
  }
  .pie h3 b {
    font-weight: 700;
  }
  .pie p {
    margin: 10px 0 0;
    color: #c9ced2;
    max-width: 52ch;
  }
  .btn span {
    transition: transform 0.25s var(--ease);
  }
  .btn:hover span {
    transform: translateX(5px);
  }
  /* El laboratorio tiene su salida arriba, antes de que empiece lo del distribuidor */
  .lab {
    display: inline-block;
    margin-top: 18px;
    padding-bottom: 2px;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(var(--red), var(--red)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s var(--ease);
  }
  .lab:hover,
  .lab:focus-visible {
    background-size: 100% 2px;
  }
  .lab i {
    font-style: normal;
    font-weight: 700;
    color: var(--red);
  }
  .why {
    margin-top: 32px;
  }

  /* Movimiento: todo visible sin JS; con JS entra al verse */
  .ap {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  :global(.js) #distribuidores .ap:not(.vista) {
    opacity: 0;
    transform: translateY(24px);
  }
  :global(.js) .traz {
    /* algo más que el largo de la ruta en el lienzo */
    stroke-dasharray: 1250;
    stroke-dashoffset: 1250;
  }
  .ruta.vista .traz {
    animation: dibuja var(--dibujo) linear forwards;
  }
  :global(.js) .ruta:not(.vista) :is(.haz, .suelo, .escena, .texto) {
    opacity: 0;
  }
  .ruta.vista .haz {
    animation: haz 0.5s var(--ease) both var(--t);
  }
  .ruta.vista .suelo {
    animation: brota 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) both var(--t);
  }
  .ruta.vista .escena {
    animation:
      proyecta 0.9s steps(1, end) both calc(var(--t) + 0.25s),
      sube 0.8s var(--ease) both calc(var(--t) + 0.25s);
  }
  .ruta.vista .abajo .escena {
    animation-name: proyecta, baja;
  }
  .ruta.vista .texto {
    animation: entra 0.6s var(--ease) both calc(var(--t) + 0.5s);
  }
  @keyframes dibuja {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes gira {
    to {
      rotate: 360deg;
    }
  }
  @keyframes haz {
    from {
      opacity: 0;
      scale: 1 0;
    }
  }
  @keyframes brota {
    from {
      scale: 0;
    }
  }
  /* Parpadeo de proyector al encenderse */
  @keyframes proyecta {
    0% {
      opacity: 0;
    }
    15% {
      opacity: 0.6;
    }
    25% {
      opacity: 0.1;
    }
    40% {
      opacity: 0.8;
    }
    50% {
      opacity: 0.3;
    }
    65%,
    100% {
      opacity: 1;
    }
  }
  @keyframes sube {
    from {
      translate: 0 30px;
      scale: 0.7;
    }
  }
  @keyframes baja {
    from {
      translate: 0 -30px;
      scale: 0.7;
    }
  }
  @keyframes entra {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  /* Móvil y tableta: la ruta se apila; cada rotor a la izquierda de su texto */
  @media (max-width: 900px) {
    .izq {
      display: none;
    }
    .cab {
      grid-template-columns: 1fr;
    }
    .linea {
      display: none;
    }
    ol {
      display: grid;
      gap: 32px;
    }
    li {
      display: grid;
      grid-template-columns: 96px 1fr;
      gap: 18px;
      align-items: center;
    }
    .rotor {
      position: relative;
    }
    .ruta.vista li .haz,
    .ruta.vista li .suelo,
    .ruta.vista li .escena,
    .ruta.vista li .texto {
      animation-delay: calc(var(--i, 0) * 0.35s);
    }
    .abajo .haz {
      top: auto;
      bottom: 0;
      transform-origin: bottom;
      background: linear-gradient(to top, rgba(221, 4, 10, 0.55), rgba(221, 4, 10, 0.12) 55%, transparent);
      clip-path: polygon(44% 100%, 56% 100%, 100% 42%, 0 42%);
    }
    .abajo .suelo {
      top: auto;
      bottom: -7px;
    }
    .abajo .escena {
      margin: 0 0 20%;
    }
    .ruta.vista .abajo .escena {
      animation-name: proyecta, sube;
    }
    .pie {
      grid-template-columns: 1fr;
    }
  }
</style>
