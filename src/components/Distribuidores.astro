---
// Las razones para el distribuidor, contadas como el recorrido de un pedido.
// Fuentes: catálogo 2025 ("¿Qué nos diferencia?", garantía, OEM) y web actual (plazo de entrega).
const pasos = [
  {
    cuando: 'Haces el pedido',
    cifra: 'Stock',
    titulo: 'Siempre disponible',
    texto: 'Stock continuo de toda la gama.',
  },
  {
    cuando: 'Llega a tu almacén en',
    cifra: '1',
    unidad: 'semana',
    titulo: 'Entrega rápida',
    texto: 'Plazo medio de entrega en 2024 y 2025.',
  },
  {
    cuando: 'Si tienes una duda, respuesta en',
    cifra: '48',
    unidad: 'h',
    titulo: 'Asesoramiento',
    texto: 'Puesta en marcha, incidencias, reparaciones y formación técnica online.',
  },
  {
    cuando: 'Tu cliente, cubierto durante',
    cifra: '3',
    unidad: 'años',
    titulo: 'Garantía sin sorpresas',
    texto: 'En todas las centrífugas nuevas, salvo la Minicen (14 meses).',
  },
];
---

<section class="sec dist" id="distribuidores">
  <div class="wrap">
    <div class="cab ap">
      <h2>
        Crece con <b>nosotros</b>
      </h2>
      <p class="lead">
        Una empresa familiar que trata a cada distribuidor como socio. Así funciona un pedido con Orto Alresa.
      </p>
    </div>

    <ol class="ruta ap">
      {pasos.map((p) => (
        <li>
          <span class="cuando">{p.cuando}</span>
          <strong>
            {p.cifra}
            {p.unidad && <small>{p.unidad}</small>}
          </strong>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>

    <div class="pie ap">
      <div>
        <h3>
          ¿Necesitas equipos <b>con tu marca</b>?
        </h3>
        <p>Fabricación OEM a medida, con análisis de riesgos y trazabilidad de origen a usuario.</p>
      </div>
      <div class="acciones">
        <a class="btn red" href="#contacto">
          Hazte distribuidor <span aria-hidden="true">»</span>
        </a>
        <a class="lab" href="#contacto">
          ¿Eres un laboratorio? Encuentra tu distribuidor <i aria-hidden="true">»</i>
        </a>
      </div>
    </div>

    <p class="why">
      <b>Antes:</b> no había nada para distribuidores y el formulario ponía "Cliente final" primero.
      <b>Ahora:</b> una sección que habla al cliente real, con las razones contadas como el recorrido de su pedido y un
      solo botón claro.
    </p>
  </div>
</section>

<script>
  // Cada bloque entra suave la primera vez que se ve; la línea del recorrido se dibuja sola
  const bloques = document.querySelectorAll('#distribuidores .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    bloques.forEach((b) => obs.observe(b));
  }
</script>

<style>
  .dist {
    background: var(--band);
  }

  /* Cabecera: título grande a la izquierda, entradilla a la derecha */
  .cab {
    display: grid;
    grid-template-columns: 1fr minmax(0, 440px);
    gap: 24px 64px;
    align-items: end;
  }
  h2 {
    margin: 0;
    font-weight: 300;
    font-size: clamp(40px, 5.2vw, 72px);
    line-height: 0.95;
    text-wrap: balance;
  }
  h2 b {
    color: var(--red);
  }
  .lead {
    margin: 0;
    color: var(--body);
    font-size: clamp(17px, 1.4vw, 20px);
    max-width: 44ch;
  }

  /* El recorrido: una línea con cuatro paradas */
  .ruta {
    position: relative;
    list-style: none;
    margin: clamp(56px, 7vw, 96px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .ruta::before,
  .ruta::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 11px;
    height: 2px;
    background: var(--line);
  }
  .ruta::after {
    background: var(--red);
    transform-origin: left;
  }
  li {
    position: relative;
    padding-top: 48px;
  }
  li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 24px;
    height: 24px;
    background: #fff;
    border: 2px solid var(--red);
    transition: background 0.3s var(--ease);
  }
  li:hover::before {
    background: var(--red);
  }
  .cuando {
    font-size: 15px;
    color: var(--muted);
  }
  strong {
    display: block;
    margin-top: 4px;
    font-size: clamp(48px, 5vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    transition: transform 0.35s var(--ease);
  }
  strong small {
    margin-left: 6px;
    font-size: 0.38em;
    font-weight: 300;
    letter-spacing: 0;
  }
  li:hover strong {
    transform: translateY(-4px);
  }
  li h3 {
    margin: 14px 0 6px;
    font-size: 20px;
  }
  li p {
    margin: 0;
    color: var(--body);
    max-width: 28ch;
  }

  /* Remate oscuro: OEM y el botón */
  .pie {
    margin-top: clamp(56px, 7vw, 88px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    padding: clamp(28px, 4vw, 48px);
    background: #3b4045;
    color: #fff;
  }
  .pie h3 {
    margin: 0;
    font-weight: 300;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.05;
  }
  .pie h3 b {
    font-weight: 700;
  }
  .pie p {
    margin: 10px 0 0;
    color: #c9ced2;
    max-width: 52ch;
  }
  .acciones {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .btn span {
    transition: transform 0.25s var(--ease);
  }
  .btn:hover span {
    transform: translateX(5px);
  }
  .lab {
    padding-bottom: 2px;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(var(--red), var(--red)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s var(--ease);
  }
  .lab:hover,
  .lab:focus-visible {
    background-size: 100% 2px;
  }
  .lab i {
    font-style: normal;
    font-weight: 700;
    color: var(--red);
  }
  .why {
    margin-top: 32px;
  }

  /* Movimiento: todo visible sin JS; con JS entra al verse */
  :global(.js) #distribuidores .ap:not(.vista) {
    opacity: 0;
    transform: translateY(24px);
  }
  .ap {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  /* La ruta en sí no se desplaza: entran sus paradas una tras otra y la línea se dibuja */
  :global(.js) #distribuidores .ruta.ap:not(.vista) {
    opacity: 1;
    transform: none;
  }
  :global(.js) .ruta::after {
    transform: scaleX(0);
    transition: transform 1.8s var(--ease) 0.3s;
  }
  :global(.js) .ruta.vista::after {
    transform: scaleX(1);
  }
  :global(.js) .ruta li {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  :global(.js) .ruta:not(.vista) li {
    opacity: 0;
    transform: translateY(24px);
  }
  .ruta.vista li:nth-child(2) {
    transition-delay: 0.5s;
  }
  .ruta.vista li:nth-child(3) {
    transition-delay: 1s;
  }
  .ruta.vista li:nth-child(4) {
    transition-delay: 1.5s;
  }

  @media (max-width: 900px) {
    .cab {
      grid-template-columns: 1fr;
    }
    .ruta {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .ruta::before,
    .ruta::after {
      left: 11px;
      right: auto;
      top: 0;
      bottom: 40px;
      width: 2px;
      height: auto;
    }
    .ruta::after {
      transform-origin: top;
    }
    :global(.js) .ruta::after {
      transform: scaleY(0);
    }
    :global(.js) .ruta.vista::after {
      transform: scaleY(1);
    }
    li {
      padding: 0 0 40px 52px;
    }
    .pie {
      grid-template-columns: 1fr;
    }
  }
</style>
