---
// Las razones para el distribuidor, contadas como el recorrido de un pedido.
// Fuentes: catálogo 2025 ("¿Qué nos diferencia?", garantía, OEM) y web actual (plazo de entrega).
// Cada parada proyecta un rotor; cada rotor lleva más tubos que el anterior, como el pedido que avanza.
// Hueco preparado: cuando la empresa pase los CAD, el dibujo de cada rotor se cambia por su modelo real
// (ver docs/pendiente-empresa.md) sin tocar la ruta ni los textos.
const pasos = [
  {
    cuando: 'Haces el pedido',
    cifra: 'Stock',
    titulo: 'Siempre disponible',
    texto: 'Stock continuo de toda la gama.',
    tubos: 4,
  },
  {
    cuando: 'Llega a tu almacén en',
    cifra: '1',
    unidad: 'semana',
    titulo: 'Entrega rápida',
    texto: 'Plazo medio de entrega, gracias al stock continuo.',
    tubos: 6,
  },
  {
    cuando: 'Si tienes una duda, respuesta en',
    cifra: '48',
    unidad: 'h',
    titulo: 'Asesoramiento',
    texto: 'Puesta en marcha, incidencias, reparaciones y formación técnica online.',
    tubos: 8,
  },
  {
    cuando: 'Tu cliente, cubierto durante',
    cifra: '3',
    unidad: 'años',
    titulo: 'Garantía sin sorpresas',
    texto: 'En todas las centrífugas nuevas, salvo la Minicen (14 meses).',
    tubos: 12,
  },
];

// La ruta (lienzo de 1200 x 900) y el punto exacto de cada parada sobre ella.
// Las paradas están al 16, 39, 63 y 84 % del recorrido; la línea se dibuja a ritmo constante,
// así que cada rotor sale justo cuando la línea llega a él.
const ruta =
  'M0,420 C120,420 150,420 190,420 C340,420 360,480 470,480 C580,480 600,420 760,420 C880,420 900,480 1010,480 C1100,480 1150,460 1200,450';
const paradas = [
  { x: 196.7, y: 420, t: 0.16 },
  { x: 470.9, y: 480, t: 0.39 },
  { x: 757.6, y: 420, t: 0.63 },
  { x: 1006.3, y: 480, t: 0.84 },
];
const DIBUJO = 2.6; // segundos que tarda la línea

// Rotor visto desde arriba: aro, radios, tubos y eje rojo.
function rotor(n: number) {
  const r = n > 8 ? 6 : 8;
  const d = n > 8 ? 31 : 29;
  let s =
    '<circle cx="50" cy="50" r="48" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.85)" stroke-width="1.6"/>' +
    '<circle cx="50" cy="50" r="41" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1"/>';
  for (let i = 0; i < n; i++) {
    const a = (i / n) * 2 * Math.PI;
    const c = Math.cos(a);
    const sn = Math.sin(a);
    s +=
      `<line x1="50" y1="50" x2="${(50 + 40 * c).toFixed(1)}" y2="${(50 + 40 * sn).toFixed(1)}" stroke="rgba(255,255,255,.18)"/>` +
      `<circle cx="${(50 + d * c).toFixed(1)}" cy="${(50 + d * sn).toFixed(1)}" r="${r}" fill="rgba(21,24,27,.6)" stroke="#fff" stroke-width="1.4"/>`;
  }
  return s + '<circle cx="50" cy="50" r="11" fill="#dd040a"/><circle cx="50" cy="50" r="4" fill="#fff"/>';
}
---

<section class="sec dist" id="distribuidores">
  <div class="fondo" aria-hidden="true"></div>
  <div class="wrap">
    <div class="cab ap">
      <h2>
        Crece con <b>nosotros</b>
      </h2>
      <div>
        <p class="lead">
          Una empresa familiar que trata a cada distribuidor como socio. Así funciona un pedido con Orto Alresa.
        </p>
        <a class="lab" href="#contacto">
          ¿Eres un laboratorio? Encuentra tu distribuidor <i aria-hidden="true">»</i>
        </a>
      </div>
    </div>

    <div class="ruta" style={`--dibujo:${DIBUJO}s`}>
      <svg class="linea" viewBox="0 0 1200 900" aria-hidden="true">
        <path class="guia" d={ruta}></path>
        <path class="traz" d={ruta}></path>
      </svg>
      <ol>
        {pasos.map((p, i) => {
          const q = paradas[i];
          const t = (DIBUJO * q.t - 0.1).toFixed(2);
          return (
            <li
              class={i % 2 ? 'abajo' : 'arriba'}
              style={`--x:${((q.x / 1200) * 100).toFixed(2)}%;--y:${((q.y / 900) * 100).toFixed(2)}%;--t:${t}s;--w:${110 + i * 12};--i:${i}`}
            >
              <div class="rotor" aria-hidden="true" data-tubos={p.tubos}>
                <div class="haz" />
                <div class="suelo" />
                <div class="escena">
                  <div class="plato">
                    <svg class="bajo" viewBox="0 0 100 100" set:html={rotor(p.tubos)} />
                    <svg viewBox="0 0 100 100" set:html={rotor(p.tubos)} />
                  </div>
                </div>
              </div>
              <div class="texto">
                <span class="cuando">{p.cuando}</span>
                <strong>
                  {p.cifra}
                  {p.unidad && <small>{p.unidad}</small>}
                </strong>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>

    <div class="pie ap">
      <div>
        <h3>
          ¿Necesitas un equipo <b>a medida</b>?
        </h3>
        <p>Fabricación OEM a medida, con análisis de riesgos y trazabilidad de origen a usuario.</p>
      </div>
      <a class="btn red" href="#contacto">
        Hazte distribuidor <span aria-hidden="true">»</span>
      </a>
    </div>

    <p class="why">
      <b>Antes:</b> no había nada para distribuidores y el formulario ponía "Cliente final" primero.
      <b>Ahora:</b> una sección que habla al cliente real: el recorrido de su pedido se dibuja sobre un fondo de
      laboratorio y cada parada proyecta un rotor, con un solo botón claro.
    </p>
  </div>
</section>

<script>
  const sec = document.getElementById('distribuidores');
  if (sec && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');

    // Cada bloque entra la primera vez que se ve; la ruta se dibuja y proyecta sus rotores
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    sec.querySelectorAll('.ap, .ruta').forEach((b) => obs.observe(b));

    // Red de puntos del fondo: plana, pocos puntos y muy tenue. Donde hay texto o rotor casi se apaga.
    // Solo se anima mientras la sección está a la vista; con "reducir movimiento" queda quieta.
    const cv = document.createElement('canvas');
    cv.className = 'malla';
    cv.setAttribute('aria-hidden', 'true');
    sec.insertBefore(cv, sec.querySelector('.wrap'));
    const cx = cv.getContext('2d');
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DIST = 190;
    type Punto = { x: number; y: number; vx: number; vy: number; l: number; c: number };
    const pts: Punto[] = [];
    let W = 0;
    let H = 0;
    let zonas: number[][] = [];
    let vivo = false;
    let raf = 0;
    let rx = -1e4;
    let ry = -1e4;
    let mx = -1e4;
    let my = -1e4;

    const medir = () => {
      const r = sec.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = r.width;
      H = r.height;
      cv.width = W * dpr;
      cv.height = H * dpr;
      cx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(60, (W * H) / 20000));
      while (pts.length < n) {
        pts.push({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.18,
          vy: (Math.random() - 0.5) * 0.18,
          l: 1,
          c: 1,
        });
      }
      pts.length = n;
      zonas = [...sec.querySelectorAll('.cab, .texto, .escena, .pie')].map((e) => {
        const b = e.getBoundingClientRect();
        return [b.left - r.left - 24, b.top - r.top - 24, b.right - r.left + 24, b.bottom - r.top + 24];
      });
    };
    const luz = (x: number, y: number) => {
      for (const z of zonas) if (x > z[0] && x < z[2] && y > z[1] && y < z[3]) return 0.18;
      return 1;
    };
    const cuadro = () => {
      if (!cx) return;
      cx.clearRect(0, 0, W, H);
      mx += (rx - mx) * 0.08;
      my += (ry - my) * 0.08;
      for (const p of pts) {
        if (!quieto) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < -20) p.x = W + 20;
          if (p.x > W + 20) p.x = -20;
          if (p.y < -20) p.y = H + 20;
          if (p.y > H + 20) p.y = -20;
        }
        const d2 = (p.x - mx) ** 2 + (p.y - my) ** 2;
        p.c = d2 < 40000 ? 1 + (1 - d2 / 40000) * 1.6 : 1;
        p.l = luz(p.x, p.y);
      }
      cx.lineWidth = 1;
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i];
        for (let j = i + 1; j < pts.length; j++) {
          const b = pts[j];
          const d2 = (a.x - b.x) ** 2 + (a.y - b.y) ** 2;
          if (d2 > DIST * DIST) continue;
          const al = (1 - Math.sqrt(d2) / DIST) * 0.2 * Math.min(a.l, b.l) * Math.max(a.c, b.c);
          cx.strokeStyle = `rgba(235,238,240,${al.toFixed(3)})`;
          cx.beginPath();
          cx.moveTo(a.x, a.y);
          cx.lineTo(b.x, b.y);
          cx.stroke();
        }
      }
      for (const p of pts) {
        cx.fillStyle = `rgba(255,255,255,${Math.min(0.45 * p.l * p.c, 1).toFixed(3)})`;
        cx.beginPath();
        cx.arc(p.x, p.y, 1.5, 0, 6.283);
        cx.fill();
      }
      if (vivo && !quieto) raf = requestAnimationFrame(cuadro);
    };
    const arrancar = () => {
      cancelAnimationFrame(raf);
      if (vivo && !document.hidden) raf = requestAnimationFrame(cuadro);
    };
    sec.addEventListener('pointermove', (e) => {
      const r = sec.getBoundingClientRect();
      rx = e.clientX - r.left;
      ry = e.clientY - r.top;
    });
    sec.addEventListener('pointerleave', () => {
      rx = ry = -1e4;
    });
    new ResizeObserver(() => {
      medir();
      cuadro();
    }).observe(sec);
    new IntersectionObserver((es) => {
      vivo = es[0].isIntersecting;
      arrancar();
    }).observe(sec);
    document.addEventListener('visibilitychange', arrancar);
  }
</script>

<style>
  /* Sección oscura: foto de laboratorio muy apagada, red de puntos encima y el contenido delante */
  .dist {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #15181b;
    color: #fff;
  }
  .fondo {
    position: absolute;
    inset: -20px;
    z-index: -1;
    background: url('/img/fotos/lab-235.webp') center / cover;
    filter: blur(8px) grayscale(0.7) brightness(0.3);
  }
  .dist::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 30% 40%, rgba(21, 24, 27, 0.55), rgba(21, 24, 27, 0.92));
  }
  .dist :global(.malla) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .wrap {
    position: relative;
    z-index: 1;
  }

  /* Cabecera: título grande a la izquierda, entradilla a la derecha */
  .cab {
    display: grid;
    grid-template-columns: 1fr minmax(0, 440px);
    gap: 24px 64px;
    align-items: end;
  }
  h2 {
    margin: 0;
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.95;
    text-wrap: balance;
  }
  h2 b {
    color: var(--red);
  }
  .lead {
    margin: 0;
    color: #c9ced2;
    font-size: var(--t-sub);
    max-width: 44ch;
  }

  /* La ruta: lienzo de 1200 x 900; rotores y textos colocados sobre él en porcentajes */
  .ruta {
    position: relative;
    margin-top: clamp(40px, 5vw, 72px);
  }
  @media (min-width: 901px) {
    .ruta {
      aspect-ratio: 1200 / 900;
    }
    li {
      display: contents;
    }
    .rotor {
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: calc(var(--w) / 1200 * 100%);
      transform: translate(-50%, -100%);
    }
    .abajo .rotor {
      transform: translate(-50%, 0);
    }
    .texto {
      position: absolute;
      width: 22%;
    }
    li:nth-child(1) .texto {
      left: 3%;
      top: 0;
    }
    li:nth-child(2) .texto {
      left: 30%;
      top: 76%;
    }
    li:nth-child(3) .texto {
      left: 56%;
      top: 0;
    }
    li:nth-child(4) .texto {
      left: 77%;
      top: 76%;
    }
  }
  .linea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .guia,
  .traz {
    fill: none;
    stroke-linecap: round;
  }
  .guia {
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 2;
  }
  .traz {
    stroke: var(--red);
    stroke-width: 2.5;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Rotor proyectado: haz de luz desde la línea, brillo en el suelo y el rotor girando en 3D */
  .haz {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 70%;
    height: 100%;
    transform: translateX(-50%);
    transform-origin: bottom;
    background: linear-gradient(to top, rgba(221, 4, 10, 0.55), rgba(221, 4, 10, 0.12) 55%, transparent);
    clip-path: polygon(44% 100%, 56% 100%, 100% 39%, 0 39%);
  }
  .suelo {
    position: absolute;
    left: 50%;
    bottom: -7px;
    width: 44px;
    height: 14px;
    margin-left: -22px;
    border-radius: 50%;
    background: radial-gradient(rgba(255, 80, 80, 0.9), rgba(221, 4, 10, 0) 70%);
  }
  .escena {
    position: relative;
    aspect-ratio: 1;
    margin-bottom: 28%;
    perspective: 500px;
  }
  .plato {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(64deg);
  }
  .plato svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: gira 7s linear infinite;
  }
  /* Una segunda capa más abajo y más tenue da el grosor del rotor */
  .plato .bajo {
    transform: translateZ(-9px);
    opacity: 0.35;
  }
  .abajo .haz {
    top: 0;
    bottom: auto;
    transform-origin: top;
    background: linear-gradient(to bottom, rgba(221, 4, 10, 0.55), rgba(221, 4, 10, 0.12) 55%, transparent);
    clip-path: polygon(44% 0, 56% 0, 100% 61%, 0 61%);
  }
  .abajo .suelo {
    top: -7px;
    bottom: auto;
  }
  .abajo .escena {
    margin: 28% 0 0;
  }
  li:hover .haz {
    filter: brightness(1.35);
  }

  .cuando {
    font-size: 15px;
    color: #b9bfc4;
  }
  strong {
    display: block;
    margin-top: 4px;
    font-size: clamp(48px, 5vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  strong small {
    margin-left: 6px;
    font-size: 0.38em;
    font-weight: 300;
    letter-spacing: 0;
  }
  .texto h3 {
    margin: 14px 0 6px;
    font-size: 20px;
  }
  .texto p {
    margin: 0;
    color: #d6dadd;
    max-width: 28ch;
  }

  /* Remate: OEM y el botón, en un panel gris translúcido sobre el fondo */
  .pie {
    margin-top: clamp(40px, 5vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    padding: clamp(28px, 4vw, 48px);
    background: rgba(59, 64, 69, 0.72);
    color: #fff;
  }
  .pie h3 {
    margin: 0;
    font-weight: 300;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.05;
  }
  .pie h3 b {
    font-weight: 700;
  }
  .pie p {
    margin: 10px 0 0;
    color: #c9ced2;
    max-width: 52ch;
  }
  .btn span {
    transition: transform 0.25s var(--ease);
  }
  .btn:hover span {
    transform: translateX(5px);
  }
  /* El laboratorio tiene su salida arriba, antes de que empiece lo del distribuidor */
  .lab {
    display: inline-block;
    margin-top: 18px;
    padding-bottom: 2px;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(var(--red), var(--red)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s var(--ease);
  }
  .lab:hover,
  .lab:focus-visible {
    background-size: 100% 2px;
  }
  .lab i {
    font-style: normal;
    font-weight: 700;
    color: var(--red);
  }
  .why {
    margin-top: 32px;
  }

  /* Movimiento: todo visible sin JS; con JS entra al verse */
  .ap {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  :global(.js) #distribuidores .ap:not(.vista) {
    opacity: 0;
    transform: translateY(24px);
  }
  :global(.js) .traz {
    /* largo de la ruta en el lienzo: 1229,4 */
    stroke-dasharray: 1230;
    stroke-dashoffset: 1230;
  }
  .ruta.vista .traz {
    animation: dibuja var(--dibujo) linear forwards;
  }
  :global(.js) .ruta:not(.vista) :is(.haz, .suelo, .escena, .texto) {
    opacity: 0;
  }
  .ruta.vista .haz {
    animation: haz 0.5s var(--ease) both var(--t);
  }
  .ruta.vista .suelo {
    animation: brota 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) both var(--t);
  }
  .ruta.vista .escena {
    animation:
      proyecta 0.9s steps(1, end) both calc(var(--t) + 0.25s),
      sube 0.8s var(--ease) both calc(var(--t) + 0.25s);
  }
  .ruta.vista .abajo .escena {
    animation-name: proyecta, baja;
  }
  .ruta.vista .texto {
    animation: entra 0.6s var(--ease) both calc(var(--t) + 0.5s);
  }
  @keyframes dibuja {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes gira {
    to {
      rotate: 360deg;
    }
  }
  @keyframes haz {
    from {
      opacity: 0;
      scale: 1 0;
    }
  }
  @keyframes brota {
    from {
      scale: 0;
    }
  }
  /* Parpadeo de proyector al encenderse */
  @keyframes proyecta {
    0% {
      opacity: 0;
    }
    15% {
      opacity: 0.6;
    }
    25% {
      opacity: 0.1;
    }
    40% {
      opacity: 0.8;
    }
    50% {
      opacity: 0.3;
    }
    65%,
    100% {
      opacity: 1;
    }
  }
  @keyframes sube {
    from {
      translate: 0 30px;
      scale: 0.7;
    }
  }
  @keyframes baja {
    from {
      translate: 0 -30px;
      scale: 0.7;
    }
  }
  @keyframes entra {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  /* Móvil y tableta: la ruta se apila; cada rotor a la izquierda de su texto */
  @media (max-width: 900px) {
    .cab {
      grid-template-columns: 1fr;
    }
    .linea {
      display: none;
    }
    ol {
      display: grid;
      gap: 32px;
    }
    li {
      display: grid;
      grid-template-columns: 96px 1fr;
      gap: 18px;
      align-items: center;
    }
    .rotor {
      position: relative;
    }
    .ruta.vista li .haz,
    .ruta.vista li .suelo,
    .ruta.vista li .escena,
    .ruta.vista li .texto {
      animation-delay: calc(var(--i, 0) * 0.35s);
    }
    .abajo .haz {
      top: auto;
      bottom: 0;
      transform-origin: bottom;
      background: linear-gradient(to top, rgba(221, 4, 10, 0.55), rgba(221, 4, 10, 0.12) 55%, transparent);
      clip-path: polygon(44% 100%, 56% 100%, 100% 39%, 0 39%);
    }
    .abajo .suelo {
      top: auto;
      bottom: -7px;
    }
    .abajo .escena {
      margin: 0 0 28%;
    }
    .ruta.vista .abajo .escena {
      animation-name: proyecta, sube;
    }
    .pie {
      grid-template-columns: 1fr;
    }
  }
</style>
