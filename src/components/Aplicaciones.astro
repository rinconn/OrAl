---
import { getCollection } from 'astro:content';

// Las cinco últimas notas del blog; al publicar una nueva, la portada se actualiza sola.
const notas = (await getCollection('notas'))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 5);
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<section class="sec apl" id="aplicaciones">
  <div class="wrap">
    <h2 class="ap">
      Aplicaciones <b>en el laboratorio</b>
    </h2>
  </div>

  <!-- La baraja usa más ancho que el resto de la página para que cinco cartas no queden estrechas -->
  <div class="ancho">
    <ul class="baraja ap">
      {notas.map((n) => (
        <li>
          <a class="carta" href={`/noticias/${n.id}/`}>
            <span class="marcas" aria-hidden="true" />
            <div class="foto">
              <img src={n.data.foto} alt={n.data.alt} loading="lazy" decoding="async" />
            </div>
            <div class="texto">
              {!n.data.fechaPendiente && (
                <time datetime={n.data.fecha.toISOString().slice(0, 10)}>{fmt.format(n.data.fecha)}</time>
              )}
              <h3>{n.data.titulo}</h3>
            </div>
            <span class="leer">
              Leer la nota <i aria-hidden="true">»</i>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="wrap">
    <div class="cta ap">
      <a class="btn ghost" href="/noticias/">
        Ver todas las notas <span aria-hidden="true">»</span>
      </a>
    </div>

    <p class="why">
      <b>Antes:</b> las notas solo estaban en Noticias, en una rejilla de fotos con una etiqueta roja encima y el título
      tapando la imagen. <b>Ahora:</b> las cinco últimas en la portada, como una baraja que se reparte sola al llegar a
      ella y se queda abierta. Se actualiza sola al publicar una nota nueva.
    </p>
  </div>
</section>

<script>
  // Entrada suave la primera vez que se ve, como en el resto de la portada
  const bloques = document.querySelectorAll('#aplicaciones .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    bloques.forEach((b) => obs.observe(b));

    // La baraja se reparte sola una vez al llegar a ella y se queda abierta
    const baraja = document.querySelector('#aplicaciones .baraja');
    if (baraja) {
      const abrir = new IntersectionObserver(
        (entradas) => {
          if (entradas[0]?.isIntersecting) {
            window.setTimeout(() => baraja.classList.add('abierta'), 500);
            abrir.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      abrir.observe(baraja);
    }
  }
</script>

<style>
  h2 {
    margin: 0 0 clamp(32px, 4vw, 56px);
    text-align: center;
    font-weight: 300;
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: 1;
  }

  /* La baraja: cinco fotos en fila que, mientras está cerrada, se apilan en el centro un poco giradas */
  .ancho {
    max-width: 1560px;
    margin: 0 auto;
    padding-inline: var(--gut);
  }
  .baraja {
    --gap: clamp(14px, 1.4vw, 22px);
    --paso: calc(100% + var(--gap));
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--gap);
  }
  .baraja li {
    position: relative;
    transition: transform 0.75s cubic-bezier(0.25, 0.9, 0.3, 1.1);
  }
  .baraja li:nth-child(1) {
    z-index: 5;
  }
  .baraja li:nth-child(2) {
    z-index: 4;
    transition-delay: 0.04s;
  }
  .baraja li:nth-child(3) {
    z-index: 3;
    transition-delay: 0.08s;
  }
  .baraja li:nth-child(4) {
    z-index: 2;
    transition-delay: 0.12s;
  }
  .baraja li:nth-child(5) {
    z-index: 1;
    transition-delay: 0.16s;
  }
  :global(.js) .baraja:not(.abierta) li:nth-child(1) {
    transform: translateX(calc(2 * var(--paso))) rotate(-2deg);
  }
  :global(.js) .baraja:not(.abierta) li:nth-child(2) {
    transform: translateX(var(--paso)) rotate(4deg);
  }
  :global(.js) .baraja:not(.abierta) li:nth-child(3) {
    transform: rotate(-6deg);
  }
  :global(.js) .baraja:not(.abierta) li:nth-child(4) {
    transform: translateX(calc(-1 * var(--paso))) rotate(7deg);
  }
  :global(.js) .baraja:not(.abierta) li:nth-child(5) {
    transform: translateX(calc(-2 * var(--paso))) rotate(-9deg);
  }

  /* La carta: borde gris oscuro marcado, marcas de esquina grises y franja inferior; todo se pone rojo al pasar */
  .carta {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    border: 2px solid #3b4045;
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.45);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.3s var(--ease);
  }
  .marcas {
    position: absolute;
    inset: -9px;
    z-index: 1;
    pointer-events: none;
    --c: var(--steel);
    background:
      linear-gradient(var(--c), var(--c)) top left / 16px 2px,
      linear-gradient(var(--c), var(--c)) top left / 2px 16px,
      linear-gradient(var(--c), var(--c)) top right / 16px 2px,
      linear-gradient(var(--c), var(--c)) top right / 2px 16px,
      linear-gradient(var(--c), var(--c)) bottom left / 16px 2px,
      linear-gradient(var(--c), var(--c)) bottom left / 2px 16px,
      linear-gradient(var(--c), var(--c)) bottom right / 16px 2px,
      linear-gradient(var(--c), var(--c)) bottom right / 2px 16px;
    background-repeat: no-repeat;
    opacity: 0;
    transition:
      opacity 0.3s var(--ease),
      inset 0.3s var(--ease);
  }
  .carta:is(:hover, :focus-visible) {
    transform: translateY(-6px);
    border-color: var(--red);
    box-shadow: 0 26px 50px -24px rgba(0, 0, 0, 0.5);
  }
  .carta:is(:hover, :focus-visible) .marcas {
    --c: var(--red);
    opacity: 1;
    inset: -12px;
  }
  .baraja.abierta .marcas {
    opacity: 1;
  }
  .carta:focus-visible {
    outline: none;
  }
  .foto {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--panel);
    border-bottom: 2px solid #3b4045;
    transition: border-color 0.3s var(--ease);
  }
  .carta:is(:hover, :focus-visible) .foto {
    border-color: var(--red);
  }
  .foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .carta:hover .foto img {
    transform: scale(1.06);
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    padding: 18px 20px 20px;
  }
  time {
    font-size: 14px;
    color: var(--muted);
  }
  h3 {
    margin: 0;
    font-size: clamp(18px, 1.4vw, 21px);
    line-height: 1.18;
    font-weight: 700;
    text-wrap: balance;
  }
  /* Franja inferior: gris oscuro que se pone roja */
  .leer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 13px 20px;
    background: #3b4045;
    color: var(--white);
    font-weight: 700;
    font-size: 15px;
    transition: background 0.3s var(--ease);
  }
  .leer i {
    font-style: normal;
    transition: transform 0.3s var(--ease);
  }
  .carta:is(:hover, :focus-visible) .leer {
    background: var(--red);
  }
  .carta:is(:hover, :focus-visible) .leer i {
    transform: translateX(4px);
  }

  .cta {
    margin-top: clamp(40px, 5vw, 64px);
    text-align: center;
  }

  /* Entrada suave, como en el resto de la portada */
  .ap {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  :global(.js) #aplicaciones .ap:not(.vista) {
    opacity: 0;
    transform: translateY(24px);
  }

  /* En móvil van una debajo de otra; cerrada, la baraja se apila sobre la primera */
  /* Tableta: dos filas no quedan bien, así que las cartas se deslizan de lado */
  @media (max-width: 1100px) and (min-width: 901px) {
    .baraja {
      grid-template-columns: repeat(5, 240px);
      overflow-x: auto;
      padding: 14px 4px 20px;
    }
  }
  /* En móvil van una debajo de otra; cerrada, la baraja se apila sobre la primera */
  @media (max-width: 900px) {
    .baraja {
      --paso: calc(100% + var(--gap));
      --gap: 28px;
      grid-template-columns: 1fr;
      max-width: 440px;
      margin: 0 auto;
    }
    .foto {
      aspect-ratio: 16 / 10;
    }
    .marcas {
      opacity: 1;
    }
    :global(.js) .baraja:not(.abierta) li:nth-child(1) {
      transform: rotate(-2deg);
    }
    :global(.js) .baraja:not(.abierta) li:nth-child(2) {
      transform: translateY(calc(-1 * var(--paso))) rotate(3deg);
    }
    :global(.js) .baraja:not(.abierta) li:nth-child(3) {
      transform: translateY(calc(-2 * var(--paso))) rotate(-4deg);
    }
    :global(.js) .baraja:not(.abierta) li:nth-child(4) {
      transform: translateY(calc(-3 * var(--paso))) rotate(5deg);
    }
    :global(.js) .baraja:not(.abierta) li:nth-child(5) {
      transform: translateY(calc(-4 * var(--paso))) rotate(-6deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .baraja li {
      transform: none !important;
      transition: none;
    }
    .ap,
    .carta,
    .foto img {
      transition: none;
    }
  }
</style>
