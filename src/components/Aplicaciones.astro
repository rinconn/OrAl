---
import { getCollection } from 'astro:content';
import { idioma, ruta, textos } from '../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);

// Las cinco últimas notas del blog; al publicar una nueva, la portada se actualiza sola.
// La más reciente va en grande y las otras cuatro en lista.
const [destacada, ...resto] = (await getCollection('notas'))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 5);
const fmt = new Intl.DateTimeFormat(t.meta.fechas, { day: 'numeric', month: 'long', year: 'numeric' });

type Nota = typeof destacada;
const titulo = (n: Nota) => (lang !== 'es' && n.data[lang]?.titulo) || n.data.titulo;
const alt = (n: Nota) => (lang !== 'es' && n.data[lang]?.alt) || n.data.alt;
const area = (n: Nota) => (lang !== 'es' && n.data[lang]?.area) || n.data.area;
// Mientras las notas no tengan página en la web nueva, cada una lleva a la suya en el blog actual
const enlace = (n: Nota) => n.data.origen ?? ruta(lang, `/noticias/${n.id}/`);
const blog = 'https://ortoalresa.com/blog/';
---

<section class="sec apl" id="aplicaciones">
  <div class="wrap">
    <div class="cab ap">
      <h2>
        {t.aplicaciones.titulo[0]}
        <b>{t.aplicaciones.titulo[1]}</b>
      </h2>
      <a class="arrow todas" href={blog}>
        {t.aplicaciones.todas}
      </a>
    </div>

    <div class="notas">
      {destacada && (
        <a class="destacada ap" href={enlace(destacada)}>
          <div class="foto">
            <img src={destacada.data.foto} alt={alt(destacada)} loading="lazy" decoding="async" />
          </div>
          <p class="meta">
            <span class="area">{area(destacada)}</span>
            {!destacada.data.fechaPendiente && (
              <time datetime={destacada.data.fecha.toISOString().slice(0, 10)}>{fmt.format(destacada.data.fecha)}</time>
            )}
          </p>
          <h3>{titulo(destacada)}</h3>
          <span class="leer">{t.aplicaciones.leer}</span>
        </a>
      )}

      <ul class="lista ap">
        {resto.map((n) => (
          <li>
            <a class="fila" href={enlace(n)}>
              <div class="foto">
                <img src={n.data.foto} alt={alt(n)} loading="lazy" decoding="async" />
              </div>
              <div class="texto">
                <p class="meta">
                  <span class="area">{area(n)}</span>
                  {!n.data.fechaPendiente && (
                    <time datetime={n.data.fecha.toISOString().slice(0, 10)}>{fmt.format(n.data.fecha)}</time>
                  )}
                </p>
                <h3>{titulo(n)}</h3>
              </div>
              <span class="flecha" aria-hidden="true">
                »
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Entrada suave la primera vez que se ve, como en el resto de la portada
  const bloques = document.querySelectorAll('#aplicaciones .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    bloques.forEach((b) => obs.observe(b));
  }
</script>

<style>
  /* Cabecera: título a la izquierda, como en el resto de secciones, y "Ver todas las notas" a la derecha */
  .cab {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  h2 {
    margin: 0;
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.95;
  }
  /* "En el laboratorio" en rojo, como "propia" en Tecnología */
  h2 b {
    color: var(--red);
  }
  .todas {
    font-size: 18px;
    color: var(--ink);
    padding-bottom: 6px;
  }

  /* Nota destacada a la izquierda y las otras cuatro en lista a la derecha */
  .notas {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(32px, 4.5vw, 72px);
    align-items: start;
  }
  a {
    color: var(--ink);
    text-decoration: none;
  }

  .foto {
    overflow: hidden;
    background: var(--panel);
  }
  .foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  a:hover .foto img {
    transform: scale(1.05);
  }

  /* Área en rojo y fecha en gris, separadas por una raya fina */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin: 0;
    font-size: 14px;
  }
  .area {
    color: var(--red);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 13px;
  }
  time {
    color: var(--muted);
  }
  .area + time::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 12px;
    margin-right: 12px;
    background: var(--line);
    vertical-align: -1px;
  }
  h3 {
    margin: 0;
    font-weight: 700;
    text-wrap: balance;
    transition: color 0.25s var(--ease);
  }

  /* La destacada: foto ancha con raya roja que crece al pasar, título grande */
  .destacada {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .destacada .foto {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-bottom: 6px;
  }
  .destacada .foto::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    width: 64px;
    background: var(--red);
    transition: width 0.6s var(--ease);
  }
  .destacada:is(:hover, :focus-visible) .foto::after {
    width: 100%;
  }
  .destacada h3 {
    font-size: clamp(28px, 2.6vw, 40px);
    line-height: 1.04;
  }
  .leer {
    display: inline-flex;
    gap: 6px;
    font-weight: 700;
    font-size: 17px;
  }
  .leer::after {
    content: '»';
    color: var(--red);
    transition: transform 0.2s var(--ease);
  }
  .destacada:is(:hover, :focus-visible) .leer::after {
    transform: translateX(4px);
  }
  .destacada:is(:hover, :focus-visible) h3 {
    color: var(--red);
  }

  /* La lista: foto pequeña, área, fecha y título, separadas por rayas finas */
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .lista li {
    border-bottom: 1px solid var(--line);
  }
  .fila {
    display: grid;
    grid-template-columns: clamp(96px, 9vw, 136px) minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    padding-block: 20px;
  }
  .fila .foto {
    aspect-ratio: 4 / 3;
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fila h3 {
    font-size: clamp(18px, 1.45vw, 21px);
    line-height: 1.15;
  }
  .flecha {
    color: var(--red);
    font-size: 22px;
    font-weight: 700;
    transition: transform 0.2s var(--ease);
  }
  .fila:is(:hover, :focus-visible) h3 {
    color: var(--red);
  }
  .fila:is(:hover, :focus-visible) .flecha {
    transform: translateX(4px);
  }

  a:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 4px;
  }

  /* Entrada suave, como en el resto de la portada; la lista entra un poco después */
  .ap {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  .lista.ap {
    transition-delay: 0.12s;
  }
  :global(.js) #aplicaciones .ap:not(.vista) {
    opacity: 0;
    transform: translateY(24px);
  }

  /* Tableta y móvil: la destacada arriba y la lista debajo */
  @media (max-width: 960px) {
    .notas {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .fila {
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 14px;
      padding-block: 16px;
    }
    .flecha {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ap,
    .foto img,
    .destacada .foto::after {
      transition: none;
    }
  }
</style>
