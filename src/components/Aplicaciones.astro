---
import { getCollection } from 'astro:content';

// Las tres últimas notas del blog; al publicar una nueva, la portada se actualiza sola.
const notas = (await getCollection('notas'))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<section class="sec apl" id="aplicaciones">
  <div class="wrap">
    <h2 class="ap">
      Aplicaciones <b>en el laboratorio</b>
    </h2>

    <ul class="notas ap">
      {notas.map((n) => (
        <li>
          <a class="tarjeta" href={`/noticias/${n.id}/`}>
            <div class="foto">
              <img src={n.data.foto} alt={n.data.alt} loading="lazy" decoding="async" />
            </div>
            <div class="texto">
              <time datetime={n.data.fecha.toISOString().slice(0, 10)}>{fmt.format(n.data.fecha)}</time>
              <h3>{n.data.titulo}</h3>
              <span class="leer">
                Leer la nota <i aria-hidden="true">»</i>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="cta ap">
      <a class="btn ghost" href="/noticias/">
        Ver todas las notas <span aria-hidden="true">»</span>
      </a>
    </div>

    <p class="why">
      <b>Antes:</b> las notas solo estaban en Noticias, en una rejilla de fotos con una etiqueta roja encima y el título
      tapando la imagen. <b>Ahora:</b> las tres últimas en la portada, cada una con su foto limpia y el título debajo,
      con el mismo estilo de tarjeta que el resto de la portada. Se actualiza sola al publicar una nota nueva.
    </p>
  </div>
</section>

<script>
  // Entrada suave la primera vez que se ve, como en el resto de la portada
  const bloques = document.querySelectorAll('#aplicaciones .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    bloques.forEach((b) => obs.observe(b));
  }
</script>

<style>
  h2 {
    margin: 0 0 clamp(32px, 4vw, 56px);
    text-align: center;
    font-weight: 300;
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: 1;
  }

  .notas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.4vw, 32px);
  }

  /* Tarjeta como las de Distribuidores y Empresa: borde oscuro, esquina que se pone roja y raya roja que crece */
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    border: 2px solid #3b4045;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .tarjeta::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    z-index: 2;
    height: 4px;
    width: 0;
    background: var(--red);
    transition: width 0.4s var(--ease);
  }
  .tarjeta::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    width: 28px;
    height: 28px;
    background: #3b4045;
    clip-path: polygon(0 0, 100% 0, 100% 100%);
    transition: background 0.3s var(--ease);
  }
  .tarjeta:hover,
  .tarjeta:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px -18px rgba(0, 0, 0, 0.35);
  }
  .tarjeta:hover::before,
  .tarjeta:focus-visible::before {
    width: calc(100% + 4px);
  }
  .tarjeta:hover::after,
  .tarjeta:focus-visible::after {
    background: var(--red);
  }
  .tarjeta:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 4px;
  }

  /* Foto vertical, limpia, sin nada encima */
  .foto {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--panel);
  }
  .foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .tarjeta:hover .foto img {
    transform: scale(1.05);
  }

  .texto {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: 22px 26px 26px;
  }
  time {
    font-size: 15px;
    color: var(--muted);
  }
  h3 {
    margin: 0;
    font-size: clamp(21px, 1.8vw, 25px);
    line-height: 1.15;
    font-weight: 700;
    text-wrap: balance;
  }
  .leer {
    margin-top: auto;
    padding-top: 8px;
    font-weight: 700;
  }
  .leer i {
    font-style: normal;
    color: var(--red);
  }

  .cta {
    margin-top: clamp(32px, 4vw, 48px);
    text-align: center;
  }

  /* Entrada suave: las tarjetas llegan una detrás de otra */
  .ap,
  .notas li {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  :global(.js) #aplicaciones .ap:not(.vista) {
    opacity: 0;
    transform: translateY(24px);
  }
  :global(.js) #aplicaciones .notas.ap:not(.vista) {
    opacity: 1;
    transform: none;
  }
  :global(.js) #aplicaciones .notas:not(.vista) li {
    opacity: 0;
    transform: translateY(24px);
  }
  .notas.vista li:nth-child(2) {
    transition-delay: 0.15s;
  }
  .notas.vista li:nth-child(3) {
    transition-delay: 0.3s;
  }

  @media (max-width: 900px) {
    .notas {
      grid-template-columns: 1fr;
    }
    .foto {
      aspect-ratio: 16 / 10;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ap,
    .notas li,
    .tarjeta,
    .foto img {
      transition: none;
    }
  }
</style>
