---
import { getCollection } from 'astro:content';

// Las tres últimas notas del blog; al publicar una nueva, la portada se actualiza sola.
const notas = (await getCollection('notas'))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<section class="sec apl" id="aplicaciones">
  <div class="wrap">
    <h2 class="ap">
      Aplicaciones <b>en el laboratorio</b>
    </h2>

    <ul class="baraja ap">
      {notas.map((n) => (
        <li>
          <a class="carta" href={`/noticias/${n.id}/`}>
            <div class="foto">
              <img src={n.data.foto} alt={n.data.alt} loading="lazy" decoding="async" />
            </div>
            <time datetime={n.data.fecha.toISOString().slice(0, 10)}>{fmt.format(n.data.fecha)}</time>
            <h3>{n.data.titulo}</h3>
          </a>
        </li>
      ))}
    </ul>

    <div class="cta ap">
      <a class="btn ghost" href="/noticias/">
        Ver todas las notas <span aria-hidden="true">»</span>
      </a>
    </div>

    <p class="why">
      <b>Antes:</b> las notas solo estaban en Noticias, en una rejilla de fotos con una etiqueta roja encima y el título
      tapando la imagen. <b>Ahora:</b> las tres últimas en la portada, cada una con su foto limpia y el título debajo,
      con el mismo estilo de tarjeta que el resto de la portada. Se actualiza sola al publicar una nota nueva.
    </p>
  </div>
</section>

<script>
  // Entrada suave la primera vez que se ve, como en el resto de la portada
  const bloques = document.querySelectorAll('#aplicaciones .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    bloques.forEach((b) => obs.observe(b));

    // Sin ratón (móvil y tableta) la baraja se abre sola al llegar a ella
    const baraja = document.querySelector('#aplicaciones .baraja');
    if (baraja && !window.matchMedia('(hover: hover)').matches) {
      const abrir = new IntersectionObserver(
        (entradas) => {
          if (entradas[0]?.isIntersecting) {
            window.setTimeout(() => baraja.classList.add('abierta'), 500);
            abrir.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      abrir.observe(baraja);
    }
  }
</script>

<style>
  h2 {
    margin: 0 0 clamp(32px, 4vw, 56px);
    text-align: center;
    font-weight: 300;
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: 1;
  }

  /* La baraja: tres fotos en fila que, mientras está cerrada, se apilan en el centro un poco giradas */
  .baraja {
    --gap: clamp(20px, 2.4vw, 32px);
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1080px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  .baraja li {
    position: relative;
    transition: transform 0.7s cubic-bezier(0.25, 0.9, 0.3, 1.1);
  }
  .baraja li:nth-child(1) {
    z-index: 3;
  }
  .baraja li:nth-child(2) {
    z-index: 2;
    transition-delay: 0.05s;
  }
  .baraja li:nth-child(3) {
    z-index: 1;
    transition-delay: 0.1s;
  }
  :global(.js) .baraja:not(.abierta) li:nth-child(1) {
    transform: translateX(calc(100% + var(--gap))) rotate(-3deg);
  }
  :global(.js) .baraja:not(.abierta) li:nth-child(2) {
    transform: rotate(4deg);
  }
  :global(.js) .baraja:not(.abierta) li:nth-child(3) {
    transform: translateX(calc(-100% - var(--gap))) rotate(-8deg);
  }
  /* Con ratón, se abre en abanico al pasar por encima o al llegar con el teclado */
  @media (hover: hover) {
    :global(.js) .baraja:not(.abierta):is(:hover, :focus-within) li {
      transform: none;
    }
  }

  /* Cada nota es una foto impresa: marco blanco, sombra, y la fecha y el título debajo */
  .carta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 12px 12px 22px;
    background: var(--white);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.12),
      0 18px 40px -22px rgba(0, 0, 0, 0.45);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .carta:hover,
  .carta:focus-visible {
    transform: translateY(-6px);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.12),
      0 26px 50px -24px rgba(0, 0, 0, 0.5);
  }
  .carta:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 4px;
  }
  .foto {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 8px;
    background: var(--panel);
  }
  .foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .carta:hover .foto img {
    transform: scale(1.05);
  }
  time {
    padding-inline: 8px;
    font-size: 15px;
    color: var(--muted);
  }
  h3 {
    margin: 0;
    padding-inline: 8px;
    font-size: clamp(20px, 1.7vw, 24px);
    line-height: 1.15;
    font-weight: 700;
    text-wrap: balance;
    transition: color 0.3s var(--ease);
  }
  .carta:hover h3 {
    color: var(--red);
  }

  .cta {
    margin-top: clamp(40px, 5vw, 64px);
    text-align: center;
  }

  /* Entrada suave, como en el resto de la portada */
  .ap {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  :global(.js) #aplicaciones .ap:not(.vista) {
    opacity: 0;
    transform: translateY(24px);
  }

  /* En móvil van una debajo de otra; cerrada, la baraja se apila sobre la primera */
  @media (max-width: 900px) {
    .baraja {
      grid-template-columns: 1fr;
      max-width: 440px;
    }
    .foto {
      aspect-ratio: 16 / 10;
    }
    :global(.js) .baraja:not(.abierta) li:nth-child(1) {
      transform: rotate(-2deg);
    }
    :global(.js) .baraja:not(.abierta) li:nth-child(2) {
      transform: translateY(calc(-100% - var(--gap))) rotate(3deg);
    }
    :global(.js) .baraja:not(.abierta) li:nth-child(3) {
      transform: translateY(calc(-200% - 2 * var(--gap))) rotate(-4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .baraja li {
      transform: none !important;
      transition: none;
    }
    .ap,
    .carta,
    .foto img {
      transition: none;
    }
  }
</style>
