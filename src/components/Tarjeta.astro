---
// Tarjeta de un producto en el catálogo. Escenario de estudio oscuro con un halo del color de su temperatura detrás
// de la máquina (azul la refrigerada, ámbar la calefactada, acero la ventilada): las centrífugas, blancas y grises,
// resaltan sobre el carbón. Detrás, el nombre de la serie en grande; al pie del escenario, las tres cifras en una
// franja de cristal. Debajo, en blanco, la aplicación y el nombre. Toda la tarjeta lleva a la ficha del producto.
import type { Modelo } from '../data/productos';
import type { ProductoLab } from '../data/laboratorio';
import { idioma, numero, ruta, textos } from '../i18n';

interface Props {
  cat: string;
  modelo?: Modelo;
  lab?: ProductoLab;
  capacidad?: string;
}

const { cat, modelo: m, lab: p, capacidad } = Astro.props;
const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const slug = m?.slug ?? p!.slug;
const href = ruta(lang, `/centrifugas/${slug}/`);
const item = p && t.laboratorio.items[p.slug];
const nombre = m ? m.nombre : item!.nombre;
// La primera palabra del nombre ("Digicen", "Consul", "Mesas"), de fondo
const fondo = nombre.split(' ')[0];
---

<a class:list={['tarjeta', { lab: p }]} href={href} data-t={m?.temperatura ?? 'lab'}>
  <div class:list={['foto', { doble: p?.imagen2 }]}>
    <span class="fondo" aria-hidden="true">
      {fondo}
    </span>
    <img
      src={(m ?? p)!.imagen.src}
      alt=""
      width={(m ?? p)!.imagen.ancho}
      height={(m ?? p)!.imagen.alto}
      loading="lazy"
      decoding="async"
    />
    {p?.imagen2 && (
      <img
        class="segunda"
        src={p.imagen2.src}
        alt=""
        width={p.imagen2.ancho}
        height={p.imagen2.alto}
        loading="lazy"
        decoding="async"
      />
    )}
    {m && <span class="temp">{may(t.temperatura[m.temperatura])}</span>}
    {m ? (
      <dl class="cifras">
        <div>
          <dt>{t.catalogo.iconos.capacidad}</dt>
          <dd class:list={{ largo: (capacidad ?? '').length > 10 }}>{capacidad}</dd>
        </div>
        <div>
          <dt>rpm</dt>
          <dd>{numero(lang, m.rpm)}</dd>
        </div>
        <div>
          <dt>{t.catalogo.iconos.pantalla}</dt>
          <dd>{m.pantalla}</dd>
        </div>
      </dl>
    ) : (
      <p class="cifras modelo">{p!.modelo}</p>
    )}
  </div>
  <div class="cuerpo">
    <p class="cat">{cat}</p>
    <h3 class="nombre">{nombre}</h3>
    <span class="ver">{t.catalogo.ficha.verFicha}</span>
  </div>
</a>

<style>
  /* Cada temperatura, su color: etiqueta, halo del escenario y raya al pasar el ratón */
  .tarjeta {
    --c: var(--t-ventilada);
    --halo: rgba(154, 161, 166, 0.55);
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #c9ced2;
    box-shadow:
      0 1px 0 rgba(17, 19, 21, 0.04),
      0 14px 30px -24px rgba(17, 19, 21, 0.45);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease),
      border-color 0.45s var(--ease);
  }
  .tarjeta[data-t='refrigerada'] {
    --c: var(--t-refrigerada);
    --halo: rgba(58, 140, 214, 0.6);
  }
  .tarjeta[data-t='calefactada'] {
    --c: var(--t-calefactada);
    --halo: rgba(222, 120, 40, 0.55);
  }
  .tarjeta[data-t='lab'] {
    --c: var(--red);
    --halo: rgba(221, 4, 10, 0.4);
  }

  /* ——— Escenario oscuro con el halo detrás de la máquina ——— */
  .foto {
    position: relative;
    aspect-ratio: 1 / 0.98;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(58% 50% at 50% 48%, var(--halo), rgba(21, 23, 25, 0) 72%), var(--carbon);
  }
  /* El nombre de la serie, enorme y apenas visible, detrás de la máquina */
  .fondo {
    position: absolute;
    z-index: -1;
    left: 6%;
    top: 5%;
    font-size: clamp(56px, 6.2vw, 96px);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.07);
    white-space: nowrap;
    transition: transform 0.9s var(--ease);
  }
  /* Sombra en el suelo: se encoge cuando la máquina se eleva */
  .foto::after {
    content: '';
    position: absolute;
    left: 22%;
    right: 22%;
    bottom: 25%;
    height: 7%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.75), transparent);
    transition:
      transform 0.6s var(--ease),
      opacity 0.6s var(--ease);
  }
  .foto img {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 40%;
    width: 68%;
    height: auto;
    translate: -50% -50%;
    transition:
      transform 0.7s var(--ease),
      opacity 0.45s var(--ease);
  }
  .foto .segunda {
    opacity: 0;
    width: 100%;
    top: 50%;
  }
  .temp {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    padding: 7px 14px 8px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    color: #fff;
    background: var(--c);
  }

  /* Las tres cifras en una franja de cristal al pie del escenario */
  .cifras {
    position: absolute;
    z-index: 2;
    left: 12px;
    right: 12px;
    bottom: 12px;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 0.8fr);
    background: rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    backdrop-filter: blur(14px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
    color: #fff;
    text-align: center;
  }
  .cifras div {
    display: flex;
    flex-direction: column-reverse;
    padding: 10px 6px 9px;
  }
  .cifras div + div {
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }
  .cifras dd {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .cifras dd.largo {
    font-size: 15px;
    white-space: normal;
  }
  .cifras dt {
    margin-top: 2px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.78);
  }
  .cifras.modelo {
    display: block;
    padding: 12px 10px;
    font-size: 17px;
    font-weight: 700;
  }

  /* ——— Ficha blanca ——— */
  .cuerpo {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 18px 20px 20px;
    text-align: center;
  }
  /* Raya del color de la temperatura entre el escenario y la ficha; crece al pasar el ratón */
  .cuerpo::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--c);
    transform: scaleX(0.12);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }
  .cat {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }
  .nombre {
    margin: 4px 0 0;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.02;
  }
  .ver {
    margin-top: auto;
    padding-top: 12px;
    font-size: 16px;
    font-weight: 700;
    color: var(--red);
  }
  .ver::after {
    content: '»';
    display: inline-block;
    margin-left: 6px;
    transition: transform 0.3s var(--ease);
  }
  .tarjeta:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .tarjeta:hover {
      transform: translateY(-6px);
      border-color: var(--c);
      box-shadow: 0 34px 50px -30px rgba(17, 19, 21, 0.55);
    }
    /* La máquina se eleva sobre su sombra y el nombre de fondo se desliza */
    .tarjeta:hover .foto img {
      transform: translateY(-10px) scale(1.05);
    }
    .tarjeta:hover .foto::after {
      transform: scaleX(0.8);
      opacity: 0.55;
    }
    .tarjeta:hover .fondo {
      transform: translateX(-8%);
    }
    .tarjeta:hover .cuerpo::before {
      transform: scaleX(1);
    }
    .tarjeta:hover .ver::after {
      transform: translateX(5px);
    }
    .tarjeta:hover .foto.doble img:first-of-type {
      opacity: 0;
    }
    .tarjeta:hover .foto.doble .segunda {
      opacity: 1;
    }
  }

  /* Móvil: una por fila, con el escenario más bajo */
  @media (max-width: 640px) {
    .foto {
      aspect-ratio: 1 / 0.8;
    }
    .foto img {
      width: 56%;
      top: 42%;
    }
    .fondo {
      font-size: 84px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tarjeta,
    .foto img,
    .fondo,
    .cuerpo::before {
      transition: none;
    }
  }
</style>
