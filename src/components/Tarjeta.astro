---
// Tarjeta de un producto en el catálogo. El escenario de la foto lleva el tono de su temperatura (azul hielo la
// refrigerada, arena la calefactada, gris la ventilada) y el nombre de la serie en grande y en blanco detrás de la
// máquina, como en el catálogo impreso. Debajo, el nombre y tres cifras centradas. Al pasar el ratón la máquina se
// eleva y el nombre de fondo se desliza. Toda la tarjeta lleva a la ficha del producto.
import type { Modelo } from '../data/productos';
import type { ProductoLab } from '../data/laboratorio';
import { idioma, numero, ruta, textos } from '../i18n';

interface Props {
  cat: string;
  modelo?: Modelo;
  lab?: ProductoLab;
  capacidad?: string;
}

const { cat, modelo: m, lab: p, capacidad } = Astro.props;
const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const slug = m?.slug ?? p!.slug;
const href = ruta(lang, `/centrifugas/${slug}/`);
const item = p && t.laboratorio.items[p.slug];
const nombre = m ? m.nombre : item!.nombre;
// La primera palabra del nombre ("Digicen", "Consul", "Mesas"), de fondo
const fondo = nombre.split(' ')[0];
---

<a class:list={['tarjeta', { lab: p }]} href={href} data-t={m?.temperatura ?? 'lab'}>
  <div class:list={['foto', { doble: p?.imagen2 }]}>
    <span class="fondo" aria-hidden="true">
      {fondo}
    </span>
    <img
      src={(m ?? p)!.imagen.src}
      alt=""
      width={(m ?? p)!.imagen.ancho}
      height={(m ?? p)!.imagen.alto}
      loading="lazy"
      decoding="async"
    />
    {p?.imagen2 && (
      <img
        class="segunda"
        src={p.imagen2.src}
        alt=""
        width={p.imagen2.ancho}
        height={p.imagen2.alto}
        loading="lazy"
        decoding="async"
      />
    )}
    {m && <span class="temp">{may(t.temperatura[m.temperatura])}</span>}
  </div>
  <div class="cuerpo">
    <p class="cat">{cat}</p>
    <h3 class="nombre">{nombre}</h3>
    {m ? (
      <dl class="cifras">
        <div>
          <dt>{t.catalogo.iconos.capacidad}</dt>
          <dd class:list={{ largo: (capacidad ?? '').length > 10 }}>{capacidad}</dd>
        </div>
        <div>
          <dt>rpm</dt>
          <dd>{numero(lang, m.rpm)}</dd>
        </div>
        <div>
          <dt>{t.catalogo.iconos.pantalla}</dt>
          <dd>{m.pantalla}</dd>
        </div>
      </dl>
    ) : (
      <p class="modelo">{p!.modelo}</p>
    )}
    <span class="ver">{t.catalogo.ficha.verFicha}</span>
  </div>
</a>

<style>
  /* Cada temperatura, su color fuerte (etiqueta y raya) y su tono suave (escenario) */
  .tarjeta {
    --c: var(--t-ventilada);
    --tono: #eceef0;
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease),
      border-color 0.45s var(--ease);
  }
  .tarjeta[data-t='refrigerada'] {
    --c: var(--t-refrigerada);
    --tono: #e3edf7;
  }
  .tarjeta[data-t='calefactada'] {
    --c: var(--t-calefactada);
    --tono: #f6ebdf;
  }
  .tarjeta[data-t='lab'] {
    --c: var(--red);
    --tono: #f1efed;
  }

  /* ——— Escenario ——— */
  .foto {
    position: relative;
    aspect-ratio: 1 / 0.82;
    overflow: hidden;
    background: var(--tono);
    isolation: isolate;
  }
  /* El nombre de la serie, enorme y en blanco, detrás de la máquina */
  .fondo {
    position: absolute;
    z-index: -1;
    left: 6%;
    top: 4%;
    font-size: clamp(56px, 6.2vw, 96px);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: #fff;
    white-space: nowrap;
    transition: transform 0.9s var(--ease);
  }
  /* Sombra en el suelo: se encoge cuando la máquina se eleva */
  .foto::after {
    content: '';
    position: absolute;
    left: 22%;
    right: 22%;
    bottom: 8%;
    height: 8%;
    background: radial-gradient(closest-side, rgba(17, 19, 21, 0.3), transparent);
    transition:
      transform 0.6s var(--ease),
      opacity 0.6s var(--ease);
  }
  .foto img {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 52%;
    width: 78%;
    height: auto;
    translate: -50% -50%;
    transition:
      transform 0.7s var(--ease),
      opacity 0.45s var(--ease);
  }
  .foto .segunda {
    opacity: 0;
    width: 100%;
  }
  /* Temperatura en una etiqueta de color lleno, arriba a la izquierda */
  .temp {
    position: absolute;
    z-index: 2;
    left: 0;
    bottom: 0;
    padding: 7px 14px 8px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    color: #fff;
    background: var(--c);
  }

  /* ——— Ficha ——— */
  .cuerpo {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 20px 22px;
    text-align: center;
  }
  /* Raya del color de la temperatura entre la foto y la ficha; crece al pasar el ratón */
  .cuerpo::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--c);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }
  .cat {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }
  .nombre {
    margin: 6px 0 0;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.02;
  }
  .modelo {
    margin: 8px 0 0;
    font-size: 17px;
    color: var(--body);
  }
  /* Tres cifras centradas en columnas, separadas por rayas finas */
  .cifras {
    width: 100%;
    margin: 18px 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 0.8fr);
    border-top: 1px solid var(--line);
  }
  .cifras div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 3px;
    padding: 12px 6px 0;
  }
  .cifras div + div {
    border-left: 1px solid var(--line);
  }
  .cifras dd {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .cifras dd.largo {
    font-size: 15px;
    white-space: normal;
  }
  .cifras dt {
    font-size: 14px;
    color: var(--body);
  }
  .ver {
    margin-top: auto;
    padding-top: 18px;
    font-size: 16px;
    font-weight: 700;
    color: var(--red);
  }
  .ver::after {
    content: '»';
    display: inline-block;
    margin-left: 6px;
    transition: transform 0.3s var(--ease);
  }
  .tarjeta:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .tarjeta:hover {
      transform: translateY(-6px);
      border-color: rgba(26, 26, 26, 0.18);
      box-shadow: 0 34px 50px -32px rgba(17, 19, 21, 0.45);
    }
    /* La máquina se eleva sobre su sombra y el nombre de fondo se desliza */
    .tarjeta:hover .foto img {
      transform: translateY(-10px) scale(1.05);
    }
    .tarjeta:hover .foto::after {
      transform: scaleX(0.82);
      opacity: 0.6;
    }
    .tarjeta:hover .fondo {
      transform: translateX(-8%);
    }
    .tarjeta:hover .cuerpo::before {
      transform: scaleX(1);
    }
    .tarjeta:hover .ver::after {
      transform: translateX(5px);
    }
    .tarjeta:hover .foto.doble img:first-of-type {
      opacity: 0;
    }
    .tarjeta:hover .foto.doble .segunda {
      opacity: 1;
    }
  }

  /* Móvil: una por fila, con la foto más baja */
  @media (max-width: 640px) {
    .foto {
      aspect-ratio: 1 / 0.66;
    }
    .foto img {
      width: 60%;
    }
    .fondo {
      font-size: 84px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tarjeta,
    .foto img,
    .fondo,
    .cuerpo::before {
      transition: none;
    }
  }
</style>
