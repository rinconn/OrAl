---
// Una tarjeta del catálogo (una por serie: si tiene versiones, la página pone el selector encima): caja con borde, y arriba la máquina sobre una mesa de laboratorio oscura (la misma foto
// en todas, retocada: solo una gradilla de tubos y un matraz rojos en los bordes), para que la máquina blanca destaque; debajo, la raya del color de su familia. La máquina, grande, con su
// sombra de apoyo; la temperatura en una etiqueta con su icono. Debajo, aplicación, nombre, frase, placa con tres cifras y
// "Ver producto »". Al pasar el ratón: el borde se oscurece, la tarjeta sube un poco y la máquina crece ligeramente.
import type { Modelo } from '../data/productos';
import type { ProductoLab } from '../data/laboratorio';
import IconoTemp from './ui/IconoTemp.astro';
import { idioma, numero, ruta, textos } from '../i18n';

interface Version {
  m: Modelo;
  capacidad: string;
  /** Fuerza máxima ya formateada, sin "xg" */
  fuerza?: string;
}
interface Props {
  /** Las versiones de una serie (22 y 22 R, o C, C-U y C-8); la primera es la que se ve al cargar */
  versiones?: Version[];
  lab?: ProductoLab;
  /** Aplicación (Microcentrífuga, Universal…) */
  uso: string;
  frase?: string;
  /** Color de la familia (src/data/productos.ts) */
  color: string;
}

const { versiones: vs, lab: p, uso, frase, color } = Astro.props;
const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const tf = t.catalogo.ficha;
const m = vs?.[0].m;
const href = ruta(lang, `/centrifugas/${m?.slug ?? p!.slug}/`);
const cifras = (v: Version) => [
  { k: tf.capacidad, v: v.capacidad, u: '' },
  { k: tf.velocidad, v: numero(lang, v.m.rpm), u: 'rpm' },
  ...(v.fuerza ? [{ k: tf.fuerza, v: v.fuerza, u: '× g' }] : []),
];
---

<a class:list={['pieza', { lab: p }]} href={href} style={`--fam: ${color}`}>
  <span class="estudio">
    {vs ? (
      vs.map((v, i) => (
        <>
          <span class:list={['temp', v.m.temperatura]} data-v={i} hidden={i > 0}>
            <IconoTemp t={v.m.temperatura} size={15} />
            {t.temperatura[v.m.temperatura]}
          </span>
          <img
            src={v.m.imagen.src}
            alt=""
            width={v.m.imagen.ancho}
            height={v.m.imagen.alto}
            loading="lazy"
            decoding="async"
            data-v={i}
            hidden={i > 0}
          />
        </>
      ))
    ) : (
      <img src={p!.imagen.src} alt="" width={p!.imagen.ancho} height={p!.imagen.alto} loading="lazy" decoding="async" />
    )}
    <span class="velo" aria-hidden="true"></span>
  </span>

  <span class="cuerpo">
    <span class="uso">{uso}</span>
    <h3 class="nombre">
      {vs
        ? vs.map((v, i) => (
            <span data-v={i} hidden={i > 0}>
              {v.m.nombre}
            </span>
          ))
        : t.laboratorio.items[p!.slug].nombre}
    </h3>
    {frase && <span class="frase">{frase}</span>}
  </span>

  <!-- Placa de datos: cada cifra con su nombre arriba y la unidad pequeña al lado -->
  {vs ? (
    vs.map((v, i) => (
      <span class="placa" data-v={i} hidden={i > 0}>
        {cifras(v).map((c) => (
          <span class:list={['cifra', { largo: c.v.length > 11, rpm: c.u === 'rpm' }]}>
            <small>{c.k}</small>
            <b>
              <span class="valor">{c.v}</span>
              {c.u && <i>{'\u00a0' + c.u}</i>}
            </b>
          </span>
        ))}
      </span>
    ))
  ) : (
    <span class="placa modelo">{p!.modelo}</span>
  )}

  <span class="ver">
    <span>{tf.verProducto}</span>
    <span class="flecha" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18">
        <path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"></path>
      </svg>
    </span>
  </span>
</a>

<style>
  [hidden] {
    display: none !important;
  }
  .pieza {
    --sube: cubic-bezier(0.23, 1, 0.32, 1);
    --borde: #b4b9bd;
    --marco: #5f656b;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 2px solid var(--marco);
    color: var(--ink);
    text-decoration: none;
    outline: 0;
    transition:
      transform 0.45s var(--sube),
      border-color 0.25s ease,
      box-shadow 0.45s var(--sube);
  }

  /* ——— Estudio: la máquina sobre la mesa de laboratorio, con su sombra de apoyo ——— */
  .estudio {
    position: relative;
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: #2b2e31 url(/img/fondos/mesa-tarjeta.webp) center / cover no-repeat;
    border-bottom: 3px solid var(--fam);
  }
  /* Sombra de apoyo bajo la máquina */
  .estudio::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 13%;
    width: 58%;
    height: 7%;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    filter: blur(10px);
    translate: -50% 50%;
    transition:
      scale 0.45s var(--sube),
      opacity 0.45s var(--sube);
  }
  .estudio img {
    position: absolute;
    left: 50%;
    bottom: 11%;
    z-index: 1;
    width: auto;
    height: 82%;
    max-width: 86%;
    object-fit: contain;
    object-position: bottom;
    translate: -50% 0;
    transform-origin: bottom;
    transition: transform 0.5s var(--sube);
  }
  /* Al cambiar de versión: un velo frío (refrigerada) o cálido (calefactada) barre la foto y se va */
  .velo {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
  }
  .lab .estudio img {
    height: 74%;
  }

  /* Temperatura: etiqueta blanca con su icono en su color */
  .temp {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 11px 0 9px;
    background: #fff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(17, 19, 21, 0.12);
  }
  .temp :global(svg) {
    color: var(--tc);
  }
  .ventilada {
    --tc: #6f7a81;
  }
  .refrigerada {
    --tc: #2a7fc4;
  }
  .calefactada {
    --tc: var(--red);
  }

  /* ——— Cuerpo ——— */
  .cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 22px 24px 24px;
  }
  .uso {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .uso::before {
    content: '';
    width: 10px;
    height: 10px;
    background: var(--fam);
  }
  .nombre {
    margin: 10px 0 0;
    font-size: clamp(28px, 2.4vw, 34px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .frase {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 300;
    line-height: 1.35;
    color: var(--body);
  }
  /* Placa de datos: banda gris de borde a borde con tres casillas */
  .placa {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.1fr) minmax(0, 1fr);
    margin-top: 4px;
    background: #f3f4f5;
    border-top: 1px solid var(--borde);
  }
  .cifra {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 14px 10px 14px 20px;
    font-variant-numeric: tabular-nums;
  }
  .cifra + .cifra {
    padding-left: 12px;
    border-left: 1px solid var(--borde);
  }
  .cifra small {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .cifra b {
    font-size: clamp(19px, 1.5vw, 22px);
    font-weight: 400;
    line-height: 1.1;
    white-space: nowrap;
    color: var(--ink);
  }
  /* Capacidades largas ("12 butirómetros"): un punto más pequeñas y, si no caben, en dos líneas */
  .cifra.largo b {
    font-size: 17px;
    white-space: normal;
  }
  /* La unidad va pegada a su cifra (espacio duro), nunca sola en otra línea */
  .cifra i {
    white-space: nowrap;
    font-size: 15px;
    font-style: normal;
    font-weight: 400;
    color: var(--body);
  }
  .placa.modelo {
    display: block;
    padding: 16px 24px;
    font-size: 17px;
    font-weight: 700;
  }

  /* Franja de abajo: a la izquierda va "Presupuesto" (lo pone la página encima), a la derecha "Ver producto →" */
  .ver {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    height: 56px;
    padding: 0 20px 0 calc(50% + 16px);
    border-top: 1px solid var(--borde);
    font-size: 17px;
    font-weight: 700;
    color: var(--red);
    position: relative;
    isolation: isolate;
    transition: color 0.3s ease;
  }
  /* Al pasar por la tarjeta, la mitad de "Ver producto" se llena de rojo de izquierda a derecha */
  .ver::before {
    content: '';
    position: absolute;
    inset: 0 0 0 50%;
    z-index: -1;
    background: var(--red);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.45s var(--sube);
  }
  .flecha {
    display: grid;
    place-items: center;
  }
  .flecha svg {
    transition: translate 0.45s var(--sube);
  }

  @media (hover: hover) and (pointer: fine) {
    .pieza:hover {
      border-color: #bfc4c8;
      box-shadow:
        0 2px 4px rgba(17, 19, 21, 0.06),
        0 24px 48px -20px rgba(17, 19, 21, 0.3);
    }
    .pieza:hover .estudio img {
      transform: scale(1.04);
    }
    .pieza:hover .estudio::after {
      scale: 0.92;
      opacity: 0.8;
    }
    .pieza:hover .ver {
      color: #fff;
    }
    .pieza:hover .ver::before {
      scale: 1 1;
    }
    .pieza:hover .flecha svg {
      translate: 4px 0;
    }
  }
  .pieza:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }
  .pieza:active {
    transform: scale(0.99);
    transition-duration: 0.12s;
  }

  @media (max-width: 640px) {
    .cuerpo {
      padding: 18px 18px 20px;
    }
    .ver {
      padding-right: 16px;
    }
    .cifra {
      padding-left: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pieza,
    .estudio img,
    .estudio::after,
    .flecha svg,
    .ver::before {
      transition-property: border-color, box-shadow, opacity;
    }
    .pieza:hover,
    .pieza:hover .estudio img {
      transform: none;
    }
  }
</style>
