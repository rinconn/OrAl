---
// Una tarjeta del catálogo (una por serie: si tiene versiones, la página pone el selector encima): caja con borde, y arriba la máquina sobre una mesa de laboratorio oscura (la misma foto
// en todas, retocada: solo una gradilla de tubos y un matraz rojos en los bordes), para que la máquina blanca destaque; debajo, la raya del color de su familia. La máquina, grande, con su
// sombra de apoyo; la temperatura en una etiqueta con su icono (con varias versiones, la dice el selector). Debajo, aplicación, nombre, frase, placa con tres cifras y
// "Ver producto »". Al pasar el ratón: el borde se oscurece, la tarjeta sube un poco y la máquina crece ligeramente.
import type { Modelo } from '../data/productos';
import type { ProductoLab } from '../data/laboratorio';
import IconoTemp from './ui/IconoTemp.astro';
import { idioma, numero, ruta, textos } from '../i18n';

interface Version {
  m: Modelo;
  capacidad: string;
  /** Fuerza máxima ya formateada, sin "xg" */
  fuerza?: string;
}
interface Props {
  /** Las versiones de una serie (22 y 22 R, o C, C-U y C-8); la primera es la que se ve al cargar */
  versiones?: Version[];
  lab?: ProductoLab;
  /** Aplicación (Microcentrífuga, Universal…) */
  uso: string;
  frase?: string;
  /** Color de la familia (src/data/productos.ts) */
  color: string;
}

const { versiones: vs, lab: p, uso, frase, color } = Astro.props;
const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const tf = t.catalogo.ficha;
const m = vs?.[0].m;
const href = ruta(lang, `/centrifugas/${m?.slug ?? p!.slug}/`);
const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const cifras = (v: Version) => [
  { k: tf.capacidad, v: v.capacidad, u: '' },
  { k: tf.velocidad, v: numero(lang, v.m.rpm), u: 'rpm' },
  ...(v.fuerza ? [{ k: tf.fuerza, v: v.fuerza, u: '× g' }] : []),
];
---

<a class:list={['pieza', { lab: p }]} href={href} style={`--fam: ${color}`}>
  <span class="estudio">
    <span class="anillo" aria-hidden="true"></span>
    {vs ? (
      vs.map((v, i) => (
        <>
          {vs.length === 1 && (
            <span class:list={['temp', v.m.temperatura]}>
              <IconoTemp t={v.m.temperatura} size={15} />
              {may(t.temperatura[v.m.temperatura])}
            </span>
          )}
          <img
            src={v.m.imagen.src}
            alt=""
            width={v.m.imagen.ancho}
            height={v.m.imagen.alto}
            loading="lazy"
            decoding="async"
            data-v={i}
            hidden={i > 0}
          />
        </>
      ))
    ) : (
      <img src={p!.imagen.src} alt="" width={p!.imagen.ancho} height={p!.imagen.alto} loading="lazy" decoding="async" />
    )}
  </span>

  <span class="cuerpo">
    <span class="uso">{uso}</span>
    <h3 class="nombre">
      {vs
        ? vs.map((v, i) => (
            <span data-v={i} hidden={i > 0}>
              {v.m.nombre}
            </span>
          ))
        : t.laboratorio.items[p!.slug].nombre}
    </h3>
    {frase && <span class="frase">{frase}</span>}
  </span>

  <!-- Con un tubo elegido en los filtros: en qué rotor va y cuántos caben (lo rellena la página) -->
  {vs && (
    <span class="con-tubo" hidden>
      <span class="texto" />
    </span>
  )}

  <!-- Las tres cifras en mosaicos: la cifra grande arriba y su nombre debajo (en el HTML, el nombre va primero) -->
  {vs ? (
    vs.map((v, i) => (
      <span class="placa" data-v={i} hidden={i > 0}>
        {cifras(v).map((c) => (
          <span class:list={['cifra', { largo: c.v.length > 11 }]}>
            <small>{c.k}</small>
            <b>
              {c.v}
              {c.u && <i>{' ' + c.u}</i>}
            </b>
          </span>
        ))}
      </span>
    ))
  ) : (
    <span class="placa modelo">{p!.modelo}</span>
  )}

  <span class="ver">
    <span class="boton">
      <span class="txt">{tf.verProducto}</span>
      <span class="flecha" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
      </span>
    </span>
  </span>
</a>

<style>
  [hidden] {
    display: none !important;
  }
  .pieza {
    /* El color de la familia, más vivo (como en la raya de su portada) */
    --fam-vivo: oklch(from var(--fam) calc(l + 0.06) calc(c * 2) h);
    --sube: cubic-bezier(0.23, 1, 0.32, 1);
    --borde: #b4b9bd;
    --marco: #5f656b;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #fff;
    border: 1px solid color-mix(in oklch, var(--fam-vivo) 22%, #e2e5e8);
    border-radius: 14px;
    color: var(--ink);
    text-decoration: none;
    outline: 0;
    transition:
      transform 0.45s var(--sube),
      border-color 0.25s ease,
      box-shadow 0.45s var(--sube);
  }

  /* ——— Estudio: la máquina sobre la mesa de laboratorio, con su sombra de apoyo ——— */
  .estudio {
    position: relative;
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: #2b2e31 url(/img/fondos/mesa-tarjeta.webp) center / cover no-repeat;
    border-bottom: 5px solid var(--fam-vivo);
  }
  /* Sombra de apoyo bajo la máquina */
  .estudio::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 13%;
    width: 58%;
    height: 7%;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    filter: blur(10px);
    translate: -50% 50%;
    transition:
      scale 0.45s var(--sube),
      opacity 0.45s var(--sube);
  }
  .estudio img {
    position: absolute;
    left: 50%;
    bottom: 11%;
    z-index: 1;
    width: auto;
    height: 82%;
    max-width: 86%;
    object-fit: contain;
    object-position: bottom;
    translate: -50% 0;
    transform-origin: bottom;
    transition: transform 0.6s var(--sube);
  }
  .lab .estudio img {
    height: 74%;
  }

  /* Temperatura: etiqueta blanca con su icono en su color */
  .temp {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 11px 0 9px;
    border-radius: 8px;
    background: #fff;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    box-shadow: 0 2px 8px rgba(17, 19, 21, 0.18);
  }
  .temp :global(svg) {
    color: var(--tc);
  }
  .ventilada {
    --tc: #6f7a81;
  }
  .refrigerada {
    --tc: #2a7fc4;
  }
  .calefactada {
    --tc: var(--red);
  }

  /* ——— Cuerpo ——— */
  .cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 22px 24px 24px;
  }
  .uso {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .uso::before {
    content: '';
    width: 10px;
    height: 10px;
    background: var(--fam-vivo);
  }
  .nombre {
    margin: 10px 0 0;
    font-size: clamp(28px, 2.4vw, 34px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  /* La frase es lo único que explica la máquina: en peso normal, que en ligera (300) la condensada quedaba muy fina */
  .frase {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.35;
    color: var(--body);
  }
  /* "Con tu tubo": franja oscura de borde a borde, con el tubo en rojo delante */
  .con-tubo {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 46px;
    padding: 12px 24px;
    background: var(--ink);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
  }
  /* El texto se centra por sus mayúsculas, no por la caja de la letra (que deja más aire abajo) */
  .con-tubo .texto {
    text-box: trim-both cap alphabetic;
  }
  /* El tubo: un poco más alto que las mayúsculas, centrado con ellas */
  .con-tubo::before {
    content: '';
    flex: none;
    box-sizing: border-box;
    width: 9px;
    height: 16px;
    border: 1.5px solid #fff;
    border-top: 4px solid var(--red);
    border-radius: 0 0 4.5px 4.5px;
  }
  /* Con la banda puesta, la placa va pegada debajo, sin hueco blanco entre las dos */
  .con-tubo:not([hidden]) ~ .placa {
    margin-top: 0;
    border-top: 0;
  }

  /* ——— Parte de abajo: las tres cifras en mosaicos gris suave (la cifra grande, su nombre debajo) y una fila de
     botones redondeados con aire alrededor, sin rayas ni divisores ——— */
  .pieza {
    --boton: 40px;
    --aire: 16px;
    --suave: #eceef1;
  }
  .placa {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin: auto var(--aire) 0;
    padding-top: 4px;
  }
  .cifra {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 3px;
    min-width: 0;
    padding: 11px 12px 10px;
    border-radius: 10px;
    background: var(--suave);
    box-shadow: inset 0 0 0 1px #d8dce1;
    font-variant-numeric: tabular-nums;
    transition: background-color 0.35s ease;
  }
  .cifra small {
    overflow: hidden;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .cifra b {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--ink);
  }
  /* Capacidades largas ("12 butirómetros"): un punto más pequeñas y, si no caben, en dos líneas */
  .cifra.largo b {
    font-size: 15px;
    white-space: normal;
  }
  /* La unidad va pegada a su cifra (espacio duro), nunca sola en otra línea */
  .cifra i {
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    color: var(--muted);
  }
  .placa.modelo {
    display: block;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--suave);
    font-size: 16px;
    font-weight: 700;
  }
  /* Tarjeta estrecha (cuatro columnas a 1360-1500 px): un punto más pequeño para que "21.948 × g" quepa */
  @container (max-width: 330px) {
    .cifra {
      padding: 10px 9px 9px;
    }
    .cifra b {
      font-size: 16px;
    }
    .cifra small {
      font-size: 11px;
    }
  }

  /* Fila de botones: a la izquierda la página pone "Presupuesto" y, en las centrífugas, "Comparar"; a la derecha,
     "Ver producto": en las centrífugas solo la flecha, en una casilla que se pone roja al pasar por la tarjeta; en
     los equipos, con su texto */
  .ver {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    height: calc(var(--boton) + var(--aire) + 12px);
    padding: 12px var(--aire) 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: var(--boton);
    min-width: var(--boton);
    padding: 0 14px;
    border-radius: 10px;
    background: var(--suave);
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .pieza:not(.lab) .boton {
    padding: 0;
  }
  .pieza:not(.lab) .txt {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .flecha {
    display: grid;
    place-items: center;
  }
  .flecha svg {
    transition: translate 0.45s var(--sube);
  }

  /* ——— Vida al pasar el ratón ———
     · Borde: una luz del color de la familia recorre el borde siguiendo el cursor (--mx/--my, del script de abajo).
     · Centrífuga: quieta, con un anillo rojo girando debajo, como al centrifugar.
     · Tarjeta: sube 3 px con una sombra tintada del color de su familia (solo se mueve una cosa).
     · Flecha: se llena de rojo y la flecha sale por la derecha y vuelve a entrar por la izquierda */
  @property --giro {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  .pieza::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: 5;
    padding: 1.5px;
    border-radius: inherit;
    background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 0%), var(--fam-vivo), transparent 70%);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .anillo {
    position: absolute;
    left: 50%;
    bottom: 6%;
    width: 74%;
    height: 17%;
    border-radius: 50%;
    translate: -50% 0;
    background: conic-gradient(
      from var(--giro),
      transparent 0deg,
      rgba(221, 4, 10, 0.15) 120deg,
      #ff2a30 200deg,
      transparent 230deg,
      transparent 300deg,
      rgba(255, 255, 255, 0.55) 340deg,
      transparent 360deg
    );
    mask: radial-gradient(closest-side, transparent 80%, #000 84%, #000 96%, transparent 100%);
    filter: drop-shadow(0 0 6px rgba(255, 42, 48, 0.8));
    opacity: 0;
    scale: 0.8;
    transition:
      opacity 0.4s ease,
      scale 0.6s var(--sube);
    pointer-events: none;
  }
  @keyframes gira {
    to {
      --giro: 360deg;
    }
  }
  @keyframes sale-entra {
    45% {
      translate: 130% 0;
      opacity: 0;
    }
    46% {
      translate: -130% 0;
      opacity: 0;
    }
  }
  .boton {
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .pieza:hover {
      border-color: color-mix(in oklch, var(--fam-vivo) 45%, #dfe2e5);
      transform: translateY(-3px);
      box-shadow:
        0 2px 6px rgba(17, 19, 21, 0.06),
        0 34px 60px -30px color-mix(in oklch, var(--fam-vivo) 70%, transparent);
    }
    .pieza:hover::before {
      opacity: 1;
    }
    .pieza:hover .anillo {
      opacity: 1;
      scale: 1;
      animation: gira 1.6s linear infinite;
    }
    .pieza:hover .boton {
      color: #fff;
      background: var(--red);
      box-shadow: 0 8px 18px -8px rgba(221, 4, 10, 0.7);
    }
    .pieza:hover .flecha svg {
      animation: sale-entra 0.6s var(--sube);
    }
    .pieza:hover .cifra {
      background: color-mix(in oklch, var(--fam-vivo) 9%, var(--suave));
    }
  }
  .pieza:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }
  .pieza:active {
    transform: scale(0.99);
    transition-duration: 0.12s;
  }

  /* ——— Teléfono: tarjeta compacta. Arriba, la foto a la izquierda (40 %) y al lado aplicación, nombre y frase (168 px;
     solo crece en algún equipo de nombre largo, que no tiene versiones), con la
     raya de la familia debajo de las dos; luego la placa de cifras y una franja de botones. La página (Centrifugas)
     abre debajo de la raya un hueco para las versiones y pone Presupuesto y Comparar en la franja ——— */
  @media (max-width: 640px) {
    .pieza {
      --alto: 168px;
      /* Lo que ocupan Presupuesto (y Comparar, en las centrífugas) a la izquierda de la franja de abajo */
      --izq: 75%;
      display: grid;
      grid-template-columns: 40% minmax(0, 1fr);
      grid-template-rows: minmax(var(--alto), auto) var(--hueco, 0);
      height: auto;
    }
    .pieza.lab {
      --izq: 42%;
    }
    .estudio {
      grid-area: 1 / 1;
      aspect-ratio: auto;
      border-bottom-width: 4px;
    }
    .estudio img {
      bottom: 12px;
      height: calc(100% - 50px);
      max-width: 88%;
    }
    .lab .estudio img {
      height: calc(100% - 60px);
    }
    .estudio::after {
      bottom: 12px;
      filter: blur(6px);
    }
    .temp {
      top: 8px;
      left: 8px;
      gap: 5px;
      height: 24px;
      padding: 0 8px 0 6px;
      font-size: 11px;
    }
    .temp :global(svg) {
      width: 13px;
      height: 13px;
    }
    .cuerpo {
      grid-area: 1 / 2;
      min-width: 0;
      padding: 14px 14px 10px;
      border-bottom: 4px solid var(--fam-vivo);
    }
    .uso {
      gap: 7px;
      font-size: 12px;
    }
    .uso::before {
      width: 8px;
      height: 8px;
    }
    .nombre {
      margin-top: 6px;
      font-size: 24px;
    }
    .frase {
      margin-top: 6px;
      font-size: 15px;
      line-height: 1.3;
    }
    .con-tubo {
      grid-area: 3 / 1 / 4 / -1;
      padding: 8px 14px;
      font-size: 14px;
    }
    .placa {
      grid-area: 4 / 1 / 5 / -1;
      margin: 14px 14px 0;
      padding: 0;
    }
    .cifra b {
      font-size: 17px;
    }
    .cifra.largo b {
      font-size: 15px;
    }
    .pieza {
      --aire: 14px;
    }
    .ver {
      grid-area: 5 / 1 / 6 / -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pieza,
    .estudio img,
    .estudio::after,
    .flecha svg,
    .anillo {
      transition-property: border-color, box-shadow, opacity;
    }
    .pieza:hover,
    .pieza:hover .estudio img {
      transform: none;
    }
    .pieza:hover .anillo,
    .pieza:hover .flecha svg {
      animation: none;
    }
  }
</style>

<script>
  // La luz del borde sigue al cursor: cada tarjeta guarda dónde está el ratón dentro de ella
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    addEventListener(
      'pointermove',
      (ev) => {
        const c = (ev.target as Element | null)?.closest?.<HTMLElement>('.pieza');
        if (!c) return;
        const r = c.getBoundingClientRect();
        c.style.setProperty('--mx', `${ev.clientX - r.left}px`);
        c.style.setProperty('--my', `${ev.clientY - r.top}px`);
      },
      { passive: true },
    );
  }
</script>
