---
// Visor 3D de la Digicen 22: el modelo de SolidWorks de la empresa, que gira y se abre en despiece con sus piezas
// etiquetadas. Sin WebGL o mientras carga se ve la foto del catálogo. La lógica está en src/scripts/visor3d.ts.
import { idioma, textos } from '../i18n';

const t = textos(idioma(Astro.currentLocale));
const v = t.catalogo.visor;
---

<!-- Sin WebGL o mientras carga se ve la foto; el modelo aparece encima cuando está listo -->
<figure class="visor" id="visor" data-src="/3d/digicen22.glb" data-draco="/3d/draco/">
  <div class="lienzo" role="img" aria-label={v.alt}>
    <img
      class="poster"
      src="/img/catalogo/digicen-22.webp"
      alt=""
      width="640"
      height="640"
      fetchpriority="high"
      decoding="async"
    />
    {Object.entries(v.piezas).map(([codigo, nombre]) => (
      <span class="pieza" data-codigo={codigo} aria-hidden="true">
        <b>{codigo}</b>
        {nombre}
      </span>
    ))}
    <i class="carga" aria-hidden="true">
      <i></i>
    </i>
  </div>
  <figcaption class="mandos">
    <p class="nombre">
      <b>{v.nombre}</b>
      <span>{v.etiqueta}</span>
    </p>
    <p class="girar" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18">
        <path
          d="M4 12a8 8 0 0 1 14.5-4.6M20 12a8 8 0 0 1-14.5 4.6M18.5 3v4.4H14M5.5 21v-4.4H10"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
      {v.girar}
    </p>
    <button type="button" class="abrir" aria-pressed="false" data-abrir={v.abrir} data-cerrar={v.cerrar} hidden>
      <span>{v.abrir}</span>
    </button>
  </figcaption>
</figure>

<script>
  // Visor 3D: three.js se descarga aparte, solo si el navegador tiene WebGL. Si algo falla, queda la foto.
  const visor = document.getElementById('visor');
  const webgl = (() => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  })();
  if (visor && webgl) {
    const lienzo = visor.querySelector<HTMLElement>('.lienzo')!;
    const boton = visor.querySelector<HTMLButtonElement>('.abrir')!;
    const barra = visor.querySelector<HTMLElement>('.carga > i')!;
    visor.classList.add('cargando');
    import('../scripts/visor3d')
      .then(({ crearVisor }) =>
        crearVisor(lienzo, {
          src: visor.dataset.src!,
          draco: visor.dataset.draco!,
          etiquetas: [...lienzo.querySelectorAll<HTMLElement>('.pieza')].map((el) => ({
            codigo: el.dataset.codigo!,
            el,
          })),
          quieto: matchMedia('(prefers-reduced-motion: reduce)').matches,
          alProgreso: (p) => (barra.style.transform = `scaleX(${p})`),
          alCargar: () => {
            visor.classList.remove('cargando');
            visor.classList.add('listo');
            boton.hidden = false;
          },
        }),
      )
      .then((v3d) => {
        boton.addEventListener('click', () => {
          const abierto = boton.getAttribute('aria-pressed') !== 'true';
          boton.setAttribute('aria-pressed', String(abierto));
          boton.querySelector('span')!.textContent = abierto ? boton.dataset.cerrar! : boton.dataset.abrir!;
          v3d.abrir(abierto);
        });
      })
      .catch(() => visor.classList.remove('cargando'));
  }
</script>

<style>
  /* Visor 3D */
  .visor {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    margin: 0;
    min-height: 460px;
  }
  .lienzo {
    position: relative;
    flex: 1;
    min-height: 0;
  }
  .lienzo :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    cursor: grab;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }
  .lienzo :global(canvas:active) {
    cursor: grabbing;
  }
  .listo .lienzo :global(canvas) {
    opacity: 1;
  }
  .poster {
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: min(78%, 520px);
    height: auto;
    translate: -50% 0;
    transition: opacity 0.6s var(--ease);
  }
  .listo .poster {
    opacity: 0;
  }
  /* Barra de carga roja, fina, al pie del visor */
  .carga {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .carga i {
    display: block;
    height: 100%;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s linear;
  }
  .cargando .carga {
    opacity: 1;
  }
  /* Etiquetas del despiece: punto rojo, código y nombre, como las llamadas de un plano */
  .pieza {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: -11px 0 0 14px;
    padding: 3px 9px 4px;
    background: rgba(21, 23, 25, 0.78);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 14px;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
  }
  .pieza b {
    font-size: 12px;
    color: var(--red);
    letter-spacing: 0.04em;
  }
  .pieza::before {
    content: '';
    position: absolute;
    left: -15px;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 3px rgba(221, 4, 10, 0.25);
  }
  .pieza::after {
    content: '';
    position: absolute;
    left: -8px;
    top: 50%;
    width: 8px;
    height: 1px;
    background: rgba(255, 255, 255, 0.4);
  }
  /* Mandos: nombre del modelo, cómo se gira y el botón del despiece */
  .mandos {
    display: flex;
    align-items: center;
    gap: 12px 20px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .nombre {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
  }
  .nombre b {
    font-size: 22px;
  }
  .nombre span {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }
  .girar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 15px;
    color: var(--on-dark);
    transition: opacity 0.4s var(--ease);
  }
  .visor:not(.listo) .girar,
  .visor:has(.tocado) .girar {
    opacity: 0;
  }
  .abrir {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding: 0 22px;
    border: 1px solid var(--red);
    background: var(--red);
    font: 700 17px var(--f);
    color: #fff;
    cursor: pointer;
    animation: aparece 0.5s var(--ease);
    transition:
      background 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .abrir::after {
    content: '»';
    font-weight: 300;
    transition: transform 0.3s var(--ease);
  }
  .abrir[aria-pressed='true'] {
    background: transparent;
    color: #fff;
  }
  .abrir[aria-pressed='true']::after {
    transform: rotate(90deg);
  }
  .abrir:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .abrir:hover {
      background: var(--red-d);
    }
    .abrir[aria-pressed='true']:hover {
      background: rgba(221, 4, 10, 0.18);
    }
  }
  @media (pointer: coarse) {
    .girar {
      display: none;
    }
    .lienzo :global(canvas) {
      cursor: default;
    }
  }
  @media (max-width: 900px) {
    .visor {
      min-height: clamp(380px, 92vw, 560px);
    }
  }
  @keyframes aparece {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
