---
// Franja de la gama en la portada: solo cinco fotos, una por familia, y la entrada al catálogo.
// El catálogo completo, con todas las series y sus cifras, vive en /centrifugas/.
import { productos, totalModelos } from '../data/productos';

const destacadas = ['biocen-22-r', 'digicen-22', 'digtor-22', 'cyto-22', 'lacter-21'].map((slug) => {
  const p = productos.find((x) => x.slug === slug);
  if (!p) throw new Error(`Franja de la gama: no existe la serie "${slug}"`);
  return p;
});
---

<section class="sec" id="gama">
  <div class="wrap">
    <div class="cab">
      <div>
        <h2>
          La gama completa, <b>siempre en stock</b>
        </h2>
        <p class="lead">
          {totalModelos} modelos en {productos.length} series, de la minicentrífuga a los equipos de suelo.
        </p>
      </div>
      <a class="btn" href="/centrifugas/">
        Ver todas las centrífugas
      </a>
    </div>

    <ul class="fila">
      {destacadas.map((p, i) => (
        <li style={`--n: ${i}`}>
          <a href={`/centrifugas/#${p.slug}`}>
            <span class="foto">
              <img
                src={p.imagen.src}
                alt=""
                width={p.imagen.ancho}
                height={p.imagen.alto}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="nombre">{p.nombre}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Entrada suave la primera vez que se ve la franja
  const seccion = document.getElementById('gama');
  if (seccion && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        if (entradas.some((e) => e.isIntersecting)) {
          seccion.classList.add('vista');
          obs.disconnect();
        }
      },
      { threshold: 0.15 },
    );
    obs.observe(seccion);
  }
</script>

<style>
  .cab {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 48px;
    flex-wrap: wrap;
  }
  h2 {
    max-width: 19ch;
    font-size: var(--t-titulo);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.015em;
  }
  .lead {
    margin-top: 24px;
    max-width: 52ch;
    font-size: var(--t-sub);
    color: var(--body);
  }
  .btn::after {
    content: '»';
    margin-left: 10px;
    color: var(--red);
    transition: color 0.2s var(--ease);
  }
  .btn:hover::after {
    color: #fff;
  }

  .fila {
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }
  .fila a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  /* Misma tarjeta que el resto de la web: sube, crece la raya roja arriba y la esquina oscura se pone roja */
  .foto {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--panel);
    border: 2px solid #3b4045;
    transition:
      transform 0.35s var(--ease),
      border-color 0.3s var(--ease);
  }
  .foto::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0 auto auto 0;
    width: 0;
    height: 4px;
    background: var(--red);
    transition: width 0.4s var(--ease);
  }
  .foto::after {
    content: '';
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    border-style: solid;
    border-width: 0 18px 18px 0;
    border-color: transparent #3b4045 transparent transparent;
    transition: border-color 0.3s var(--ease);
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.7s var(--ease);
  }
  .nombre {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 14px;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.1;
  }
  .nombre::after {
    content: '»';
    color: var(--red);
    transition: transform 0.3s var(--ease);
  }
  .fila a:hover .foto {
    transform: translateY(-4px);
    border-color: var(--ink);
  }
  .fila a:hover .foto::before {
    width: 100%;
  }
  .fila a:hover .foto::after {
    border-right-color: var(--red);
  }
  .fila a:hover img {
    transform: scale(1.04);
  }
  .fila a:hover .nombre::after {
    transform: translateX(5px);
  }

  .cab,
  .fila li {
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  .fila li {
    transition-delay: calc(0.15s + var(--n) * 60ms);
  }
  :global(.js) #gama:not(.vista) .cab,
  :global(.js) #gama:not(.vista) .fila li {
    opacity: 0;
    transform: translateY(20px);
  }

  /* Móvil: las fotos se deslizan con el dedo en una sola fila */
  @media (max-width: 900px) {
    .fila {
      margin-top: 36px;
      margin-inline: calc(var(--gut) * -1);
      padding-inline: var(--gut);
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 44%;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gut);
      scrollbar-width: none;
    }
    .fila::-webkit-scrollbar {
      display: none;
    }
    .fila li {
      scroll-snap-align: start;
    }
    .nombre {
      font-size: 19px;
    }
  }
  @media (max-width: 620px) {
    .fila {
      grid-auto-columns: 62%;
    }
    .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
