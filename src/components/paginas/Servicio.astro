---
// Servicio técnico: el parte de servicio en la web, en vez del PDF que había que imprimir, rellenar y escanear.
// · Portada sin foto: un plano de taller (cuadrícula y el despiece de un rotor con su escala de calibración).
// · Los campos son los del "Service Pattern" (PGC-IT-128) que publica la fábrica: datos del distribuidor, del equipo y
//   descripción de la incidencia. Si el equipo vuelve a fábrica, el aviso del certificado de descontaminación
//   (PGC-IT-091) con sus documentos para descargar.
// · A la izquierda, los tres pasos en vertical: cada uno resume lo ya rellenado; debajo, el contacto directo.
//   A la derecha, la tarjeta con el paso abierto y sus botones al pie.
// · Lo escrito se guarda en el navegador hasta que se envía, por si se cierra la pestaña a medias.
// Destino: la URL del flujo de Power Automate ("Cuando se recibe una solicitud HTTP") en PUBLIC_SAT_URL. Se envía un
// JSON con los campos más idioma y página. Mientras esté vacía, se abre un correo al servicio técnico con todo escrito.
// Sin JavaScript se ven los tres pasos seguidos y el formulario se envía por correo.
import Base from '../../layouts/Base.astro';
import { modelos } from '../../data/productos';
import { equipos } from '../../data/laboratorio';
import { generales, type IdiomaPdf } from '../../data/descargas';
import { contacto } from '../../data/navegacion';
import { idioma, ruta, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const s = t.servicio;
const f = t.formulario;
const destino = import.meta.env.PUBLIC_SAT_URL ?? '';

// Todo lo que fabrica la casa, para elegir el modelo; con su foto
const lista = [
  ...modelos.map((m) => ({ nombre: m.nombre, foto: m.imagen.src })),
  ...equipos.map((e) => ({ nombre: t.laboratorio.items[e.slug].nombre, foto: e.imagen.src })),
];
const fotos = Object.fromEntries(lista.map((x) => [x.nombre.toLowerCase(), x.foto]));

// Certificado de descontaminación y manual de limpieza, en el idioma de la página si existe
const orden: IdiomaPdf[] = lang === 'es' ? ['es', 'en'] : ['en', 'es'];
const docsVuelta = ['descontaminacion', 'limpieza'].flatMap((id) => {
  const g = generales.find((x) => x.id === id);
  const l = g && orden.find((o) => g.pdf[o]);
  return g && l ? [{ nombre: t.descargas.docs[id]?.nombre ?? id, url: g.pdf[l]!.url, l }] : [];
});

// Cada paso con lo que resume en la columna de la izquierda cuando ya está rellenado
const pasos = [{ campos: 'distribuidor ciudad' }, { campos: 'modelo serie' }, { campos: 'tipo' }].map((p, k) => ({
  ...p,
  n: String(k + 1).padStart(2, '0'),
  titulo: s.pasos[k],
  intro: s.intro[k],
}));

// Iconos de línea de cada campo, con el trazo de la web (sin emojis: se ven distintos en cada sistema)
const ico: Record<string, string> = {
  distribuidor: 'M4 20.5v-15l8-2.5v17.5M12 9h8v11.5M3 20.5h18M7.5 8h1.5M7.5 12h1.5M7.5 16h1.5M15 13h2M15 16.5h2',
  contacto: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4.5 20.5a7.5 7.5 0 0 1 15 0',
  email: 'M3.5 5.5h17v13h-17zM4 6l8 6.5L20 6',
  telefono:
    'M6.6 3.5h2.6l1.4 4-2 1.4a12 12 0 0 0 6.5 6.5l1.4-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z',
  ciudad: 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11ZM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  pais: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z',
  modelo:
    'M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17ZM12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM12 5.5V8M12 16v2.5M5.5 12H8M16 12h2.5',
  serie: 'M4 6v12M7 6v12M10.5 6v12M13 6v12M16.5 6v12M20 6v12',
  accesorios: 'M9 3h6M10 3v13.5a2 2 0 0 0 4 0V3M10 10h4',
  factura: 'M6 3h9l3 3v15H6zM9 9h6M9 13h6M9 17h4',
  pedido: 'M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5zM3.5 7.5 12 12l8.5-4.5M12 12v9',
  instalacion: 'M4 6h16v14H4zM4 10h16M8 3.5v4M16 3.5v4',
};

// El fondo de la portada: un plano de taller dibujado, sin foto. El despiece de un rotor visto desde arriba (seis
// alojamientos, eje, cotas y ejes de centro) y, alrededor, una escala de calibración que gira despacio.
const marcas = Array.from({ length: 120 }, (_, i) => {
  const a = (i * 3 * Math.PI) / 180;
  const largo = i % 10 === 0 ? 26 : i % 5 === 0 ? 16 : 9;
  const r1 = 262;
  const r2 = r1 - largo;
  const p = (r: number) => [(400 + r * Math.cos(a)).toFixed(1), (400 + r * Math.sin(a)).toFixed(1)];
  return { a: p(r1), b: p(r2), fuerte: i % 10 === 0 };
});
const alojamientos = Array.from({ length: 6 }, (_, i) => {
  const a = ((i * 60 - 90) * Math.PI) / 180;
  return { x: (400 + 150 * Math.cos(a)).toFixed(1), y: (400 + 150 * Math.sin(a)).toFixed(1) };
});
---

<Base title={s.title} description={s.description}>
  <div class="sat">
    <!-- ——— Portada ——— -->
    <section class="portada">
      <svg class="plano" viewBox="0 0 800 800" aria-hidden="true">
        <!-- ejes de centro y cotas -->
        <g class="eje">
          <path d="M400 40v720M40 400h720" />
          <path d="M138 138l524 524M662 138 138 662" />
        </g>
        <g class="cota">
          <path class="traza" pathLength="1" d="M138 770h524M138 758v24M662 758v24" />
          <path d="M150 770l-12-5v10zM650 770l12-5v10z" class="punta" />
          <path class="traza" pathLength="1" d="M770 138v524M758 138h24M758 662h24" />
        </g>
        <!-- la escala que gira -->
        <g class="escala">
          <circle cx="400" cy="400" r="262" />
          {marcas.map((m) => (
            <line x1={m.a[0]} y1={m.a[1]} x2={m.b[0]} y2={m.b[1]} class:list={{ fuerte: m.fuerte }} />
          ))}
          <path class="aguja" d="M400 128v-36" />
        </g>
        <!-- el rotor -->
        <g class="rotor">
          <circle class="traza" pathLength="1" cx="400" cy="400" r="210" />
          <circle class="fino traza" pathLength="1" cx="400" cy="400" r="196" />
          {alojamientos.map((p, i) => (
            <g style={`--i:${i}`}>
              <circle class="traza" pathLength="1" cx={p.x} cy={p.y} r="40" />
              <circle class="ping" cx={p.x} cy={p.y} r="30" />
            </g>
          ))}
          <circle class="traza" pathLength="1" cx="400" cy="400" r="58" />
          <circle cx="400" cy="400" r="34" class="fino" />
          <path class="tuerca" d="M400 378l19 11v22l-19 11-19-11v-22z" />
        </g>
        <!-- el diagnóstico: un barrido que da la vuelta y enciende cada alojamiento al pasar -->
        <g class="barrido">
          <path class="estela" d="M400 400 400 138A262 262 0 0 0 334.2 146.4Z" />
          <path class="haz" d="M400 400V138" />
        </g>
        <circle class="onda" cx="400" cy="400" r="5" />
        <circle class="centro" cx="400" cy="400" r="5" />
      </svg>
      <div class="wrap">
        <div class="portada-txt">
          <span class="eyebrow">{t.nav.servicio}</span>
          <h1>
            {s.titulo[0]}
            <b>{s.titulo[1]}</b>
          </h1>
          <p class="lead">{s.lead}</p>
        </div>
      </div>
    </section>

    <!-- ——— El parte ——— -->
    <section class="wrap sat-cuerpo">
      <header class="sec-cab">
        <div>
          <span class="eyebrow">{s.parte}</span>
          <h2>
            {s.seccionTitulo[0]}
            <b>{s.seccionTitulo[1]}</b>
          </h2>
        </div>
        <p>{s.seccionTexto}</p>
      </header>

      <div class="tarjeta" data-tarjeta>
        <!-- Columna oscura: los pasos, con lo rellenado; debajo, el contacto directo -->
        <aside class="rail">
          <div class="rail-in">
            <ol class="pasos" data-pasos style="--p: 0">
              {pasos.map((p, k) => (
                <li>
                  <button type="button" data-ir={k} aria-current={k === 0 ? 'step' : undefined}>
                    <i>{p.n}</i>
                    <span>
                      <b>{p.titulo}</b>
                      <small data-espejo={p.campos} data-sep=" · ">
                        {p.intro}
                      </small>
                    </span>
                  </button>
                </li>
              ))}
            </ol>
            <div class="directo">
              <p class="plazo">
                {s.plazo[0]}
                <b>{s.plazo[1]}</b>
              </p>
              <p class="plazo-txt">{s.plazoTexto}</p>
              <p class="directo-t">{s.directo}</p>
              <a href={`mailto:${contacto.tecnico}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="5.5" width="18" height="13" rx="2"></rect>
                  <path d="m4 7 8 6 8-6"></path>
                </svg>
                {contacto.tecnico}
              </a>
              <a href={contacto.telefonoHref}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6.6 3.5h2.6l1.4 4-2 1.4a12 12 0 0 0 6.5 6.5l1.4-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"></path>
                </svg>
                {contacto.telefono}
              </a>
            </div>
          </div>
        </aside>

        <div class="cuerpo-f">
          <form
            class="parte-f"
            action={`mailto:${contacto.tecnico}`}
            method="post"
            enctype="text/plain"
            novalidate
            data-destino={destino}
            data-correo={contacto.tecnico}
            data-lang={lang}
          >
            <!-- Paso 1 · Datos del distribuidor -->
            <fieldset class="paso-f activo" data-paso="0">
              <legend class="paso-cab">
                <small>{s.paso(1, 3)}</small>
                <b tabindex="-1">{pasos[0].titulo}</b>
                <span>{pasos[0].intro}</span>
              </legend>
              <div class="rejilla">
                <label class="campo">
                  <span>{s.distribuidor}</span>
                  <span class="in">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ico.distribuidor} />
                    </svg>
                    <input name="distribuidor" autocomplete="organization" required maxlength="120" />
                  </span>
                  <em class="err" aria-live="polite"></em>
                </label>
                <label class="campo">
                  <span>{s.contacto}</span>
                  <span class="in">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ico.contacto} />
                    </svg>
                    <input name="contacto" autocomplete="name" required maxlength="120" />
                  </span>
                  <em class="err" aria-live="polite"></em>
                </label>
                <label class="campo">
                  <span>{f.email}</span>
                  <span class="in">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ico.email} />
                    </svg>
                    <input name="email" type="email" autocomplete="email" required maxlength="160" />
                  </span>
                  <em class="err" aria-live="polite"></em>
                </label>
                <label class="campo">
                  <span>{f.telefono}</span>
                  <span class="in">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ico.telefono} />
                    </svg>
                    <input name="telefono" type="tel" autocomplete="tel" required maxlength="40" />
                  </span>
                  <em class="err" aria-live="polite"></em>
                </label>
                <label class="campo">
                  <span>{s.ciudad}</span>
                  <span class="in">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ico.ciudad} />
                    </svg>
                    <input name="ciudad" autocomplete="address-level2" required maxlength="80" />
                  </span>
                  <em class="err" aria-live="polite"></em>
                </label>
                <label class="campo">
                  <span>{f.pais}</span>
                  <span class="in">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ico.pais} />
                    </svg>
                    <input name="pais" autocomplete="country-name" required maxlength="80" />
                  </span>
                  <em class="err" aria-live="polite"></em>
                </label>
              </div>
            </fieldset>

            <!-- Paso 2 · El equipo -->
            <fieldset class="paso-f" data-paso="1">
              <legend class="paso-cab">
                <small>{s.paso(2, 3)}</small>
                <b tabindex="-1">{pasos[1].titulo}</b>
                <span>{pasos[1].intro}</span>
              </legend>
              <div class="rejilla">
                <div class="ancho modelo-fila">
                  <label class="campo">
                    <span>{s.modelo}</span>
                    <span class="in">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d={ico.modelo} />
                      </svg>
                      <input
                        name="modelo"
                        list="sat-modelos"
                        required
                        maxlength="80"
                        autocomplete="off"
                        placeholder={s.modeloAyuda}
                      />
                    </span>
                    <em class="err" aria-live="polite"></em>
                  </label>
                  <!-- La foto del modelo elegido -->
                  <figure class="modelo-foto" data-foto-caja aria-hidden="true">
                    <img alt="" width="640" height="640" data-foto hidden />
                    <svg viewBox="0 0 48 48" data-foto-vacia>
                      <circle cx="24" cy="24" r="17"></circle>
                      <circle cx="24" cy="24" r="4"></circle>
                      <path d="M24 7v6M24 35v6M7 24h6M35 24h6"></path>
                    </svg>
                  </figure>
                </div>
                <label class="campo">
                  <span>{s.serie}</span>
                  <span class="in">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ico.serie} />
                    </svg>
                    <input name="serie" required maxlength="60" autocomplete="off" spellcheck="false" class="mono" />
                  </span>
                  <em class="err" aria-live="polite"></em>
                </label>
                <label class="campo">
                  <span>
                    {s.accesorios} <small>· {f.opcional}</small>
                  </span>
                  <span class="in">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={ico.accesorios} />
                    </svg>
                    <input name="accesorios" maxlength="200" placeholder={s.accesoriosAyuda} />
                  </span>
                </label>
                <div class="ancho tres">
                  <label class="campo">
                    <span>
                      {s.factura} <small>· {f.opcional}</small>
                    </span>
                    <span class="in">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d={ico.factura} />
                      </svg>
                      <input name="factura" maxlength="60" autocomplete="off" />
                    </span>
                  </label>
                  <label class="campo">
                    <span>
                      {s.instalacion} <small>· {f.opcional}</small>
                    </span>
                    <span class="in">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d={ico.instalacion} />
                      </svg>
                      <input name="instalacion" type="date" />
                    </span>
                    <em class="err" aria-live="polite"></em>
                  </label>
                  <label class="campo">
                    <span>
                      {s.pedido} <small>· {f.opcional}</small>
                    </span>
                    <span class="in">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d={ico.pedido} />
                      </svg>
                      <input name="pedido" maxlength="60" autocomplete="off" />
                    </span>
                  </label>
                </div>
              </div>
            </fieldset>

            <!-- Paso 3 · La incidencia -->
            <fieldset class="paso-f" data-paso="2">
              <legend class="paso-cab">
                <small>{s.paso(3, 3)}</small>
                <b tabindex="-1">{pasos[2].titulo}</b>
                <span>{pasos[2].intro}</span>
              </legend>
              <div class="rejilla">
                <div class="campo ancho" role="radiogroup" aria-labelledby="sat-tipo">
                  <span id="sat-tipo">{s.tipo}</span>
                  <div class="tipos">
                    {s.tipos.map((x) => (
                      <label class="tipo">
                        <input type="radio" name="tipo" value={x} required />
                        <b>{x}</b>
                      </label>
                    ))}
                  </div>
                  <em class="err" aria-live="polite"></em>
                </div>
                <label class="campo ancho">
                  <span>{s.descripcion}</span>
                  <textarea
                    name="descripcion"
                    rows="6"
                    required
                    maxlength="4000"
                    placeholder={s.descripcionAyuda}
                  ></textarea>
                  <small class="cuenta" aria-hidden="true">
                    <b>0</b> / 4000
                  </small>
                  <em class="err" aria-live="polite"></em>
                </label>
                <div class="campo ancho" role="radiogroup" aria-labelledby="sat-vuelve">
                  <span id="sat-vuelve">{s.vuelve}</span>
                  <div class="sino">
                    <label>
                      <input type="radio" name="vuelve" value={s.si} data-si required />
                      <b>{s.si}</b>
                    </label>
                    <label>
                      <input type="radio" name="vuelve" value={s.no} required />
                      <b>{s.no}</b>
                    </label>
                  </div>
                  <em class="err" aria-live="polite"></em>
                </div>
                <div class="descon ancho" data-descon hidden>
                  <b class="descon-t">{s.descontaminacion}</b>
                  <p>{s.descontaminacionTexto}</p>
                  <div class="descon-docs">
                    {docsVuelta.map((x) => (
                      <a href={x.url} target="_blank" rel="noopener" download>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" />
                        </svg>
                        {x.nombre}
                        <small>PDF · {x.l.toUpperCase()}</small>
                      </a>
                    ))}
                  </div>
                  <label class="marca">
                    <input type="checkbox" name="descontaminado" value="1" data-confirmo disabled />
                    <span>{s.confirmo}</span>
                  </label>
                  <em class="err" aria-live="polite"></em>
                </div>
                <!-- Trampa para robots: invisible para personas; si llega rellena, no se envía -->
                <label class="trampa" aria-hidden="true">
                  Web <input name="web" tabindex="-1" autocomplete="off" />
                </label>
                <label class="marca ancho">
                  <input name="privacidad" type="checkbox" required />
                  <span>
                    {f.acepto}{' '}
                    <a href={ruta(lang, '/privacidad/')} target="_blank">
                      {f.privacidad}
                    </a>
                  </span>
                </label>
              </div>
            </fieldset>

            <div class="nav-f">
              <p class="borrador" data-borrador>
                {s.borrador}
                <button type="button" data-vaciar>
                  {s.vaciar}
                </button>
              </p>
              <div class="nav-btn">
                <button type="button" class="atras" data-atras hidden>
                  <span aria-hidden="true">«</span>
                  {s.atras}
                </button>
                <button type="button" class="btn red rel" data-sig>
                  {s.siguiente} <span aria-hidden="true">»</span>
                </button>
                <button type="submit" class="btn red rel" data-enviar data-enviando={s.enviando}>
                  <svg class="sobre" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={ico.email} />
                  </svg>
                  {s.enviar} <span aria-hidden="true">»</span>
                </button>
              </div>
              <p class="estado" role="status" aria-live="polite" data-error={s.error}></p>
            </div>
          </form>

          <!-- Enviado: el aviso y el parte, con su sello -->
          <div class="hecho" data-hecho hidden tabindex="-1">
            <svg class="hecho-ok" viewBox="0 0 64 64" aria-hidden="true">
              <circle cx="32" cy="32" r="29"></circle>
              <path d="m19 33 9 9 18-19"></path>
            </svg>
            <h2>
              {s.okTitulo[0]}
              <b>{s.okTitulo[1]}</b>
            </h2>
            <p>
              {s.okTexto} <b data-espejo="email"></b>.
            </p>
            <dl class="resumen">
              <div>
                <dt>{s.pasos[0]}</dt>
                <dd data-espejo="distribuidor contacto ciudad" data-sep=" · "></dd>
              </div>
              <div>
                <dt>{s.pasos[1]}</dt>
                <dd data-espejo="modelo serie" data-sep=" · "></dd>
              </div>
              <div>
                <dt>{s.pasos[2]}</dt>
                <dd data-espejo="tipo"></dd>
              </div>
              <span class="sello" aria-hidden="true">
                {s.enviado}
              </span>
            </dl>
            <button type="button" class="btn red rel" data-otro>
              {s.otro} <span aria-hidden="true">»</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <datalist id="sat-modelos">
      {lista.map((x) => (
        <option value={x.nombre} />
      ))}
    </datalist>
    <script type="application/json" id="sat-fotos" set:html={JSON.stringify(fotos)} />
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.parte-f');
  if (form) {
    const pasos = [...form.querySelectorAll<HTMLFieldSetElement>('.paso-f')];
    const indice = document.querySelector<HTMLElement>('[data-pasos]')!;
    const botonesPaso = [...indice.querySelectorAll<HTMLButtonElement>('[data-ir]')];
    const atras = form.querySelector<HTMLButtonElement>('[data-atras]')!;
    const sig = form.querySelector<HTMLButtonElement>('[data-sig]')!;
    const enviar = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
    const estado = form.querySelector<HTMLElement>('.estado')!;
    const descon = form.querySelector<HTMLElement>('[data-descon]')!;
    const confirmo = form.querySelector<HTMLInputElement>('[data-confirmo]')!;
    const tarjeta = document.querySelector<HTMLElement>('[data-tarjeta]')!;
    const hecho = document.querySelector<HTMLElement>('[data-hecho]')!;
    const cuenta = form.querySelector<HTMLElement>('.cuenta b')!;
    const fotos = JSON.parse(document.getElementById('sat-fotos')!.textContent || '{}') as Record<string, string>;
    const foto = form.querySelector<HTMLImageElement>('[data-foto]')!;
    const fotoCaja = form.querySelector<HTMLElement>('[data-foto-caja]')!;
    const lang = form.dataset.lang!;
    const CLAVE = 'oa-parte-servicio';
    const privados = new Set(['privacidad', 'descontaminado', 'web']);

    form.classList.add('js');
    let actual = 0;
    let alcanzado = 0;

    // ——— Validación: el mensaje del navegador, debajo de cada campo ———
    const caja = (el: Element) => el.closest<HTMLElement>('.campo, .descon, .marca');
    const marcar = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const c = caja(el);
      const err = c?.querySelector<HTMLElement>('.err');
      const ok = el.checkValidity();
      c?.classList.toggle('mal', !ok);
      el.setAttribute('aria-invalid', String(!ok));
      if (err) err.textContent = ok ? '' : el.validationMessage;
      return ok;
    };
    const validar = (k: number, foco = true) => {
      const vistos = new Set<string>();
      const campos = [...pasos[k].querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')].filter(
        (el) => el.willValidate && !(el.type === 'radio' && vistos.has(el.name)) && (vistos.add(el.name), true),
      );
      const malos = campos.filter((el) => !marcar(el));
      if (foco) malos[0]?.focus();
      return !malos.length;
    };
    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (caja(el)?.classList.contains('mal')) marcar(el);
    });
    form.addEventListener('focusout', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.matches('input:not([type=radio]):not([type=checkbox]), textarea') && el.value) marcar(el);
    });

    // ——— Pasos ———
    // La línea entre pasos: se llena hacia abajo al avanzar y se vacía hacia arriba al volver, tramo a tramo
    const tramos = [...indice.querySelectorAll<HTMLLIElement>('li')];
    const linea = (de: number, a: number) => {
      tramos.forEach((li, i) => {
        const orden = a > de ? i - de : de - 1 - i;
        li.style.setProperty('--retraso', `${Math.max(orden, 0) * 0.55}s`);
        li.classList.toggle('lleno', i < a);
      });
    };
    const ir = (k: number, foco = true) => {
      linea(actual, k);
      actual = k;
      alcanzado = Math.max(alcanzado, k);
      pasos.forEach((p, i) => p.classList.toggle('activo', i === k));
      botonesPaso.forEach((b, i) => {
        if (i === k) b.setAttribute('aria-current', 'step');
        else b.removeAttribute('aria-current');
        // Con tick solo los pasos por encima del actual: al volver atrás, los de abajo se apagan
        b.classList.toggle('hecho', i < k);
        b.disabled = i > alcanzado;
      });
      indice.style.setProperty('--p', String(k / (pasos.length - 1)));
      atras.hidden = k === 0;
      sig.hidden = k === pasos.length - 1;
      enviar.hidden = k !== pasos.length - 1;
      if (foco) {
        pasos[k].querySelector<HTMLElement>('.paso-cab b')!.focus({ preventScroll: true });
        const arriba = tarjeta.getBoundingClientRect().top;
        if (arriba < 80) window.scrollBy({ top: arriba - 110, behavior: 'smooth' });
      }
    };
    sig.addEventListener('click', () => validar(actual) && ir(actual + 1));
    atras.addEventListener('click', () => ir(actual - 1));
    botonesPaso.forEach((b, i) =>
      b.addEventListener('click', () => {
        if (i <= actual) return ir(i);
        for (let k = actual; k < i; k++) if (!validar(k)) return ir(k, false);
        ir(i);
      }),
    );

    // ——— Si el equipo vuelve a fábrica: el certificado ———
    const vuelta = () => {
      const si = !!form.querySelector<HTMLInputElement>('[data-si]:checked');
      descon.hidden = !si;
      confirmo.disabled = !si;
      confirmo.required = si;
    };

    // ——— Lo rellenado, copiado en los pasos de la izquierda y en el resumen final ———
    const valor = (n: string) => {
      const el = form.elements.namedItem(n);
      if (el instanceof RadioNodeList) return el.value;
      return (el as HTMLInputElement | null)?.value.trim() ?? '';
    };
    const espejos = [...document.querySelectorAll<HTMLElement>('.sat [data-espejo]')].map((el) => ({
      el,
      campos: el.dataset.espejo!.split(' '),
      sep: el.dataset.sep ?? ', ',
      vacio: el.textContent?.trim() ?? '',
    }));
    const pintar = () => {
      for (const { el, campos, sep, vacio } of espejos) {
        const v = campos.map(valor).filter(Boolean).join(sep);
        el.textContent = v || vacio;
        el.classList.toggle('lleno', !!v);
      }
      const src = fotos[valor('modelo').toLowerCase()];
      if (src && foto.getAttribute('src') !== src) foto.src = src;
      foto.hidden = !src;
      fotoCaja.classList.toggle('con', !!src);
      cuenta.textContent = String(valor('descripcion').length);
      vuelta();
    };

    // ——— Borrador en el navegador ———
    const guardar = () => {
      const datos: Record<string, string> = {};
      new FormData(form).forEach((v, k) => {
        if (!privados.has(k) && typeof v === 'string' && v) datos[k] = v;
      });
      try {
        localStorage.setItem(CLAVE, JSON.stringify(datos));
      } catch {
        /* sin almacenamiento: no pasa nada */
      }
    };
    const borrar = () => {
      try {
        localStorage.removeItem(CLAVE);
      } catch {
        /* nada */
      }
    };
    try {
      const datos = JSON.parse(localStorage.getItem(CLAVE) || '{}') as Record<string, string>;
      for (const [k, v] of Object.entries(datos)) {
        const el = form.elements.namedItem(k);
        if (el instanceof RadioNodeList) el.value = v;
        else if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) el.value = v;
      }
    } catch {
      /* nada */
    }
    form.addEventListener('input', () => {
      pintar();
      guardar();
    });
    form.addEventListener('change', pintar);
    const reiniciar = () => {
      form.reset();
      form.querySelectorAll('.mal').forEach((c) => c.classList.remove('mal'));
      form.querySelectorAll('.err').forEach((e) => (e.textContent = ''));
      borrar();
      alcanzado = 0;
      pintar();
      ir(0);
    };
    form.querySelector('[data-vaciar]')!.addEventListener('click', reiniciar);

    // ——— Envío ———
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Intro en un campo de los primeros pasos: pasa al siguiente
      if (actual < pasos.length - 1) {
        if (validar(actual)) ir(actual + 1);
        return;
      }
      for (let k = 0; k < pasos.length; k++) if (!validar(k)) return ir(k, false);
      const datos = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (datos.web) return; // robot
      delete datos.web;
      const envio = {
        formulario: 'servicio-tecnico',
        ...datos,
        descontaminado: datos.descontaminado === '1',
        privacidad: true,
        idioma: lang,
        pagina: location.href,
        fecha: new Date().toISOString(),
      };
      const destino = form.dataset.destino;
      const correo = form.dataset.correo!;

      // Sin flujo conectado todavía: correo al servicio técnico con el parte ya escrito
      if (!destino) {
        const cuerpo = Object.entries(envio)
          .map(([k, v]) => `${k}: ${v}`)
          .join('\n');
        location.href = `mailto:${correo}?subject=${encodeURIComponent(`${datos.tipo} · ${datos.modelo} · ${datos.distribuidor}`)}&body=${encodeURIComponent(cuerpo)}`;
        return;
      }

      const texto = enviar.innerHTML;
      enviar.disabled = true;
      enviar.textContent = enviar.dataset.enviando!;
      estado.textContent = '';
      try {
        const r = await fetch(destino, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(envio),
        });
        if (!r.ok) throw new Error(String(r.status));
        borrar();
        botonesPaso.forEach((b) => {
          b.classList.add('hecho');
          b.removeAttribute('aria-current');
          b.disabled = true;
        });
        indice.style.setProperty('--p', '1');
        linea(actual, pasos.length);
        form.hidden = true;
        hecho.hidden = false;
        hecho.focus();
      } catch {
        estado.innerHTML = `${estado.dataset.error} <a href="mailto:${correo}">${correo}</a>`;
      } finally {
        enviar.disabled = false;
        enviar.innerHTML = texto;
      }
    });

    document.querySelector('[data-otro]')!.addEventListener('click', () => {
      form.hidden = false;
      hecho.hidden = true;
      reiniciar();
    });

    pintar();
    ir(0, false);
  }
</script>

