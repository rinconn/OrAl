---
// Portada, la misma en los tres idiomas: cada sección saca sus textos del idioma de la dirección.
import Base from '../../layouts/Base.astro';
import Hero from '../Hero.astro';
import Tecnologia from '../Tecnologia.astro';
import Distribuidores from '../Distribuidores.astro';
import Empresa from '../Empresa.astro';
import Aplicaciones from '../Aplicaciones.astro';
import { idioma, textos } from '../../i18n';

const t = textos(idioma(Astro.currentLocale)).portada;
---

<Base title={t.title} description={t.description}>
  <Hero />
  <Empresa />
  <Distribuidores />
  <Tecnologia />
  <Aplicaciones />
</Base>

<script>
  // La sección que se está leyendo: su título enciende la raya roja
  const secciones = document.querySelectorAll<HTMLElement>('[data-raya]');
  if ('IntersectionObserver' in window) {
    const vistas = new IntersectionObserver(
      (es) => {
        for (const e of es) e.target.classList.toggle('actual', e.isIntersecting);
      },
      { rootMargin: '-35% 0px -50% 0px' },
    );
    secciones.forEach((s) => vistas.observe(s));
  }
</script>
