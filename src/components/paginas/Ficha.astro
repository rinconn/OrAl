---
// Ficha de un producto (/centrifugas/<slug>/). Arriba, una galería sobre la mesa de laboratorio del catálogo (la
// máquina, su foto de detalle, sus rotores y, en la Digicen 22, el modelo 3D) y, al lado, el nombre, la versión y los
// datos técnicos: las tres cifras clave con una barra que las compara con la más alta de la gama. Debajo, todo seguido
// (descripción, ficha técnica, rotores, versiones, accesorios) con un índice fijo a la izquierda que marca dónde estás
// y lleva siempre el botón de pedir. Al final, más máquinas como en el catálogo.
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import Maquina from '../Maquina.astro';
import Tarjeta from '../Tarjeta.astro';
import Visor3D from '../Visor3D.astro';
import IconoTemp from '../ui/IconoTemp.astro';
import { contacto } from '../../data/navegacion';
import { familias, modelos, productos, type Modelo } from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import {
  cifra,
  fichaCentrifuga,
  fichaLab,
  medida,
  rotor,
  tipoRotor,
  tipoTubo,
  type TextosFicha,
} from '../../data/fichas';
import { idioma, numero, ruta, textoSerie, textos } from '../../i18n';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const tf = t.catalogo.ficha;
const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const m: Modelo | undefined = modelos.find((x) => x.slug === slug);
const esAccesorio = accesorios.some((x) => x.slug === slug);
const p: ProductoLab | undefined = [...accesorios, ...equipos].find((x) => x.slug === slug);

// Lo común a centrífugas y equipos
const web = m ? fichaCentrifuga(m.slug) : undefined;
const txt: TextosFicha | undefined = web?.textos[lang] ?? (p ? fichaLab(p.slug)?.[lang] : undefined);
const nombre = m ? m.nombre : t.laboratorio.items[p!.slug].nombre;
const cat = m ? t.catalogo.categorias[m.categoria] : esAccesorio ? t.laboratorio.accesorios : t.laboratorio.equipos;
const catClave = m ? m.categoria : esAccesorio ? 'accesorios' : 'laboratorio';
const frase = m ? textoSerie(lang, m.serie).frase : t.laboratorio.items[p!.slug].frase;
const imagen = (m ?? p)!.imagen;
const pdf = web?.pdf?.[lang] ?? p?.pdf;

// Capacidad como en el catálogo y fuerza del catálogo o, si no la da para esa versión, de la web actual
const capacidadDe = (x: Modelo) =>
  x.capacidad === productos.find((s) => s.slug === x.serie)?.capacidad
    ? (textoSerie(lang, x.serie).capacidad ?? x.capacidad)
    : x.capacidad;
const xgDe = (x: Modelo) => x.xg ?? fichaCentrifuga(x.slug)?.xg;
const fuerzaDe = (x: Modelo) => (x.xg ? numero(lang, x.xg) : cifra(lang, xgDe(x)));
const capacidad = m && capacidadDe(m);
const xg = m && fuerzaDe(m);

// Versiones de la misma serie (22 / 22 R, C / C-U / C-8)
const hermanos = m ? modelos.filter((x) => x.serie === m.serie) : [];
const etiquetaVersion = (x: Modelo) =>
  x.serie === 'digtor-22-c' ? x.nombre.replace('Digtor 22 ', '') : may(t.temperatura[x.temperatura]);
const rotores = (web?.rotores ?? []).map(rotor);
const versiones = web?.versiones ?? [];
const deAccesorios = [...accesorios].filter((a) => web?.accesorios.includes(a.slug));

// Barras de las cifras clave: frente a la más alta de toda la gama
const num = (s?: string) => (s ? Number(s.replace(/\D/g, '')) || 0 : 0);
const maxRpm = Math.max(...modelos.map((x) => num(x.rpm)));
const maxXg = Math.max(...modelos.map((x) => num(xgDe(x))));
const pct = (v: number, max: number) => Math.max(0.04, Math.min(1, v / max)).toFixed(3);

// Galería: la máquina entera, su foto de detalle (la de la gama, si es de esta versión), sus rotores y el 3D
type Vista = { tipo: 'maquina' | 'detalle' | 'rotor' | '3d'; src: string; nombre: string };
const tg = tf.galeria;
const conVisor = m?.slug === 'digicen-22';
const gamaPropia = !!m && existsSync(`${process.cwd()}/public/img/gama/${m.slug}.webp`);
const detalle = m && (gamaPropia || m.slug === m.serie) ? `/img/gama/${m.slug}.webp` : undefined;
const vistas = [
  conVisor && { tipo: '3d', src: imagen.src, nombre: tg.tresD },
  { tipo: 'maquina', src: imagen.src, nombre: tg.foto },
  detalle && { tipo: 'detalle', src: detalle, nombre: tg.detalle },
  p?.imagen2 && { tipo: 'detalle', src: p.imagen2.src, nombre: tg.detalle },
  ...rotores.filter((r) => r.imagen).map((r) => ({ tipo: 'rotor', src: r.imagen!, nombre: r.nombre })),
].filter(Boolean) as Vista[];

// Columnas de la tabla de versiones: solo las que tienen algún dato
const columnas = (['medidas', 'peso', 'voltaje', 'frecuencia', 'consumo', 'zMax', 'calefaccion'] as const).filter((k) =>
  versiones.some((v) => v[k]),
);
const unidades: Record<(typeof columnas)[number], string> = {
  medidas: ' mm',
  peso: ' kg',
  voltaje: ' V',
  frecuencia: ' Hz',
  consumo: ' W',
  zMax: '',
  calefaccion: '',
};
const valor = (k: (typeof columnas)[number], v?: string) =>
  v ? (k === 'medidas' ? v.replace(/x/g, ' × ') : v) + unidades[k] : '—';

const secciones = [
  txt?.descripcion.length && { id: 'descripcion', nombre: tf.secciones.descripcion },
  txt?.bloques.length && { id: 'caracteristicas', nombre: tf.secciones.caracteristicas },
  rotores.length && { id: 'rotores', nombre: tf.secciones.rotores, n: rotores.length },
  versiones.length && { id: 'versiones', nombre: tf.secciones.versiones },
  deAccesorios.length && { id: 'accesorios', nombre: tf.secciones.accesorios },
].filter(Boolean) as { id: string; nombre: string; n?: number }[];
const numSeccion = (id: string) => String(secciones.findIndex((x) => x.id === id) + 1).padStart(2, '0');

// "De un vistazo": lo que el distribuidor busca primero, sacado de la tabla de versiones
const v0 = versiones[0];
const voltajes = [...new Set(versiones.map((v) => v.voltaje).filter(Boolean))].join(' / ');
const frecuencias = [...new Set(versiones.map((v) => v.frecuencia).filter(Boolean))].join(' / ');
const codigos = versiones.map((v) => v.codigo).join(' · ');
const vistazo = [
  v0?.medidas && { k: tf.versiones.medidas, v: valor('medidas', v0.medidas) },
  v0?.peso && { k: tf.versiones.peso, v: valor('peso', v0.peso) },
  v0?.consumo && { k: tf.versiones.consumo, v: valor('consumo', v0.consumo) },
  rotores.length && { k: tf.secciones.rotores, v: String(rotores.length) },
].filter(Boolean) as { k: string; v: string }[];

// Rotores: tipos de tubo que admite alguno de ellos, para buscar por tubo
const tiposTubo = [...new Set(rotores.flatMap((r) => r.tubos.map((x) => x.tipo).filter(Boolean)))] as string[];

// Al final, más de la misma aplicación; si son menos de tres, se completa con la misma temperatura y luego el resto
const mismos = m
  ? modelos.filter((x) => x.categoria === m.categoria && x.slug !== m.slug)
  : (esAccesorio ? accesorios : equipos).filter((x) => x.slug !== p!.slug);
const otros = m
  ? modelos
      .filter((x) => x.categoria !== m.categoria)
      .sort((a, b) => Number(b.temperatura === m.temperatura) - Number(a.temperatura === m.temperatura))
  : [];
const completa = mismos.length < 3 && otros.length > 0;
const tres = [...mismos, ...(completa ? otros : [])].slice(0, 3);
const colorDe = (x: Modelo) => familias[productos.find((s) => s.slug === x.serie)!.familia].color as string;

const titulo = `${nombre} · ${cat} · Orto Alresa`;
const descripcion = m
  ? `${nombre}: ${frase} ${capacidad}, ${numero(lang, m.rpm)} rpm, ${tf.pantalla.toLowerCase()} ${m.pantalla}.`
  : `${nombre} (${p!.modelo}): ${frase}`;
---

<Base title={titulo} description={descripcion}>
  <section class="cabecera" data-t={m?.temperatura ?? 'lab'}>
    <div class="wrap cabecera-in">
      <nav class="migas" aria-label="Breadcrumb">
        <a href={ruta(lang, '/')}>{tf.inicio}</a>
        <span aria-hidden="true">/</span>
        <a href={ruta(lang, '/centrifugas/')}>{tf.productos}</a>
        <span aria-hidden="true">/</span>
        <a href={ruta(lang, `/centrifugas/?c=${catClave}`)}>{cat}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{nombre}</span>
      </nav>

      <!-- Galería: una vista grande y sus miniaturas debajo. Sin JS se ve la primera -->
      <div class="galeria">
        <div class="escena">
          {vistas.map((v, i) => (
            <div class="vista" data-tipo={v.tipo} id={`vista-${i}`} hidden={i > 0} role="tabpanel">
              {v.tipo === '3d' ? (
                <Visor3D />
              ) : v.tipo === 'maquina' ? (
                <>
                  <img
                    src={v.src}
                    alt={nombre}
                    width={imagen.ancho}
                    height={imagen.alto}
                    fetchpriority={i === 0 ? 'high' : undefined}
                    loading={i === 0 ? undefined : 'lazy'}
                  />
                  {m && (
                    <span class:list={['temp', m.temperatura]}>
                      <IconoTemp t={m.temperatura} size={16} />
                      {t.temperatura[m.temperatura]}
                    </span>
                  )}
                </>
              ) : (
                <>
                  <img src={v.src} alt={`${nombre} · ${v.nombre}`} width="720" height="720" loading="lazy" />
                  <span class="pie-vista">{v.nombre}</span>
                </>
              )}
            </div>
          ))}
        </div>
        {vistas.length > 1 && (
          <div class="miniaturas" role="tablist" aria-label={nombre}>
            {vistas.map((v, i) => (
              <button
                type="button"
                role="tab"
                class="mini"
                data-tipo={v.tipo}
                data-vista={`vista-${i}`}
                aria-controls={`vista-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="mini-foto">
                  {v.tipo === '3d' ? <b>3D</b> : <img src={v.src} alt="" width="120" height="100" decoding="async" />}
                </span>
                <span class="mini-nombre">{v.nombre}</span>
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="datos">
        <p class="cat">{cat}</p>
        <h1>
          {nombre}
          {p && <span>{p.modelo}</span>}
        </h1>
        <p class="frase">{frase}</p>

        {hermanos.length > 1 && (
          <div class="version">
            <p>{tf.version}</p>
            <ul>
              {hermanos.map((x) => (
                <li>
                  <a
                    href={ruta(lang, `/centrifugas/${x.slug}/`)}
                    aria-current={x.slug === m!.slug ? 'page' : undefined}
                    data-t={x.temperatura}
                  >
                    {etiquetaVersion(x)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {m ? (
          <div class="placa">
            <p class="placa-cabeza">
              <span>{tf.placa}</span>
              <b>{nombre}</b>
            </p>
            <!-- Las tres cifras clave, grandes; velocidad y fuerza con su barra frente a la más alta de la gama -->
            <dl class="clave">
              <div>
                <dt>{tf.capacidad}</dt>
                <dd>{capacidad}</dd>
              </div>
              <div>
                <dt>{tf.velocidad}</dt>
                <dd>
                  {numero(lang, m.rpm)} <small>rpm</small>
                </dd>
                <span class="barra" style={`--p: ${pct(num(m.rpm), maxRpm)}`} aria-hidden="true"></span>
              </div>
              {xg && (
                <div>
                  <dt>{tf.fuerza}</dt>
                  <dd>
                    {xg} <small>xg</small>
                  </dd>
                  <span class="barra" style={`--p: ${pct(num(xgDe(m)), maxXg)}`} aria-hidden="true"></span>
                </div>
              )}
            </dl>
            <p class="nota-gama">{tf.frenteGama}</p>
            <dl class="resto">
              <div>
                <dt>{tf.pantalla}</dt>
                <dd>{m.pantalla}</dd>
              </div>
              <div>
                <dt>{t.catalogo.iconos.temperatura}</dt>
                <dd class="placa-temp">
                  <IconoTemp t={m.temperatura} />
                  {may(t.temperatura[m.temperatura])}
                </dd>
              </div>
              {voltajes && (
                <div>
                  <dt>{tf.versiones.voltaje}</dt>
                  <dd>
                    {voltajes} V{frecuencias && <small> · {frecuencias} Hz</small>}
                  </dd>
                </div>
              )}
              {codigos && (
                <div>
                  <dt>{tf.versiones.codigo}</dt>
                  <dd>{codigos}</dd>
                </div>
              )}
            </dl>
            <p class="placa-pie">
              <span>{contacto.empresa}</span>
              <b>CE</b>
            </p>
          </div>
        ) : (
          <p class="linea">{t.laboratorio.items[p!.slug].datos}</p>
        )}

        <div class="botones">
          {pdf && (
            <a class="btn red" href={pdf} target="_blank" rel="noopener">
              {tf.pdf}
            </a>
          )}
          <a class:list={['btn', pdf ? 'ghost' : 'red']} href={ruta(lang, '/#distribuidores')}>
            {tf.distribuidor}
          </a>
        </div>
      </div>
    </div>
  </section>

  {secciones.length > 0 && (
    <section class="detalle" id="detalle">
      <div class="wrap detalle-in">
        <!-- Índice fijo: la máquina en pequeño, las secciones con la que se lee marcada, y pedir siempre a mano -->
        <aside class="indice">
          <div class="indice-ficha" aria-hidden="true">
            <span class="indice-foto">
              <img src={imagen.src} alt="" width="160" height="128" loading="lazy" decoding="async" />
            </span>
            <span>
              <small>{cat}</small>
              <b>{nombre}</b>
            </span>
          </div>
          <p class="indice-t">{tf.indice}</p>
          <ol class="indice-lista">
            {secciones.map((x, i) => (
              <li>
                <a href={`#${x.id}`} aria-current={i === 0 ? 'true' : undefined}>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  {x.nombre}
                  {x.n && <span class="n">{x.n}</span>}
                </a>
              </li>
            ))}
          </ol>
          <div class="indice-botones">
            <a class="btn red" href={ruta(lang, '/#distribuidores')}>
              {tf.distribuidor}
            </a>
            {pdf && (
              <a class="arrow" href={pdf} target="_blank" rel="noopener">
                {tf.pdf}
              </a>
            )}
          </div>
        </aside>

        <div class="paneles">
          {txt?.descripcion.length ? (
            <section class="panel" id="descripcion" aria-labelledby="t-descripcion">
              <header class="panel-cab">
                <span class="num">{numSeccion('descripcion')}</span>
                <h2 id="t-descripcion">{tf.secciones.descripcion}</h2>
              </header>
              <div class="texto">
                {txt.descripcion.map((d) => (
                  <p>{d}</p>
                ))}
              </div>
              {vistazo.length > 0 && (
                <div class="vistazo">
                  <h3>{tf.vistazo}</h3>
                  <dl>
                    {vistazo.map((x) => (
                      <div>
                        <dt>{x.k}</dt>
                        <dd>{x.v}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
            </section>
          ) : null}

          {txt?.bloques.length ? (
            <section class="panel" id="caracteristicas" aria-labelledby="t-caracteristicas">
              <header class="panel-cab">
                <span class="num">{numSeccion('caracteristicas')}</span>
                <h2 id="t-caracteristicas">{tf.secciones.caracteristicas}</h2>
              </header>
              <div class="tarjetas-texto">
                {txt.bloques.map((b) => (
                  <article>
                    <h3>{b.titulo}</h3>
                    <ul>
                      {b.puntos.map((pt) =>
                        pt.punto || pt.sub ? (
                          <li>
                            {pt.t}
                            {pt.sub && (
                              <ul>
                                {pt.sub.map((s) => (
                                  <li>{s}</li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ) : (
                          <li class="sub-titulo">{pt.t}</li>
                        ),
                      )}
                    </ul>
                  </article>
                ))}
              </div>
            </section>
          ) : null}

          {rotores.length > 0 && (
            <section class="panel" id="rotores" aria-labelledby="t-rotores">
              <header class="panel-cab">
                <span class="num">{numSeccion('rotores')}</span>
                <h2 id="t-rotores">{tf.secciones.rotores}</h2>
                <p>{tf.rotores.intro(rotores.length)}</p>
              </header>
              {tiposTubo.length > 1 && (
                <div class="por-tubo" role="group" aria-label={tf.rotores.porTubo}>
                  <p>{tf.rotores.porTubo}</p>
                  <button type="button" data-tubo="" aria-pressed="true">
                    {tf.rotores.todos}
                  </button>
                  {tiposTubo.map((x) => (
                    <button type="button" data-tubo={x} aria-pressed="false">
                      {may(tipoTubo(lang, x)!)}
                    </button>
                  ))}
                </div>
              )}
              <div class="selector">
                <ul class="lista-rotores">
                  {rotores.map((r, i) => (
                    <li data-tubos={r.tubos.map((x) => x.tipo).join('|')}>
                      <button
                        type="button"
                        class="r-item"
                        data-rotor={`rotor-${i}`}
                        aria-pressed={i === 0 ? 'true' : 'false'}
                      >
                        <span class="r-mini">
                          {r.imagen && (
                            <img src={r.imagen} alt="" width="480" height="480" loading="lazy" decoding="async" />
                          )}
                        </span>
                        <span class="r-texto">
                          <span class="r-nombre">{r.nombre}</span>
                          <span class="r-tipo">{tipoRotor(lang, r.tipo)}</span>
                          <span class="r-cap">{medida(lang, r.capacidad)}</span>
                        </span>
                      </button>
                    </li>
                  ))}
                </ul>
                <div class="r-detalles" aria-live="polite">
                  {rotores.map((r, i) => (
                    <article class="r-detalle" id={`rotor-${i}`}>
                      <div class="r-top">
                        <span class="r-foto">
                          {r.imagen && <img src={r.imagen} alt={r.nombre} width="480" height="480" loading="lazy" />}
                        </span>
                        <div>
                          <p class="r-tipo">{tipoRotor(lang, r.tipo)}</p>
                          <h3>{r.nombre}</h3>
                          <dl class="r-cifras">
                            <div>
                              <dt>{tf.capacidad}</dt>
                              <dd>{medida(lang, r.capacidad)}</dd>
                            </div>
                            <div>
                              <dt>{tf.velocidad}</dt>
                              <dd>{cifra(lang, r.rpm)} rpm</dd>
                            </div>
                            <div>
                              <dt>{tf.fuerza}</dt>
                              <dd>{cifra(lang, r.xg)} xg</dd>
                            </div>
                            {r.radio && (
                              <div>
                                <dt>{tf.rotores.radio}</dt>
                                <dd>{r.radio} mm</dd>
                              </div>
                            )}
                            {r.angulo && (
                              <div>
                                <dt>{tf.rotores.angulo}</dt>
                                <dd>{r.angulo}°</dd>
                              </div>
                            )}
                            {r.tempMin && (
                              <div>
                                <dt>{tf.rotores.tempMin}</dt>
                                <dd>{r.tempMin} °C</dd>
                              </div>
                            )}
                          </dl>
                        </div>
                      </div>
                      {r.tubos.length > 0 && (
                        <>
                          <h4>{tf.rotores.tubos}</h4>
                          <div class="tabla-scroll">
                            <table>
                              <thead>
                                <tr>
                                  <th scope="col">{tf.rotores.posiciones}</th>
                                  <th scope="col">{tf.rotores.tubo}</th>
                                  <th scope="col">{tf.rotores.capacidadTubo}</th>
                                  <th scope="col">{tf.rotores.medidas}</th>
                                  <th scope="col">{tf.rotores.reductor}</th>
                                </tr>
                              </thead>
                              <tbody>
                                {r.tubos.map((tb) => (
                                  <tr data-tubo={tb.tipo}>
                                    <td class="num">{tb.posiciones}</td>
                                    <td>{tipoTubo(lang, tb.tipo)}</td>
                                    <td>{medida(lang, tb.capacidad) ?? '—'}</td>
                                    <td>{medida(lang, tb.medidas) ?? '—'}</td>
                                    <td>{tb.reductor ?? tf.rotores.directo}</td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </>
                      )}
                    </article>
                  ))}
                </div>
              </div>
            </section>
          )}

          {versiones.length > 0 && (
            <section class="panel" id="versiones" aria-labelledby="t-versiones">
              <header class="panel-cab">
                <span class="num">{numSeccion('versiones')}</span>
                <h2 id="t-versiones">{tf.secciones.versiones}</h2>
                <p>{tf.versiones.titulo}</p>
              </header>
              <div class="tabla-scroll">
                <table class="versiones">
                  <thead>
                    <tr>
                      <th scope="col">{tf.versiones.codigo}</th>
                      {columnas.map((k) => (
                        <th scope="col">{tf.versiones[k]}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {versiones.map((v) => (
                      <tr>
                        <th scope="row">{v.codigo}</th>
                        {columnas.map((k) => (
                          <td>{valor(k, v[k])}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}

          {deAccesorios.length > 0 && (
            <section class="panel" id="accesorios" aria-labelledby="t-accesorios">
              <header class="panel-cab">
                <span class="num">{numSeccion('accesorios')}</span>
                <h2 id="t-accesorios">{tf.secciones.accesorios}</h2>
                <p>{tf.accesorios}</p>
              </header>
              <ul class="rejilla dos">
                {deAccesorios.map((a) => (
                  <li>
                    <Tarjeta cat={t.laboratorio.accesorios} lab={a} />
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>
    </section>
  )}

  {tres.length > 0 && (
    <section class="mas">
      <div class="wrap">
        <div class="cabeza">
          <h2>
            {completa ? tf.otras[0] : tf.mas} <b>{completa ? tf.otras[1] : cat}</b>
          </h2>
          <a class="arrow" href={ruta(lang, `/centrifugas/?c=${catClave}`)}>
            {tf.volver}
          </a>
        </div>
        <ul class="rejilla">
          {tres.map((x) => (
            <li>
              {'rpm' in x ? (
                <Maquina
                  versiones={[{ m: x, capacidad: capacidadDe(x), fuerza: fuerzaDe(x) }]}
                  uso={t.catalogo.categorias[x.categoria]}
                  frase={textoSerie(lang, x.serie).frase}
                  color={colorDe(x)}
                />
              ) : (
                <Maquina lab={x} uso={cat} frase={t.laboratorio.items[x.slug].frase} color="#8c959b" />
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<script>
  // Galería: cada miniatura enseña su vista; con las flechas se pasa de una a otra
  const minis = [...document.querySelectorAll<HTMLButtonElement>('.miniaturas .mini')];
  const verVista = (b: HTMLButtonElement) => {
    for (const x of minis) {
      const si = x === b;
      x.setAttribute('aria-selected', String(si));
      x.tabIndex = si ? 0 : -1;
      document.getElementById(x.dataset.vista!)!.hidden = !si;
    }
  };
  for (const b of minis) {
    b.addEventListener('click', () => verVista(b));
    b.addEventListener('keydown', (e) => {
      const j = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!j) return;
      const c = minis[(minis.indexOf(b) + j + minis.length) % minis.length];
      verVista(c);
      c.focus();
    });
  }

  // Rotores: la lista a la izquierda y el elegido a la derecha. "¿Qué tubo usas?" deja solo los rotores que lo
  // admiten y resalta sus filas en la tabla. Sin JS se ven todos, uno debajo de otro.
  const selector = document.querySelector<HTMLElement>('.selector');
  if (selector) {
    selector.classList.add('activo');
    const items = [...selector.querySelectorAll<HTMLButtonElement>('.r-item')];
    const detalles = [...selector.querySelectorAll<HTMLElement>('.r-detalle')];
    const filtros = [...document.querySelectorAll<HTMLButtonElement>('.por-tubo button')];
    let tubo = '';
    const elegir = (id: string) => {
      for (const b of items) b.setAttribute('aria-pressed', String(b.dataset.rotor === id));
      for (const d of detalles) {
        d.hidden = d.id !== id;
        for (const tr of d.querySelectorAll<HTMLElement>('tr[data-tubo]')) {
          tr.classList.toggle('marcada', !!tubo && tr.dataset.tubo === tubo);
        }
      }
    };
    for (const b of items) b.addEventListener('click', () => elegir(b.dataset.rotor!));
    for (const f of filtros) {
      f.addEventListener('click', () => {
        tubo = f.dataset.tubo ?? '';
        for (const g of filtros) g.setAttribute('aria-pressed', String(g === f));
        let primero = '';
        for (const b of items) {
          const li = b.parentElement!;
          li.hidden = !!tubo && !(li.dataset.tubos ?? '').split('|').includes(tubo);
          if (!li.hidden && !primero) primero = b.dataset.rotor!;
        }
        const actual = items.find((b) => b.getAttribute('aria-pressed') === 'true');
        elegir(actual && !actual.parentElement!.hidden ? actual.dataset.rotor! : primero);
      });
    }
    elegir(items[0].dataset.rotor!);
  }

  // Índice: marca la sección que se está leyendo y llena la raya de progreso; en móvil, la lleva a la vista
  const indice = document.querySelector<HTMLElement>('.indice');
  const paneles = document.querySelector<HTMLElement>('.paneles');
  if (indice && paneles) {
    const lista = indice.querySelector<HTMLElement>('.indice-lista')!;
    const enlaces = [...lista.querySelectorAll<HTMLAnchorElement>('a')];
    const secciones = enlaces.map((a) => document.getElementById(a.hash.slice(1))!);
    let actual = '';
    const marcar = () => {
      const y = innerHeight * 0.3;
      let s = secciones[0];
      for (const x of secciones) if (x.getBoundingClientRect().top < y) s = x;
      const r = paneles.getBoundingClientRect();
      indice.style.setProperty('--p', String(Math.min(1, Math.max(0, (y - r.top) / r.height))));
      if (s.id === actual) return;
      actual = s.id;
      for (const a of enlaces) {
        const si = a.hash === `#${s.id}`;
        if (si) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
        if (si && lista.scrollWidth > lista.clientWidth) {
          lista.scrollTo({ left: a.offsetLeft - 16, behavior: 'smooth' });
        }
      }
    };
    addEventListener('scroll', marcar, { passive: true });
    addEventListener('resize', marcar);
    marcar();
    const suave = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const a of enlaces) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById(a.hash.slice(1))!.scrollIntoView({ behavior: suave ? 'smooth' : 'auto' });
        history.replaceState(null, '', a.hash);
      });
    }
  }
</script>

