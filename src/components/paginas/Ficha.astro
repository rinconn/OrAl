---
// Ficha de un producto (/centrifugas/<slug>/): todo lo que cuenta su página en la web actual, ordenado para leerse
// de un vistazo. Arriba la foto (la Digicen 22, en 3D) con el nombre, la versión, las cuatro cifras clave y los dos
// botones; debajo, una barra fija para saltar a descripción, características, rotores (cada uno abre sus tubos),
// versiones con medidas y consumo, accesorios y los demás modelos de la misma aplicación.
import Base from '../../layouts/Base.astro';
import Tarjeta from '../Tarjeta.astro';
import Visor3D from '../Visor3D.astro';
import { modelos, productos, type Modelo } from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import {
  cifra,
  fichaCentrifuga,
  fichaLab,
  medida,
  rotor,
  tipoRotor,
  tipoTubo,
  type TextosFicha,
} from '../../data/fichas';
import { idioma, numero, ruta, textoSerie, textos } from '../../i18n';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const tf = t.catalogo.ficha;
const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const m: Modelo | undefined = modelos.find((x) => x.slug === slug);
const esAccesorio = accesorios.some((x) => x.slug === slug);
const p: ProductoLab | undefined = [...accesorios, ...equipos].find((x) => x.slug === slug);

// Lo común a centrífugas y equipos
const web = m ? fichaCentrifuga(m.slug) : undefined;
const txt: TextosFicha | undefined = web?.textos[lang] ?? (p ? fichaLab(p.slug)?.[lang] : undefined);
const nombre = m ? m.nombre : t.laboratorio.items[p!.slug].nombre;
const cat = m ? t.catalogo.categorias[m.categoria] : esAccesorio ? t.laboratorio.accesorios : t.laboratorio.equipos;
const catClave = m ? m.categoria : esAccesorio ? 'accesorios' : 'laboratorio';
const frase = m ? textoSerie(lang, m.serie).frase : t.laboratorio.items[p!.slug].frase;
const imagen = (m ?? p)!.imagen;
const pdf = web?.pdf?.[lang] ?? p?.pdf;

// Centrífugas: capacidad como en el catálogo y versiones de la misma serie (22 / 22 R, C / C-U / C-8)
const capacidad = m
  ? m.capacidad === productos.find((s) => s.slug === m.serie)?.capacidad
    ? (textoSerie(lang, m.serie).capacidad ?? m.capacidad)
    : m.capacidad
  : undefined;
const hermanos = m ? modelos.filter((x) => x.serie === m.serie) : [];
const etiquetaVersion = (x: Modelo) =>
  x.serie === 'digtor-22-c' ? x.nombre.replace('Digtor 22 ', '') : may(t.temperatura[x.temperatura]);
// La fuerza, del catálogo; si el catálogo no la da para esa versión (Digtor 22 C-8), la de la web actual
const xg = m?.xg ? numero(lang, m.xg) : cifra(lang, web?.xg);
const rotores = (web?.rotores ?? []).map(rotor);
const versiones = web?.versiones ?? [];
const deAccesorios = [...accesorios].filter((a) => web?.accesorios.includes(a.slug));
const mismos = m
  ? modelos.filter((x) => x.categoria === m.categoria && x.slug !== m.slug)
  : (esAccesorio ? accesorios : equipos).filter((x) => x.slug !== p!.slug);
const tres = mismos.slice(0, 3);

// Columnas de la tabla de versiones: solo las que tienen algún dato
const columnas = (['medidas', 'peso', 'voltaje', 'frecuencia', 'consumo', 'zMax', 'calefaccion'] as const).filter((k) =>
  versiones.some((v) => v[k]),
);
const unidades: Record<(typeof columnas)[number], string> = {
  medidas: ' mm',
  peso: ' kg',
  voltaje: ' V',
  frecuencia: ' Hz',
  consumo: ' W',
  zMax: '',
  calefaccion: '',
};
const valor = (k: (typeof columnas)[number], v?: string) =>
  v ? (k === 'medidas' ? v.replace(/x/g, ' × ') : v) + unidades[k] : '—';

const secciones = [
  txt?.descripcion.length && { id: 'descripcion', nombre: tf.secciones.descripcion },
  txt?.bloques.length && { id: 'caracteristicas', nombre: tf.secciones.caracteristicas },
  rotores.length && { id: 'rotores', nombre: tf.secciones.rotores, n: rotores.length },
  versiones.length && { id: 'versiones', nombre: tf.secciones.versiones },
  deAccesorios.length && { id: 'accesorios', nombre: tf.secciones.accesorios },
].filter(Boolean) as { id: string; nombre: string; n?: number }[];

// "De un vistazo": lo que el distribuidor busca primero, sacado de la tabla de versiones
const v0 = versiones[0];
const voltajes = [...new Set(versiones.map((v) => v.voltaje).filter(Boolean))].join(' / ');
const vistazo = [
  versiones.length && { k: tf.versiones.codigo, v: versiones.map((v) => v.codigo).join(' · ') },
  v0?.medidas && { k: tf.versiones.medidas, v: valor('medidas', v0.medidas) },
  v0?.peso && { k: tf.versiones.peso, v: valor('peso', v0.peso) },
  v0?.consumo && { k: tf.versiones.consumo, v: valor('consumo', v0.consumo) },
  voltajes && { k: tf.versiones.voltaje, v: `${voltajes} V` },
  rotores.length && { k: tf.secciones.rotores, v: String(rotores.length) },
].filter(Boolean) as { k: string; v: string }[];

const conVisor = m?.slug === 'digicen-22';
const titulo = `${nombre} · ${cat} · Orto Alresa`;
const descripcion = m
  ? `${nombre}: ${frase} ${capacidad}, ${numero(lang, m.rpm)} rpm, ${tf.pantalla.toLowerCase()} ${m.pantalla}.`
  : `${nombre} (${p!.modelo}): ${frase}`;
---

<Base title={titulo} description={descripcion}>
  <section class="cabecera" data-t={m?.temperatura ?? 'lab'}>
    <div class="wrap cabecera-in">
      <nav class="migas" aria-label="Breadcrumb">
        <a href={ruta(lang, '/')}>{tf.inicio}</a>
        <span aria-hidden="true">/</span>
        <a href={ruta(lang, '/centrifugas/')}>{tf.productos}</a>
        <span aria-hidden="true">/</span>
        <a href={ruta(lang, `/centrifugas/?c=${catClave}`)}>{cat}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{nombre}</span>
      </nav>

      <div class:list={['escaparate', { oscuro: conVisor }]}>
        {conVisor ? (
          <Visor3D />
        ) : (
          <>
            <span class="fondo" aria-hidden="true">
              {nombre.split(' ')[0]}
            </span>
            <img src={imagen.src} alt={nombre} width={imagen.ancho} height={imagen.alto} fetchpriority="high" />
            {m && (
              <span class="temp" data-t={m.temperatura}>
                {may(t.temperatura[m.temperatura])}
              </span>
            )}
          </>
        )}
      </div>

      <div class="datos">
        <p class="cat">{cat}</p>
        <h1>
          {nombre}
          {p && <span>{p.modelo}</span>}
        </h1>
        <p class="frase">{frase}</p>

        {hermanos.length > 1 && (
          <div class="version">
            <p>{tf.version}</p>
            <ul>
              {hermanos.map((x) => (
                <li>
                  <a
                    href={ruta(lang, `/centrifugas/${x.slug}/`)}
                    aria-current={x.slug === m!.slug ? 'page' : undefined}
                    data-t={x.temperatura}
                  >
                    {etiquetaVersion(x)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {m ? (
          <dl class="cifras">
            <div>
              <dt>{tf.capacidad}</dt>
              <dd>{capacidad}</dd>
            </div>
            <div>
              <dt>{tf.velocidad}</dt>
              <dd>
                {numero(lang, m.rpm)} <small>rpm</small>
              </dd>
            </div>
            {xg && (
              <div>
                <dt>{tf.fuerza}</dt>
                <dd>
                  {xg} <small>xg</small>
                </dd>
              </div>
            )}
            <div>
              <dt>{tf.pantalla}</dt>
              <dd>{m.pantalla}</dd>
            </div>
          </dl>
        ) : (
          <p class="linea">{t.laboratorio.items[p!.slug].datos}</p>
        )}

        <div class="botones">
          {pdf && (
            <a class="btn red" href={pdf} target="_blank" rel="noopener">
              {tf.pdf}
            </a>
          )}
          <a class:list={['btn', pdf ? 'ghost' : 'red']} href={ruta(lang, '/#distribuidores')}>
            {tf.distribuidor}
          </a>
        </div>
      </div>
    </div>
  </section>

  {secciones.length > 0 && (
    <section class="detalle" id="detalle">
      <div class="pestanas-barra">
        <div class="wrap pestanas" role="tablist" aria-label={nombre}>
          {secciones.map((x, i) => (
            <a
              role="tab"
              href={`#${x.id}`}
              id={`tab-${x.id}`}
              aria-controls={x.id}
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {x.nombre}
              {x.n && <span class="n">{x.n}</span>}
            </a>
          ))}
        </div>
      </div>

      <div class="wrap paneles">
        {txt?.descripcion.length ? (
          <div class="panel" id="descripcion" role="tabpanel" aria-labelledby="tab-descripcion">
            <div class="desc">
              <div class="texto">
                {txt.descripcion.map((d) => (
                  <p>{d}</p>
                ))}
              </div>
              {vistazo.length > 0 && (
                <aside class="vistazo">
                  <h2>{tf.vistazo}</h2>
                  <dl>
                    {vistazo.map((x) => (
                      <div>
                        <dt>{x.k}</dt>
                        <dd>{x.v}</dd>
                      </div>
                    ))}
                  </dl>
                  {pdf && (
                    <a class="arrow" href={pdf} target="_blank" rel="noopener">
                      {tf.pdf}
                    </a>
                  )}
                </aside>
              )}
            </div>
          </div>
        ) : null}

        {txt?.bloques.length ? (
          <div class="panel" id="caracteristicas" role="tabpanel" aria-labelledby="tab-caracteristicas">
            <div class="tarjetas-texto">
              {txt.bloques.map((b) => (
                <article>
                  <h3>{b.titulo}</h3>
                  <ul>
                    {b.puntos.map((pt) =>
                      pt.punto || pt.sub ? (
                        <li>
                          {pt.t}
                          {pt.sub && (
                            <ul>
                              {pt.sub.map((s) => (
                                <li>{s}</li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ) : (
                        <li class="sub-titulo">{pt.t}</li>
                      ),
                    )}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        ) : null}

        {rotores.length > 0 && (
          <div class="panel" id="rotores" role="tabpanel" aria-labelledby="tab-rotores">
            <p class="intro">{tf.rotores.intro(rotores.length)}</p>
            <ul class="rotores">
              {rotores.map((r, i) => (
                <li>
                  <button type="button" class="rotor" data-abre={`rotor-${i}`}>
                    <span class="r-foto">
                      {r.imagen && (
                        <img src={r.imagen} alt="" width="480" height="480" loading="lazy" decoding="async" />
                      )}
                    </span>
                    <span class="r-nombre">{r.nombre}</span>
                    <span class="r-tipo">{tipoRotor(lang, r.tipo)}</span>
                    <span class="r-cap">{medida(lang, r.capacidad)}</span>
                    <span class="r-vel">
                      {cifra(lang, r.rpm)} rpm · {cifra(lang, r.xg)} xg
                    </span>
                  </button>
                  <dialog class="modal" id={`rotor-${i}`} aria-labelledby={`rotor-${i}-t`}>
                    <div class="modal-in">
                      <button type="button" class="cerrar" aria-label={t.catalogo.visor.cerrar} data-cierra>
                        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                          <path
                            d="M6 6l12 12M18 6 6 18"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                          />
                        </svg>
                      </button>
                      <div class="m-top">
                        <span class="m-foto">
                          {r.imagen && <img src={r.imagen} alt={r.nombre} width="480" height="480" loading="lazy" />}
                        </span>
                        <div>
                          <p class="cat">{tipoRotor(lang, r.tipo)}</p>
                          <h3 id={`rotor-${i}-t`}>{r.nombre}</h3>
                          <dl class="m-cifras">
                            <div>
                              <dt>{tf.capacidad}</dt>
                              <dd>{medida(lang, r.capacidad)}</dd>
                            </div>
                            <div>
                              <dt>{tf.velocidad}</dt>
                              <dd>{cifra(lang, r.rpm)} rpm</dd>
                            </div>
                            <div>
                              <dt>{tf.fuerza}</dt>
                              <dd>{cifra(lang, r.xg)} xg</dd>
                            </div>
                            {r.radio && (
                              <div>
                                <dt>{tf.rotores.radio}</dt>
                                <dd>{r.radio} mm</dd>
                              </div>
                            )}
                            {r.angulo && (
                              <div>
                                <dt>{tf.rotores.angulo}</dt>
                                <dd>{r.angulo}°</dd>
                              </div>
                            )}
                            {r.tempMin && (
                              <div>
                                <dt>{tf.rotores.tempMin}</dt>
                                <dd>{r.tempMin} °C</dd>
                              </div>
                            )}
                          </dl>
                        </div>
                      </div>
                      {r.tubos.length > 0 && (
                        <>
                          <h4>{tf.rotores.tubos}</h4>
                          <div class="tabla-scroll">
                            <table>
                              <thead>
                                <tr>
                                  <th scope="col">{tf.rotores.posiciones}</th>
                                  <th scope="col">{tf.rotores.tubo}</th>
                                  <th scope="col">{tf.rotores.capacidadTubo}</th>
                                  <th scope="col">{tf.rotores.medidas}</th>
                                  <th scope="col">{tf.rotores.reductor}</th>
                                </tr>
                              </thead>
                              <tbody>
                                {r.tubos.map((tb) => (
                                  <tr>
                                    <td class="num">{tb.posiciones}</td>
                                    <td>{tipoTubo(lang, tb.tipo)}</td>
                                    <td>{medida(lang, tb.capacidad) ?? '—'}</td>
                                    <td>{medida(lang, tb.medidas) ?? '—'}</td>
                                    <td>{tb.reductor ?? tf.rotores.directo}</td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </>
                      )}
                    </div>
                  </dialog>
                </li>
              ))}
            </ul>
          </div>
        )}

        {versiones.length > 0 && (
          <div class="panel" id="versiones" role="tabpanel" aria-labelledby="tab-versiones">
            <p class="intro">{tf.versiones.titulo}</p>
            <div class="tabla-scroll">
              <table class="versiones">
                <thead>
                  <tr>
                    <th scope="col">{tf.versiones.codigo}</th>
                    {columnas.map((k) => (
                      <th scope="col">{tf.versiones[k]}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {versiones.map((v) => (
                    <tr>
                      <th scope="row">{v.codigo}</th>
                      {columnas.map((k) => (
                        <td>{valor(k, v[k])}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {deAccesorios.length > 0 && (
          <div class="panel" id="accesorios" role="tabpanel" aria-labelledby="tab-accesorios">
            <p class="intro">{tf.accesorios}</p>
            <ul class="rejilla">
              {deAccesorios.map((a) => (
                <li>
                  <Tarjeta cat={t.laboratorio.accesorios} lab={a} />
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  {tres.length > 0 && (
    <section class="bloque mas">
      <div class="wrap">
        <div class="cabeza">
          <h2>
            {tf.mas} <b>{cat}</b>
          </h2>
          <a class="arrow" href={ruta(lang, `/centrifugas/?c=${catClave}`)}>
            {tf.volver}
          </a>
        </div>
        <ul class="rejilla">
          {tres.map((x) => (
            <li>
              {'rpm' in x ? (
                <Tarjeta
                  cat={cat}
                  modelo={x}
                  capacidad={
                    x.capacidad === productos.find((s) => s.slug === x.serie)?.capacidad
                      ? (textoSerie(lang, x.serie).capacidad ?? x.capacidad)
                      : x.capacidad
                  }
                />
              ) : (
                <Tarjeta cat={cat} lab={x} />
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <p class="wrap fuente">{tf.fuente}</p>
</Base>

<script>
  // Rotores: cada tarjeta abre su ventana con las cifras y los tubos. Se cierra con la X, Esc o pulsando fuera.
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-abre]')) {
    const d = document.getElementById(b.dataset.abre!) as HTMLDialogElement | null;
    if (!d) continue;
    b.addEventListener('click', () => d.showModal());
    d.querySelector('[data-cierra]')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    });
  }

  // Pestañas: se ve un panel cada vez. Sin JS se ven todos, uno debajo de otro.
  const detalle = document.getElementById('detalle');
  const pestanas = [...document.querySelectorAll<HTMLAnchorElement>('.pestanas [role=tab]')];
  if (detalle && pestanas.length) {
    detalle.classList.add('con-pestanas');
    const elegir = (id: string, subir = false) => {
      for (const a of pestanas) {
        const si = a.hash === `#${id}`;
        a.setAttribute('aria-selected', String(si));
        a.tabIndex = si ? 0 : -1;
        document.getElementById(a.hash.slice(1))!.hidden = !si;
      }
      if (subir) {
        history.replaceState(null, '', `#${id}`);
        const y = detalle.getBoundingClientRect().top + window.scrollY - 80;
        if (window.scrollY > y) window.scrollTo({ top: y, behavior: 'smooth' });
      }
    };
    for (const a of pestanas) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        elegir(a.hash.slice(1), true);
      });
      // Flechas para pasar de pestaña con el teclado
      a.addEventListener('keydown', (e) => {
        const i = pestanas.indexOf(a);
        const j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
        if (j === null) return;
        const b = pestanas[(j + pestanas.length) % pestanas.length];
        elegir(b.hash.slice(1));
        b.focus();
      });
    }
    elegir((pestanas.find((a) => a.hash === location.hash) ?? pestanas[0]).hash.slice(1));
  }
</script>

<style>
  /* ——— Cabecera oscura: el escenario con la máquina a la izquierda y los datos en placas de cristal ——— */
  .cabecera {
    --c: var(--t-ventilada);
    --halo: rgba(154, 161, 166, 0.5);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: var(--carbon);
  }
  .cabecera[data-t='refrigerada'] {
    --c: var(--t-refrigerada);
    --halo: rgba(58, 140, 214, 0.55);
  }
  .cabecera[data-t='calefactada'] {
    --c: var(--t-calefactada);
    --halo: rgba(222, 120, 40, 0.5);
  }
  .cabecera[data-t='lab'] {
    --c: var(--red);
    --halo: rgba(221, 4, 10, 0.35);
  }
  /* La luz del estudio: un halo del color de la temperatura detrás de la máquina */
  .cabecera::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -10%;
    left: -10%;
    width: 75%;
    height: 120%;
    background: radial-gradient(closest-side, var(--halo), rgba(21, 23, 25, 0));
  }
  .cabecera-in {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    grid-template-areas:
      'migas migas'
      'foto datos';
    gap: 16px clamp(32px, 5vw, 80px);
    padding-block: 24px clamp(40px, 5vw, 64px);
  }
  .migas {
    grid-area: migas;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    font-size: 15px;
    color: var(--on-dark);
  }
  .migas a {
    color: var(--on-dark);
    text-decoration: none;
  }
  .migas a:hover {
    color: #fff;
  }
  .migas [aria-current] {
    font-weight: 700;
    color: #fff;
  }
  .escaparate {
    grid-area: foto;
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 0.86;
    isolation: isolate;
  }
  /* El nombre de la serie, enorme y apenas visible, detrás de la máquina */
  .fondo {
    position: absolute;
    z-index: -1;
    left: 0;
    top: 2%;
    font-size: clamp(96px, 13vw, 200px);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.06);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fondo {
      animation: desliza 1.4s var(--ease) both;
    }
    .escaparate > img {
      animation: sube 1s 0.15s var(--ease) both;
    }
  }
  @keyframes desliza {
    from {
      opacity: 0;
      transform: translateX(8%);
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .escaparate::after {
    content: '';
    position: absolute;
    left: 22%;
    right: 22%;
    bottom: 7%;
    height: 7%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.75), transparent);
  }
  .escaparate img {
    position: relative;
    z-index: 1;
    width: 80%;
    height: auto;
  }
  .escaparate.oscuro {
    display: flex;
    aspect-ratio: auto;
    min-height: 560px;
  }
  .escaparate.oscuro::after {
    content: none;
  }
