---
// Ficha de un producto (/centrifugas/<slug>/), la misma para centrífugas, accesorios y equipos de laboratorio.
// Responde, en este orden, a lo que pregunta el distribuidor:
// 1. ¿Qué máquina es? Arriba, la galería y, al lado, nombre, frase, una tabla corta con las cifras que deciden
//    (velocidad, fuerza, capacidad, rotores, pantalla, temperatura y referencias) y los dos botones.
// 2. ¿Le vale a mi cliente? Compatibilidad: eliges el tipo de tubo y su tamaño (dibujados a escala con sus medidas
//    reales) y quedan los rotores que lo admiten, con cuántos caben y qué adaptador lleva.
// 3. ¿Cómo lo pido? Datos técnicos (descripción y características) y Referencias (códigos que se copian, medidas,
//    peso y consumo de cada versión, y accesorios).
// Una barra fija con el nombre lleva a cada apartado y siempre a "Pedir". Al final, más máquinas como en el catálogo.
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import Maquina from '../Maquina.astro';
import Tarjeta from '../Tarjeta.astro';
import IconoTemp from '../ui/IconoTemp.astro';
import { familias, modelos, productos, type Modelo } from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import {
  cifra,
  fichaCentrifuga,
  fichaLab,
  medida,
  rotor,
  tipoRotor,
  tipoTubo,
  type TextosFicha,
  type Tubo,
} from '../../data/fichas';
import { idioma, numero, ruta, textoSerie, textos } from '../../i18n';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const tf = t.catalogo.ficha;
const tc = tf.compat;
const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const m: Modelo | undefined = modelos.find((x) => x.slug === slug);
const esAccesorio = accesorios.some((x) => x.slug === slug);
const p: ProductoLab | undefined = [...accesorios, ...equipos].find((x) => x.slug === slug);

// Lo común a centrífugas y equipos
const web = m ? fichaCentrifuga(m.slug) : undefined;
const txt: TextosFicha | undefined = web?.textos[lang] ?? (p ? fichaLab(p.slug)?.[lang] : undefined);
const nombre = m ? m.nombre : t.laboratorio.items[p!.slug].nombre;
const cat = m ? t.catalogo.categorias[m.categoria] : esAccesorio ? t.laboratorio.accesorios : t.laboratorio.equipos;
const catClave = m ? m.categoria : esAccesorio ? 'accesorios' : 'laboratorio';
const frase = m ? textoSerie(lang, m.serie).frase : t.laboratorio.items[p!.slug].frase;
const imagen = (m ?? p)!.imagen;
const pdf = web?.pdf?.[lang] ?? p?.pdf;
const pedir = ruta(lang, '/#distribuidores');

// Capacidad como en el catálogo y fuerza del catálogo o, si no la da para esa versión, de la web actual
const capacidadDe = (x: Modelo) =>
  x.capacidad === productos.find((s) => s.slug === x.serie)?.capacidad
    ? (textoSerie(lang, x.serie).capacidad ?? x.capacidad)
    : x.capacidad;
const xgDe = (x: Modelo) => x.xg ?? fichaCentrifuga(x.slug)?.xg;
const fuerzaDe = (x: Modelo) => (x.xg ? numero(lang, x.xg) : cifra(lang, xgDe(x)));

// Versiones de la misma serie (22 / 22 R, C / C-U / C-8). En casi todas la versión es la temperatura y va en su
// fila; en la Digtor 22 C son tres modelos de la misma temperatura y llevan su propia fila
const hermanos = m ? modelos.filter((x) => x.serie === m.serie) : [];
const versionPorTemp =
  !!m && hermanos.length > 1 && new Set(hermanos.map((x) => x.temperatura)).size === hermanos.length;
const etiquetaVersion = (x: Modelo) =>
  versionPorTemp ? may(t.temperatura[x.temperatura]) : x.nombre.replace(/^.* (?=\S+$)/, '');
const rotores = (web?.rotores ?? []).map(rotor);
const versiones = web?.versiones ?? [];
const deAccesorios = [...accesorios].filter((a) => web?.accesorios.includes(a.slug));

// Galería: la máquina entera, su foto de detalle (la de la gama, si es de esta versión) y sus rotores
type Vista = { tipo: 'maquina' | 'detalle' | 'rotor'; src: string; nombre: string };
const tg = tf.galeria;
const gamaPropia = !!m && existsSync(`${process.cwd()}/public/img/gama/${m.slug}.webp`);
const detalle = m && (gamaPropia || m.slug === m.serie) ? `/img/gama/${m.slug}.webp` : undefined;
const vistas = [
  { tipo: 'maquina', src: imagen.src, nombre: tg.foto },
  detalle && { tipo: 'detalle', src: detalle, nombre: tg.detalle },
  p?.imagen2 && { tipo: 'detalle', src: p.imagen2.src, nombre: tg.detalle },
  ...rotores.filter((r) => r.imagen).map((r) => ({ tipo: 'rotor', src: r.imagen!, nombre: r.nombre })),
].filter(Boolean) as Vista[];
// Con muchas vistas (los modelos con una docena de rotores) la tira no crece: enseña las primeras y una casilla "+N"
// que abre todas a pantalla completa. Las demás siguen en la galería (flechas, deslizar), solo sin miniatura
const MAX_MINIS = 6;
const minisVisibles = vistas.length > MAX_MINIS ? MAX_MINIS - 1 : vistas.length;
const minisFuera = vistas.length - minisVisibles;

// ——— Tabla de la cabecera ———
// Rotores: cuántos y de qué tipo ("13 angulares y oscilantes")
const tiposDeRotor = [...new Set(rotores.map((r) => r.tipo))];
const tiposTexto = tiposDeRotor
  .map((x) => tf.tiposRotor[x])
  .join(', ')
  .replace(/, ([^,]*)$/, ` ${tf.tiposRotor.y} $1`);
// Referencias: el código de cada versión; las IVD, en la tabla de Referencias
const conIvd = versiones.some((v) => v.ivd);

// ——— Compatibilidad: el distribuidor elige la capacidad del tubo de su cliente y cada rotor que lo admite dice cuántos
// caben y qué adaptador lleva. Las opciones son las capacidades que admite algún rotor, de menor a mayor; lo que no la
// tiene en el catálogo (microplacas, hemólisis, capilares…) va al final con su nombre
// Opción de un tubo: su capacidad ("80 ml-85 ml" → "80-85 ml") o, si el catálogo no la da, su tipo
const opcionDe = (x: Tubo) => (x.capacidad ? `c:${x.capacidad.replace(/\s*ml\s*-\s*/i, '-')}` : `t:${x.tipo}`);
// "1,5-2,2 ml" → [1.5, 2.2], "1.000 ml" → [1000]: se ordena por la menor y luego por la mayor
const mls = (c: string) =>
  c
    .split('-')
    .map((v) =>
      Number(
        v
          .replace(/\./g, '')
          .replace(',', '.')
          .replace(/[^\d.]/g, ''),
      ),
    )
    .filter((v) => v > 0);
interface Opcion {
  id: string;
  /** Lo que dice el desplegable: "15 ml" o, sin capacidad, el nombre del tipo ("Microplacas") */
  nombre: string;
  /** Lo que se busca, para las frases: "tubos de 15 ml" */
  que: string;
  /** Los tipos de tubo de esa capacidad (tipo del ERP, nombre y su frase). Si hay más de uno, un segundo
   * desplegable (opcional) deja solo el del cliente */
  tipos: { clave: string; nombre: string; frase: string }[];
  /** Frase del recuento, ya hecha: "7 de 13 rotores admiten tubos de 15 ml" */
  frase: string;
  orden: number[];
}
const opciones = new Map<string, Opcion>();
for (const r of rotores) {
  for (const x of r.tubos) {
    if (!x.tipo) continue;
    const id = opcionDe(x);
    let o = opciones.get(id);
    if (!o) {
      const c = id.slice(2);
      const n = rotores.filter((y) => y.tubos.some((z) => z.tipo && opcionDe(z) === id)).length;
      const que = x.capacidad ? tc.tuboDe(medida(lang, c)!) : tipoTubo(lang, x.tipo)!;
      o = {
        id,
        nombre: x.capacidad ? medida(lang, c)! : may(tipoTubo(lang, x.tipo)!),
        que,
        tipos: [],
        frase: tc.admiten(n, rotores.length, que),
        orden: x.capacidad ? mls(c) : [Infinity],
      };
      opciones.set(id, o);
    }
    if (o.tipos.some((t) => t.clave === x.tipo)) continue;
    const nombre = tipoTubo(lang, x.tipo)!;
    const n = rotores.filter((y) => y.tubos.some((z) => z.tipo === x.tipo && opcionDe(z) === id)).length;
    o.tipos.push({ clave: x.tipo, nombre, frase: tc.admiten(n, rotores.length, `${o.que} (${nombre})`) });
  }
}
const listaOpciones = [...opciones.values()].sort(
  (a, b) =>
    a.orden[0] - b.orden[0] || (a.orden.at(-1) ?? 0) - (b.orden.at(-1) ?? 0) || a.nombre.localeCompare(b.nombre, lang),
);
const conTipos = listaOpciones.filter((o) => o.tipos.length > 1);

// ——— Referencias: columnas de la tabla de versiones, solo las que tienen algún dato ———
const columnas = (['medidas', 'peso', 'voltaje', 'frecuencia', 'consumo', 'zMax', 'calefaccion'] as const).filter((k) =>
  versiones.some((v) => v[k]),
);
const unidades: Record<(typeof columnas)[number], string> = {
  medidas: ' mm',
  peso: ' kg',
  voltaje: ' V',
  frecuencia: ' Hz',
  consumo: ' W',
  zMax: '',
  calefaccion: '',
};
const valor = (k: (typeof columnas)[number], v?: string) =>
  v ? (k === 'medidas' ? v.replace(/x/g, ' × ') : v) + unidades[k] : '—';

// Datos técnicos: el primer párrafo a la vista y el resto tras "Leer más"
// Los párrafos seguidos que empiezan por "• " son una lista (las funciones del GRS)
const [entrada, ...restoLineas] = (txt?.descripcion ?? []).filter((d) => d.trim());
const restoTexto = restoLineas.reduce<(string | string[])[]>((acc, d) => {
  const li = d.match(/^•\s*(.*)/s)?.[1];
  const ult = acc.at(-1);
  if (li === undefined) acc.push(d);
  else if (Array.isArray(ult)) ult.push(li);
  else acc.push([li]);
  return acc;
}, []);
type BloqueFicha = NonNullable<typeof txt>['bloques'][number];
// Los bloques con tablas o fotos (versiones, referencias, accesorios) van en Referencias, como tablas de verdad
const esReferencia = (b: BloqueFicha) => Boolean(b.tablas?.length || b.imagenes?.length);
const refBloques = txt?.bloques.filter(esReferencia) ?? [];
// Cada bloque va en su tarjeta; los de normas (solo líneas sin viñeta) quedan fuera, como una línea de texto bajo
// las tarjetas. Una tarjeta sin ningún punto con texto no se enseña
const esNormas = (b: BloqueFicha) =>
  !esReferencia(b) && b.puntos.length > 0 && b.puntos.every((pt) => !pt.punto && !pt.sub);
const tarjetas =
  txt?.bloques.filter(
    (b) => !esReferencia(b) && !esNormas(b) && b.puntos.some((pt) => pt.t.trim() || pt.sub?.length),
  ) ?? [];
// Normas y directivas: en un bloque ("Directivas: …" / "Normas: …") o en uno por cada una (el GRS)
const bloquesNormas = txt?.bloques.filter(esNormas) ?? [];
const normas = bloquesNormas.length && {
  titulo: bloquesNormas.length > 1 ? tf.normas : bloquesNormas[0].titulo,
  filas: bloquesNormas.flatMap((b) =>
    b.puntos.map((pt) => {
      const [k, v] = pt.t.split(/:\s*(.*)/s);
      const lista = (s: string) =>
        s
          .replace(/\.$/, '')
          .split(/\s*,\s*/)
          .filter(Boolean);
      return v ? { k, v: lista(v) } : { k: bloquesNormas.length > 1 ? b.titulo : '', v: lista(pt.t) };
    }),
  ),
};
const VISIBLES = 4;
const cuenta = (b: (typeof tarjetas)[number]) => b.puntos.filter((pt) => pt.punto || pt.sub).length;
// Datos técnicos solo si hay algo que enseñar: texto, alguna tarjeta o las normas
const hayDatos = Boolean(entrada || tarjetas.length || normas);
// En las tablas de la web actual, los códigos ("CP 007", "PI 226") se copian con un clic, como en las versiones
const esCodigo = (s: string) => /^[A-Z]{2,3} ?\d{3}[A-Z]*$/.test(s);
// El bloque que se llama como el apartado ("Referencias") no repite el título
const tituloRef = (b: BloqueFicha) =>
  b.titulo.toLowerCase() === tf.secciones.referencias.toLowerCase() ? '' : b.titulo;

const apartados = [
  rotores.length && { id: 'compatibilidad', nombre: tf.secciones.compatibilidad },
  hayDatos && { id: 'datos', nombre: tf.secciones.datos },
  (versiones.length || deAccesorios.length || refBloques.length) && {
    id: 'referencias',
    nombre: tf.secciones.referencias,
  },
].filter(Boolean) as { id: string; nombre: string }[];

// Al final, un carrusel: primero los de la misma aplicación y luego los de la misma temperatura y el resto, hasta nueve
const mismos = m
  ? modelos.filter((x) => x.categoria === m.categoria && x.slug !== m.slug)
  : (esAccesorio ? accesorios : equipos).filter((x) => x.slug !== p!.slug);
const otros = m
  ? modelos
      .filter((x) => x.categoria !== m.categoria)
      .sort((a, b) => Number(b.temperatura === m.temperatura) - Number(a.temperatura === m.temperatura))
  : [];
const tres = [...mismos, ...otros].slice(0, 9);
const completa = tres.length > mismos.length;
const colorDe = (x: Modelo) => familias[productos.find((s) => s.slug === x.serie)!.familia].color as string;

// Cifras de la cabecera: lo que decide la compra; la temperatura, aquí salvo que se elija como versión
// ——— Cifras dentro de la gama: velocidad, fuerza y capacidad, cada una con una barra que dice dónde queda este
// modelo entre la más pequeña y la más grande del catálogo (fuerza y capacidad, en escala logarítmica, porque van de
// unos pocos ml a litros) ———
const aNum = (s?: string | number) =>
  typeof s === 'number'
    ? s
    : Number(
        String(s ?? '')
          .replace(/\./g, '')
          .replace(',', '.'),
      );
// "12 × 2 ml" → 24; "4 x 750 ml" → 3000; si no se puede leer, NaN y la cifra va sin barra
const mlTotal = (c: string) => {
  const r = c.match(/(\d+)\s*[x×]\s*([\d.,]+)\s*ml/i);
  return r ? Number(r[1]) * aNum(r[2]) : NaN;
};
const fmt = (n: number) =>
  numero(lang, new Intl.NumberFormat('es-ES', { maximumFractionDigits: 1, useGrouping: 'always' }).format(n));
// ——— Franja técnica: las cifras que deciden la compra, en una línea. Cada una puede llevar su contexto (a cuántos
// modelos del catálogo supera, su posición en la gama de 0 a 1 y entre qué cifras va) ———
interface Contexto {
  supera: string;
  gama: string;
  p: number;
}
interface Cifra {
  k: string;
  ico?: string;
  v: string;
  u?: string;
  ctx?: Contexto;
  extra?: string;
}
const contextoDe = (valor: (x: Modelo) => number, u: string, log: boolean): Contexto | undefined => {
  if (!m) return undefined;
  const ns = modelos.map(valor).filter((n) => Number.isFinite(n) && n > 0);
  const yo = valor(m);
  if (!Number.isFinite(yo) || yo <= 0 || ns.length < 2) return undefined;
  const [min, max] = [Math.min(...ns), Math.max(...ns)];
  const f = log ? Math.log : (z: number) => z;
  return {
    // Si no supera a ninguno, la frase no dice nada: queda la microbarra y la gama
    supera: ns.some((n) => n < yo)
      ? tf.supera.replace('{n}', String(ns.filter((n) => n < yo).length)).replace('{total}', String(ns.length))
      : '',
    gama: `${tf.gama}: ${fmt(min)} – ${fmt(max)}${u}`,
    p: (f(yo) - f(min)) / (f(max) - f(min) || 1),
  };
};
const cifras: Cifra[] = m
  ? [
      {
        k: tf.velocidad,
        ico: 'ficha-velocidad',
        v: numero(lang, m.rpm),
        u: 'rpm',
        ctx: contextoDe((x) => aNum(x.rpm), ' rpm', false),
      },
      ...(fuerzaDe(m)
        ? [
            {
              k: tf.fuerza,
              ico: 'ficha-velocidad',
              v: fuerzaDe(m)!,
              u: 'xg',
              ctx: contextoDe((x) => aNum(xgDe(x)), ' xg', true),
            },
          ]
        : []),
      {
        k: tf.capacidad,
        ico: 'ficha-capacidad',
        v: capacidadDe(m),
        ctx: contextoDe((x) => mlTotal(x.capacidad), ' ml', true),
      },
      ...(rotores.length > 0
        ? [
            {
              k: tf.rotoresFila,
              ico: 'rotor-add',
              v: String(rotores.length),
              u: tiposTexto,
              extra: rotores.map((r) => r.nombre).join(' · '),
            },
          ]
        : []),
      { k: tf.pantalla, ico: 'ficha-pantalla', v: m.pantalla },
    ]
  : // Equipos y accesorios: sus datos tal como los da el catálogo, y su código
    [
      ...t.laboratorio.items[p!.slug].datos.split(' · ').map((v) => ({ k: '', v })),
      { k: tf.versiones.codigo, v: p!.modelo },
    ];

const titulo = `${nombre} · ${cat} · Orto Alresa`;
const descripcion = m
  ? `${nombre}: ${frase} ${capacidadDe(m)}, ${numero(lang, m.rpm)} rpm, ${tf.pantalla.toLowerCase()} ${m.pantalla}.`
  : `${nombre} (${p!.modelo}): ${frase}`;
---

<Base title={titulo} description={descripcion}>
  <section class="cabecera" data-t={m?.temperatura ?? 'lab'}>
    <div class="wrap cabecera-in">
      <nav class="migas" aria-label="Breadcrumb">
        <a href={ruta(lang, '/')}>{tf.inicio}</a>
        <span aria-hidden="true">/</span>
        <a href={ruta(lang, '/centrifugas/')}>{tf.productos}</a>
        <span aria-hidden="true">/</span>
        <a href={ruta(lang, `/centrifugas/?c=${catClave}`)}>{cat}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{nombre}</span>
      </nav>

      <!-- Escaparate: un escenario a sangre con la máquina a la derecha, la tarjeta en un panel oscuro a la izquierda y,
      abajo, la franja técnica en la misma rejilla. El fondo cambia de tono según la vista -->
      <div class="escaparate" data-vista={vistas[0]?.tipo ?? 'maquina'}>
        <!-- Galería: una vista grande y sus miniaturas en una tira vertical. Sin JS se ve la primera; en móvil se desliza -->
        <div class="galeria">
          <div class="escena">
            {vistas.map((v, i) => (
              <div
                class="vista"
                data-tipo={v.tipo}
                id={`vista-${i}`}
                hidden={i > 0}
                role="tabpanel"
                aria-label={v.tipo === 'maquina' ? nombre : v.nombre}
              >
                {v.tipo === 'maquina' ? (
                  <span class="pieza">
                    <span class="contacto" aria-hidden="true"></span>
                    <img
                      src={v.src}
                      alt={nombre}
                      width={imagen.ancho}
                      height={imagen.alto}
                      fetchpriority={i === 0 ? 'high' : undefined}
                      loading={i === 0 ? undefined : 'lazy'}
                    />
                  </span>
                ) : (
                  <>
                    <img src={v.src} alt={`${nombre} · ${v.nombre}`} width="720" height="720" loading="lazy" />
                    <span class="pie-vista">{v.nombre}</span>
                  </>
                )}
              </div>
            ))}
          </div>
          <button type="button" class="ampliar" aria-label={tg.ampliar}>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M2 7V2h5M13 2h5v5M18 13v5h-5M7 18H2v-5" />
            </svg>
          </button>
          <!-- Pantalla completa: las fotos grandes sobre negro, con flechas, y clic para acercar donde se pulsa -->
          <dialog class="visor-foto" aria-label={nombre}>
            <figure>
              <img src="" alt="" />
              <figcaption>
                <b></b>
                <span class="lb-cuenta"></span>
                <span class="lb-pista">{tg.zoom}</span>
              </figcaption>
            </figure>
            <button type="button" class="lb-paso" data-paso="-1" aria-label={tg.anterior}>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M12.5 4 6.5 10l6 6" />
              </svg>
            </button>
            <button type="button" class="lb-paso" data-paso="1" aria-label={tg.siguiente}>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="m7.5 4 6 6-6 6" />
              </svg>
            </button>
            <button type="button" class="lb-cerrar" aria-label={tg.cerrar}>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="m4 4 12 12M16 4 4 16" />
              </svg>
            </button>
          </dialog>
          {vistas.length > 1 && (
            <div class="miniaturas" role="tablist" aria-label={nombre} aria-orientation="vertical" style="--sel: 0">
              <span class="mini-raya" aria-hidden="true"></span>
              {vistas.map((v, i) => (
                <button
                  type="button"
                  role="tab"
                  class="mini"
                  data-tipo={v.tipo}
                  data-vista={`vista-${i}`}
                  aria-controls={`vista-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  hidden={i >= minisVisibles}
                >
                  <span class="mini-foto">
                    <img src={v.src} alt="" width="120" height="100" decoding="async" />
                  </span>
                  <span class="mini-nombre">{v.nombre}</span>
                </button>
              ))}
              {minisFuera > 0 && (
                <button type="button" class="mini mini-todas" aria-label={`${tg.todas} (${vistas.length})`}>
                  <span class="mini-foto">
                    <b>+{minisFuera}</b>
                  </span>
                </button>
              )}
            </div>
          )}
        </div>

        <!-- Tarjeta: panel oscuro sólido (contraste asegurado sobre cualquier vista). Categoría, nombre, frase, temperatura
        y referencia, y el pedido -->
        <div class="datos">
          <p class="cat">{cat}</p>
          <h1>{nombre}</h1>
          <p class="frase">{frase}</p>

          <div class="botones">
            <a class="btn red" href={pedir}>
              {tf.distribuidor}
            </a>
            {pdf && (
              <a class="btn ghost" href={pdf} target="_blank" rel="noopener">
                {tf.pdf}
              </a>
            )}
          </div>

          {m && (
            <dl class="meta">
              {!versionPorTemp && (
                <div>
                  <dt>{t.catalogo.iconos.temperatura}</dt>
                  <dd class="ico-temp" data-t={m.temperatura}>
                    <IconoTemp t={m.temperatura} size={18} />
                    <b>{may(t.temperatura[m.temperatura])}</b>
                  </dd>
                </div>
              )}
              {hermanos.length > 1 && (
                <div>
                  <dt>{versionPorTemp ? t.catalogo.iconos.temperatura : tf.version}</dt>
                  <dd>
                    <ul class="version">
                      {hermanos.map((x) => (
                        <li>
                          <a
                            href={ruta(lang, `/centrifugas/${x.slug}/`)}
                            aria-current={x.slug === m.slug ? 'page' : undefined}
                            data-t={versionPorTemp ? x.temperatura : undefined}
                          >
                            {versionPorTemp && <IconoTemp t={x.temperatura} size={14} />}
                            {etiquetaVersion(x)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
              {versiones.length > 0 && (
                <div>
                  <dt>{tf.secciones.referencias}</dt>
                  <dd class="codigos">
                    {versiones.map((v) => (
                      <button type="button" class="copiar" data-copiar={v.codigo}>
                        <span class="cod">{v.codigo}</span>
                        <span class="copia-estado" aria-hidden="true">
                          <span class="c-copiar">
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                              <path d="M5.5 5.5h8v8h-8zM10.5 5.5v-3h-8v8h3" />
                            </svg>
                            {tf.copiar}
                          </span>
                          <span class="c-hecho">
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                              <path d="m3 8.5 3.2 3L13 4.5" />
                            </svg>
                            {tf.copiado}
                          </span>
                        </span>
                        <span class="sr">{tf.copiar}</span>
                      </button>
                    ))}
                    {conIvd && <small>{tf.ivd}</small>}
                    <span class="sr aviso-copia" role="status" aria-live="polite" data-hecho={tf.copiado}></span>
                  </dd>
                </div>
              )}
            </dl>
          )}
        </div>

        <!-- Franja técnica: las cifras en una línea, con divisores finos. Cada una se enfoca y anuncia su contexto -->
        {cifras.length > 0 && (
          <dl class="franja" style={`--n: ${cifras.length}`}>
            {cifras.map((x, i) => (
              <div class:list={['cifra', { codigos: !m && x.k === tf.versiones.codigo }]} style={`--i: ${i}`}>
                <span class="marea" aria-hidden="true">
                  <i>
                    <b />
                    <b />
                    <b />
                  </i>
                </span>
                {x.k && (
                  <dt>
                    {x.ico && <i class="ico" style={`--ico: url(/img/iconos/${x.ico}.svg)`} aria-hidden="true" />}
                    {x.k}
                  </dt>
                )}
                <dd>
                  {/* Con contexto, la cifra es un botón: se enfoca con el teclado (o se toca) y anuncia su contexto */}
                  {x.ctx || x.extra ? (
                    <button type="button" class="valor" aria-describedby={`ctx-${i}`}>
                      <b>{x.v}</b>
                      {x.u && <small>{x.u}</small>}
                    </button>
                  ) : (
                    <span class="valor">
                      <b>{x.v}</b>
                      {x.u && <small>{x.u}</small>}
                    </span>
                  )}
                  {(x.ctx || x.extra) && (
                    <span
                      class="ctx"
                      id={`ctx-${i}`}
                      role="tooltip"
                      style={x.ctx ? `--p: ${x.ctx.p.toFixed(3)}` : undefined}
                    >
                      {x.ctx && (
                        <>
                          {x.ctx.supera && <b>{x.ctx.supera}</b>}
                          <span class="micro" aria-hidden="true">
                            <i></i>
                          </span>
                          <span>{x.ctx.gama}</span>
                        </>
                      )}
                      {x.extra && <b>{x.extra}</b>}
                    </span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </div>
  </section>

  {apartados.length > 0 && (
    <>
      <!-- Barra fija: el nombre, los apartados (marca el que se lee) y pedir siempre a mano -->
      <nav class="barra" aria-label={nombre}>
        <div class="wrap barra-in">
          <b class="barra-nombre">{nombre}</b>
          {apartados.length > 1 && (
            <ul>
              {apartados.map((x) => (
                <li>
                  <a href={`#${x.id}`}>{x.nombre}</a>
                </li>
              ))}
            </ul>
          )}
          <a class="btn red barra-pedir" href={pedir}>
            {tf.pedir}
          </a>
        </div>
      </nav>

      {rotores.length > 0 && (
        <section class="apartado compat" id="compatibilidad" aria-labelledby="t-compat">
          <div class="wrap">
            <header class="cp-cab">
              <h2 id="t-compat">{tc.titulo}</h2>
              <p>{tc.intro(rotores.length)}</p>
            </header>

            <div class="elegir" hidden>
              <label class="campo">
                <span>{tc.capacidad}</span>
                <span class="sel">
                  <select class="sel-cap">
                    <option value="">{tc.elige}</option>
                    {listaOpciones.map((o) => (
                      <option
                        value={o.id}
                        data-frase={o.frase}
                        data-tipos={
                          o.tipos.length > 1
                            ? JSON.stringify(o.tipos.map((x) => [x.clave, may(x.nombre), x.frase]))
                            : undefined
                        }
                      >
                        {o.nombre}
                      </option>
                    ))}
                  </select>
                </span>
              </label>
              {conTipos.length > 0 && (
                <label class="campo campo-tipo" hidden>
                  <span>{tc.tipo}</span>
                  <span class="sel">
                    <select class="sel-tipo" data-todos={tc.todosTipos} />
                  </span>
                </label>
              )}
              <p class="estado">
                <span class="aviso" aria-live="polite" data-todos={tc.todos(rotores.length)}>
                  {tc.todos(rotores.length)}
                </span>
                <button type="button" class="quitar" hidden>
                  {tc.quitar}
                </button>
              </p>
            </div>

            <div>
              <div class="cp-th" aria-hidden="true">
                <span>{tc.rotor}</span>
                <span class="th-cifras">
                  <span>{tf.capacidad}</span>
                  <span>{tf.velocidad}</span>
                  <span>{tf.fuerza}</span>
                </span>
                <span class="th-encaja">
                  <span>{tf.rotores.tubo}</span>
                  <span>{tc.caben}</span>
                  <span>{tf.rotores.reductor}</span>
                </span>
              </div>
              <ul class="rotores">
                {rotores.map((r) => (
                  <li class="rc" data-nombre={r.nombre}>
                    <div class="rc-rotor">
                      <span class="rc-foto">
                        {r.imagen && (
                          <img src={r.imagen} alt="" width="480" height="480" loading="lazy" decoding="async" />
                        )}
                      </span>
                      <div>
                        <h3>{r.nombre}</h3>
                        <p class="rc-tipo">{tipoRotor(lang, r.tipo)}</p>
                        {r.noEn && <p class="rc-no">{tf.rotores.noEn(r.noEn.join(', '))}</p>}
                      </div>
                    </div>
                    <dl class="rc-cifras">
                      <div>
                        <dt>{tf.capacidad}</dt>
                        <dd>{medida(lang, r.capacidad) ?? '—'}</dd>
                      </div>
                      <div>
                        <dt>{tf.velocidad}</dt>
                        <dd>{r.rpm ? `${cifra(lang, r.rpm)} rpm` : '—'}</dd>
                      </div>
                      <div>
                        <dt>{tf.fuerza}</dt>
                        <dd>{r.xg ? `${cifra(lang, r.xg)} xg` : '—'}</dd>
                      </div>
                    </dl>
                    {r.tubos.length > 0 && (
                      <ul class="encaja" hidden>
                        {r.tubos
                          .filter((x) => x.tipo)
                          .map((x) => (
                            <li data-op={opcionDe(x)} data-tipo={x.tipo} hidden>
                              <span class="en-que">
                                {may(tipoTubo(lang, x.tipo)!)}
                                {x.medidas && <small>{medida(lang, x.medidas)}</small>}
                              </span>
                              <span class="en-n">
                                <b>{x.posiciones ?? '—'}</b> {tc.ud}
                              </span>
                              <span class="en-ad">
                                <span class="en-et">{tf.rotores.reductor}</span>
                                {x.reductor ? (
                                  <button
                                    type="button"
                                    class="copiar adaptador"
                                    data-copiar={x.reductor}
                                    data-pista={tf.copiar}
                                    data-hecho={tf.copiado}
                                  >
                                    {x.reductor}
                                  </button>
                                ) : (
                                  <em>{tc.sinAdaptador}</em>
                                )}
                              </span>
                            </li>
                          ))}
                      </ul>
                    )}
                    {r.tubos.length > 0 && (
                      <details class="rc-tabla">
                        <summary>{tc.verTubos(r.tubos.length)}</summary>
                        <div class="tabla-scroll">
                          <table>
                            <thead>
                              <tr>
                                <th scope="col">{tf.rotores.posiciones}</th>
                                <th scope="col">{tf.rotores.tubo}</th>
                                <th scope="col">{tf.rotores.capacidadTubo}</th>
                                <th scope="col">{tf.rotores.medidas}</th>
                                <th scope="col">{tf.rotores.reductor}</th>
                              </tr>
                            </thead>
                            <tbody>
                              {r.tubos.map((tb) => (
                                <tr data-op={tb.tipo && opcionDe(tb)} data-tipo={tb.tipo}>
                                  <td class="num">{tb.posiciones}</td>
                                  <td>{may(tipoTubo(lang, tb.tipo) ?? '—')}</td>
                                  <td>{medida(lang, tb.capacidad) ?? '—'}</td>
                                  <td>{medida(lang, tb.medidas) ?? '—'}</td>
                                  <td>{tb.reductor ?? tf.rotores.directo}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                        {(r.radio || r.angulo || r.tempMin) && (
                          <p class="rc-mas">
                            {r.radio && (
                              <span>
                                {tf.rotores.radio} <b>{r.radio} mm</b>
                              </span>
                            )}
                            {r.angulo && (
                              <span>
                                {tf.rotores.angulo} <b>{r.angulo}°</b>
                              </span>
                            )}
                            {r.tempMin && (
                              <span>
                                {tf.rotores.tempMin} <b>{r.tempMin} °C</b>
                              </span>
                            )}
                          </p>
