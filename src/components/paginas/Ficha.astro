---
// Ficha de un producto (/centrifugas/<slug>/), la misma para centrífugas, accesorios y equipos de laboratorio.
// Responde, en este orden, a lo que pregunta el distribuidor:
// 1. ¿Qué máquina es? Arriba, la galería y, al lado, nombre, frase, una tabla corta con las cifras que deciden
//    (velocidad, fuerza, capacidad, rotores, pantalla, temperatura y referencias) y los dos botones.
// 2. ¿Le vale a mi cliente? Compatibilidad: eliges el tipo de tubo y su tamaño (dibujados a escala con sus medidas
//    reales) y quedan los rotores que lo admiten, con cuántos caben y qué adaptador lleva.
// 3. ¿Cómo lo pido? Datos técnicos (descripción y características) y Referencias (códigos que se copian, medidas,
//    peso y consumo de cada versión, y accesorios).
// Una barra fija con el nombre lleva a cada apartado y siempre a "Pedir". Al final, más máquinas como en el catálogo.
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import Maquina from '../Maquina.astro';
import Paso from '../Paso.astro';
import Tarjeta from '../Tarjeta.astro';
import Visor3D from '../Visor3D.astro';
import IconoTemp from '../ui/IconoTemp.astro';
import { familias, modelos, productos, type Modelo } from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import {
  cifra,
  familiaTubo,
  familiasTubo,
  fichaCentrifuga,
  fichaLab,
  medida,
  rotor,
  tipoRotor,
  tipoTubo,
  type FamiliaTubo,
  type Rotor,
  type TextosFicha,
  type Tubo,
} from '../../data/fichas';
import { idioma, numero, ruta, textoSerie, textos } from '../../i18n';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const tf = t.catalogo.ficha;
const tc = tf.compat;
const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const m: Modelo | undefined = modelos.find((x) => x.slug === slug);
const esAccesorio = accesorios.some((x) => x.slug === slug);
const p: ProductoLab | undefined = [...accesorios, ...equipos].find((x) => x.slug === slug);

// Lo común a centrífugas y equipos
const web = m ? fichaCentrifuga(m.slug) : undefined;
const txt: TextosFicha | undefined = web?.textos[lang] ?? (p ? fichaLab(p.slug)?.[lang] : undefined);
const nombre = m ? m.nombre : t.laboratorio.items[p!.slug].nombre;
const cat = m ? t.catalogo.categorias[m.categoria] : esAccesorio ? t.laboratorio.accesorios : t.laboratorio.equipos;
const catClave = m ? m.categoria : esAccesorio ? 'accesorios' : 'laboratorio';
const frase = m ? textoSerie(lang, m.serie).frase : t.laboratorio.items[p!.slug].frase;
const imagen = (m ?? p)!.imagen;
const pdf = web?.pdf?.[lang] ?? p?.pdf;
const pedir = ruta(lang, '/#distribuidores');

// Capacidad como en el catálogo y fuerza del catálogo o, si no la da para esa versión, de la web actual
const capacidadDe = (x: Modelo) =>
  x.capacidad === productos.find((s) => s.slug === x.serie)?.capacidad
    ? (textoSerie(lang, x.serie).capacidad ?? x.capacidad)
    : x.capacidad;
const xgDe = (x: Modelo) => x.xg ?? fichaCentrifuga(x.slug)?.xg;
const fuerzaDe = (x: Modelo) => (x.xg ? numero(lang, x.xg) : cifra(lang, xgDe(x)));

// Versiones de la misma serie (22 / 22 R, C / C-U / C-8). En casi todas la versión es la temperatura y va en su
// fila; en la Digtor 22 C son tres modelos de la misma temperatura y llevan su propia fila
const hermanos = m ? modelos.filter((x) => x.serie === m.serie) : [];
const versionPorTemp =
  !!m && hermanos.length > 1 && new Set(hermanos.map((x) => x.temperatura)).size === hermanos.length;
const etiquetaVersion = (x: Modelo) =>
  versionPorTemp ? may(t.temperatura[x.temperatura]) : x.nombre.replace(/^.* (?=\S+$)/, '');
const rotores = (web?.rotores ?? []).map(rotor);
const versiones = web?.versiones ?? [];
const deAccesorios = [...accesorios].filter((a) => web?.accesorios.includes(a.slug));

// Galería: solo la máquina (entera, su foto de detalle si es de esta versión y el 3D donde lo hay). Las fotos de los
// rotores van con cada rotor en Compatibilidad
type Vista = { tipo: 'maquina' | 'detalle' | '3d'; src: string; nombre: string };
const tg = tf.galeria;
const conVisor = m?.slug === 'digicen-22';
const gamaPropia = !!m && existsSync(`${process.cwd()}/public/img/gama/${m.slug}.webp`);
const detalle = m && (gamaPropia || m.slug === m.serie) ? `/img/gama/${m.slug}.webp` : undefined;
const vistas = [
  conVisor && { tipo: '3d', src: imagen.src, nombre: tg.tresD },
  { tipo: 'maquina', src: imagen.src, nombre: tg.foto },
  detalle && { tipo: 'detalle', src: detalle, nombre: tg.detalle },
  p?.imagen2 && { tipo: 'detalle', src: p.imagen2.src, nombre: tg.detalle },
].filter(Boolean) as Vista[];

// ——— Tabla de la cabecera ———
// Rotores: cuántos y de qué tipo ("13 angulares y oscilantes")
const tiposDeRotor = [...new Set(rotores.map((r) => r.tipo))];
const tiposTexto = tiposDeRotor
  .map((x) => tf.tiposRotor[x])
  .join(', ')
  .replace(/, ([^,]*)$/, ` ${tf.tiposRotor.y} $1`);
// Referencias: el código de cada versión; las IVD, en la tabla de Referencias
const conIvd = versiones.some((v) => v.ivd);

// ——— Compatibilidad: los tubos que admite alguno de sus rotores ———
// Se elige por capacidad, no por cada tipo y medida del ERP: en la Digtor 22 eran 26 tubos de "fondo redondo y plano";
// por capacidad quedan la mitad. Cada opción junta los tubos de esa familia con la misma capacidad (sus "variantes")
type Forma = 'conico' | 'redondo' | 'plano' | 'placa';
interface TuboFicha {
  tipo: string;
  medidas?: string;
  capacidad?: string;
  /** Medidas en mm: diámetro y largo (en placas, ancho y alto) */
  d?: number;
  l?: number;
  forma: Forma;
  tapon: boolean;
}
interface Opcion {
  k: string;
  fam: FamiliaTubo;
  /** Lo que se lee bajo el dibujo: la capacidad o, si no la tiene, el tipo */
  nombre: string;
  variantes: TuboFicha[];
  /** La variante que se dibuja: la más larga, para que el dibujo no se quede corto */
  dib: TuboFicha;
}
// "16x132 mm" → [16, 132]; "36-38x195-203 mm" → [38, 203]; "128x86x22 mm" (placa) → [128, 86, 22]
const mm = (s?: string) => {
  const n = s
    ?.replace(/max\.?/i, '')
    .replace(/mm/i, '')
    .split(/x/i)
    .map((x) => Math.max(...x.split('-').map((v) => Number(v.trim().replace(',', '.')))));
  return n && n.length >= 2 && n.every((v) => v > 0) ? n : undefined;
};
const tuboFicha = (x: Tubo & { tipo: string }): TuboFicha => {
  const n = mm(x.medidas);
  const placa = n?.length === 3;
  return {
    tipo: x.tipo,
    medidas: x.medidas,
    capacidad: x.capacidad,
    d: n?.[0],
    l: placa ? n[2] : n?.[1],
    forma: placa
      ? 'placa'
      : /cónico|microtubos|tiras|traza|cilindro|finger/i.test(x.tipo)
        ? 'conico'
        : /plano/i.test(x.tipo)
          ? 'plano'
          : 'redondo',
    tapon: /tapón|microtubos|criotubos|tiras/i.test(x.tipo),
  };
};
// Capacidad en ml para ordenar ("7-10 ml" → 10, "1.000 ml" → 1000) o, si no la da, la que sale de sus medidas
const volumen = (x: TuboFicha) => {
  const ml = x.capacidad
    ?.split('-')
    .map((v) =>
      Number(
        v
          .replace(/\./g, '')
          .replace(',', '.')
          .replace(/[^\d.]/g, ''),
      ),
    )
    .filter((v) => v > 0);
  if (ml?.length) return Math.max(...ml);
  return x.d && x.l ? (x.forma === 'placa' ? x.d * 86 * x.l : Math.PI * (x.d / 2) ** 2 * x.l) / 1000 : 0;
};
// "80 ml-85 ml" y "80-85 ml" son la misma capacidad
const claveCap = (c: string) =>
  c
    .replace(/\s*ml\s*-/i, '-')
    .replace(/\s+/g, ' ')
    .trim();
const claveOpcion = (x: Tubo & { tipo: string }) =>
  `${familiaTubo(x.tipo)}|${x.capacidad ? claveCap(x.capacidad) : `${x.tipo}|${x.medidas ?? ''}`}`;
const opcionesMapa = new Map<string, Opcion>();
for (const r of rotores) {
  for (const x of r.tubos) {
    if (!x.tipo) continue;
    const c = claveOpcion(x as Tubo & { tipo: string });
    const t = tuboFicha(x as Tubo & { tipo: string });
    const o = opcionesMapa.get(c);
    if (!o) {
      opcionesMapa.set(c, {
        k: `t${opcionesMapa.size}`,
        fam: familiaTubo(x.tipo),
        nombre: x.capacidad ? medida(lang, claveCap(x.capacidad))! : may(tipoTubo(lang, x.tipo)!),
        variantes: [t],
        dib: t,
      });
    } else if (!o.variantes.some((v) => v.tipo === t.tipo && v.medidas === t.medidas)) {
      o.variantes.push(t);
      if ((t.l ?? 0) > (o.dib.l ?? 0)) o.dib = t;
    }
  }
}
const kDe = (x: Tubo) => (x.tipo ? opcionesMapa.get(claveOpcion(x as Tubo & { tipo: string }))?.k : undefined);
// Familias con algún tubo, en el orden del filtro del catálogo; y dentro, del más pequeño al más grande
const familiasFicha = familiasTubo
  .map((f) => ({
    f,
    tubos: [...opcionesMapa.values()]
      .filter((x) => x.fam === f)
      .sort((a, b) => volumen(a.dib) - volumen(b.dib) || (a.dib.l ?? 0) - (b.dib.l ?? 0)),
  }))
  .filter((x) => x.tubos.length > 0);

// Dibujo de cada opción a escala: la misma escala para toda su familia, para que se comparen entre sí, con el más
// largo a 150 px de alto y el más ancho a 150 px como mucho
const ALTO = 150;
const dibujos = new Map<string, { w: number; h: number; cuerpo: string; tapon?: string; nivel: number }>();
for (const { tubos } of familiasFicha) {
  const conMedida = tubos.filter((x) => x.dib.d && x.dib.l);
  if (!conMedida.length) continue;
  const k = Math.min(
    ALTO / Math.max(...conMedida.map((x) => x.dib.l!)),
    150 / Math.max(...conMedida.map((x) => x.dib.d!)),
  );
  for (const { k: id, dib: x } of conMedida) {
    const w = Math.max(4, x.d! * k);
    const h = Math.max(12, x.l! * k);
    const c = x.tapon ? Math.min(14, Math.max(3, h * 0.08)) : 0;
    const f = (v: number) => v.toFixed(1);
    let cuerpo: string;
    if (x.forma === 'redondo') {
      const r = Math.min(w / 2, h - c);
      cuerpo = `M0 ${f(c)}V${f(h - r)}A${f(w / 2)} ${f(r)} 0 0 0 ${f(w)} ${f(h - r)}V${f(c)}Z`;
    } else if (x.forma === 'conico') {
      const cono = Math.min(w * 0.9, (h - c) * 0.38);
      const punta = w * 0.14;
      cuerpo = `M0 ${f(c)}V${f(h - cono)}L${f(w / 2 - punta)} ${f(h)}H${f(w / 2 + punta)}L${f(w)} ${f(h - cono)}V${f(c)}Z`;
    } else if (x.forma === 'plano') {
      const r = Math.min(5, w * 0.1);
      cuerpo = `M0 ${f(c)}V${f(h - r)}Q0 ${f(h)} ${f(r)} ${f(h)}H${f(w - r)}Q${f(w)} ${f(h)} ${f(w)} ${f(h - r)}V${f(c)}Z`;
    } else {
      cuerpo = `M0 ${f(c)}H${f(w)}V${f(h)}H0Z`;
    }
    const tapon = c ? `M${f(-w * 0.06)} 0H${f(w * 1.06)}V${f(c)}H${f(-w * 0.06)}Z` : undefined;
    dibujos.set(id, { w, h, cuerpo, tapon, nivel: c + (h - c) * (x.forma === 'placa' ? 0.25 : 0.42) });
  }
}
// Alto del dibujo más alto de cada familia: todos los de esa familia se apoyan en la misma línea
const altoFamilia = (tubos: Opcion[]) => Math.ceil(Math.max(0, ...tubos.map((x) => dibujos.get(x.k)?.h ?? 0)) + 6);
// Una variante, en palabras: "Fondo plano con tapón, 62 × 120 mm"
const textoVariante = (x: TuboFicha) =>
  [may(tipoTubo(lang, x.tipo)!), medida(lang, x.medidas)].filter(Boolean).join(', ');
const textoOpcion = (x: Opcion) =>
  [x.nombre, ...x.variantes.map(textoVariante)].filter((v, i, a) => a.indexOf(v) === i).join(' · ');
// Lo que el rotor admite: claves de opción
const clavesRotor = (r: Rotor) => [...new Set(r.tubos.map(kDe).filter(Boolean))].join(' ');
// Frases del recuento, ya hechas para cada número (el script solo elige)
const admiten = Array.from({ length: rotores.length + 1 }, (_, i) => tc.admiten(i, rotores.length));
const variasDe = (k?: string) =>
  k ? ([...opcionesMapa.values()].find((o) => o.k === k)?.variantes.length ?? 0) > 1 : false;

// ——— Referencias: columnas de la tabla de versiones, solo las que tienen algún dato ———
const columnas = (['medidas', 'peso', 'voltaje', 'frecuencia', 'consumo', 'zMax', 'calefaccion'] as const).filter((k) =>
  versiones.some((v) => v[k]),
);
const unidades: Record<(typeof columnas)[number], string> = {
  medidas: ' mm',
  peso: ' kg',
  voltaje: ' V',
  frecuencia: ' Hz',
  consumo: ' W',
  zMax: '',
  calefaccion: '',
};
const valor = (k: (typeof columnas)[number], v?: string) =>
  v ? (k === 'medidas' ? v.replace(/x/g, ' × ') : v) + unidades[k] : '—';

// Datos técnicos: la descripción, cortada a unas líneas hasta pulsar "Leer más"
const entrada = txt?.descripcion[0];

const apartados = [
  rotores.length && { id: 'compatibilidad', nombre: tf.secciones.compatibilidad },
  (txt?.descripcion.length || txt?.bloques.length) && { id: 'datos', nombre: tf.secciones.datos },
  (versiones.length || deAccesorios.length) && { id: 'referencias', nombre: tf.secciones.referencias },
].filter(Boolean) as { id: string; nombre: string }[];

// Al final, más de la misma aplicación; si son menos de tres, se completa con la misma temperatura y luego el resto
const mismos = m
  ? modelos.filter((x) => x.categoria === m.categoria && x.slug !== m.slug)
  : (esAccesorio ? accesorios : equipos).filter((x) => x.slug !== p!.slug);
const otros = m
  ? modelos
      .filter((x) => x.categoria !== m.categoria)
      .sort((a, b) => Number(b.temperatura === m.temperatura) - Number(a.temperatura === m.temperatura))
  : [];
const completa = mismos.length < 3 && otros.length > 0;
const tres = [...mismos, ...(completa ? otros : [])].slice(0, 3);
const colorDe = (x: Modelo) => familias[productos.find((s) => s.slug === x.serie)!.familia].color as string;

const titulo = `${nombre} · ${cat} · Orto Alresa`;
const descripcion = m
  ? `${nombre}: ${frase} ${capacidadDe(m)}, ${numero(lang, m.rpm)} rpm, ${tf.pantalla.toLowerCase()} ${m.pantalla}.`
  : `${nombre} (${p!.modelo}): ${frase}`;
---

<Base title={titulo} description={descripcion}>
  <section class="cabecera" data-t={m?.temperatura ?? 'lab'}>
    <div class="wrap cabecera-in">
      <nav class="migas" aria-label="Breadcrumb">
        <a href={ruta(lang, '/')}>{tf.inicio}</a>
        <span aria-hidden="true">/</span>
        <a href={ruta(lang, '/centrifugas/')}>{tf.productos}</a>
        <span aria-hidden="true">/</span>
        <a href={ruta(lang, `/centrifugas/?c=${catClave}`)}>{cat}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{nombre}</span>
      </nav>

      <!-- Galería: una vista grande y sus miniaturas debajo. Sin JS se ve la primera -->
      <div class="galeria">
        <div class="escena">
          {vistas.map((v, i) => (
            <div class="vista" data-tipo={v.tipo} id={`vista-${i}`} hidden={i > 0} role="tabpanel">
              {v.tipo === '3d' ? (
                <Visor3D />
              ) : v.tipo === 'maquina' ? (
                <>
                  <img
                    src={v.src}
                    alt={nombre}
                    width={imagen.ancho}
                    height={imagen.alto}
                    fetchpriority={i === 0 ? 'high' : undefined}
                    loading={i === 0 ? undefined : 'lazy'}
                  />
                  {m && (
                    <span class:list={['temp', m.temperatura]}>
                      <IconoTemp t={m.temperatura} size={16} />
                      {t.temperatura[m.temperatura]}
                    </span>
                  )}
                </>
              ) : (
                <>
                  <img src={v.src} alt={`${nombre} · ${v.nombre}`} width="720" height="720" loading="lazy" />
                  <span class="pie-vista">{v.nombre}</span>
                </>
              )}
            </div>
          ))}
          <button type="button" class="ampliar" aria-label={tg.ampliar}>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M2 7V2h5M13 2h5v5M18 13v5h-5M7 18H2v-5" />
            </svg>
          </button>
          {vistas.length > 1 && (
            <div class="mandos">
              <button type="button" class="paso" data-dir="-1" aria-label={tg.anterior}>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M12.5 4 6.5 10l6 6" />
                </svg>
              </button>
              <span class="cuenta" aria-hidden="true">
                <b>01</b>
                <span>/ {String(vistas.length).padStart(2, '0')}</span>
              </span>
              <button type="button" class="paso" data-dir="1" aria-label={tg.siguiente}>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="m7.5 4 6 6-6 6" />
                </svg>
              </button>
            </div>
          )}
        </div>
        <!-- Pantalla completa: las fotos grandes sobre negro, con flechas, y clic para acercar donde se pulsa -->
        <dialog class="visor-foto" aria-label={nombre}>
          <figure>
            <img src="" alt="" />
            <figcaption>
              <b></b>
              <span class="lb-cuenta"></span>
              <span class="lb-pista">{tg.zoom}</span>
            </figcaption>
          </figure>
          <button type="button" class="lb-paso" data-dir="-1" aria-label={tg.anterior}>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M12.5 4 6.5 10l6 6" />
            </svg>
          </button>
          <button type="button" class="lb-paso" data-dir="1" aria-label={tg.siguiente}>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="m7.5 4 6 6-6 6" />
            </svg>
          </button>
          <button type="button" class="lb-cerrar" aria-label={tg.cerrar}>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="m4 4 12 12M16 4 4 16" />
            </svg>
          </button>
        </dialog>
        {vistas.length > 1 && (
          <div class="miniaturas" role="tablist" aria-label={nombre}>
            {vistas.map((v, i) => (
              <button
                type="button"
                role="tab"
                class="mini"
                data-tipo={v.tipo}
                data-vista={`vista-${i}`}
                aria-controls={`vista-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="mini-foto">
                  {v.tipo === '3d' ? <b>3D</b> : <img src={v.src} alt="" width="120" height="100" decoding="async" />}
                </span>
                <span class="mini-nombre">{v.nombre}</span>
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="datos">
        <p class="cat">{cat}</p>
        <h1>{nombre}</h1>
        <p class="frase">{frase}</p>

        {m ? (
          <>
            <!-- Las tres cifras que deciden, en grande sobre carbón; lo demás, debajo y más pequeño -->
            <dl class="clave">
              <div>
                <dt>{tf.velocidad}</dt>
                <dd>
                  {numero(lang, m.rpm)}
                  <small>rpm</small>
                </dd>
              </div>
              {fuerzaDe(m) && (
                <div>
                  <dt>{tf.fuerza}</dt>
                  <dd>
                    {fuerzaDe(m)}
                    <small>xg</small>
                  </dd>
                </div>
              )}
              <div>
                <dt>{tf.capacidad}</dt>
                <dd>{capacidadDe(m)}</dd>
              </div>
            </dl>

            {hermanos.length > 1 && (
              <div class="version-fila">
                <p>{versionPorTemp ? t.catalogo.iconos.temperatura : tf.version}</p>
                <ul class="version">
                  {hermanos.map((x) => (
                    <li>
                      <a
                        href={ruta(lang, `/centrifugas/${x.slug}/`)}
                        aria-current={x.slug === m.slug ? 'page' : undefined}
                        data-t={versionPorTemp ? x.temperatura : undefined}
                      >
                        {versionPorTemp && <IconoTemp t={x.temperatura} />}
                        {etiquetaVersion(x)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <dl class="detalles">
              <div>
                <dt>{tf.pantalla}</dt>
                <dd>{m.pantalla}</dd>
              </div>
              {!versionPorTemp && (
                <div>
                  <dt>{t.catalogo.iconos.temperatura}</dt>
                  <dd class="temp-fila" data-t={m.temperatura}>
                    <IconoTemp t={m.temperatura} />
                    {may(t.temperatura[m.temperatura])}
                  </dd>
                </div>
              )}
              {rotores.length > 0 && (
                <div>
                  <dt>{tf.rotoresFila}</dt>
                  <dd>
                    {rotores.length} <small>{tiposTexto}</small>
                  </dd>
                </div>
              )}
              {versiones.length > 0 && (
                <div class="refs">
                  <dt>{tf.secciones.referencias}</dt>
                  <dd class="codigos">
                    {versiones.map((v) => (
                      <button
                        type="button"
                        class="copiar"
                        data-copiar={v.codigo}
                        data-pista={tf.copiar}
                        data-hecho={tf.copiado}
                      >
                        {v.codigo}
                      </button>
                    ))}
                    {conIvd && <small>{tf.ivd}</small>}
                  </dd>
                </div>
              )}
            </dl>
          </>
        ) : (
          <ul class="lineas">
            {t.laboratorio.items[p!.slug].datos.split(' · ').map((x) => (
              <li>{x}</li>
            ))}
            <li>
              <span>{tf.versiones.codigo}</span>
              {p!.modelo}
            </li>
          </ul>
        )}

        <div class="botones">
          <a class="btn red" href={pedir}>
            {tf.distribuidor}
          </a>
          {pdf && (
            <a class="btn ghost" href={pdf} target="_blank" rel="noopener">
              {tf.pdf}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {apartados.length > 0 && (
    <>
      <!-- Barra fija: el nombre, los apartados (marca el que se lee) y pedir siempre a mano -->
      <nav class="barra" aria-label={nombre}>
        <div class="wrap barra-in">
          <b class="barra-nombre">{nombre}</b>
          {apartados.length > 1 && (
            <ul>
              {apartados.map((x) => (
                <li>
                  <a href={`#${x.id}`}>{x.nombre}</a>
                </li>
              ))}
            </ul>
          )}
          <a class="btn red barra-pedir" href={pedir}>
            {tf.pedir}
          </a>
        </div>
      </nav>

      {rotores.length > 0 && (
        <section class="apartado compat" id="compatibilidad" aria-labelledby="t-compat">
          <Paso desde="transparent" />
          <div class="wrap">
            <header class="ap-cab">
              <h2 id="t-compat">{tf.secciones.compatibilidad}</h2>
              <p>{tc.intro(rotores.length)}</p>
            </header>

            <div class="elegir" hidden>
              <div class="paso-tubo">
                <p class="paso-t">
                  <span>1</span>
                  {tc.paso1}
                </p>
                <div class="familias" role="group" aria-label={tc.paso1}>
                  {familiasFicha.map(({ f }) => (
                    <button type="button" class="chip" data-fam={f} aria-pressed="false">
                      {t.catalogo.filtros.familiasTubo[f]}
                    </button>
                  ))}
                </div>
              </div>

              <div class="paso-tubo paso-tam" hidden>
                <p class="paso-t">
                  <span>2</span>
                  {tc.paso2}
                </p>
                {familiasFicha.map(({ f, tubos }) => (
                  <div
                    class="tubos"
                    style={`--alto: ${altoFamilia(tubos)}px`}
                    data-fam={f}
                    role="group"
                    aria-label={`${tc.paso2}: ${t.catalogo.filtros.familiasTubo[f]}`}
                    hidden
                  >
                    {tubos.map((x) => {
                      const dib = dibujos.get(x.k);
                      return (
                        <button
                          type="button"
                          class="tubo"
                          data-k={x.k}
                          aria-pressed="false"
                          aria-label={textoOpcion(x)}
                          title={textoOpcion(x)}
                        >
                          {dib && (
                            <span class="tubo-dib" aria-hidden="true">
                              <svg
                                width={(dib.w * 1.12 + 4).toFixed(0)}
                                height={(dib.h + 4).toFixed(0)}
                                viewBox={`${(-dib.w * 0.06 - 2).toFixed(1)} -2 ${(dib.w * 1.12 + 4).toFixed(1)} ${(dib.h + 4).toFixed(1)}`}
                              >
                                <clipPath id={`c-${x.k}`}>
                                  <path d={dib.cuerpo} />
                                </clipPath>
                                <path class="t-cuerpo" d={dib.cuerpo} />
                                <rect
                                  class="t-liquido"
                                  clip-path={`url(#c-${x.k})`}
                                  x="0"
                                  y={dib.nivel.toFixed(1)}
                                  width={dib.w.toFixed(1)}
                                  height={(dib.h - dib.nivel).toFixed(1)}
                                />
                                <path class="t-borde" d={dib.cuerpo} />
                                {dib.tapon && <path class="t-tapon" d={dib.tapon} />}
                              </svg>
                            </span>
                          )}
                          <b>{x.nombre}</b>
                          <small>
                            {x.variantes.length > 1
                              ? tc.medidasN(x.variantes.length)
                              : (medida(lang, x.variantes[0].medidas) ?? '')}
                          </small>
                        </button>
                      );
                    })}
                  </div>
                ))}
                {familiasFicha
                  .filter(({ tubos }) => tubos.some((x) => dibujos.has(x.k)))
                  .map(({ f }) => (
                    <p class="escala" data-fam={f} hidden>
                      {tc.escala}
                    </p>
                  ))}
              </div>
            </div>

            <!-- Lo que sale: nada hasta elegir tubo; luego, solo los rotores que lo admiten -->
            <div class="resultado" hidden>
              <p class="recuento" aria-live="polite" data-admiten={JSON.stringify(admiten)}>
                <span data-elige={tc.elige} data-tam={tc.eligeTam}>
                  {tc.elige}
                </span>
                <button type="button" class="quitar arrow" hidden>
                  {tc.quitar}
                </button>
              </p>
              <ul class="tarjetas">
                {rotores.map((r) => (
                  <li class="rc" data-ks={clavesRotor(r)} hidden>
                    <span class="rc-foto">
                      {r.imagen && (
                        <img src={r.imagen} alt="" width="480" height="480" loading="lazy" decoding="async" />
                      )}
                    </span>
                    <p class="rc-tipo">{tipoRotor(lang, r.tipo)}</p>
                    <h3>{r.nombre}</h3>
                    <ul class="rc-encaja">
                      {r.tubos.map((x) => (
                        <li data-k={kDe(x)} hidden>
                          <span class="cuantos">
                            <b>{tc.tubos(x.posiciones ?? '—')}</b>
                            <span>{tc.porCiclo}</span>
                          </span>
                          {variasDe(kDe(x)) && (
                            <span class="variante">{textoVariante(tuboFicha(x as Tubo & { tipo: string }))}</span>
                          )}
                          {x.reductor ? (
                            <button
                              type="button"
                              class="copiar adaptador"
                              data-copiar={x.reductor}
                              data-pista={tf.copiar}
                              data-hecho={tf.copiado}
                            >
                              {tf.rotores.reductor} {x.reductor}
                            </button>
                          ) : (
                            <em>{tc.sinAdaptador}</em>
                          )}
                        </li>
                      ))}
                    </ul>
                    <p class="rc-cifras">
                      {cifra(lang, r.rpm)} <small>rpm</small> · {cifra(lang, r.xg)} <small>xg</small>
                    </p>
                    {r.noEn && <p class="rc-no">{tf.rotores.noEn(r.noEn.join(', '))}</p>}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Todos los datos, para quien los quiera: cada rotor con su tabla de tubos y adaptadores -->
            <details class="todos">
              <summary>{tc.verTodos(rotores.length)}</summary>
              <div class="todos-lista">
                {rotores.map((r) => (
                  <article class="rt">
                    <header class="rt-cab">
                      <span class="rc-foto">
                        {r.imagen && (
                          <img src={r.imagen} alt="" width="480" height="480" loading="lazy" decoding="async" />
                        )}
                      </span>
                      <div>
                        <p class="rc-tipo">{tipoRotor(lang, r.tipo)}</p>
                        <h3>{r.nombre}</h3>
                      </div>
                      <p class="rt-cifras">
                        <span>
                          {tf.capacidad} <b>{medida(lang, r.capacidad) ?? '—'}</b>
                        </span>
                        <span>
                          {tf.velocidad} <b>{cifra(lang, r.rpm)} rpm</b>
                        </span>
                        <span>
                          {tf.fuerza} <b>{cifra(lang, r.xg)} xg</b>
                        </span>
                        {r.radio && (
                          <span>
                            {tf.rotores.radio} <b>{r.radio} mm</b>
                          </span>
                        )}
                        {r.angulo && (
                          <span>
                            {tf.rotores.angulo} <b>{r.angulo}°</b>
                          </span>
                        )}
                        {r.tempMin && (
                          <span>
                            {tf.rotores.tempMin} <b>{r.tempMin} °C</b>
                          </span>
                        )}
                      </p>
                    </header>
                    {r.noEn && <p class="rc-no">{tf.rotores.noEn(r.noEn.join(', '))}</p>}
                    {r.tubos.length > 0 && (
                      <div class="tabla-scroll">
                        <table>
                          <thead>
                            <tr>
                              <th scope="col">{tf.rotores.posiciones}</th>
                              <th scope="col">{tf.rotores.tubo}</th>
                              <th scope="col">{tf.rotores.capacidadTubo}</th>
                              <th scope="col">{tf.rotores.medidas}</th>
                              <th scope="col">{tf.rotores.reductor}</th>
                            </tr>
                          </thead>
                          <tbody>
                            {r.tubos.map((tb) => (
                              <tr data-k={kDe(tb)}>
                                <td class="num">{tb.posiciones}</td>
                                <td>{may(tipoTubo(lang, tb.tipo) ?? '—')}</td>
                                <td>{medida(lang, tb.capacidad) ?? '—'}</td>
                                <td>{medida(lang, tb.medidas) ?? '—'}</td>
                                <td>{tb.reductor ?? tf.rotores.directo}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </details>
          </div>
        </section>
      )}

      {txt?.descripcion.length || txt?.bloques.length ? (
        <section class="apartado datos-ap" id="datos" aria-labelledby="t-datos">
          <Paso desde="transparent" />
          <div class="wrap datos-in">
            <header class="ap-cab">
              <h2 id="t-datos">{tf.secciones.datos}</h2>
            </header>
            {entrada && (
              <div class="texto">
                <div class="texto-in">
                  {txt!.descripcion.map((d) => (
                    <p>{d}</p>
                  ))}
                </div>
                <button type="button" class="leer arrow" hidden>
                  {tf.leerMas}
                </button>
              </div>
            )}
            {txt?.bloques.length ? (
              <div class="bloques">
                {txt.bloques.map((b, i) => (
                  <details class="bloque" open={i === 0}>
                    <summary>
                      <span>{b.titulo || tf.caracteristicas}</span>
                      <small>{b.puntos.filter((pt) => pt.punto || pt.sub).length || b.puntos.length}</small>
                    </summary>
                    <ul>
                      {b.puntos.map((pt) =>
                        pt.punto || pt.sub ? (
                          <li>
                            {pt.t}
                            {pt.sub && (
                              <ul>
                                {pt.sub.map((s) => (
                                  <li>{s}</li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ) : (
                          <li class="sub-titulo">{pt.t}</li>
                        ),
                      )}
                    </ul>
                  </details>
                ))}
              </div>
            ) : null}
          </div>
        </section>
      ) : null}

      {(versiones.length > 0 || deAccesorios.length > 0) && (
        <section class="apartado refs-ap" id="referencias" aria-labelledby="t-refs">
          <Paso desde="transparent" />
          <div class="wrap">
            <header class="ap-cab">
              <h2 id="t-refs">{tf.secciones.referencias}</h2>
              {versiones.length > 0 && <p>{tf.referencias}</p>}
            </header>
            {versiones.length > 0 && (
              <div class="tabla-scroll tabla-blanca">
                <table class="versiones">
                  <thead>
                    <tr>
                      <th scope="col">{tf.versiones.codigo}</th>
                      {columnas.map((k) => (
                        <th scope="col">{tf.versiones[k]}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {versiones.map((v) => (
                      <tr>
                        <th scope="row">
                          <button
                            type="button"
                            class="copiar"
                            data-copiar={v.codigo}
                            data-pista={tf.copiar}
                            data-hecho={tf.copiado}
                          >
                            {v.codigo}
                          </button>
                          {v.ivd && (
                            <button
                              type="button"
                              class="copiar"
                              data-copiar={v.ivd}
                              data-pista={tf.copiar}
                              data-hecho={tf.copiado}
                            >
                              {v.ivd}
                            </button>
                          )}
                        </th>
                        {columnas.map((k) => (
                          <td>{valor(k, v[k])}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {deAccesorios.length > 0 && (
              <div class="accesorios">
                <h3>{tf.accesorios}</h3>
                <ul class="rejilla dos">
                  {deAccesorios.map((a) => (
                    <li>
                      <Tarjeta cat={t.laboratorio.accesorios} lab={a} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )}
    </>
  )}

  {tres.length > 0 && (
    <section class="mas">
      <div class="wrap">
        <div class="cabeza">
          <h2>
            {completa ? tf.otras[0] : tf.mas} <b>{completa ? tf.otras[1] : cat}</b>
          </h2>
          <a class="arrow" href={ruta(lang, `/centrifugas/?c=${catClave}`)}>
            {tf.volver}
          </a>
        </div>
        <ul class="rejilla">
          {tres.map((x) => (
            <li>
              {'rpm' in x ? (
                <Maquina
                  versiones={[{ m: x, capacidad: capacidadDe(x), fuerza: fuerzaDe(x) }]}
                  uso={t.catalogo.categorias[x.categoria]}
                  frase={textoSerie(lang, x.serie).frase}
                  color={colorDe(x)}
                />
              ) : (
                <Maquina lab={x} uso={cat} frase={t.laboratorio.items[x.slug].frase} color="#8c959b" />
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<script>
  // Galería: cada miniatura enseña su vista; las flechas (del escenario o del teclado) pasan de una a otra
  const escena = document.querySelector<HTMLElement>('.escena');
  const minis = [...document.querySelectorAll<HTMLButtonElement>('.miniaturas .mini')];
  const vistas = [...document.querySelectorAll<HTMLElement>('.escena .vista')];
  const cuenta = document.querySelector<HTMLElement>('.cuenta b');
  const dos = (n: number) => String(n).padStart(2, '0');
  let iVista = 0;
  const verVista = (i: number) => {
    iVista = (i + vistas.length) % vistas.length;
    vistas.forEach((v, j) => (v.hidden = j !== iVista));
    minis.forEach((x, j) => {
      x.setAttribute('aria-selected', String(j === iVista));
      x.tabIndex = j === iVista ? 0 : -1;
    });
    // La miniatura elegida, a la vista en su tira (sin mover la página)
    const mi = minis[iVista];
    if (mi) {
      const tira = mi.parentElement!;
      if (mi.offsetLeft < tira.scrollLeft || mi.offsetLeft + mi.offsetWidth > tira.scrollLeft + tira.clientWidth) {
        tira.scrollTo({ left: mi.offsetLeft - 8, behavior: 'smooth' });
      }
    }
    if (cuenta) cuenta.textContent = dos(iVista + 1);
    escena?.setAttribute('data-vista', vistas[iVista].dataset.tipo!);
  };
  minis.forEach((b, i) => {
    b.addEventListener('click', () => verVista(i));
    b.addEventListener('keydown', (e) => {
      const j = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!j) return;
      verVista(i + j);
      minis[iVista].focus();
    });
  });
  for (const b of document.querySelectorAll<HTMLButtonElement>('.mandos .paso')) {
    b.addEventListener('click', () => verVista(iVista + Number(b.dataset.dir)));
  }
  if (vistas.length) verVista(0);

  // Pantalla completa: solo las fotos (el 3D tiene su propio visor). Clic en la foto para acercar donde se pulsa
  const visor = document.querySelector<HTMLDialogElement>('.visor-foto');
  if (escena && visor) {
    const fotos = vistas.filter((v) => v.dataset.tipo !== '3d');
    const img = visor.querySelector('img')!;
    const pie = visor.querySelector('figcaption b')!;
    const lbCuenta = visor.querySelector('.lb-cuenta')!;
    let iFoto = 0;
    const verFoto = (i: number) => {
      iFoto = (i + fotos.length) % fotos.length;
      const o = fotos[iFoto].querySelector('img')!;
      img.src = o.currentSrc || o.src;
      img.alt = o.alt;
      img.classList.remove('cerca');
      pie.textContent = o.alt;
      lbCuenta.textContent = `${dos(iFoto + 1)} / ${dos(fotos.length)}`;
    };
    const abrir = () => {
      const i = fotos.indexOf(vistas[iVista]);
      if (i < 0) return;
      verFoto(i);
      visor.showModal();
    };
    escena.querySelector('.ampliar')!.addEventListener('click', abrir);
    for (const f of fotos) f.querySelector('img')!.addEventListener('click', abrir);
    for (const b of visor.querySelectorAll<HTMLButtonElement>('.lb-paso')) {
      b.hidden = fotos.length < 2;
      b.addEventListener('click', () => verFoto(iFoto + Number(b.dataset.dir)));
    }
    visor.querySelector('.lb-cerrar')!.addEventListener('click', () => visor.close());
    visor.addEventListener('click', (e) => e.target === visor && visor.close());
    visor.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') verFoto(iFoto + 1);
      if (e.key === 'ArrowLeft') verFoto(iFoto - 1);
    });
    visor.addEventListener('close', () => verVista(vistas.indexOf(fotos[iFoto])));
    img.addEventListener('click', (e) => {
      const r = img.getBoundingClientRect();
      img.style.transformOrigin = `${((e.clientX - r.left) / r.width) * 100}% ${((e.clientY - r.top) / r.height) * 100}%`;
      img.classList.toggle('cerca');
    });
  }

  // Códigos: un clic los copia (para el pedido) y avisa sin moverse de sitio
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copiar]')) {
    const pista = b.dataset.pista!;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copiar!);
        b.dataset.pista = b.dataset.hecho;
        b.classList.add('hecho');
        setTimeout(() => {
          b.dataset.pista = pista;
          b.classList.remove('hecho');
        }, 1600);
      } catch {
        /* sin portapapeles, se queda como texto seleccionable */
      }
    });
  }

  // Compatibilidad: 1, tipo de tubo; 2, su tamaño. Hasta elegir no sale ningún rotor; luego, solo los que lo admiten,
  // con cuántos tubos caben y su adaptador. Pulsar otra vez lo elegido lo quita. Sin JS se ve la lista completa
  const compat = document.querySelector<HTMLElement>('.compat');
  if (compat) {
    const elegir = compat.querySelector<HTMLElement>('.elegir')!;
    const resultado = compat.querySelector<HTMLElement>('.resultado')!;
    const pasoTam = compat.querySelector<HTMLElement>('.paso-tam')!;
    const chips = [...compat.querySelectorAll<HTMLButtonElement>('.chip')];
    const grupos = [...compat.querySelectorAll<HTMLElement>('.paso-tam [data-fam]')];
    const tubos = [...compat.querySelectorAll<HTMLButtonElement>('.tubo')];
    const tarjetas = [...compat.querySelectorAll<HTMLElement>('.rc')];
    const recuento = compat.querySelector<HTMLElement>('.recuento')!;
    const frase = recuento.querySelector<HTMLElement>('span')!;
    const quitar = recuento.querySelector<HTMLButtonElement>('.quitar')!;
    const frases = JSON.parse(recuento.dataset.admiten!) as string[];
    let fam = '';
    let k = '';
    elegir.hidden = false;
    resultado.hidden = false;
    const pintar = () => {
      for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.fam === fam));
      pasoTam.hidden = !fam;
      for (const g of grupos) g.hidden = g.dataset.fam !== fam;
      for (const x of tubos) x.setAttribute('aria-pressed', String(x.dataset.k === k));
      let n = 0;
      for (const r of tarjetas) {
        r.hidden = !k || !r.dataset.ks!.split(' ').includes(k);
        if (!r.hidden) n++;
        for (const li of r.querySelectorAll<HTMLElement>('.rc-encaja li')) li.hidden = li.dataset.k !== k;
      }
      for (const tr of compat.querySelectorAll<HTMLElement>('tr[data-k]')) {
        tr.classList.toggle('marcada', !!k && tr.dataset.k === k);
      }
      frase.textContent = k ? frases[n] : fam ? frase.dataset.tam! : frase.dataset.elige!;
      quitar.hidden = !fam;
      compat.dataset.estado = k ? 'tubo' : fam ? 'familia' : '';
    };
    for (const c of chips) {
      c.addEventListener('click', () => {
        fam = fam === c.dataset.fam ? '' : c.dataset.fam!;
        k = '';
        pintar();
      });
    }
    for (const x of tubos) {
      x.addEventListener('click', () => {
        k = k === x.dataset.k ? '' : x.dataset.k!;
        pintar();
      });
    }
    quitar.addEventListener('click', () => {
      fam = '';
      k = '';
      pintar();
      chips[0]?.focus();
    });
    pintar();
  }

  // Datos técnicos: la descripción, cortada a unas líneas; "Leer más" la abre entera. Sin JS se ve entera
  const texto = document.querySelector<HTMLElement>('.texto');
  if (texto) {
    const leer = texto.querySelector<HTMLButtonElement>('.leer')!;
    const dentro = texto.querySelector<HTMLElement>('.texto-in')!;
    texto.classList.add('corto');
    if (dentro.scrollHeight > dentro.clientHeight + 4) {
      leer.hidden = false;
      leer.addEventListener('click', () => {
        texto.classList.remove('corto');
        leer.hidden = true;
      });
    } else texto.classList.remove('corto');
  }

  // Datos técnicos: en móvil, las características empiezan cerradas para no hacer la página eterna
  if (matchMedia('(max-width: 760px)').matches) {
    for (const d of document.querySelectorAll<HTMLDetailsElement>('.bloque')) d.open = false;
  }

  // Barra: marca el apartado que se está leyendo
  const barra = document.querySelector<HTMLElement>('.barra');
  if (barra) {
    const enlaces = [...barra.querySelectorAll<HTMLAnchorElement>('ul a')];
    const apartados = enlaces.map((a) => document.getElementById(a.hash.slice(1))!);
    let actual = '';
    const marcar = () => {
      const y = innerHeight * 0.35;
      let s: HTMLElement | undefined;
      for (const x of apartados) if (x.getBoundingClientRect().top < y) s = x;
      const id = s?.id ?? '';
      if (id === actual) return;
      actual = id;
      for (const a of enlaces) {
        if (a.hash === `#${id}`) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };
    addEventListener('scroll', marcar, { passive: true });
    addEventListener('resize', marcar);
    marcar();
  }
</script>

