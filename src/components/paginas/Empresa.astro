---
// Empresa: el destino de "Conoce la empresa". Todo el texto sale de la página "Empresa" de ortoalresa.com (en sus
// tres idiomas) y los certificados, de la sección Empresa de la portada. Textos en src/i18n/ (`sobre`).
// · Portada oscura con una centrífuga viva: partículas mezcladas que giran y se separan en capas (las rojas, más
//   pesadas, fuera; las blancas dentro). Al pasar el ratón acelera; al pulsar se mezcla y vuelve a separarse.
// · Historia: una línea baja en curvas al ritmo del scroll y da una vuelta completa a cada hito, como un rotor; al
//   llegar, el punto se enciende y una raya cruza la pantalla. En la punta, el año va contando, y detrás una luz
//   descubre una cuadrícula finísima.
// · Propuesta de valor: la Digtor 22 presentada como una pieza, con hilos de luz hasta cada sistema propio que se
//   encienden por turno; al bajar sube y se endereza, ligada al scroll. Debajo, las cuatro ideas y los valores.
// · Qué nos diferencia: la lista del equipo y de la empresa, y al lado una pantalla que enseña en grande la cifra del
//   punto que se está leyendo (o el que tiene el ratón encima).
// · Calidad: los certificados como fichas de archivador que se despliegan.
// · Compromiso: Empresa Solidaria, LABMAS (9 de cada 10) y los 17 ODS, con los 5 en los que colaboramos.
// · Cierre en rojo, con las dos salidas a toda la anchura.
// Cada título se marca con su barra roja vertical al llegar a la vista, como en el resto de la web.
// Sin JavaScript todo se lee seguido: los hitos en lista, las fichas abiertas y los cinco ODS con su texto.
import Base from '../../layouts/Base.astro';
import Paso from '../Paso.astro';
import { contacto, sellos } from '../../data/navegacion';
import { idioma, ruta, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const s = t.sobre;
const certificados = t.empresa.certificados;
const selloOds = sellos.find((x) => x.clave === 'ods');
const selloSolidaria = sellos.find((x) => x.clave === 'solidaria');

// La historia: cada hito, separado del anterior según los años que pasan (sin que el último quede pegado)
const anioDe = (c: string) => (/^\d{4}$/.test(c) ? Number(c) : null);
const hitos = s.hitos.map((h, i) => {
  const a = anioDe(h.cuando);
  const b = i ? anioDe(s.hitos[i - 1]!.cuando) : null;
  const anios = a !== null && b !== null ? a - b : 0;
  return { ...h, k: i ? (0.8 + Math.min(anios, 60) / 40).toFixed(2) : '0' };
});

// La vitrina: dónde está cada sistema del equipo en la foto de la Digtor 22 (en %) y a qué lado sale su ficha
const enFoto = [
  { x: 55, y: 66, lado: 'der' }, // pantalla TFT
  { x: 34, y: 38, lado: 'izq' }, // freno PCBS: el eje del rotor
  { x: 15, y: 29, lado: 'izq' }, // GRS: la cámara
  { x: 6, y: 37, lado: 'izq' }, // refrigeradas: la pared de la cámara
  { x: 60, y: 46, lado: 'der' }, // calefactadas: el borde de la cámara
  { x: 77, y: 37, lado: 'der' }, // ULS: el rotor cargado
] as const;
const sistemas = s.grupos[0]!.items.map((it, k) => ({ ...it, ...enFoto[k]!, k }));

// Qué nos diferencia: todos los puntos seguidos, cada uno con su grupo
const puntos = s.grupos.flatMap((g) => g.items.map((it) => ({ ...it, grupo: g.nombre })));
const total = String(puntos.length).padStart(2, '0');
const indice = (g: number, k: number) => s.grupos.slice(0, g).reduce((n, x) => n + x.items.length, 0) + k;

// Los 17 ODS de la ONU; los nuestros, con su texto
const ods = Array.from({ length: 17 }, (_, i) => {
  const n = String(i + 1);
  const k = s.objetivos.findIndex((o) => o.n === n);
  return { n, k };
});
---

<Base title={s.title} description={s.description}>
  <div class="emp">
    <!-- ——— Portada ——— -->
    <section class="portada">
      <div class="wrap portada-in">
        <div class="portada-txt">
          <span class="eyebrow">{s.eyebrow}</span>
          <h1>
            {s.titulo[0]}
            <b>{s.titulo[1]}</b>
          </h1>
          <p class="lead">{s.lead}</p>
        </div>
        <div class="escena" data-escena>
          <canvas role="img" aria-label={s.escena}></canvas>
        </div>
      </div>
    </section>

    <!-- ——— Historia: la trayectoria que da una vuelta a cada hito ——— -->
    <section class="historia sec-t" data-historia>
      <Paso desde="transparent" />
      <div class="linterna" aria-hidden="true">
        <div class="l-foco">
          <div class="l-rejilla"></div>
        </div>
      </div>
      <span class="barrido" aria-hidden="true"></span>
      <div class="wrap h-in">
        <header class="cab">
          <span class="eyebrow">{s.historiaEyebrow}</span>
          <h2 class="t">
            {s.historiaTitulo[0]}
            <b>{s.historiaTitulo[1]}</b>
          </h2>
        </header>
        <div class="via" data-via>
          <svg class="trazo" aria-hidden="true">
            <path class="t-medida" />
            <path class="t-linea" />
            <g class="t-nudos"></g>
            <circle class="t-halo" r="11"></circle>
            <circle class="t-punta" r="4.5"></circle>
          </svg>
          <span class="t-anio" aria-hidden="true"></span>
          <ol class="h-hitos">
            {hitos.map((h, i) => (
              <li class={i % 2 ? 'der' : 'izq'} data-cuando={h.cuando} style={`--k: ${h.k}`}>
                <span class="nudo" aria-hidden="true" />
                <div class="h-txt">
                  <span class="cuando">{h.cuando}</span>
                  <h3>{h.titulo}</h3>
                  <p>{h.texto}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ——— Propuesta de valor: texto de revista con un haz de luz detrás ——— -->
    <section class="propuesta sec-t" data-propuesta>
      <Paso desde="transparent" />
      <div class="haz" aria-hidden="true">
        <span></span>
      </div>
      <div class="wrap pr-in">
        <header class="pr-cab">
          <span class="eyebrow">{s.propuestaEyebrow}</span>
          <h2 class="t">
            {s.propuestaTitulo[0]}
            <b>{s.propuestaTitulo[1]}</b>
          </h2>
          <p>
            {s.propuesta[0]}
            <b>{s.propuesta[1]}</b>
          </p>
        </header>
      </div>
      <!-- La centrífuga presentada como una pieza: cada sistema propio, señalado con un hilo de luz -->
      <div class="wrap vitrina" data-vitrina>
        <div class="v-foco" data-v-foco aria-hidden="true"></div>
        <svg class="v-hilos" data-hilos aria-hidden="true"></svg>
        {(['izq', 'der'] as const).map((lado) => (
          <ul class:list={['v-fichas', lado]}>
            {sistemas
              .filter((p) => p.lado === lado)
              .map((p) => (
                <li class="v-ficha" data-ficha={p.k}>
                  <span class="c">
                    {p.cifra}
                    {p.unidad && <small>{p.unidad}</small>}
                  </span>
                  <b>{p.titulo}</b>
                  <p>{p.texto}</p>
                </li>
              ))}
          </ul>
        ))}
        <figure class="v-pieza">
          <img
            src="/img/gama/digtor-22.webp"
            alt={s.vitrinaAlt}
            width="701"
            height="720"
            loading="lazy"
            decoding="async"
          />
          {sistemas.map((p) => (
            <span class="v-punto" style={`--x: ${p.x}%; --y: ${p.y}%`} data-punto={p.k}>
              <i></i>
            </span>
          ))}
          <span class="v-suelo" aria-hidden="true"></span>
        </figure>
      </div>
      <div class="wrap pr-ideas">
        {s.ideas.map((idea) => (
          <div class="idea">
            <span class="i-clave">{idea.clave}</span>
            <h3>{idea.titulo}</h3>
            <p>{idea.texto}</p>
          </div>
        ))}
        <p class="pr-caracter">{s.caracter.map((tramo, k) => (k % 2 ? <b>{tramo}</b> : tramo))}</p>
      </div>
    </section>

    <!-- ——— Qué nos diferencia: la lista y la pantalla ——— -->
    <section class="dif sec-t">
      <Paso desde="transparent" />
      <div class="wrap">
        <header class="cab">
          <span class="eyebrow">{s.difEyebrow}</span>
          <h2 class="t">
            {s.difTitulo[0]}
            <b>{s.difTitulo[1]}</b>
          </h2>
          <p>{s.difLead}</p>
        </header>
        <div class="dif-in" data-dif>
          <div class="pantalla" aria-hidden="true">
            <div class="p-marco" data-p-marco>
              <div class="p-arriba">
                <span data-p-grupo>{puntos[0]!.grupo}</span>
                <span data-p-n>01 / {total}</span>
              </div>
              <div class="p-cifra">
                <b data-p-cifra>{puntos[0]!.cifra}</b>
                <i data-p-unidad>{puntos[0]!.unidad}</i>
              </div>
              <span class="p-titulo" data-p-titulo>
                {puntos[0]!.titulo}
              </span>
              <span class="p-barra">
                <i data-p-barra style={`transform: scaleX(${1 / puntos.length})`}></i>
              </span>
            </div>
          </div>
          <div class="listas">
            {s.grupos.map((g, gi) => (
              <div class="grupo">
                <h3>{g.nombre}</h3>
                <ol>
                  {g.items.map((it, k) => (
                    <li
                      data-item
                      data-cifra={it.cifra}
                      data-unidad={it.unidad}
                      data-titulo={it.titulo}
                      data-grupo={g.nombre}
                      class:list={{ on: indice(gi, k) === 0 }}
                    >
                      <span class="c">
                        {it.cifra}
                        {it.unidad && <small>{it.unidad}</small>}
                      </span>
                      <div>
                        <b>{it.titulo}</b>
                        <p>{it.texto}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ——— Calidad: el archivador ——— -->
    <section class="calidad sec-t">
      <Paso desde="transparent" />
      <div class="wrap">
        <div class="cal-cab">
          <header class="cab">
            <span class="eyebrow">{s.calidadEyebrow}</span>
            <h2 class="t">
              {s.calidadTitulo[0]}
              <b>{s.calidadTitulo[1]}</b>
            </h2>
          </header>
          <div class="cal-txt">
            <p>{s.calidadTexto}</p>
            <a class="arrow" href={ruta(lang, '/descargas/')}>
              {t.nav.descargas}
            </a>
          </div>
        </div>
        <ul class="archivo" data-archivo>
          {certificados.map((c, i) => (
            <li class:list={['ficha', { abierta: i === 0 }]}>
              <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`cert-${i}`}>
                <span class="f-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="f-lomo">{c.nombre}</span>
              </button>
              <div class="f-cuerpo" id={`cert-${i}`}>
                <div class="f-in">
                  <b>{c.nombre}</b>
                  <small>{c.detalle}</small>
                  <p>{c.texto}</p>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ——— Compromiso ——— -->
    <section class="compromiso sec-t">
      <Paso desde="transparent" />
      <div class="wrap">
        <header class="cab">
          <span class="eyebrow">{s.compromisoEyebrow}</span>
          <h2 class="t">
            {s.compromisoTitulo[0]}
            <b>{s.compromisoTitulo[1]}</b>
          </h2>
        </header>
        <div class="pares">
          <article class="par ap">
            <b class="gigante">{s.solidaria.cifra}</b>
            <div class="par-txt">
              {selloSolidaria && (
                <img
                  src={selloSolidaria.src}
                  alt=""
                  width={selloSolidaria.ancho}
                  height={selloSolidaria.alto}
                  loading="lazy"
                />
              )}
              <h3>{s.solidaria.titulo}</h3>
              <p>{s.solidaria.texto}</p>
            </div>
          </article>
          <article class="par ap">
            <b class="gigante">{s.labmas.cifra}</b>
            <div class="par-txt">
              <span class="diez" aria-hidden="true">
                {Array.from({ length: 10 }, (_, i) => (
                  <i class:list={{ lleno: i < 9 }} style={`--i: ${i}`} />
                ))}
              </span>
              <h3>{s.labmas.titulo}</h3>
              <p class="pie">{s.labmas.pie}</p>
              <p>{s.labmas.texto}</p>
            </div>
          </article>
        </div>
        <div class="ods" data-ods>
          <div class="ods-txt">
            <div class="ods-cab">
              {selloOds && (
                <img src={selloOds.src} alt="" width={selloOds.ancho} height={selloOds.alto} loading="lazy" />
              )}
              <div>
                <h3>{s.ods.titulo}</h3>
                <p>{s.ods.texto}</p>
              </div>
            </div>
            <div class="ods-paneles" aria-live="polite">
              {s.objetivos.map((o) => (
                <article data-panel>
                  <span class="n">{o.n}</span>
                  <b>{o.nombre}</b>
                  <p>{o.texto}</p>
                </article>
              ))}
            </div>
          </div>
          <div class="rejilla">
            {ods.map((o) =>
              o.k >= 0 ? (
                <button type="button" class="celda nuestra" data-obj={o.k} aria-pressed={o.k === 0 ? 'true' : 'false'}>
                  {o.n}
                </button>
              ) : (
                <span class="celda" aria-hidden="true">
                  {o.n}
                </span>
              ),
            )}
            <span class="celda marca" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ——— Cierre en rojo ——— -->
    <section class="cierre">
      <div class="wrap cierre-in">
        <h2>
          {s.cierreTitulo[0]}
          <b>{s.cierreTitulo[1]}</b>
        </h2>
        <p>{s.cierreTexto}</p>
        <div class="filas">
          <a class="fila" href={ruta(lang, contacto.href)} data-alta>
            <span>{s.distribuidor}</span>
            <span class="fl" aria-hidden="true">
              »
            </span>
          </a>
          <a class="fila" href={ruta(lang, contacto.href)}>
            <span>{s.contacto}</span>
            <span class="fl" aria-hidden="true">
              »
            </span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const entre = (x: number) => Math.max(0, Math.min(1, x));
  const dos = (n: number) => String(n).padStart(2, '0');

  // Un solo aviso de scroll por fotograma para todo lo que se mueve al bajar
  const alBajar: (() => void)[] = [];
  let pendiente = false;
  const repasar = () => {
    pendiente = false;
    for (const f of alBajar) f();
  };
  const pedir = () => {
    if (!pendiente) {
      pendiente = true;
      requestAnimationFrame(repasar);
    }
  };
  window.addEventListener('scroll', pedir, { passive: true });
  window.addEventListener('resize', pedir);

  // Entradas suaves la primera vez que se ve cada bloque
  const bloques = document.querySelectorAll('.emp .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    bloques.forEach((b) => obs.observe(b));
  }

  // El título de cada sección se marca con su barra roja al llegar a la vista
  if ('IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('.emp .sec-t').forEach((sec) =>
      new IntersectionObserver(([e]) => sec.classList.toggle('actual', !!e?.isIntersecting), {
        rootMargin: '0px 0px -30% 0px',
      }).observe(sec),
    );
  }

  // ——— La centrífuga de la portada ———
  // Cada partícula gira con el rotor y va hacia su capa: las rojas (pesadas) fuera, las grises en medio y las blancas
  // dentro, como la sangre en el tubo. Se dibujan como arcos cortos, más largos cuanto más rápido gira (la estela).
  const escena = document.querySelector<HTMLElement>('[data-escena]');
  const lienzo = escena?.querySelector('canvas');
  const ctx = lienzo?.getContext('2d');
  if (escena && lienzo && ctx) {
    type Particula = {
      ang: number;
      desde: number;
      mezcla: number;
      destino: number;
      k: number;
      tipo: number;
      w: number;
    };
    // Capas por tipo, en fracción del radio: [interior, exterior]
    const capas: [number, number][] = [
      [0.8, 0.95],
      [0.6, 0.76],
      [0.24, 0.56],
    ];
    const colores = ['#dd040a', '#80878d', 'rgba(236, 239, 241, 0.9)'];
    const MEZCLA = 0.8;
    const PAUSA = 0.5;
    const SEPARA = 4.2;

    const azar = (a: number, b: number) => a + Math.random() * (b - a);
    // Radio al azar repartido por la superficie (no se amontonan en el centro)
    const enAnillo = (a: number, b: number) => Math.sqrt(azar(a * a, b * b));
    const suave = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));

    let ps: Particula[] = [];
    const crear = () => {
      const n = window.innerWidth < 860 ? 650 : 1100;
      ps = Array.from({ length: n }, () => {
        const u = Math.random();
        const tipo = u < 0.34 ? 0 : u < 0.58 ? 1 : 2;
        const c = capas[tipo]!;
        const r = enAnillo(0.22, 0.95);
        return {
          ang: Math.random() * Math.PI * 2,
          desde: r,
          mezcla: r,
          destino: enAnillo(c[0], c[1]),
          k: azar(0.75, 1.35),
          tipo,
          w: Math.random() < 0.5 ? 1.4 : 2.4,
        };
      });
    };

    let ancho = 0;
    let alto = 0;
    const medir = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      ancho = lienzo.clientWidth;
      alto = lienzo.clientHeight;
      lienzo.width = Math.round(ancho * dpr);
      lienzo.height = Math.round(alto * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    let t0 = performance.now() / 1000;
    let w = 0;
    let impulso = 1;
    let objetivoImpulso = 1;
    let previo = 0;

    const radio = (p: Particula, t: number) => {
      const tm = t - t0;
      if (tm < MEZCLA) return p.desde + (p.mezcla - p.desde) * suave(tm / MEZCLA);
      const ts = (tm - MEZCLA - PAUSA) * p.k;
      return p.mezcla + (p.destino - p.mezcla) * suave(ts / SEPARA);
    };

    const pintar = (t: number, estela: number) => {
      const cx = ancho / 2;
      const cy = alto / 2;
      const R = Math.min(ancho, alto) * 0.47;
      ctx.clearRect(0, 0, ancho, alto);

      // La cámara: aro fino y la escala
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
      ctx.beginPath();
      ctx.arc(cx, cy, R * 1.02, 0, Math.PI * 2);
      ctx.stroke();
      ctx.beginPath();
      for (let i = 0; i < 120; i++) {
        const a = (i / 120) * Math.PI * 2;
        const l = i % 10 === 0 ? 0.045 : 0.02;
        ctx.moveTo(cx + Math.cos(a) * R * 1.06, cy + Math.sin(a) * R * 1.06);
        ctx.lineTo(cx + Math.cos(a) * R * (1.06 + l), cy + Math.sin(a) * R * (1.06 + l));
      }
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.16)';
      ctx.stroke();
      // La aguja roja arriba
      ctx.strokeStyle = '#dd040a';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(cx, cy - R * 1.06);
      ctx.lineTo(cx, cy - R * 1.15);
      ctx.stroke();

      // Las partículas, en un trazo por color y grosor
      ctx.lineCap = 'round';
      for (let tipo = 0; tipo < 3; tipo++) {
        for (const grosor of [1.4, 2.4]) {
          ctx.beginPath();
          for (const p of ps) {
            if (p.tipo !== tipo || p.w !== grosor) continue;
            const r = radio(p, t) * R;
            const a1 = p.ang;
            const a0 = a1 - estela;
            ctx.moveTo(cx + Math.cos(a0) * r, cy + Math.sin(a0) * r);
            ctx.arc(cx, cy, r, a0, a1);
          }
          ctx.strokeStyle = colores[tipo]!;
          ctx.lineWidth = grosor;
          ctx.stroke();
        }
      }

      // El buje de metal en el centro
      const g = ctx.createRadialGradient(cx - R * 0.03, cy - R * 0.03, 0, cx, cy, R * 0.13);
      g.addColorStop(0, '#d9dde0');
      g.addColorStop(0.55, '#8b9298');
      g.addColorStop(1, '#3a3f44');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 0.12, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = 'rgba(21, 23, 25, 0.5)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 0.06, 0, Math.PI * 2);
      ctx.stroke();
    };

    let reloj = 0;
    let visible = true;
    const vuelta = (ms: number) => {
      const t = ms / 1000;
      const dt = Math.min(t - (previo || t), 0.05);
      previo = t;
      // Arranca despacio, acelera y se queda girando; con el ratón encima, más rápido
      impulso += (objetivoImpulso - impulso) * Math.min(dt * 3, 1);
      const base = 2.6 * suave((t - t0 + (t0 === inicio ? 0 : 3)) / 2.4);
      w = base * impulso;
      for (const p of ps) {
        // Las de dentro, un poco más rápidas: el disco brilla
        const r = radio(p, t);
        p.ang += w * dt * (1 + 0.06 * (1 - r));
      }
      pintar(t, Math.min(0.02 + w * 0.13, 1.1));
      if (visible) reloj = requestAnimationFrame(vuelta);
    };

    const inicio = t0;
    crear();
    medir();
    if (quieto) {
      // Sin movimiento: el resultado ya separado, en puntos
      for (const p of ps) p.mezcla = p.desde = p.destino;
      pintar(t0 + 99, 0.004);
      new ResizeObserver(() => {
        medir();
        pintar(t0 + 99, 0.004);
      }).observe(lienzo);
    } else {
      new ResizeObserver(medir).observe(lienzo);
      const arrancar = () => {
        cancelAnimationFrame(reloj);
        previo = 0;
        reloj = requestAnimationFrame(vuelta);
      };
      new IntersectionObserver(([e]) => {
        visible = !!e?.isIntersecting && !document.hidden;
        if (visible) arrancar();
      }).observe(escena);
      document.addEventListener('visibilitychange', () => {
        visible = !document.hidden;
        if (visible) arrancar();
      });
      escena.addEventListener('pointerenter', () => (objetivoImpulso = 1.7));
      escena.addEventListener('pointerleave', () => (objetivoImpulso = 1));
      // Al pulsar se vuelve a mezclar todo y se separa otra vez
      escena.addEventListener('click', () => {
        const t = performance.now() / 1000;
        for (const p of ps) {
          p.desde = radio(p, t);
          p.mezcla = enAnillo(0.22, 0.95);
        }
        t0 = t;
      });
    }
  }

  // ——— Historia: la línea baja en curvas al ritmo del scroll y da una vuelta a cada hito ———
  const via = document.querySelector<HTMLElement>('[data-via]');
  const svg = via?.querySelector<SVGSVGElement>('.trazo');
  if (via && svg) {
    const NS = 'http://www.w3.org/2000/svg';
    const medida = svg.querySelector<SVGPathElement>('.t-medida')!;
    const linea = svg.querySelector<SVGPathElement>('.t-linea')!;
    const grupo = svg.querySelector<SVGGElement>('.t-nudos')!;
    const punta = svg.querySelector<SVGCircleElement>('.t-punta')!;
    const halo = svg.querySelector<SVGCircleElement>('.t-halo')!;
    const etiqueta = via.querySelector<HTMLElement>('.t-anio');
    const seccion = via.closest<HTMLElement>('[data-historia]')!;
    const linterna = seccion.querySelector<HTMLElement>('.linterna');
    const foco = seccion.querySelector<HTMLElement>('.l-foco');
    const rejilla = seccion.querySelector<HTMLElement>('.l-rejilla');
    const barrido = seccion.querySelector<HTMLElement>('.barrido');
    const hitos = [...via.querySelectorAll<HTMLElement>('.h-hitos > li')];
    // Solo los hitos con año cuentan en la punta
    const anios = hitos.map((li) => {
      const c = li.dataset.cuando ?? '';
      return /^\d{4}$/.test(c) ? Number(c) : null;
    });
    via.classList.add('viva');

    let total = 1;
    let claves: { y: number; l: number }[] = [];
    let llegadas: number[] = [];
    let salidas: number[] = [];
    let pts: { x: number; y: number }[] = [];
    let nudos: SVGGElement[] = [];
    let ultimo = -2;
    let objetivo = 0;
    let ahora = 0;
    let bucle = 0;
    const largo = (d: string) => {
      medida.setAttribute('d', d);
      return medida.getTotalLength();
    };
    const circulo = (cls: string, x: number, y: number, r: number) => {
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('class', cls);
      c.setAttribute('cx', String(x));
      c.setAttribute('cy', String(y));
      c.setAttribute('r', String(r));
      return c;
    };

    const trazar = () => {
      const caja = via.getBoundingClientRect();
      const movil = window.matchMedia('(max-width: 860px)').matches;
      const r = movil ? 13 : 20;
      // Lo que se recorre a cada lado de un hito mientras la línea le da la vuelta: ahí se para
      const pausa = movil ? 56 : 90;
      const lados = hitos.map((li) => li.classList.contains('der'));
      pts = hitos.map((li) => {
        const n = li.querySelector('.nudo')!.getBoundingClientRect();
        return { x: n.left + n.width / 2 - caja.left, y: n.top + n.height / 2 - caja.top };
      });
      const cola = movil ? 56 : 90;
      const alto = Math.ceil(Math.max(caja.height, pts.at(-1)!.y + r + cola + 8));
      svg.setAttribute('viewBox', `0 0 ${caja.width} ${alto}`);
      svg.style.height = `${alto}px`;

      // Cada tramo llega por el lado de dentro del punto, bajando, y da la vuelta entera antes de seguir
      const entradas = pts.map((p, i) => p.x + (movil || lados[i] ? -r : r));
      let x = entradas[0]!;
      let y = 0;
      let d = `M ${x} ${y}`;
      llegadas = [];
      salidas = [];
      claves = [{ y: 0, l: 0 }];
      pts.forEach((p, i) => {
        const ex = entradas[i]!;
        const k = (p.y - y) * 0.55;
        d += ` C ${x} ${y + k} ${ex} ${p.y - k} ${ex} ${p.y}`;
        const a = largo(d);
        const giro = ex < p.x ? 0 : 1;
        d += ` A ${r} ${r} 0 0 ${giro} ${2 * p.x - ex} ${p.y} A ${r} ${r} 0 0 ${giro} ${ex} ${p.y}`;
        const b = largo(d);
        llegadas.push(a);
        salidas.push(b);
        claves.push({ y: p.y - pausa, l: a }, { y: p.y + pausa, l: b });
        x = ex;
        y = p.y;
      });
      d += ` L ${x} ${y + cola}`;
      total = largo(d);
      claves.push({ y: y + cola + pausa, l: total });
      linea.setAttribute('d', d);
      linea.style.strokeDasharray = `${total} ${total}`;

      // Los puntos: el anillo que gira cuando se encienden y la onda del momento en que llega la línea
      grupo.replaceChildren();
      nudos = pts.map((p) => {
        const g = document.createElementNS(NS, 'g');
        g.setAttribute('class', 'nd');
        g.append(circulo('onda', p.x, p.y, 6), circulo('giro', p.x, p.y, r - 6), circulo('punto', p.x, p.y, 5));
        grupo.append(g);
        return g;
      });
      ultimo = -2;
      calcular();
      ahora = objetivo;
      pintar();
    };

    const pintar = () => {
      const l = Math.max(0, Math.min(total, ahora));
      linea.style.strokeDashoffset = String(total - l);
      const p = linea.getPointAtLength(l);
      for (const c of [punta, halo]) {
        c.setAttribute('cx', p.x.toFixed(1));
        c.setAttribute('cy', p.y.toFixed(1));
      }
      const enMarcha = l > 1 && l < total - 1;
      via.classList.toggle('en-marcha', enMarcha);
      // La luz del fondo va con la punta
      // Solo se mueve (sin repintar): el foco va con la punta y la cuadrícula de dentro, al revés, para quedarse quieta
      if (linterna && foco && rejilla) {
        const fx = Math.round(via.offsetLeft + p.x - 300);
        const fy = Math.round(via.offsetTop + p.y - 300);
        foco.style.transform = `translate3d(${fx}px, ${fy}px, 0)`;
        rejilla.style.transform = `translate3d(${-(((fx % 44) + 44) % 44)}px, ${-(((fy % 44) + 44) % 44)}px, 0)`;
        linterna.classList.toggle('on', l > 1);
      }
      let encendido = -1;
      llegadas.forEach((a, i) => {
        const on = l >= a - 1;
        if (on) encendido = i;
        nudos[i]?.classList.toggle('on', on);
        hitos[i]?.classList.toggle('on', on);
      });
      // Al encenderse un hito nuevo, una raya cruza la pantalla a su altura
      if (encendido !== ultimo) {
        const q = pts[encendido];
        if (barrido && q && ultimo > -2 && encendido > ultimo) {
          barrido.style.top = `${(via.offsetTop + q.y).toFixed(0)}px`;
          barrido.style.setProperty('--bx', `${(via.offsetLeft + q.x).toFixed(0)}px`);
          barrido.classList.remove('va');
          void barrido.offsetWidth;
          barrido.classList.add('va');
        }
        ultimo = encendido;
      }
      // El año de la punta cuenta de un hito al siguiente
      if (etiqueta) {
        let anio = anios[0] ?? null;
        for (let i = 1; i < llegadas.length; i++) {
          const desde = salidas[i - 1]!;
          const hasta = llegadas[i]!;
          const a = anios[i - 1] ?? null;
          const b = anios[i] ?? null;
          if (l >= hasta) anio = b;
          else if (l > desde) {
            anio = a !== null && b !== null ? Math.round(a + (b - a) * entre((l - desde) / (hasta - desde))) : null;
          }
        }
        etiqueta.hidden = anio === null;
        if (anio !== null) etiqueta.textContent = String(anio);
        etiqueta.style.transform = `translate(${(p.x + 18).toFixed(1)}px, ${p.y.toFixed(1)}px)`;
      }
    };

    // La punta sigue a una altura fija de la pantalla, con inercia
    const calcular = () => {
      const y = window.innerHeight * 0.58 - via.getBoundingClientRect().top;
      let l = total;
      for (let i = 1; i < claves.length; i++) {
        const a = claves[i - 1]!;
        const b = claves[i]!;
        if (y < b.y) {
          l = a.l + (b.l - a.l) * entre((y - a.y) / Math.max(1, b.y - a.y));
          break;
        }
      }
      objetivo = quieto ? total : l;
      if (!bucle && !quieto) bucle = requestAnimationFrame(paso);
    };
    const paso = () => {
      ahora += (objetivo - ahora) * 0.07;
      if (Math.abs(objetivo - ahora) < 0.5) ahora = objetivo;
      pintar();
      bucle = ahora === objetivo ? 0 : requestAnimationFrame(paso);
    };

    trazar();
    new ResizeObserver(trazar).observe(via);
    void document.fonts.ready.then(trazar);
    if (!quieto) alBajar.push(calcular);
  }

  // ——— Propuesta: el haz de luz solo se mueve mientras se ve ———
  const propuesta = document.querySelector<HTMLElement>('[data-propuesta]');
  if (propuesta) {
    new IntersectionObserver(([e]) => propuesta.classList.toggle('a-la-vista', !!e?.isIntersecting)).observe(propuesta);
  }

  // ——— Propuesta: la vitrina. Los hilos van de cada ficha a su punto; se encienden por turno mientras se ve, o el que
  // tiene el ratón o el foco; la luz de detrás se va al punto encendido (solo transform) ———
  const vitrina = document.querySelector<HTMLElement>('[data-vitrina]');
  if (vitrina) {
    const hilos = vitrina.querySelector<SVGSVGElement>('[data-hilos]')!;
    const foco = vitrina.querySelector<HTMLElement>('[data-v-foco]')!;
    const fichas = [...vitrina.querySelectorAll<HTMLElement>('[data-ficha]')];
    const puntos = [...vitrina.querySelectorAll<HTMLElement>('[data-punto]')];
    const ns = 'http://www.w3.org/2000/svg';
    const de = (k: number) => fichas.find((f) => f.dataset.ficha === String(k))!;
    const lineas = puntos.map(() => {
      const g = document.createElementNS(ns, 'g');
      for (const c of ['h-base', 'h-luz']) {
        const p = document.createElementNS(ns, 'path');
        p.setAttribute('class', c);
        p.setAttribute('pathLength', '1');
        g.append(p);
      }
      hilos.append(g);
      return g;
    });
    let actual = 0;
    const centro = (el: Element) => {
      const r = el.getBoundingClientRect();
      const v = vitrina.getBoundingClientRect();
      return { x: r.left + r.width / 2 - v.left, y: r.top + r.height / 2 - v.top };
    };
    const mover = () => {
      const { x, y } = centro(puntos[actual]!);
      foco.style.transform = `translate3d(${Math.round(x - 300)}px, ${Math.round(y - 300)}px, 0)`;
    };
    const trazarVitrina = () => {
      const v = vitrina.getBoundingClientRect();
      hilos.setAttribute('viewBox', `0 0 ${v.width} ${v.height}`);
      puntos.forEach((pt, k) => {
        const f = de(k).querySelector('b')!.getBoundingClientRect();
        const izq = de(k).closest('.izq') !== null;
        const ax = (izq ? f.right + 14 : f.left - 14) - v.left;
        const ay = f.top + f.height / 2 - v.top;
        const { x, y } = centro(pt);
        const codo = ax + (izq ? 28 : -28);
        for (const p of lineas[k]!.children) p.setAttribute('d', `M ${ax} ${ay} H ${codo} L ${x} ${y}`);
      });
      mover();
    };
    const poner = (k: number) => {
      actual = k;
      fichas.forEach((el) => el.classList.toggle('on', el.dataset.ficha === String(k)));
      puntos.forEach((el, j) => el.classList.toggle('on', j === k));
      lineas.forEach((g, j) => g.classList.toggle('on', j === k));
      mover();
    };
    let parado = false;
    let visible = false;
    let reloj = 0;
    const ciclo = () => {
      window.clearInterval(reloj);
      if (quieto || parado || !visible) return;
      reloj = window.setInterval(() => poner((actual + 1) % puntos.length), 3800);
    };
    const elegir = (k: number) => () => {
      parado = true;
      poner(k);
      ciclo();
    };
    fichas.forEach((f) => {
      const k = Number(f.dataset.ficha);
      f.addEventListener('pointerenter', elegir(k));
      f.addEventListener('focus', elegir(k));
      f.addEventListener('click', elegir(k));
    });
    puntos.forEach((p, k) => p.addEventListener('pointerenter', elegir(k)));
    vitrina.addEventListener('pointerleave', () => {
      parado = false;
      ciclo();
    });
    new IntersectionObserver(
      ([e]) => {
        visible = !!e?.isIntersecting;
        if (visible) vitrina.classList.add('encendida');
        vitrina.classList.toggle('a-la-vista', visible);
        ciclo();
      },
      { threshold: 0.25 },
    ).observe(vitrina);
    vitrina.classList.add('viva');
    trazarVitrina();
    new ResizeObserver(trazarVitrina).observe(vitrina);
    void document.fonts.ready.then(trazarVitrina);
    vitrina.querySelector('img')?.addEventListener('load', trazarVitrina);
    poner(0);
  }

  // ——— Qué nos diferencia: la pantalla enseña el punto que se lee o el que tiene el ratón encima ———
  const dif = document.querySelector<HTMLElement>('[data-dif]');
  if (dif) {
    const items = [...dif.querySelectorAll<HTMLElement>('[data-item]')];
    const campo = (k: string) => dif.querySelector<HTMLElement>(`[data-p-${k}]`);
    const marco = campo('marco');
    const grupo = campo('grupo');
    const num = campo('n');
    const cifra = campo('cifra');
    const unidad = campo('unidad');
    const titulo = campo('titulo');
    const barra = campo('barra');
    let actual = 0;
    let encima = false;
    let cuenta = 0;

    const poner = (i: number) => {
      if (i === actual) return;
      actual = i;
      const d = items[i]!.dataset;
      items.forEach((li, k) => li.classList.toggle('on', k === i));
      if (grupo) grupo.textContent = d.grupo ?? '';
      if (num) num.textContent = `${dos(i + 1)} / ${dos(items.length)}`;
      if (titulo) titulo.textContent = d.titulo ?? '';
      if (unidad) unidad.textContent = d.unidad ?? '';
      if (barra) barra.style.transform = `scaleX(${(i + 1) / items.length})`;
      const c = d.cifra ?? '';
      cancelAnimationFrame(cuenta);
      // Las cifras cuentan desde cero, como el display al arrancar
      if (cifra && /^\d+$/.test(c) && !quieto) {
        const fin = Number(c);
        const t0 = performance.now();
        const paso = (t: number) => {
          const x = entre((t - t0) / 650);
          cifra.textContent = String(Math.round(fin * (1 - Math.pow(1 - x, 3))));
          if (x < 1) cuenta = requestAnimationFrame(paso);
        };
        cuenta = requestAnimationFrame(paso);
      } else if (cifra) cifra.textContent = c;
      if (marco && !quieto) {
        marco.classList.remove('entra');
        void marco.offsetWidth;
        marco.classList.add('entra');
      }
    };
    const calcular = () => {
      if (encima) return;
      const y = window.innerHeight * 0.5;
      let k = 0;
      items.forEach((li, j) => {
        if (li.getBoundingClientRect().top < y) k = j;
      });
      poner(k);
    };
    items.forEach((li, k) =>
      li.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        encima = true;
        poner(k);
      }),
    );
    dif.addEventListener('pointerleave', () => {
      encima = false;
      calcular();
    });
    alBajar.push(calcular);
    calcular();
  }

  // ——— Calidad: una ficha abierta; se abre al pulsar o, con ratón y en ancho, al pasar por encima ———
  const archivo = document.querySelector<HTMLElement>('[data-archivo]');
  if (archivo) {
    const fichas = [...archivo.children] as HTMLElement[];
    const ancho = window.matchMedia('(min-width: 861px)');
    archivo.classList.add('viva');
    const abrir = (i: number) =>
      fichas.forEach((f, k) => {
        f.classList.toggle('abierta', k === i);
        f.querySelector('button')?.setAttribute('aria-expanded', String(k === i));
      });
    fichas.forEach((f, k) => {
      f.querySelector('button')?.addEventListener('click', () => abrir(k));
      f.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && ancho.matches) abrir(k);
      });
    });
  }

  // ——— Compromiso: los 17 ODS; al elegir uno de los nuestros se lee su texto ———
  const odsEl = document.querySelector<HTMLElement>('[data-ods]');
  if (odsEl) {
    const botones = [...odsEl.querySelectorAll<HTMLButtonElement>('[data-obj]')];
    const paneles = [...odsEl.querySelectorAll<HTMLElement>('[data-panel]')];
    odsEl.classList.add('viva');
    const elegir = (i: number) => {
      botones.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.obj) === i)));
      paneles.forEach((p, k) => (p.hidden = k !== i));
    };
    botones.forEach((b) => {
      const k = Number(b.dataset.obj);
      b.addEventListener('click', () => elegir(k));
      b.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && elegir(k));
    });
    elegir(0);
  }
</script>

<style>
  .emp {
    background: #fff;
  }
  /* Cada sección lleva arriba la raya roja con destello (Paso) */
  .emp .sec-t {
    position: relative;
  }
  .cab h2,
  .cierre h2 {
    margin-top: 18px;
    font-weight: 300;
    font-size: clamp(36px, 4.6vw, 64px);
    line-height: 0.98;
  }
  .cab h2 b {
    font-weight: 700;
    color: var(--red);
  }
  .cab > p {
    max-width: 58ch;
    margin-top: 18px;
    color: var(--body);
    font-size: clamp(17px, 1.3vw, 20px);
  }
  /* La sección que se está leyendo: una barra roja junto al título, en el margen, que crece al llegar */
  .t {
    position: relative;
  }
  .t::before {
    content: '';
    position: absolute;
    top: 0.12em;
    bottom: 0.12em;
    left: calc(-1 * clamp(10px, 1.4vw, 22px));
    width: 4px;
    background: var(--red);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-4) var(--ease-out);
  }
  .actual .t::before {
    transform: scaleY(1);
  }

  /* ——— Portada: carbono con la centrífuga viva a la derecha ——— */
  .portada {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 74% 50%, rgba(255, 255, 255, 0.05), transparent 46%),
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px) 0 0 / 32px 32px,
      var(--carbon);
    color: #fff;
  }
  .portada-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    min-height: min(calc(100vh - 88px), 780px);
    padding-block: clamp(48px, 6vw, 88px);
  }
  .portada .eyebrow {
    color: var(--on-dark);
  }
  h1 {
    margin-top: 22px;
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.93;
  }
  /* El rojo de marca en negrita, como en la portada de Productos */
  h1 b {
    display: block;
    font-weight: 700;
    color: var(--red);
    text-shadow: 0 0 28px rgba(221, 4, 10, 0.28);
  }
  .lead {
    max-width: 46ch;
    margin-top: 22px;
    color: var(--on-dark);
    font-size: var(--t-sub);
  }
  .escena {
    position: relative;
    width: 100%;
    max-width: 680px;
    justify-self: end;
    aspect-ratio: 1;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .escena canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ——— Historia: la trayectoria ——— */
  .historia {
    overflow: clip;
    background: #fff;
  }
  .h-in {
    padding-block: clamp(72px, 9vw, 128px);
  }
  .via {
    position: relative;
    max-width: 1040px;
    margin: clamp(48px, 6vw, 80px) auto 0;
  }
  .h-hitos {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Cada hito, a un lado de la línea; la separación crece con los años que pasan */
  .h-hitos li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px minmax(0, 1fr);
    align-items: start;
    margin-top: calc(var(--k) * clamp(64px, 8vw, 128px));
  }
  .h-txt {
    grid-row: 1;
    max-width: 38ch;
  }
  .izq .h-txt {
    grid-column: 1;
    justify-self: end;
    text-align: right;
  }
  .der .h-txt {
    grid-column: 3;
  }
  .nudo {
    grid-row: 1;
    grid-column: 2;
    width: 12px;
    height: 20px;
    background: var(--red);
    background-clip: content-box;
    padding-block: 4px;
  }
  .izq .nudo {
    justify-self: start;
    margin-left: 44px;
  }
  .der .nudo {
    justify-self: end;
    margin-right: 44px;
  }
  .cuando {
    display: block;
    color: var(--red);
    font-weight: 700;
    font-size: 15px;
    line-height: 20px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color var(--dur-3) var(--ease);
  }
  .h-hitos h3 {
    margin-top: 8px;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.1;
  }
  .h-hitos p {
    margin-top: 10px;
    color: var(--body);
    font-size: 17px;
  }
  .t-anio,
  .trazo {
    display: none;
  }

  /* Con JS: la línea se dibuja al bajar */
  .via.viva {
    padding-bottom: 96px;
  }
  .viva .trazo {
    display: block;
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .viva .nudo {
    visibility: hidden;
  }
  .t-medida {
    fill: none;
    stroke: none;
  }
  .t-linea {
    fill: none;
    stroke: var(--red);
    stroke-width: 2;
    stroke-linecap: round;
  }
  /* El fondo: una cuadrícula finísima que solo se ve donde alumbra la punta de la línea */
  .historia {
    position: relative;
  }
  .historia > .wrap {
    position: relative;
  }
  .linterna {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1s var(--ease);
  }
  .l-foco {
    position: absolute;
    top: 0;
    left: 0;
    width: 600px;
    height: 600px;
    overflow: hidden;
    background: radial-gradient(circle 220px at 50% 50%, rgba(221, 4, 10, 0.07), transparent);
    mask-image: radial-gradient(circle 300px at 50% 50%, #000, rgba(0, 0, 0, 0.35) 45%, transparent);
    will-change: transform;
  }
  .l-rejilla {
    position: absolute;
    inset: -44px;
    background-image:
      linear-gradient(to right, rgba(20, 20, 20, 0.09) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(20, 20, 20, 0.09) 1px, transparent 1px);
    background-size: 44px 44px;
    will-change: transform;
  }
  .linterna.on {
    opacity: 1;
  }
  /* Al llegar a un hito, una raya roja cruza la pantalla a su altura, desde el punto hacia los dos lados */
  .barrido {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--red);
    opacity: 0;
    transform-origin: var(--bx, 50%) 0;
    pointer-events: none;
  }
  .barrido.va {
    animation: barrido 1.3s var(--ease-out);
  }
  @keyframes barrido {
    from {
      opacity: 0.9;
      transform: scaleX(0);
    }
    to {
      opacity: 0;
      transform: scaleX(1);
    }
  }
  .viva .t-anio[hidden] {
    display: none;
  }
  @keyframes rotor {
    to {
      transform: rotate(1turn);
    }
  }
  /* Los puntos se crean desde el script: van con :global */
  .via :global(.nd .punto) {
    fill: #fff;
    stroke: var(--muted);
    stroke-width: 1.5;
    transition:
      fill var(--dur-3) var(--ease),
      stroke var(--dur-3) var(--ease);
  }
  .via :global(.nd.on .punto) {
    fill: var(--red);
    stroke: var(--red);
    filter: drop-shadow(0 0 6px rgba(221, 4, 10, 0.55));
  }
  .via :global(.nd .giro) {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.5;
    stroke-dasharray: 10 6;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity var(--dur-3) var(--ease);
  }
  .via :global(.nd.on .giro) {
    opacity: 0.55;
  }
  .via :global(.nd .onda) {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .via :global(.nd.on .onda) {
    animation: onda 1.4s var(--ease-out);
  }
  @keyframes onda {
    from {
      opacity: 0.7;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(7);
    }
  }
  .t-punta,
  .t-halo {
    fill: var(--red);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease);
  }
  .en-marcha .t-punta {
    opacity: 1;
  }
  .en-marcha .t-halo {
    opacity: 0.16;
  }
  /* El año que va contando en la punta */
  .viva .t-anio {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    translate: 0 -50%;
    padding: 2px 6px;
    background: #fff;
    color: var(--red);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease);
  }
  .en-marcha .t-anio {
    opacity: 1;
  }
  /* El hito espera en gris hasta que llega la línea */
  .viva .h-txt {
    opacity: 0.28;
    translate: 0 10px;
    transition:
      opacity var(--dur-4) var(--ease),
      translate var(--dur-4) var(--ease-out);
  }
  .viva li:not(.on) .cuando {
    color: var(--muted);
  }
  .viva li.on .h-txt {
    opacity: 1;
    translate: none;
  }

  /* ——— Propuesta: oscura, texto de revista; detrás, un haz de luz recto que cruza en diagonal y se mece despacio
     (solo transform: no repinta) ——— */
  .propuesta {
    overflow: clip;
    padding-block: clamp(80px, 9vw, 128px);
    background: var(--carbon);
    color: #fff;
  }
  .haz {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .haz span {
    position: absolute;
    top: 38%;
    left: -25%;
    width: 150%;
    height: 280px;
    margin-top: -140px;
    background: radial-gradient(
      ellipse 50% 50% at 50% 50%,
      rgba(221, 4, 10, 0.3),
      rgba(221, 4, 10, 0.07) 45%,
      transparent 70%
    );
    transform: rotate(-11deg);
    will-change: transform;
  }
  /* El filo del haz: una línea fina y brillante, blanca en el centro */
  .haz span::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 12%;
    right: 12%;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 82, 87, 0.8) 30%,
      #fff 50%,
      rgba(255, 82, 87, 0.8) 70%,
      transparent
    );
    box-shadow: 0 0 14px rgba(221, 4, 10, 0.9);
  }
  @media (prefers-reduced-motion: no-preference) {
    .propuesta.a-la-vista .haz span {
      animation: mece 16s ease-in-out infinite alternate;
    }
  }
  @keyframes mece {
    to {
      transform: translateY(70px) rotate(-6deg);
    }
  }
  /* La cabecera, centrada */
  .pr-in {
    position: relative;
    text-align: center;
  }
  .pr-cab {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pr-cab .eyebrow {
    color: var(--on-dark);
  }
  .pr-cab h2 {
    margin-top: 16px;
    font-weight: 300;
    font-size: clamp(28px, 2.8vw, 40px);
    line-height: 1.05;
  }
  .pr-cab h2 b {
    font-weight: 700;
    color: var(--red-on-dark);
  }
  .pr-cab p {
    max-width: 52ch;
    margin: 18px auto 0;
    color: var(--on-dark);
    font-size: clamp(16px, 1.2vw, 18px);
  }
  .pr-cab p b {
    color: #fff;
  }
  /* Las ideas, en dos columnas a toda la anchura: cada una bajo una raya fina que se enciende en rojo neón */
  .pr-ideas {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(48px, 6vw, 88px) clamp(40px, 7vw, 120px);
  }
  .idea {
    position: relative;
    padding-top: 28px;
    border-top: 1px solid var(--carbon-line);
  }
  .idea::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--red), var(--red) 60%, transparent);
    box-shadow: 0 0 14px rgba(221, 4, 10, 0.6);
    transform: scaleX(0.18);
    transform-origin: left;
    transition: transform 0.9s var(--ease);
  }
  .idea:hover::before {
    transform: scaleX(1);
  }
  .i-clave {
    color: var(--red-on-dark);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .idea h3 {
    margin-top: 12px;
    color: #fff;
    font-weight: 300;
    font-size: clamp(26px, 2.4vw, 36px);
    line-height: 1.1;
  }
  .idea p {
    max-width: 46ch;
    margin-top: 14px;
    color: var(--on-dark);
    font-size: 17px;
    line-height: 1.6;
  }
  /* Los valores, en una frase grande que cierra la sección */
  .pr-caracter {
    grid-column: 1 / -1;
    max-width: 32ch;
    margin-top: clamp(24px, 4vw, 56px);
    color: var(--steel);
    font-weight: 300;
    font-size: clamp(28px, 3.2vw, 48px);
    line-height: 1.2;
  }
  .pr-caracter b {
    color: #fff;
    font-weight: 700;
  }
  /* Al bajar, todo entra ligado al scroll (solo transform y opacidad): la centrífuga sube y se endereza como una
     pieza que se presenta, el suelo de luz se abre, las ideas suben con su raya y los valores se encienden */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .v-pieza img,
      .v-suelo,
      .v-punto,
      .idea,
      .idea::before,
      .pr-caracter b {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
      }
      .v-pieza {
        perspective: 1200px;
      }
      .v-pieza img {
        animation-name: emerge;
        animation-range: entry 0% cover 45%;
      }
      .v-suelo {
        animation-name: abre;
        animation-range: entry 20% cover 45%;
      }
      .v-punto {
        animation-name: asoma;
        animation-range: cover 38% cover 48%;
      }
      .idea {
        animation-name: sube;
        animation-range: entry 0% cover 30%;
      }
      .idea::before {
        animation-name: raya;
        animation-range: entry 40% cover 40%;
      }
      .idea:hover::before {
        animation: none;
      }
      .pr-caracter b {
        animation-name: aviva;
        animation-range: entry 60% cover 50%;
      }
    }
  }
  @keyframes emerge {
    from {
      opacity: 0;
      transform: translateY(120px) rotateX(24deg) scale(0.8);
    }
  }
  @keyframes abre {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes asoma {
    from {
      opacity: 0;
      scale: 0.4;
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      translate: 0 64px;
    }
  }
  @keyframes raya {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes aviva {
    from {
      color: var(--steel);
    }
  }

  /* La vitrina: la centrífuga en el centro, sobre un suelo de luz, y sus sistemas a los lados unidos con hilos */
  .vitrina {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    margin-block: clamp(64px, 8vw, 112px);
  }
  .v-fichas {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(28px, 3vw, 44px);
    list-style: none;
  }
  .v-fichas.izq {
    grid-column: 1;
    grid-row: 1;
    text-align: right;
  }
  .v-fichas.der {
    grid-column: 3;
    grid-row: 1;
  }
  .v-ficha {
    cursor: default;
    outline: none;
    transition:
      opacity 0.6s var(--ease),
      translate 0.6s var(--ease);
  }
  .v-ficha .c {
    display: block;
    color: var(--steel);
    font-weight: 300;
    font-size: clamp(30px, 2.6vw, 40px);
    line-height: 1;
    transition: color var(--dur-2) var(--ease);
  }
  .v-ficha small {
    margin-left: 4px;
    font-size: 0.45em;
  }
  .v-ficha b {
    display: inline-block;
    margin-top: 6px;
    color: #fff;
    font-size: 17px;
  }
  .v-ficha p {
    max-width: 34ch;
    margin-top: 6px;
    color: var(--on-dark);
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.55;
    transition: opacity var(--dur-2) var(--ease);
  }
  .izq .v-ficha p {
    margin-left: auto;
  }
  .v-ficha.on .c {
    color: var(--red-on-dark);
  }
  .v-ficha.on p {
    opacity: 1;
  }
  .v-pieza {
    position: relative;
    z-index: 1;
    grid-column: 2;
    grid-row: 1;
    margin: 0;
  }
  .v-pieza img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* El suelo: una raya de luz bajo la pieza, como la de los pasos entre secciones */
  .v-suelo {
    position: absolute;
    left: -12%;
    right: -12%;
    bottom: -14px;
    height: 2px;
    overflow: hidden;
    background: linear-gradient(90deg, transparent, var(--red) 25%, var(--red) 75%, transparent);
    box-shadow: 0 0 22px rgba(221, 4, 10, 0.7);
  }
  .v-suelo::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 22%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
    translate: -120% 0;
  }
  .v-punto {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(221, 4, 10, 0.85);
    transition: scale 0.4s var(--ease);
  }
  .v-punto i {
    position: absolute;
    inset: -10px;
    border: 1.5px solid var(--red-on-dark);
    border-radius: 50%;
    opacity: 0;
  }
  .v-punto.on {
    scale: 1.25;
  }
  /* La luz de detrás: va al punto encendido */
  .v-foco {
    position: absolute;
    top: 0;
    left: 0;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(221, 4, 10, 0.32), rgba(221, 4, 10, 0.08) 40%, transparent 68%);
    pointer-events: none;
    will-change: transform;
    transition: transform 1.1s var(--ease);
  }
  .v-hilos {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .v-hilos :global(path) {
    fill: none;
    stroke-width: 1.5;
  }
  .v-hilos :global(.h-base) {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 1.2s var(--ease),
      stroke 0.4s var(--ease);
  }
  .v-hilos :global(.on .h-base) {
    stroke: var(--red-on-dark);
  }
  .v-hilos :global(.h-luz) {
    stroke: #fff;
    stroke-width: 2;
    stroke-dasharray: 0.12 1;
    stroke-dashoffset: 0.12;
    opacity: 0;
  }
  .encendida .v-hilos :global(.h-base) {
    stroke-dashoffset: 0;
  }
  /* Sin JS las fichas se leen igual; con JS entran al encenderse la vitrina */
  .viva:not(.encendida) .v-ficha {
    opacity: 0;
    translate: 0 16px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .a-la-vista .v-hilos :global(.on .h-luz) {
      opacity: 1;
      animation: hilo 1.6s var(--ease) infinite;
    }
    .a-la-vista .v-punto.on i {
      animation: aviso 1.6s var(--ease) infinite;
    }
    .a-la-vista .v-suelo::after {
      animation: recorre-suelo 5s var(--ease) infinite;
    }
  }
  @keyframes hilo {
    to {
      stroke-dashoffset: -1;
    }
  }
  @keyframes aviso {
    from {
      opacity: 1;
      scale: 0.6;
    }
    to {
      opacity: 0;
      scale: 1.6;
    }
  }
  @keyframes recorre-suelo {
    0% {
      translate: -120% 0;
    }
    45%,
    100% {
      translate: 560% 0;
    }
  }

  /* ——— Qué nos diferencia: carbono, la lista a la derecha y la pantalla fija a la izquierda ——— */
  .dif {
    padding-block: clamp(80px, 10vw, 140px);
    background: var(--carbon);
    color: #fff;
  }
  .dif .eyebrow,
  .dif .cab > p {
    color: var(--on-dark);
  }
  .dif-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(32px, 5vw, 88px);
    margin-top: clamp(48px, 6vw, 88px);
  }
  .pantalla {
    position: sticky;
    top: calc(var(--cabecera, 72px) + 32px);
  }
  .p-marco {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 24px;
    min-height: min(56svh, 480px);
    padding: clamp(24px, 2.4vw, 36px);
    border: 1px solid var(--carbon-line);
    background:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px) 0 0 / 100% 6px,
      #0e1011;
  }
  /* Las cuatro esquinas marcadas, como el visor de un equipo */
  .p-marco::before,
  .p-marco::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid var(--red);
  }
  .p-marco::before {
    top: -1px;
    left: -1px;
    border-right: 0;
    border-bottom: 0;
  }
  .p-marco::after {
    right: -1px;
    bottom: -1px;
    border-left: 0;
    border-top: 0;
  }
  .p-arriba {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--steel);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .p-cifra {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 14px;
  }
  .p-cifra b {
    font-weight: 300;
    font-size: clamp(96px, 11vw, 176px);
    line-height: 0.85;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .p-cifra i {
    color: var(--red);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(28px, 2.8vw, 44px);
  }
  .p-titulo {
    font-weight: 700;
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.1;
  }
  .p-barra {
    display: block;
    height: 2px;
    background: var(--carbon-line);
  }
  .p-barra i {
    display: block;
    height: 100%;
    background: var(--red);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .p-marco.entra :is(.p-titulo, .p-cifra i) {
    animation: sube 0.5s var(--ease-out) both;
  }
  .grupo + .grupo {
    margin-top: clamp(48px, 5vw, 72px);
  }
  .grupo h3 {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--carbon-line);
    color: var(--steel);
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .grupo ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .grupo li {
    position: relative;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 20px;
    padding: 22px 0 22px 20px;
    border-bottom: 1px solid var(--carbon-line);
    color: var(--steel);
    transition: color var(--dur-2) var(--ease);
  }
  .grupo li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 22px;
    bottom: 22px;
    width: 3px;
    background: var(--red);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .grupo li.on {
    color: #fff;
  }
  .grupo li.on::before {
    transform: scaleY(1);
  }
  .grupo .c {
    font-weight: 700;
    font-size: 22px;
    line-height: 1.1;
    transition: color var(--dur-2) var(--ease);
  }
  .grupo .c small {
    margin-left: 4px;
    font-size: 15px;
  }
