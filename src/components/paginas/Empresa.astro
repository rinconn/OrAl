    padding: 0;
    list-style: none;
  }
  .e-texto .c {
    display: block;
    color: var(--steel);
    font-weight: 300;
    font-size: clamp(44px, 4.4vw, 72px);
    line-height: 0.95;
    transition: color var(--dur-2) var(--ease);
  }
  .e-texto small {
    margin-left: 6px;
    font-size: 0.36em;
  }
  .e-texto p {
    max-width: 30ch;
    margin-top: 14px;
    color: rgba(255, 255, 255, 0.5);
    font-size: clamp(19px, 1.55vw, 24px);
    line-height: 1.3;
  }
  .e-texto b {
    color: #fff;
  }
  .e-lead p {
    margin-top: 0;
    color: var(--on-dark);
  }
  /* Con JS los textos se apilan en el mismo sitio y entra el que toca */
  .vivo .e-textos {
    gap: 0;
  }
  .vivo .e-texto {
    grid-area: 1 / 1;
    opacity: 0;
    translate: 0 18px;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease),
      translate 0.7s var(--ease),
      visibility 0s 0.45s;
  }
  .vivo .e-texto.on {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
    transition-delay: 0.12s, 0.12s, 0s;
  }
  .rayos .e-texto.on .c {
    color: #fff;
  }
  .e-lienzo {
    display: none;
  }
  .vivo .e-lienzo {
    position: relative;
    display: block;
    align-self: stretch;
    min-height: 0;
    margin-inline: clamp(-140px, -7vw, -40px);
  }
  /* La línea vertical que atraviesa la escena; mientras carga el modelo se llena de rojo de arriba abajo */
  .e-lienzo::before,
  .e-carga {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: rgba(255, 255, 255, 0.12);
    opacity: var(--sal, 0);
  }
  .e-carga {
    background: var(--red);
    opacity: 1;
    transform: scaleY(var(--v, 0));
    transform-origin: top;
    transition:
      transform 0.3s linear,
      opacity 0.6s var(--ease);
  }
  .listo .e-carga {
    opacity: 0;
  }
  .e-lienzo :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  .listo .e-lienzo :global(canvas) {
    opacity: 1;
  }
  /* El punto sobre la pieza encendida y las etiquetas de la anatomía: un punto con su código y su nombre */
  .e-punto,
  .e-parte {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    pointer-events: none;
    will-change: transform;
  }
  .e-punto > *,
  .e-parte > * {
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .e-punto.on > *,
  .e-parte.on > * {
    opacity: 1;
  }
  /* En la anatomía las etiquetas salen una tras otra */
  .e-parte > *,
  .e-parte::before {
    transition-delay: calc(var(--i, 0) * 90ms);
  }
  .e-punto i,
  .e-parte i {
    position: absolute;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(221, 4, 10, 0.6);
  }
  .e-punto i::after {
    content: '';
    position: absolute;
    inset: -10px;
    border: 1px solid rgba(255, 82, 87, 0.8);
    border-radius: 50%;
  }
  .e-punto b {
    position: absolute;
    top: -11px;
    left: 18px;
    padding: 3px 9px;
    border-left: 1px solid var(--red);
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 12px;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .e-parte i {
    background: #bfeaff;
    box-shadow: 0 0 0 3px rgba(58, 159, 214, 0.45);
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
  }
  /* La etiqueta sale con una raya fina, a la derecha o a la izquierda por turnos */
  .e-parte b,
  .e-parte span {
    position: absolute;
    left: 44px;
    white-space: nowrap;
  }
  .e-parte b {
    top: -18px;
    color: #7cc0e6;
    font-size: 11px;
    letter-spacing: 0.12em;
  }
  .e-parte span {
    top: -2px;
    color: #fff;
    font-size: 15px;
  }
  .e-parte::before {
    content: '';
    position: absolute;
    top: 0;
    left: 8px;
    width: 30px;
    height: 1px;
    background: rgba(124, 192, 230, 0.6);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }
  .e-parte.on::before {
    transform: scaleX(1);
  }
  .e-parte:nth-of-type(odd) b,
  .e-parte:nth-of-type(odd) span {
    right: 44px;
    left: auto;
    text-align: right;
  }
  .e-parte:nth-of-type(odd)::before {
    right: 8px;
    left: auto;
    transform-origin: right;
  }
  @media (prefers-reduced-motion: no-preference) {
    .e-punto.on i::after {
      animation: aviso 1.8s var(--ease) infinite;
    }
  }
  .e-lista {
    display: none;
  }
  .vivo .e-lista {
    position: relative;
    z-index: 2;
    display: grid;
    padding: 0;
    list-style: none;
  }
  .e-lista button {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: baseline;
    width: 100%;
    padding: 16px 0 18px;
    border: 0;
    background: none;
    color: rgba(255, 255, 255, 0.38);
    font: inherit;
    font-size: 17px;
    text-align: left;
    cursor: pointer;
    transition: color var(--dur-2) var(--ease);
  }
  .e-lista button:hover,
  .e-lista button.on {
    color: #fff;
  }
  .e-lista button:focus-visible {
    color: #fff;
    outline: var(--foco);
    outline-offset: 4px;
  }
  .e-lista .c {
    color: var(--steel);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-2) var(--ease);
  }
  .e-lista button.on .c {
    color: var(--red-on-dark);
  }
  .e-lista small {
    margin-left: 3px;
    font-size: 0.8em;
  }
  /* Cada raya se llena con su tramo de scroll (solo transform) */
  .e-raya {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.14);
  }
  .e-raya i {
    position: absolute;
    inset: 0;
    background: var(--red);
    transform: scaleX(var(--lleno, 0));
    transform-origin: left;
  }
  .e-pie {
    display: none;
  }
  .vivo .e-pie {
    position: absolute;
    bottom: 28px;
    left: 50%;
    display: block;
    color: var(--steel);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    translate: -50% 0;
  }
  /* Saltar el recorrido: abajo a la derecha, solo dentro del tramo; la » apunta hacia donde lleva */
  .e-saltar {
    display: none;
  }
  .vivo .e-saltar,
  .viva .e-saltar {
    position: absolute;
    right: max(var(--gut), calc((100% - var(--wrap)) / 2 + var(--gut)));
    bottom: 20px;
    z-index: 3;
    display: inline-flex;
    gap: 10px;
    align-items: center;
    padding: 9px 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(21, 23, 25, 0.7);
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    translate: 0 8px;
    transition:
      opacity var(--dur-2) var(--ease),
      translate var(--dur-2) var(--ease),
      visibility 0s var(--dur-2),
      border-color var(--dur-2) var(--ease);
  }
  .vivo .e-saltar.on,
  .viva .e-saltar.on {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-delay: 0s;
  }
  .e-saltar:hover {
    border-color: var(--red-on-dark);
  }
  .e-saltar:focus-visible {
    outline: var(--foco);
  }
  .e-saltar i {
    color: var(--red-on-dark);
    font-style: normal;
    font-size: 18px;
    line-height: 1;
    rotate: 90deg;
    transition: rotate var(--dur-2) var(--ease);
  }
  .e-saltar.arriba i {
    rotate: -90deg;
  }
  @keyframes aviso {
    from {
      opacity: 1;
      scale: 0.6;
    }
    to {
      opacity: 0;
      scale: 1.8;
    }
  }

  /* Las ideas: tres paneles en fila; el abierto (el último que tuvo el ratón o el foco) se ensancha y enseña su
     texto con una raya roja encima. Sin JS, o en móvil, se leen todas en rejilla */
  .pr-ideas {
    margin-top: clamp(56px, 7vw, 96px);
    scroll-margin-top: 96px;
  }
  .ideas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px clamp(32px, 4vw, 64px);
    padding: 0;
    list-style: none;
  }
  .idea {
    position: relative;
    padding-top: 22px;
    border-top: 1px solid var(--carbon-line);
    outline: none;
  }
  .i-n {
    color: var(--steel);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }
  .i-clave {
    margin-left: 12px;
    color: var(--red-on-dark);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .idea h3 {
    margin-top: 14px;
    color: #fff;
    font-weight: 300;
    font-size: clamp(24px, 2.1vw, 32px);
    line-height: 1.1;
  }
  .idea p {
    max-width: 40ch;
    margin-top: 12px;
    color: var(--on-dark);
    font-size: 16px;
    line-height: 1.55;
  }
  .idea h3 button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .idea h3 button:focus-visible {
    outline: var(--foco);
    outline-offset: 4px;
  }
  .i-raya {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--red);
    box-shadow: 0 0 14px rgba(221, 4, 10, 0.6);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease);
  }
  @media (min-width: 861px) {
    .ideas.viva {
      display: flex;
      gap: 0;
      height: clamp(300px, 25vw, 340px);
      border-bottom: 1px solid var(--carbon-line);
    }
    .viva .idea {
      display: flex;
      flex: 1 1 0;
      flex-direction: column;
      min-width: 0;
      padding: 26px clamp(20px, 2vw, 32px) 30px;
      border-left: 1px solid var(--carbon-line);
      overflow: hidden;
      cursor: default;
      transition:
        flex-grow 0.7s var(--ease),
        background 0.5s var(--ease);
    }
    .viva .idea:first-child {
      border-left: 0;
    }
    .viva .idea h3 {
      margin-top: auto;
      transition: color var(--dur-2) var(--ease);
    }
    .viva .idea:not(.abierta) h3 {
      color: rgba(255, 255, 255, 0.55);
    }
    /* El texto tiene ancho fijo: no se recoloca mientras el panel crece */
    .viva .idea p {
      width: 38ch;
      max-width: none;
      max-height: 0;
      margin-top: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        max-height 0.6s var(--ease),
        margin 0.6s var(--ease),
        opacity 0.4s var(--ease);
    }
    .viva .idea.abierta {
      flex-grow: 2.5;
      background: rgba(255, 255, 255, 0.025);
    }
    .viva .idea.abierta p {
      max-height: 9em;
      margin-top: 14px;
      opacity: 1;
      transition-delay: 0.15s;
    }
    .viva .idea.abierta .i-raya {
      transform: scaleX(1);
    }
    .viva .idea h3 button:focus-visible {
      outline: none;
    }
    .viva .idea:has(:focus-visible) {
      outline: var(--foco);
      outline-offset: -2px;
    }
  }

  /* Los valores, en una cinta a todo el ancho que corre sola, en grande y separados por »: una palabra en negrita y
     la siguiente ligera. Se para con el ratón encima; sin movimiento, se leen seguidos */
  .valores {
    margin-top: clamp(56px, 7vw, 96px);
  }
  .v-tit {
    display: block;
    color: var(--steel);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .v-cinta {
    display: flex;
    overflow: hidden;
    margin: 20px calc(50% - 50vw) 0;
    padding-block: clamp(12px, 1.2vw, 18px);
    border-block: 1px solid rgba(255, 255, 255, 0.12);
  }
  .v-pista {
    display: flex;
    flex: none;
    padding: 0;
    list-style: none;
  }
  .v-pista li {
    color: #fff;
    font-weight: 700;
    font-size: clamp(26px, 3.2vw, 48px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease);
  }
  .v-pista li:nth-child(even) {
    color: var(--on-dark);
    font-weight: 300;
  }
  .v-pista li::after {
    content: '»';
    margin-inline: 0.32em;
    color: var(--red-on-dark);
    font-weight: 700;
  }
  .v-pista li:hover {
    color: var(--red-on-dark);
  }
  @media (prefers-reduced-motion: no-preference) {
    .v-pista {
      animation: cinta 64s linear infinite;
    }
    .v-cinta:hover .v-pista {
      animation-play-state: paused;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v-cinta {
      flex-wrap: wrap;
      margin-inline: 0;
    }
    .v-pista[aria-hidden],
    .v-pista .rep {
      display: none;
    }
    .v-pista {
      flex-wrap: wrap;
    }
  }
  @keyframes cinta {
    to {
      translate: -100% 0;
    }
  }
  /* Al bajar, las ideas suben (ligado al scroll; solo opacidad y transform) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .idea {
        animation: sube linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
    }
  }

  /* ——— Qué nos diferencia: en oscuro, con el aro de luz a la derecha; una diapositiva cada vez ——— */
  .dif {
    overflow: clip;
    padding-block: clamp(96px, 11vw, 160px) clamp(80px, 9vw, 128px);
    background: #0b0b0c;
    color: #fff;
  }
  .dif .wrap {
    position: relative;
    z-index: 1;
  }
  /* La cabecera en dos columnas: el título a la izquierda y la entradilla a la derecha */
  .dif .cab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'ceja texto'
      'titulo texto';
    column-gap: clamp(32px, 6vw, 96px);
    justify-items: start;
  }
  .dif .cab .eyebrow {
    grid-area: ceja;
  }
  .dif .cab h2 {
    grid-area: titulo;
  }
  .dif .cab > p {
    grid-area: texto;
    align-self: start;
    max-width: 44ch;
    margin-top: 28px;
    color: rgb(255 255 255 / 0.62);
  }
  @media (max-width: 860px) {
    .dif .cab {
      display: block;
    }
    .dif .cab > p {
      margin-top: 18px;
    }
  }
  /* El aro: una línea fina y blanca donde más brilla, roja en la cola, con su halo; gira un paso por diapositiva */
  .haz {
    position: absolute;
    top: 50%;
    right: clamp(-380px, -18vw, -120px);
    width: clamp(560px, 64vw, 1040px);
    aspect-ratio: 1;
    pointer-events: none;
    translate: var(--mx, 0px) calc(-50% + var(--my, 0px));
    transition: translate 1.4s var(--ease-out);
  }
  /* Debajo, el aro entero en rojo tenue con un brillo que da la vuelta sin parar: nunca se apaga del todo */
  .haz i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
    background: conic-gradient(
      rgb(221 4 10 / 0.22) 0deg,
      rgb(255 60 66 / 0.75) 40deg,
      rgb(221 4 10 / 0.22) 90deg 360deg
    );
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    animation: h-vuelta 14s linear infinite;
  }
  .encendida .haz i {
    opacity: 1;
  }
  @keyframes h-vuelta {
    to {
      rotate: -1turn;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .haz i {
      animation: none;
    }
  }
  .haz span {
    position: absolute;
    inset: 0;
    rotate: calc(var(--giro, 0deg) - 40deg);
    opacity: 0;
    transition:
      rotate 1.6s var(--ease-out),
      opacity 1.2s var(--ease);
  }
  .encendida .haz span {
    rotate: var(--giro, 0deg);
    opacity: 1;
  }
  .haz span::before,
  .haz span::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: conic-gradient(
      from 170deg,
      rgb(221 4 10 / 0) 0deg,
      rgb(221 4 10 / 0.35) 70deg,
      #e8141a 140deg,
      #ff6b6f 172deg,
      #fff 186deg,
      #ff8a8d 196deg,
      rgb(221 4 10 / 0) 230deg
    );
  }
  .haz span::before {
    inset: 0;
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
  }
  .haz span::after {
    inset: -9%;
    opacity: 0.75;
    mask: radial-gradient(farthest-side, transparent 62%, rgb(0 0 0 / 0.5) 86%, #000 91.7%, transparent 100%);
  }
  .haz.pulso span::after {
    animation: h-pulso 1.6s var(--ease-out);
  }
  @keyframes h-pulso {
    30% {
      opacity: 1;
    }
  }
  /* Sin JavaScript, las once seguidas */
  .sel {
    margin-top: clamp(48px, 6vw, 88px);
  }
  .s-ficha + .s-ficha {
    margin-top: 56px;
  }
  .sel:not(.viva) .s-pie {
    display: none;
  }
  /* Con JavaScript, todas en la misma celda: el alto es el de la más larga y nada salta al cambiar */
  .viva .s-fichas {
    display: grid;
    touch-action: pan-y;
  }
  .viva .s-ficha {
    grid-area: 1 / 1;
    margin: 0;
    visibility: hidden;
  }
  .viva .s-ficha.on,
  .viva .s-ficha.sale {
    visibility: visible;
  }
  .viva .s-ficha.sale {
    animation: s-sale 0.45s var(--ease) forwards;
  }
  .s-ficha {
    max-width: 760px;
  }
  .s-meta {
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }
  .s-cifra {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 18px;
    margin: clamp(18px, 2.4vw, 32px) 0 clamp(18px, 2.4vw, 30px);
    line-height: 0.85;
  }
  .s-cifra b {
    font-weight: 300;
    font-size: clamp(104px, 14vw, 224px);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .s-cifra small {
    color: var(--red-on-dark);
    font-weight: 700;
    font-size: clamp(22px, 2.2vw, 34px);
  }
  .s-ficha h3 {
    max-width: 22ch;
    font-size: clamp(30px, 3.4vw, 52px);
    line-height: 1.02;
  }
  .s-txt {
    max-width: 50ch;
    margin-top: 16px;
    color: rgb(255 255 255 / 0.62);
    font-size: clamp(17px, 1.3vw, 20px);
  }
  /* Al llegar: la cifra sube desde detrás de una línea y el resto entra desde el lado hacia el que se avanza */
  .viva .s-ficha.on .s-meta {
    animation: s-entra 0.7s var(--ease-out) both;
  }
  .viva .s-ficha.on .s-cifra b {
    animation: s-sube 0.9s 0.05s var(--ease-out) both;
  }
  .viva .s-ficha.on .s-cifra small {
    animation: s-entra 0.7s 0.25s var(--ease-out) both;
  }
  .viva .s-ficha.on h3 {
    animation: s-entra 0.8s 0.14s var(--ease-out) both;
  }
  .viva .s-ficha.on .s-txt {
    animation: s-entra 0.8s 0.24s var(--ease-out) both;
  }
  @keyframes s-sube {
    from {
