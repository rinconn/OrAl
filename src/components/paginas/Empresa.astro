---
// Empresa: el destino de "Conoce la empresa". Todo el texto sale de la página "Empresa" de ortoalresa.com (en sus
// tres idiomas) y los certificados, de la sección Empresa de la portada. Textos en src/i18n/ (`sobre`).
// · Portada oscura con una centrífuga viva: partículas mezcladas que giran y se separan en capas (las rojas, más
//   pesadas, fuera; las blancas dentro). Al pasar el ratón acelera; al pulsar se mezcla y vuelve a separarse.
// · Historia: la pantalla se queda fija y una cámara muy cerca sigue la punta de una línea en garabatos; en cada punto,
//   un hito con su texto. Entre hitos se aleja un poco y vuelve a acercarse; al final se aleja del todo y se ve el
//   dibujo entero con sus cinco marcas.
// · Propuesta de valor: el título enorme y, delante, una caja con la marca que se abre; la Digicen 22 sube girando, una
//   lámina de luz la pasa a rayos X, se separa en piezas con su nombre y la cámara va de un sistema propio a otro, con
//   su pieza encendida en rojo. Debajo, las tres ideas en paneles que se abren y los valores en una línea.
// · Qué nos diferencia: diapositivas en oscuro bajo un aro de luz roja, como el rotor de una centrífuga: gira un
//   paso con cada una. Pasan solas mientras se ven (once tramos marcan el tiempo), se paran fuera de pantalla y se
//   mueven con las flechas, el teclado, los tramos o deslizando. Sin JavaScript, las once seguidas.
// · Calidad: una pieza clara y redondeada. Los tres ISO grandes con su PDF (es/en, los de Descargas), con su PDF;
//   debajo, una tira con el resto de normas y marcados.
// · Compromiso: en su propio componente (Compromiso.astro), con los indicadores de impacto y los ODS.
// Cada título se marca con su barra roja vertical al llegar a la vista, como en el resto de la web.
// Sin JavaScript todo se lee seguido: los hitos en lista.
import Base from '../../layouts/Base.astro';
import Paso from '../Paso.astro';
import Compromiso from '../Compromiso.astro';
import { generales, peso } from '../../data/descargas';
import { idioma, ruta, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const s = t.sobre;

// Calidad: los ISO, con su PDF de Descargas ("ISO 9001" → "iso-9001"); el resto, en lista
const certificados = t.empresa.certificados;
const iso = certificados
  .filter((c) => c.nombre.startsWith('ISO'))
  .map((c) => {
    const pdf = generales.find((g) => g.id === c.nombre.toLowerCase().replace(' ', '-'))?.pdf ?? {};
    const pdfs = (['es', 'en'] as const).flatMap((l) =>
      pdf[l] ? [{ l, url: pdf[l]!.url, peso: peso(pdf[l]!.bytes, t.meta.fechas) }] : [],
    );
    return { ...c, pdfs };
  });
// Iconos de la marca (public/img/iconos), pintados en rojo con máscara
const icono: Record<string, string> = {
  'ISO 9001': 'ico-tabla',
  'ISO 13485': 'centrifuge',
  'ISO 14001': 'medioambiente',
  IVDR: 'ico-tubos',
  CE: 'sobre-nosotros',
  'EN 61010': 'ico-seguridad',
  RoHS: 'ico-info',
  RAEE: 'settings-cycle',
  KC: 'pack',
};
const icoBajar = 'M12 4v11M7 10l5 5 5-5M5 20h14';
const normas = certificados.filter((c) => !c.nombre.startsWith('ISO'));

// El escáner: los sistemas del equipo, en orden; dónde va cada uno en la Digicen 22, en src/scripts/escena-escaner.ts
const sistemas = s.grupos[0]!.items.map((it, k) => ({ ...it, k }));
const dos = (n: number) => String(n).padStart(2, '0');

// Qué nos diferencia: las once en fila, con su grupo
const fichas = s.grupos.flatMap((g) => g.items.map((it) => ({ ...it, grupo: g.nombre })));
---

<Base title={s.title} description={s.description}>
  <div class="emp">
    <!-- ——— Portada ——— -->
    <section class="portada">
      <div class="wrap portada-in">
        <div class="portada-txt">
          <span class="eyebrow">{s.eyebrow}</span>
          <h1>
            {s.titulo[0]}
            <b>{s.titulo[1]}</b>
          </h1>
          <p class="lead">{s.lead}</p>
        </div>
        <div class="escena" data-escena>
          <canvas role="img" aria-label={s.escena}></canvas>
        </div>
      </div>
    </section>

    <!-- ——— Historia: la trayectoria que da una vuelta a cada hito ——— -->
    <section class="historia sec-t" data-historia>
      <Paso desde="transparent" />
      <div class="wrap h-in">
        <header class="cab">
          <span class="eyebrow">{s.historiaEyebrow}</span>
          <h2 class="t">
            {s.historiaTitulo[0]}
            <b>{s.historiaTitulo[1]}</b>
          </h2>
        </header>
      </div>
      <div class="viaje" data-viaje>
        <div class="escenario">
          <div class="rejilla" aria-hidden="true"></div>
          <svg class="mundo" aria-hidden="true">
            <g class="m-cam">
              <g class="m-fantasmas"></g>
              <path class="m-cola" />
              <path class="m-linea" />
              <path class="m-nucleo" />
              <g class="m-nudos"></g>
              <circle class="m-punta" r="5"></circle>
            </g>
          </svg>
          <ol class="h-hitos">
            {s.hitos.map((h, i) => (
              <li class={i % 2 ? 'der' : 'izq'} data-cuando={h.cuando}>
                <span class="cuando">{h.cuando}</span>
                <h3>{h.titulo}</h3>
                <p>{h.texto}</p>
              </li>
            ))}
          </ol>
          <!-- Como en el escáner: saltar el recorrido hacia abajo o, si viene de abajo, hacia arriba -->
          <button
            type="button"
            class="e-saltar"
            data-h-saltar
            data-bajar={s.escaner.saltar}
            data-subir={s.escaner.subir}
          >
            <span data-h-saltar-txt>{s.escaner.saltar}</span>
            <i aria-hidden="true">»</i>
          </button>
        </div>
      </div>
    </section>

    <!-- ——— Propuesta de valor: la Digicen 22 sale de su caja y pasa por el escáner; debajo, las ideas y los valores ——— -->
    <section class="propuesta sec-t">
      <Paso desde="transparent" />
      <div
        class="escaner"
        data-escaner
        data-src="/3d/digicen22.glb"
        data-draco="/3d/draco/"
        style={`--n: ${sistemas.length}`}
      >
        <div class="e-fijo">
          <!-- El título, enorme y detrás de la máquina; al abrirse la caja se aparta -->
          <header class="e-titulo">
            <span class="eyebrow">{s.propuestaEyebrow}</span>
            <h2>
              <span class="l">
                <span>{s.propuestaTitulo[0]}</span>
              </span>
              <span class="l">
                <b>{s.propuestaTitulo[1]}</b>
              </span>
            </h2>
          </header>
          <div class="wrap e-in">
            <div class="e-izq">
              <div class="e-estado" aria-hidden="true">
                <span class="e-chip">
                  <i></i>
                  <span data-e-modo data-real={s.escaner.real} data-rayos={s.escaner.rayos}>
                    {s.escaner.real}
                  </span>
                </span>
                <span class="e-n" data-e-n>
                  00 / {dos(sistemas.length)}
                </span>
              </div>
              <ol class="e-textos">
                <li class="e-texto e-lead" data-e-texto>
                  <p>
                    {s.propuesta[0]}
                    <b>{s.propuesta[1]}</b>
                  </p>
                </li>
                {sistemas.map((p) => (
                  <li class="e-texto" data-e-texto>
                    <span class="c">
                      {p.cifra}
                      {p.unidad && <small>{p.unidad}</small>}
                    </span>
                    <p>
                      <b>{p.titulo}</b> {p.texto}
                    </p>
                  </li>
                ))}
              </ol>
            </div>
            <div class="e-lienzo" data-e-lienzo aria-hidden="true">
              <span class="e-carga" data-e-carga></span>
              <span class="e-punto" data-e-punto>
                <i></i>
                <b data-e-codigo></b>
              </span>
              {s.escaner.partes.map((x, i) => (
                <span class="e-parte" data-e-parte={x.codigo} data-nombre={x.nombre} style={`--i: ${i}`}>
                  <i></i>
                  <b>{x.codigo}</b>
                  <span>{x.nombre}</span>
                </span>
              ))}
            </div>
            <ul class="e-lista">
              {sistemas.map((p) => (
                <li>
                  <button type="button" data-e-ir={p.k}>
                    <span class="e-raya">
                      <i></i>
                    </span>
                    <b>{p.titulo}</b>
                    <span class="c">
                      {p.cifra}
                      {p.unidad && <small>{p.unidad}</small>}
                    </span>
                  </button>
                </li>
              ))}
            </ul>
            <span class="e-pie">{s.escaner.modelo}</span>
          </div>
          <!-- Para quien ya lo ha visto: saltar el recorrido hacia abajo o, si viene de abajo, hacia arriba -->
          <button
            type="button"
            class="e-saltar"
            data-e-saltar
            data-bajar={s.escaner.saltar}
            data-subir={s.escaner.subir}
          >
            <span data-e-saltar-txt>{s.escaner.saltar}</span>
            <i aria-hidden="true">»</i>
          </button>
        </div>
      </div>
      <!-- Las tres ideas en un acordeón de paneles; los valores, en una cinta que corre de lado a lado -->
      <div class="wrap pr-ideas">
        <ol class="ideas" data-ideas>
          {s.ideas.map((idea, i) => (
            <li class:list={['idea', { abierta: i === 0 }]}>
              <span class="i-n">{dos(i + 1)}</span>
              <span class="i-clave">{idea.clave}</span>
              <h3>
                <button type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                  {idea.titulo}
                </button>
              </h3>
              <p>{idea.texto}</p>
              <span class="i-raya" aria-hidden="true"></span>
            </li>
          ))}
        </ol>
        <div class="valores">
          <span class="v-tit">{s.valoresTitulo}</span>
          <div class="v-cinta">
            {/* Cada pista lleva los valores dos veces: con un número par, negrita y ligera alternan también en la unión */}
            {[0, 1].map((copia) => (
              <ul class="v-pista" aria-hidden={copia ? 'true' : undefined}>
                {[0, 1].map((vuelta) =>
                  s.caracter
                    .filter((_, k) => k % 2)
                    .map((v) => (
                      <li class:list={{ rep: vuelta }} aria-hidden={vuelta ? 'true' : undefined}>
                        {v}
                      </li>
                    )),
                )}
              </ul>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ——— Qué nos diferencia: diapositivas bajo el aro de luz ——— -->
    <section class="dif sec-t" data-dif-sec>
      <Paso desde="var(--carbon)" />
      <div class="haz" aria-hidden="true" data-haz>
        <i></i>
        <span></span>
      </div>
      <div class="wrap">
        <header class="cab">
          <span class="eyebrow">{s.difEyebrow}</span>
          <h2 class="t">
            {s.difTitulo[0]}
            <b>{s.difTitulo[1]}</b>
          </h2>
          <p>{s.difLead}</p>
        </header>
        <div class="sel" data-dif>
          <div class="s-fichas" aria-live="polite">
            {fichas.map((it, i) => (
              <article class:list={['s-ficha', { on: i === 0 }]} data-ficha>
                <p class="s-meta arrow">{it.grupo}</p>
                <p class="s-cifra">
                  <b data-cifra={it.cifra}>{it.cifra}</b>
                  {it.unidad && <small>{it.unidad}</small>}
                </p>
                <h3>{it.titulo}</h3>
                <p class="s-txt">{it.texto}</p>
              </article>
            ))}
          </div>
          <div class="s-pie">
            <div class="s-tramos" aria-hidden="true">
              {fichas.map((it) => (
                <span data-tramo title={it.titulo}>
                  <i />
                </span>
              ))}
            </div>
            <div class="s-nav">
              <button type="button" class="s-flecha s-atras" data-mueve="-1" aria-label={s.difAnterior}>
                <span />
              </button>
              <p class="s-cuenta" aria-hidden="true">
                <span class="s-rueda">
                  <span data-cuenta>01</span>
                </span>
                <i>/</i>
                {dos(fichas.length)}
              </p>
              <button type="button" class="s-flecha" data-mueve="1" aria-label={s.difSiguiente}>
                <span />
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ——— Calidad: los ISO y las normas ——— -->
    <section class="calidad sec-t">
      <Paso desde="transparent" />
      <div class="wrap">
        <div class="cal-cab">
          <header class="cab">
            <span class="eyebrow">{s.calidadEyebrow}</span>
            <h2 class="t">
              {s.calidadTitulo[0]}
              <b>{s.calidadTitulo[1]}</b>
            </h2>
          </header>
          <div class="cal-txt">
            <p>{s.calidadTexto}</p>
            <a class="arrow" href={ruta(lang, '/descargas/')}>
              {t.nav.descargas}
            </a>
          </div>
        </div>
        <div class="cert">
          <ul class="isos">
            {iso.map((c) => (
              <li>
                <i class="ic" style={`--ic: url(/img/iconos/${icono[c.nombre]}.svg)`} aria-hidden="true" />
                <b>{c.nombre}</b>
                <small>{c.detalle}</small>
                <p>{c.texto}</p>
                <span class="pdf">
                  {c.pdfs.map((p) => (
                    <a
                      href={p.url}
                      target="_blank"
                      rel="noopener"
                      hreflang={p.l}
                      aria-label={`${c.nombre} · PDF · ${t.descargas.idiomas[p.l]} · ${p.peso}`}
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d={icoBajar} />
                      </svg>
                      {p.l.toUpperCase()}
                    </a>
                  ))}
                </span>
              </li>
            ))}
          </ul>
          <ul class="normas">
            {normas.map((c) => (
              <li>
                <i class="ic" style={`--ic: url(/img/iconos/${icono[c.nombre]}.svg)`} aria-hidden="true" />
                <b>{c.nombre}</b>
                <small>{c.detalle}</small>
                <span>{c.texto}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <Compromiso />
  </div>
</Base>

<script>
  import type { Escaner } from '../../scripts/escena-escaner';
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const entre = (x: number) => Math.max(0, Math.min(1, x));
  const dos = (n: number) => String(n).padStart(2, '0');
  // Los saltos son inmediatos (con scroll suave se vería todo el recorrido igualmente)
  const irSinSuavizar = (top: number) => {
    const raiz = document.documentElement;
    raiz.style.scrollBehavior = 'auto';
    window.scrollTo({ top });
    raiz.style.scrollBehavior = '';
  };

  // Un solo aviso de scroll por fotograma para todo lo que se mueve al bajar
  const alBajar: (() => void)[] = [];
  let pendiente = false;
  const repasar = () => {
    pendiente = false;
    for (const f of alBajar) f();
  };
  const pedir = () => {
    if (!pendiente) {
      pendiente = true;
      requestAnimationFrame(repasar);
    }
  };
  window.addEventListener('scroll', pedir, { passive: true });
  window.addEventListener('resize', pedir);

  // Entradas suaves la primera vez que se ve cada bloque
  const bloques = document.querySelectorAll('.emp .ap');
  if (bloques.length && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const obs = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('vista');
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    bloques.forEach((b) => obs.observe(b));
  }

  // El título de cada sección se marca con su barra roja al llegar a la vista
  if ('IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('.emp .sec-t').forEach((sec) =>
      new IntersectionObserver(([e]) => sec.classList.toggle('actual', !!e?.isIntersecting), {
        rootMargin: '0px 0px -30% 0px',
      }).observe(sec),
    );
  }

  // ——— La centrífuga de la portada ———
  // Cada partícula gira con el rotor y va hacia su capa: las rojas (pesadas) fuera, las grises en medio y las blancas
  // dentro, como la sangre en el tubo. Se dibujan como arcos cortos, más largos cuanto más rápido gira (la estela).
  const escena = document.querySelector<HTMLElement>('[data-escena]');
  const lienzo = escena?.querySelector('canvas');
  const ctx = lienzo?.getContext('2d');
  if (escena && lienzo && ctx) {
    type Particula = {
      ang: number;
      desde: number;
      mezcla: number;
      destino: number;
      k: number;
      tipo: number;
      w: number;
    };
    // Capas por tipo, en fracción del radio: [interior, exterior]
    const capas: [number, number][] = [
      [0.8, 0.95],
      [0.6, 0.76],
      [0.24, 0.56],
    ];
    const colores = ['#dd040a', '#80878d', 'rgba(236, 239, 241, 0.9)'];
    const MEZCLA = 0.8;
    const PAUSA = 0.5;
    const SEPARA = 4.2;

    const azar = (a: number, b: number) => a + Math.random() * (b - a);
    // Radio al azar repartido por la superficie (no se amontonan en el centro)
    const enAnillo = (a: number, b: number) => Math.sqrt(azar(a * a, b * b));
    const suave = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));

    let ps: Particula[] = [];
    const crear = () => {
      const n = window.innerWidth < 860 ? 650 : 1100;
      ps = Array.from({ length: n }, () => {
        const u = Math.random();
        const tipo = u < 0.34 ? 0 : u < 0.58 ? 1 : 2;
        const c = capas[tipo]!;
        const r = enAnillo(0.22, 0.95);
        return {
          ang: Math.random() * Math.PI * 2,
          desde: r,
          mezcla: r,
          destino: enAnillo(c[0], c[1]),
          k: azar(0.75, 1.35),
          tipo,
          w: Math.random() < 0.5 ? 1.4 : 2.4,
        };
      });
    };

    let ancho = 0;
    let alto = 0;
    const medir = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      ancho = lienzo.clientWidth;
      alto = lienzo.clientHeight;
      lienzo.width = Math.round(ancho * dpr);
      lienzo.height = Math.round(alto * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    let t0 = performance.now() / 1000;
    let w = 0;
    let impulso = 1;
    let objetivoImpulso = 1;
    let previo = 0;

    const radio = (p: Particula, t: number) => {
      const tm = t - t0;
      if (tm < MEZCLA) return p.desde + (p.mezcla - p.desde) * suave(tm / MEZCLA);
      const ts = (tm - MEZCLA - PAUSA) * p.k;
      return p.mezcla + (p.destino - p.mezcla) * suave(ts / SEPARA);
    };

    const pintar = (t: number, estela: number) => {
      const cx = ancho / 2;
      const cy = alto / 2;
      const R = Math.min(ancho, alto) * 0.47;
      ctx.clearRect(0, 0, ancho, alto);

      // La cámara: aro fino y la escala
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
      ctx.beginPath();
      ctx.arc(cx, cy, R * 1.02, 0, Math.PI * 2);
      ctx.stroke();
      ctx.beginPath();
      for (let i = 0; i < 120; i++) {
        const a = (i / 120) * Math.PI * 2;
        const l = i % 10 === 0 ? 0.045 : 0.02;
        ctx.moveTo(cx + Math.cos(a) * R * 1.06, cy + Math.sin(a) * R * 1.06);
        ctx.lineTo(cx + Math.cos(a) * R * (1.06 + l), cy + Math.sin(a) * R * (1.06 + l));
      }
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.16)';
      ctx.stroke();
      // La aguja roja arriba
      ctx.strokeStyle = '#dd040a';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(cx, cy - R * 1.06);
      ctx.lineTo(cx, cy - R * 1.15);
      ctx.stroke();

      // Las partículas, en un trazo por color y grosor
      ctx.lineCap = 'round';
      for (let tipo = 0; tipo < 3; tipo++) {
        for (const grosor of [1.4, 2.4]) {
          ctx.beginPath();
          for (const p of ps) {
            if (p.tipo !== tipo || p.w !== grosor) continue;
            const r = radio(p, t) * R;
            const a1 = p.ang;
            const a0 = a1 - estela;
            ctx.moveTo(cx + Math.cos(a0) * r, cy + Math.sin(a0) * r);
            ctx.arc(cx, cy, r, a0, a1);
          }
          ctx.strokeStyle = colores[tipo]!;
          ctx.lineWidth = grosor;
          ctx.stroke();
        }
      }

      // El buje de metal en el centro
      const g = ctx.createRadialGradient(cx - R * 0.03, cy - R * 0.03, 0, cx, cy, R * 0.13);
      g.addColorStop(0, '#d9dde0');
      g.addColorStop(0.55, '#8b9298');
      g.addColorStop(1, '#3a3f44');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 0.12, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = 'rgba(21, 23, 25, 0.5)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 0.06, 0, Math.PI * 2);
      ctx.stroke();
    };

    let reloj = 0;
    let visible = true;
    const vuelta = (ms: number) => {
      const t = ms / 1000;
      const dt = Math.min(t - (previo || t), 0.05);
      previo = t;
      // Arranca despacio, acelera y se queda girando; con el ratón encima, más rápido
      impulso += (objetivoImpulso - impulso) * Math.min(dt * 3, 1);
      const base = 2.6 * suave((t - t0 + (t0 === inicio ? 0 : 3)) / 2.4);
      w = base * impulso;
      for (const p of ps) {
        // Las de dentro, un poco más rápidas: el disco brilla
        const r = radio(p, t);
        p.ang += w * dt * (1 + 0.06 * (1 - r));
      }
      pintar(t, Math.min(0.02 + w * 0.13, 1.1));
      if (visible) reloj = requestAnimationFrame(vuelta);
    };

    const inicio = t0;
    crear();
    medir();
    if (quieto) {
      // Sin movimiento: el resultado ya separado, en puntos
      for (const p of ps) p.mezcla = p.desde = p.destino;
      pintar(t0 + 99, 0.004);
      new ResizeObserver(() => {
        medir();
        pintar(t0 + 99, 0.004);
      }).observe(lienzo);
    } else {
      new ResizeObserver(medir).observe(lienzo);
      const arrancar = () => {
        cancelAnimationFrame(reloj);
        previo = 0;
        reloj = requestAnimationFrame(vuelta);
      };
      new IntersectionObserver(([e]) => {
        visible = !!e?.isIntersecting && !document.hidden;
        if (visible) arrancar();
      }).observe(escena);
      document.addEventListener('visibilitychange', () => {
        visible = !document.hidden;
        if (visible) arrancar();
      });
      escena.addEventListener('pointerenter', () => (objetivoImpulso = 1.7));
      escena.addEventListener('pointerleave', () => (objetivoImpulso = 1));
      // Al pulsar se vuelve a mezclar todo y se separa otra vez
      escena.addEventListener('click', () => {
        const t = performance.now() / 1000;
        for (const p of ps) {
          p.desde = radio(p, t);
          p.mezcla = enAnillo(0.22, 0.95);
        }
        t0 = t;
      });
    }
  }

  // ——— Historia: la pantalla se queda fija y una cámara cercana sigue la punta de una línea de garabatos; en cada
  // punto, un hito. De la línea solo se ve la cola reciente, que se va borrando; no queda rastro ni vista final ———
  const viaje = document.querySelector<HTMLElement>('[data-viaje]');
  if (viaje && !quieto) {
    const NS = 'http://www.w3.org/2000/svg';
    const esc = viaje.querySelector<HTMLElement>('.escenario')!;
    const svg = esc.querySelector<SVGSVGElement>('.mundo')!;
    const cam = svg.querySelector<SVGGElement>('.m-cam')!;
    const cola = svg.querySelector<SVGPathElement>('.m-cola')!;
    const nucleo = svg.querySelector<SVGPathElement>('.m-nucleo')!;
    const linea = svg.querySelector<SVGPathElement>('.m-linea')!;
    const gNudos = svg.querySelector<SVGGElement>('.m-nudos')!;
    const gFantasmas = svg.querySelector<SVGGElement>('.m-fantasmas')!;
    const punta = svg.querySelector<SVGCircleElement>('.m-punta')!;
    const rejilla = esc.querySelector<HTMLElement>('.rejilla')!;
    const hitos = [...esc.querySelectorAll<HTMLElement>('.h-hitos > li')];
    viaje.classList.add('viva');

    // Cada clave: en qué punto del scroll (en pantallas), cuánta línea, el zoom y el desvío de la cámara hacia el texto
    type Clave = { u: number; l: number; z: number; ox: number };
    let claves: Clave[] = [];
    let pts: { x: number; y: number }[] = [];
    let largos: number[] = [];
    // La línea, ya calculada punto a punto con su longitud acumulada: así no se pregunta al navegador en cada fotograma
    let px = new Float32Array(0);
    let py = new Float32Array(0);
    let cum = new Float32Array(0);
    let tramo = 1;
    let total = 1;
    let ancho = 0;
    let alto = 0;
    let ay = 0;
    let unidades = 1;
    let nudos: SVGGElement[] = [];
    // Dónde se para la rueda: en cada hito, mientras se lee
    let paradas: number[] = [];
    let objetivo = 0;
    let ahora = 0;
    let bucle = 0;
    const suave = (x: number) => x * x * (3 - 2 * x);
    const circulo = (cls: string, x: number, y: number) => {
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('class', cls);
      c.setAttribute('cx', String(x));
      c.setAttribute('cy', String(y));
      return c;
    };
    // Índice del último punto de la línea que queda antes de la longitud l
    const indice = (l: number) => {
      let a = 0;
      let b = cum.length - 1;
      while (a < b) {
        const m = (a + b + 1) >> 1;
        if (cum[m]! <= l) a = m;
        else b = m - 1;
      }
      return a;
    };
    const en = (l: number) => {
      const i = indice(Math.max(0, Math.min(total, l)));
      const j = Math.min(i + 1, cum.length - 1);
      const k = j === i ? 0 : (Math.max(0, Math.min(total, l)) - cum[i]!) / (cum[j]! - cum[i]!);
      return { x: px[i]! + (px[j]! - px[i]!) * k, y: py[i]! + (py[j]! - py[i]!) * k };
    };
    // El trozo de línea que va de l - largo a l, como un solo trazo
    const trozo = (l: number, largo: number) => {
      const desde = Math.max(0, l - largo);
      const a = indice(desde) + 1;
      const b = indice(l);
      const p0 = en(desde);
      const p1 = en(l);
      let d = `M ${p0.x.toFixed(1)} ${p0.y.toFixed(1)}`;
      const paso = Math.max(1, Math.ceil((b - a) / 90));
      for (let i = a; i <= b; i += paso) d += ` L ${px[i]!.toFixed(1)} ${py[i]!.toFixed(1)}`;
      return `${d} L ${p1.x.toFixed(1)} ${p1.y.toFixed(1)}`;
    };

    const trazar = () => {
      ancho = esc.clientWidth;
      alto = esc.clientHeight;
      const movil = window.matchMedia('(max-width: 860px)').matches;
      // En móvil el punto queda arriba y el texto debajo; en escritorio, el punto al centro y el texto a su lado
      ay = alto * (movil ? 0.3 : 0.5);
      svg.setAttribute('viewBox', `0 0 ${ancho} ${alto}`);
      // Largo y ancho: da amplios barridos de un lado a otro y baja poco entre uno y otro
      const A = movil ? ancho * 0.28 : Math.min(ancho * 0.34, 520);
      const D = alto * (movil ? 0.8 : 0.6);
      const xs = [-0.8, 0.9, -0.9, 0.8, -0.6];
      const ys = [0.9, 1.1, 0.95, 1.1, 1];
      let yy = 0;
      pts = hitos.map((_, i) => ({ x: xs[i % xs.length]! * A, y: (yy += ys[i % ys.length]! * D) }));
      const fin = { x: 0, y: pts.at(-1)!.y + D * 0.9 };

      // De un punto al siguiente la línea hace un garabato distinto: una ola, un lazo, una fila de rizos, una ese, una
      // espiral y una ola suave. Los rizos son una trocoide: avanzar en recta mientras se gira, y si el giro es más
      // ancho que el avance, se cierra en bucle. Cada garabato da [avance extra, desvío lateral] en el instante t
      const rizo = (t: number, k: number, r: number): [number, number] => [
        -r * Math.sin(2 * Math.PI * k * t),
        r * (1 - Math.cos(2 * Math.PI * k * t)),
      ];
      const garabatos: ((t: number, L: number) => [number, number])[] = [
        (t, L) => rizo(t, 2, L * 0.1 * Math.sin(Math.PI * t)),
        (t, L) => [0, L * 0.16 * Math.sin(2 * Math.PI * t)],
        (t, L) => rizo(t, 1, L * 0.16),
        (t, L) => rizo(t, 3, L * 0.07 * Math.sin(Math.PI * t)),
        (t, L) => [0, L * 0.12 * Math.sin(3 * Math.PI * t) * Math.sin(Math.PI * t)],
        (t, L) => rizo(t, 2, L * 0.12),
      ];
      const nodos = [{ x: 0, y: 0 }, ...pts, fin];
      const xp: number[] = [0];
      const yp: number[] = [0];
      const marca: number[] = [];
      for (let s = 0; s < nodos.length - 1; s++) {
        const a = nodos[s]!;
        const b = nodos[s + 1]!;
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const L = Math.hypot(dx, dy);
        const ux = dx / L;
        const uy = dy / L;
        // Unos garabatos se tuercen hacia un lado y otros hacia el otro
        const lado = s % 2 ? 1 : -1;
        const f = garabatos[s % garabatos.length]!;
        const n = Math.ceil(L / 6);
        for (let j = 1; j <= n; j++) {
          const t = j / n;
          const [p, q] = f(t, L);
          xp.push(a.x + dx * t + ux * p - uy * lado * q);
          yp.push(a.y + dy * t + uy * p + ux * lado * q);
        }
        if (s < pts.length) marca.push(xp.length - 1);
      }
      px = Float32Array.from(xp);
      py = Float32Array.from(yp);
      cum = new Float32Array(px.length);
      for (let i = 1; i < px.length; i++) cum[i] = cum[i - 1]! + Math.hypot(px[i]! - px[i - 1]!, py[i]! - py[i - 1]!);
      total = cum.at(-1)!;
      largos = marca.map((i) => cum[i]!);
      tramo = total / (nodos.length - 1);

      // Detrás de cada hito, su año (o su palabra) en grande y muy claro, hacia fuera
      const fs = movil ? 120 : 210;
      gFantasmas.replaceChildren(
        ...pts.map((p, i) => {
          const tx = document.createElementNS(NS, 'text');
          const fuera = Math.sign(p.x);
          tx.setAttribute('class', 'm-fantasma');
          tx.setAttribute('font-size', String(fs));
          tx.setAttribute('x', String(movil ? p.x : p.x + fuera * 40));
          tx.setAttribute('y', String(movil ? p.y - 40 : p.y + fs * 0.35));
          tx.setAttribute('text-anchor', movil ? 'middle' : fuera < 0 ? 'end' : 'start');
          tx.textContent = hitos[i]!.dataset.cuando ?? '';
          return tx;
        }),
      );
      gNudos.replaceChildren();
      nudos = pts.map((p) => {
        const g = document.createElementNS(NS, 'g');
        g.setAttribute('class', 'nd');
        g.append(
          circulo('onda', p.x, p.y),
          circulo('luz', p.x, p.y),
          circulo('punto', p.x, p.y),
          circulo('brillo', p.x, p.y),
        );
        gNudos.append(g);
        return g;
      });

      // El recorrido: se acerca a cada hito, se queda un rato leyendo (empujando un poco hacia dentro) y se aleja al
      // pasar al siguiente
      const tw = movil ? 0 : (hitos[0]?.offsetWidth ?? 0);
      const desvio = (i: number) => (movil ? 0 : Math.sign(pts[i]!.x) * (24 + tw / 2));
      const zm = movil ? 0.62 : 0.55;
      let u = 0;
      claves = [{ u, l: 0, z: 0.9, ox: 0 }];
      paradas = [];
      pts.forEach((_, i) => {
        const a = i ? largos[i - 1]! : 0;
        const b = largos[i]!;
        const oa = i ? desvio(i - 1) : 0;
        claves.push({ u: (u += 0.55), l: (a + b) / 2, z: zm, ox: (oa + desvio(i)) / 2 });
        claves.push({ u: (u += 0.55), l: b, z: 1, ox: desvio(i) });
        paradas.push(u + 0.35);
        claves.push({ u: (u += 0.7), l: b, z: 1.08, ox: desvio(i) });
      });
      claves.push({ u: (u += 0.6), l: total, z: zm, ox: 0 });
      unidades = u;
      viaje.style.height = `${Math.round((u + 1) * alto)}px`;
      calcular();
      ahora = objetivo;
      pintar();
    };

    const pintar = () => {
      const c: Clave = claves.at(-1)!;
      let l = c.l;
      let z = c.z;
      let ox = c.ox;
      for (let i = 1; i < claves.length; i++) {
        const a = claves[i - 1]!;
        const b = claves[i]!;
        if (ahora <= b.u) {
          const t = suave(entre((ahora - a.u) / Math.max(1e-6, b.u - a.u)));
          l = a.l + (b.l - a.l) * t;
          z = Math.exp(Math.log(a.z) + (Math.log(b.z) - Math.log(a.z)) * t);
          ox = a.ox + (b.ox - a.ox) * t;
          break;
        }
      }
      const p = en(l);
      // La cámara no se marea con cada rizo: mira a la media del trozo de línea que rodea la punta
      let mx = 0;
      let my = 0;
      for (let k = -4; k <= 4; k++) {
        const q = en(l + k * 40);
        mx += q.x / 9;
        my += q.y / 9;
      }
      const tx = ancho / 2 - (mx + ox / z) * z;
      const ty = ay - my * z;
      cam.setAttribute('transform', `translate(${tx.toFixed(1)} ${ty.toFixed(1)}) scale(${z.toFixed(4)})`);
      // Solo la cola: un trazo corto y firme y otro más largo y tenue; el resto de la línea no se dibuja. Grosores y
      // puntos del mismo tamaño en pantalla, se acerque o se aleje
      const k = 1 / z;
      const dCorta = trozo(l, 170 * k);
      linea.setAttribute('d', dCorta);
      nucleo.setAttribute('d', dCorta);
      cola.setAttribute('d', trozo(l, 520 * k));
      linea.style.strokeWidth = String(3 * k);
      nucleo.style.strokeWidth = String(1.1 * k);
      cola.style.strokeWidth = String(9 * k);
      punta.setAttribute('cx', p.x.toFixed(1));
      punta.setAttribute('cy', p.y.toFixed(1));
      punta.setAttribute('r', String(5 * k));
      // La cuadrícula del fondo va con la cámara: al acercarse se abre, al alejarse se cierra
      const g = 48 * z;
      rejilla.style.backgroundSize = `${g}px ${g}px`;
      rejilla.style.backgroundPosition = `${tx.toFixed(1)}px ${ty.toFixed(1)}px`;
      rejilla.style.opacity = String(entre((z - 0.12) / 0.5));
      // El último punto alcanzado late y se queda encendido hasta que se pasa al siguiente
      let ultimo = -1;
      largos.forEach((lg, i) => {
        if (l >= lg - 1) ultimo = i;
      });
      nudos.forEach((n, i) => {
        n.classList.toggle('on', i <= ultimo);
        n.classList.toggle('act', i === ultimo);
        for (const h of n.children) h.setAttribute('r', String(7 * k));
      });
      // Cada texto, junto a su punto: aparece al acercarse y se va al seguir
      hitos.forEach((li, i) => {
        const q = pts[i]!;
        const o = entre(1 - Math.abs(l - largos[i]!) / (tramo * 0.4));
        if (o === 0 && li.style.visibility === 'hidden') return;
        li.style.setProperty('--x', (tx + q.x * z).toFixed(1));
        li.style.setProperty('--y', (ty + q.y * z).toFixed(1));
        li.style.opacity = o.toFixed(3);
        li.style.visibility = o > 0.01 ? 'visible' : 'hidden';
        li.classList.toggle('on', o > 0.5);
      });
    };

    const saltar = esc.querySelector<HTMLButtonElement>('[data-h-saltar]')!;
    const saltarTxt = esc.querySelector<HTMLElement>('[data-h-saltar-txt]')!;
    let antes = 0;
    let arriba = false;

    const calcular = () => {
      objetivo = entre(-viaje.getBoundingClientRect().top / Math.max(1, alto) / unidades) * unidades;
      if (!bucle) bucle = requestAnimationFrame(paso);
      // El botón de saltar: dentro del recorrido, hacia donde se está bajando o subiendo
      const p = objetivo / unidades;
      saltar.classList.toggle('on', p > 0.004 && p < 0.985);
      if (p !== antes && p < antes !== arriba) {
        arriba = p < antes;
        saltar.classList.toggle('arriba', arriba);
        saltarTxt.textContent = (arriba ? saltar.dataset.subir : saltar.dataset.bajar) ?? '';
      }
      antes = p;
    };
    // Al ir de hito en hito con la rueda, el paso dura lo mismo siempre y arranca y frena con suavidad; si entretanto
    // se mueve la página de otra forma, se deja y se sigue al scroll
    const DURA = 1400;
    let viajeRueda: { desde: number; hasta: number; t0: number } | null = null;
    const paso = () => {
      if (viajeRueda && Math.abs(objetivo - viajeRueda.hasta) > 0.005) viajeRueda = null;
      if (viajeRueda) {
        const k = entre((performance.now() - viajeRueda.t0) / DURA);
        ahora = viajeRueda.desde + (viajeRueda.hasta - viajeRueda.desde) * suave(k);
        if (k === 1) viajeRueda = null;
      } else ahora += (objetivo - ahora) * 0.1;
      if (!viajeRueda && Math.abs(objetivo - ahora) < 0.001) ahora = objetivo;
      pintar();
      bucle = ahora === objetivo ? 0 : requestAnimationFrame(paso);
    };

    // Hacia abajo, al final de la historia, con la sección siguiente aún por entrar para que su animación se vea
    // entera; hacia arriba, al título de la historia. El dibujo se pone en su sitio al momento, sin recorrerlo
    const historia = viaje.closest('section')!;
    saltar.addEventListener('click', () => {
      const r = historia.getBoundingClientRect();
      irSinSuavizar(window.scrollY + (arriba ? r.top : r.bottom - window.innerHeight));
      viajeRueda = null;
      calcular();
      ahora = objetivo;
      pintar();
    });

    // Con la pantalla fija, cada golpe de rueda lleva al hito siguiente o al anterior, despacio y sin saltarse el
    // alejarse y acercarse de entre medias. Pasado el último hito, o antes del primero, la rueda vuelve a ir como
    // siempre. Mientras dura un paso no se cuenta otro, y un trackpad, que manda muchos avisos por gesto, da uno solo
    let ultimaRueda = 0;
    let ultimoSalto = 0;
    window.addEventListener(
      'wheel',
      (e) => {
        if (e.ctrlKey || !e.deltaY || Math.abs(e.deltaY) < Math.abs(e.deltaX)) return;
        const r = viaje.getBoundingClientRect();
        if (r.top > 2 || r.bottom < window.innerHeight - 2) return;
        const u = -r.top / Math.max(1, alto);
        const destino = e.deltaY > 0 ? paradas.find((x) => x > u + 0.02) : paradas.findLast((x) => x < u - 0.02);
        if (destino === undefined) return;
        e.preventDefault();
        const t = performance.now();
        const seguida = t - ultimaRueda < 160;
        ultimaRueda = t;
        if (viajeRueda || (seguida && t - ultimoSalto < DURA + 400)) return;
        ultimoSalto = t;
        viajeRueda = { desde: ahora, hasta: destino, t0: t };
        irSinSuavizar(window.scrollY + r.top + destino * alto);
        calcular();
      },
      { passive: false },
    );

    trazar();
    new ResizeObserver(trazar).observe(esc);
    void document.fonts.ready.then(trazar);
    alBajar.push(calcular);
  }

  // ——— Propuesta: el escáner. La pantalla se queda fija mientras se baja y el recorrido (0–1) va por tramos: la caja
  // se abre y el título se aparta, la lámina pasa la máquina a rayos X, se separa en piezas con su nombre, un tramo por
  // sistema y, al final, vuelve a su acabado real. La escena 3D se carga solo al acercarse ———
  const escaner = document.querySelector<HTMLElement>('[data-escaner]');
  if (escaner) {
    const textos = [...escaner.querySelectorAll<HTMLElement>('[data-e-texto]')];
    const botones = [...escaner.querySelectorAll<HTMLButtonElement>('[data-e-ir]')];
    const partesEl = [...escaner.querySelectorAll<HTMLElement>('[data-e-parte]')];
    const modo = escaner.querySelector<HTMLElement>('[data-e-modo]')!;
    const num = escaner.querySelector<HTMLElement>('[data-e-n]')!;
    const lienzo = escaner.querySelector<HTMLElement>('[data-e-lienzo]')!;
    const carga = escaner.querySelector<HTMLElement>('[data-e-carga]')!;
    const punto = escaner.querySelector<HTMLElement>('[data-e-punto]')!;
    const codigo = escaner.querySelector<HTMLElement>('[data-e-codigo]')!;
    const nombreDe = new Map(partesEl.map((el) => [el.dataset.eParte!, el.dataset.nombre ?? '']));
    const n = botones.length;
    const tramo = (p: number, a: number, b: number) => entre((p - a) / (b - a));
    // Los sistemas van de PASOS[0] a PASOS[1]
    const PASOS = [0.46, 0.93] as const;
    let escena: Escaner | null = null;
    let codigos: string[] = [];
    let visto = -2;
    let rayos = false;
    const saltar = escaner.querySelector<HTMLButtonElement>('[data-e-saltar]')!;
    const saltarTxt = escaner.querySelector<HTMLElement>('[data-e-saltar-txt]')!;
    let antes = 0;
    let arriba = false;

    const calcular = () => {
      const r = escaner.getBoundingClientRect();
      const p = entre(-r.top / Math.max(1, r.height - window.innerHeight));
      // La caja baja mientras la sección termina de entrar (el título ya está) y se abre al empezar a bajar
      const llega = entre(1 - r.top / (window.innerHeight * 0.4));
      const caja = tramo(p, 0.035, 0.17);
      const sal = tramo(p, 0.015, 0.08);
      const escaneo = p < 0.5 ? tramo(p, 0.17, 0.27) : 1 - tramo(p, 0.94, 0.995);
      const despiece = Math.min(tramo(p, 0.29, 0.34), 1 - tramo(p, 0.4, 0.45));
      const t = tramo(p, PASOS[0], PASOS[1]);
      const k = p >= PASOS[0] && p <= PASOS[1] ? Math.min(n - 1, Math.floor(t * n)) : -1;
      const dentro = entre(t * n - Math.max(0, k));
      escena?.estado({ llega, caja, escaneo, despiece, paso: k });
      escaner.style.setProperty('--sal', sal.toFixed(3));

      // El botón de saltar: dentro del recorrido, hacia donde se está bajando o subiendo
      saltar.classList.toggle('on', p > 0.004 && p < 0.985);
      if (p !== antes && p < antes !== arriba) {
        arriba = p < antes;
        saltar.classList.toggle('arriba', arriba);
        saltarTxt.textContent = (arriba ? saltar.dataset.subir : saltar.dataset.bajar) ?? '';
      }
      antes = p;

      if (escaneo > 0.5 !== rayos) {
        rayos = escaneo > 0.5;
        modo.textContent = (rayos ? modo.dataset.rayos : modo.dataset.real) ?? '';
        escaner.classList.toggle('rayos', rayos);
      }
      // Antes de los sistemas se lee la propuesta; luego, el sistema del tramo
      const ver = p >= PASOS[0] ? Math.max(0, k) + 1 : 0;
      if (ver !== visto) {
        visto = ver;
        textos.forEach((el, j) => el.classList.toggle('on', j === ver));
        botones.forEach((b, j) => {
          b.classList.toggle('on', j === ver - 1);
          b.setAttribute('aria-current', String(j === ver - 1));
        });
        num.textContent = `${dos(ver)} / ${dos(n)}`;
        const cod = ver ? (codigos[ver - 1] ?? '') : '';
        codigo.textContent = cod ? `${cod} · ${nombreDe.get(cod) ?? ''}` : '';
      }
      botones.forEach((b, j) => b.style.setProperty('--lleno', String(j < k ? 1 : j === k ? dentro : 0)));
    };
    // Saltar: hacia abajo, al principio de lo que
    // sigue (las ideas); hacia arriba, al final de la sección anterior, con su último tramo a la vista. Se apunta al
    // elemento, no a una cuenta, por si algo cambia de alto
    const propuesta = escaner.closest('section')!;
    saltar.addEventListener('click', () => {
      const destino = arriba ? propuesta.previousElementSibling : propuesta.querySelector('.pr-ideas');
      if (!(destino instanceof HTMLElement)) return;
      const r = destino.getBoundingClientRect();
      irSinSuavizar(window.scrollY + (arriba ? r.bottom - window.innerHeight : r.top));
    });
    // Cada botón lleva al centro de su tramo
    botones.forEach((b, j) =>
      b.addEventListener('click', () => {
        const r = escaner.getBoundingClientRect();
        const p = PASOS[0] + ((j + 0.5) / n) * (PASOS[1] - PASOS[0]);
        const top = window.scrollY + r.top + p * (r.height - window.innerHeight);
        window.scrollTo({ top, behavior: quieto ? 'auto' : 'smooth' });
      }),
    );

    escaner.classList.add('vivo');
    alBajar.push(calcular);
    calcular();
    // El título entra una vez, en cuanto asoma la sección (antes que la caja)
    new IntersectionObserver(
      ([e], obs) => {
        if (!e?.isIntersecting) return;
        escaner.classList.add('visto');
        obs.disconnect();
      },
      { rootMargin: '0px 0px -25% 0px' },
    ).observe(escaner);

    new IntersectionObserver(
      ([e], obs) => {
        if (!e?.isIntersecting) return;
        obs.disconnect();
        import('../../scripts/escena-escaner')
          .then(async ({ crearEscaner, paradas }) => {
            codigos = paradas.map((x) => x.codigo);
            escena = await crearEscaner({
              lienzo,
              src: escaner.dataset.src!,
              draco: escaner.dataset.draco!,
              partes: partesEl.map((el) => el.dataset.eParte!),
              marca: ['ORTO ALRESA', 'DIGICEN 22'],
              quieto,
              alProgreso: (v) => carga.style.setProperty('--v', String(v)),
            });
            escena.alProyectar((pt, partes) => {
              if (pt.ve) punto.style.transform = `translate3d(${pt.x.toFixed(1)}px, ${pt.y.toFixed(1)}px, 0)`;
              punto.classList.toggle('on', pt.ve);
              partes.forEach((q, i) => {
                const el = partesEl[i]!;
                if (q.ve) el.style.transform = `translate3d(${q.x.toFixed(1)}px, ${q.y.toFixed(1)}px, 0)`;
                el.classList.toggle('on', q.ve);
              });
            });
            escaner.classList.add('listo');
            visto = -2;
            calcular();
          })
          // Si el 3D no carga (sin WebGL, red caída), la sección vuelve a ser la lista de textos seguidos
          .catch(() => {
            escaner.classList.remove('vivo');
            alBajar.splice(alBajar.indexOf(calcular), 1);
          });
      },
      { rootMargin: '600px 0px' },
    ).observe(escaner);
  }

  // ——— Propuesta: las ideas. Se abre la que tiene el ratón o el foco y se queda abierta ———
  const ideas = document.querySelector<HTMLElement>('[data-ideas]');
  if (ideas) {
    const paneles = [...ideas.children] as HTMLElement[];
    const abrir = (el: HTMLElement) => () =>
      paneles.forEach((x) => {
        x.classList.toggle('abierta', x === el);
        x.querySelector('button')?.setAttribute('aria-expanded', String(x === el));
      });
    for (const el of paneles) {
      el.addEventListener('pointerenter', abrir(el));
      el.addEventListener('focusin', abrir(el));
      el.addEventListener('click', abrir(el));
    }
    ideas.classList.add('viva');
  }

  // ——— Qué nos diferencia: las diapositivas. El tramo en curso se llena por CSS y, al acabar, pasa a la siguiente; solo
  // se para fuera de pantalla o con el teclado dentro. El aro gira un paso por diapositiva, en el sentido en que se avanza ———
  const dif = document.querySelector<HTMLElement>('[data-dif]');
  const difSec = document.querySelector<HTMLElement>('[data-dif-sec]');
  const haz = document.querySelector<HTMLElement>('[data-haz]');
  if (dif && difSec && haz && 'IntersectionObserver' in window) {
    const fichas = [...dif.querySelectorAll<HTMLElement>('[data-ficha]')];
    const tramos = [...dif.querySelectorAll<HTMLElement>('[data-tramo]')];
    const cuenta = dif.querySelector<HTMLElement>('[data-cuenta]')!;
    const n = fichas.length;
    const grados = 360 / n;
    let act = 0;
    let giro = 0;
    dif.classList.add('viva');
    if (quieto) dif.classList.add('manual');

    const contar = (ficha: HTMLElement) => {
      const cifra = ficha.querySelector<HTMLElement>('[data-cifra]');
      const c = cifra?.dataset.cifra ?? '';
      if (!cifra || quieto || !/^\d+$/.test(c)) return;
      const fin = Number(c);
      const t0 = performance.now();
      const paso = (t: number) => {
        const x = entre((t - t0) / 900);
        cifra.textContent = String(Math.round(fin * (1 - Math.pow(1 - x, 3))));
        if (x < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };

    // d: hacia dónde se mueve (1 adelante, -1 atrás); el aro gira tantos pasos como diapositivas se salten
    const ir = (i: number, d = 1) => {
      i = (i + n) % n;
      if (i === act) return;
      const saltos = d > 0 ? (i - act + n) % n : -((act - i + n) % n);
      const antes = fichas[act]!;
      antes.classList.remove('on');
      antes.classList.add('sale');
      setTimeout(() => antes.classList.remove('sale'), 500);
      act = i;
      dif.style.setProperty('--d', String(Math.sign(saltos)));
      fichas[i]!.classList.add('on');
      giro += saltos * grados;
      haz.style.setProperty('--giro', `${giro}deg`);
      haz.classList.remove('pulso');
      void haz.offsetWidth;
      haz.classList.add('pulso');
      cuenta.textContent = dos(i + 1);
      cuenta.classList.remove('rueda');
      void cuenta.offsetWidth;
      cuenta.classList.add('rueda');
      tramos.forEach((t, k) => {
        t.classList.toggle('hecho', k < i);
        t.classList.remove('va');
      });
      void tramos[i]!.offsetWidth; // reinicia la animación del tramo
      tramos[i]!.classList.add('va');
      contar(fichas[i]!);
    };

    dif.querySelectorAll<HTMLButtonElement>('[data-mueve]').forEach((b) => {
      const d = Number(b.dataset.mueve);
      b.addEventListener('click', () => ir(act + d, d));
    });
    tramos.forEach((t, k) => t.addEventListener('click', () => ir(k, k < act ? -1 : 1)));
    dif.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      ir(act + d, d);
    });
    dif.addEventListener('animationend', (e) => {
      if ((e.target as HTMLElement).parentElement === tramos[act]) ir(act + 1);
    });

    // Deslizar con el dedo
    let x0: number | null = null;
    dif.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') x0 = e.clientX;
    });
    dif.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 48) ir(act - Math.sign(dx), -Math.sign(dx));
    });

    // El aro sigue un poco al ratón
    if (!quieto) {
      difSec.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = difSec.getBoundingClientRect();
        haz.style.setProperty('--mx', `${((e.clientX - r.left) / r.width - 0.5) * 40}px`);
        haz.style.setProperty('--my', `${((e.clientY - r.top) / r.height - 0.5) * 40}px`);
      });
      difSec.addEventListener('pointerleave', () => {
        haz.style.setProperty('--mx', '0px');
        haz.style.setProperty('--my', '0px');
      });
    }

    // Se enciende al entrar en pantalla y se para fuera de ella
    new IntersectionObserver(
      ([e]) => {
        if (!e) return;
        dif.classList.toggle('fuera', !e.isIntersecting);
        if (e.isIntersecting && !dif.classList.contains('en-marcha')) {
          dif.classList.add('en-marcha');
          difSec.classList.add('encendida');
          tramos[0]!.classList.add('va');
          contar(fichas[0]!);
        }
      },
      { threshold: 0.35 },
    ).observe(dif);
  }
</script>

