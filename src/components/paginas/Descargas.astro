---
// Descargas: el portal de documentación. Un buscador grande ("¿Qué equipo buscas?") y los filtros por familia, fijos
// al bajar; debajo, cada catálogo en su tarjeta, agrupados por familia, con sus PDF y el botón "Al dossier". Lo
// elegido baja a una bandeja y se abre como dossier: un enlace para compartir con la misma selección (?sel=) y un
// PDF con la foto, la fecha y el QR de cada catálogo. Todo sale de los PDF que ya publica ortoalresa.com.
import Base from '../../layouts/Base.astro';
import { familias } from '../../data/productos';
import { comprobado, documentos, esReciente, peso, type Documento, type IdiomaPdf } from '../../data/descargas';
import { contacto } from '../../data/navegacion';
import { idioma, ruta, textoSerie, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const d = t.descargas;
const tv = t.catalogo.filtros.vista;
const cruz = 'M6 6l12 12M18 6 6 18';

const fecha = (iso: string) =>
  new Date(iso).toLocaleDateString(t.meta.fechas, { day: 'numeric', month: 'short', year: 'numeric' });
const plano = (...partes: (string | undefined)[]) =>
  partes.filter(Boolean).join(' ').normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();

// Primero el PDF en el idioma de la página; en francés, el inglés
const orden: IdiomaPdf[] = lang === 'es' ? ['es', 'en'] : ['en', 'es'];
const pdfs = (x: Documento) => orden.flatMap((l) => (x.pdf[l] ? [{ l, a: x.pdf[l]! }] : []));

const nombreGrupo = (g: Documento['grupo']) => (g === 'laboratorio' ? d.lab : t.familias[g]);
const nombre = (x: Documento) =>
  x.tipo === 'lab' ? t.laboratorio.items[x.slug as keyof typeof t.laboratorio.items].nombre : x.nombre;
const frase = (x: Documento) =>
  x.tipo === 'lab'
    ? t.laboratorio.items[x.slug as keyof typeof t.laboratorio.items].frase
    : textoSerie(lang, x.slug).frase;
const ficha = (x: Documento) => ruta(lang, `/centrifugas/${x.slug}/`);

const grupos = [...(Object.keys(familias) as Documento['grupo'][]), 'laboratorio' as const]
  .map((g) => ({ g, docs: documentos.filter((x) => x.grupo === g) }))
  .filter((x) => x.docs.length);
const recientes = documentos.filter(esReciente).length;

// Lo que necesita el dossier de cada equipo, por su slug
const datos = {
  docs: Object.fromEntries(
    documentos.map((x) => [
      x.slug,
      {
        nombre: nombre(x),
        variantes: x.variantes,
        grupo: nombreGrupo(x.grupo),
        frase: frase(x),
        fecha: `${d.actualizado} ${fecha(x.fecha)}`,
        img: x.imagen.src,
        ficha: new URL(ficha(x), Astro.site).href,
        pdfs: pdfs(x).map(({ l, a }) => ({ l, url: a.url, peso: peso(a.bytes, t.meta.fechas) })),
      },
    ]),
  ),
  idiomas: d.idiomas,
  t: {
    quitar: d.quitar('{x}'),
    tipo: d.pdfTipo,
    titulo: d.pdfTitulo,
    para: d.para,
    etqEquipos: d.etqEquipos,
    etqCatalogos: d.etqCatalogos,
    etqIdiomas: d.etqIdiomas,
    intro: d.pdfIntro,
    verFicha: d.verFicha,
    enlace: d.pdfEnlace,
    archivo: d.archivo,
    copiado: d.copiado,
  },
  // Las formas con número, para el navegador: "{n} equipos en tu dossier"
  n: { bandeja: [d.bandeja(1), d.bandeja(99)], equipos: [d.equipos(1), d.equipos(99)] },
  pie: { empresa: `${contacto.empresa} · ${contacto.direccion}`, web: 'ortoalresa.com', pagina: tv.pagina, fuente: '' },
};
---

<Base title={d.title} description={d.description(documentos.length)}>
  <section class="sec cab">
    <div class="wrap">
      <span class="eyebrow">{t.nav.descargas}</span>
      <h1>
        {d.titulo[0]}
        <b>{d.titulo[1]}</b>
      </h1>
      <p class="lead">{d.lead}</p>
    </div>
  </section>

  <section class="lista" id="catalogos">
    <div class="barra" role="search">
      <div class="wrap barra-in">
        <label class="busca">
          <span class="sr">{d.buscar}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="M15.5 15.5 21 21"></path>
          </svg>
          <input type="search" id="busca" placeholder={d.ejemplo} autocomplete="off" />
        </label>
        <div class="chips" role="group" aria-label={d.buscar}>
          <button type="button" class="chip" aria-pressed="true" data-g="">
            {d.todo} <span>{documentos.length}</span>
          </button>
          {recientes > 0 && (
            <button type="button" class="chip chip-rec" aria-pressed="false" data-g="recientes">
              <i aria-hidden="true" />
              {d.recientes} <span>{recientes}</span>
            </button>
          )}
          {grupos.map(({ g, docs }) => (
            <button type="button" class="chip" aria-pressed="false" data-g={g}>
              {nombreGrupo(g)} <span>{docs.length}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="wrap">
      {grupos.map(({ g, docs }) => (
        <section class="grupo" data-grupo={g} aria-labelledby={`g-${g}`}>
          <h2 class="grupo-tit" id={`g-${g}`}>
            {nombreGrupo(g)} <span>{docs.length}</span>
          </h2>
          <ul class="rejilla">
            {docs.map((x) => (
              <li
                class="doc"
                data-slug={x.slug}
                data-reciente={esReciente(x) ? '' : undefined}
                data-texto={plano(nombre(x), x.variantes, nombreGrupo(g), frase(x))}
              >
                <a class="foto" href={ficha(x)} tabindex="-1" aria-hidden="true">
                  <img src={x.imagen.src} width={x.imagen.ancho} height={x.imagen.alto} alt="" loading="lazy" />
                  {esReciente(x) && <span class="nuevo">{d.reciente}</span>}
                </a>
                <div class="doc-txt">
                  <h3>
                    <a href={ficha(x)}>
                      {nombre(x)}
                      {x.variantes && <span>· {x.variantes}</span>}
                    </a>
                  </h3>
                  <p>{frase(x)}</p>
                  <small>
                    {d.actualizado} {fecha(x.fecha)}
                  </small>
                </div>
                <div class="acciones">
                  {pdfs(x).map(({ l, a }) => (
                    <a class="pdf" href={a.url} target="_blank" rel="noopener" lang={l} title={d.idiomas[l]}>
                      <b>PDF {l.toUpperCase()}</b>
                      <span>{peso(a.bytes, t.meta.fechas)}</span>
                    </a>
                  ))}
                  <button type="button" class="elegir" aria-pressed="false" aria-label={d.anadir(nombre(x))}>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path class="mas" d="M12 5v14M5 12h14" />
                      <path class="ok" d="m5 12.5 4.5 4.5L19 7.5" />
                    </svg>
                    <span class="no">{d.alDossier}</span>
                    <span class="si">{d.enDossier}</span>
                  </button>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="nada" id="nada" hidden>
        {d.nada}
      </p>
      <p class="nota">
        {d.comprobado}
        {fecha(comprobado)}.
      </p>
    </div>
  </section>

  <section class="sec falta">
    <div class="wrap falta-in">
      <h2>
        {d.falta[0]}
        <b>{d.falta[1]}</b>
      </h2>
      <p>{d.faltaTexto}</p>
      <div class="falta-links">
        <a class="arrow" href={`mailto:${contacto.tecnico}`}>
          {d.tecnico} · {contacto.tecnico}
        </a>
        <a class="arrow" href={`mailto:${contacto.comercial}`}>
          {d.comercial} · {contacto.comercial}
        </a>
      </div>
    </div>
  </section>

  <!-- La bandeja: lo elegido, siempre a mano abajo -->
  <div class="bandeja" id="bandeja" hidden>
    <div class="ban-fotos" aria-hidden="true"></div>
    <b class="ban-n" aria-live="polite"></b>
    <button type="button" class="ban-vaciar">
      {d.vaciar}
    </button>
    <button type="button" class="ban-ver">
      {d.verDossier} »
    </button>
  </div>

  <!-- El dossier: la lista de lo elegido con sus PDF, para quién es, y el PDF o el enlace para compartirlo -->
  <dialog class="dossier" id="dossier" aria-labelledby="dos-tit">
    <div class="dos-cab">
      <div>
        <span class="eyebrow">{d.tuDossier}</span>
        <h2 id="dos-tit">{d.equipos(0)}</h2>
      </div>
      <button type="button" class="dos-cerrar" aria-label={d.cerrar}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d={cruz} stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <ol class="dos-lista"></ol>
    <p class="dos-vacio">{d.vacio}</p>
    <div class="dos-pie">
      <label class="dos-para">
        <span>{d.para}</span>
        <input type="text" id="dos-para" maxlength="60" placeholder={d.paraEjemplo} autocomplete="organization" />
      </label>
      <div class="dos-acc">
        <button type="button" class="btn red" id="dos-pdf">
          {d.crearPdf}
        </button>
        <button type="button" class="btn ghost" id="dos-copiar">
          {d.copiar}
        </button>
        <button type="button" class="btn ghost" id="dos-compartir" hidden>
          {d.compartir}
        </button>
      </div>
      <p>{d.dossierTexto}</p>
    </div>
  </dialog>

  <!-- Vista previa del PDF del dossier: desde aquí se descarga o se imprime -->
  <dialog class="vista-pdf" id="vista-pdf" aria-labelledby="vista-pdf-tit">
    <div class="vp-cab">
      <h2 id="vista-pdf-tit">{tv.vistaPrevia}</h2>
      <button type="button" class="vp-descargar">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="1.8"></path>
        </svg>
        {tv.descargarPdf}
      </button>
      <button type="button" class="vp-imprimir">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M7 9V4h10v5M7 17H5v-7h14v7h-2M8 14h8v6H8z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          ></path>
        </svg>
        {tv.imprimir}
      </button>
      <button type="button" class="vp-cerrar" aria-label={d.cerrar}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d={cruz} stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <div class="vp-cuerpo">
      <iframe title={tv.vistaPrevia}></iframe>
      <p class="vp-espera">{tv.preparando}</p>
      <p class="vp-sin">{tv.sinVista}</p>
      <p class="vp-fallo">{tv.fallo}</p>
    </div>
  </dialog>

  <script type="application/json" id="datos-dossier" set:html={JSON.stringify(datos)} />
</Base>

<script>
  import { hoy, iniciarVistaPdf, vistaPdf, type Pie } from '../../scripts/exportar';
  import { dossierPdf, type EquipoDossier } from '../../scripts/dossier';

  const datos = JSON.parse(document.getElementById('datos-dossier')!.textContent!) as {
    docs: Record<string, EquipoDossier>;
    idiomas: Record<string, string>;
    t: Record<string, string>;
    n: { bandeja: [string, string]; equipos: [string, string] };
    pie: Pie;
  };
  const { docs, t } = datos;
  // "99 equipos" → "3 equipos": las formas con número se escriben en el servidor y aquí solo cambia la cifra
  const contar = ([uno, varios]: [string, string], n: number) => (n === 1 ? uno : varios.replace('99', String(n)));

  // ——— Buscador y filtros ———
  const busca = document.querySelector<HTMLInputElement>('#busca')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const grupos = [...document.querySelectorAll<HTMLElement>('.grupo')];
  const nada = document.querySelector<HTMLElement>('#nada')!;
  let filtro = '';
  const plano = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
  const filtrar = () => {
    const q = plano(busca.value);
    let total = 0;
    for (const g of grupos) {
      let n = 0;
      for (const f of g.querySelectorAll<HTMLElement>('.doc')) {
        const enFiltro =
          !filtro || (filtro === 'recientes' ? f.dataset.reciente !== undefined : g.dataset.grupo === filtro);
        const ok = enFiltro && (!q || f.dataset.texto!.includes(q));
        f.hidden = !ok;
        if (ok) n++;
      }
      g.hidden = !n;
      total += n;
    }
    nada.hidden = total > 0;
  };
  busca.addEventListener('input', filtrar);
  for (const c of chips)
    c.addEventListener('click', () => {
      filtro = c.dataset.g ?? '';
      for (const o of chips) o.setAttribute('aria-pressed', String(o === c));
      filtrar();
    });

  // ——— El dossier: lo elegido vive en la dirección (?sel=) y, si no viene en ella, en el navegador ———
  const CLAVE = 'oa-dossier';
  const leer = (): string[] => {
    const url = new URLSearchParams(location.search).get('sel');
    if (url !== null) return url.split(',').filter((s) => docs[s]);
    try {
      return (JSON.parse(localStorage.getItem(CLAVE) ?? '[]') as string[]).filter((s) => docs[s]);
    } catch {
      return [];
    }
  };
  const venia = new URLSearchParams(location.search).has('sel');
  let sel = [...new Set(leer())];

  const enlace = () => {
    const u = new URL(location.pathname, location.origin);
    if (sel.length) u.searchParams.set('sel', sel.join(','));
    return u.href.replace(/%2C/g, ',');
  };

  const bandeja = document.querySelector<HTMLElement>('#bandeja')!;
  const banFotos = bandeja.querySelector<HTMLElement>('.ban-fotos')!;
  const banN = bandeja.querySelector<HTMLElement>('.ban-n')!;
  const dlg = document.querySelector<HTMLDialogElement>('#dossier')!;
  const lista = dlg.querySelector<HTMLOListElement>('.dos-lista')!;
  const titulo = dlg.querySelector<HTMLElement>('#dos-tit')!;
  const copiar = dlg.querySelector<HTMLButtonElement>('#dos-copiar')!;
  const textoCopiar = copiar.textContent;
  const para = dlg.querySelector<HTMLInputElement>('#dos-para')!;

  const foto = (src: string) => Object.assign(document.createElement('img'), { src, alt: '', loading: 'lazy' });

  const pintar = () => {
    try {
      localStorage.setItem(CLAVE, JSON.stringify(sel));
    } catch {
      /* sin almacenamiento: la selección vale mientras dure la página */
    }
    history.replaceState(null, '', enlace());
    for (const li of document.querySelectorAll<HTMLElement>('.doc')) {
      const si = sel.includes(li.dataset.slug!);
      li.classList.toggle('elegido', si);
      li.querySelector('.elegir')!.setAttribute('aria-pressed', String(si));
    }
    bandeja.hidden = !sel.length;
    document.body.classList.toggle('con-bandeja', sel.length > 0);
    banN.textContent = contar(datos.n.bandeja, sel.length);
    banFotos.replaceChildren(...sel.slice(-4).map((s) => foto(docs[s].img)));
    titulo.textContent = contar(datos.n.equipos, sel.length);
    dlg.classList.toggle('vacio', !sel.length);
    copiar.textContent = textoCopiar;
    lista.replaceChildren(
      ...sel.map((s) => {
        const x = docs[s];
        const li = document.createElement('li');
        const txt = document.createElement('div');
        txt.className = 'dl-txt';
        const n = Object.assign(document.createElement('a'), { href: x.ficha, textContent: x.nombre });
        if (x.variantes) n.append(Object.assign(document.createElement('span'), { textContent: ` · ${x.variantes}` }));
        const g = Object.assign(document.createElement('small'), { textContent: `${x.grupo} · ${x.fecha}` });
        const acc = document.createElement('div');
        acc.className = 'dl-pdfs';
        acc.append(
          ...x.pdfs.map((p) => {
            const a = Object.assign(document.createElement('a'), {
              href: p.url,
              target: '_blank',
              rel: 'noopener',
              title: datos.idiomas[p.l],
            });
            a.append(
              Object.assign(document.createElement('b'), { textContent: `PDF ${p.l.toUpperCase()}` }),
              Object.assign(document.createElement('span'), { textContent: p.peso }),
            );
            return a;
          }),
        );
        txt.append(n, g, acc);
        const quitar = Object.assign(document.createElement('button'), {
          type: 'button',
          className: 'dl-quitar',
          innerHTML: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>',
        });
        quitar.setAttribute('aria-label', t.quitar.replace('{x}', x.nombre));
        quitar.addEventListener('click', () => {
          sel = sel.filter((o) => o !== s);
          pintar();
        });
        li.append(foto(x.img), txt, quitar);
        return li;
      }),
    );
  };

  for (const b of document.querySelectorAll<HTMLButtonElement>('.elegir'))
    b.addEventListener('click', () => {
      const s = b.closest<HTMLElement>('.doc')!.dataset.slug!;
      sel = sel.includes(s) ? sel.filter((o) => o !== s) : [...sel, s];
      pintar();
      if (sel.includes(s)) {
        bandeja.classList.remove('late');
        void bandeja.offsetWidth;
        bandeja.classList.add('late');
      }
    });
  bandeja.querySelector('.ban-vaciar')!.addEventListener('click', () => {
    sel = [];
    pintar();
  });
  bandeja.querySelector('.ban-ver')!.addEventListener('click', () => dlg.showModal());
  dlg.querySelector('.dos-cerrar')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });

  copiar.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(enlace());
      copiar.textContent = t.copiado;
    } catch {
      window.prompt('', enlace());
    }
  });
  const compartir = dlg.querySelector<HTMLButtonElement>('#dos-compartir')!;
  if ('share' in navigator) {
    compartir.hidden = false;
    compartir.addEventListener('click', () => {
      void navigator.share({ title: document.title, url: enlace() }).catch(() => {});
    });
  }

  // El PDF: para quién es (si se dice), cuántos equipos y catálogos, en qué idiomas, y cada equipo con sus QR
  iniciarVistaPdf();
  dlg.querySelector('#dos-pdf')!.addEventListener('click', () => {
    if (!sel.length) return;
    const equipos = sel.map((s) => docs[s]);
    const pdfs = equipos.flatMap((e) => e.pdfs);
    const idiomas = [...new Set(pdfs.map((p) => p.l))].map((l) => datos.idiomas[l]);
    const cliente = para.value.trim();
    const f = hoy();
    void vistaPdf(
      () =>
        dossierPdf(
          {
            tipo: t.tipo,
            titulo: t.titulo,
            fecha: f.texto,
            datos: [
              ...(cliente ? [[t.para, cliente] as [string, string]] : []),
              [t.etqEquipos, String(equipos.length)],
              [t.etqCatalogos, String(pdfs.length)],
              [t.etqIdiomas, idiomas.join(' · ')],
            ],
            intro: t.intro,
            verFicha: t.verFicha,
            enlace: [t.enlace, enlace()],
            equipos,
          },
          datos.pie,
        ),
      `${t.archivo}-${f.archivo}`,
    );
  });

  pintar();
  // Quien recibe el enlace llega con el dossier abierto
  if (venia && sel.length) dlg.showModal();
</script>

<style>
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  h1 b,
  h2 b {
    font-weight: 700;
  }

  /* ——— Cabecera ——— */
  .cab {
    padding-bottom: clamp(32px, 4vw, 56px);
  }
  h1 {
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.95;
    margin-top: 22px;
    max-width: 14ch;
  }
  .lead {
    margin-top: 24px;
    color: var(--body);
    font-size: var(--t-sub);
    max-width: 56ch;
  }

  /* ——— Barra fija: el buscador grande y los filtros ——— */
  .barra {
    position: sticky;
    top: 76px;
    z-index: 5;
    background: var(--white);
    border-block: 1px solid var(--line);
  }
  .barra-in {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: 18px 16px;
  }
  .busca {
    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 2px solid var(--ink);
    transition: border-color var(--dur-1) ease;
  }
  .busca:focus-within {
    border-color: var(--red);
  }
  .busca svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    flex: none;
  }
  .busca input {
    border: 0;
    outline: 0;
    font: 300 clamp(22px, 2.4vw, 32px) var(--f);
    padding: 6px 0 10px;
    width: 100%;
    min-width: 0;
    background: transparent;
    color: var(--ink);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--line);
    background: var(--white);
    padding: 8px 12px;
    font: 700 15px/1 var(--f);
    cursor: pointer;
    color: var(--ink);
    transition:
      background var(--dur-1) ease,
      border-color var(--dur-1) ease;
  }
  .chip:hover {
    border-color: var(--ink);
  }
  .chip span {
    font-weight: 300;
    color: var(--muted);
  }
  .chip-rec i {
    width: 7px;
    height: 7px;
    background: var(--red);
  }
