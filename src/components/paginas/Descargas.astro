---
// Descargas: el folleto en PDF de cada centrífuga y equipo de laboratorio, y los logos de la marca. Cada folleto se
// descarga, se copia su enlace o se enseña con un QR para abrirlo en el móvil; varios se juntan en un pack que se
// comparte con un solo enlace (y su QR). La búsqueda, la familia, el idioma y el pack van en la dirección.
import Base from '../../layouts/Base.astro';
import Bandera from '../ui/Bandera.astro';
import IconoTemp from '../ui/IconoTemp.astro';
import { familias, modelos, productos, type Familia, type Temperatura } from '../../data/productos';
import { equipos } from '../../data/laboratorio';
import { fichaCentrifuga } from '../../data/fichas';
import { idioma, idiomas, ruta, textos, type Idioma } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const d = t.descargas;

const plano = (...partes: (string | undefined)[]) =>
  partes.filter(Boolean).join(' ').normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();

type Doc = {
  id: string;
  nombre: string;
  fam: Familia | 'lab';
  temp?: Temperatura;
  img: string;
  ficha: string;
  pdf: Record<Idioma, string>;
};

// Centrífugas: el folleto de la web actual, en español e inglés (el francés enlaza el inglés)
const docs: Doc[] = [
  ...modelos.flatMap((m): Doc[] => {
    const pdf = fichaCentrifuga(m.slug)?.pdf;
    if (!pdf) return [];
    return [
      {
        id: m.slug,
        nombre: m.nombre,
        fam: productos.find((p) => p.slug === m.serie)!.familia,
        temp: m.temperatura,
        img: m.imagen.src,
        ficha: ruta(lang, `/centrifugas/${m.slug}/`),
        pdf,
      },
    ];
  }),
  // Equipos de laboratorio: un solo PDF, en español
  ...equipos.flatMap((e): Doc[] =>
    e.pdf
      ? [
          {
            id: e.slug,
            nombre: t.laboratorio.items[e.slug].nombre,
            fam: 'lab',
            img: e.imagen.src,
            ficha: ruta(lang, `/centrifugas/${e.slug}/`),
            pdf: { es: e.pdf, en: e.pdf, fr: e.pdf },
          },
        ]
      : [],
  ),
];

// Idioma en que está de verdad el PDF que se abre al elegir cada idioma (si no hay folleto en ese idioma, se abre el
// inglés o, si tampoco, el español)
const idiomaReal = (x: Doc, l: Idioma): Idioma =>
  l === 'es' || x.pdf[l] === x.pdf.es ? 'es' : l === 'fr' && x.pdf.fr === x.pdf.en ? 'en' : l;

const filtros: { id: Familia | 'lab'; nombre: string }[] = [
  ...(Object.keys(familias) as Familia[]).map((f) => ({ id: f, nombre: t.familias[f] })),
  { id: 'lab' as const, nombre: d.laboratorio },
].filter((f) => docs.some((x) => x.fam === f.id));

const logos = [
  { id: 'color', src: '/img/marca/logo-ortoalresa-color.svg', oscuro: false },
  { id: 'horizontal', src: '/img/marca/logo-ortoalresa-color-horizontal.svg', oscuro: false },
  { id: 'lineas', src: '/img/marca/logo-ortoalresa-2-lineas.svg', oscuro: false },
  { id: 'oscuro', src: '/img/marca/logo-ortoalresa-oscuro.svg', oscuro: true },
  { id: 'blanco', src: '/img/marca/logo-ortoalresa-white.svg', oscuro: true },
] as const;

// Textos que necesita el script
const js = {
  lang,
  total: [d.total(1), d.total(2).replace('2', '#')],
  pack: [d.pack(1), d.pack(2).replace('2', '#')],
  compartido: [d.compartido(1), d.compartido(2).replace('2', '#')],
  copiar: d.copiar,
  copiado: d.copiado,
  anadir: d.anadir,
  enPack: d.enPack,
  asunto: d.asunto,
};
---

<Base title={d.title} description={d.description}>
  <section class="desc-cab">
    <div class="wrap">
      <span class="eyebrow">{d.eyebrow}</span>
      <h1>
        {d.titulo} <b>{d.tituloB}</b>
      </h1>
      <p class="entradilla">{d.entradilla}</p>
    </div>
  </section>

  <div class="barra-desc" data-barra>
    <div class="wrap barra-in">
      <label class="busca">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="m15.5 15.5 5 5"></path>
        </svg>
        <span class="sr">{d.buscar}</span>
        <input type="search" placeholder={d.buscar} autocomplete="off" data-q />
      </label>
      <div class="fams" role="group" aria-label={d.eyebrow}>
        <button type="button" class="fam" aria-pressed="true" data-fam="">
          {d.todos} <span data-n>{docs.length}</span>
        </button>
        {filtros.map((f) => (
          <button type="button" class="fam" aria-pressed="false" data-fam={f.id}>
            {f.nombre} <span data-n>{docs.filter((x) => x.fam === f.id).length}</span>
          </button>
        ))}
      </div>
      <div class="langs" role="radiogroup" aria-label={d.idioma}>
        {idiomas.map((l) => (
          <button
            type="button"
            class="lang"
            role="radio"
            aria-checked={l.codigo === lang ? 'true' : 'false'}
            data-lang={l.codigo}
            title={l.nombre}
          >
            <Bandera codigo={l.codigo} />
            {l.codigo.toUpperCase()}
          </button>
        ))}
      </div>
    </div>
  </div>

  <section class="desc-lista">
    <div class="wrap">
      <div class="compartido" data-compartido hidden>
        <p data-compartido-txt></p>
        <button type="button" class="arrow" data-ver-todos>
          {d.verTodos}
        </button>
      </div>
      <p class="cuenta" aria-live="polite" data-cuenta>
        {d.total(docs.length)}
      </p>
      <ul class="docs">
        {docs.map((x) => (
          <li
            class="doc"
            data-id={x.id}
            data-fam={x.fam}
            data-texto={plano(x.nombre, x.fam === 'lab' ? d.laboratorio : t.familias[x.fam])}
            data-es={x.pdf.es}
            data-en={x.pdf.en}
            data-fr={x.pdf.fr}
            data-real-es={idiomaReal(x, 'es')}
            data-real-en={idiomaReal(x, 'en')}
            data-real-fr={idiomaReal(x, 'fr')}
            data-nombre={x.nombre}
          >
            <a class="doc-foto" href={x.ficha} tabindex="-1" aria-hidden="true">
              <img src={x.img} alt="" width="320" height="320" loading="lazy" decoding="async" />
            </a>
            <button type="button" class="doc-pack" aria-pressed="false" data-pack title={d.anadir}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path class="mas" d="M12 5v14M5 12h14" />
                <path class="ok" d="m5 12.5 4.5 4.5L19 7.5" />
              </svg>
              <span class="sr">{d.anadir}</span>
            </button>
            <div class="doc-txt">
              <a class="doc-nombre" href={x.ficha}>
                {x.nombre}
              </a>
              <p class="doc-meta">
                {x.temp && <IconoTemp t={x.temp} size={14} />}
                {x.fam === 'lab' ? d.laboratorio : t.familias[x.fam]}
                {x.temp && <> · {t.temperatura[x.temp]}</>}
              </p>
              <p class="doc-aviso" data-aviso data-es={d.solo.es} data-en={d.solo.en} hidden />
            </div>
            <div class="doc-acc">
              <a
                class="acc acc-pdf"
                href={x.pdf[lang]}
                target="_blank"
                rel="noopener"
                data-pdf
                title={d.descargarLargo}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 4v11m-4.5-4.5L12 15l4.5-4.5M5 19.5h14" />
                </svg>
                {d.descargar} <span data-lang-pdf>{idiomaReal(x, lang).toUpperCase()}</span>
              </a>
              <button type="button" class="acc" data-qr title={d.qr}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2v2h-2zM18 18h2v2h-2zM14 18h2M18 14h2" />
                </svg>
                <span class="sr">{d.qr}</span>
              </button>
              <button type="button" class="acc" data-copiar title={d.copiar}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" />
                </svg>
                <span class="sr">{d.copiar}</span>
              </button>
            </div>
          </li>
        ))}
      </ul>
      <div class="vacio" data-vacio hidden>
        <p>{d.ninguno}</p>
        <button type="button" class="arrow" data-borrar>
          {d.borrar}
        </button>
      </div>
    </div>
  </section>

  <section class="desc-marca">
    <div class="wrap">
      <h2>{d.marca}</h2>
      <p>{d.marcaTexto}</p>
      <ul class="logos">
        {logos.map((l) => (
          <li>
            <a class:list={['logo', { oscuro: l.oscuro }]} href={l.src} download>
              <span class="logo-img">
                <img src={l.src} alt="" loading="lazy" />
              </span>
              <span class="logo-pie">
                {d.logos[l.id]}
                <b>SVG</b>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="pack-barra" data-pack-barra hidden>
    <div class="wrap pack-in">
      <ul class="pack-minis" data-pack-minis></ul>
      <p data-pack-txt></p>
      <button type="button" class="pack-vaciar" data-vaciar>
        {d.vaciar}
      </button>
      <button type="button" class="btn red" data-compartir>
        {d.compartir}
      </button>
    </div>
  </div>

  <dialog class="ventana" data-ventana aria-labelledby="v-titulo">
    <button type="button" class="v-cerrar" data-cerrar>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
      <span class="sr">{d.cerrar}</span>
    </button>
    <div class="v-qr" data-v-qr></div>
    <div class="v-txt">
      <span class="eyebrow" data-v-eyebrow></span>
      <h2 id="v-titulo" data-v-titulo></h2>
      <p data-v-texto></p>
      <ul class="v-lista" data-v-lista hidden></ul>
      <div class="v-acc">
        <button type="button" class="btn red" data-v-copiar>
          {d.copiar}
        </button>
        <button type="button" class="btn ghost" data-v-share hidden>
          {d.enviar}
        </button>
        <a class="btn ghost" data-v-correo hidden>
          {d.correo}
        </a>
        <button type="button" class="btn ghost" data-v-descargar>
          {d.qrDescargar}
        </button>
      </div>
    </div>
  </dialog>

  <div class="sr" aria-live="polite" data-anuncio></div>
  <script is:inline type="application/json" id="desc-txt" set:html={JSON.stringify(js)} />
  <template
    id="desc-qr-txt"
    data-titulo={d.qrTitulo}
    data-texto={d.qrTexto}
    data-pack={d.packTitulo}
    data-pack-texto={d.packTexto}
  ></template>
</Base>

<script>
  type Lang = 'es' | 'en' | 'fr';
  const txt = JSON.parse(document.getElementById('desc-txt')!.textContent!) as {
    lang: Lang;
    total: [string, string];
    pack: [string, string];
    compartido: [string, string];
    copiar: string;
    copiado: string;
    anadir: string;
    enPack: string;
    asunto: string;
  };
  const plural = ([uno, varios]: [string, string], n: number) => (n === 1 ? uno : varios.replace('#', String(n)));
  const plano = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;

  const docs = [...document.querySelectorAll<HTMLElement>('.doc')];
  const q = $<HTMLInputElement>('[data-q]');
  const famBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-fam]')].filter((b) => b.tagName === 'BUTTON');
  const langBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-lang]')];
  const cuenta = $('[data-cuenta]');
  const vacio = $('[data-vacio]');
  const anuncio = $('[data-anuncio]');
  const compartido = $('[data-compartido]');

  const url = new URL(location.href);
  const PACK = 'oral-pack';
  let fam = url.searchParams.get('familia') ?? '';
  let lang = (url.searchParams.get('idioma') as Lang) || txt.lang;
  let soloPack: string[] | null = url.searchParams.get('pack')?.split(',').filter(Boolean) ?? null;
  let pack: string[] = [];
  try {
    pack = JSON.parse(localStorage.getItem(PACK) ?? '[]');
  } catch {
    /* sin almacenamiento, el pack dura lo que la visita */
  }
  q.value = url.searchParams.get('q') ?? '';

  const pdfDe = (el: HTMLElement) => el.dataset[lang]!;
  const nombreDe = (id: string) => docs.find((x) => x.dataset.id === id)?.dataset.nombre ?? id;

  const guardarUrl = () => {
    const u = new URL(location.href);
    const set = (k: string, v: string) => (v ? u.searchParams.set(k, v) : u.searchParams.delete(k));
    set('q', q.value.trim());
    set('familia', fam);
    set('idioma', lang === txt.lang ? '' : lang);
    set('pack', soloPack?.join(',') ?? '');
    history.replaceState(null, '', u);
  };

  const pintar = () => {
    const busca = plano(q.value.trim());
    let n = 0;
    for (const el of docs) {
      const ver =
        (!soloPack || soloPack.includes(el.dataset.id!)) &&
        (!fam || el.dataset.fam === fam) &&
        (!busca || busca.split(/\s+/).every((p) => el.dataset.texto!.includes(p)));
      el.hidden = !ver;
      if (ver) n++;
      const a = $<HTMLAnchorElement>('[data-pdf]', el);
      a.href = pdfDe(el);
      const real = el.dataset[`real${lang[0].toUpperCase()}${lang[1]}` as 'realEs'] as Lang;
      $('[data-lang-pdf]', el).textContent = real.toUpperCase();
      const aviso = $('[data-aviso]', el);
      aviso.hidden = real === lang;
      aviso.textContent = real === lang ? '' : aviso.dataset[real as 'es' | 'en']!;
    }
    cuenta.textContent = plural(txt.total, n);
    // Cada familia dice cuántos folletos le quedan con la búsqueda escrita
    for (const b of famBtns) {
      const k = b.dataset.fam;
      $('[data-n]', b).textContent = String(
        docs.filter(
          (el) =>
            (!soloPack || soloPack.includes(el.dataset.id!)) &&
            (!k || el.dataset.fam === k) &&
            (!busca || busca.split(/\s+/).every((p) => el.dataset.texto!.includes(p))),
        ).length,
      );
    }
    vacio.hidden = n > 0;
    for (const b of famBtns) b.setAttribute('aria-pressed', String(b.dataset.fam === fam));
    for (const b of langBtns) b.setAttribute('aria-checked', String(b.dataset.lang === lang));
    compartido.hidden = !soloPack;
    if (soloPack) $('[data-compartido-txt]').textContent = plural(txt.compartido, soloPack.length);
    guardarUrl();
  };

  // ——— Pack ———
  const barra = $('[data-pack-barra]');
  const pintarPack = () => {
    try {
      localStorage.setItem(PACK, JSON.stringify(pack));
    } catch {
      /* nada */
    }
    for (const el of docs) {
      const dentro = pack.includes(el.dataset.id!);
      const b = $<HTMLButtonElement>('[data-pack]', el);
      b.setAttribute('aria-pressed', String(dentro));
      b.title = dentro ? txt.enPack : txt.anadir;
      el.classList.toggle('en-pack', dentro);
    }
    barra.hidden = pack.length === 0;
    document.body.classList.toggle('con-pack', pack.length > 0);
    $('[data-pack-txt]').textContent = plural(txt.pack, pack.length);
    $('[data-pack-minis]').replaceChildren(
      ...pack.slice(-5).map((id) => {
        const li = document.createElement('li');
        const img = docs.find((x) => x.dataset.id === id)?.querySelector('img');
        if (img) li.append(Object.assign(new Image(), { src: img.src, alt: '' }));
        return li;
      }),
    );
  };

  // ——— Ventana: QR de un folleto o del pack ———
  const ventana = $<HTMLDialogElement>('[data-ventana]');
  const tq = $<HTMLTemplateElement>('#desc-qr-txt').dataset;
  let enlace = '';
  let archivo = 'qr';
  const copiar = async (texto: string, boton?: HTMLElement) => {
    try {
      await navigator.clipboard.writeText(texto);
      anuncio.textContent = txt.copiado;
      if (boton) {
        boton.classList.add('hecho');
        const antes = boton.title;
        boton.title = txt.copiado;
        if (boton.dataset.vCopiar !== undefined) boton.textContent = txt.copiado;
        setTimeout(() => {
          boton.classList.remove('hecho');
          boton.title = antes;
          if (boton.dataset.vCopiar !== undefined) boton.textContent = txt.copiar;
        }, 1800);
      }
    } catch {
      /* sin portapapeles */
    }
  };
  const abrir = async (o: {
    enlace: string;
    eyebrow: string;
    titulo: string;
    texto: string;
    lista?: string[];
    archivo: string;
    pack?: boolean;
  }) => {
    enlace = o.enlace;
    archivo = o.archivo;
    const { renderSVG } = await import('uqr');
    $('[data-v-qr]', ventana).innerHTML = renderSVG(enlace, {
      ecc: 'M',
      border: 2,
      pixelSize: 8,
      blackColor: '#1a1a1a',
    });
    $('[data-v-eyebrow]', ventana).textContent = o.eyebrow;
    $('[data-v-titulo]', ventana).textContent = o.titulo;
    $('[data-v-texto]', ventana).textContent = o.texto;
    const lista = $('[data-v-lista]', ventana);
    lista.hidden = !o.lista;
    lista.replaceChildren(
      ...(o.lista ?? []).map((n) => Object.assign(document.createElement('li'), { textContent: n })),
    );
    const share = $<HTMLButtonElement>('[data-v-share]', ventana);
    share.hidden = !o.pack || !('share' in navigator);
    const correo = $<HTMLAnchorElement>('[data-v-correo]', ventana);
    correo.hidden = !o.pack;
    if (o.pack) {
      const cuerpo = [
        ...pack.map((id) => `${nombreDe(id)}: ${pdfDe(docs.find((x) => x.dataset.id === id)!)}`),
        '',
        enlace,
      ].join('\n');
      correo.href = `mailto:?subject=${encodeURIComponent(txt.asunto)}&body=${encodeURIComponent(cuerpo)}`;
    }
    ventana.showModal();
  };

  // ——— Eventos ———
  q.addEventListener('input', pintar);
  // «/» lleva al buscador, como en muchas webs de documentación
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !ventana.open && !(e.target as HTMLElement).closest('input, textarea, select')) {
      e.preventDefault();
      q.focus();
    }
  });
  for (const b of famBtns)
    b.addEventListener('click', () => {
      fam = b.dataset.fam!;
      pintar();
    });
  for (const b of langBtns)
    b.addEventListener('click', () => {
      lang = b.dataset.lang as Lang;
      pintar();
    });
  $('[data-borrar]').addEventListener('click', () => {
    q.value = '';
    fam = '';
    pintar();
    q.focus();
  });
  $('[data-ver-todos]').addEventListener('click', () => {
    soloPack = null;
    pintar();
  });

  for (const el of docs) {
    const id = el.dataset.id!;
    $('[data-pack]', el).addEventListener('click', () => {
      pack = pack.includes(id) ? pack.filter((x) => x !== id) : [...pack, id];
      pintarPack();
    });
    $('[data-copiar]', el).addEventListener('click', (e) => copiar(pdfDe(el), e.currentTarget as HTMLElement));
    $('[data-qr]', el).addEventListener('click', () =>
      abrir({
        enlace: pdfDe(el),
        eyebrow: `PDF · ${$('[data-lang-pdf]', el).textContent}`,
        titulo: el.dataset.nombre!,
        texto: tq.texto!,
        archivo: `qr-${id}-${lang}`,
      }),
    );
  }

  $('[data-vaciar]').addEventListener('click', () => {
    pack = [];
    pintarPack();
  });
  $('[data-compartir]').addEventListener('click', () => {
    const u = new URL(location.pathname, location.origin);
    u.searchParams.set('pack', pack.join(','));
    if (lang !== txt.lang) u.searchParams.set('idioma', lang);
    abrir({
      enlace: u.href,
      eyebrow: plural(txt.pack, pack.length),
      titulo: tq.pack!,
      texto: tq.packTexto!,
      lista: pack.map(nombreDe),
      archivo: 'qr-pack-orto-alresa',
      pack: true,
    });
  });

  $('[data-cerrar]', ventana).addEventListener('click', () => ventana.close());
  ventana.addEventListener('click', (e) => e.target === ventana && ventana.close());
  $('[data-v-copiar]', ventana).addEventListener('click', (e) => copiar(enlace, e.currentTarget as HTMLElement));
  $('[data-v-share]', ventana).addEventListener('click', () =>
    navigator.share({ title: txt.asunto, text: pack.map(nombreDe).join(', '), url: enlace }).catch(() => {}),
  );
  $('[data-v-descargar]', ventana).addEventListener('click', () => {
    const svg = $('[data-v-qr] svg', ventana).outerHTML;
    const a = Object.assign(document.createElement('a'), {
      href: URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' })),
      download: `${archivo}.svg`,
    });
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });

  pintar();
  pintarPack();
</script>

<style>
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: square;
  }

  /* ——— Cabecera ——— */
  .desc-cab {
