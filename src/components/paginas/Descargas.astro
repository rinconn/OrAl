<script>
  import { excel, hoy, iniciarVistaPdf, vistaPdf, type Pie } from '../../scripts/exportar';
  import { dossierPdf, type EquipoDossier } from '../../scripts/dossier';
  import { qrSvg } from '../../scripts/qr';

  type Doc = EquipoDossier & { rotores: { c: string[]; n: string[] }[] };
  const datos = JSON.parse(document.getElementById('datos-descargas')!.textContent!) as {
    docs: Record<string, Doc>;
    idiomas: Record<string, string>;
    t: Record<string, string>;
    n: Record<'bandeja' | 'equipos', [string, string]>;
    pie: Pie;
  };
  const { docs, t } = datos;
  const contar = ([uno, varios]: [string, string], n: number) => (n === 1 ? uno : varios.replace('99', String(n)));
  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const plano = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const guardado = (k: string) => {
    try {
      return localStorage.getItem(k);
    } catch {
      return null;
    }
  };
  const guardar = (k: string, v: string) => {
    try {
      localStorage.setItem(k, v);
    } catch {
      /* sin almacenamiento: vale mientras dure la página */
    }
  };
  // Lo que solo funciona con JavaScript se enseña ahora
  for (const el of document.querySelectorAll<HTMLElement>('.descargas [hidden]:is(.sel, .xlsx)')) el.hidden = false;

  // ——— Partículas de la portada: puntos sueltos que suben despacio, sin líneas; se apartan del ratón ———
  const lienzo = document.querySelector<HTMLCanvasElement>('#particulas');
  if (lienzo) {
    const g = lienzo.getContext('2d')!;
    let w = 0;
    let h = 0;
    type P = { x: number; y: number; r: number; v: number; o: number; fase: number; rojo: boolean };
    let ps: P[] = [];
    const raton = { x: -999, y: -999 };
    const nueva = (y?: number): P => ({
      x: Math.random() * w,
      y: y ?? Math.random() * h,
      r: 1.6 + Math.random() * 3.4,
      v: 0.12 + Math.random() * 0.35,
      o: 0.25 + Math.random() * 0.5,
      fase: Math.random() * Math.PI * 2,
      rojo: Math.random() < 0.38,
    });
    const medir = () => {
      const r = lienzo.getBoundingClientRect();
      const k = Math.min(devicePixelRatio || 1, 2);
      w = r.width;
      h = r.height;
      lienzo.width = w * k;
      lienzo.height = h * k;
      g.setTransform(k, 0, 0, k, 0, 0);
      ps = Array.from({ length: Math.round(Math.min(90, Math.max(30, (w * h) / 13000))) }, () => nueva());
    };
    const pintar = () => {
      g.clearRect(0, 0, w, h);
      for (const p of ps) {
        g.fillStyle = p.rojo ? `rgba(221, 4, 10, ${p.o * 0.85})` : `rgba(26, 26, 26, ${p.o * 0.45})`;
        g.beginPath();
        g.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        g.fill();
      }
    };
    let activo = true;
    let tiempo = 0;
    const paso = () => {
      if (!activo) return;
      tiempo += 0.01;
      for (const p of ps) {
        p.y -= p.v;
        p.x += Math.sin(tiempo + p.fase) * 0.25;
        const dx = p.x - raton.x;
        const dy = p.y - raton.y;
        const dist = Math.hypot(dx, dy);
        if (dist < 120 && dist > 0) {
          p.x += (dx / dist) * 1.2;
          p.y += (dy / dist) * 1.2;
        }
        if (p.y < -6) Object.assign(p, nueva(h + 6));
      }
      pintar();
      requestAnimationFrame(paso);
    };
    medir();
    pintar();
    if (!quieto) {
      new IntersectionObserver(([e]) => {
        const antes = activo;
        activo = e.isIntersecting;
        if (activo && !antes) requestAnimationFrame(paso);
      }).observe(lienzo);
      requestAnimationFrame(paso);
      const portada = lienzo.parentElement!;
      portada.addEventListener('pointermove', (e) => {
        const r = lienzo.getBoundingClientRect();
        raton.x = e.clientX - r.left;
        raton.y = e.clientY - r.top;
      });
      portada.addEventListener('pointerleave', () => Object.assign(raton, { x: -999, y: -999 }));
    }
    let espera = 0;
    addEventListener('resize', () => {
      clearTimeout(espera);
      espera = window.setTimeout(() => {
        medir();
        pintar();
      }, 200);
    });
  }

  // ——— La sección que se está leyendo: su título enciende la barra roja ———
  const secciones = [...document.querySelectorAll<HTMLElement>('[data-seccion]')];
  if ('IntersectionObserver' in window) {
    const vistas = new IntersectionObserver(
      (es) => {
        for (const e of es) e.target.classList.toggle('actual', e.isIntersecting);
      },
      { rootMargin: '-35% 0px -50% 0px' },
    );
    secciones.forEach((s) => vistas.observe(s));
  }

  // ——— Buscador ———
  const busca = document.querySelector<HTMLInputElement>('#busca')!;
  const nada = document.querySelector<HTMLElement>('#nada')!;
  let sincronizarLibro = () => {};
  let sincronizarArchivo = () => {};
  const filtrar = () => {
    const q = plano(busca.value);
    let total = 0;
    const destacado = document.querySelector<HTMLElement>('.destacado');
    if (destacado) {
      destacado.hidden = !!q && !destacado.dataset.busca!.includes(q);
      if (!destacado.hidden) total++;
    }
    for (const s of secciones) {
      for (const x of s.querySelectorAll<HTMLElement>('.doc')) x.hidden = !!q && !x.dataset.busca!.includes(q);
      for (const f of s.querySelectorAll<HTMLElement>('.familia')) f.hidden = !f.querySelector('.doc:not([hidden])');
      const n = s.querySelectorAll('.doc:not([hidden])').length;
      s.hidden = !n;
      total += n;
    }
    nada.hidden = total > 0;
    sincronizarLibro();
    sincronizarArchivo();
  };
  busca.addEventListener('input', filtrar);
  busca.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      busca.value = '';
      filtrar();
    }
  });

  // ——— El libro de catálogos: la tapa se abre y cada serie es un pliego; al pasar la hoja se ve la siguiente ———
  const libro = document.querySelector<HTMLElement>('[data-libro]');
  if (libro) {
    const pliegos = [...libro.querySelectorAll<HTMLElement>('.pliego')];
    const tapa = libro.querySelector<HTMLElement>('.tapa-fija')!;
    const hoja = libro.querySelector<HTMLElement>('.hoja')!;
    const caraFr = hoja.querySelector<HTMLElement>('.fr')!;
    const caraTr = hoja.querySelector<HTMLElement>('.tr')!;
    const ant = libro.querySelector<HTMLButtonElement>('[data-ant]')!;
    const sig = libro.querySelector<HTMLButtonElement>('[data-sig]')!;
    const cuenta = libro.querySelector<HTMLElement>('.cuenta')!;
    const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)');
    const movil = matchMedia('(max-width: 759px)');
    let vis: HTMLElement[] = [];
    let i = -1; // -1: el libro está cerrado
    let ocupado = false;

    const controles = () => {
      ant.disabled = ocupado || i < 0;
      sig.disabled = ocupado || i >= vis.length - 1;
      cuenta.textContent = i < 0 ? '' : `${i + 1} / ${vis.length}`;
    };
    const pintar = () => {
      libro.classList.toggle('abierto', i >= 0);
      for (const p of pliegos) {
        const es = i >= 0 && p === vis[i];
        p.classList.toggle('v-i', es);
        p.classList.toggle('v-d', es);
      }
      controles();
    };
    // Una hoja que gira sobre el lomo: delante, la página derecha del pliego menor; detrás, la izquierda del mayor
    const volar = (menor: number, mayor: number, adelante: boolean, alTerminar: () => void) => {
      caraFr.replaceChildren(
        (menor < 0 ? tapa.querySelector('.tapa-in')! : vis[menor].querySelector('.der')!).cloneNode(true),
      );
      caraTr.replaceChildren(vis[mayor].querySelector('.izq')!.cloneNode(true));
      hoja.hidden = false;
      libro.classList.add('volteando');
      const giro = [{ transform: 'rotateY(0deg)' }, { transform: 'rotateY(-180deg)' }];
      const a = hoja.animate(adelante ? giro : giro.reverse(), {
        duration: 520,
        easing: 'cubic-bezier(0.45, 0, 0.2, 1)',
        fill: 'both',
      });
      const sombra = (cara: HTMLElement, de: number, a2: number) =>
        cara.animate([{ opacity: de }, { opacity: a2 }], {
          duration: 520,
          easing: 'linear',
          pseudoElement: '::after',
          fill: 'both',
        });
      sombra(caraFr, adelante ? 0 : 0.5, adelante ? 0.5 : 0);
      sombra(caraTr, adelante ? 0.5 : 0, adelante ? 0 : 0.5);
      a.onfinish = () => {
        a.cancel();
        hoja.hidden = true;
        libro.classList.remove('volteando');
        alTerminar();
      };
    };
    const ir = (destino: number) => {
      const j = Math.max(-1, Math.min(vis.length - 1, destino));
      if (j === i || ocupado || !vis.length) return;
      if (sinMovimiento.matches || movil.matches) {
        i = j;
        pintar();
        return;
      }
      const viejo = i;
      if (viejo < 0 || j < 0) {
        // De la portada al libro y vuelta: la portada sube y se desvanece, el libro aparece (y al revés)
        const portada = [tapa.querySelector('.intro-libro'), tapa.querySelector('.holo'), tapa.querySelector('.magia')];
        const caja = libro.querySelector<HTMLElement>('.pliegos')!;
        const suave = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
        const mostrar = () => {
          for (const p of pliegos) p.classList.remove('entra');
          if (j >= 0) vis[j].classList.add('entra');
          i = j;
          ocupado = false;
          pintar();
        };
        ocupado = true;
        controles();
        const [lib, holo, magia] = portada;
        const despliega = [
          { opacity: 0, transform: 'perspective(1600px) rotateX(58deg) translateY(80px) scale(0.78)' },
          { opacity: 1, offset: 0.55 },
          { opacity: 1, transform: 'perspective(1600px) rotateX(-4deg) translateY(-8px) scale(1.02)', offset: 0.8 },
          { opacity: 1, transform: 'none' },
        ];
        if (j >= 0) {
          // Abrir: la portada coge impulso, el holograma parpadea y se apaga, y el catálogo se despliega desde abajo
          const salidas = [
            lib?.animate(
              [
                { opacity: 1, transform: 'none' },
                { opacity: 1, transform: 'scale(0.96) translateY(10px)', offset: 0.25 },
                { opacity: 1, transform: 'scale(1.06) translateY(-14px)', offset: 0.55 },
                { opacity: 0, transform: 'scale(1.3) translateY(-50px)' },
              ],
              { duration: 950, easing: 'ease-in-out', fill: 'forwards' },
            ),
            holo?.animate(
              [
                { opacity: 1 },
                { opacity: 0.15, offset: 0.12 },
                { opacity: 0.95, offset: 0.2 },
                { opacity: 0.1, offset: 0.34 },
                { opacity: 0.8, offset: 0.42 },
                { opacity: 0, transform: 'translateY(-70px) scaleY(1.5)' },
              ],
              { duration: 850, easing: 'linear', fill: 'forwards' },
            ),
            magia?.animate(
              [
                { opacity: 1, transform: 'none' },
                { opacity: 1, transform: 'translateY(-30px) scale(1.15)', offset: 0.5 },
                { opacity: 0, transform: 'translateY(-120px) scale(1.4)' },
              ],
              { duration: 950, easing: 'ease-out', fill: 'forwards' },
            ),
          ];
          salidas[0]!.onfinish = () => {
            mostrar();
            salidas.forEach((x) => x?.cancel());
            caja.animate(despliega, { duration: 1100, easing: suave });
          };
        } else {
          // Cerrar: el catálogo se pliega hacia abajo y la portada vuelve a montarse pieza a pieza
          caja.animate(
            [
              { opacity: 1, transform: 'none' },
              { opacity: 1, transform: 'perspective(1600px) rotateX(-4deg) translateY(-8px) scale(1.02)', offset: 0.2 },
              { opacity: 1, offset: 0.45 },
              { opacity: 0, transform: 'perspective(1600px) rotateX(58deg) translateY(80px) scale(0.78)' },
            ],
            {
              duration: 800,
              easing: 'cubic-bezier(0.5, 0, 0.75, 0)',
              fill: 'forwards',
            },
          ).onfinish = (e) => {
            mostrar();
            (e.target as Animation).cancel();
            lib?.animate(
              [
                { opacity: 0, transform: 'scale(0.7) translateY(90px)' },
                { opacity: 1, transform: 'scale(1.05) translateY(-10px)', offset: 0.65 },
                { opacity: 1, transform: 'none' },
              ],
              { duration: 1000, easing: suave, fill: 'backwards' },
            );
            magia?.animate(
              [
                { opacity: 0, transform: 'translateY(60px) scale(0.6)' },
                { opacity: 1, transform: 'none' },
              ],
              { duration: 900, delay: 350, easing: suave, fill: 'backwards' },
            );
            holo?.animate(
              [
                { opacity: 0, transform: 'translateY(40px) scaleY(0.2)' },
                { opacity: 0.9, transform: 'none', offset: 0.45 },
                { opacity: 0.2, offset: 0.55 },
                { opacity: 1, offset: 0.65 },
                { opacity: 0.4, offset: 0.75 },
                { opacity: 1 },
              ],
              { duration: 1000, delay: 600, easing: 'linear', fill: 'backwards' },
            );
          };
        }
        return;
      }
      const adelante = j > viejo;
      ocupado = true;
      libro.classList.toggle('abierto', j >= 0);
      for (const p of pliegos) p.classList.remove('entra');
      if (adelante) {
        vis[j].classList.add('entra', 'v-d');
        vis[viejo]?.classList.remove('v-d');
      } else {
        vis[j]?.classList.add('v-i');
        vis[viejo].classList.remove('v-i');
      }
      volar(Math.min(viejo, j), Math.max(viejo, j), adelante, () => {
        ocupado = false;
        i = j;
        pintar();
      });
      controles();
    };

    sincronizarLibro = () => {
      const actual = vis[i];
      vis = pliegos.filter((p) => !p.hidden);
      vis.forEach((p, k) => {
        p.querySelector('.pag-marca')!.textContent = String(k + 1).padStart(2, '0');
        p.querySelectorAll('.pag-n').forEach((n, c) => (n.textContent = String(2 * k + 2 + c).padStart(2, '0')));
      });
      for (const b of libro.querySelectorAll<HTMLElement>('[data-ir]'))
        b.parentElement!.hidden = !vis.some((p) => p.dataset.slug === b.dataset.ir);
      for (const f of libro.querySelectorAll<HTMLElement>('.ind-fam'))
        f.hidden = !vis.some((p) => p.dataset.grupo === f.querySelector<HTMLElement>('.fam')!.dataset.grupo);
      i = vis.length ? (vis.includes(actual) ? vis.indexOf(actual) : movil.matches || i >= 0 ? 0 : -1) : -1;
      pintar();
    };
    sincronizarLibro();

    tapa.addEventListener('click', () => ir(0));
    ant.addEventListener('click', () => ir(i - 1));
    sig.addEventListener('click', () => ir(i + 1));
    // El índice de la página izquierda: una familia abre sus series y cada serie lleva a su pliego
    libro.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-ir], .fam, [data-pasa]');
      if (!b || b.closest('.hoja')) return;
      if (b.dataset.pasa) return ir(i + Number(b.dataset.pasa));
      const k = b.dataset.ir
        ? vis.findIndex((p) => p.dataset.slug === b.dataset.ir)
        : vis.findIndex((p) => p.dataset.grupo === b.dataset.grupo);
      if (k >= 0) ir(k);
    });
    libro.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') ir(i - 1);
      else if (e.key === 'ArrowRight') ir(i + 1);
    });
  }

  // ——— Archivador de condiciones: una pestaña por documento ———
  const pestanas = [...document.querySelectorAll<HTMLButtonElement>('[data-archivo-tabs] .arch-tab')];
  const hojasArch = [...document.querySelectorAll<HTMLElement>('.arch-cuerpo > .doc')];
  if (pestanas.length === hojasArch.length && pestanas.length) {
    let act = 0;
    const elegir = (k: number, foco = false) => {
      act = k;
      sincronizarArchivo();
      if (foco) pestanas[k].focus();
    };
    sincronizarArchivo = () => {
      if (hojasArch[act].hidden)
        act = Math.max(
          hojasArch.findIndex((h) => !h.hidden),
          0,
        );
      pestanas.forEach((p, k) => {
        p.hidden = hojasArch[k].hidden;
        p.setAttribute('aria-selected', String(k === act));
        p.tabIndex = k === act ? 0 : -1;
        hojasArch[k].classList.toggle('activa', k === act);
      });
    };
    pestanas.forEach((p, k) => p.addEventListener('click', () => elegir(k)));
    pestanas[0].parentElement!.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      let k = act;
      do k = (k + dir + pestanas.length) % pestanas.length;
      while (hojasArch[k].hidden && k !== act);
      e.preventDefault();
      elegir(k, true);
    });
    sincronizarArchivo();
  }

  // ——— Excel de rotores, con los datos de la ficha ———
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-excel]'))
    b.addEventListener('click', () => {
      const slug = b.dataset.excel!;
      const x = docs[slug];
      const [c0, c1, c2, c3, c4] = t.columnas.split('|');
      excel({
        titulo: `${x.nombre}${x.variantes ? ` · ${x.variantes}` : ''} · ${t.rotores}`,
        tipo: t.rotores,
        fecha: hoy().texto,
        datos: [[t.etqEquipo, x.nombre]],
        cabecera: [{ t: c0 }, { t: c1 }, { t: c2, ud: 'rpm', num: true }, { t: c3, ud: 'x g', num: true }, { t: c4 }],
        filas: x.rotores.map((r) => [
          { t: r.c[0] },
          { t: r.c[1] },
          { t: r.c[2], n: Number(r.n[0]) || undefined },
          { t: r.c[3], n: Number(r.n[1]) || undefined },
          { t: r.c[4] },
        ]),
        archivo: `rotores-${slug}-orto-alresa`,
      });
    });

  // ——— Tu selección: en la dirección (?sel=) o en el navegador; un QR la abre en el móvil ———
  const CLAVE = 'oa-dossier';
  const params = new URLSearchParams(location.search);
  const venia = params.has('sel');
  const leer = (): string[] => {
    const url = params.get('sel');
    if (url !== null) return url.split(',').filter((s) => docs[s]);
    try {
      return (JSON.parse(guardado(CLAVE) ?? '[]') as string[]).filter((s) => docs[s]);
    } catch {
      return [];
    }
  };
  let sel = [...new Set(leer())];
  // Lo que abre el QR: con un solo documento, su PDF directamente; con varios, esta página con la selección
  const destinoQr = () => (sel.length === 1 ? docs[sel[0]].pdfs[0].url : enlace());
  const enlace = () => {
    const u = new URL(location.pathname, location.origin);
    if (sel.length) u.searchParams.set('sel', sel.join(','));
    return u.href.replace(/%2C/g, ',');
  };
  const bandeja = document.querySelector<HTMLElement>('#bandeja')!;
  const banQr = bandeja.querySelector<HTMLButtonElement>('.ban-qr')!;
  const banN = bandeja.querySelector<HTMLElement>('.ban-n')!;
  const dlg = document.querySelector<HTMLDialogElement>('#dossier')!;
  const lista = dlg.querySelector<HTMLOListElement>('.dos-lista')!;
  const dosQr = dlg.querySelector<HTMLElement>('#dos-qr')!;
  const pintarSel = () => {
    guardar(CLAVE, JSON.stringify(sel));
    history.replaceState(null, '', enlace() + location.hash);
    for (const b of document.querySelectorAll<HTMLButtonElement>('.sel')) {
      const si = sel.includes(b.dataset.sel!);
      b.setAttribute('aria-pressed', String(si));
      b.closest('.doc, .destacado')?.classList.toggle('elegido', si);
    }
    bandeja.hidden = !sel.length;
    document.body.classList.toggle('con-bandeja', sel.length > 0);
    banN.textContent = contar(datos.n.bandeja, sel.length);
    if (sel.length) {
      const qr = qrSvg(destinoQr(), '');
      banQr.innerHTML = qr;
      dosQr.innerHTML = `${qr}<i class="barrido"></i>`;
    }
    dlg.querySelector('#dos-tit')!.textContent = contar(datos.n.equipos, sel.length);
    dlg.classList.toggle('vacio', !sel.length);
    lista.innerHTML = sel
      .map((s) => {
        const x = docs[s];
        return `<li data-s="${s}"><span class="dl-pdf">PDF</span><div class="dl-txt">
          <b>${esc(x.nombre)}${x.variantes ? ` <span>${esc(x.variantes)}</span>` : ''}</b>
          <small>${esc(x.grupo)}</small>
          <div class="dl-pdfs">${x.pdfs
            .map(
              (p) =>
                `<a href="${esc(p.url)}" target="_blank" rel="noopener"><b>${p.l.toUpperCase()}</b> <span>${esc(p.peso)}</span></a>`,
            )
            .join('')}</div></div>
          <button type="button" class="dl-quitar" aria-label="${esc(t.quitar.replace('{x}', x.nombre))}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></li>`;
      })
      .join('');
  };
  for (const b of document.querySelectorAll<HTMLButtonElement>('.sel'))
    b.addEventListener('click', () => {
      const s = b.dataset.sel!;
      const entra = !sel.includes(s);
      sel = entra ? [...sel, s] : sel.filter((o) => o !== s);
      pintarSel();
      if (entra && !quieto) {
        bandeja.classList.remove('late');
        void bandeja.offsetWidth;
        bandeja.classList.add('late');
      }
    });
  lista.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('li');
    if (li && (e.target as HTMLElement).closest('.dl-quitar')) {
      sel = sel.filter((o) => o !== li.dataset.s);
      pintarSel();
    }
  });
  bandeja.querySelector('.ban-vaciar')!.addEventListener('click', () => {
    sel = [];
    pintarSel();
  });
  bandeja.querySelector('.ban-ver')!.addEventListener('click', () => dlg.showModal());
  banQr.addEventListener('click', () => dlg.showModal());
  dlg.querySelector('.dos-cerrar')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
  const copiar = async (texto: string, boton: HTMLButtonElement) => {
    try {
      await navigator.clipboard.writeText(texto);
      boton.textContent = t.copiado;
    } catch {
      window.prompt('', texto);
    }
  };
  const copiarDos = dlg.querySelector<HTMLButtonElement>('#dos-copiar')!;
  copiarDos.addEventListener('click', () => void copiar(enlace(), copiarDos));
  const compartir = dlg.querySelector<HTMLButtonElement>('#dos-compartir')!;
  if ('share' in navigator) {
    compartir.hidden = false;
    compartir.addEventListener('click', () => {
      void navigator.share({ title: document.title, url: enlace() }).catch(() => {});
    });
  }
  iniciarVistaPdf();
  dlg.querySelector('#dos-pdf')!.addEventListener('click', () => {
    if (!sel.length) return;
    const equipos = sel.map((s) => docs[s]);
    const todos = equipos.flatMap((e) => e.pdfs);
    const idiomas = [...new Set(todos.map((p) => p.l))].map((l) => datos.idiomas[l]);
    const f = hoy();
    void vistaPdf(
      () =>
        dossierPdf(
          {
            tipo: t.tipo,
            titulo: t.titulo,
            fecha: f.texto,
            datos: [
              [t.etqEquipos, String(equipos.length)],
              [t.etqCatalogos, String(todos.length)],
              [t.etqIdiomas, idiomas.join(' · ')],
            ],
            intro: t.intro,
            verFicha: t.verFicha,
            enlace: [t.enlace, enlace()],
            equipos,
          },
          datos.pie,
        ),
      `${t.archivo}-${f.archivo}`,
    );
  });
  pintarSel();
  if (venia && sel.length) dlg.showModal();

  // ——— Entradas al aparecer ———
  if (!quieto && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('visto');
          io.unobserve(e.target);
        }),
      { rootMargin: '0px 0px -6% 0px' },
    );
    document.documentElement.classList.add('animar');
    document.querySelectorAll<HTMLElement>('.doc, .destacado').forEach((el, i) => {
      el.style.setProperty('--retraso', `${(i % 4) * 60}ms`);
      io.observe(el);
    });
  }
</script>

<style>
  .descargas {
    --gris-fondo: #eceef0;
    background: var(--gris-fondo);
  }
  :global(body:has(.descargas)) {
    background: var(--gris-fondo, #eceef0);
  }
  /* La cabecera blanca se separa siempre de la portada */
  :global(body:has(.descargas) .top) {
    box-shadow: 0 8px 24px -10px rgba(21, 23, 25, 0.25);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  h1 b,
  h2 b {
    font-weight: 700;
  }
  .portada h1 b {
    color: var(--red);
  }

  /* ——— Portada: la foto del catálogo a la izquierda, el texto a la derecha sobre un velo gris ——— */
  .portada {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(82vh, 780px);
    display: flex;
    align-items: center;
    padding: clamp(64px, 8vw, 112px) 0;
    background: #d9dcdf;
  }
  .portada-foto {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 10% 50%;
    animation: acerca 28s ease-in-out infinite alternate;
  }
  @keyframes acerca {
    to {
      transform: scale(1.06) translateX(1%);
    }
  }
  .velo {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        270deg,
        rgba(236, 238, 240, 0.96) 0%,
        rgba(236, 238, 240, 0.86) 32%,
        rgba(236, 238, 240, 0.12) 52%,
        rgba(236, 238, 240, 0) 62%
      ),
      linear-gradient(180deg, transparent 70%, var(--gris-fondo) 100%);
  }
  .particulas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }
  .portada-in {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }
  .portada-txt {
    width: min(600px, 100%);
  }
  h1 {
    margin-top: 22px;
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.93;
  }
  .lead {
    margin-top: 20px;
    color: var(--body);
    font-size: var(--t-sub);
  }
  .busca {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 62px;
    margin-top: 30px;
    padding: 0 20px;
    background: rgba(255, 255, 255, 0.9);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 2px solid var(--ink);
    box-shadow: 0 22px 44px -28px rgba(21, 23, 25, 0.5);
    transition:
      border-color var(--dur-1) ease,
      box-shadow var(--dur-2) ease;
  }
  .busca:focus-within {
    border-bottom-color: var(--red);
  }
  .busca svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: none;
    stroke: var(--red);
    stroke-width: 2;
  }
  .busca input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    font: 300 clamp(19px, 1.8vw, 23px) var(--f);
  }
  .resumen {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ——— Índice: iconos de la marca, sin números ——— */
  .indice {
    background: #fff;
  }
  .indice ol {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-block: 0;
    list-style: none;
  }
  .indice li + li {
    border-left: 1px solid rgba(21, 23, 25, 0.08);
  }
  .indice a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 20px;
    text-decoration: none;
    border-radius: 14px 14px 0 0;
    overflow: hidden;
    transition: background var(--dur-2) ease;
  }
  .indice a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .indice a:hover {
    background: #f7f8f8;
  }
  .indice a:hover::after {
    transform: scaleX(1);
  }
  .ind-ico {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 14px;
    background: var(--gris-fondo);
    transition:
      background var(--dur-2) ease,
      transform var(--dur-3) var(--ease-out);
  }
  /* Todos los iconos con el mismo trazo oscuro (el del teléfono venía en rojo): se pintan como máscara */
  .ind-ico::before {
    content: '';
    width: 26px;
    height: 26px;
    background: #333;
    -webkit-mask: var(--ico) center / contain no-repeat;
    mask: var(--ico) center / contain no-repeat;
    transition: background var(--dur-2) ease;
  }
  .indice a:hover .ind-ico {
    background: var(--red);
    transform: rotate(-6deg);
  }
  .indice a:hover .ind-ico::before {
    background: #fff;
  }
  .ind-txt b {
    display: block;
    font-size: 18px;
    line-height: 1.1;
  }
  .ind-txt small {
    font-size: 14px;
    color: var(--muted);
  }

  /* ——— Catálogo general ——— */
  .destacado {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    margin-top: clamp(56px, 7vw, 104px);
    background: #fff;
  }
  .des-foto {
    position: relative;
    overflow: hidden;
    min-height: 460px;
  }
  .des-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 8% 60%;
    transition: transform 1.2s var(--ease-out);
  }
  .destacado:hover .des-foto img {
    transform: scale(1.05);
  }
  .des-foto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-left: 6px solid var(--red);
    background: linear-gradient(90deg, transparent 75%, #fff 100%);
  }
  .des-txt {
    align-self: center;
    padding: clamp(40px, 5vw, 80px) clamp(24px, 5vw, 80px) clamp(40px, 5vw, 80px) clamp(16px, 2vw, 32px);
  }
  .des-txt h2 {
    margin-top: 16px;
    font-size: clamp(44px, 5vw, 76px);
    line-height: 0.92;
  }
  .des-txt > p {
    margin-top: 16px;
    max-width: 38ch;
    color: var(--body);
    font-size: var(--t-sub);
  }
  /* Datos del documento como insignias de logro: medalla redonda con su icono y, al lado, valor y etiqueta */
  .ficha-doc {
    display: flex;
    flex-wrap: wrap;
    gap: 18px clamp(22px, 3vw, 40px);
    margin: 30px 0 0;
  }
  .ficha-doc div {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-areas: 'ico dd' 'ico dt';
    column-gap: 14px;
    align-items: center;
    align-content: center;
  }
  .fd-ico {
    grid-area: ico;
    position: relative;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, #f2262c, var(--red) 60%, #b40308);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 8px 14px -8px rgba(221, 4, 10, 0.85);
    transition:
      scale var(--dur-2) var(--ease-out),
      rotate var(--dur-2) var(--ease-out);
  }
  .fd-ico::before {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1.5px dashed rgba(221, 4, 10, 0.55);
    transition: rotate var(--dur-4) var(--ease-out);
  }
  .fd-ico svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: #fff;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (hover: hover) and (pointer: fine) {
    .ficha-doc div:hover .fd-ico {
      scale: 1.1;
      rotate: -8deg;
    }
    .ficha-doc div:hover .fd-ico::before {
      rotate: 180deg;
    }
  }
  .ficha-doc dt {
    grid-area: dt;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ficha-doc dd {
    grid-area: dd;
    margin: 0;
    font-weight: 700;
    font-size: 23px;
    line-height: 1.1;
  }
  .acc {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  /* ——— Secciones: el título con la barra roja que crece al llegar a él ——— */
  .seccion {
    padding-top: clamp(64px, 8vw, 112px);
    scroll-margin-top: 60px;
  }
  .sec-cab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 10px 40px;
    align-items: end;
    padding-top: 30px;
    margin-bottom: 32px;
  }
  .sec-cab h2 {
    position: relative;
    font-weight: 300;
    font-size: clamp(34px, 3.6vw, 54px);
    line-height: 0.95;
  }
  .sec-cab h2::before {
    content: '';
    position: absolute;
    top: 0.08em;
    bottom: 0.08em;
    left: calc(-1 * clamp(12px, 1.4vw, 22px));
    width: 4px;
    background: var(--red);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-4) var(--ease-out);
  }
  .actual .sec-cab h2::before {
    transform: scaleY(1);
  }
  .sec-cab p {
    max-width: 44ch;
    color: var(--body);
    font-size: 18px;
  }
  :is(.sec-catalogo, .sec-equipos, .sec-servicio, .sec-condiciones) .sec-cab p {
    max-width: none;
  }
  @media (min-width: 1100px) {
    :is(.sec-catalogo, .sec-equipos, .sec-servicio, .sec-condiciones) .sec-cab p {
      white-space: nowrap;
    }
    :is(.sec-servicio, .sec-condiciones) .sec-cab {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
  :global(html.animar) :is(.doc, .destacado) {
    opacity: 0;
    translate: 0 22px;
  }
  :global(html.animar) :is(.doc, .destacado).visto {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.7s var(--ease-out) var(--retraso, 0ms),
      translate 0.7s var(--ease-out) var(--retraso, 0ms);
  }
  .nuevo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: 10px;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
  }
  .nuevo::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--red);
  }
  /* Formato, peso y fecha: cada dato en su pastilla con su icono */
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
  }
  .dato {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 8px;
    border-radius: 999px;
    background: rgba(21, 23, 25, 0.06);
    font-weight: 700;
    line-height: 1.2;
    color: var(--body);
  }
  .dato svg {
    width: 15px;
    height: 15px;
    flex: none;
    fill: none;
    stroke: var(--red);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Botones de descarga: barrido de abajo arriba */
  .doc-acc {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .pdf {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border-radius: 10px;
    font: 700 14px/1 var(--f);
    text-decoration: none;
    cursor: pointer;
  }
  .pdf svg,
  .sel svg,
  .boton svg {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .sel.mini {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-left: auto;
    border-radius: 10px;
    cursor: pointer;
  }
  .sel .ok,
  .sel[aria-pressed='true'] .mas {
    display: none;
  }
  .sel[aria-pressed='true'] .ok {
    display: inline;
  }
  .sel[hidden],
  .xlsx[hidden] {
    display: none;
  }

  /* — Catálogos generales: portadas con fotos distintas; la información sube al pasar — */
  .portadas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-block: 0;
    list-style: none;
  }
  .portada-doc {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--carbon);
    color: #fff;
  }
  .portada-doc > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.3);
    transition:
      transform 1s var(--ease-out),
      filter var(--dur-3) ease;
  }
  .portada-doc::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(21, 23, 25, 0.05) 35%, rgba(21, 23, 25, 0.9) 100%);
  }
  .portada-doc::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 5px;
    background: var(--red);
    transform: scaleY(0.25);
    transform-origin: bottom;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .pd-cab {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    padding: 22px 22px 24px;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .pd-cab h3 {
    margin-top: 6px;
    font-size: clamp(22px, 1.9vw, 28px);
    line-height: 1;
  }
  .portada-doc .nuevo {
    color: #fff;
  }
  .pd-info {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: grid;
    gap: 10px;
    padding: 20px 22px 22px;
    background: rgba(21, 23, 25, 0.93);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-top: 2px solid var(--red);
    color: #fff;
    transform: translateY(101%);
    transition: transform var(--dur-3) var(--ease-out);
  }
  .pd-info p:not(.pd-stats) {
    font-size: 15px;
    color: var(--on-dark);
  }
  /* Tamaño y fecha: dos cifras grandes separadas por una regla, sin cajas ni iconos */
  .pd-stats {
    display: grid;
    grid-template-columns: auto 1fr;
    margin: 0;
  }
  .pd-stats span {
    display: grid;
    gap: 3px;
    padding-right: 18px;
  }
  .pd-stats span + span {
    padding: 0 0 0 18px;
    border-left: 1px solid var(--carbon-line);
  }
  .pd-stats small {
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--steel);
  }
  .pd-stats b {
    font-size: 20px;
    line-height: 1.1;
    color: #fff;
  }
  .pd-info .doc-acc {
    flex-wrap: nowrap;
  }
  .pd-info .pdf {
    flex: 1;
    justify-content: center;
  }
  .pd-info .sel.mini {
    margin-left: 0;
    flex: none;
  }
  .portada-doc:hover > img,
  .portada-doc:focus-within > img {
    transform: scale(1.08);
    filter: none;
  }
  .portada-doc:hover::after,
  .portada-doc:focus-within::after,
  .portada-doc.elegido::after {
    transform: none;
  }
  .portada-doc:hover .pd-info,
  .portada-doc:focus-within .pd-info {
    transform: none;
  }
  .portada-doc:hover .pd-cab,
  .portada-doc:focus-within .pd-cab {
    transform: translateY(-116px);
  }

  /* — Tarjetas de cristal: equipos, servicio técnico y condiciones — */
  /* Detrás, manchas de luz suaves que se mueven: es lo que hace que el cristal se note */
  .sec-equipos,
  .sec-servicio,
  .sec-condiciones {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .sec-equipos::before,
  .sec-equipos::after,
  .sec-servicio::before,
  .sec-condiciones::after {
    content: '';
    position: absolute;
    z-index: -1;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
    animation: deriva 24s ease-in-out infinite alternate;
  }
  .sec-equipos::before {
    top: 10%;
    left: -140px;
    background: rgba(120, 132, 142, 0.22);
  }
  .sec-equipos::after {
    bottom: 5%;
    right: -120px;
    background: rgba(120, 132, 142, 0.35);
    animation-duration: 30s;
  }
  .sec-servicio::before {
    top: 20%;
    right: -100px;
    background: rgba(120, 132, 142, 0.2);
  }
  .sec-condiciones::after {
    bottom: 0;
    left: -120px;
    background: rgba(120, 132, 142, 0.3);
  }
  @keyframes deriva {
    to {
      transform: translate(60px, -40px) scale(1.15);
    }
  }
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin-block: 0;
    padding-block: 0;
    list-style: none;
  }
  .t-servicio {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
    counter-reset: paso;
  }
  /* Servicio técnico como un recorrido de tres pasos unidos por una flecha de la marca */
  .paso {
    padding: 26px 24px 22px;
    overflow: visible;
  }
  .paso-n {
    position: absolute;
    right: 20px;
    top: 14px;
    font-weight: 700;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(21, 23, 25, 0.16);
    transition: -webkit-text-stroke-color var(--dur-3) ease;
  }
  .paso:hover .paso-n {
    -webkit-text-stroke-color: var(--red);
  }
  .paso h3 {
    margin-top: 10px;
    font-size: 26px;
    line-height: 1;
  }
  .paso .insignia {
    width: 54px;
    height: 54px;
    border-radius: 16px;
  }
  .paso .cab-tarjeta {
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
  }
  .paso .chips:empty {
    display: none;
  }
  .paso .chips {
    justify-content: flex-start;
  }
  .paso .doc-acc {
    gap: 8px;
  }
  .paso .pdf {
    height: 40px;
    padding: 0 18px 0 14px;
  }
  .paso .sel.mini {
    width: 40px;
    height: 40px;
    margin-left: 0;
  }
  .paso:not(:last-child)::after {
    content: '»';
    position: absolute;
    top: 50%;
    right: -36px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    translate: 0 -50%;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    font-weight: 700;
    font-size: 20px;
    line-height: 1;
    box-shadow: 0 8px 16px -8px rgba(221, 4, 10, 0.7);
  }
  .vidrio {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    background: rgba(255, 255, 255, 0.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 16px 40px -28px rgba(21, 23, 25, 0.45);
    transition:
      transform var(--dur-3) var(--ease-out),
      background var(--dur-2) ease,
      box-shadow var(--dur-3) ease;
  }
  /* Al pasar: sube, se aclara y se enciende el filo rojo de arriba */
  .vidrio::before {
    content: '';
    position: absolute;
    inset: -1px -1px auto;
    height: 3px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .vidrio:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.78);
    box-shadow:
      0 1px 0 #fff inset,
      0 28px 50px -28px rgba(21, 23, 25, 0.5);
  }
  .vidrio:hover::before,
  .vidrio.elegido::before {
    transform: scaleX(1);
  }
  .vidrio.elegido {
    background: rgba(255, 255, 255, 0.85);
  }
  .cab-tarjeta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }
  /* La insignia: el icono de la marca en blanco sobre un cuadro rojo */
  .insignia {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex: none;
    background: linear-gradient(135deg, var(--red), var(--red-d));
    box-shadow: 0 10px 20px -10px rgba(221, 4, 10, 0.7);
    transition: transform var(--dur-3) var(--ease-out);
  }
  .insignia img {
    width: 24px;
    height: 24px;
    filter: brightness(0) invert(1);
  }
  .vidrio:hover .insignia {
    transform: rotate(-8deg) scale(1.06);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
  }
  .chip {
    padding: 4px 8px;
    border: 1px solid rgba(21, 23, 25, 0.14);
    background: rgba(255, 255, 255, 0.7);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--body);
  }
  .chip.rojo {
    border-color: var(--red);
    background: var(--red);
    color: #fff;
  }
  .chip.verde {
    border-color: rgba(30, 127, 92, 0.4);
    color: #1e7f5c;
  }
  .vidrio h3,
  .vidrio h4 {
    font-size: 22px;
    line-height: 1.05;
  }
  .vidrio h4 a {
    text-decoration: none;
  }
  .vidrio h4 a:hover {
    color: var(--red);
  }
  .vidrio h4 span {
    margin-left: 0.3em;
    font-weight: 300;
    color: var(--muted);
  }
  .eq-frase {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.3;
    color: var(--body);
  }
  .vidrio .meta {
    margin-top: auto;
    padding-top: 4px;
  }
  .vidrio .doc-acc {
    margin-top: 10px;
    padding-top: 12px;
    border-top: 1px solid rgba(21, 23, 25, 0.08);
  }
  /* Condiciones y políticas: un archivador con una pestaña por documento */
  .arch-tabs,
  .arch-cuerpo {
    width: calc(100% - 2 * var(--gut));
    max-width: calc(var(--wrap) - 2 * var(--gut));
    margin-inline: auto;
  }
  .arch-tabs {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    margin-top: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .arch-tab {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: baseline;
    gap: 10px;
    margin-bottom: -1px;
    padding: 14px 22px 12px;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    background: #e9eaec;
    color: var(--body);
    font: 700 17px/1 var(--f);
    cursor: pointer;
    translate: 0 5px;
    transition:
      translate var(--dur-2) var(--ease-out),
      background var(--dur-2) ease,
      color var(--dur-2) ease;
  }
  .arch-tab i {
    font-style: normal;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .arch-tab[hidden] {
    display: none;
  }
  .arch-tab:hover {
    translate: 0 1px;
    color: var(--red);
  }
  .arch-tab[aria-selected='true'] {
    z-index: 2;
    translate: 0 0;
    padding-top: 15px;
    border-top: 3px solid var(--red);
    background: #fff;
    color: var(--carbon);
  }
  .arch-tab[aria-selected='true'] i {
    color: var(--red);
  }
  .arch-tab:focus-visible {
    outline: var(--foco);
    outline-offset: -3px;
  }
  .arch-cuerpo {
    position: relative;
    z-index: 1;
    display: block;
    border: 1px solid var(--line);
    border-radius: 0 22px 22px 22px;
    background: #fff;
    box-shadow: 0 30px 60px -44px rgba(21, 23, 25, 0.55);
  }
  .fila {
    position: relative;
    display: none;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: clamp(28px, 3vw, 44px);
    row-gap: 14px;
    min-height: clamp(260px, 24vw, 320px);
    padding: clamp(40px, 4.5vw, 64px) clamp(28px, 4.5vw, 64px);
    overflow: hidden;
  }
  .fila.activa:not([hidden]) {
    display: grid;
    animation: hoja-arch 0.5s var(--ease-out);
  }
  @keyframes hoja-arch {
    from {
      opacity: 0;
      translate: 18px 0;
    }
  }
  :global(html.animar) .arch-cuerpo .doc {
    opacity: 1;
    translate: none;
  }
  /* El número del documento, de fondo, como el sello de una carpeta */
  .fila .paso-n {
    position: absolute;
    right: clamp(170px, 24vw, 360px);
    top: 50%;
    translate: 0 -50%;
    font-size: clamp(140px, 16vw, 230px);
    line-height: 1;
    -webkit-text-stroke-width: 1.5px;
    -webkit-text-stroke-color: rgba(21, 23, 25, 0.1);
    pointer-events: none;
  }
  .fila .cab-tarjeta {
    grid-column: 1;
    grid-row: 1 / span 2;
    margin: 0;
  }
  .fila .insignia {
    width: clamp(72px, 7vw, 96px);
    height: clamp(72px, 7vw, 96px);
    border-radius: 24px;
  }
  .fila .insignia img {
    width: 40%;
    height: 40%;
  }
  .fila .chips:empty {
    display: none;
  }
  .fila h3,
  .fila .meta {
    grid-column: 2;
    position: relative;
    z-index: 1;
  }
  .fila h3 {
    align-self: end;
    max-width: 20ch;
    font-size: clamp(30px, 3.3vw, 46px);
    line-height: 1;
  }
  .fila .meta {
    align-self: start;
    margin-top: 0;
  }
  .fila .doc-acc {
    grid-column: 3;
    grid-row: 1 / span 2;
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0;
    border: 0;
    gap: 8px;
  }
  .fila .pdf {
    height: 50px;
    padding: 0 24px 0 20px;
    font-size: 17px;
  }
  .fila .sel.mini {
    width: 50px;
    height: 50px;
    margin-left: 0;
  }
  /* Servicio técnico y condiciones: insignias y chips más redondeados; los botones, los de toda la web */
  .tarjetas.vidrio,
  .tarjetas .vidrio {
    border-radius: 18px;
  }
  .tarjetas .vidrio::before {
    inset: 0 18px auto;
    height: 3px;
    border-radius: 0 0 3px 3px;
  }
  .tarjetas .insignia {
    border-radius: 14px;
  }
  .tarjetas .chip {
    padding: 4px 10px;
    border-radius: 999px;
  }
  .tarjetas .sel.mini {
    margin-left: 0;
  }

  /* — El libro de catálogos de cada equipo: tapa que se abre y un pliego por serie — */
  .libro-caja {
    padding-bottom: 96px;
  }
  .libro {
    --papel: #f0ede6;
    --alto: clamp(500px, 44vw, 620px);
    position: relative;
    width: min(100%, 1120px);
    height: var(--alto);
    margin-inline: auto;
    perspective: 2600px;
  }
  .libro.js {
    transition: translate 0.55s var(--ease-out);
  }
  .libro.js:not(.abierto) {
    translate: -25% 0;
  }
  .libro-fondo {
    position: absolute;
    inset: -14px -16px -20px;
    border-radius: 10px;
    background: var(--carbon);
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .libro.abierto .libro-fondo {
    opacity: 1;
  }
  .libro:not(.js) .libro-fondo,
  .libro:not(.js) .tapa-fija,
  .libro:not(.js) .hoja,
  .libro:not(.js) .libro-nav {
    display: none;
  }
  .pliegos {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pliego {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .pliego .pag {
    pointer-events: auto;
  }
  :global(html.animar) .pliego {
    opacity: 1;
    translate: none;
  }
  .pliego:not(.v-i) .izq,
  .pliego:not(.v-d) .der {
    display: none;
  }

  /* Cada página: papel con la sombra del lomo y el canto de las hojas */
  .pag {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--papel);
    color: var(--ink);
  }
  .pag.izq {
    left: 0;
    padding: 36px 40px 28px 44px;
    border-radius: 6px 0 0 6px;
    background: linear-gradient(90deg, transparent 80%, rgba(21, 23, 25, 0.08)), var(--papel);
    box-shadow:
      -2px 2px 0 #ebe8e2,
      -4px 4px 0 #dedad3,
      -6px 6px 0 #d0ccc4;
  }
  .pag.der {
    right: 0;
    padding: 36px 44px 28px 40px;
    border-radius: 0 6px 6px 0;
    background: linear-gradient(270deg, transparent 80%, rgba(21, 23, 25, 0.08)), var(--papel);
    box-shadow:
      2px 2px 0 #ebe8e2,
      4px 4px 0 #dedad3,
      6px 6px 0 #d0ccc4;
  }
  .pag-grupo {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
  }
  /* El índice: familias que se abren en sus series */
  .indlib {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .fam {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 11px 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--ink);
    font: 700 17px/1.1 var(--f);
    text-align: left;
    cursor: pointer;
    transition: color var(--dur-1) ease;
  }
  .fam span {
    margin-left: auto;
    font-size: 13px;
    color: var(--muted);
  }
  .fam::after {
    content: '»';
    color: var(--red);
    transition: rotate var(--dur-2) var(--ease-out);
  }
  .ind-fam.abierta .fam {
    color: var(--red);
  }
  .ind-fam.abierta .fam::after {
    rotate: 90deg;
  }
  .fam:hover {
    color: var(--red);
  }
  .indlib ul {
    display: grid;
    gap: 1px;
    margin: 6px 0 10px 2px;
    padding: 0 0 0 12px;
    border-left: 2px solid var(--red);
    list-style: none;
  }
  .indlib ul button {
    display: flex;
    align-items: baseline;
    gap: 8px;
    width: 100%;
    padding: 6px 8px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--body);
    font: 300 16px/1.2 var(--f);
    text-align: left;
    cursor: pointer;
    transition:
      background var(--dur-1) ease,
      color var(--dur-1) ease;
  }
  .indlib ul button small {
    font-size: 13px;
    color: var(--muted);
  }
  .indlib ul button:hover {
    background: rgba(221, 4, 10, 0.08);
    color: var(--red);
  }
  .indlib ul button[aria-current='true'] {
    background: rgba(221, 4, 10, 0.1);
    color: var(--red);
    font-weight: 700;
  }
  .fam:focus-visible,
  .indlib ul button:focus-visible {
    outline: var(--foco);
    outline-offset: 2px;
  }
  .pag-pie {
    margin-top: auto;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .der .pag-pie {
    margin-top: 0;
    text-align: right;
  }
  .pliego h4 {
    font-weight: 700;
    font-size: clamp(30px, 3.2vw, 46px);
    line-height: 1;
  }
  .pliego h4 a {
    text-decoration: none;
  }
  .pliego h4 a:hover {
    color: var(--red);
  }
  .pliego h4 span {
    margin-left: 0.3em;
    font-weight: 300;
    color: var(--muted);
  }
  .pliego .eq-frase {
    display: block;
    overflow: visible;
    font-size: 18px;
    line-height: 1.35;
  }
  .pliego .chips {
    justify-content: flex-start;
  }
  .pliego .doc-acc {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .pliego .pdf:not(.xlsx) {
    padding: 0 18px;
  }
  .pliego.elegido .der::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--red);
  }

  /* La tapa: carbón con el lomo rojo; al pasar el ratón se entreabre */
  .tapa-fija {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    width: 50%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
    text-align: left;
    cursor: pointer;
    perspective: 1800px;
  }
  .libro.abierto .tapa-fija,
  .libro.volteando .tapa-fija {
    visibility: hidden;
  }
  .tapa-in {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 44px 48px 40px 56px;
    border-radius: 4px 12px 12px 4px;
    background: var(--carbon);
    box-shadow:
      inset 14px 0 0 var(--red),
      inset 16px 0 0 rgba(0, 0, 0, 0.28),
      5px 5px 0 #26292c;
    transform-origin: left center;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .tapa-in img {
    width: 160px;
    height: auto;
  }
  .tapa-tit {
    font-weight: 300;
    font-size: clamp(34px, 4vw, 58px);
    line-height: 0.95;
  }
  .tapa-tit b {
    display: block;
  }
  .tapa-pie {
    display: grid;
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--carbon-line);
  }
  .tapa-pie small {
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--steel);
  }
  .tapa-abrir {
    font-weight: 700;
    font-size: 17px;
  }
  .tapa-abrir::after {
    content: '»';
    margin-left: 8px;
    color: var(--red-on-dark);
  }
  /* Detrás de la tapa, la primera hoja: al pasar el ratón la tapa se entreabre, sale luz por la rendija y el libro suelta chispas */
  .tapa-fija::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0 6px 6px 0;
    background: var(--papel);
    box-shadow:
      3px 3px 0 #ebe8e2,
      6px 6px 0 #d0ccc4;
    transition: box-shadow var(--dur-3) ease;
  }
  .magia {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
  }
  .magia {
    perspective: 700px;
  }
  .magia i {
    position: absolute;
    bottom: 34%;
    left: var(--x);
    width: var(--z);
    height: calc(var(--z) * 1.3);
    border: 1px solid #cdc8bd;
    border-radius: 2px 5px 2px 5px;
    background: linear-gradient(135deg, #fffdf7, var(--papel));
    box-shadow:
      0 0 10px 1px rgba(221, 4, 10, 0.22),
      0 4px 8px -2px rgba(21, 23, 25, 0.3);
    opacity: 0;
  }
  .magia i:nth-child(4n) {
    border-color: var(--red);
    background: linear-gradient(135deg, #fff, #ffe3e4);
  }
  .magia b {
    position: absolute;
    bottom: 34%;
    left: var(--x);
    width: var(--z);
    height: var(--z);
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 8px 2px rgba(221, 4, 10, 0.4);
    opacity: 0;
  }
  .magia b:nth-child(3n) {
    background: var(--steel);
    box-shadow: 0 0 8px 2px rgba(120, 132, 142, 0.35);
  }
  .libro.js:not(.abierto) .tapa-fija .magia b {
    animation: mota var(--t) ease-out var(--r) infinite;
  }
  @keyframes mota {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    20% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      translate: var(--w) var(--h);
    }
  }
  /* Con el libro cerrado se ve un libro abierto de frente, del que sale la luz */
  .intro-libro {
    position: absolute;
    left: 50%;
    bottom: 0;
    display: none;
    width: 190%;
    height: auto;
    translate: -50% 0;
    overflow: visible;
  }
  .libro.js:not(.abierto):not(.volteando) .intro-libro {
    display: block;
  }
  .libro.js:not(.abierto):not(.volteando) .tapa-fija::after,
  .libro.js:not(.abierto):not(.volteando) .pliegos::after,
  .libro.js:not(.abierto):not(.volteando) .tapa-in,
  .libro.js:not(.abierto):not(.volteando) .tapa-fija::before {
    visibility: hidden;
  }
  .il-halo {
    opacity: 0.6;
    animation: il-respira 3.4s ease-in-out infinite alternate;
  }
  .il-tapa,
  .il-lomo {
    fill: var(--carbon);
  }
  .il-tapa {
    stroke: var(--red);
    stroke-width: 2;
  }
  .il-bloque {
    fill: #d8d2c6;
  }
  .il-canto {
    fill: none;
    stroke: #bdb6a8;
    stroke-width: 0.8;
  }
  .il-hoja,
  .il-ala {
    fill: url(#il-papel);
    stroke: #d2ccc0;
    stroke-width: 1;
  }
  .il-ala {
    transform-box: view-box;
    transform-origin: 500px 252px;
    animation: il-aleteo 2.6s ease-in-out infinite alternate;
  }
  .il-ala.a1 {
    --lo: -6deg;
    --a: 6deg;
  }
  .il-ala.a2 {
    --lo: 11deg;
    --a: 22deg;
    animation-duration: 3.1s;
    animation-delay: -1.2s;
  }
  .il-ala.a3 {
    --lo: 27deg;
    --a: 38deg;
    animation-duration: 3.7s;
    animation-delay: -2.3s;
  }
  @keyframes il-aleteo {
    from {
      transform: rotate(var(--lo));
    }
    to {
      transform: rotate(var(--a));
    }
  }
  /* Al pasar el ratón, una ráfaga de viento: las hojas se agitan y todo lo que vuela se acelera hacia un lado */
  @media (hover: hover) and (pointer: fine) {
    .libro.js .tapa-fija:hover .il-ala {
      animation-duration: 0.42s;
    }
    .libro.js:not(.abierto) .tapa-fija:hover .magia i,
    .libro.js:not(.abierto) .tapa-fija:hover .magia b {
      animation-duration: calc(var(--t) * 0.4);
    }
    .libro.js:not(.abierto) .tapa-fija:hover .magia {
      animation: rafaga 0.8s ease-in-out infinite alternate;
    }
  }
  @keyframes rafaga {
    from {
      translate: -14px 0;
      skew: 4deg 0;
    }
    to {
      translate: 26px -6px;
      skew: -6deg 0;
    }
  }
  @keyframes il-respira {
    to {
      opacity: 0.85;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .il-ala,
    .il-halo {
      animation: none;
    }
  }
  /* El holograma: sobre el libro cerrado se proyecta el título del catálogo, como un haz de luz */
  .holo {
    position: absolute;
    z-index: 3;
    bottom: 50%;
    left: 50%;
    display: none;
    width: min(150%, 760px);
    height: 230px;
    translate: -50% 0;
    place-content: end center;
    justify-items: center;
    gap: 6px;
    padding-bottom: 22px;
    text-align: center;
    clip-path: polygon(22% 100%, 78% 100%, 100% 0, 0 0);
    background:
      repeating-linear-gradient(0deg, rgba(21, 23, 25, 0.14) 0 1px, transparent 1px 5px),
      linear-gradient(0deg, rgba(21, 23, 25, 0.26), rgba(21, 23, 25, 0.02));
    color: var(--ink);
    pointer-events: none;
    animation: holo 4.5s ease-in-out infinite;
  }
  .libro.js:not(.abierto) .holo {
    display: grid;
  }
  .holo img {
    width: 130px;
    height: auto;
    margin-bottom: 6px;
    opacity: 0.92;
  }
  .holo small {
    color: var(--red);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .holo b {
    font-weight: 300;
    font-size: clamp(24px, 2.5vw, 34px);
    line-height: 1.05;
    white-space: nowrap;
  }
  .holo small::after {
    content: '»';
    margin-left: 10px;
    font-weight: 700;
  }
  @keyframes holo {
    0%,
    100% {
      opacity: 0.9;
      translate: -50% 0;
    }
    47% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
    52% {
      opacity: 1;
    }
    55% {
      translate: -50% -8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .holo,
    .magia i,
    .magia b {
      animation: none;
    }
  }
  @keyframes chispa {
    0% {
      opacity: 0;
      transform: rotateX(0) rotateY(0);
      translate: 0 0;
      rotate: 0deg;
      scale: 0.5;
    }
    15% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: rotateX(540deg) rotateY(200deg);
      translate: var(--w) var(--h);
      rotate: var(--g);
      scale: 1.1;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .tapa-fija:hover .tapa-in,
    .tapa-fija:focus-visible .tapa-in {
      transform: rotateY(-32deg);
    }
    .tapa-fija:hover::before,
    .tapa-fija:focus-visible::before {
      box-shadow:
        3px 3px 0 #ebe8e2,
        6px 6px 0 #d0ccc4,
        0 0 60px 6px rgba(255, 82, 87, 0.55);
    }
    .tapa-fija:hover .magia i,
    .tapa-fija:focus-visible .magia i {
      animation: chispa var(--t) ease-out var(--r) infinite;
    }
  }
  /* Con el libro cerrado, como la pantalla de inicio de un videojuego: del libro emanan luz y chispas todo el rato */
  .libro.js:not(.abierto) .tapa-fija .magia i {
    animation: chispa var(--t) ease-out var(--r) infinite;
  }
  .tapa-fija:focus-visible {
    outline: var(--foco);
    outline-offset: 6px;
  }

  /* La hoja que se pasa: gira sobre el lomo, con otra cara por detrás */
  .hoja {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: 5;
    width: 50%;
    transform-origin: left center;
    transform-style: preserve-3d;
    pointer-events: none;
  }
  .hoja[hidden] {
    display: none;
  }
  .cara {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .cara.tr {
    transform: rotateY(180deg);
  }
  .cara > .pag,
  .cara > .tapa-in {
    position: absolute;
    inset: 0;
    width: auto;
  }
  .cara > .tapa-in {
    transform: none !important;
  }

  .libro-nav {
    position: absolute;
    top: calc(100% + 38px);
    left: 50%;
    display: flex;
    align-items: center;
    gap: 18px;
    translate: -50% 0;
    transition: opacity 0.4s ease;
  }
  .libro:not(.abierto) .libro-nav {
    opacity: 0;
    pointer-events: none;
  }
  .cuenta {
    min-width: 64px;
    text-align: center;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.1em;
    color: var(--body);
  }
  .pasa {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(21, 23, 25, 0.22);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    transition:
      background var(--dur-1) ease,
      border-color var(--dur-1) ease,
      color var(--dur-1) ease,
      translate 0.25s ease,
      box-shadow 0.25s ease,
      opacity var(--dur-1) ease;
  }
  .pasa svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pasa:disabled {
    opacity: 0.35;
    cursor: default;
  }
  @media (hover: hover) and (pointer: fine) {
    .pasa:not(:disabled):hover {
      border-color: rgba(221, 4, 10, 0.3);
      color: var(--red);
      background: #fdecec;
      translate: 0 -1px;
      box-shadow: 0 8px 16px -10px rgba(221, 4, 10, 0.7);
    }
  }
  .pasa:focus-visible {
    outline: var(--foco);
    outline-offset: 2px;
  }

  /* Sin JavaScript: los pliegos, uno debajo de otro */
  .libro:not(.js) {
    height: auto;
  }
  .libro:not(.js) .pliegos {
    position: static;
    display: grid;
    gap: 36px;
  }
  .libro:not(.js) .pliego {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 460px;
  }
  .libro:not(.js) .pliego .pag {
    position: relative;
    display: flex;
    width: auto;
  }

  @media (max-width: 759px) {
    .libro-caja {
      padding-bottom: 24px;
    }
    .libro.js {
      height: auto;
      perspective: none;
      translate: none !important;
    }
    .libro.js .libro-fondo,
    .libro.js .tapa-fija,
    .libro.js .hoja {
      display: none;
    }
    .libro.js .pliegos,
    .libro.js .pliego {
      position: relative;
      inset: auto;
    }
    .libro.js .pag {
      position: relative;
      width: auto;
      padding: 24px 20px;
      border-radius: 0;
      box-shadow: none;
      background: var(--papel);
    }
    .esquina,
    .pag-marca {
      display: none;
    }
    .libro.js .libro-nav {
      position: static;
      justify-content: center;
      margin-top: 22px;
      translate: none;
    }
    .libro.js:not(.abierto) .libro-nav {
      opacity: 1;
      pointer-events: auto;
    }
    .pliego .doc-acc {
      margin-top: 8px;
    }
  }

  /* — Más vida: la tapa en neón y flotando, y las páginas con cinta, marca de agua, lomo y esquina que se dobla — */
  .tapa-fija {
    animation: flota 5.5s ease-in-out infinite alternate;
  }
  @keyframes flota {
    to {
      translate: 0 -8px;
    }
  }
  .tapa-in {
    animation: latido 3.6s ease-in-out infinite;
  }
  @keyframes latido {
    0%,
    100% {
      box-shadow:
        inset 14px 0 0 var(--red),
        inset 16px 0 0 rgba(0, 0, 0, 0.28),
        5px 5px 0 #26292c,
        0 0 0 rgba(221, 4, 10, 0);
    }
    50% {
      box-shadow:
        inset 14px 0 0 var(--red),
        inset 16px 0 0 rgba(0, 0, 0, 0.28),
        5px 5px 0 #26292c,
        0 0 46px rgba(221, 4, 10, 0.35);
    }
  }
  .cara,
  .cara * {
    animation: none !important;
  }
  .tapa-tit {
    color: #fff;
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.22);
  }
  .tapa-tit b {
    color: #ff4a50;
    text-shadow:
      0 0 4px rgba(255, 74, 80, 0.7),
      0 0 12px rgba(221, 4, 10, 0.6),
      0 0 26px rgba(221, 4, 10, 0.35);
    animation: neon 6.5s linear infinite;
    transition: text-shadow var(--dur-3) ease;
  }
  @keyframes neon {
    0%,
    18%,
    22%,
    54%,
    57%,
    100% {
      opacity: 1;
    }
    20%,
    55% {
      opacity: 0.72;
    }
    21% {
      opacity: 0.92;
    }
  }
  .tapa-abrir {
    transition:
      color var(--dur-2) ease,
      text-shadow var(--dur-2) ease;
  }
  .tapa-fija::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: -12%;
    bottom: -12%;
    left: -190px;
    width: 380px;
    background: radial-gradient(closest-side, rgba(255, 82, 87, 0.5), transparent);
    opacity: 0;
    transition: opacity var(--dur-4) ease;
    pointer-events: none;
  }
  .magia i:nth-child(n + 8) {
    animation-play-state: paused;
  }
  .magia i:nth-child(-n + 7) {
    animation: chispa calc(var(--t) * 1.6) ease-out var(--r) infinite;
  }
  @media (hover: hover) and (pointer: fine) {
    .tapa-fija:hover::after,
    .tapa-fija:focus-visible::after {
      opacity: 1;
    }
    .tapa-fija:hover .tapa-tit b,
    .tapa-fija:focus-visible .tapa-tit b {
      text-shadow:
        0 0 5px rgba(255, 255, 255, 0.55),
        0 0 14px rgba(255, 74, 80, 0.8),
        0 0 32px rgba(221, 4, 10, 0.55);
    }
    .tapa-fija:hover .tapa-abrir,
    .tapa-fija:focus-visible .tapa-abrir {
      color: #ff4a50;
      text-shadow:
        0 0 4px rgba(255, 74, 80, 0.7),
        0 0 14px rgba(221, 4, 10, 0.55);
    }
    .tapa-fija:hover .magia i,
    .tapa-fija:focus-visible .magia i {
      animation: chispa var(--t) ease-out var(--r) infinite;
      animation-play-state: running;
    }
  }

  .pliegos::after {
    content: '';
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: calc(50% - 46px);
    width: 92px;
    background: linear-gradient(90deg, transparent, rgba(21, 23, 25, 0.16) 50%, transparent);
    pointer-events: none;
  }
  .cara::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(21, 23, 25);
    opacity: 0;
    pointer-events: none;
  }
  .pag-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-weight: 700;
  }
  .pag-pie img {
    width: auto;
    height: 16px;
    opacity: 0.8;
  }
  .der .pag-pie {
    justify-content: flex-end;
    padding-right: 30px;
  }
  .der-cab {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-right: 28px;
  }
  .der-cab .chips {
    margin-left: auto;
    justify-content: flex-end;
  }
  .pag-marca {
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--red);
  }
  .der-cab .pag-grupo {
    padding-left: 14px;
    border-left: 1px solid var(--line);
    color: var(--body);
  }
  .pag.der > :not(.esquina) {
    position: relative;
  }
  .pag.der::after {
    content: '';
    position: absolute;
    top: -6px;
    right: 14px;
    width: 22px;
    height: 74px;
    background: var(--red);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
  }
  .pliego .doc-acc {
    flex-wrap: nowrap;
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .pliego .doc-acc .pdf,
  .pliego .doc-acc .sel.mini {
    height: 52px;
  }
  .pliego .doc-acc .sel.mini {
    width: 52px;
    margin-left: 0;
    flex: none;
  }
  .pliego .doc-acc .pdf:not(.xlsx) {
    flex: 1;
    justify-content: center;
    gap: 8px;
    font-size: 16px;
  }
  .pliego .doc-acc .pdf small {
    font-weight: 300;
    font-size: 13px;
    opacity: 0.85;
  }
  .pliego .doc-acc .xlsx {
    flex: none;
    padding: 0 16px;
  }
  .pliego .eq-frase {
    margin-bottom: 4px;
  }
  .pliego h4 {
    margin-top: 6px;
  }
  .pliego h4::after {
    content: '';
    display: block;
    width: 56px;
    height: 3px;
    margin-top: 14px;
    background: var(--red);
  }

  /* Al aparecer una página, su contenido sube escalonado */
  @keyframes entra {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  .pliego.entra .der > :is(.der-cab, h4, .eq-frase, .pg-datos, .doc-acc) {
    animation: entra 0.7s var(--ease-out) both;
  }
  .pliego.entra .der > h4 {
    animation-delay: 0.08s;
  }
  .pliego.entra .der > .eq-frase {
    animation-delay: 0.16s;
  }
  .pliego.entra .der > .pg-datos {
    animation-delay: 0.24s;
  }
  .pliego.entra .der > .doc-acc {
    animation-delay: 0.32s;
  }
  .indlib ul button[aria-current='true']::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    align-self: center;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 10px 2px rgba(221, 4, 10, 0.55);
  }
  .indlib ul button {
    transition:
      background var(--dur-1) ease,
      color var(--dur-1) ease,
      translate var(--dur-2) var(--ease-out);
  }
  .indlib ul button:hover {
    translate: 4px 0;
  }

  /* La esquina de abajo: una punta doblada que crece al acercar el ratón y pasa la hoja */
  .esquina {
    position: absolute;
    bottom: 0;
    z-index: 3;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    cursor: pointer;
    transition:
      width var(--dur-3) var(--ease-out),
      height var(--dur-3) var(--ease-out);
  }
  .esquina:hover {
    width: 56px;
    height: 56px;
  }
  .der .esquina {
    right: 0;
    background: linear-gradient(135deg, #d6d2ca 50%, var(--carbon) 50%);
  }
  .izq .esquina {
    left: 0;
    background: linear-gradient(225deg, #d6d2ca 50%, var(--carbon) 50%);
  }
  .esquina {
    filter: drop-shadow(0 0 0 transparent);
  }

  /* Los datos del pliego, grabados en una placa de característica como la de una centrífuga */
  @property --cuenta-rotores {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }
  .pg-datos {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    align-items: stretch;
    margin-top: auto;
    padding: 18px 22px;
    border-radius: 8px;
    background:
      radial-gradient(circle, #f4f6f7 0 1.4px, #8a9399 2.6px, transparent 3.2px) left 8px top 8px / 9px 9px no-repeat,
      radial-gradient(circle, #f4f6f7 0 1.4px, #8a9399 2.6px, transparent 3.2px) right 8px top 8px / 9px 9px no-repeat,
      radial-gradient(circle, #f4f6f7 0 1.4px, #8a9399 2.6px, transparent 3.2px) left 8px bottom 8px / 9px 9px no-repeat,
      radial-gradient(circle, #f4f6f7 0 1.4px, #8a9399 2.6px, transparent 3.2px) right 8px bottom 8px / 9px 9px
        no-repeat,
      linear-gradient(180deg, #e9ecee, #cdd3d7 55%, #dde1e4);
    color: var(--ink);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(21, 23, 25, 0.25),
      0 0 0 1px rgba(21, 23, 25, 0.18),
      0 10px 20px -12px rgba(21, 23, 25, 0.5);
  }
  .pg-datos > div {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 6px;
    padding: 2px 10px;
    text-align: center;
  }
  .pg-datos > div + div {
    border-left: 1px solid rgba(21, 23, 25, 0.28);
    box-shadow: -1px 0 0 rgba(255, 255, 255, 0.7);
  }
  .pg-datos small {
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #5b646b;
  }
  .pg-datos b {
    font-size: 25px;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
  }
  .rotor-n {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .rotor-n svg {
    width: 30px;
    height: 30px;
    overflow: visible;
  }
  .rotor-n circle {
    fill: none;
    stroke: #6b747b;
    stroke-width: 2;
  }
  .rotor-n .tubo {
    fill: #353a3f;
    stroke: none;
  }
  .rotor-n .eje {
    fill: var(--red);
    stroke: none;
  }
  .rotor-n .gira {
    transform-origin: 24px 24px;
    animation: gira 14s linear infinite;
  }
  .pliego:hover .rotor-n .gira {
    animation-duration: 2.4s;
  }
  @keyframes gira {
    to {
      transform: rotate(360deg);
    }
  }
  /* El número de rotores sube desde cero cuando llega la página */
  .rotor-cnt {
    --cuenta-rotores: var(--max);
    counter-reset: n var(--cuenta-rotores);
  }
  .rotor-cnt::after {
    content: counter(n);
  }
  .pliego.entra .rotor-cnt {
    animation: cuenta 1.3s var(--ease-out) 0.35s both;
  }
  @keyframes cuenta {
    from {
      --cuenta-rotores: 0;
    }
  }

  /* Botones grandes */
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border: 1px solid rgba(21, 23, 25, 0.22);
    background: #fff;
    color: var(--ink);
    font: 700 15px/1 var(--f);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    border-radius: 10px;
  }
  .boton.grande {
    height: 56px;
    padding: 0 28px;
    font-size: 17px;
  }

  /* ——— Botones: los mismos dos de toda la web ———
     Rojo (descargar, crear, ver): el "Presupuesto" de las tarjetas de producto, con relieve (luz arriba, sombra
     roja); al pasar sube 1 px y lo cruza un haz de luz.
     Secundario (añadir, copiar, vaciar, imprimir, Excel): el "Comparar" de las tarjetas, gris suave; al pasar, texto
     rojo sobre rosa muy claro, sube 1 px y el «+» gira un cuarto de vuelta. Elegido, rojo lleno */
  .pdf:not(.xlsx),
  .boton.rojo,
  .ban-ver,
  .vp-descargar {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border: 0;
    border-radius: 10px;
    background: linear-gradient(180deg, #f2262c, var(--red) 55%, #c8030a);
    color: #fff;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 6px 14px -8px rgba(221, 4, 10, 0.8);
    transition:
      box-shadow 0.25s ease,
      translate 0.25s ease;
  }
  .pdf:not(.xlsx)::before,
  .boton.rojo::before,
  .ban-ver::before,
  .vp-descargar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.28) 50%, transparent 58%);
    translate: -110% 0;
    pointer-events: none;
  }
  .xlsx,
  .sel.mini,
  .boton:not(.rojo),
  .ban-vaciar,
  .vp-imprimir,
  .dos-lista :global(.dl-pdfs a) {
    border: 1px solid rgba(21, 23, 25, 0.16);
    border-radius: 10px;
    background: #f2f3f5;
    color: var(--ink);
    transition:
      background var(--dur-1) ease,
      border-color var(--dur-1) ease,
      color var(--dur-1) ease,
      box-shadow 0.25s ease,
      translate 0.25s ease;
  }
  .xlsx {
    color: #1e7f5c;
  }
  .sel svg {
    transition: rotate 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .sel[aria-pressed='true'] {
    border-color: var(--red);
    background: var(--red);
    color: #fff;
  }
  @media (hover: hover) and (pointer: fine) {
    .pdf:not(.xlsx):hover,
    .boton.rojo:hover,
    .ban-ver:hover,
    .vp-descargar:hover {
      translate: 0 -1px;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 12px 22px -8px rgba(221, 4, 10, 0.85);
    }
    .pdf:not(.xlsx):hover::before,
    .boton.rojo:hover::before,
    .ban-ver:hover::before,
    .vp-descargar:hover::before {
      translate: 110% 0;
      transition: translate 1s cubic-bezier(0.45, 0, 0.25, 1);
    }
    :is(.xlsx, .sel.mini, .boton:not(.rojo), .ban-vaciar, .vp-imprimir):not([aria-pressed='true']):hover,
    .dos-lista :global(.dl-pdfs a:hover) {
      border-color: rgba(221, 4, 10, 0.3);
      background: #fdecec;
      color: var(--red);
      translate: 0 -1px;
      box-shadow: 0 8px 16px -10px rgba(221, 4, 10, 0.7);
    }
    .sel:not([aria-pressed='true']):hover svg {
      rotate: 90deg;
    }
    .sel[aria-pressed='true']:hover {
      translate: 0 -1px;
      box-shadow: 0 8px 16px -10px rgba(221, 4, 10, 0.8);
    }
  }
  .boton:active,
  .pdf:active,
  .sel:active,
  .ban-ver:active,
  .ban-vaciar:active,
  .vp-descargar:active,
  .vp-imprimir:active,
  .indice a:active {
    scale: 0.97;
  }
  .boton:focus-visible,
  .pdf:focus-visible,
  .sel:focus-visible,
  .indice a:focus-visible,
  .pliego h4 a:focus-visible {
    outline: var(--foco);
    outline-offset: 2px;
  }
  .nada {
    padding: 56px 0;
    color: var(--body);
    font-size: var(--t-sub);
  }

  /* ——— Cierre de la página ———
     Un remate blanco con "¿Necesitas otro documento?" y los dos correos, la última acción antes del pie */
  .cierre {
    display: grid;
    gap: 18px;
    margin-top: clamp(80px, 10vw, 140px);
    padding-bottom: clamp(96px, 12vw, 160px);
  }
  .sellos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-block: 0;
    padding-block: 0;
    list-style: none;
    border-block: 1px solid var(--line);
  }
  .sello {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: clamp(32px, 4vw, 48px) 20px;
    transition: background var(--dur-2) ease;
  }
  .sello + .sello {
    border-left: 1px solid var(--line);
  }
  @media (hover: hover) and (pointer: fine) {
    .sello:hover {
      background: #fff;
    }
  }
  .sello .doc-acc {
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 0;
    gap: 8px;
  }
  .se-marca {
    position: relative;
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
  }
  .remate {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px clamp(32px, 5vw, 72px);
    padding: clamp(28px, 3.5vw, 44px) clamp(28px, 4vw, 56px);
    border: 1px solid var(--line);
    border-top: 3px solid var(--red);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 40px 70px -50px rgba(21, 23, 25, 0.45);
  }
  .falta h2 {
    font-weight: 300;
    font-size: clamp(30px, 3.2vw, 46px);
    line-height: 1;
    color: var(--ink);
  }
  .falta h2 b {
    color: var(--red);
  }
  .falta > p {
    margin-top: 10px;
    color: var(--body);
    font-size: var(--t-sub);
  }
  .falta-links {
    display: flex;
    gap: 10px;
  }
  .buzon {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #f6f7f8;
    color: var(--ink);
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition:
      border-color var(--dur-1) ease,
      background var(--dur-1) ease,
      translate 0.25s ease,
      box-shadow 0.25s ease;
  }
  .buzon svg {
    flex: none;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--red);
    stroke-width: 1.8;
    stroke-linejoin: round;
  }
  .buzon span {
    display: grid;
    gap: 3px;
  }
  .buzon small {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .buzon::after {
    content: '»';
    margin-left: auto;
    padding-left: 8px;
    color: var(--red);
    font-size: 22px;
    transition: translate 0.25s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .buzon:hover {
      border-color: rgba(221, 4, 10, 0.3);
      background: #fdecec;
      translate: 0 -1px;
      box-shadow: 0 8px 16px -10px rgba(221, 4, 10, 0.6);
    }
    .buzon:hover::after {
      translate: 4px 0;
    }
  }
  .buzon:focus-visible {
    outline: var(--foco);
    outline-offset: 2px;
  }
  .cierre .nota {
    text-align: center;
    font-size: 13px;
    color: var(--muted);
  }
  .se-anillo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    animation: gira 30s linear infinite;
  }
  .se-anillo circle:first-of-type {
    stroke: rgba(21, 23, 25, 0.18);
    stroke-width: 1;
  }
  .se-anillo circle:last-of-type {
    stroke: var(--red);
    stroke-width: 1.5;
  }
  .se-anillo text {
    fill: var(--muted);
    font: 700 8.4px var(--f);
    letter-spacing: 0.22em;
  }
  @keyframes gira {
    to {
      transform: rotate(360deg);
    }
  }
  .sello:hover .se-anillo {
    animation-duration: 6s;
  }
  .se-n {
    position: relative;
    display: grid;
    text-align: center;
    font-weight: 700;
    font-size: 21px;
    line-height: 1;
  }
  .se-n small {
    font-size: 10px;
    letter-spacing: 0.24em;
    color: var(--red);
  }
  .se-txt h3 {
    font-size: clamp(22px, 2vw, 26px);
    line-height: 1;
  }
  .se-txt p {
    margin-top: 6px;
    color: var(--body);
    font-size: 15px;
    line-height: 1.3;
  }
  .sello .sel.mini {
    margin-left: 0;
  }

  /* ——— Bandeja: la selección y su QR ——— */
  :global(body.con-bandeja) {
    padding-bottom: 100px;
  }
  .bandeja {
    position: fixed;
    left: 50%;
    bottom: 16px;
    z-index: 20;
    translate: -50% 0;
    width: min(680px, calc(100vw - 32px));
    display: flex;
    align-items: center;
    gap: 14px;
