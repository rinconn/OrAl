---
// Catálogo de productos: el hero con la Digicen 22 en 3D (HeroProductos.astro), y debajo la misma exposición con la
// luz encendida: blanco, cada máquina grande sobre su elipse roja, agrupadas por familia con un título grande. Arriba,
// una barra fina y fija para buscar y filtrar (en móvil, los filtros suben en un panel desde abajo), y en cada
// máquina "Comparar" para verlas lado a lado. Los filtros se guardan en la dirección para poder compartir una búsqueda.
import Base from '../../layouts/Base.astro';
import Maquina from '../Maquina.astro';
import Paso from '../Paso.astro';
import Filtros from '../Filtros.astro';
import HeroProductos from '../HeroProductos.astro';
import {
  categorias,
  familias,
  modelos,
  productos,
  totalModelos,
  type Categoria,
  type Familia,
  type Modelo,
} from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import { cifra, fichaCentrifuga } from '../../data/fichas';
import { idioma, numero, ruta, textoSerie, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const f = t.catalogo.filtros;

const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// Texto para el buscador: sin tildes ni mayúsculas, como la lupa de la cabecera
const plano = (...partes: (string | undefined)[]) =>
  partes.filter(Boolean).join(' ').normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();

type Otro = 'accesorios' | 'laboratorio';
type Cat = Categoria | Otro;
// Aplicaciones del filtro, como en la web actual: generales, especiales y otros productos
const grupos: { nombre: string; cats: Cat[] }[] = [
  { nombre: t.catalogo.grupos.generales, cats: [...categorias.generales] },
  { nombre: t.catalogo.grupos.especiales, cats: [...categorias.especiales] },
  { nombre: t.catalogo.grupos.otros, cats: ['accesorios', 'laboratorio'] },
];
const nombreCat = (c: Cat) =>
  c === 'accesorios'
    ? t.laboratorio.accesorios
    : c === 'laboratorio'
      ? t.laboratorio.equipos
      : t.catalogo.categorias[c];
const nombreCorto = (c: Cat) => (c === 'accesorios' || c === 'laboratorio' ? f.cortos[c] : nombreCat(c));

// La exposición, por familias (Compactas, Universales…) y al final accesorios y otros productos de laboratorio
type Ficha = { tipo: 'modelo'; cat: Cat; m: Modelo } | { tipo: 'lab'; cat: Cat; p: ProductoLab };
const familiaDe = (m: Modelo) => productos.find((p) => p.slug === m.serie)!.familia;
const lab = (c: Otro, items: ProductoLab[]): Ficha[] => items.map((p) => ({ tipo: 'lab', cat: c, p }));
const salas: { id: string; nombre: string; color: string; fichas: Ficha[] }[] = [
  ...(Object.keys(familias) as Familia[]).map((fam) => ({
    id: fam,
    nombre: t.familias[fam],
    color: familias[fam].color as string,
    fichas: modelos.filter((m) => familiaDe(m) === fam).map((m): Ficha => ({ tipo: 'modelo', cat: m.categoria, m })),
  })),
  { id: 'accesorios', nombre: t.laboratorio.accesorios, color: '#8c959b', fichas: lab('accesorios', accesorios) },
  { id: 'laboratorio', nombre: t.laboratorio.equipos, color: '#8c959b', fichas: lab('laboratorio', equipos) },
].filter((s) => s.fichas.length);
const capacidad = (m: Modelo) =>
  m.capacidad === productos.find((p) => p.slug === m.serie)?.capacidad
    ? (textoSerie(lang, m.serie).capacidad ?? m.capacidad)
    : m.capacidad;
// Fuerza máxima: la del modelo o, si no la tiene, la de su ficha de la web
const fuerza = (m: Modelo) => {
  const xg = m.xg ?? fichaCentrifuga(m.slug)?.xg;
  return xg ? (m.xg ? numero(lang, m.xg) : cifra(lang, xg)) : undefined;
};

// Comparador: los datos que el distribuidor mira para elegir, de la tabla de la serie y de la ficha de cada modelo
const tc = t.catalogo.comparar;
const tf = t.catalogo.ficha;
const aNumero = (s?: string) => (s ? Number(s.replace(/\D/g, '')) : undefined);
const comparables = Object.fromEntries(
  modelos.map((m) => {
    const web = fichaCentrifuga(m.slug);
    const v0 = web?.versiones[0];
    const xg = m.xg ?? web?.xg;
    return [
      m.slug,
      {
        nombre: m.nombre,
        img: m.imagen.src,
        href: ruta(lang, `/centrifugas/${m.slug}/`),
        filas: {
          aplicacion: t.catalogo.categorias[m.categoria],
          temperatura: may(t.temperatura[m.temperatura]),
          capacidad: capacidad(m),
          velocidad: `${numero(lang, m.rpm)} rpm`,
          fuerza: xg ? `${m.xg ? numero(lang, m.xg) : cifra(lang, xg)} xg` : undefined,
          pantalla: m.pantalla,
          medidas: v0?.medidas ? `${v0.medidas.replace(/x/g, ' × ')} mm` : undefined,
          peso: v0?.peso ? `${v0.peso} kg` : undefined,
          consumo: v0?.consumo ? `${v0.consumo} W` : undefined,
          rotores: web?.rotores.length ? String(web.rotores.length) : undefined,
        },
        // Para marcar el mayor de cada fila numérica
        num: { velocidad: aNumero(m.rpm), fuerza: aNumero(xg), rotores: web?.rotores.length },
      },
    ];
  }),
);
const filasComparar = [
  { k: 'aplicacion', nombre: tc.aplicacion },
  { k: 'temperatura', nombre: tc.temperatura },
  { k: 'capacidad', nombre: tf.capacidad },
  { k: 'velocidad', nombre: tf.velocidad },
  { k: 'fuerza', nombre: tf.fuerza },
  { k: 'pantalla', nombre: tf.pantalla },
  { k: 'medidas', nombre: tf.versiones.medidas },
  { k: 'peso', nombre: tf.versiones.peso },
  { k: 'consumo', nombre: tf.versiones.consumo },
  { k: 'rotores', nombre: tc.rotores },
];
const cruz = 'M6 6l12 12M18 6 6 18';
---

<Base title={t.catalogo.title} description={t.catalogo.description(productos.length, totalModelos)}>
  <HeroProductos />

  <section class="catalogo" id="catalogo" aria-label={f.todoTitulo}>
    <!-- Corte limpio con el hero: la raya roja se dibuja desde el centro, sin fundido -->
    <Paso desde="transparent" />

    <!-- Filtros: panel a la vista y, al bajar, barra fina fija con lo puesto -->
    <Filtros
      grupos={grupos.map((g) => ({ nombre: g.nombre, cats: g.cats.map((c) => ({ v: c, nombre: nombreCorto(c) })) }))}
    />

    <div class="wrap salas" id="salas">
      {salas.map((s, i) => (
        <section class="sala" data-sala={s.id} aria-labelledby={`sala-${s.id}`} style={`--fam: ${s.color}`}>
          <header class="sala-cab">
            <span class="sala-i" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h2 id={`sala-${s.id}`}>{s.nombre}</h2>
            <p class="sala-n">{f.resultados(s.fichas.length)}</p>
          </header>
          <ul class="piezas">
            {s.fichas.map((x) =>
              x.tipo === 'modelo' ? (
                <li
                  class="ficha"
                  id={x.m.principal ? x.m.serie : x.m.slug}
                  data-cat={x.cat}
                  data-t={x.m.temperatura}
                  data-texto={plano(
                    x.m.nombre,
                    s.nombre,
                    nombreCat(x.cat),
                    textoSerie(lang, x.m.serie).frase,
                    capacidad(x.m),
                    x.m.pantalla,
                    t.temperatura[x.m.temperatura],
                  )}
                >
                  <Maquina
                    modelo={x.m}
                    capacidad={capacidad(x.m)}
                    fuerza={fuerza(x.m)}
                    uso={nombreCat(x.cat)}
                    frase={textoSerie(lang, x.m.serie).frase}
                    color={s.color}
                  />
                  <label class="comparar">
                    <input type="checkbox" value={x.m.slug} />
                    <span class="caja" aria-hidden="true" />
                    {tc.comparar}
                    <span class="sr">{x.m.nombre}</span>
                  </label>
                </li>
              ) : (
                <li
                  class="ficha"
                  id={x.p.slug}
                  data-cat={x.cat}
                  data-texto={plano(
                    t.laboratorio.items[x.p.slug].nombre,
                    x.p.modelo,
                    nombreCat(x.cat),
                    t.laboratorio.items[x.p.slug].frase,
                    t.laboratorio.items[x.p.slug].datos,
                  )}
                >
                  <Maquina
                    lab={x.p}
                    uso={nombreCat(x.cat)}
                    frase={t.laboratorio.items[x.p.slug].frase}
                    color={s.color}
                  />
                </li>
              ),
            )}
          </ul>
        </section>
      ))}

      <div class="vacio" hidden>
        <p>{f.vacio}</p>
        <button type="button" class="btn red limpiar">
          {f.limpiar}
        </button>
      </div>
    </div>
  </section>

  <!-- Comparador: barra abajo con las elegidas y, al abrirla, las máquinas lado a lado -->
  <div class="barra-comparar" id="barra-comparar" role="region" aria-label={tc.titulo} hidden>
    <ul class="elegidas"></ul>
    <p class="pista-otra">{tc.otra}</p>
    <div class="barra-acciones">
      <button type="button" class="vaciar">
        {tc.vaciar}
      </button>
      <button type="button" class="abrir-comparar" data-txt={tc.abrir(999)}></button>
    </div>
  </div>

  <dialog class="comparador" id="comparador" aria-labelledby="comparador-tit">
    <div class="comp-cab">
      <h2 id="comparador-tit">{tc.titulo}</h2>
      <button type="button" class="cerrar-comp" aria-label={tc.cerrar}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d={cruz} stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <div class="comp-tabla"></div>
  </dialog>

  <script
    type="application/json"
    id="datos-comparar"
    set:html={JSON.stringify({
      maquinas: comparables,
      filas: filasComparar,
      textos: { quitar: tc.quitar('{n}'), maximo: tc.maximo, verFicha: tf.verFicha, mejor: tc.mejor },
    })}
  />
</Base>

<script>
  import { iniciarComparador } from '../../scripts/comparador';
  iniciarComparador();

  // Al bajar, las máquinas entran de abajo arriba, escalonadas por fila
  const salasEl = document.getElementById('salas');
  if (salasEl && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    salasEl.classList.add('revela');
    const io = new IntersectionObserver(
      (entradas) => {
        entradas
          .filter((e) => e.isIntersecting)
          .forEach((e, i) => {
            const el = e.target as HTMLElement;
            el.style.setProperty('--d', `${i * 70}ms`);
            el.classList.add('visto');
            io.unobserve(el);
          });
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    for (const el of salasEl.querySelectorAll('.ficha')) io.observe(el);
  }
</script>

<style>
  /* Lo que el filtro oculta, oculto aunque tenga su propio display */
  [hidden] {
    display: none !important;
  }

  /* ——— La exposición con la luz encendida ——— */
  .catalogo {
    --arriba: 0px;
    position: relative;
    padding-bottom: clamp(96px, 11vw, 160px);
    background: #fff;
  }
  /* Con la cabecera de la web a la vista, la barra baja para no quedar debajo */
  :global(html:has(#top:not(.oculta))) .catalogo {
    --arriba: 104px;
  }
  .catalogo > :global(.paso) {
    z-index: 19;
  }

  /* ——— Familias: número rojo, título en negrita enorme y la raya de su color ——— */
  .salas {
    padding-top: clamp(64px, 7vw, 104px);
  }
  .sala + .sala {
    margin-top: clamp(96px, 10vw, 160px);
  }
  .sala-cab {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: 0 clamp(16px, 2vw, 28px);
    padding-bottom: clamp(20px, 2.4vw, 32px);
    margin-bottom: clamp(28px, 3.2vw, 44px);
    border-bottom: 2px solid var(--ink);
  }
  .sala-cab::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: clamp(80px, 12vw, 180px);
    height: 6px;
    background: var(--fam);
    translate: 0 50%;
  }
  .sala-i {
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 700;
    line-height: 1;
    color: var(--red);
    font-variant-numeric: tabular-nums;
    padding-bottom: 0.35em;
  }
  .sala-cab h2 {
    font-size: clamp(52px, 7.4vw, 112px);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .sala-n {
    flex: none;
    margin: 0;
    padding-bottom: 0.3em;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .piezas {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 28px);
  }
  /* Cada máquina deja sitio a la barra al llegar con un enlace a ella */
  .ficha {
    position: relative;
    scroll-margin-top: 200px;
  }

  /* "Comparar": arriba a la derecha del escenario; marcado, en rojo */
  .comparar {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 10px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--ink);
    background: #fff;
    cursor: pointer;
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }
  .comparar input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .caja {
    position: relative;
    width: 14px;
    height: 14px;
    border: 1.5px solid currentColor;
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease;
  }
  .caja::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.5px;
    width: 4px;
    height: 8px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    rotate: 45deg;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.16s ease,
      scale 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .comparar:has(input:checked) {
    color: #fff;
    background: var(--ink);
  }
  .comparar input:checked + .caja {
    background: var(--red);
    border-color: var(--red);
  }
  .comparar input:checked + .caja::after {
    opacity: 1;
    scale: 1;
  }
  .comparar input:focus-visible + .caja {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  .comparar:has(input:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }
  @media (hover: hover) and (pointer: fine) {
    .comparar:hover:not(:has(input:disabled)) {
      color: var(--ink);
    }
  }

  /* Sin resultados: el mensaje claro y el botón para empezar de nuevo */
  .vacio {
    padding: clamp(72px, 10vw, 140px) 0;
    text-align: center;
  }
  .vacio p {
    margin: 0 0 28px;
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 300;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Entrada al bajar */
  .revela .ficha:not(.visto) {
    opacity: 0;
    transform: translateY(28px);
  }
  .revela .ficha.visto {
    transition:
      opacity 0.6s var(--ease) var(--d, 0ms),
      transform 0.7s cubic-bezier(0.23, 1, 0.32, 1) var(--d, 0ms);
  }

  @media (max-width: 1439px) {
    :global(html:has(#top:not(.oculta))) .catalogo {
      --arriba: 88px;
    }
  }
  @media (max-width: 1180px) {
    .piezas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    :global(html:has(#top:not(.oculta))) .catalogo {
      --arriba: 60px;
    }
  }

  /* ——— Móvil ——— */
  @media (max-width: 1024px) {
    .salas {
      padding-top: 56px;
    }
    .sala + .sala {
      margin-top: 104px;
    }
    .sala-n {
      font-size: 16px;
    }
  }
  @media (max-width: 640px) {
    .piezas {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .sala-cab {
      grid-template-columns: auto 1fr;
    }
    .sala-cab h2 {
      font-size: clamp(38px, 11vw, 52px);
    }
    .sala-n {
      grid-column: 1 / -1;
      padding: 12px 0 0;
      font-size: 16px;
    }
  }
  /* Los botones que se pintan desde JS no llevan el ámbito del componente */
  :global(:where(.barra-comparar, .comparador) button) {
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  /* ——— Comparador ——— */
  .barra-comparar {
    position: fixed;
    left: 50%;
    bottom: 20px;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 20px;
    width: max-content;
    max-width: calc(100% - 2 * var(--gut));
    padding: 10px 10px 10px 16px;
    background: rgba(21, 23, 25, 0.96);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #fff;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.55);
    translate: -50% 0;
    animation: sube-barra 0.45s var(--ease);
  }
  .barra-comparar::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--red);
  }
  .elegidas {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .elegidas :global(li) {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 6px 0 4px;
    background: rgba(255, 255, 255, 0.07);
    animation: entra-chip 0.3s var(--ease);
  }
  .elegidas :global(img) {
    width: 40px;
    height: 40px;
    object-fit: contain;
    background: #fff;
  }
  .elegidas :global(span) {
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }
  .elegidas :global(button) {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: var(--on-dark);
  }
  .pista-otra {
    font-size: 15px;
    color: var(--on-dark);
    white-space: nowrap;
  }
  .barra-acciones {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .vaciar {
    height: 44px;
    padding: 0 14px;
    font-size: 15px;
    color: var(--on-dark);
  }
  .abrir-comparar {
    height: 44px;
    padding: 0 20px;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    background: var(--red);
    transition: background 0.25s var(--ease);
  }
  .abrir-comparar::after {
    content: ' »';
    font-weight: 300;
  }
  .abrir-comparar:disabled {
    background: #4a4f53;
    color: #a9afb3;
    cursor: default;
  }
  .barra-comparar button:focus-visible {
    outline-color: #fff;
  }

  .comparador {
    width: min(1080px, calc(100% - 2 * var(--gut)));
    max-height: calc(100% - 48px);
    padding: 0;
    border: 0;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 40px 100px -30px rgba(0, 0, 0, 0.5);
  }
  .comparador[open] {
    animation: abre 0.4s var(--ease);
  }
  .comparador::backdrop {
    background: rgba(21, 23, 25, 0.55);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  .comp-cab {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px clamp(20px, 3vw, 36px);
    background: #fff;
    border-top: 3px solid var(--red);
    border-bottom: 1px solid var(--line);
  }
  .comp-cab h2 {
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 300;
  }
  .cerrar-comp {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }
  .comp-tabla {
    overflow-x: auto;
    padding: 0 clamp(20px, 3vw, 36px) 32px;
  }
  .comp-tabla :global(table) {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .comp-tabla :global(th),
  .comp-tabla :global(td) {
    padding: 14px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid #ececec;
    font-variant-numeric: tabular-nums;
  }
