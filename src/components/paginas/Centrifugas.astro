---
// Catálogo de productos: todas las series de centrífugas del Catálogo General 2025, agrupadas por uso, y después
// los equipos de laboratorio y los accesorios. Sin filtros ni etiquetas: foto, nombre, una frase y las cifras que
// pide un distribuidor.
import Base from '../../layouts/Base.astro';
import { familias, productos, totalModelos, type Familia } from '../../data/productos';
import { accesorios, equipos } from '../../data/laboratorio';
import { idioma, numero, textoSerie, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);

const grupos = (Object.keys(familias) as Familia[]).map((clave) => ({
  clave,
  nombre: t.familias[clave],
  series: productos.filter((p) => p.familia === clave),
}));
// Como en la página de productos de la web actual: primero los accesorios de centrífuga y después el resto
const otros = [
  { clave: 'accesorios', nombre: t.laboratorio.accesorios, items: accesorios },
  { clave: 'equipos', nombre: t.laboratorio.equipos, items: equipos },
];
// "ventilada / refrigerada", con la primera en mayúscula
const temperatura = (p: (typeof productos)[number]) => {
  const s = p.temperatura.map((x) => t.temperatura[x]).join(' / ');
  return s.charAt(0).toUpperCase() + s.slice(1);
};
---

<Base title={t.catalogo.title} description={t.catalogo.description(productos.length, totalModelos)}>
  <section class="sec cat">
    <div class="wrap">
      <h1>
        {t.catalogo.titulo[0]}
        <b>{t.catalogo.titulo[1]}</b>
      </h1>
      <p class="lead">{t.catalogo.lead(productos.length, totalModelos)}</p>
      <nav class="indice" aria-label={t.catalogo.indice}>
        {[...grupos, ...otros].map((g) => (
          <a href={`#${g.clave}`}>{g.nombre}</a>
        ))}
      </nav>

      {grupos.map((g) => (
        <section class="grupo" id={g.clave} aria-labelledby={`t-${g.clave}`}>
          <h2 id={`t-${g.clave}`}>{g.nombre}</h2>
          <ul class="rejilla">
            {g.series.map((p) => (
              <li class="serie" id={p.slug}>
                <span class="foto">
                  <img
                    src={p.imagen.src}
                    alt={p.nombre}
                    width={p.imagen.ancho}
                    height={p.imagen.alto}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <h3>
                  {p.nombre}
                  {p.variantes && <span> · {p.variantes}</span>}
                </h3>
                <p class="frase">{textoSerie(lang, p.slug).frase}</p>
                {/* Los cuatro iconos de la web actual: capacidad, pantalla, velocidad y temperatura */}
                <ul class="fichas">
                  <li>
                    <i style="--ico: url(/img/iconos/ficha-capacidad.svg)" aria-hidden="true" />
                    <span class="sr">{t.catalogo.iconos.capacidad}: </span>
                    {textoSerie(lang, p.slug).capacidad ?? p.capacidad}
                  </li>
                  <li>
                    <i style="--ico: url(/img/iconos/ficha-pantalla.svg)" aria-hidden="true" />
                    <span class="sr">{t.catalogo.iconos.pantalla}: </span>
                    {p.pantalla}
                  </li>
                  <li>
                    <i style="--ico: url(/img/iconos/ficha-velocidad.svg)" aria-hidden="true" />
                    <span class="sr">{t.catalogo.iconos.velocidad}: </span>
                    {numero(lang, p.rpm)} rpm
                    <small>{numero(lang, p.xg)} xg</small>
                  </li>
                  <li>
                    <i style="--ico: url(/img/iconos/ficha-info.svg)" aria-hidden="true" />
                    <span class="sr">{t.catalogo.iconos.temperatura}: </span>
                    {temperatura(p)}
                  </li>
                </ul>
              </li>
            ))}
          </ul>
        </section>
      ))}

      {otros.map((g) => (
        <section class="grupo" id={g.clave} aria-labelledby={`t-${g.clave}`}>
          <h2 id={`t-${g.clave}`}>{g.nombre}</h2>
          <ul class="rejilla">
            {g.items.map((p) => {
              const tx = t.laboratorio.items[p.slug];
              return (
                <li class="serie" id={p.slug}>
                  <span class:list={['foto', { doble: p.imagen2 }]}>
                    <img
                      src={p.imagen.src}
                      alt={tx.nombre}
                      width={p.imagen.ancho}
                      height={p.imagen.alto}
                      loading="lazy"
                      decoding="async"
                    />
                    {p.imagen2 && (
                      <img
                        class="segunda"
                        src={p.imagen2.src}
                        alt=""
                        width={p.imagen2.ancho}
                        height={p.imagen2.alto}
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </span>
                  <h3>
                    {tx.nombre} <span>· {p.modelo}</span>
                  </h3>
                  <p class="frase">{tx.frase}</p>
                  <p class="spec">{tx.datos}</p>
                  {p.pdf && (
                    <a class="arrow pdf" href={p.pdf} target="_blank" rel="noopener">
                      {t.laboratorio.pdf}
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: var(--t-titulo);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.015em;
  }
  .lead {
    margin-top: 24px;
    max-width: 52ch;
    font-size: var(--t-sub);
    color: var(--body);
  }

  /* Índice de familias: texto suelto que se subraya en rojo, sin barra ni pestañas */
  .indice {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 36px;
  }
  .indice a {
    position: relative;
    padding-bottom: 4px;
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }
  .indice a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--red);
    transition: width 0.3s var(--ease);
  }
  .indice a:hover::after,
  .indice a:focus-visible::after {
    width: 100%;
  }

  .grupo {
    margin-top: clamp(64px, 8vw, 104px);
    scroll-margin-top: 110px;
  }
  .grupo h2 {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    font-size: clamp(32px, 3.4vw, 44px);
    font-weight: 300;
    line-height: 1;
  }
  .rejilla {
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px 28px;
  }
  .serie {
    scroll-margin-top: 110px;
  }

  /* Misma tarjeta que el resto de la web: sube, crece la raya roja arriba y la esquina oscura se pone roja */
  .foto {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--panel);
    border: 2px solid #3b4045;
    transition:
      transform 0.35s var(--ease),
      border-color 0.3s var(--ease);
  }
  .foto::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0 auto auto 0;
    width: 0;
    height: 4px;
    background: var(--red);
    transition: width 0.4s var(--ease);
  }
  .foto::after {
    content: '';
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    border-style: solid;
    border-width: 0 18px 18px 0;
    border-color: transparent #3b4045 transparent transparent;
    transition: border-color 0.3s var(--ease);
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.7s var(--ease);
  }
  .serie:hover .foto {
    transform: translateY(-4px);
    border-color: var(--ink);
  }
  .serie:hover .foto::before {
    width: 100%;
  }
  .serie:hover .foto::after {
    border-right-color: var(--red);
  }
  .serie:hover img {
    transform: scale(1.04);
  }
  /* Ficha enlazada desde Tecnología o la lupa: se marca un momento al llegar */
  .serie:target .foto {
    border-color: var(--red);
  }

  h3 {
    margin-top: 16px;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.05;
  }
  h3 span {
    font-weight: 300;
  }
  .frase {
    margin-top: 8px;
    font-size: 17px;
    color: var(--body);
  }
  .spec {
    margin-top: 10px;
    font-size: 16px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .spec b {
    color: var(--ink);
  }
  /* Iconos de la ficha, como en la web actual: cuadrado rojo con el dibujo en blanco y el dato debajo */
  .fichas {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .fichas li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.15;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .fichas i {
    display: block;
    width: 32px;
    height: 32px;
    background: var(--red) var(--ico) center / 60% 60% no-repeat;
  }
  .fichas small {
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Equipos y accesorios con segunda foto (el accesorio en uso): aparece encima al pasar el ratón */
  .foto .segunda {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition:
      opacity 0.45s var(--ease),
      transform 0.7s var(--ease);
  }
  .serie:hover .foto.doble .segunda {
    opacity: 1;
  }
  .pdf {
    margin-top: 12px;
    font-size: 16px;
    color: var(--ink);
  }

  @media (max-width: 1100px) {
    .rejilla {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  /* Móvil: dos por fila para que el catálogo no se haga eterno */
  @media (max-width: 760px) {
    .indice {
      gap: 10px 24px;
    }
    .indice a {
      font-size: 18px;
    }
    .rejilla {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 16px;
      margin-top: 24px;
    }
    h3 {
      font-size: 21px;
    }
    .frase {
      font-size: 16px;
    }
    .spec {
      font-size: 15px;
    }
    /* Dos tarjetas por fila: los cuatro iconos, en dos filas de dos para que el texto no se monte */
    .fichas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 8px;
    }
    .fichas li {
      overflow-wrap: anywhere;
    }
    .fichas i {
      width: 28px;
      height: 28px;
    }
  }
</style>
