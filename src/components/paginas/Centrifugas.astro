---
// Catálogo de productos: el hero con la Digicen 22 en 3D (HeroProductos.astro), y debajo el catálogo en blanco con
// un índice fijo a la izquierda (buscador, aplicaciones y temperatura) y una rejilla continua de tarjetas: los 23
// modelos de centrífuga (fotos y aplicaciones de la página de productos de la web actual), los accesorios y los otros
// productos de laboratorio. Los filtros se guardan en la dirección para poder compartir una búsqueda.
import Base from '../../layouts/Base.astro';
import Tarjeta from '../Tarjeta.astro';
import HeroProductos from '../HeroProductos.astro';
import IconoTemp from '../ui/IconoTemp.astro';
import {
  categorias,
  modelos,
  productos,
  totalModelos,
  type Categoria,
  type Modelo,
  type Temperatura,
} from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import { cifra, fichaCentrifuga } from '../../data/fichas';
import { idioma, numero, ruta, textoSerie, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const f = t.catalogo.filtros;

const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// Texto para el buscador: sin tildes ni mayúsculas, como la lupa de la cabecera
const plano = (...partes: (string | undefined)[]) =>
  partes.filter(Boolean).join(' ').normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();

type Otro = 'accesorios' | 'laboratorio';
type Cat = Categoria | Otro;
const grupos: { nombre: string; cats: Cat[] }[] = [
  { nombre: t.catalogo.grupos.generales, cats: [...categorias.generales] },
  { nombre: t.catalogo.grupos.especiales, cats: [...categorias.especiales] },
  { nombre: t.catalogo.grupos.otros, cats: ['accesorios', 'laboratorio'] },
];
const todas = grupos.flatMap((g) => g.cats);
const nombreCat = (c: Cat) =>
  c === 'accesorios'
    ? t.laboratorio.accesorios
    : c === 'laboratorio'
      ? t.laboratorio.equipos
      : t.catalogo.categorias[c];
const nombreCorto = (c: Cat) => (c === 'accesorios' || c === 'laboratorio' ? f.cortos[c] : nombreCat(c));
const grupoDe = (c: Cat) => grupos.find((g) => g.cats.includes(c))!.nombre;

const temperaturas: Temperatura[] = ['ventilada', 'refrigerada', 'calefactada'];

// Tarjetas en el orden del catálogo: por aplicación, y dentro de cada una como en la web actual
type Ficha = { tipo: 'modelo'; cat: Cat; m: Modelo } | { tipo: 'lab'; cat: Cat; p: ProductoLab };
const lab = (c: Otro, items: ProductoLab[]): Ficha[] => items.map((p) => ({ tipo: 'lab', cat: c, p }));
const fichas = todas.flatMap((c): Ficha[] =>
  c === 'accesorios'
    ? lab(c, accesorios)
    : c === 'laboratorio'
      ? lab(c, equipos)
      : modelos.filter((m) => m.categoria === c).map((m): Ficha => ({ tipo: 'modelo', cat: c, m })),
);
const capacidad = (m: Modelo) =>
  m.capacidad === productos.find((p) => p.slug === m.serie)?.capacidad
    ? (textoSerie(lang, m.serie).capacidad ?? m.capacidad)
    : m.capacidad;

// Comparador: los datos que el distribuidor mira para elegir, de la tabla de la serie y de la ficha de cada modelo
const tc = t.catalogo.comparar;
const tf = t.catalogo.ficha;
const aNumero = (s?: string) => (s ? Number(s.replace(/\D/g, '')) : undefined);
const comparables = Object.fromEntries(
  modelos.map((m) => {
    const web = fichaCentrifuga(m.slug);
    const v0 = web?.versiones[0];
    const xg = m.xg ?? web?.xg;
    return [
      m.slug,
      {
        nombre: m.nombre,
        img: m.imagen.src,
        href: ruta(lang, `/centrifugas/${m.slug}/`),
        filas: {
          aplicacion: t.catalogo.categorias[m.categoria],
          temperatura: may(t.temperatura[m.temperatura]),
          capacidad: capacidad(m),
          velocidad: `${numero(lang, m.rpm)} rpm`,
          fuerza: xg ? `${m.xg ? numero(lang, m.xg) : cifra(lang, xg)} xg` : undefined,
          pantalla: m.pantalla,
          medidas: v0?.medidas ? `${v0.medidas.replace(/x/g, ' × ')} mm` : undefined,
          peso: v0?.peso ? `${v0.peso} kg` : undefined,
          consumo: v0?.consumo ? `${v0.consumo} W` : undefined,
          rotores: web?.rotores.length ? String(web.rotores.length) : undefined,
        },
        // Para marcar el mayor de cada fila numérica
        num: { velocidad: aNumero(m.rpm), fuerza: aNumero(xg), rotores: web?.rotores.length },
      },
    ];
  }),
);
const filasComparar = [
  { k: 'aplicacion', nombre: tc.aplicacion },
  { k: 'temperatura', nombre: tc.temperatura },
  { k: 'capacidad', nombre: tf.capacidad },
  { k: 'velocidad', nombre: tf.velocidad },
  { k: 'fuerza', nombre: tf.fuerza },
  { k: 'pantalla', nombre: tf.pantalla },
  { k: 'medidas', nombre: tf.versiones.medidas },
  { k: 'peso', nombre: tf.versiones.peso },
  { k: 'consumo', nombre: tf.versiones.consumo },
  { k: 'rotores', nombre: tc.rotores },
];
---

<Base title={t.catalogo.title} description={t.catalogo.description(productos.length, totalModelos)}>
  <HeroProductos />

  <section class="catalogo" id="catalogo">
    <div class="wrap catalogo-in">
      <!-- Índice fijo a la izquierda; en móvil, barra fija arriba. Sin JS no aparece y se ve todo el catálogo -->
      <form
        class="indice"
        id="filtros"
        role="search"
        aria-label={f.titulo}
        data-uno={f.resultados(1)}
        data-varios={f.resultados(999)}
        hidden
      >
        <label class="buscar">
          <span class="sr">{f.buscar}</span>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <input type="search" name="q" placeholder={f.buscar} autocomplete="off" />
        </label>

        <div class="bloque temp-bloque">
          <p class="rotulo">{f.temperatura}</p>
          <div class="temps" role="group" aria-label={f.temperatura}>
            {temperaturas.map((x) => (
              <button type="button" class="temp" data-v={x} aria-pressed="false">
                <IconoTemp t={x} />
                {may(t.temperatura[x])}
              </button>
            ))}
          </div>
        </div>

        <div class="bloque cats" role="group" aria-label={f.aplicacion}>
          <p class="rotulo">{f.aplicacion}</p>
          <button type="button" class="cat todo" data-c="" aria-pressed="true">
            <span class="nom">{f.todo}</span> <span class="n"></span>
          </button>
          {grupos.map((g) => (
            <div class="grupo">
              <p class="g-nombre">{g.nombre}</p>
              {g.cats.map((c) => (
                <button type="button" class="cat" data-c={c} data-nombre={nombreCat(c)} aria-pressed="false">
                  <span class="nom">{nombreCorto(c)}</span> <span class="n" />
                </button>
              ))}
            </div>
          ))}
        </div>

        <button type="button" class="borrar limpiar" hidden>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          {f.limpiar}
        </button>
      </form>

      <div class="lista">
        <!-- Lo que se está viendo: la aplicación elegida (o todo) en grande y cuántos productos hay -->
        <header class="cabeza" id="cabeza" data-todo={f.todoTitulo}>
          <h2 aria-live="polite">{f.todoTitulo}</h2>
          <p class="total"></p>
        </header>

        <ul class="rejilla" id="rejilla">
          {fichas.map((x) =>
            x.tipo === 'modelo' ? (
              <li
                class="ficha"
                id={x.m.principal ? x.m.serie : x.m.slug}
                data-cat={x.cat}
                data-t={x.m.temperatura}
                data-texto={plano(
                  x.m.nombre,
                  nombreCat(x.cat),
                  grupoDe(x.cat),
                  textoSerie(lang, x.m.serie).frase,
                  capacidad(x.m),
                  x.m.pantalla,
                  t.temperatura[x.m.temperatura],
                )}
              >
                <Tarjeta cat={nombreCat(x.cat)} modelo={x.m} capacidad={capacidad(x.m)} />
                <label class="comparar">
                  <input type="checkbox" value={x.m.slug} />
                  <span class="caja" aria-hidden="true" />
                  {tc.comparar}
                  <span class="sr">{x.m.nombre}</span>
                </label>
              </li>
            ) : (
              <li
                class="ficha"
                id={x.p.slug}
                data-cat={x.cat}
                data-texto={plano(
                  t.laboratorio.items[x.p.slug].nombre,
                  x.p.modelo,
                  nombreCat(x.cat),
                  t.laboratorio.items[x.p.slug].frase,
                  t.laboratorio.items[x.p.slug].datos,
                )}
              >
                <Tarjeta cat={nombreCat(x.cat)} lab={x.p} />
              </li>
            ),
          )}
          <li class="vacio" hidden>
            <p>{f.vacio}</p>
            <button type="button" class="btn red limpiar">
              {f.limpiar}
            </button>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Comparador: barra abajo con las elegidas y, al abrirla, las máquinas lado a lado -->
  <div class="barra-comparar" id="barra-comparar" role="region" aria-label={tc.titulo} hidden>
    <ul class="elegidas"></ul>
    <p class="pista-otra">{tc.otra}</p>
    <div class="barra-acciones">
      <button type="button" class="vaciar">
        {tc.vaciar}
      </button>
      <button type="button" class="abrir-comparar" data-txt={tc.abrir(999)}></button>
    </div>
  </div>

  <dialog class="comparador" id="comparador" aria-labelledby="comparador-tit">
    <div class="comp-cab">
      <h2 id="comparador-tit">{tc.titulo}</h2>
      <button type="button" class="cerrar-comp" aria-label={tc.cerrar}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <div class="comp-tabla"></div>
  </dialog>

  <script
    type="application/json"
    id="datos-comparar"
    set:html={JSON.stringify({
      maquinas: comparables,
      filas: filasComparar,
      textos: { quitar: tc.quitar('{n}'), maximo: tc.maximo, verFicha: tf.verFicha, mejor: tc.mejor },
    })}
  />
</Base>

<script>
  import { iniciarComparador } from '../../scripts/comparador';
  iniciarComparador();

  // Filtros sencillos: una aplicación, la temperatura (se pueden sumar) y el buscador sin tildes.
  // Cada aplicación dice cuántos productos quedarían al pulsarla y el título de la lista cambia con ella.
  const form = document.getElementById('filtros') as HTMLFormElement | null;
  const rejilla = document.getElementById('rejilla');
  const cabeza = document.getElementById('cabeza');
  if (form && rejilla && cabeza) {
    form.hidden = false;
    const total = (n: number) => (n === 1 ? form.dataset.uno! : form.dataset.varios!.replace('999', String(n)));
    const fichas = [...rejilla.querySelectorAll<HTMLElement>('.ficha')];
    const vacio = rejilla.querySelector<HTMLElement>('.vacio')!;
    const cats = [...form.querySelectorAll<HTMLButtonElement>('.cat')];
    const temps = [...form.querySelectorAll<HTMLButtonElement>('.temp')];
    const q = form.querySelector<HTMLInputElement>('input[name=q]')!;
    const borrar = [...document.querySelectorAll<HTMLButtonElement>('.limpiar')];
    const titulo = cabeza.querySelector('h2')!;
    const totalEl = cabeza.querySelector<HTMLElement>('.total')!;

    let cat = '';
    const elegidas = new Set<string>();
    const plano = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
    const cumple = (el: HTMLElement, c = cat) => {
      if (c && el.dataset.cat !== c) return false;
      if (elegidas.size && !elegidas.has(el.dataset.t ?? '')) return false;
      const texto = plano(q.value);
      return !texto || texto.split(/\s+/).every((p) => (el.dataset.texto ?? '').includes(p));
    };

    let primera = true;
    const aplicar = () => {
      const visibles = new Set(fichas.filter((el) => cumple(el)));
      let i = 0;
      for (const el of fichas) {
        const ver = visibles.has(el);
        if (ver && !primera) {
          el.style.setProperty('--i', String(Math.min(i, 8)));
          el.classList.remove('entra');
          void el.offsetWidth;
          el.classList.add('entra');
        }
        if (ver) i++;
        el.hidden = !ver;
      }
      for (const b of cats) {
        const c = b.dataset.c ?? '';
        const n = fichas.filter((el) => cumple(el, c)).length;
        b.setAttribute('aria-pressed', String(c === cat));
        b.disabled = c !== cat && n === 0;
        b.querySelector('.n')!.textContent = String(n);
      }
      for (const b of temps) b.setAttribute('aria-pressed', String(elegidas.has(b.dataset.v!)));
      const hay = !!cat || elegidas.size > 0 || !!q.value.trim();
      for (const b of borrar) if (!b.closest('.vacio')) b.hidden = !hay;
      titulo.textContent = cats.find((b) => b.dataset.c === cat)?.dataset.nombre ?? cabeza.dataset.todo!;
      totalEl.textContent = total(visibles.size);
      vacio.hidden = visibles.size > 0;
      // La búsqueda queda en la dirección para poder compartirla
      const url = new URL(location.href);
      const poner = (k: string, v: string) => (v ? url.searchParams.set(k, v) : url.searchParams.delete(k));
      poner('c', cat);
      poner('t', [...elegidas].join(','));
      poner('q', q.value.trim());
      history.replaceState(null, '', url);
      primera = false;
    };

    // Estado inicial desde la dirección; si se llega a una ficha concreta (lupa, Tecnología), se ve todo
    const url = new URL(location.href);
    const aFicha = location.hash && document.getElementById(location.hash.slice(1))?.classList.contains('ficha');
    if (!aFicha) {
      cat = url.searchParams.get('c') ?? '';
      for (const v of url.searchParams.get('t')?.split(',') ?? []) if (v) elegidas.add(v);
      q.value = url.searchParams.get('q') ?? '';
    }

    // Al cambiar de aplicación, la lista sube para verla desde arriba
    const subir = () => {
      const y = cabeza.getBoundingClientRect().top + window.scrollY - 120;
      if (window.scrollY > y) window.scrollTo({ top: y, behavior: 'smooth' });
    };
    for (const b of cats) {
      b.addEventListener('click', () => {
        cat = b.dataset.c ?? '';
        aplicar();
        subir();
      });
    }
    for (const b of temps) {
      b.addEventListener('click', () => {
        const v = b.dataset.v!;
        if (elegidas.has(v)) elegidas.delete(v);
        else elegidas.add(v);
        aplicar();
      });
    }
    let espera = 0;
    q.addEventListener('input', () => {
      clearTimeout(espera);
      espera = window.setTimeout(aplicar, 120);
    });
    form.addEventListener('submit', (e) => e.preventDefault());
    for (const b of borrar) {
      b.addEventListener('click', () => {
        cat = '';
        elegidas.clear();
        q.value = '';
        aplicar();
      });
    }
    aplicar();

    // Al bajar, las tarjetas entran de abajo arriba, escalonadas por fila
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      rejilla.classList.add('revela');
      const io = new IntersectionObserver(
        (entradas) => {
          entradas
            .filter((e) => e.isIntersecting)
            .forEach((e, i) => {
              const el = e.target as HTMLElement;
              el.style.setProperty('--d', `${i * 70}ms`);
              el.classList.add('visto');
              io.unobserve(el);
            });
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      for (const el of fichas) io.observe(el);
    }
  }
</script>

<style>
  /* Lo que el filtro oculta, oculto aunque tenga su propio display */
  [hidden] {
    display: none !important;
  }

  /* ——— Catálogo: índice fijo a la izquierda y la lista a la derecha ——— */
  .catalogo {
    --arriba: 28px;
    padding-block: clamp(40px, 5vw, 64px) clamp(72px, 9vw, 120px);
  }
  /* Con la cabecera de la web a la vista, el índice baja para no quedar debajo */
  :global(html:has(#top:not(.oculta))) .catalogo {
    --arriba: 104px;
  }
  .catalogo-in {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr);
    gap: clamp(32px, 4vw, 56px);
    align-items: start;
  }
  .catalogo-in:has(.indice[hidden]) {
    grid-template-columns: minmax(0, 1fr);
  }

  .indice {
    position: sticky;
    top: var(--arriba);
    max-height: calc(100vh - var(--arriba) - 16px);
    overflow-y: auto;
    scrollbar-width: thin;
    display: grid;
    gap: 28px;
    padding-bottom: 8px;
    transition: top 0.35s var(--ease);
  }
  .rotulo,
  .g-nombre {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  /* Grupos del índice, en negrita y con su raya roja corta */
  .g-nombre {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 22px 0 6px;
    letter-spacing: 0.1em;
  }
  .g-nombre::before {
    content: '';
    width: 14px;
    height: 2px;
    background: var(--red);
  }
  .buscar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-bottom: 2px solid var(--ink);
    color: var(--red);
    transition:
      border-color 0.2s var(--ease),
      background 0.2s var(--ease);
  }
  .buscar:focus-within {
    border-color: var(--red);
    box-shadow: 0 0 0 3px rgba(221, 4, 10, 0.12);
  }
  .buscar input::placeholder {
    color: var(--body);
  }
  .buscar input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    font: 400 17px var(--f);
    color: var(--ink);
  }

  /* Temperatura: tres casillas con su punto de color; se pueden sumar */
  .temps {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .temp {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 11px;
    border: 1px solid var(--line);
    background: #fff;
    font: 400 15px var(--f);
    color: var(--ink);
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  /* Cada temperatura con su icono y su color; elegida, la casilla entera se pinta de ese color */
  .temp {
    --c: var(--t-ventilada);
  }
  .temp[data-v='refrigerada'] {
    --c: var(--t-refrigerada);
  }
  .temp[data-v='calefactada'] {
    --c: var(--t-calefactada);
  }
  .temp :global(.icono-temp) {
    color: var(--c);
  }
  .temp[aria-pressed='true'] :global(.icono-temp) {
    color: #fff;
  }
  .temp[aria-pressed='true'] {
    background: var(--c);
    border-color: var(--c);
    color: #fff;
    font-weight: 700;
  }

  /* Aplicaciones: una lista como el índice de un catálogo; la elegida, con su raya roja */
  .cats {
    display: block;
  }
  .cat {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 7px 0 7px 14px;
    border: 0;
    border-left: 2px solid var(--panel);
    background: none;
    font: 400 17px/1.2 var(--f);
    color: var(--body);
    text-align: left;
    cursor: pointer;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      padding 0.3s var(--ease);
  }
  .cat.todo {
    font-weight: 700;
    color: var(--ink);
  }
  .n {
    font-size: 14px;
    font-weight: 400;
    color: var(--body);
    font-variant-numeric: tabular-nums;
  }
  .cat[aria-pressed='true'] {
    border-left-color: var(--red);
    padding-left: 18px;
    color: var(--red);
    font-weight: 700;
  }
  .cat[aria-pressed='true'] .n {
    color: var(--red);
  }
  .cat:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .borrar {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--red);
    background: var(--red);
    font: 700 15px var(--f);
    color: #fff;
    cursor: pointer;
    animation: aparece 0.25s var(--ease);
  }
  @media (hover: hover) {
    .cat:not(:disabled, [aria-pressed='true']):hover {
      border-left-color: var(--ink);
      color: var(--ink);
    }
    .temp:not([aria-pressed='true']):hover {
      border-color: var(--ink);
    }
    .borrar:hover {
      background: var(--red-d);
    }
  }
  .cat:focus-visible,
  .temp:focus-visible,
  .borrar:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  /* Cabecera de la lista: lo elegido en grande y fino, y el total a la derecha */
  .cabeza {
    display: flex;
