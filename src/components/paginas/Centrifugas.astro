---
// Catálogo de productos: los 23 modelos de centrífuga (fotos y aplicaciones de la página de productos de la web
// actual), los accesorios y los otros productos de laboratorio. Cabecera oscura como la portada, un panel de
// filtros de cristal (buscador, aplicación, temperatura, pantalla y orden) y una tarjeta por modelo con los cuatro
// iconos de la web actual. Los filtros se guardan en la dirección para poder compartir una búsqueda.
import Base from '../../layouts/Base.astro';
import {
  categorias,
  modelos,
  productos,
  totalModelos,
  type Categoria,
  type Modelo,
  type Temperatura,
} from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import { idioma, numero, textoSerie, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const f = t.catalogo.filtros;

const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// Texto para el buscador: sin tildes ni mayúsculas, como la lupa de la cabecera
const plano = (...partes: (string | undefined)[]) =>
  partes.filter(Boolean).join(' ').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

type Otro = 'accesorios' | 'laboratorio';
const todas: (Categoria | Otro)[] = [...categorias.generales, ...categorias.especiales, 'accesorios', 'laboratorio'];
const nombreCat = (c: Categoria | Otro) =>
  c === 'accesorios'
    ? t.laboratorio.accesorios
    : c === 'laboratorio'
      ? t.laboratorio.equipos
      : t.catalogo.categorias[c];
const nombreCorto = (c: Categoria | Otro) => (c === 'accesorios' || c === 'laboratorio' ? f.cortos[c] : nombreCat(c));
const grupoDe = (c: Categoria | Otro) =>
  (categorias.generales as readonly string[]).includes(c)
    ? t.catalogo.grupos.generales
    : (categorias.especiales as readonly string[]).includes(c)
      ? t.catalogo.grupos.especiales
      : t.catalogo.grupos.otros;

const cuenta = (c: Categoria | Otro) =>
  c === 'accesorios'
    ? accesorios.length
    : c === 'laboratorio'
      ? equipos.length
      : modelos.filter((m) => m.categoria === c).length;

const temperaturas: Temperatura[] = ['ventilada', 'refrigerada', 'calefactada'];
const pantallas = ['TFT', 'LCD', 'LED'] as const;

// Tarjetas en el orden del catálogo: por aplicación, y dentro de cada una como en la web actual
type Ficha =
  { tipo: 'modelo'; cat: Categoria | Otro; m: Modelo } | { tipo: 'lab'; cat: Categoria | Otro; p: ProductoLab };
const lab = (c: Otro, items: ProductoLab[]): Ficha[] => items.map((p) => ({ tipo: 'lab', cat: c, p }));
const fichas = todas.flatMap((c): Ficha[] =>
  c === 'accesorios'
    ? lab(c, accesorios)
    : c === 'laboratorio'
      ? lab(c, equipos)
      : modelos.filter((m) => m.categoria === c).map((m): Ficha => ({ tipo: 'modelo', cat: c, m })),
);
---

<Base title={t.catalogo.title} description={t.catalogo.description(productos.length, totalModelos)}>
  <!-- Cabecera oscura, como la portada: el rotor girando muy apagado, el título y tres cifras en cristal -->
  <section class="cab">
    <div class="fondo" aria-hidden="true">
      <img src="/img/fotos/portada-rotor-960.webp" alt="" width="960" height="640" decoding="async" />
    </div>
    <div class="wrap">
      <h1>
        {t.catalogo.titulo[0]}
        <b>{t.catalogo.titulo[1]}</b>
      </h1>
      <p class="lead">{t.catalogo.lead(productos.length, totalModelos)}</p>
      <ul class="cifras">
        <li>
          <b>{modelos.length}</b> {t.catalogo.cifras.centrifugas}
        </li>
        <li>
          <b>{categorias.generales.length + categorias.especiales.length}</b> {t.catalogo.cifras.aplicaciones}
        </li>
        <li>
          <b>{accesorios.length + equipos.length}</b> {t.catalogo.cifras.otros}
        </li>
      </ul>
    </div>
  </section>

  <section class="cat">
    <div class="wrap">
      <!-- Panel de filtros: cristal sobre la cabecera. Sin JS se ve todo el catálogo y el panel no aparece -->
      <form
        class="filtros"
        id="filtros"
        role="search"
        aria-label={f.titulo}
        data-uno={f.resultados(1)}
        data-varios={f.resultados(999)}
        hidden
      >
        <div class="fila primera">
          <label class="buscar">
            <span class="sr">{f.buscar}</span>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
              <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            <input type="search" name="q" placeholder={f.buscar} autocomplete="off" />
          </label>
          <label class="orden">
            <span>{f.orden}</span>
            <select name="o">
              <option value="">{f.ordenes.catalogo}</option>
              <option value="rapidas">{f.ordenes.rapidas}</option>
              <option value="lentas">{f.ordenes.lentas}</option>
              <option value="nombre">{f.ordenes.nombre}</option>
            </select>
          </label>
        </div>

        <div class="fila">
          <p class="etq">{f.titulo}</p>
          <div class="chips cats">
            <button type="button" class="chip todo" data-todo aria-pressed="true">
              {f.todo}
            </button>
            {[
              [t.catalogo.grupos.generales, categorias.generales],
              [t.catalogo.grupos.especiales, categorias.especiales],
              [t.catalogo.grupos.otros, ['accesorios', 'laboratorio']],
            ].map(([grupo, lista]) => (
              <div class="grupo-chips" role="group" aria-label={grupo as string}>
                <span class="nombre-grupo" aria-hidden="true">
                  {grupo as string}
                </span>
                {(lista as (Categoria | Otro)[]).map((c) => (
                  <button type="button" class="chip" data-f="c" data-v={c} aria-pressed="false">
                    {nombreCorto(c)} <span class="n">{cuenta(c)}</span>
                  </button>
                ))}
              </div>
            ))}
          </div>
        </div>

        <div class="fila facetas">
          <div class="chips" role="group" aria-label={f.temperatura}>
            <p class="etq">{f.temperatura}</p>
            {temperaturas.map((x) => (
              <button type="button" class="chip" data-f="t" data-v={x} aria-pressed="false">
                {may(t.temperatura[x])} <span class="n" />
              </button>
            ))}
          </div>
          <div class="chips" role="group" aria-label={f.pantalla}>
            <p class="etq">{f.pantalla}</p>
            {pantallas.map((x) => (
              <button type="button" class="chip" data-f="p" data-v={x} aria-pressed="false">
                {x} <span class="n" />
              </button>
            ))}
          </div>
          <div class="estado">
            <p class="total" aria-live="polite"></p>
            <button type="button" class="limpiar" hidden>
              {f.limpiar}
            </button>
          </div>
        </div>
      </form>

      <!-- Barra fija al bajar: lo que está filtrado, el total y vuelta al panel -->
      <div class="barra" aria-hidden="true">
        <div class="wrap barra-in">
          <p class="resumen"></p>
          <p class="total"></p>
          <button type="button" class="subir" tabindex="-1">
            {f.abrir}
          </button>
        </div>
      </div>

      <ul class="rejilla" id="rejilla">
        {todas.map((c) => (
          <>
            <li class="titulo" data-cat={c}>
              <h2>{nombreCat(c)}</h2>
              <span>{grupoDe(c)}</span>
            </li>
            {fichas
              .filter((x) => x.cat === c)
              .map((x) =>
                x.tipo === 'modelo' ? (
                  <li
                    class="ficha"
                    id={x.m.principal ? x.m.serie : x.m.slug}
                    data-cat={c}
                    data-t={x.m.temperatura}
                    data-p={x.m.pantalla}
                    data-rpm={x.m.rpm.replace(/\./g, '')}
                    data-nombre={x.m.nombre}
                    data-texto={plano(
                      x.m.nombre,
                      nombreCat(c),
                      grupoDe(c),
                      textoSerie(lang, x.m.serie).frase,
                      x.m.capacidad,
                      x.m.pantalla,
                      t.temperatura[x.m.temperatura],
                    )}
                  >
                    <article>
                      <div class="foto">
                        <img
                          src={x.m.imagen.src}
                          alt={x.m.nombre}
                          width={x.m.imagen.ancho}
                          height={x.m.imagen.alto}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="luz" aria-hidden="true" />
                      </div>
                      <div class="cuerpo">
                        <p class="cat-n">{nombreCat(c)}</p>
                        <h3>{x.m.nombre}</h3>
                        <p class="frase">{textoSerie(lang, x.m.serie).frase}</p>
                        {/* Los cuatro iconos de la web actual: capacidad, pantalla, velocidad y temperatura */}
                        <ul class="iconos">
                          <li>
                            <i style="--ico: url(/img/iconos/ficha-capacidad.svg)" aria-hidden="true" />
                            <span class="sr">{t.catalogo.iconos.capacidad}: </span>
                            {x.m.capacidad === productos.find((p) => p.slug === x.m.serie)?.capacidad
                              ? (textoSerie(lang, x.m.serie).capacidad ?? x.m.capacidad)
                              : x.m.capacidad}
                          </li>
                          <li>
                            <i style="--ico: url(/img/iconos/ficha-pantalla.svg)" aria-hidden="true" />
                            <span class="sr">{t.catalogo.iconos.pantalla}: </span>
                            {x.m.pantalla}
                          </li>
                          <li>
                            <i style="--ico: url(/img/iconos/ficha-velocidad.svg)" aria-hidden="true" />
                            <span class="sr">{t.catalogo.iconos.velocidad}: </span>
                            {numero(lang, x.m.rpm)} rpm
                            {x.m.xg && <small>{numero(lang, x.m.xg)} xg</small>}
                          </li>
                          <li>
                            <i style="--ico: url(/img/iconos/ficha-info.svg)" aria-hidden="true" />
                            <span class="sr">{t.catalogo.iconos.temperatura}: </span>
                            {may(t.temperatura[x.m.temperatura])}
                          </li>
                        </ul>
                      </div>
                    </article>
                  </li>
                ) : (
                  <li
                    class="ficha lab"
                    id={x.p.slug}
                    data-cat={c}
                    data-rpm="0"
                    data-nombre={t.laboratorio.items[x.p.slug].nombre}
                    data-texto={plano(
                      t.laboratorio.items[x.p.slug].nombre,
                      x.p.modelo,
                      nombreCat(c),
                      t.laboratorio.items[x.p.slug].frase,
                      t.laboratorio.items[x.p.slug].datos,
                    )}
                  >
                    <article>
                      <div class:list={['foto', { doble: x.p.imagen2 }]}>
                        <img
                          src={x.p.imagen.src}
                          alt={t.laboratorio.items[x.p.slug].nombre}
                          width={x.p.imagen.ancho}
                          height={x.p.imagen.alto}
                          loading="lazy"
                          decoding="async"
                        />
                        {x.p.imagen2 && (
                          <img
                            class="segunda"
                            src={x.p.imagen2.src}
                            alt=""
                            width={x.p.imagen2.ancho}
                            height={x.p.imagen2.alto}
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                        <span class="luz" aria-hidden="true" />
                      </div>
                      <div class="cuerpo">
                        <p class="cat-n">{nombreCat(c)}</p>
                        <h3>
                          {t.laboratorio.items[x.p.slug].nombre} <span>{x.p.modelo}</span>
                        </h3>
                        <p class="frase">{t.laboratorio.items[x.p.slug].frase}</p>
                        <p class="datos">{t.laboratorio.items[x.p.slug].datos}</p>
                        {x.p.pdf && (
                          <a class="arrow pdf" href={x.p.pdf} target="_blank" rel="noopener">
                            {t.laboratorio.pdf}
                          </a>
                        )}
                      </div>
                    </article>
                  </li>
                ),
              )}
          </>
        ))}
        <li class="vacio" hidden>
          <p>{f.vacio}</p>
          <button type="button" class="btn red limpiar">
            {f.limpiar}
          </button>
        </li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // Filtros del catálogo: aplicación, temperatura y pantalla (dentro de cada uno se suma, entre ellos se cruza),
  // buscador sin tildes y orden. Cada botón dice cuántos productos quedarían si se pulsa.
  const form = document.getElementById('filtros') as HTMLFormElement | null;
  const rejilla = document.getElementById('rejilla');
  if (form && rejilla) {
    form.hidden = false;
    document.documentElement.classList.add('con-filtros');
    // "1 producto" / "N productos", con los textos de cada idioma
    const total = (n: number) => (n === 1 ? form.dataset.uno! : form.dataset.varios!.replace('999', String(n)));
    const fichas = [...rejilla.querySelectorAll<HTMLElement>('.ficha')];
    const titulos = [...rejilla.querySelectorAll<HTMLElement>('.titulo')];
    const vacio = rejilla.querySelector<HTMLElement>('.vacio')!;
    const chips = [...form.querySelectorAll<HTMLButtonElement>('.chip[data-f]')];
    const todo = form.querySelector<HTMLButtonElement>('[data-todo]')!;
    const q = form.querySelector<HTMLInputElement>('input[name=q]')!;
    const orden = form.querySelector<HTMLSelectElement>('select[name=o]')!;
    const limpiar = [...document.querySelectorAll<HTMLButtonElement>('.limpiar')];
    const totales = [...document.querySelectorAll<HTMLElement>('.total')];
    const barra = document.querySelector<HTMLElement>('.barra')!;
    const resumen = barra.querySelector<HTMLElement>('.resumen')!;

    type Clave = 'c' | 't' | 'p';
    const estado: Record<Clave, Set<string>> = { c: new Set(), t: new Set(), p: new Set() };
    const plano = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
    const campo: Record<Clave, string> = { c: 'cat', t: 't', p: 'p' };
    const cumple = (el: HTMLElement, sin?: Clave, extra?: [Clave, string]) => {
      for (const k of ['c', 't', 'p'] as Clave[]) {
        const valores = new Set(k === sin ? [] : estado[k]);
        if (extra && extra[0] === k) valores.add(extra[1]);
        if (valores.size && !valores.has(el.dataset[campo[k]] ?? '')) return false;
      }
      const texto = plano(q.value);
      return !texto || texto.split(/\s+/).every((p) => (el.dataset.texto ?? '').includes(p));
    };

    let primera = true;
    const aplicar = () => {
      const visibles = new Set(fichas.filter((el) => cumple(el)));
      let i = 0;
      for (const el of fichas) {
        const ver = visibles.has(el);
        if (ver && el.hidden && !primera) {
          el.style.setProperty('--i', String(Math.min(i, 8)));
          el.classList.remove('entra');
          void el.offsetWidth;
          el.classList.add('entra');
        }
        if (ver) i++;
        el.hidden = !ver;
      }
      // Orden: por aplicación (con sus títulos), por velocidad o por nombre
      const o = orden.value;
      const lista = [...fichas];
      if (o === 'rapidas' || o === 'lentas') {
        const s = o === 'rapidas' ? -1 : 1;
        lista.sort((a, b) => {
          const ra = Number(a.dataset.rpm),
            rb = Number(b.dataset.rpm);
          if (!ra || !rb) return ra ? -1 : rb ? 1 : 0;
          return s * (ra - rb);
        });
      } else if (o === 'nombre') {
        lista.sort((a, b) =>
          (a.dataset.nombre ?? '').localeCompare(b.dataset.nombre ?? '', document.documentElement.lang),
        );
      }
      lista.forEach((el, n) => (el.style.order = o ? String(n) : ''));
      for (const ti of titulos) {
        ti.hidden = !!o || !fichas.some((el) => visibles.has(el) && el.dataset.cat === ti.dataset.cat);
      }
      // Cada botón: cuántos quedarían al pulsarlo; los que dejarían cero, apagados
      for (const ch of chips) {
        const k = ch.dataset.f as Clave,
          v = ch.dataset.v!;
        const n = fichas.filter((el) => cumple(el, k, [k, v])).length;
        const activo = estado[k].has(v);
        ch.setAttribute('aria-pressed', String(activo));
        ch.disabled = !activo && n === 0;
        const num = ch.querySelector('.n');
        if (num) num.textContent = String(n);
      }
      todo.setAttribute('aria-pressed', String(estado.c.size === 0));
      const hay = estado.c.size + estado.t.size + estado.p.size > 0 || !!q.value.trim() || !!o;
      for (const b of limpiar) if (b.closest('.estado')) b.hidden = !hay;
      for (const tt of totales) tt.textContent = total(visibles.size);
      vacio.hidden = visibles.size > 0;
      const activos = [...chips].filter((ch) => ch.getAttribute('aria-pressed') === 'true');
      resumen.textContent = activos.length
        ? activos.map((ch) => ch.firstChild?.textContent?.trim()).join(' · ')
        : (todo.textContent ?? '');
      // La búsqueda queda en la dirección para poder compartirla
      const url = new URL(location.href);
      for (const k of ['c', 't', 'p'] as Clave[]) {
        if (estado[k].size) url.searchParams.set(k, [...estado[k]].join(','));
        else url.searchParams.delete(k);
      }
      if (q.value.trim()) url.searchParams.set('q', q.value.trim());
      else url.searchParams.delete('q');
      if (o) url.searchParams.set('o', o);
      else url.searchParams.delete('o');
      history.replaceState(null, '', url);
      primera = false;
    };

    // Estado inicial desde la dirección
    const url = new URL(location.href);
    for (const k of ['c', 't', 'p'] as Clave[]) {
      for (const v of url.searchParams.get(k)?.split(',') ?? []) if (v) estado[k].add(v);
    }
    q.value = url.searchParams.get('q') ?? '';
    orden.value = url.searchParams.get('o') ?? '';
    // Si se llega a una ficha concreta (lupa, Tecnología), se ve todo para que esté
    if (location.hash && document.getElementById(location.hash.slice(1))?.classList.contains('ficha')) {
      for (const k of ['c', 't', 'p'] as Clave[]) estado[k].clear();
      q.value = '';
    }

    for (const ch of chips) {
      ch.addEventListener('click', () => {
        const k = ch.dataset.f as Clave,
          v = ch.dataset.v!;
        if (estado[k].has(v)) estado[k].delete(v);
        else estado[k].add(v);
        aplicar();
      });
    }
    todo.addEventListener('click', () => {
      estado.c.clear();
      aplicar();
    });
    let espera = 0;
    q.addEventListener('input', () => {
      clearTimeout(espera);
      espera = window.setTimeout(aplicar, 120);
    });
    orden.addEventListener('change', aplicar);
    form.addEventListener('submit', (e) => e.preventDefault());
    for (const b of limpiar) {
      b.addEventListener('click', () => {
        for (const k of ['c', 't', 'p'] as Clave[]) estado[k].clear();
        q.value = '';
        orden.value = '';
        aplicar();
      });
    }
    aplicar();

    // Barra fija: aparece cuando el panel sale de la pantalla y quedan productos debajo
    if ('IntersectionObserver' in window) {
      let panelFuera = false,
        rejillaDentro = false;
      const ver = () => {
        const si = panelFuera && rejillaDentro;
        barra.classList.toggle('visible', si);
        barra.setAttribute('aria-hidden', String(!si));
        barra.querySelector('button')!.tabIndex = si ? 0 : -1;
      };
      new IntersectionObserver(([e]) => {
        panelFuera = !e.isIntersecting && e.boundingClientRect.top < 0;
        ver();
      }).observe(form);
      new IntersectionObserver(([e]) => {
        rejillaDentro = e.isIntersecting;
        ver();
      }).observe(rejilla);
    }
    barra.querySelector('button')!.addEventListener('click', () => {
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => q.focus({ preventScroll: true }), 500);
    });
  }
</script>

<style>
  /* Cabecera oscura con el rotor apagado detrás, como la primera pantalla de la portada */
  .cab {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #111315;
    color: #fff;
    padding-block: clamp(56px, 9vw, 112px) clamp(120px, 14vw, 168px);
  }
  .fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .fondo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 45%;
    opacity: 0.55;
  }
  .cab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(10, 11, 12, 0.92) 0%, rgba(10, 11, 12, 0.72) 45%, rgba(10, 11, 12, 0.35) 100%),
      linear-gradient(0deg, rgba(10, 11, 12, 0.85) 0%, rgba(10, 11, 12, 0) 45%);
  }
  h1 {
    font-size: var(--t-titulo);
    font-weight: 300;
    line-height: 0.94;
    letter-spacing: -0.015em;
  }
  /* "productos" en el rojo de la marca, como "ción" en la portada */
  h1 b {
    display: block;
    font-weight: 700;
    color: var(--red);
  }
  .lead {
    margin-top: 22px;
    max-width: 46ch;
    font-size: var(--t-sub);
    color: rgba(255, 255, 255, 0.82);
  }
  /* Tres cifras en placas de cristal, con el filo de luz de los botones de la portada */
  .cifras {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cifras li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 18px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
    font-size: 16px;
    color: rgba(255, 255, 255, 0.82);
  }
  .cifras b {
    font-size: 30px;
