---
// Catálogo de productos: un hero grande con una foto de la empresa y badges de cristal, y debajo la página en blanco
// con filtros sencillos (buscador, temperatura y aplicaciones) y una tarjeta por modelo: los 23 de centrífuga (fotos y
// aplicaciones de la página de productos de la web actual), los accesorios y los otros productos de laboratorio.
// Los filtros se guardan en la dirección para poder compartir una búsqueda.
import Base from '../../layouts/Base.astro';
import {
  categorias,
  modelos,
  productos,
  totalModelos,
  type Categoria,
  type Modelo,
  type Temperatura,
} from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import { idioma, numero, textoSerie, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const f = t.catalogo.filtros;

const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// Texto para el buscador: sin tildes ni mayúsculas, como la lupa de la cabecera
const plano = (...partes: (string | undefined)[]) =>
  partes.filter(Boolean).join(' ').normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();

type Otro = 'accesorios' | 'laboratorio';
type Cat = Categoria | Otro;
const todas: Cat[] = [...categorias.generales, ...categorias.especiales, 'accesorios', 'laboratorio'];
const nombreCat = (c: Cat) =>
  c === 'accesorios'
    ? t.laboratorio.accesorios
    : c === 'laboratorio'
      ? t.laboratorio.equipos
      : t.catalogo.categorias[c];
const nombreCorto = (c: Cat) => (c === 'accesorios' || c === 'laboratorio' ? f.cortos[c] : nombreCat(c));
const grupoDe = (c: Cat) =>
  (categorias.generales as readonly string[]).includes(c)
    ? t.catalogo.grupos.generales
    : (categorias.especiales as readonly string[]).includes(c)
      ? t.catalogo.grupos.especiales
      : t.catalogo.grupos.otros;

const temperaturas: Temperatura[] = ['ventilada', 'refrigerada', 'calefactada'];

// Tarjetas en el orden del catálogo: por aplicación, y dentro de cada una como en la web actual
type Ficha = { tipo: 'modelo'; cat: Cat; m: Modelo } | { tipo: 'lab'; cat: Cat; p: ProductoLab };
const lab = (c: Otro, items: ProductoLab[]): Ficha[] => items.map((p) => ({ tipo: 'lab', cat: c, p }));
const fichas = todas.flatMap((c): Ficha[] =>
  c === 'accesorios'
    ? lab(c, accesorios)
    : c === 'laboratorio'
      ? lab(c, equipos)
      : modelos.filter((m) => m.categoria === c).map((m): Ficha => ({ tipo: 'modelo', cat: c, m })),
);
const capacidad = (m: Modelo) =>
  m.capacidad === productos.find((p) => p.slug === m.serie)?.capacidad
    ? (textoSerie(lang, m.serie).capacidad ?? m.capacidad)
    : m.capacidad;
---

<Base title={t.catalogo.title} description={t.catalogo.description(productos.length, totalModelos)}>
  <!-- Hero: una centrífuga en uso, a todo el ancho, con el título y los badges de cristal encima -->
  <section class="hero">
    <img
      class="hero-foto"
      src="/img/fotos/productos-hero.webp"
      srcset="/img/fotos/productos-hero-960.webp 960w, /img/fotos/productos-hero.webp 1800w"
      sizes="100vw"
      alt=""
      width="1800"
      height="1199"
      fetchpriority="high"
      decoding="async"
    />
    <div class="wrap hero-in">
      <h1>
        {t.catalogo.titulo[0]}
        <b>{t.catalogo.titulo[1]}</b>
      </h1>
      <p class="lead">{t.catalogo.lead(productos.length, totalModelos)}</p>
      <ul class="badges">
        <li>
          <b>{modelos.length}</b>
          <span>{t.catalogo.cifras.centrifugas}</span>
        </li>
        <li>
          <b>{categorias.generales.length + categorias.especiales.length}</b>
          <span>{t.catalogo.cifras.aplicaciones}</span>
        </li>
        <li>
          <b>1949</b>
          <span>{t.catalogo.cifras.desde}</span>
        </li>
        <li class="stock">
          <i aria-hidden="true"></i>
          <span>{t.catalogo.cifras.stock}</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Filtros sencillos en una barra blanca fija. Sin JS no aparece y se ve todo el catálogo -->
  <form
    class="filtros"
    id="filtros"
    role="search"
    aria-label={f.titulo}
    data-uno={f.resultados(1)}
    data-varios={f.resultados(999)}
    hidden
  >
    <div class="wrap filtros-in">
      <div class="arriba">
        <label class="buscar">
          <span class="sr">{f.buscar}</span>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <input type="search" name="q" placeholder={f.buscar} autocomplete="off" />
        </label>
        <div class="temps" role="group" aria-label={f.temperatura}>
          {temperaturas.map((x) => (
            <button type="button" class="temp" data-v={x} aria-pressed="false">
              {may(t.temperatura[x])}
            </button>
          ))}
        </div>
        <p class="total" aria-live="polite"></p>
        <button type="button" class="borrar limpiar" hidden>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          {f.limpiar}
        </button>
      </div>
      <div class="cats" role="group" aria-label={f.titulo}>
        <button type="button" class="cat" data-c="" aria-pressed="true">
          {f.todo} <span class="n"></span>
        </button>
        {todas.map((c) => (
          <button type="button" class="cat" data-c={c} aria-pressed="false" title={grupoDe(c)}>
            {nombreCorto(c)} <span class="n" />
          </button>
        ))}
      </div>
    </div>
  </form>

  <section class="catalogo">
    <div class="wrap">
      <ul class="rejilla" id="rejilla">
        {todas.map((c, i) => (
          <>
            <li class="titulo" data-cat={c}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h2>{nombreCat(c)}</h2>
              <span class="grupo-n">{grupoDe(c)}</span>
            </li>
            {fichas
              .filter((x) => x.cat === c)
              .map((x) =>
                x.tipo === 'modelo' ? (
                  <li
                    class="ficha"
                    id={x.m.principal ? x.m.serie : x.m.slug}
                    data-cat={c}
                    data-t={x.m.temperatura}
                    data-texto={plano(
                      x.m.nombre,
                      nombreCat(c),
                      grupoDe(c),
                      textoSerie(lang, x.m.serie).frase,
                      capacidad(x.m),
                      x.m.pantalla,
                      t.temperatura[x.m.temperatura],
                    )}
                  >
                    <article>
                      <div class="foto">
                        <img
                          src={x.m.imagen.src}
                          alt={x.m.nombre}
                          width={x.m.imagen.ancho}
                          height={x.m.imagen.alto}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="temp-tag" data-t={x.m.temperatura}>
                          {may(t.temperatura[x.m.temperatura])}
                        </span>
                      </div>
                      <div class="cuerpo">
                        <p class="cat-n">{nombreCat(c)}</p>
                        <h3>{x.m.nombre}</h3>
                        <p class="frase">{textoSerie(lang, x.m.serie).frase}</p>
                        {/* Los datos de la web actual, cada uno con su icono */}
                        <ul class="datos">
                          <li>
                            <i style="--ico: url(/img/iconos/ficha-capacidad.svg)" aria-hidden="true" />
                            <span>{t.catalogo.iconos.capacidad}</span>
                            <b>{capacidad(x.m)}</b>
                          </li>
                          <li>
                            <i style="--ico: url(/img/iconos/ficha-velocidad.svg)" aria-hidden="true" />
                            <span>{t.catalogo.iconos.velocidad}</span>
                            <b>
                              {numero(lang, x.m.rpm)} rpm
                              {x.m.xg && <small> · {numero(lang, x.m.xg)} xg</small>}
                            </b>
                          </li>
                          <li>
                            <i style="--ico: url(/img/iconos/ficha-pantalla.svg)" aria-hidden="true" />
                            <span>{t.catalogo.iconos.pantalla}</span>
                            <b>{x.m.pantalla}</b>
                          </li>
                        </ul>
                      </div>
                    </article>
                  </li>
                ) : (
                  <li
                    class="ficha lab"
                    id={x.p.slug}
                    data-cat={c}
                    data-texto={plano(
                      t.laboratorio.items[x.p.slug].nombre,
                      x.p.modelo,
                      nombreCat(c),
                      t.laboratorio.items[x.p.slug].frase,
                      t.laboratorio.items[x.p.slug].datos,
                    )}
                  >
                    <article>
                      <div class:list={['foto', { doble: x.p.imagen2 }]}>
                        <img
                          src={x.p.imagen.src}
                          alt={t.laboratorio.items[x.p.slug].nombre}
                          width={x.p.imagen.ancho}
                          height={x.p.imagen.alto}
                          loading="lazy"
                          decoding="async"
                        />
                        {x.p.imagen2 && (
                          <img
                            class="segunda"
                            src={x.p.imagen2.src}
                            alt=""
                            width={x.p.imagen2.ancho}
                            height={x.p.imagen2.alto}
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                      </div>
                      <div class="cuerpo">
                        <p class="cat-n">{nombreCat(c)}</p>
                        <h3>
                          {t.laboratorio.items[x.p.slug].nombre} <span>{x.p.modelo}</span>
                        </h3>
                        <p class="frase">{t.laboratorio.items[x.p.slug].frase}</p>
                        <p class="linea">{t.laboratorio.items[x.p.slug].datos}</p>
                        {x.p.pdf && (
                          <a class="arrow pdf" href={x.p.pdf} target="_blank" rel="noopener">
                            {t.laboratorio.pdf}
                          </a>
                        )}
                      </div>
                    </article>
                  </li>
                ),
              )}
          </>
        ))}
        <li class="vacio" hidden>
          <p>{f.vacio}</p>
          <button type="button" class="btn red limpiar">
            {f.limpiar}
          </button>
        </li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // Filtros sencillos: una aplicación, la temperatura (se pueden sumar) y el buscador sin tildes.
  // Cada aplicación dice cuántos productos quedarían al pulsarla.
  const form = document.getElementById('filtros') as HTMLFormElement | null;
  const rejilla = document.getElementById('rejilla');
  if (form && rejilla) {
    form.hidden = false;
    const total = (n: number) => (n === 1 ? form.dataset.uno! : form.dataset.varios!.replace('999', String(n)));
    const fichas = [...rejilla.querySelectorAll<HTMLElement>('.ficha')];
    const titulos = [...rejilla.querySelectorAll<HTMLElement>('.titulo')];
    const vacio = rejilla.querySelector<HTMLElement>('.vacio')!;
    const cats = [...form.querySelectorAll<HTMLButtonElement>('.cat')];
    const temps = [...form.querySelectorAll<HTMLButtonElement>('.temp')];
    const q = form.querySelector<HTMLInputElement>('input[name=q]')!;
    const borrar = [...document.querySelectorAll<HTMLButtonElement>('.limpiar')];
    const totalEl = form.querySelector<HTMLElement>('.total')!;

    let cat = '';
    const elegidas = new Set<string>();
    const plano = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
    const cumple = (el: HTMLElement, c = cat) => {
      if (c && el.dataset.cat !== c) return false;
      if (elegidas.size && !elegidas.has(el.dataset.t ?? '')) return false;
      const texto = plano(q.value);
      return !texto || texto.split(/\s+/).every((p) => (el.dataset.texto ?? '').includes(p));
    };

    let primera = true;
    const aplicar = () => {
      const visibles = new Set(fichas.filter((el) => cumple(el)));
      let i = 0;
      for (const el of fichas) {
        const ver = visibles.has(el);
        if (ver && el.hidden && !primera) {
          el.style.setProperty('--i', String(Math.min(i, 8)));
          el.classList.remove('entra');
          void el.offsetWidth;
          el.classList.add('entra');
        }
        if (ver) i++;
        el.hidden = !ver;
      }
      for (const ti of titulos) {
        ti.hidden = !fichas.some((el) => visibles.has(el) && el.dataset.cat === ti.dataset.cat);
      }
      for (const b of cats) {
        const c = b.dataset.c ?? '';
        const n = fichas.filter((el) => cumple(el, c)).length;
        b.setAttribute('aria-pressed', String(c === cat));
        b.disabled = c !== cat && n === 0;
        b.querySelector('.n')!.textContent = String(n);
      }
      for (const b of temps) b.setAttribute('aria-pressed', String(elegidas.has(b.dataset.v!)));
      const hay = !!cat || elegidas.size > 0 || !!q.value.trim();
      for (const b of borrar) if (!b.closest('.vacio')) b.hidden = !hay;
      totalEl.textContent = total(visibles.size);
      vacio.hidden = visibles.size > 0;
      // La búsqueda queda en la dirección para poder compartirla
      const url = new URL(location.href);
      const poner = (k: string, v: string) => (v ? url.searchParams.set(k, v) : url.searchParams.delete(k));
      poner('c', cat);
      poner('t', [...elegidas].join(','));
      poner('q', q.value.trim());
      history.replaceState(null, '', url);
      primera = false;
    };

    // Estado inicial desde la dirección; si se llega a una ficha concreta (lupa, Tecnología), se ve todo
    const url = new URL(location.href);
    const aFicha = location.hash && document.getElementById(location.hash.slice(1))?.classList.contains('ficha');
    if (!aFicha) {
      cat = url.searchParams.get('c') ?? '';
      for (const v of url.searchParams.get('t')?.split(',') ?? []) if (v) elegidas.add(v);
      q.value = url.searchParams.get('q') ?? '';
    }

    // Al cambiar de aplicación, el catálogo sube bajo la barra para verlo desde arriba
    const subir = () => {
      const y = rejilla.getBoundingClientRect().top + window.scrollY - form.offsetHeight - 100;
      if (window.scrollY > y) window.scrollTo({ top: y, behavior: 'smooth' });
    };
    for (const b of cats) {
      b.addEventListener('click', () => {
        cat = b.dataset.c ?? '';
        aplicar();
        subir();
      });
    }
    for (const b of temps) {
      b.addEventListener('click', () => {
        const v = b.dataset.v!;
        if (elegidas.has(v)) elegidas.delete(v);
        else elegidas.add(v);
        aplicar();
      });
    }
    let espera = 0;
    q.addEventListener('input', () => {
      clearTimeout(espera);
      espera = window.setTimeout(aplicar, 120);
    });
    form.addEventListener('submit', (e) => e.preventDefault());
    for (const b of borrar) {
      b.addEventListener('click', () => {
        cat = '';
        elegidas.clear();
        q.value = '';
        aplicar();
      });
    }
    aplicar();
  }
</script>

<style>
  /* Lo que el filtro oculta, oculto aunque tenga su propio display */
  [hidden] {
    display: none !important;
  }

  /* ——— Hero: foto a todo el ancho, oscurecida a la izquierda para el texto ——— */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #111315;
    color: #fff;
  }
  .hero-foto {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(10, 11, 12, 0.9) 0%, rgba(10, 11, 12, 0.72) 40%, rgba(10, 11, 12, 0.1) 75%),
      linear-gradient(0deg, rgba(10, 11, 12, 0.55) 0%, rgba(10, 11, 12, 0) 40%);
  }
  .hero-in {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(68vh, 640px);
    padding-block: clamp(64px, 9vw, 120px) clamp(36px, 4.5vw, 56px);
  }
  h1 {
    font-size: var(--t-titulo);
    font-weight: 300;
    line-height: 0.94;
    letter-spacing: -0.015em;
  }
  /* "productos" en el rojo de la marca, como "ción" en la portada */
  h1 b {
    display: block;
    font-weight: 700;
    color: var(--red);
  }
  .lead {
    margin-top: 20px;
    max-width: 44ch;
    font-size: var(--t-sub);
    color: rgba(255, 255, 255, 0.86);
  }
  /* Badges de cristal, como los botones de la portada: cifra grande y qué es */
  .badges {
    margin: clamp(28px, 4vw, 40px) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .badges li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 10px 20px 10px 18px;
    border: 1px solid rgba(255, 255, 255, 0.26);
    background: rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .badges li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 24px;
    height: 3px;
    background: var(--red);
  }
  .badges b {
    font-size: 34px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .badges span {
    max-width: 11ch;
    font-size: 15px;
    line-height: 1.15;
    color: rgba(255, 255, 255, 0.86);
  }
  /* "Siempre en stock": punto rojo que late */
  .stock i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 0 rgba(221, 4, 10, 0.7);
  }
  .stock span {
    max-width: none;
    font-weight: 700;
    color: #fff;
  }

  /* ——— Filtros sencillos: barra blanca fija ——— */
  .filtros {
    position: sticky;
    top: 0;
    z-index: 15;
    background: rgba(255, 255, 255, 0.9);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 12px 30px -26px rgba(17, 19, 21, 0.5);
    transition: top 0.35s var(--ease);
  }
  /* Con la cabecera de la web a la vista, la barra va justo debajo */
  :global(html:has(#top:not(.oculta))) .filtros {
    top: 76px;
  }
  .filtros-in {
    display: grid;
    gap: 12px;
    padding-block: 16px 14px;
  }
  .arriba {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .buscar {
    flex: 1 1 280px;
    max-width: 420px;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 14px;
    background: var(--panel);
    border: 1px solid transparent;
    color: var(--muted);
    transition:
      border-color 0.2s var(--ease),
      background 0.2s var(--ease);
  }
  .buscar:focus-within {
    background: #fff;
    border-color: var(--ink);
  }
  .buscar input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    font: 400 17px var(--f);
    color: var(--ink);
  }
  /* Temperatura: tres botones pegados, como un interruptor */
  .temps {
    display: flex;
    border: 1px solid var(--line);
  }
  .temp {
    height: 42px;
    padding: 0 14px;
    border: 0;
    border-left: 1px solid var(--line);
    background: #fff;
    font: 400 15px var(--f);
    color: var(--ink);
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .temp:first-child {
    border-left: 0;
  }
  .temp[aria-pressed='true'] {
    background: var(--ink);
    color: #fff;
    font-weight: 700;
  }
  .total {
    margin: 0 0 0 auto;
    font-size: 16px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .borrar {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 42px;
    padding: 0 14px;
    border: 1px solid var(--red);
    background: var(--red);
    font: 700 15px var(--f);
    color: #fff;
    cursor: pointer;
    animation: aparece 0.25s var(--ease);
  }
  /* Aplicaciones: texto con su número; la elegida, en rojo */
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cat {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid transparent;
    background: var(--panel);
    font: 400 15px var(--f);
    color: var(--ink);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .n {
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .cat[aria-pressed='true'] {
    background: var(--red);
    color: #fff;
    font-weight: 700;
  }
  .cat[aria-pressed='true'] .n {
    color: rgba(255, 255, 255, 0.8);
  }
  .cat:disabled {
