    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.4);
    font-size: 17px;
    color: rgba(255, 255, 255, 0.92);
  }
  .sala-usos li::before {
    content: '»';
    margin-right: 7px;
    font-weight: 300;
  }

  /* Al llegar a cada familia: el color sube desde abajo y el nombre y sus datos aparecen detrás */
  .revela .sala-cab:not(.visto) {
    clip-path: inset(100% 0 0 0);
  }
  .revela .sala-cab:not(.visto) > * {
    opacity: 0;
    translate: 0 16px;
  }
  .revela .sala-cab:not(.visto) > .sala-i {
    translate: 0 -40%;
  }
  .revela .sala-cab.visto {
    transition: clip-path 0.8s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .revela .sala-cab.visto > * {
    transition:
      opacity 0.5s ease 0.35s,
      translate 0.7s cubic-bezier(0.23, 1, 0.32, 1) 0.35s;
  }
  .revela .sala-cab.visto > .sala-n,
  .revela .sala-cab.visto > .sala-usos {
    transition-delay: 0.5s;
  }
  .sala {
    scroll-margin-top: 140px;
  }

  .piezas {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 28px);
  }
  /* Cada máquina deja sitio a la barra al llegar con un enlace a ella. Mide su ancho para colocar el selector de
     versión justo al pie de la foto (que es 5:4) */
  .ficha {
    container-type: inline-size;
    position: relative;
    scroll-margin-top: 200px;
  }

  /* "Comparar": arriba a la derecha del escenario; marcado, en rojo */
  .comparar {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 10px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--ink);
    background: #fff;
    cursor: pointer;
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }
  .comparar input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .caja {
    position: relative;
    width: 14px;
    height: 14px;
    border: 1.5px solid currentColor;
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease;
  }
  .caja::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.5px;
    width: 4px;
    height: 8px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    rotate: 45deg;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.16s ease,
      scale 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .comparar:has(input:checked) {
    color: #fff;
    background: var(--ink);
  }
  .comparar input:checked + .caja {
    background: var(--red);
    border-color: var(--red);
  }
  .comparar input:checked + .caja::after {
    opacity: 1;
    scale: 1;
  }
  .comparar input:focus-visible + .caja {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  .comparar:has(input:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }
  @media (hover: hover) and (pointer: fine) {
    .comparar:hover:not(:has(input:disabled)) {
      color: var(--ink);
    }
  }

  /* Sin resultados: el mensaje claro y el botón para empezar de nuevo */
  .vacio {
    padding: clamp(72px, 10vw, 140px) 0;
    text-align: center;
  }
  .vacio p {
    margin: 0 0 28px;
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 300;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Entrada al bajar */
  .revela .ficha:not(.visto) {
    opacity: 0;
    transform: translateY(28px);
  }
  .revela .ficha.visto {
    transition:
      opacity 0.6s var(--ease) var(--d, 0ms),
      transform 0.7s cubic-bezier(0.23, 1, 0.32, 1) var(--d, 0ms);
  }
  /* Dentro de cada tarjeta, la máquina sube y se asienta sobre su sombra un poco después */
  .revela .ficha:not(.visto) :global(.estudio img) {
    opacity: 0;
    translate: -50% 24px;
  }
  .revela .ficha:not(.visto) :global(.estudio::after) {
    scale: 0.5;
    opacity: 0;
  }
  .revela .ficha.visto :global(.estudio img) {
    transition:
      opacity 0.6s ease calc(var(--d, 0ms) + 0.15s),
      translate 0.9s cubic-bezier(0.23, 1, 0.32, 1) calc(var(--d, 0ms) + 0.15s),
      transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .revela .ficha.visto :global(.estudio::after) {
    transition:
      opacity 0.7s ease calc(var(--d, 0ms) + 0.3s),
      scale 0.9s cubic-bezier(0.23, 1, 0.32, 1) calc(var(--d, 0ms) + 0.3s);
  }

  /* Pantalla grande: el catálogo se ensancha y pasa a cuatro columnas (tarjetas de unos 345 px, casi como con tres a
     1280 px), así quedan menos tarjetas sueltas al final de cada familia */
  @media (min-width: 1600px) {
    .catalogo {
      --wrap: 1560px;
    }
    .piezas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 1439px) {
    :global(html:has(#top:not(.oculta))) .catalogo {
      --arriba: 88px;
    }
  }
  @media (max-width: 1180px) {
    .piezas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    :global(html:has(#top:not(.oculta))) .catalogo {
      --arriba: 60px;
    }
  }

  /* ——— Móvil ——— */
  @media (max-width: 640px) {
    .piezas {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    /* En móvil la portada es más baja, para ver antes el primer producto */
    .sala-cab {
      grid-template-columns: 1fr;
      grid-template-areas:
        'nombre'
        'n'
        'usos';
      gap: 6px;
      min-height: 0;
      padding: 22px 20px 20px;
    }
    .sala-usos {
      font-size: 15px;
      gap: 4px 16px;
    }
    .sala-i {
      top: 14px;
      right: 16px;
      font-size: 72px;
      translate: none;
    }
    .sala-cab h2 {
      font-size: 36px;
    }
    .sala-n {
      padding: 0;
      font-size: 16px;
    }
  }
  /* ——— Atajos a las familias: una fila de pastillas con el color de cada una ——— */
  .atajos-fila {
    display: flex;
    align-items: flex-start;
    gap: 8px 24px;
    margin-top: 20px;
  }
  .atajos {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: 8px;
  }
  .atajos-fila .descargar button {
    height: 40px;
  }
  @media (max-width: 900px) {
    .atajos-fila {
      flex-direction: column;
    }
  }
  .atajos a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 12px 0 14px;
    border: 1px solid #c4c8cc;
    border-left: 4px solid var(--fam);
    background: #fff;
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .atajos .n {
    min-width: 22px;
    padding: 2px 6px;
    background: #f0f1f2;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .atajos a:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .atajos a:hover {
      border-color: var(--ink);
      border-left-color: var(--fam);
      background: #f7f7f7;
    }
  }

  /* ——— Selector de versión: pestañas que salen de la raya de color de la foto. La elegida es del color de la raya
     y parece formar parte de ella; las otras, oscuras y apagadas. Sin etiqueta "Versión" delante: con ella parecía
     un botón más ——— */
  .versiones {
    --fam-vivo: oklch(from var(--fam) calc(l + 0.06) calc(c * 2) h);
    position: absolute;
    left: 16px;
    top: calc(80cqw - 38px);
    z-index: 3;
    display: flex;
    align-items: flex-end;
    gap: 2px;
  }
  .versiones button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px;
    border: 0;
    background: rgba(17, 19, 21, 0.62);
    font: 700 13px var(--f);
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      height 0.2s var(--sube, ease);
  }
  .versiones button[aria-pressed='true'] {
    height: 32px;
    background: var(--fam-vivo);
    color: var(--ink);
    cursor: default;
  }
  .versiones button :global(svg) {
    flex: none;
  }
  .versiones button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 1px;
  }
  @media (hover: hover) and (pointer: fine) {
    .versiones button:not([aria-pressed='true']):hover {
      background: rgba(17, 19, 21, 0.85);
      color: #fff;
    }
  }

  /* ——— Presupuesto en cada tarjeta: abajo a la izquierda, junto a "Ver producto". Sin añadir, "+ Presupuesto";
     añadida, un contador "− 1 ud. +" gris y tranquilo (lo pone src/scripts/presupuesto.ts): con 1, el "−" es una
     papelera que la quita ——— */
  .anadir,
  .ficha :global(.paso) {
    position: absolute;
    left: 2px;
    bottom: 2px;
    width: calc(50% - 2px);
    z-index: 2;
    height: 56px;
  }
  .anadir {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px 0 20px;
    border: 0;
    border-right: 1px solid #b4b9bd;
    background: #fff;
    font: 700 16px var(--f);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .anadir svg {
    color: var(--red);
  }
  .ficha :global(.paso) {
    display: flex;
    background: #f3f4f5;
    border-right: 1px solid #b4b9bd;
    animation: aparece-paso 0.25s var(--ease);
  }
  .ficha :global(.paso[hidden]) {
    display: none;
  }
  .ficha :global(.paso button) {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    border: 0;
    background: none;
    color: var(--red);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .ficha :global(.paso button:first-child) {
    border-right: 1px solid #d3d6d9;
  }
  .ficha :global(.paso button:last-child) {
    border-left: 1px solid #d3d6d9;
  }
  .ficha :global(.paso button.borrar) {
    color: var(--muted);
  }
  .ficha :global(.paso output) {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font: 400 16px var(--f);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ficha :global(.paso output b) {
    font-size: 20px;
    font-weight: 700;
  }
  .anadir:focus-visible,
  .ficha :global(.paso button:focus-visible) {
    outline: 2px solid var(--red);
    outline-offset: -2px;
  }
  .anadir:active,
  .ficha :global(.paso button:active) {
    scale: 0.97;
  }
  @keyframes aparece-paso {
    from {
      opacity: 0;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .anadir:hover {
      background: #f3f4f5;
    }
    .ficha :global(.paso button:hover) {
      background: #e9ebed;
    }
    .ficha :global(.paso button.borrar:hover),
    .pres-lista :global(button.borrar:hover) {
      color: var(--red);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ficha :global(.paso) {
      animation: none;
    }
  }

  /* ——— Equipo a medida: una sola vez, al final del catálogo, sobre la mesa de laboratorio en oscuro ——— */
  .oem {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    margin-top: clamp(80px, 9vw, 140px);
    padding: clamp(32px, 4vw, 56px);
    background:
      linear-gradient(rgba(24, 26, 29, 0.82), rgba(24, 26, 29, 0.82)),
      #2b2e31 url(/img/fondos/mesa-laboratorio.webp) center / cover no-repeat;
    border-top: 3px solid var(--red);
    color: #fff;
  }
  .oem-tit {
    margin: 0;
    font-size: clamp(28px, 2.8vw, 40px);
    font-weight: 300;
    line-height: 1.1;
  }
  .oem-tit b {
    font-weight: 700;
  }
  .oem-txt {
    max-width: 52ch;
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.45;
    color: #d0d4d8;
  }
  .oem .btn {
    flex: none;
  }
  @media (max-width: 760px) {
    .oem {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ——— Presupuesto: botón fijo abajo a la derecha y su lista ——— */
  .presupuesto {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 31;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    transition: bottom 0.35s var(--ease);
    /* La caja ocupa el sitio del panel aunque esté cerrado: que no tape lo de debajo, solo sus piezas reciben el clic */
    pointer-events: none;
  }
  .presupuesto > * {
    pointer-events: auto;
  }
  .presupuesto :global(.pres-aviso) {
    pointer-events: none;
  }
  /* Con el panel de filtros abierto (móvil), el presupuesto se aparta para no tapar "Ver productos" */
  :global(html:has(#filtros.abierto)) .presupuesto {
    display: none;
  }
  /* Con la barra del comparador abajo, el presupuesto sube para no taparla */
  :global(body:has(#barra-comparar:not([hidden]))) .presupuesto {
    bottom: 96px;
  }
  .pres-abrir {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 20px 0 16px;
    background: var(--red);
    color: #fff;
    font: 700 17px var(--f);
    box-shadow: 0 18px 40px -16px rgba(17, 19, 21, 0.55);
    animation: sube-barra 0.45s var(--ease);
  }
  .pres-panel {
    width: min(360px, calc(100vw - 40px));
    max-height: min(70vh, 560px);
    overflow-y: auto;
    padding: 0 16px 16px;
    background: #fff;
    border: 1px solid #c4c8cc;
    border-top: 3px solid var(--red);
    box-shadow: 0 30px 60px -24px rgba(17, 19, 21, 0.5);
    opacity: 0;
    translate: 0 8px;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      translate 0.3s cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s 0.3s;
  }
  .presupuesto:has(.pres-abrir[aria-expanded='true']) .pres-panel {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
    transition:
      opacity 0.2s ease,
      translate 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .pres-cab {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0 10px;
    background: #fff;
    border-bottom: 1px solid #e3e5e7;
  }
  .pres-cab p {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
  }
  .pres-cerrar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-right: -8px;
  }
  .pres-lista {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pres-lista :global(li) {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid #eceef0;
  }
  .pres-lista :global(img) {
    width: 44px;
    height: 44px;
    object-fit: contain;
    background: #f1f2f3;
  }
  .pres-lista :global(span) {
    font-size: 17px;
    font-weight: 700;
  }
  /* Unidades: − n + */
  .pres-lista :global(.pres-cant) {
    display: flex;
    align-items: center;
    border: 1px solid #c4c8cc;
  }
  .pres-lista :global(.pres-cant button) {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    color: var(--red);
  }
  .pres-lista :global(.pres-cant button svg) {
    width: 16px;
    height: 16px;
  }
  .pres-lista :global(.pres-cant button.borrar) {
    color: var(--muted);
  }
  /* Aviso al añadir: aparece encima del botón de abajo y se va solo */
  .presupuesto :global(.pres-aviso) {
    position: absolute;
    right: 0;
    bottom: calc(100% + 10px);
    margin: 0;
    padding: 10px 14px;
    background: var(--ink);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 14px 30px -14px rgba(17, 19, 21, 0.5);
    opacity: 0;
    translate: 0 6px;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      translate 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .presupuesto :global(.pres-aviso.visto) {
    opacity: 1;
    translate: 0 0;
  }
  .pres-lista :global(.pres-cant output) {
    min-width: 26px;
    font-size: 16px;
    font-weight: 700;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .pres-lista :global(button) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--muted);
  }
  .pres-pedir {
    display: block;
    margin-top: 14px;
    padding: 14px 16px;
    background: var(--red);
    color: #fff;
    font-size: 17px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }
  .pres-pedir::after {
    content: ' »';
    font-weight: 300;
  }
  .pres-nota {
    margin: 8px 0 0;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
  }
  /* En el panel, la descarga va centrada bajo la nota, más pequeña que "Pedir presupuesto" */
  .pres-panel .descargar {
    display: flex;
    justify-content: center;
    margin-top: 14px;
  }
  .pres-panel .descargar button {
    height: 38px;
  }
  .pres-vaciar {
    display: block;
    margin: 8px auto 0;
    padding: 6px 10px;
    font-size: 15px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .presupuesto button:focus-visible,
  .pres-pedir:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .pres-abrir:hover,
    .pres-pedir:hover {
      background: var(--red-d);
    }
    .pres-lista :global(button:hover),
    .pres-cerrar:hover,
    .pres-vaciar:hover {
      color: var(--red);
    }
  }
  @media (max-width: 900px) {
    .presupuesto {
      right: 12px;
      bottom: 12px;
    }
    :global(body:has(#barra-comparar:not([hidden]))) .presupuesto {
      bottom: 88px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pres-panel,
    .presupuesto:has(.pres-abrir[aria-expanded='true']) .pres-panel {
      transition: visibility 0s;
    }
    .pres-abrir {
      animation: none;
    }
  }

  /* Los botones que se pintan desde JS no llevan el ámbito del componente */
  :global(:where(.barra-comparar, .comparador, .presupuesto) button) {
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  /* ——— Comparador ——— */
  .barra-comparar {
    position: fixed;
    left: 50%;
    bottom: 20px;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 20px;
    width: max-content;
    max-width: calc(100% - 2 * var(--gut));
    padding: 10px 10px 10px 16px;
    background: rgba(21, 23, 25, 0.96);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #fff;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.55);
    translate: -50% 0;
    animation: sube-barra 0.45s var(--ease);
  }
  .barra-comparar::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
