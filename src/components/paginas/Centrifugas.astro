  /* ——— Portada de cada familia: banda a todo lo ancho sobre el rotor con tubos, en gris oscuro igual para todas, y
     el color de la familia solo en la raya de arriba; sus textos a la izquierda y su número enorme a la derecha ——— */
  .sala-cab {
    --tinte: #1b1d20;
    position: relative;
    display: grid;
