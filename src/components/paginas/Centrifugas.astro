---
// Catálogo de productos: el hero con la Digicen 22 en 3D (HeroProductos.astro), y debajo la misma exposición con la
// luz encendida: blanco, cada máquina grande sobre su elipse roja, agrupadas por familia con un título grande. Arriba,
// una barra fina y fija para buscar y filtrar (en móvil, los filtros suben en un panel desde abajo), y en cada
// máquina "Comparar" para verlas lado a lado. Los filtros se guardan en la dirección para poder compartir una búsqueda.
import Base from '../../layouts/Base.astro';
import Maquina from '../Maquina.astro';
import Paso from '../Paso.astro';
import Filtros from '../Filtros.astro';
import IconoTemp from '../ui/IconoTemp.astro';
import HeroProductos from '../HeroProductos.astro';
import {
  categorias,
  familias,
  modelos,
  productos,
  totalModelos,
  type Categoria,
  type Familia,
  type Modelo,
} from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import { cifra, fichaCentrifuga, medida, rotor, tipoRotor, tipoTubo } from '../../data/fichas';
import { contacto } from '../../data/navegacion';
import { idioma, numero, ruta, textoSerie, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const f = t.catalogo.filtros;

const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// Texto para el buscador: sin tildes ni mayúsculas, como la lupa de la cabecera
const plano = (...partes: (string | undefined)[]) =>
  partes.filter(Boolean).join(' ').normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();

type Otro = 'accesorios' | 'laboratorio';
type Cat = Categoria | Otro;
// Aplicaciones del filtro, como en la web actual: generales, especiales y otros productos
const grupos: { nombre: string; cats: Cat[] }[] = [
  { nombre: t.catalogo.grupos.generales, cats: [...categorias.generales] },
  { nombre: t.catalogo.grupos.especiales, cats: [...categorias.especiales] },
  { nombre: t.catalogo.grupos.otros, cats: ['accesorios', 'laboratorio'] },
];
const nombreCat = (c: Cat) =>
  c === 'accesorios'
    ? t.laboratorio.accesorios
    : c === 'laboratorio'
      ? t.laboratorio.equipos
      : t.catalogo.categorias[c];
const nombreCorto = (c: Cat) => (c === 'accesorios' || c === 'laboratorio' ? f.cortos[c] : nombreCat(c));

// La exposición, por familias (Compactas, Universales…) y al final accesorios y otros productos de laboratorio
// Una ficha por serie: sus versiones (22 y 22 R; C, C-U y C-8) van juntas en la misma tarjeta, con un selector
type Ficha = { tipo: 'modelo'; cat: Cat; m: Modelo; ms: Modelo[] } | { tipo: 'lab'; cat: Cat; p: ProductoLab };
const porSerie = (ms: Modelo[]): Ficha[] =>
  [...new Set(ms.map((m) => m.serie))].map((serie) => {
    const vs = ms.filter((m) => m.serie === serie);
    return { tipo: 'modelo', cat: vs[0].categoria, m: vs[0], ms: vs };
  });
const familiaDe = (m: Modelo) => productos.find((p) => p.slug === m.serie)!.familia;
const lab = (c: Otro, items: ProductoLab[]): Ficha[] => items.map((p) => ({ tipo: 'lab', cat: c, p }));
const salas: { id: string; nombre: string; color: string; fichas: Ficha[] }[] = [
  ...(Object.keys(familias) as Familia[]).map((fam) => ({
    id: fam,
    nombre: t.familias[fam],
    color: familias[fam].color as string,
    fichas: porSerie(modelos.filter((m) => familiaDe(m) === fam)),
  })),
  { id: 'accesorios', nombre: t.laboratorio.accesorios, color: '#8c959b', fichas: lab('accesorios', accesorios) },
  { id: 'laboratorio', nombre: t.laboratorio.equipos, color: '#8c959b', fichas: lab('laboratorio', equipos) },
].filter((s) => s.fichas.length);
const capacidad = (m: Modelo) =>
  m.capacidad === productos.find((p) => p.slug === m.serie)?.capacidad
    ? (textoSerie(lang, m.serie).capacidad ?? m.capacidad)
    : m.capacidad;
// Fuerza máxima: la del modelo o, si no la tiene, la de su ficha de la web
const fuerza = (m: Modelo) => {
  const xg = m.xg ?? fichaCentrifuga(m.slug)?.xg;
  return xg ? (m.xg ? numero(lang, m.xg) : cifra(lang, xg)) : undefined;
};
// Para ordenar: capacidad total en ml (si se puede leer de "n × v ml"), velocidad y fuerza como números
const num = (s?: string) => (s ? Number(s.replace(/\D/g, '')) || 0 : 0);
const capacidadMl = (m: Modelo) => {
  const c = /(\d+)\s*×\s*([\d.,]+)\s*ml/.exec(m.capacidad);
  return c ? Number(c[1]) * Number(c[2].replace(',', '.')) : 0;
};
// Nombre de cada versión en el selector: la temperatura si las distingue; si no, lo que añade al nombre de la serie
const etiquetas = (vs: Modelo[]) => {
  const temps = vs.map((v) => v.temperatura);
  if (new Set(temps).size === vs.length) return temps.map((x) => may(t.temperatura[x]));
  return vs.map((v) => v.nombre.split(' ').slice(1).join(' '));
};

// Comparador: los datos que el distribuidor mira para elegir, de la tabla de la serie y de la ficha de cada modelo
const tc = t.catalogo.comparar;
const tf = t.catalogo.ficha;
const aNumero = (s?: string) => (s ? Number(s.replace(/\D/g, '')) : undefined);
const comparables = Object.fromEntries(
  modelos.map((m) => {
    const web = fichaCentrifuga(m.slug);
    const v0 = web?.versiones[0];
    const xg = m.xg ?? web?.xg;
    return [
      m.slug,
      {
        nombre: m.nombre,
        img: m.imagen.src,
        href: ruta(lang, `/centrifugas/${m.slug}/`),
        filas: {
          aplicacion: t.catalogo.categorias[m.categoria],
          temperatura: may(t.temperatura[m.temperatura]),
          capacidad: capacidad(m),
          velocidad: `${numero(lang, m.rpm)} rpm`,
          fuerza: xg ? `${m.xg ? numero(lang, m.xg) : cifra(lang, xg)} xg` : undefined,
          pantalla: m.pantalla,
          medidas: v0?.medidas ? `${v0.medidas.replace(/x/g, ' × ')} mm` : undefined,
          peso: v0?.peso ? `${v0.peso} kg` : undefined,
          consumo: v0?.consumo ? `${v0.consumo} W` : undefined,
          rotores: web?.rotores.length ? String(web.rotores.length) : undefined,
        },
        // Para marcar el mayor de cada fila numérica
        num: { velocidad: aNumero(m.rpm), fuerza: aNumero(xg), rotores: web?.rotores.length },
      },
    ];
  }),
);
const filasComparar = [
  { k: 'aplicacion', nombre: tc.aplicacion },
  { k: 'temperatura', nombre: tc.temperatura },
  { k: 'capacidad', nombre: tf.capacidad },
  { k: 'velocidad', nombre: tf.velocidad },
  { k: 'fuerza', nombre: tf.fuerza },
  { k: 'pantalla', nombre: tf.pantalla },
  { k: 'medidas', nombre: tf.versiones.medidas },
  { k: 'peso', nombre: tf.versiones.peso },
  { k: 'consumo', nombre: tf.versiones.consumo },
  { k: 'rotores', nombre: tc.rotores },
];
const cruz = 'M6 6l12 12M18 6 6 18';

// Vista en tabla: los modelos en el orden del catálogo (por familias) y las columnas por las que se puede ordenar
const tv = f.vista;
const filasTabla = (Object.keys(familias) as Familia[]).flatMap((fam) =>
  modelos.filter((m) => familiaDe(m) === fam).map((m) => ({ m, color: familias[fam].color as string })),
);
const columnasOrden = [
  { o: 'cap', nombre: tf.capacidad, ud: undefined },
  { o: 'rpm', nombre: tf.velocidad, ud: 'rpm' },
  { o: 'xg', nombre: tf.fuerza, ud: 'xg' },
];
// Barra bajo cada cifra: su tamaño frente a la mayor de la columna (sin barra si no hay cifra)
const maximos: Record<string, number> = {
  cap: Math.max(...filasTabla.map(({ m }) => capacidadMl(m))),
  rpm: Math.max(...filasTabla.map(({ m }) => num(m.rpm))),
  xg: Math.max(...filasTabla.map(({ m }) => num(m.xg ?? fichaCentrifuga(m.slug)?.xg))),
};
const barra = (v: number, k: string) => (v ? `--p: ${(v / maximos[k]).toFixed(3)}` : undefined);

// Lista de presupuesto: todo lo del catálogo, con su nombre y su foto
const tp = t.catalogo.presupuesto;
const presupuestables = Object.fromEntries(
  salas.flatMap((s) =>
    s.fichas.flatMap((x) =>
      x.tipo === 'modelo'
        ? x.ms.map((v) => [v.slug, { nombre: v.nombre, img: v.imagen.src }] as const)
        : [[x.p.slug, { nombre: t.laboratorio.items[x.p.slug].nombre, img: x.p.imagen.src }] as const],
    ),
  ),
);
const td = t.distribuidores;

// ——— Tubos: qué tubos admite cada versión (por sus rotores de la web actual), con el rotor donde caben más y cuántos
// a la vez. La clave de un tubo es "tipo|medidas", como viene de la web actual ———
type ConTubo = [rotor: string, tipo: string, n: number];
const tubosDe = (slug: string) => {
  const r: Record<string, ConTubo> = {};
  for (const id of fichaCentrifuga(slug)?.rotores ?? []) {
    const ro = rotor(id);
    if (!ro) continue;
    for (const tu of ro.tubos) {
      const k = `${tu.tipo}|${tu.medidas}`;
      const n = Number(tu.posiciones) || 0;
      if (!r[k] || n > r[k][2]) r[k] = [ro.nombre, tipoRotor(lang, ro.tipo).toLowerCase(), n];
    }
  }
  return r;
};
const tubosModelo = Object.fromEntries(modelos.map((m) => [m.slug, tubosDe(m.slug)]));

// ——— Mínimos: velocidad y fuerza máximas de cada versión, y cuántos tubos de cuántos ml caben a la vez en alguno de
// sus rotores (más la capacidad de la tabla de la serie). Solo se guardan las combinaciones que no mejora otra ———
const mlMax = (s?: string) => {
  const hasta = s?.slice(0, s.lastIndexOf('ml')) ?? '';
  const ns = hasta.match(/\d[\d.,]*/g)?.map((x) => Number(x.replace(/\.(?=\d{3})/g, '').replace(',', '.'))) ?? [];
  return ns.length ? Math.max(...ns) : 0;
};
const capacidadesDe = (m: Modelo) => {
  const pares: [number, number][] = [];
  const serie = /(\d+)\s*×\s*([\d.,/]+)\s*ml/.exec(m.capacidad);
  if (serie) pares.push([Number(serie[1]), mlMax(`${serie[2].split('/').pop()} ml`)]);
  for (const id of fichaCentrifuga(m.slug)?.rotores ?? [])
    for (const tu of rotor(id)?.tubos ?? []) {
      const n = Number(tu.posiciones) || 0;
      const ml = mlMax(tu.capacidad);
      if (n && ml) pares.push([n, ml]);
    }
  const unicos = [...new Map(pares.map((p) => [p.join('x'), p])).values()];
  return unicos.filter(([n, ml]) => !unicos.some(([n2, ml2]) => n2 >= n && ml2 >= ml && (n2 > n || ml2 > ml)));
};
const cifrasModelo = Object.fromEntries(
  modelos.map((m) => [
    m.slug,
    { rpm: num(m.rpm), xg: num(m.xg ?? fichaCentrifuga(m.slug)?.xg), cap: capacidadesDe(m) },
  ]),
);
// Para el filtro: los tubos agrupados por tipo (los tipos con más máquinas primero) y ordenados por medidas
const cuenta: Record<string, number> = {};
for (const ts of Object.values(tubosModelo)) for (const k of Object.keys(ts)) cuenta[k] = (cuenta[k] ?? 0) + 1;
const porTipo: Record<string, string[]> = {};
for (const k of Object.keys(cuenta)) (porTipo[k.split('|')[0]] ??= []).push(k);
const grosor = (k: string) =>
  k
    .split('|')[1]
    .split('x')
    .map((x) => parseFloat(x.replace(',', '.')) || 0);
const tubos = Object.entries(porTipo)
  .sort((a, b) => b[1].reduce((n, k) => n + cuenta[k], 0) - a[1].reduce((n, k) => n + cuenta[k], 0))
  .map(([tipo, ks]) => ({
    nombre: may(tipoTubo(lang, tipo) ?? tipo),
    items: ks
      .sort((a, b) => grosor(a)[0] - grosor(b)[0] || grosor(a)[1] - grosor(b)[1])
      .map((k) => ({
        v: k,
        nombre:
          `${may(tipoTubo(lang, tipo) ?? tipo)} ${k.split('|')[1] !== 'undefined' ? medida(lang, k.split('|')[1]) : ''}`.trim(),
        // Si el tubo no trae medidas en los datos (bolsas de sangre), su botón lleva el nombre del tipo
        medidas:
          k.split('|')[1] && k.split('|')[1] !== 'undefined'
            ? (medida(lang, k.split('|')[1]) ?? '')
            : may(tipoTubo(lang, tipo) ?? tipo),
      })),
  }));
---

<Base title={t.catalogo.title} description={t.catalogo.description(productos.length, totalModelos)}>
  <HeroProductos />

  <section class="catalogo" id="catalogo" aria-label={f.todoTitulo}>
    <!-- Corte limpio con el hero: la raya roja se dibuja desde el centro, sin fundido -->
    <Paso desde="transparent" />

    <!-- Filtros: panel a la vista y, al bajar, barra fina fija con lo puesto -->
    <Filtros
      tubos={tubos}
      grupos={grupos.map((g) => ({ nombre: g.nombre, cats: g.cats.map((c) => ({ v: c, nombre: nombreCorto(c) })) }))}
    />

    <!-- Atajos: una entrada por familia, con su color, que lleva a su sección; a la derecha, descargar lo que se ve
         (los modelos que dejan los filtros, como en la tabla) -->
    <div class="wrap atajos-fila">
      <nav class="atajos" aria-label={t.catalogo.atajos}>
        {salas.map((s) => (
          <a href={`#sala-${s.id}`} data-ir={s.id} style={`--fam: ${s.color}`}>
            {s.nombre}
            <span class="n">{s.fichas.length}</span>
          </a>
        ))}
      </nav>
      <div class="descargar" role="group" aria-label={tv.descargar}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="1.7" />
        </svg>
        <span class="d-etq">{tv.descargar}</span>
        <button type="button" data-exportar="pdf" title={tv.descargarEn('PDF')}>
          PDF
        </button>
        <button type="button" data-exportar="excel" title={tv.descargarEn('Excel')}>
          Excel
        </button>
      </div>
    </div>

    <div class="wrap salas" id="salas">
      {/* Vista en tabla: todos los modelos, una fila por versión, ordenables por capacidad, velocidad o fuerza */}
      <section class="tabla-vista" aria-labelledby="tabla-tit">
        <h2 id="tabla-tit" class="sr">
          {tv.tablaTitulo}
        </h2>
        {/* Qué orden se ve: lo rellena el script de los filtros; "Invertir" da la vuelta al orden elegido */}
        <div class="tabla-estado">
          <p aria-live="polite" data-catalogo={tv.catalogo} data-mayor={tv.mayor} data-menor={tv.menor}></p>
          {/* Cuántas filas hay elegidas, con la × para quitar la elección */}
          <button
            type="button"
            class="eleccion"
            hidden
            data-uno={tv.elegidos(1)}
            data-varios={tv.elegidos(999)}
            title={tv.quitarEleccion}
          >
            <span></span>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path d={cruz} stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
          </button>
          <button type="button" class="invertir" hidden>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path
                d="M7 4v16M4 17l3 3 3-3M17 20V4M14 7l3-3 3 3"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
              />
            </svg>
            {tv.invertir}
          </button>
          {/* Descargar lo que se ve (filtros y orden incluidos) para mandárselo al cliente */}
          <div class="descargar" role="group" aria-label={tv.descargar}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="1.7" />
            </svg>
            <span class="d-etq">{tv.descargar}</span>
            <button type="button" data-exportar="pdf" title={tv.descargarEn('PDF')}>
              PDF
            </button>
            <button type="button" data-exportar="excel" title={tv.descargarEn('Excel')}>
              Excel
            </button>
          </div>
        </div>
        <div class="tabla-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col" data-cols={`${tv.modelo}|${tc.aplicacion}`}>
                  {/* Elegir todas las filas a la vista, para descargar solo las elegidas */}
                  <span class="mod">
                    <label class="elegir" title={tv.elegirTodos}>
                      <input type="checkbox" class="elegir-todas" aria-label={tv.elegirTodos} />
                      <span class="caja" aria-hidden="true" />
                    </label>
                    {tv.modelo}
                  </span>
                </th>
                <th scope="col">{tc.temperatura}</th>
                {columnasOrden.map((c) => (
                  <th scope="col" class="num" aria-sort="none" data-ud={c.ud}>
                    <button type="button" data-o={c.o} aria-label={tv.ordenarPor(c.nombre)}>
                      {c.nombre}
                      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                        <path class="ar" d="m7 10 5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" />
                        <path class="ab" d="m7 14 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" />
                      </svg>
                    </button>
                  </th>
                ))}
                <th scope="col" class="centro">
                  {tf.pantalla}
                </th>
                <th scope="col" class="centro fuera">
                  {tc.comparar}
                </th>
                <th scope="col" class="centro fuera">
                  {tp.corto}
                </th>
              </tr>
            </thead>
            <tbody>
              {filasTabla.map(({ m, color }) => (
                <tr
                  style={`--fam: ${color}`}
                  data-cat={m.categoria}
                  data-t={m.temperatura}
                  data-slugs={m.slug}
                  data-cap={capacidadMl(m)}
                  data-rpm={num(m.rpm)}
                  data-xg={num(m.xg ?? fichaCentrifuga(m.slug)?.xg)}
                  data-texto={plano(
                    m.nombre,
                    t.familias[familiaDe(m)],
                    t.catalogo.categorias[m.categoria],
                    textoSerie(lang, m.serie).frase,
                    capacidad(m),
                    m.pantalla,
                    t.temperatura[m.temperatura],
                  )}
                >
                  <th scope="row">
                    <span class="mod">
                      {/* Elegir la fila: si hay alguna elegida, la descarga lleva solo esas */}
                      <label class="elegir" title={tv.elegir}>
                        <input type="checkbox" value={m.slug} aria-label={`${tv.elegir}: ${m.nombre}`} />
                        <span class="caja" aria-hidden="true" />
                      </label>
                      <a href={ruta(lang, `/centrifugas/${m.slug}/`)}>
                        <img src={m.imagen.src} alt="" width="48" height="48" loading="lazy" decoding="async" />
                        {/* La aplicación, debajo del nombre: una columna menos y la fila se lee de un vistazo */}
                        <span class="nom">
                          <b data-x>{m.nombre}</b>
                          <small data-x>{t.catalogo.categorias[m.categoria]}</small>
                        </span>
                      </a>
                    </span>
                  </th>
                  <td class:list={['temp', m.temperatura]}>
                    <IconoTemp t={m.temperatura} size={16} />
                    {may(t.temperatura[m.temperatura])}
                  </td>
                  <td class="num c-cap" style={barra(capacidadMl(m), 'cap')}>
                    {capacidad(m)}
                  </td>
                  <td class="num c-rpm" style={barra(num(m.rpm), 'rpm')} data-n={num(m.rpm)}>
                    {numero(lang, m.rpm)} rpm
                  </td>
                  <td
                    class="num c-xg"
                    style={barra(num(m.xg ?? fichaCentrifuga(m.slug)?.xg), 'xg')}
                    data-n={num(m.xg ?? fichaCentrifuga(m.slug)?.xg) || undefined}
                  >
                    {fuerza(m) ? `${fuerza(m)} xg` : '—'}
                  </td>
                  <td class="centro">{m.pantalla}</td>
                  {/* Las mismas casilla y "+" que las tarjetas: los scripts las cogen todas y las tienen a la par */}
                  <td class="centro fuera">
                    <label class="comparar" title={tc.comparar}>
                      <input type="checkbox" value={m.slug} />
                      <span class="caja" aria-hidden="true" />
                      <span class="sr">
                        {tc.comparar} {m.nombre}
                      </span>
                    </label>
                  </td>
                  <td class="pres fuera">
                    <button type="button" class="anadir" data-slug={m.slug} title={tp.anadir}>
                      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                      </svg>
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {salas.map((s, i) => (
        <section class="sala" data-sala={s.id} aria-labelledby={`sala-${s.id}`} style={`--fam: ${s.color}`}>
          <header class="sala-cab">
            <span class="sala-i" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h2 id={`sala-${s.id}`}>{s.nombre}</h2>
            <p class="sala-n">{f.resultados(s.fichas.length)}</p>
            <ul class="sala-usos">
              {[...new Set(s.fichas.map((x) => nombreCorto(x.cat)))].map((u) => (
                <li>{u}</li>
              ))}
            </ul>
          </header>
          <ul class="piezas">
            {s.fichas.map((x) =>
              x.tipo === 'modelo' ? (
                <li
                  class="ficha"
                  data-sala={s.id}
                  id={x.m.principal ? x.m.serie : x.m.slug}
                  data-cat={x.cat}
                  data-t={[...new Set(x.ms.map((v) => v.temperatura))].join(' ')}
                  data-slugs={x.ms.map((v) => v.slug).join(' ')}
                  data-cap={capacidadMl(x.m)}
                  data-rpm={num(x.m.rpm)}
                  data-xg={num(x.m.xg ?? fichaCentrifuga(x.m.slug)?.xg)}
                  data-texto={plano(
                    ...x.ms.map((v) => v.nombre),
                    s.nombre,
                    nombreCat(x.cat),
                    textoSerie(lang, x.m.serie).frase,
                    capacidad(x.m),
                    x.m.pantalla,
                    ...x.ms.map((v) => t.temperatura[v.temperatura]),
                  )}
                >
                  <Maquina
                    versiones={x.ms.map((v) => ({ m: v, capacidad: capacidad(v), fuerza: fuerza(v) }))}
                    uso={nombreCat(x.cat)}
                    frase={textoSerie(lang, x.m.serie).frase}
                    color={s.color}
                  />
                  {x.ms.length > 1 && (
                    <div class="versiones" role="group" aria-label={tc.version}>
                      {etiquetas(x.ms).map((e, i) => (
                        <button
                          type="button"
                          data-i={i}
                          data-slug={x.ms[i].slug}
                          data-t={x.ms[i].temperatura}
                          data-href={ruta(lang, `/centrifugas/${x.ms[i].slug}/`)}
                          aria-pressed={i === 0 ? 'true' : 'false'}
                        >
                          <IconoTemp t={x.ms[i].temperatura} size={15} />
                          {e}
                        </button>
                      ))}
                    </div>
                  )}
                  <label class="comparar">
                    <input type="checkbox" value={x.m.slug} />
                    <span class="caja" aria-hidden="true" />
                    {tc.comparar}
                    <span class="sr">{x.m.nombre}</span>
                  </label>
                  <button type="button" class="anadir" data-slug={x.m.slug}>
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    {tp.corto}
                  </button>
                </li>
              ) : (
                <li
                  class="ficha"
                  data-sala={s.id}
                  id={x.p.slug}
                  data-cat={x.cat}
                  data-texto={plano(
                    t.laboratorio.items[x.p.slug].nombre,
                    x.p.modelo,
                    nombreCat(x.cat),
                    t.laboratorio.items[x.p.slug].frase,
                    t.laboratorio.items[x.p.slug].datos,
                  )}
                >
                  <Maquina
                    lab={x.p}
                    uso={nombreCat(x.cat)}
                    frase={t.laboratorio.items[x.p.slug].frase}
                    color={s.color}
                  />
                  <button type="button" class="anadir" data-slug={x.p.slug}>
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    {tp.corto}
                  </button>
                </li>
              ),
            )}
          </ul>
        </section>
      ))}

      {/* Al final del catálogo, una sola vez: equipo a medida */}
      <aside class="oem">
        <div>
          <p class="oem-tit">
            {td.oemTitulo[0]}
            <b>{td.oemTitulo[1]}</b>
            {td.oemTitulo[2]}
          </p>
          <p class="oem-txt">{td.oem}</p>
        </div>
        <a class="btn red" href={ruta(lang, contacto.href)}>
          {t.cabecera.contacto}
        </a>
      </aside>

      <div class="vacio" hidden>
        <p>{f.vacio}</p>
        <button type="button" class="btn red limpiar">
          {f.limpiar}
        </button>
      </div>
    </div>
  </section>

  <!-- Comparador: barra abajo con las elegidas y, al abrirla, las máquinas lado a lado -->
  <div class="barra-comparar" id="barra-comparar" role="region" aria-label={tc.titulo} hidden>
    <ul class="elegidas"></ul>
    <p class="pista-otra">{tc.otra}</p>
    <div class="barra-acciones">
      <button type="button" class="vaciar">
        {tc.vaciar}
      </button>
      <button type="button" class="abrir-comparar" data-txt={tc.abrir(999)}></button>
    </div>
  </div>

  <!-- Presupuesto: botón fijo abajo a la derecha y, al abrirlo, la lista para pedirla por correo -->
  <div class="presupuesto" id="presupuesto" hidden>
    <div class="pres-panel" id="pres-panel" role="dialog" aria-labelledby="pres-tit">
      <div class="pres-cab">
        <p id="pres-tit">{tp.titulo}</p>
        <button type="button" class="pres-cerrar" aria-label={tp.cerrar}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d={cruz} stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <ul class="pres-lista"></ul>
      <a class="pres-pedir" href={`mailto:${contacto.comercial}`}>
        {tp.pedir}
      </a>
      <p class="pres-nota">{tp.nota}</p>
      {/* La lista, con sus unidades, en PDF o Excel: para el cliente o para adjuntarla al pedir presupuesto */}
      <div class="descargar" role="group" aria-label={tv.descargar}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="1.7" />
        </svg>
        <span class="d-etq">{tv.descargar}</span>
        <button type="button" data-exportar="pdf" title={tv.descargarEn('PDF')}>
          PDF
        </button>
        <button type="button" data-exportar="excel" title={tv.descargarEn('Excel')}>
          Excel
        </button>
      </div>
      <button type="button" class="pres-vaciar">
        {tp.vaciar}
      </button>
    </div>
    <button type="button" class="pres-abrir" aria-expanded="false" aria-controls="pres-panel">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        ></path>
      </svg>
      <span class="n"></span>
    </button>
  </div>

  <dialog class="comparador" id="comparador" aria-labelledby="comparador-tit">
    <div class="comp-cab">
      <h2 id="comparador-tit">{tc.titulo}</h2>
      <div class="descargar" role="group" aria-label={tv.descargar}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="1.7" />
        </svg>
        <span class="d-etq">{tv.descargar}</span>
        <button type="button" data-exportar="pdf" title={tv.descargarEn('PDF')}>
          PDF
        </button>
        <button type="button" data-exportar="excel" title={tv.descargarEn('Excel')}>
          Excel
        </button>
      </div>
      <button type="button" class="cerrar-comp" aria-label={tc.cerrar}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d={cruz} stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <div class="comp-tabla"></div>
  </dialog>

  <script
    type="application/json"
    id="datos-comparar"
    set:html={JSON.stringify({
      maquinas: comparables,
      filas: filasComparar,
      textos: { quitar: tc.quitar('{n}'), maximo: tc.maximo, verFicha: tf.verFicha, mejor: tc.mejor },
    })}
  />
  <script
    type="application/json"
    id="datos-tubos"
    set:html={JSON.stringify({
      modelos: tubosModelo,
      cifras: cifrasModelo,
      texto: t.catalogo.filtros.conTubo('{r}', '{t}', '{n}'),
    })}
  />
  <!-- Vista previa del PDF: el documento ya hecho, y desde aquí se descarga o se imprime -->
  <dialog class="vista-pdf" id="vista-pdf" aria-labelledby="vista-pdf-tit">
    <div class="vp-cab">
      <h2 id="vista-pdf-tit">{tv.vistaPrevia}</h2>
      <button type="button" class="vp-descargar">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="1.8" />
        </svg>
        {tv.descargarPdf}
      </button>
      <button type="button" class="vp-imprimir">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M7 9V4h10v5M7 17H5v-7h14v7h-2M8 14h8v6H8z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          />
        </svg>
        {tv.imprimir}
      </button>
      <button type="button" class="vp-cerrar" aria-label={tc.cerrar}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d={cruz} stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <div class="vp-cuerpo">
      <iframe title={tv.vistaPrevia}></iframe>
      <p class="vp-espera">{tv.preparando}</p>
      <p class="vp-sin">{tv.sinVista}</p>
      <p class="vp-fallo">{tv.fallo}</p>
    </div>
  </dialog>

  <script
    type="application/json"
    id="datos-exportar"
    set:html={JSON.stringify({
      titulo: tv.docTitulo,
      comp: tv.compTitulo,
      todo: tv.todo,
      seleccion: tv.seleccion,
      uno: tv.modelos(1),
      varios: tv.modelos(999),
      archivo: tv.archivo,
      archivoComp: tv.archivoComp,
      etqSeleccion: tv.etqSeleccion,
      etqOrden: tv.etqOrden,
      etqModelos: tv.etqModelos,
      tipoTabla: tv.tipoTabla,
      tipoComp: tv.tipoComp,
      mayorCorto: tv.mayorCorto,
      menorCorto: tv.menorCorto,
      catalogoOrden: tv.catalogoOrden,
      tipoPres: tv.tipoPres,
      presTitulo: tv.presTitulo,
      producto: tv.producto,
      etqUnidades: tv.etqUnidades,
      archivoPres: tv.archivoPres,
      fuente: tv.fuente,
      empresa: `${contacto.empresa} · ${contacto.direccion}`,
      pagina: tv.pagina,
    })}
  />
  <script
    type="application/json"
    id="datos-presupuesto"
    set:html={JSON.stringify({
      maquinas: presupuestables,
      correo: contacto.comercial,
      textos: {
        quitar: tp.quitar('{n}'),
        asunto: tp.asunto,
        cuerpo: tp.cuerpo,
        boton: tp.boton(999),
        anadir: tp.anadir,
        quitarDeLista: tp.quitarDeLista,
        corto: tp.corto,
        ud: tp.ud,
        menos: tp.menos,
        aviso: tp.aviso,
        mas: tp.mas,
      },
    })}
  />
</Base>

<script>
  import { iniciarComparador } from '../../scripts/comparador';
  iniciarComparador();
  import { iniciarPresupuesto } from '../../scripts/presupuesto';
  iniciarPresupuesto();

  // ——— Descargar la tabla (lo filtrado, en su orden) o la comparativa, en PDF o en Excel ———
  import { excel, hoy, iniciarVistaPdf, leerTabla, pdf, type Hoja } from '../../scripts/exportar';
  iniciarVistaPdf();
  const tx = JSON.parse(document.getElementById('datos-exportar')?.textContent ?? '{}') as Record<string, string>;
  const hojaTabla = (enTabla: boolean): Hoja | undefined => {
    const tabla = document.querySelector<HTMLTableElement>('.tabla-vista table');
    if (!tabla) return;
    // Si se han elegido filas en la tabla, salen solo esas; si no (o desde las tarjetas), todo lo que dejan los filtros
    const marcada = (tr: HTMLTableRowElement) => !!tr.querySelector('.elegir input:checked');
    const hayMarcadas = enTabla && [...tabla.tBodies[0].rows].some((tr) => !tr.hidden && marcada(tr));
    const { cabecera, filas } = leerTabla(tabla, hayMarcadas ? marcada : undefined);
    const d = hoy();
    const puesto = JSON.parse(document.getElementById('salas')?.dataset.resumen ?? '[]') as string[];
    // La columna por la que se ordena y hacia dónde ("Fuerza máx., de mayor a menor")
    const col = tabla.querySelector<HTMLElement>('th[aria-sort="descending"], th[aria-sort="ascending"]');
    const orden = col
      ? `${col.textContent!.trim()}, ${col.getAttribute('aria-sort') === 'ascending' ? tx.menorCorto : tx.mayorCorto}`
      : tx.catalogoOrden;
    return {
      tipo: tx.tipoTabla,
      titulo: tx.titulo,
      fecha: d.texto,
      datos: [
        [tx.etqSeleccion, hayMarcadas ? tx.seleccion : puesto.length ? puesto.join(' · ') : tx.todo],
        [tx.etqOrden, orden],
        [tx.etqModelos, filas.length === 1 ? tx.uno : tx.varios.replace('999', String(filas.length))],
      ],
      cabecera,
      filas,
      archivo: `${tx.archivo}-${d.archivo}`,
    };
  };
  const hojaComparativa = (): Hoja | undefined => {
    const tabla = document.querySelector<HTMLTableElement>('#comparador .comp-tabla table');
    if (!tabla) return;
    const { cabecera, filas } = leerTabla(tabla);
    const d = hoy();
    return {
      tipo: tx.tipoComp,
      titulo: tx.comp,
      fecha: d.texto,
      datos: [
        [
          tx.etqModelos,
          cabecera
            .slice(1)
            .map((c) => c.t)
            .join(' · '),
        ],
      ],
      cabecera,
      filas,
      archivo: `${tx.archivoComp}-${d.archivo}`,
    };
  };
  // La lista de presupuesto tal como está en su panel: cada producto con su foto y sus unidades
  const hojaPresupuesto = (): Hoja | undefined => {
    const items = [...document.querySelectorAll<HTMLElement>('#presupuesto .pres-lista li')];
    if (!items.length) return;
    const filas = items.map((li) => {
      const n = Number(li.querySelector('output')?.textContent) || 1;
      return [
        {
          t: li.querySelector('span')!.textContent!.trim(),
          img: li.querySelector('img')?.getAttribute('src') ?? undefined,
        },
        { t: String(n), n },
      ];
    });
    const total = filas.reduce((s, f) => s + (f[1].n ?? 0), 0);
    const d = hoy();
    return {
      tipo: tx.tipoPres,
      titulo: tx.presTitulo,
      fecha: d.texto,
      datos: [
        [tx.etqModelos, String(filas.length)],
        [tx.etqUnidades, String(total)],
      ],
      cabecera: [{ t: tx.producto }, { t: tx.etqUnidades, num: true }],
      filas,
      archivo: `${tx.archivoPres}-${d.archivo}`,
    };
  };
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-exportar]')) {
    b.addEventListener('click', () => {
      const h = b.closest('#comparador')
        ? hojaComparativa()
        : b.closest('#presupuesto')
          ? hojaPresupuesto()
          : hojaTabla(!!b.closest('.tabla-vista'));
      if (!h) return;
      if (b.dataset.exportar === 'excel') excel(h);
      // El presupuesto no lleva datos técnicos: sin la línea de dónde salen
      else
        void pdf(h, {
          empresa: tx.empresa,
          web: 'ortoalresa.com',
          pagina: tx.pagina,
          fuente: b.closest('#presupuesto') ? '' : tx.fuente,
        });
    });
  }

  // Sin ningún modelo a la vista, ni tabla ni descargas: queda solo el mensaje de "sin resultados"
  // (los filtros de la dirección ya se han aplicado al cargar: se mira también al arrancar)
  const conFilas = () => {
    const tabla = document.querySelector<HTMLElement>('.tabla-vista');
    if (!tabla) return;
    const hay = [...tabla.querySelectorAll<HTMLElement>('tbody tr')].some((tr) => !tr.hidden);
    tabla.classList.toggle('sin-filas', !hay);
    for (const b of document.querySelectorAll<HTMLButtonElement>(
      '.tabla-estado [data-exportar], .atajos-fila [data-exportar]',
    ))
      b.disabled = !hay;
  };

  // ——— Elegir filas de la tabla para descargar solo esas: la casilla de cada fila, "todas" en la cabecera (las que
  // se ven) y, encima, cuántas hay con su × para quitarlas ———
  const elegirTodas = document.querySelector<HTMLInputElement>('.elegir-todas');
  const casillasFila = [...document.querySelectorAll<HTMLInputElement>('.tabla-vista tbody .elegir input')];
  const eleccion = document.querySelector<HTMLButtonElement>('.tabla-estado .eleccion');
  const pintarEleccion = () => {
    const vis = casillasFila.filter((c) => !c.closest('tr')!.hidden);
    const n = vis.filter((c) => c.checked).length;
    for (const c of casillasFila) c.closest('tr')!.classList.toggle('elegida', c.checked);
    if (elegirTodas) {
      elegirTodas.checked = n > 0 && n === vis.length;
      elegirTodas.indeterminate = n > 0 && n < vis.length;
    }
    if (eleccion) {
      eleccion.hidden = n === 0;
      eleccion.querySelector('span')!.textContent =
        n === 1 ? eleccion.dataset.uno! : eleccion.dataset.varios!.replace('999', String(n));
    }
  };
  for (const c of casillasFila) c.addEventListener('change', pintarEleccion);
  elegirTodas?.addEventListener('change', () => {
    for (const c of casillasFila) if (!c.closest('tr')!.hidden) c.checked = elegirTodas.checked;
    pintarEleccion();
  });
  eleccion?.addEventListener('click', () => {
    for (const c of casillasFila) c.checked = false;
    pintarEleccion();
  });
  document.addEventListener('catalogo:filtrado', pintarEleccion);
  conFilas();
  document.addEventListener('catalogo:filtrado', conFilas);

  const salasEl = document.getElementById('salas');
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ——— Versiones de una serie: el selector cambia foto, nombre, temperatura, cifras y enlace, y lo que guardan
  // Comparar y Presupuesto. Al pasar a refrigerada, un velo frío barre la foto; a calefactada, uno cálido. ———
  const velos: Record<string, string> = {
    refrigerada: 'rgba(120, 190, 255, 0.38)',
    calefactada: 'rgba(255, 140, 60, 0.3)',
  };
  const verVersion = (li: HTMLElement, i: string, animar = true) => {
    const b = li.querySelector<HTMLButtonElement>(`.versiones [data-i="${i}"]`);
    if (!b || b.getAttribute('aria-pressed') === 'true') return;
    for (const x of li.querySelectorAll<HTMLButtonElement>('.versiones button'))
      x.setAttribute('aria-pressed', String(x === b));
    for (const el of li.querySelectorAll<HTMLElement>('[data-v]')) el.hidden = el.dataset.v !== i;
    li.querySelector<HTMLAnchorElement>('a.pieza')!.href = b.dataset.href!;
    const comparar = li.querySelector<HTMLInputElement>('.comparar input');
    if (comparar) comparar.value = b.dataset.slug!;
    const anadir = li.querySelector<HTMLElement>('.anadir');
    if (anadir) anadir.dataset.slug = b.dataset.slug!;
    document.dispatchEvent(new Event('catalogo:version'));
    const velo = li.querySelector<HTMLElement>('.velo');
    const tinte = velos[b.dataset.t ?? ''];
    if (animar && !quieto && velo && tinte) {
      velo.style.background = tinte;
      velo.animate(
        [
          { opacity: 1, clipPath: 'inset(0 100% 0 0)' },
          { opacity: 1, clipPath: 'inset(0 0 0 0)', offset: 0.45 },
          { opacity: 0, clipPath: 'inset(0 0 0 0)' },
        ],
        { duration: 900, easing: 'cubic-bezier(0.65, 0, 0.35, 1)' },
      );
    }
  };
  salasEl?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.versiones button');
    if (b) verVersion(b.closest<HTMLElement>('.ficha')!, b.dataset.i!);
  });
  // Al filtrar por temperatura, cada tarjeta enseña la versión que cumple (la 22 R si se pide refrigerada)
  document.addEventListener('catalogo:filtrado', (e) => {
    const temps = (e as CustomEvent<{ temps: string[] }>).detail?.temps ?? [];
    if (!temps.length) return;
    for (const g of document.querySelectorAll<HTMLElement>('.versiones')) {
      const actual = g.querySelector<HTMLButtonElement>('[aria-pressed="true"]');
      if (actual && temps.includes(actual.dataset.t!)) continue;
      const otra = [...g.querySelectorAll<HTMLButtonElement>('button')].find((x) => temps.includes(x.dataset.t!));
      if (otra) verVersion(g.closest<HTMLElement>('.ficha')!, otra.dataset.i!, false);
    }
  });
  // Tubo elegido: cada tarjeta dice en qué rotor va y cuántos caben; si su versión a la vista no lo admite y otra sí,
  // enseña esa
  const datosTubos = JSON.parse(document.getElementById('datos-tubos')?.textContent ?? '{}') as {
    modelos: Record<string, Record<string, [string, string, number]>>;
    texto: string;
  };
  let tuboActual = '';
  const pintarTubos = () => {
    for (const li of document.querySelectorAll<HTMLElement>('#salas .ficha[data-slugs]')) {
      const franja = li.querySelector<HTMLElement>('.con-tubo');
      if (!franja) continue;
      const activa = li.querySelector<HTMLButtonElement>('.versiones [aria-pressed="true"]');
      const slug = activa?.dataset.slug ?? li.dataset.slugs!.split(' ')[0];
      const dato = tuboActual ? datosTubos.modelos?.[slug]?.[tuboActual] : undefined;
      franja.hidden = !dato;
      if (dato)
        franja.textContent = datosTubos.texto
          .replace('{r}', dato[0])
          .replace('{t}', dato[1])
          .replace('{n}', String(dato[2]));
    }
  };
  document.addEventListener('catalogo:filtrado', (e) => {
    const detalle = (e as CustomEvent<{ tubo?: string; validos?: string[] }>).detail;
    tuboActual = detalle?.tubo ?? '';
    // Con mínimos puestos, cada tarjeta enseña una versión que llega a ellos
    const validos = detalle?.validos;
    if (validos)
      for (const g of document.querySelectorAll<HTMLElement>('.versiones')) {
        const actual = g.querySelector<HTMLButtonElement>('[aria-pressed="true"]');
        if (actual && validos.includes(actual.dataset.slug!)) continue;
        const otra = [...g.querySelectorAll<HTMLButtonElement>('button')].find((x) =>
          validos.includes(x.dataset.slug!),
        );
        if (otra) verVersion(g.closest<HTMLElement>('.ficha')!, otra.dataset.i!, false);
      }
    if (tuboActual)
      for (const g of document.querySelectorAll<HTMLElement>('.versiones')) {
        const actual = g.querySelector<HTMLButtonElement>('[aria-pressed="true"]');
        if (actual && datosTubos.modelos?.[actual.dataset.slug!]?.[tuboActual]) continue;
        const otra = [...g.querySelectorAll<HTMLButtonElement>('button')].find(
          (x) => datosTubos.modelos?.[x.dataset.slug!]?.[tuboActual],
        );
        if (otra) verVersion(g.closest<HTMLElement>('.ficha')!, otra.dataset.i!, false);
      }
    pintarTubos();
  });
  document.addEventListener('catalogo:version', pintarTubos);
  // Por si los filtros ya se aplicaron antes de llegar aquí (al abrir un enlace con ?tubo=)
  tuboActual = document.querySelector<HTMLInputElement>('input[name=tubo]')?.value ?? '';
  pintarTubos();

  // Si se llega con el enlace de una versión concreta (#digicen-22-r), se enseña esa
  const pedida =
    location.hash &&
    document.querySelector<HTMLButtonElement>(`.versiones [data-slug="${CSS.escape(location.hash.slice(1))}"]`);
  if (pedida) {
    const li = pedida.closest<HTMLElement>('.ficha')!;
    verVersion(li, pedida.dataset.i!, false);
    li.scrollIntoView();
  }

  // ——— Las rpm aceleran como la máquina: la primera vez que se ve la tarjeta, de 0 a su velocidad con una rampa
  // de arranque y frenada ———
  const acelerar = (ficha: HTMLElement) => {
    const el = ficha.querySelector<HTMLElement>('.placa:not([hidden]) .rpm .valor');
    if (!el) return;
    const texto = el.textContent ?? '';
    const fin = Number(texto.replace(/\D/g, ''));
    const sep = /\d(\D)\d/.exec(texto)?.[1] ?? '';
    const t0 = performance.now();
    const paso = (t: number) => {
      const p = Math.min((t - t0) / 1300, 1);
      const r = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
      el.textContent = String(Math.round((fin * r) / 100) * 100).replace(/\B(?=(\d{3})+(?!\d))/g, sep);
      if (p < 1) requestAnimationFrame(paso);
      else el.textContent = texto;
    };
    requestAnimationFrame(paso);
  };

  // Al bajar, las máquinas entran de abajo arriba, escalonadas por fila, y las portadas se descubren
  if (salasEl && !quieto && 'IntersectionObserver' in window) {
    salasEl.classList.add('revela');
    const io = new IntersectionObserver(
      (entradas) => {
        entradas
          .filter((e) => e.isIntersecting)
          .forEach((e, i) => {
            const el = e.target as HTMLElement;
            el.style.setProperty('--d', `${i * 70}ms`);
            el.classList.add('visto');
            if (el.classList.contains('ficha')) setTimeout(() => acelerar(el), 200 + i * 70);
            io.unobserve(el);
          });
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    for (const el of salasEl.querySelectorAll('.ficha, .sala-cab')) io.observe(el);

    // La foto del rotor de cada portada se desplaza un poco al bajar, como si la máquina se moviera
    const portadas = [...salasEl.querySelectorAll<HTMLElement>('.sala-cab')];
    let marco = 0;
    const mover = () => {
      const alto = innerHeight;
      for (const el of portadas) {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > alto) continue;
        const p = 1 - (r.top + r.height) / (alto + r.height);
        el.style.setProperty('--foto-y', `${(28 + p * 30).toFixed(1)}%`);
      }
    };
    addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(marco);
        marco = requestAnimationFrame(mover);
      },
      { passive: true },
    );
    mover();
  }
</script>

