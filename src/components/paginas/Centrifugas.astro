---
// Página de Productos. Arriba, el hero con la Digicen 22 en 3D (HeroProductos.astro). Debajo, el catálogo: la misma
// exposición con la luz encendida. Las máquinas, recortadas sobre blanco y apoyadas en una elipse roja, agrupadas por
// familia en capítulos como los del catálogo impreso; al final, los accesorios y los equipos de laboratorio.
// Una barra fina fija arriba filtra por texto, temperatura y aplicación (en móvil, en un panel que sube desde abajo),
// y un comparador pone 2 o 3 centrífugas lado a lado. La lógica está en src/scripts/catalogo.ts.
// Los filtros se guardan en la dirección (?c=, ?t=, ?q=) para poder compartir una búsqueda.
import Base from '../../layouts/Base.astro';
import HeroProductos from '../HeroProductos.astro';
import Maquina from '../Maquina.astro';
import Paso from '../Paso.astro';
import IconoTemp from '../ui/IconoTemp.astro';
import {
  categorias,
  familias,
  modelos,
  productos,
  totalModelos,
  type Categoria,
  type Familia,
  type Modelo,
  type Temperatura,
} from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import { cifra, fichaCentrifuga } from '../../data/fichas';
import { idioma, numero, ruta, textoSerie, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const f = t.catalogo.filtros;
const tc = t.catalogo.comparar;
const tf = t.catalogo.ficha;

const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// Texto para el buscador: sin tildes ni mayúsculas, como la lupa de la cabecera
const plano = (...partes: (string | undefined)[]) =>
  partes.filter(Boolean).join(' ').normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();

type Otro = 'accesorios' | 'laboratorio';
type Cat = Categoria | Otro;
const grupos: { nombre: string; cats: Cat[] }[] = [
  { nombre: t.catalogo.grupos.generales, cats: [...categorias.generales] },
  { nombre: t.catalogo.grupos.especiales, cats: [...categorias.especiales] },
  { nombre: t.catalogo.grupos.otros, cats: ['accesorios', 'laboratorio'] },
];
const nombreCat = (c: Cat) =>
  c === 'accesorios'
    ? t.laboratorio.accesorios
    : c === 'laboratorio'
      ? t.laboratorio.equipos
      : t.catalogo.categorias[c];
const nombreCorto = (c: Cat) => (c === 'accesorios' || c === 'laboratorio' ? f.cortos[c] : nombreCat(c));
const temperaturas: Temperatura[] = ['ventilada', 'refrigerada', 'calefactada'];

const serieDe = (m: Modelo) => productos.find((p) => p.slug === m.serie)!;
// La capacidad como la cuenta el catálogo de cada idioma; si la versión tiene la suya (Digtor 22 C-8), esa
const capacidad = (m: Modelo) =>
  m.capacidad === serieDe(m).capacidad ? (textoSerie(lang, m.serie).capacidad ?? m.capacidad) : m.capacidad;
const datosDe = (m: Modelo) => `${capacidad(m)} · ${numero(lang, m.rpm)} rpm · ${m.pantalla}`;

// Capítulos: una familia cada uno, en el orden del catálogo impreso, y al final accesorios y laboratorio
type Item = { tipo: 'modelo'; cat: Cat; m: Modelo } | { tipo: 'lab'; cat: Otro; p: ProductoLab };
const capitulos: { clave: string; nombre: string; items: Item[] }[] = [
  ...(Object.keys(familias) as Familia[]).map((fam) => ({
    clave: fam,
    nombre: t.familias[fam],
    items: modelos
      .filter((m) => serieDe(m).familia === fam)
      .map((m): Item => ({ tipo: 'modelo', cat: m.categoria, m })),
  })),
  {
    clave: 'accesorios',
    nombre: t.laboratorio.accesorios,
    items: accesorios.map((p): Item => ({ tipo: 'lab', cat: 'accesorios', p })),
  },
  {
    clave: 'laboratorio',
    nombre: t.laboratorio.equipos,
    items: equipos.map((p): Item => ({ tipo: 'lab', cat: 'laboratorio', p })),
  },
].filter((c) => c.items.length);
const total = capitulos.reduce((n, c) => n + c.items.length, 0);

// Comparador: los datos que el distribuidor mira para elegir, de la tabla de la serie y de la ficha de cada modelo
const aNumero = (s?: string) => (s ? Number(s.replace(/\D/g, '')) : undefined);
const comparables = Object.fromEntries(
  modelos.map((m) => {
    const web = fichaCentrifuga(m.slug);
    const v0 = web?.versiones[0];
    const xg = m.xg ?? web?.xg;
    return [
      m.slug,
      {
        nombre: m.nombre,
        img: m.imagen.src,
        href: ruta(lang, `/centrifugas/${m.slug}/`),
        filas: {
          aplicacion: t.catalogo.categorias[m.categoria],
          temperatura: may(t.temperatura[m.temperatura]),
          capacidad: capacidad(m),
          velocidad: `${numero(lang, m.rpm)} rpm`,
          fuerza: xg ? `${m.xg ? numero(lang, m.xg) : cifra(lang, xg)} xg` : undefined,
          pantalla: m.pantalla,
          medidas: v0?.medidas ? `${v0.medidas.replace(/x/g, ' × ')} mm` : undefined,
          peso: v0?.peso ? `${v0.peso} kg` : undefined,
          consumo: v0?.consumo ? `${v0.consumo} W` : undefined,
          rotores: web?.rotores.length ? String(web.rotores.length) : undefined,
        },
        // Para marcar el mayor de cada fila numérica
        num: { velocidad: aNumero(m.rpm), fuerza: aNumero(xg), rotores: web?.rotores.length },
      },
    ];
  }),
);
const filasComparar = [
  { k: 'aplicacion', nombre: tc.aplicacion },
  { k: 'temperatura', nombre: tc.temperatura },
  { k: 'capacidad', nombre: tf.capacidad },
  { k: 'velocidad', nombre: tf.velocidad },
  { k: 'fuerza', nombre: tf.fuerza },
  { k: 'pantalla', nombre: tf.pantalla },
  { k: 'medidas', nombre: tf.versiones.medidas },
  { k: 'peso', nombre: tf.versiones.peso },
  { k: 'consumo', nombre: tf.versiones.consumo },
  { k: 'rotores', nombre: tc.rotores },
];
---

<Base title={t.catalogo.title} description={t.catalogo.description(productos.length, totalModelos)}>
  <HeroProductos />

  <section class="catalogo" id="catalogo" aria-label={t.catalogo.indice}>
    <Paso desde="#fff" />

    <!-- Barra de filtros: fija arriba al bajar. Sin JS no aparece y se ve todo el catálogo -->
    <div class="filtros" id="filtros" hidden>
      <form class="wrap filtros-in" role="search" aria-label={f.titulo}>
        <label class="buscar">
          <span class="sr">{f.buscar}</span>
          <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
          <input type="search" name="q" placeholder={f.buscar} autocomplete="off" enterkeyhint="search" />
        </label>

        <button type="button" class="abrir-panel" aria-expanded="false" aria-controls="panel-filtros">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M4 7h10M18 7h2M4 17h2M10 17h10"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            ></path>
            <circle cx="16" cy="7" r="2" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <circle cx="8" cy="17" r="2" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          </svg>
          {f.filtros}
          <span class="cuenta" hidden></span>
        </button>

        <!-- En escritorio, en la misma línea; en móvil, un panel que sube desde abajo -->
        <div class="panel" id="panel-filtros" aria-label={f.titulo}>
          <div class="panel-cab">
            <p>{f.filtros}</p>
            <button type="button" class="cerrar-panel" aria-label={f.cerrar}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
            </button>
          </div>

          <div class="temps" role="group" aria-label={f.temperatura}>
            <p class="panel-rot">{f.temperatura}</p>
            {temperaturas.map((x) => (
              <button type="button" class="temp" data-v={x} aria-pressed="false">
                <IconoTemp t={x} />
                {may(t.temperatura[x])}
              </button>
            ))}
          </div>

          <div class="aplic">
            <p class="panel-rot">{f.aplicacion}</p>
            <button type="button" class="aplic-btn" aria-expanded="false" aria-controls="menu-aplic">
              <span class="aplic-txt">{f.todas}</span>
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.6"></path>
              </svg>
            </button>
            <div class="menu" id="menu-aplic" role="group" aria-label={f.aplicacion}>
              <button type="button" class="cat todo" data-c="" data-nombre={f.todas} aria-pressed="true">
                <span class="nom">{f.todas}</span>
                <span class="n"></span>
              </button>
              {grupos.map((g) => (
                <div class="menu-grupo">
                  <p class="menu-tit">{g.nombre}</p>
                  {g.cats.map((c) => (
                    <button type="button" class="cat" data-c={c} data-nombre={nombreCorto(c)} aria-pressed="false">
                      <span class="nom">{nombreCat(c)}</span>
                      <span class="n" />
                    </button>
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="panel-pie">
            <button type="button" class="limpiar quitar-panel">
              {f.limpiar}
            </button>
            <button type="button" class="ver-res" data-ver={f.ver(999)} data-uno={f.ver(1)}></button>
          </div>
        </div>

        <p class="total" aria-live="polite" data-uno={f.resultados(1)} data-varios={f.resultados(999)}>
          {f.resultados(total)}
        </p>
        <button type="button" class="limpiar quitar" hidden>
          {f.limpiar}
        </button>
      </form>
    </div>
    <div class="velo" hidden></div>

    <!-- Capítulos por familia -->
    <div class="wrap capitulos" id="capitulos" data-modelos={f.modelos(999)} data-modelo={f.modelos(1)}>
      {capitulos.map((c, i) => (
        <section class="capitulo" data-cap={c.clave} aria-labelledby={`cap-${c.clave}`}>
          <header class="cap-cab">
            <span class="cap-n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h2 id={`cap-${c.clave}`}>{c.nombre}</h2>
            <span class="cap-cuenta">{f.modelos(c.items.length)}</span>
          </header>
          <ul class="maquinas">
            {c.items.map((x) =>
              x.tipo === 'modelo' ? (
                <li
                  class="ficha"
                  id={x.m.principal ? x.m.serie : x.m.slug}
                  data-cat={x.cat}
                  data-t={x.m.temperatura}
                  data-texto={plano(
                    x.m.nombre,
                    c.nombre,
                    nombreCat(x.cat),
                    textoSerie(lang, x.m.serie).frase,
                    capacidad(x.m),
                    x.m.pantalla,
                    t.temperatura[x.m.temperatura],
                  )}
                >
                  <Maquina slug={x.m.slug} nombre={x.m.nombre} datos={datosDe(x.m)} imagen={x.m.imagen} comparable />
                </li>
              ) : (
                <li
                  class="ficha"
                  id={x.p.slug}
                  data-cat={x.cat}
                  data-texto={plano(
                    t.laboratorio.items[x.p.slug].nombre,
                    x.p.modelo,
                    nombreCat(x.cat),
                    t.laboratorio.items[x.p.slug].frase,
                    t.laboratorio.items[x.p.slug].datos,
                  )}
                >
                  <Maquina
                    slug={x.p.slug}
                    nombre={t.laboratorio.items[x.p.slug].nombre}
                    datos={x.p.modelo}
                    imagen={x.p.imagen}
                  />
                </li>
              ),
            )}
          </ul>
        </section>
      ))}

      <div class="vacio" hidden>
        <p class="vacio-tit">{f.vacio}</p>
        <p>{f.vacioPista}</p>
        <button type="button" class="limpiar boton">
          {f.limpiar}
        </button>
      </div>
    </div>
  </section>

  <!-- Comparador: barra abajo con las elegidas y, al abrirla, las máquinas lado a lado -->
  <div class="barra-comparar" id="barra-comparar" role="region" aria-label={tc.titulo} hidden>
    <ul class="elegidas"></ul>
    <p class="pista-otra">{tc.otra}</p>
    <div class="barra-acciones">
      <button type="button" class="vaciar">
        {tc.vaciar}
      </button>
      <button type="button" class="abrir-comparar" data-txt={tc.abrir(999)}></button>
    </div>
  </div>

  <dialog class="comparador" id="comparador" aria-labelledby="comparador-tit">
    <div class="comp-cab">
      <h2 id="comparador-tit">{tc.titulo}</h2>
      <button type="button" class="cerrar-comp" aria-label={tc.cerrar}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <div class="comp-tabla"></div>
  </dialog>

  <script
    type="application/json"
    id="datos-comparar"
    set:html={JSON.stringify({
      maquinas: comparables,
      filas: filasComparar,
      textos: {
        quitar: tc.quitar('{n}'),
        maximo: tc.maximo,
        verFicha: tf.verFicha,
        mejor: tc.mejor,
      },
    })}
  />
</Base>

<script>
  import { iniciarCatalogo } from '../../scripts/catalogo';
  iniciarCatalogo();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ——— El catálogo: la exposición con la luz encendida ——— */
  .catalogo {
    /* Altura de la cabecera de la web cuando está a la vista: la barra de filtros se queda justo debajo */
    --arriba: 0px;
    position: relative;
    padding-bottom: clamp(96px, 12vw, 160px);
    background: #fff;
  }
  :global(html:has(#top:not(.oculta))) .catalogo {
    --arriba: 77px;
  }

  /* ——— Barra de filtros: fina, fija arriba al bajar ——— */
  .filtros {
    position: sticky;
    top: var(--arriba);
    z-index: 15;
    margin-top: 2px;
    background: rgba(255, 255, 255, 0.94);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    transition:
      top 0.35s var(--ease),
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .filtros:global(.pegada) {
    border-bottom-color: var(--line);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.25);
  }
  .filtros-in {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 36px);
    min-height: 76px;
  }
  .buscar {
    flex: 0 1 340px;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    transition: border-color 0.25s var(--ease);
  }
  .buscar:focus-within {
    border-color: var(--ink);
    color: var(--ink);
  }
  .buscar input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: none;
    font: 400 17px var(--f);
    color: var(--ink);
    outline: none;
  }
  .buscar input::placeholder {
    color: var(--muted);
  }
  .buscar input::-webkit-search-cancel-button {
    cursor: pointer;
  }

  button {
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  /* Los botones que se pintan desde JS (comparador) no llevan el ámbito del componente */
  .elegidas :global(button),
  .comp-tabla :global(button) {
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  /* Panel: en escritorio sus piezas van en la barra */
  .panel {
    display: contents;
  }
  .panel-cab,
  .panel-rot,
  .panel-pie,
  .abrir-panel {
    display: none;
  }
  .temps {
    display: flex;
    gap: 4px;
  }
  .temp {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 14px;
    font-size: 16px;
    font-weight: 400;
    color: var(--ink);
    border: 1px solid var(--line);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background 0.2s var(--ease);
  }
  .temp :global(.icono-temp) {
    color: var(--body);
    transition: color 0.2s var(--ease);
  }
  .temp[aria-pressed='true'] {
    color: #fff;
    font-weight: 700;
    background: var(--ink);
    border-color: var(--ink);
  }
  .temp[aria-pressed='true'] :global(.icono-temp) {
    color: #fff;
  }
  .temp[aria-pressed='true'] :global(.icono-temp) {
    color: var(--red);
  }
  .temp:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Aplicación: un botón con la elegida y su lista desplegable */
  .aplic {
    position: relative;
  }
  .aplic-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 38px;
    padding: 0 14px;
    font-size: 16px;
    font-weight: 400;
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .aplic-btn[aria-expanded='true'] svg {
    rotate: 180deg;
  }
  .aplic-btn svg {
    transition: rotate 0.25s var(--ease);
  }
  .aplic:global(.elegida) .aplic-btn {
    font-weight: 700;
    color: #fff;
    background: var(--ink);
    border-color: var(--ink);
  }
  .menu {
    position: absolute;
    top: calc(100% + 10px);
    left: -12px;
    z-index: 2;
    display: none;
    width: 300px;
    max-height: min(70vh, 560px);
    overflow-y: auto;
    padding: 10px 0;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.3);
  }
  .aplic:global(.abierta) .menu {
    display: block;
    animation: despliega 0.22s var(--ease);
  }
  .menu-grupo {
    padding-top: 8px;
    margin-top: 8px;
    border-top: 1px solid #ececec;
  }
  .menu-tit {
    padding: 4px 20px 6px;
    font-size: 14px;
    font-weight: 300;
    color: #8a8a8a;
  }
  .cat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 8px 20px;
    font-size: 16px;
    font-weight: 300;
    text-align: left;
    color: var(--ink);
    transition: background 0.15s var(--ease);
  }
  .cat .n {
    font-size: 14px;
    color: #8a8a8a;
    font-variant-numeric: tabular-nums;
  }
  .cat[aria-pressed='true'] {
    font-weight: 700;
    box-shadow: inset 2px 0 0 var(--red);
  }
  .cat:disabled {
    color: #b4b4b4;
    cursor: default;
  }
  .cat:focus-visible {
    outline-offset: -2px;
  }

  .total {
    margin-left: auto;
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .quitar {
    font-size: 16px;
    font-weight: 400;
    color: var(--red);
    white-space: nowrap;
  }

  /* ——— Capítulos ——— */
  /* Altura mínima: al filtrar con pocos resultados la página no encoge de golpe bajo la barra */
  .capitulos {
    min-height: 80vh;
  }
  .capitulo {
    padding-top: clamp(72px, 8vw, 120px);
  }
  .capitulo:first-of-type {
    padding-top: clamp(32px, 4vw, 48px);
  }
  .cap-cab {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: 0 clamp(16px, 2vw, 28px);
    padding-bottom: 22px;
    border-bottom: 2px solid var(--ink);
  }
  .cap-n {
    align-self: start;
    padding-top: 0.5em;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--red);
    font-variant-numeric: tabular-nums;
  }
  .cap-cab h2 {
    font-size: clamp(42px, 5.4vw, 80px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .cap-cuenta {
    padding-bottom: 0.5em;
    font-size: 16px;
    font-weight: 400;
    color: var(--body);
    font-variant-numeric: tabular-nums;
  }
  .maquinas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(48px, 5vw, 72px) clamp(20px, 2.4vw, 32px);
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding: 0;
    list-style: none;
  }
  /* Entrada al bajar: suben un poco y aparecen, escalonadas por fila */
  .capitulos:global(.revela) .ficha:not(:global(.visto)) {
    opacity: 0;
