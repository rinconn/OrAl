---
// Catálogo de productos, en oscuro como la portada: los 23 modelos de centrífuga (fotos y aplicaciones de la página de
// productos de la web actual), los accesorios y los otros productos de laboratorio. Una barra de cristal fija con las
// aplicaciones como pestañas y "Más filtros" (buscador, temperatura, pantalla y orden); cada modelo en una tarjeta de
// cristal ahumado, con la máquina bajo un foco y sus cuatro datos en fichas con el icono de la web actual.
// Los filtros se guardan en la dirección para poder compartir una búsqueda.
import Base from '../../layouts/Base.astro';
import {
  categorias,
  modelos,
  productos,
  totalModelos,
  type Categoria,
  type Modelo,
  type Temperatura,
} from '../../data/productos';
import { accesorios, equipos, type ProductoLab } from '../../data/laboratorio';
import { idioma, numero, textoSerie, textos } from '../../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang);
const f = t.catalogo.filtros;

const may = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
// Texto para el buscador: sin tildes ni mayúsculas, como la lupa de la cabecera
const plano = (...partes: (string | undefined)[]) =>
  partes.filter(Boolean).join(' ').normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();

type Otro = 'accesorios' | 'laboratorio';
type Cat = Categoria | Otro;
const todas: Cat[] = [...categorias.generales, ...categorias.especiales, 'accesorios', 'laboratorio'];
const nombreCat = (c: Cat) =>
  c === 'accesorios'
    ? t.laboratorio.accesorios
    : c === 'laboratorio'
      ? t.laboratorio.equipos
      : t.catalogo.categorias[c];
const nombreCorto = (c: Cat) => (c === 'accesorios' || c === 'laboratorio' ? f.cortos[c] : nombreCat(c));
const grupoDe = (c: Cat) =>
  (categorias.generales as readonly string[]).includes(c)
    ? t.catalogo.grupos.generales
    : (categorias.especiales as readonly string[]).includes(c)
      ? t.catalogo.grupos.especiales
      : t.catalogo.grupos.otros;

const temperaturas: Temperatura[] = ['ventilada', 'refrigerada', 'calefactada'];
const pantallas = ['TFT', 'LCD', 'LED'] as const;

// Tarjetas en el orden del catálogo: por aplicación, y dentro de cada una como en la web actual
type Ficha = { tipo: 'modelo'; cat: Cat; m: Modelo } | { tipo: 'lab'; cat: Cat; p: ProductoLab };
const lab = (c: Otro, items: ProductoLab[]): Ficha[] => items.map((p) => ({ tipo: 'lab', cat: c, p }));
const fichas = todas.flatMap((c): Ficha[] =>
  c === 'accesorios'
    ? lab(c, accesorios)
    : c === 'laboratorio'
      ? lab(c, equipos)
      : modelos.filter((m) => m.categoria === c).map((m): Ficha => ({ tipo: 'modelo', cat: c, m })),
);
const capacidad = (m: Modelo) =>
  m.capacidad === productos.find((p) => p.slug === m.serie)?.capacidad
    ? (textoSerie(lang, m.serie).capacidad ?? m.capacidad)
    : m.capacidad;
---

<Base title={t.catalogo.title} description={t.catalogo.description(productos.length, totalModelos)}>
  <div class="pagina">
    <!-- Cabecera: título con "productos" en rojo y tres cifras en placas de cristal -->
    <section class="cab">
      <div class="wrap">
        <h1>
          {t.catalogo.titulo[0]}
          <b>{t.catalogo.titulo[1]}</b>
        </h1>
        <p class="lead">{t.catalogo.lead(productos.length, totalModelos)}</p>
        <ul class="cifras">
          <li>
            <b>{modelos.length}</b> {t.catalogo.cifras.centrifugas}
          </li>
          <li>
            <b>{categorias.generales.length + categorias.especiales.length}</b> {t.catalogo.cifras.aplicaciones}
          </li>
          <li>
            <b>{accesorios.length + equipos.length}</b> {t.catalogo.cifras.otros}
          </li>
        </ul>
      </div>
    </section>

    <!-- Barra fija de cristal: las aplicaciones como pestañas y "Más filtros". Sin JS no aparece y se ve todo -->
    <form
      class="barra"
      id="filtros"
      role="search"
      aria-label={f.titulo}
      data-uno={f.resultados(1)}
      data-varios={f.resultados(999)}
      hidden
    >
      <div class="wrap barra-in">
        <div class="pestanas" role="group" aria-label={f.titulo}>
          <button type="button" class="pestana" data-c="" aria-pressed="true">
            {f.todo} <span class="n"></span>
          </button>
          {todas.map((c) => (
            <button type="button" class="pestana" data-c={c} aria-pressed="false" title={grupoDe(c)}>
              {nombreCorto(c)} <span class="n" />
            </button>
          ))}
        </div>
        <button type="button" class="borrar limpiar" hidden>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          {f.limpiar}
        </button>
        <button type="button" class="mas" aria-expanded="false" aria-controls="mas-filtros">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M4 7h10M18 7h2M4 17h4M12 17h8"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
            <circle cx="16" cy="7" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <circle cx="10" cy="17" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          </svg>
          <span>{f.abrir}</span>
          <span class="activos" hidden></span>
        </button>
      </div>

      <!-- Más filtros: se despliega bajo la barra -->
      <div class="panel" id="mas-filtros" hidden>
        <div class="wrap panel-in">
          <label class="buscar">
            <span class="sr">{f.buscar}</span>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
              <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            <input type="search" name="q" placeholder={f.buscar} autocomplete="off" />
          </label>
          <div class="grupo" role="group" aria-label={f.temperatura}>
            <p class="etq">{f.temperatura}</p>
            <div class="chips">
              {temperaturas.map((x) => (
                <button type="button" class="chip" data-f="t" data-v={x} aria-pressed="false">
                  {may(t.temperatura[x])} <span class="n" />
                </button>
              ))}
            </div>
          </div>
          <div class="grupo" role="group" aria-label={f.pantalla}>
            <p class="etq">{f.pantalla}</p>
            <div class="chips">
              {pantallas.map((x) => (
                <button type="button" class="chip" data-f="p" data-v={x} aria-pressed="false">
                  {x} <span class="n" />
                </button>
              ))}
            </div>
          </div>
          <label class="grupo orden">
            <span class="etq">{f.orden}</span>
            <select name="o">
              <option value="">{f.ordenes.catalogo}</option>
              <option value="rapidas">{f.ordenes.rapidas}</option>
              <option value="lentas">{f.ordenes.lentas}</option>
              <option value="nombre">{f.ordenes.nombre}</option>
            </select>
          </label>
        </div>
      </div>
    </form>

    <section class="cat">
      <div class="wrap">
        <div class="estado">
          <p class="total" aria-live="polite"></p>
          <button type="button" class="limpiar" hidden>
            {f.limpiar}
          </button>
        </div>

        <ul class="rejilla" id="rejilla">
          {todas.map((c, i) => (
            <>
              <li class="titulo" data-cat={c}>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <h2>{nombreCat(c)}</h2>
                <span class="grupo-n">{grupoDe(c)}</span>
              </li>
              {fichas
                .filter((x) => x.cat === c)
                .map((x) =>
                  x.tipo === 'modelo' ? (
                    <li
                      class="ficha"
                      id={x.m.principal ? x.m.serie : x.m.slug}
                      data-cat={c}
                      data-t={x.m.temperatura}
                      data-p={x.m.pantalla}
                      data-rpm={x.m.rpm.replace(/\./g, '')}
                      data-nombre={x.m.nombre}
                      data-texto={plano(
                        x.m.nombre,
                        nombreCat(c),
                        grupoDe(c),
                        textoSerie(lang, x.m.serie).frase,
                        capacidad(x.m),
                        x.m.pantalla,
                        t.temperatura[x.m.temperatura],
                      )}
                    >
                      <article>
                        <div class="foto">
                          <img
                            src={x.m.imagen.src}
                            alt={x.m.nombre}
                            width={x.m.imagen.ancho}
                            height={x.m.imagen.alto}
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="luz" aria-hidden="true" />
                        </div>
                        <div class="cuerpo">
                          <p class="cat-n">{nombreCat(c)}</p>
                          <h3>{x.m.nombre}</h3>
                          <p class="frase">{textoSerie(lang, x.m.serie).frase}</p>
                          {/* Los cuatro datos de la web actual, cada uno en su ficha con el icono */}
                          <ul class="datos">
                            <li>
                              <i style="--ico: url(/img/iconos/ficha-capacidad.svg)" aria-hidden="true" />
                              <b>{capacidad(x.m)}</b>
                              <span>{t.catalogo.iconos.capacidad}</span>
                            </li>
                            <li>
                              <i style="--ico: url(/img/iconos/ficha-pantalla.svg)" aria-hidden="true" />
                              <b>{x.m.pantalla}</b>
                              <span>{t.catalogo.iconos.pantalla}</span>
                            </li>
                            <li>
                              <i style="--ico: url(/img/iconos/ficha-velocidad.svg)" aria-hidden="true" />
                              <b>{numero(lang, x.m.rpm)} rpm</b>
                              <span>{x.m.xg ? `${numero(lang, x.m.xg)} xg` : t.catalogo.iconos.velocidad}</span>
                            </li>
                            <li>
                              <i style="--ico: url(/img/iconos/ficha-info.svg)" aria-hidden="true" />
                              <b>{may(t.temperatura[x.m.temperatura])}</b>
                              <span>{t.catalogo.iconos.temperatura}</span>
                            </li>
                          </ul>
                        </div>
                      </article>
                    </li>
                  ) : (
                    <li
                      class="ficha lab"
                      id={x.p.slug}
                      data-cat={c}
                      data-rpm="0"
                      data-nombre={t.laboratorio.items[x.p.slug].nombre}
                      data-texto={plano(
                        t.laboratorio.items[x.p.slug].nombre,
                        x.p.modelo,
                        nombreCat(c),
                        t.laboratorio.items[x.p.slug].frase,
                        t.laboratorio.items[x.p.slug].datos,
                      )}
                    >
                      <article>
                        <div class:list={['foto', { doble: x.p.imagen2 }]}>
                          <img
                            src={x.p.imagen.src}
                            alt={t.laboratorio.items[x.p.slug].nombre}
                            width={x.p.imagen.ancho}
                            height={x.p.imagen.alto}
                            loading="lazy"
                            decoding="async"
                          />
                          {x.p.imagen2 && (
                            <img
                              class="segunda"
                              src={x.p.imagen2.src}
                              alt=""
                              width={x.p.imagen2.ancho}
                              height={x.p.imagen2.alto}
                              loading="lazy"
                              decoding="async"
                            />
                          )}
                          <span class="luz" aria-hidden="true" />
                        </div>
                        <div class="cuerpo">
                          <p class="cat-n">{nombreCat(c)}</p>
                          <h3>
                            {t.laboratorio.items[x.p.slug].nombre} <span>{x.p.modelo}</span>
                          </h3>
                          <p class="frase">{t.laboratorio.items[x.p.slug].frase}</p>
                          <p class="linea">{t.laboratorio.items[x.p.slug].datos}</p>
                          {x.p.pdf && (
                            <a class="arrow pdf" href={x.p.pdf} target="_blank" rel="noopener">
                              {t.laboratorio.pdf}
                            </a>
                          )}
                        </div>
                      </article>
                    </li>
                  ),
                )}
            </>
          ))}
          <li class="vacio" hidden>
            <p>{f.vacio}</p>
            <button type="button" class="btn red limpiar">
              {f.limpiar}
            </button>
          </li>
        </ul>
      </div>
    </section>
  </div>
</Base>

<script>
  // Filtros del catálogo: una aplicación (pestañas), temperatura y pantalla (dentro de cada una se suma, entre ellas
  // se cruza), buscador sin tildes y orden. Cada botón dice cuántos productos quedarían al pulsarlo.
  const form = document.getElementById('filtros') as HTMLFormElement | null;
  const rejilla = document.getElementById('rejilla');
  if (form && rejilla) {
    form.hidden = false;
    const total = (n: number) => (n === 1 ? form.dataset.uno! : form.dataset.varios!.replace('999', String(n)));
    const fichas = [...rejilla.querySelectorAll<HTMLElement>('.ficha')];
    const titulos = [...rejilla.querySelectorAll<HTMLElement>('.titulo')];
    const vacio = rejilla.querySelector<HTMLElement>('.vacio')!;
    const pestanas = [...form.querySelectorAll<HTMLButtonElement>('.pestana')];
    const chips = [...form.querySelectorAll<HTMLButtonElement>('.chip')];
    const q = form.querySelector<HTMLInputElement>('input[name=q]')!;
    const orden = form.querySelector<HTMLSelectElement>('select[name=o]')!;
    const mas = form.querySelector<HTMLButtonElement>('.mas')!;
    const panel = form.querySelector<HTMLElement>('.panel')!;
    const activos = mas.querySelector<HTMLElement>('.activos')!;
    const limpiar = [...document.querySelectorAll<HTMLButtonElement>('.limpiar')];
    const totalEl = document.querySelector<HTMLElement>('.estado .total')!;

    let cat = '';
    const estado: Record<'t' | 'p', Set<string>> = { t: new Set(), p: new Set() };
    const plano = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
    // ¿Cumple los filtros? Se puede probar con otra aplicación u otro valor para contar cuántos quedarían
    const cumple = (el: HTMLElement, prueba?: { c?: string; f?: 't' | 'p'; v?: string }) => {
      const c = prueba && 'c' in prueba ? prueba.c! : cat;
      if (c && el.dataset.cat !== c) return false;
      for (const k of ['t', 'p'] as const) {
        const valores = new Set(estado[k]);
        if (prueba?.f === k) valores.add(prueba.v!);
        if (valores.size && !valores.has(el.dataset[k] ?? '')) return false;
      }
      const texto = plano(q.value);
      return !texto || texto.split(/\s+/).every((p) => (el.dataset.texto ?? '').includes(p));
    };

    let primera = true;
    const aplicar = () => {
      const visibles = new Set(fichas.filter((el) => cumple(el)));
      let i = 0;
      for (const el of fichas) {
        const ver = visibles.has(el);
        if (ver && el.hidden && !primera) {
          el.style.setProperty('--i', String(Math.min(i, 8)));
          el.classList.remove('entra');
          void el.offsetWidth;
          el.classList.add('entra');
        }
        if (ver) i++;
        el.hidden = !ver;
      }
      // Orden: por aplicación (con sus títulos), por velocidad o por nombre
      const o = orden.value;
      const lista = [...fichas];
      if (o === 'rapidas' || o === 'lentas') {
        const s = o === 'rapidas' ? -1 : 1;
        lista.sort((a, b) => {
          const ra = Number(a.dataset.rpm),
            rb = Number(b.dataset.rpm);
          if (!ra || !rb) return ra ? -1 : rb ? 1 : 0;
          return s * (ra - rb);
        });
      } else if (o === 'nombre') {
        lista.sort((a, b) =>
          (a.dataset.nombre ?? '').localeCompare(b.dataset.nombre ?? '', document.documentElement.lang),
        );
      }
      lista.forEach((el, n) => (el.style.order = o ? String(n) : ''));
      for (const ti of titulos) {
        ti.hidden = !!o || !fichas.some((el) => visibles.has(el) && el.dataset.cat === ti.dataset.cat);
      }
      // Pestañas y botones: cuántos quedarían; los que dejarían cero, apagados
      for (const p of pestanas) {
        const c = p.dataset.c ?? '';
        const n = fichas.filter((el) => cumple(el, { c })).length;
        p.setAttribute('aria-pressed', String(c === cat));
        p.disabled = c !== cat && n === 0;
        p.querySelector('.n')!.textContent = String(n);
      }
      for (const ch of chips) {
        const k = ch.dataset.f as 't' | 'p',
          v = ch.dataset.v!;
        const n = fichas.filter((el) => cumple(el, { f: k, v })).length;
        const activo = estado[k].has(v);
        ch.setAttribute('aria-pressed', String(activo));
        ch.disabled = !activo && n === 0;
        ch.querySelector('.n')!.textContent = String(n);
      }
      const extra = estado.t.size + estado.p.size + (q.value.trim() ? 1 : 0) + (o ? 1 : 0);
      activos.hidden = !extra;
      activos.textContent = String(extra);
      const hay = !!cat || extra > 0;
      for (const b of limpiar) if (!b.closest('.vacio')) b.hidden = !hay;
      totalEl.textContent = total(visibles.size);
      vacio.hidden = visibles.size > 0;
      // La búsqueda queda en la dirección para poder compartirla
      const url = new URL(location.href);
      const poner = (k: string, v: string) => (v ? url.searchParams.set(k, v) : url.searchParams.delete(k));
      poner('c', cat);
      poner('t', [...estado.t].join(','));
      poner('p', [...estado.p].join(','));
      poner('q', q.value.trim());
      poner('o', o);
      history.replaceState(null, '', url);
      primera = false;
    };

    // Estado inicial desde la dirección
    const url = new URL(location.href);
    cat = url.searchParams.get('c') ?? '';
    for (const k of ['t', 'p'] as const) {
      for (const v of url.searchParams.get(k)?.split(',') ?? []) if (v) estado[k].add(v);
    }
    q.value = url.searchParams.get('q') ?? '';
    orden.value = url.searchParams.get('o') ?? '';
    // Si se llega a una ficha concreta (lupa, Tecnología), se ve todo para que esté
    if (location.hash && document.getElementById(location.hash.slice(1))?.classList.contains('ficha')) {
      cat = '';
      estado.t.clear();
      estado.p.clear();
      q.value = '';
    }
    if (estado.t.size || estado.p.size || q.value || orden.value) {
      panel.hidden = false;
      mas.setAttribute('aria-expanded', 'true');
    }

    // Al cambiar de pestaña, la rejilla sube bajo la barra para ver el resultado desde arriba
    const subir = () => {
      const y = rejilla.getBoundingClientRect().top + window.scrollY - form.offsetHeight - 110;
      if (window.scrollY > y) window.scrollTo({ top: y, behavior: 'smooth' });
    };
    for (const p of pestanas) {
      p.addEventListener('click', () => {
        cat = p.dataset.c ?? '';
        aplicar();
        subir();
      });
    }
    for (const ch of chips) {
      ch.addEventListener('click', () => {
        const k = ch.dataset.f as 't' | 'p',
          v = ch.dataset.v!;
        if (estado[k].has(v)) estado[k].delete(v);
        else estado[k].add(v);
        aplicar();
      });
    }
    mas.addEventListener('click', () => {
      const abrir = panel.hidden;
      panel.hidden = !abrir;
      mas.setAttribute('aria-expanded', String(abrir));
      if (abrir) q.focus({ preventScroll: true });
    });
    let espera = 0;
    q.addEventListener('input', () => {
      clearTimeout(espera);
      espera = window.setTimeout(aplicar, 120);
    });
    orden.addEventListener('change', aplicar);
    form.addEventListener('submit', (e) => e.preventDefault());
    for (const b of limpiar) {
      b.addEventListener('click', () => {
        cat = '';
        estado.t.clear();
        estado.p.clear();
        q.value = '';
        orden.value = '';
        aplicar();
      });
    }
    aplicar();
  }
</script>

<style>
  /* Lo que el filtro oculta, oculto aunque tenga su propio display */
  .pagina [hidden] {
    display: none !important;
  }
  /* Toda la página en el oscuro de la portada */
  .pagina {
    --fondo: #111315;
    --cristal: rgba(255, 255, 255, 0.045);
    --filo: rgba(255, 255, 255, 0.1);
    --texto: rgba(255, 255, 255, 0.72);
    --tenue: rgba(255, 255, 255, 0.5);
    background: var(--fondo);
    color: #fff;
  }

  /* ——— Cabecera ——— */
  .cab {
    padding-block: clamp(56px, 8vw, 104px) clamp(36px, 4vw, 56px);
    border-bottom: 1px solid var(--filo);
  }
  h1 {
    font-size: var(--t-titulo);
    font-weight: 300;
    line-height: 0.94;
    letter-spacing: -0.015em;
  }
  /* "productos" en el rojo de la marca, como "ción" en la portada */
  h1 b {
    display: block;
    font-weight: 700;
    color: var(--red);
  }
  .lead {
    margin-top: 22px;
    max-width: 48ch;
    font-size: var(--t-sub);
    color: var(--texto);
  }
  .cifras {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cifras li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 18px;
    border: 1px solid var(--filo);
    background: var(--cristal);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    font-size: 16px;
    color: var(--texto);
  }
  .cifras b {
    font-size: 30px;
    line-height: 1;
    color: #fff;
  }

  /* ——— Barra fija de cristal con las pestañas ——— */
  .barra {
    position: sticky;
    top: 0;
    z-index: 15;
    background: rgba(17, 19, 21, 0.78);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
    border-bottom: 1px solid var(--filo);
    transition: top 0.35s var(--ease);
