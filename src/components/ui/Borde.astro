---
// Borde de neón de las tarjetas: al aparecer, una chispa de luz recorre el borde y lo va encendiendo en rojo; da
// una segunda vuelta por encima y se apaga, y el neón se queda encendido respirando (brilla y baja, sin apagarse).
// Cada tarjeta arranca por un lado y con un retraso distinto para que dos chispas no coincidan en el borde que
// comparten. La tarjeta tiene que ser position: relative y recibir la clase "vista" al verse.
interface Props {
  lado: 'arriba' | 'derecha' | 'abajo' | 'izquierda';
  retraso?: number;
}
const { lado, retraso = 0 } = Astro.props;
---

<svg class="borde" data-lado={lado} style={`--retraso: ${retraso}s`} aria-hidden="true">
  <g class="neon">
    <rect width="100%" height="100%" pathLength="100"></rect>
  </g>
  <rect class="halo" width="100%" height="100%" pathLength="100"></rect>
  <rect class="chispa" width="100%" height="100%" pathLength="100"></rect>
</svg>

<script>
  // Dónde empieza: el centro del lado elegido, en % del perímetro (el rectángulo se recorre desde la esquina de
  // arriba a la izquierda en el sentido de las agujas del reloj)
  const colocar = () => {
    document.querySelectorAll<SVGSVGElement>('svg.borde').forEach((s) => {
      const { width: w, height: h } = s.getBoundingClientRect();
      if (!w) return;
      const pos = { arriba: w / 2, derecha: w + h / 2, abajo: w + h + w / 2, izquierda: 2 * w + h + h / 2 };
      const o = ((pos[s.dataset.lado as keyof typeof pos] ?? 0) / (2 * (w + h))) * 100;
      s.style.setProperty('--o', String(-o));
      // La chispa va justo delante del neón que se enciende
      s.querySelectorAll<SVGRectElement>('.halo, .chispa').forEach((r) => {
        const largo = r.classList.contains('halo') ? 5 : 1.2;
        r.style.setProperty('--ini', String(-(o - largo)));
        r.style.setProperty('--fin', String(-(o - largo) - 200));
      });
    });
  };
  colocar();
  addEventListener('resize', colocar, { passive: true });
</script>

<style>
  .borde {
    --vuelta: 1.8s;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 2;
  }
  rect {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .neon rect {
    stroke: #ff1a20;
    stroke-width: 2;
    stroke-dasharray: 0 100;
    stroke-dashoffset: var(--o, 0);
    filter: drop-shadow(0 0 5px rgba(255, 30, 30, 0.8));
  }
  .halo,
  .chispa {
    opacity: 0;
  }
  .halo {
    stroke: rgba(255, 60, 60, 0.9);
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: 5 95;
    filter: blur(4px);
  }
  .chispa {
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1.2 98.8;
    filter: drop-shadow(0 0 4px #fff) drop-shadow(0 0 8px #ff3b3b);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* 1ª vuelta: la chispa enciende el neón. 2ª: corre por encima y se apaga. Después, el neón respira */
    :global(.vista) > .borde .neon rect {
      animation: enciende var(--vuelta) linear var(--retraso) both;
    }
    :global(.vista) > .borde :is(.halo, .chispa) {
      animation:
        corre calc(var(--vuelta) * 2) linear var(--retraso) both,
        chispa calc(var(--vuelta) * 2) linear var(--retraso) both;
    }
    :global(.vista) > .borde .neon {
      animation: respira 2.8s ease-in-out calc(var(--retraso) + var(--vuelta) * 2) infinite alternate;
    }
  }
  /* Sin animaciones, el neón se ve encendido y quieto */
  @media (prefers-reduced-motion: reduce) {
    .neon rect {
      stroke-dasharray: 100 0;
      opacity: 0.6;
    }
  }

  @keyframes enciende {
    to {
      stroke-dasharray: 100 0;
    }
  }
  @keyframes corre {
    from {
      stroke-dashoffset: var(--ini);
    }
    to {
      stroke-dashoffset: var(--fin);
    }
  }
  @keyframes chispa {
    0%,
    100% {
      opacity: 0;
    }
    4%,
    88% {
      opacity: 1;
    }
  }
  @keyframes respira {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.35;
    }
  }
</style>
