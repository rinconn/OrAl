---
// Raya roja que da dos vueltas al borde de una tarjeta cuando aparece, con un destello blanco en la punta. Al
// acabar no se apaga: su último tramo se queda quieto, más suave, respirando. El brillo es blanco para no
// confundirla con la raya roja entre secciones. Cada tarjeta arranca por un lado y con un retraso distinto para
// que dos rayas no coincidan en el borde que comparten. La tarjeta tiene que ser position: relative y recibir la
// clase "vista" al verse.
interface Props {
  lado: 'arriba' | 'derecha' | 'abajo' | 'izquierda';
  retraso?: number;
}
const { lado, retraso = 0 } = Astro.props;
---

<svg class="borde" data-lado={lado} style={`--retraso: ${retraso}s`} aria-hidden="true">
  <g class="tramo">
    <rect class="raya" width="100%" height="100%" pathLength="100"></rect>
    <rect class="punta" width="100%" height="100%" pathLength="100"></rect>
  </g>
</svg>

<script>
  // Dónde empieza (y acaba, tras dos vueltas): el centro del lado elegido, en % del perímetro (el rectángulo se
  // recorre desde la esquina de arriba a la izquierda en el sentido de las agujas del reloj)
  const colocar = () => {
    document.querySelectorAll<SVGSVGElement>('svg.borde').forEach((s) => {
      const { width: w, height: h } = s.getBoundingClientRect();
      if (!w) return;
      const pos = { arriba: w / 2, derecha: w + h / 2, abajo: w + h + w / 2, izquierda: 2 * w + h + h / 2 };
      const o = ((pos[s.dataset.lado as keyof typeof pos] ?? 0) / (2 * (w + h))) * 100;
      // La punta blanca va al final de la raya (16 de largo, punta de 2,5)
      s.querySelectorAll<SVGRectElement>('rect').forEach((r, i) => {
        const ini = -(o + (i ? 13.5 : 0));
        r.style.setProperty('--ini', String(ini));
        r.style.setProperty('--fin', String(ini - 200));
      });
    });
  };
  colocar();
  addEventListener('resize', colocar, { passive: true });
</script>

<style>
  .borde {
    --dura: 5.2s;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
  }
  rect {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .raya {
    stroke: #ff1a20;
    stroke-width: 2.5;
    stroke-dasharray: 16 84;
    stroke-dashoffset: var(--fin);
    filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.55));
  }
  .punta {
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 2.5 97.5;
    stroke-dashoffset: var(--fin);
    filter: drop-shadow(0 0 4px #fff) drop-shadow(0 0 10px rgba(255, 255, 255, 0.8));
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.vista) > .borde {
      animation: borde-aparece 0.4s linear var(--retraso) both;
    }
    :global(.vista) > .borde rect {
      animation: borde-da cubic-bezier(0.45, 0.05, 0.4, 1) var(--dura) var(--retraso) both;
    }
    /* Al acabar las dos vueltas, el tramo baja de intensidad y se queda respirando */
    :global(.vista) > .borde .tramo {
      animation:
        borde-reposa 0.9s ease-out calc(var(--retraso) + var(--dura)) both,
        borde-respira 2.6s ease-in-out calc(var(--retraso) + var(--dura) + 0.9s) infinite alternate;
    }
  }
  /* Sin animaciones, el tramo se ve quieto en su sitio */
  @media (prefers-reduced-motion: reduce) {
    .borde {
      opacity: 0.6;
    }
  }

  @keyframes borde-aparece {
    to {
      opacity: 1;
    }
  }
  /* Dos vueltas */
  @keyframes borde-da {
    from {
      stroke-dashoffset: var(--ini);
    }
    to {
      stroke-dashoffset: var(--fin);
    }
  }
  @keyframes borde-reposa {
    to {
      opacity: 0.6;
    }
  }
  @keyframes borde-respira {
    from {
      opacity: 0.6;
    }
    to {
      opacity: 0.25;
    }
  }
</style>
