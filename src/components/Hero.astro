---
// Portada: un rotor girando a toda velocidad, con estelas rojas y el buje nítido, a pantalla completa (foto de Orto Alresa), con el titular, quiénes sois, los dos caminos
// (producto y distribuidor) encima. Al cargar, la foto se aclara y se asienta despacio; nada sigue al ratón.
import { idioma, ruta, textos } from '../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang).hero;
---

<section class="hero" data-hero>
  <div class="fondo" aria-hidden="true">
    <img
      class="foto"
      src="/img/fotos/portada-rotor.webp"
      srcset="/img/fotos/portada-rotor-960.webp 960w, /img/fotos/portada-rotor.webp 1440w"
      sizes="100vw"
      alt=""
      width="1440"
      height="960"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="wrap contenido">
    <div class="texto">
      <h1>
        {t.titulo[0]}
        <b>
          {t.titulo[1]}
          <i>{t.titulo[2]}</i>
        </b>
      </h1>
      <p class="lead">{t.lead}</p>
      <div class="ctas">
        <a class="btn red rel" href={ruta(lang, '/centrifugas/')}>
          {t.gama}
        </a>
        <a class="btn ghost rel" href="#distribuidores">
          {t.distribuidor}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #111315;
    color: #fff;
    isolation: isolate;
  }

  /* Fondo: el rotor desde arriba; el buje y los tubos quedan a la derecha y el texto va sobre los guantes de la izquierda */
  .fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 45%;
    transform-origin: 66% 47%;
  }
  /* Velo oscuro donde va el texto, para que se lea; el buje y la derecha quedan limpios */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(10, 11, 12, 0.88) 0%, rgba(10, 11, 12, 0.66) 38%, rgba(10, 11, 12, 0.08) 72%),
      linear-gradient(0deg, rgba(10, 11, 12, 0.7) 0%, rgba(10, 11, 12, 0) 34%);
  }

  .contenido {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: min(calc(100svh - 76px), 880px);
    padding-block: clamp(64px, 11vh, 120px) clamp(32px, 5vh, 48px);
  }
  h1 {
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.94;
  }
  h1 b {
    display: block;
  }
  h1 i {
    font-style: normal;
    color: var(--red);
  }
  .lead {
    margin-top: clamp(22px, 3vh, 32px);
    font-size: var(--t-sub);
    max-width: 36ch;
    color: rgba(255, 255, 255, 0.84);
  }

  /* Botones: el rojo es el de las tarjetas (global.css, `.rel`); al pasar el ratón la » avanza; el blanco se rellena de izquierda a derecha */
  .ctas {
    margin-top: clamp(28px, 4vh, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ctas .btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition:
      color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      background-color 0.35s var(--ease),
      translate 0.25s ease,
      box-shadow 0.35s var(--ease);
  }
  .ctas .btn::after {
    content: '»';
    transition: transform 0.35s var(--ease);
  }
  .ctas .btn.ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.06);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .ctas .btn.ghost::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }

  /* Los efectos al pasar el ratón, solo con ratón: en el móvil un toque no deja el botón encendido */
  @media (hover: hover) {
    .ctas .btn:hover::after {
      transform: translateX(6px);
    }
    .ctas .btn.ghost:hover {
      color: var(--ink);
      border-color: #fff;
      background: transparent;
    }
    .ctas .btn.ghost:hover::before {
      transform: scaleX(1);
    }
  }
  /* Entrada: la foto se aclara y se asienta despacio, sin sacudidas; el texto se descubre línea a línea desde abajo */
  @media (prefers-reduced-motion: no-preference) {
    .foto {
      animation: asienta 2.4s cubic-bezier(0.22, 0.7, 0.2, 1) both;
    }
    .texto > * {
      animation: sube 0.9s var(--ease) both;
    }
    h1 {
      animation-name: descubre;
    }
    .texto > :nth-child(2) {
      animation-delay: 0.25s;
    }
    .texto > :nth-child(3) {
      animation-delay: 0.38s;
    }
  }
  @keyframes asienta {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    25% {
      opacity: 1;
    }
  }
  @keyframes descubre {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(24px);
    }
    to {
      clip-path: inset(0 0 -10% 0);
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* Móvil: la foto ocupa la mitad de arriba, con el buje a la vista, y se funde con el fondo oscuro del texto */
  @media (max-width: 1024px) {
    .foto {
      inset: 0;
      width: 100%;
      height: 58%;
      object-position: 82% 50%;
    }
    .hero::before {
      background: linear-gradient(0deg, #111315 0%, #111315 44%, rgba(17, 19, 21, 0.5) 54%, rgba(17, 19, 21, 0) 74%);
    }
    .contenido {
      min-height: calc(100svh - 60px);
      justify-content: flex-end;
      padding-block: 46svh 32px;
    }
  }
</style>
