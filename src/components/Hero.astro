---
// Portada: qué hacéis (centrífugas de laboratorio), por qué fiarse y dos caminos claros, en la primera pantalla.
// La Digicen 22 es la protagonista y su hueco es el del futuro modelo 3D: el visor ocupará este mismo sitio.
import { cifras } from '../data/cifras';

// Ficha corta del equipo de la foto. Catálogo General 2025, Serie Digicen 22 (pág. 52).
const equipo = {
  nombre: 'Digicen 22',
  datos: [
    { valor: '16.500', unidad: 'rpm' },
    { valor: '26.480', unidad: '× g' },
    { valor: '4 × 125', unidad: 'ml' },
  ],
};
---

<section class="hero">
  <div class="wrap grid">
    <div class="texto">
      <p class="eyebrow">Centrifugación de laboratorio · Desde 1949</p>
      <h1>
        <span>Expertos en</span>
        <b>
          Centrifuga<i>ción</i>
        </b>
      </h1>
      <p class="lead">
        Centrífugas diseñadas y fabricadas para ofrecer precisión, fiabilidad y rendimiento en los entornos de
        laboratorio más exigentes.
      </p>
      <div class="ctas">
        <a class="btn red" href="#gama">
          Ver la gama
        </a>
        <a class="btn ghost" href="#distribuidores">
          Soy distribuidor
        </a>
      </div>
      <dl class="cifras">
        {cifras.map((c) => (
          <div>
            <dt>{c.valor}</dt>
            <dd>{c.texto}</dd>
          </div>
        ))}
      </dl>
      <p class="why">
        <b>Antes:</b> la máquina recortada sobre un recuadro oscuro con retícula y notas técnicas encima.
        <b>Ahora:</b> la Digicen 22 en grande sobre un plano gris claro, saliendo por encima de él, con sus tres cifras
        técnicas como en una ficha de catálogo. El titular dice en una palabra qué hacéis.
      </p>
    </div>

    <div class="producto">
      <figure>
        <img
          src="/img/productos/digicen-22.webp"
          alt="Centrífuga Digicen 22 con la tapa abierta y el rotor a la vista"
          width="1400"
          height="1830"
          fetchpriority="high"
        />
      </figure>
      <a class="ficha" href="#gama">
        <span class="nombre">
          <b>{equipo.nombre}</b>
          <span class="arrow">Ver en la gama</span>
        </span>
        <dl>
          {equipo.datos.map((d, i) => (
            <div style={`--i:${i}`}>
              <dt>{d.valor}</dt>
              <dd>{d.unidad}</dd>
            </div>
          ))}
        </dl>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Alto de la franja de la ficha, al pie del plano gris */
    --ficha: 132px;
    /* Cuánto sobresale la máquina por encima del plano gris */
    --sale: 72px;
    --alto: min(calc(100svh - 96px), 960px);
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  /* Asimétrica: el texto se lleva algo más de la mitad y la máquina el resto, hasta el borde de la pantalla */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.74fr);
    min-height: var(--alto);
  }

  /* ---------- Texto ---------- */
  .texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: clamp(40px, 7vh, 80px);
    padding-right: clamp(24px, 3vw, 56px);
    container-type: inline-size;
  }
  /* El bloque principal queda centrado en el hueco que hay sobre las cifras */
  .eyebrow {
    margin: auto 0 0;
    color: var(--body);
  }
  h1 {
    margin-top: clamp(18px, 2.6vh, 28px);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.88;
    letter-spacing: -0.01em;
  }
  h1 span {
    display: block;
    font-weight: 300;
    /* "Expertos en" más pequeño para que "centrifugación" sea la palabra que manda */
    font-size: min(8.4cqi, 7.2vh, 72px);
    letter-spacing: 0;
  }
  h1 b {
    display: block;
    /* La palabra llena el ancho de la columna, sin pasarse en pantallas bajas */
    font-size: min(14.2cqi, 15vh, 148px);
  }
  h1 i {
    font-style: normal;
    color: var(--red);
  }
  .lead {
    margin-top: clamp(20px, 3vh, 32px);
    font-size: var(--t-sub);
    line-height: 1.45;
    max-width: 36ch;
    color: var(--body);
  }
  .ctas {
    margin: clamp(24px, 3.6vh, 36px) 0 clamp(32px, 6vh, 64px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ctas .btn {
    font-size: 17px;
    padding: 16px 26px;
  }
  .ctas .btn::after {
    content: '»';
    color: var(--red);
    transition: transform 0.25s var(--ease);
  }
  .ctas .btn.red::after {
    color: #fff;
  }
  .ctas .btn:hover::after {
    transform: translateX(5px);
  }

  /* Las cuatro cifras de confianza, discretas, a la altura de la ficha de la máquina */
  .cifras {
    margin: auto 0 0;
    width: 100%;
    height: var(--ficha);
    display: flex;
    align-items: center;
    border-top: 1px solid var(--line);
  }
  .cifras div {
    padding: 0 clamp(14px, 1.8vw, 28px);
    border-left: 1px solid var(--line);
  }
  .cifras div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .cifras dt {
    font-weight: 700;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.1;
    white-space: nowrap;
  }
  .cifras dd {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--muted);
    white-space: nowrap;
  }
  /* ---------- Producto ---------- */
  .producto {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Llega hasta el borde derecho de la pantalla */
    margin-right: calc(-1 * (var(--gut) + max(0px, (100vw - var(--wrap)) / 2)));
  }
  /* Plano gris claro: empieza por debajo de la tapa, así la máquina sobresale por arriba */
  .producto::before {
    content: '';
    position: absolute;
    inset: calc(var(--sale) + clamp(24px, 4vh, 40px)) 0 0 0;
    background: var(--panel);
  }
  figure {
    position: relative;
    margin: 0;
    padding-left: clamp(24px, 3vw, 56px);
    /* Tan grande como quepa entre el borde de arriba y la ficha */
    width: min(100%, calc((var(--alto) - var(--ficha) - clamp(16px, 3vh, 32px)) * 1400 / 1830));
    transition: transform 0.5s var(--ease);
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Sombra de contacto: la máquina se apoya en el suelo, no flota */
  figure::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 22%;
    right: 6%;
    bottom: 2px;
    height: 16px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.32);
    filter: blur(9px);
  }
  .producto:hover figure {
    transform: translateY(-4px);
  }

  /* Ficha técnica: nombre y tres cifras grandes, como en el catálogo */
  .ficha {
    position: relative;
    height: var(--ficha);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding-left: clamp(24px, 3vw, 56px);
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .nombre {
    display: flex;
    gap: 20px;
    align-items: baseline;
  }
  .nombre b {
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .nombre .arrow {
    position: relative;
    align-self: flex-start;
    padding-bottom: 3px;
    font-size: 15px;
    white-space: nowrap;
  }
  .nombre .arrow::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--red);
    transition: width 0.3s var(--ease);
  }
  .ficha:hover .arrow::before,
  .ficha:focus-visible .arrow::before {
    width: calc(100% - 14px);
  }
  .ficha dl {
    margin: 0;
    display: flex;
    gap: clamp(12px, 1.6vw, 32px);
  }
  .ficha dl div {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding-left: clamp(14px, 1.4vw, 20px);
    border-left: 2px solid var(--red);
  }
  .ficha dt {
    font-weight: 700;
    font-size: clamp(22px, 2.2vw, 36px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ficha dd {
    margin: 0;
    font-size: 16px;
    white-space: nowrap;
    color: var(--muted);
  }

  /* Portátiles estrechos: la ficha se apila (nombre arriba, cifras debajo) para que quepa */
  @media (max-width: 1220px) {
    .hero {
      --alto: min(calc(100svh - 72px), 960px);
    }
  }

  /* ---------- Tableta y móvil: una columna ---------- */
  @media (max-width: 1024px) {
    /* El texto se "deshace" para poder colocar la máquina entre los botones y las cifras */
    .grid {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-height: 0;
      padding-top: clamp(32px, 5vh, 56px);
    }
    .texto {
      display: contents;
    }
    .eyebrow {
      margin: 0;
      font-size: 12px;
      letter-spacing: 0.1em;
    }
    .ctas {
      margin-bottom: 0;
    }
    h1 span {
      font-size: min(8.4cqi, 56px);
    }
    h1 b {
      font-size: min(13.6cqi, 112px);
    }
    .producto {
      order: 1;
      align-self: stretch;
      margin: clamp(32px, 6vw, 56px) calc(-1 * var(--gut)) 0;
      align-items: center;
    }
    .cifras {
      order: 2;
      margin: 0;
      height: auto;
      padding: 24px 0 32px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px 16px;
      border: 0;
    }
    .cifras div,
    .cifras div:first-child {
      padding: 8px 0 0;
      border-left: 0;
      border-top: 2px solid var(--ink);
    }
    .texto > .why {
      order: 3;
    }
    .producto::before {
      inset: calc(var(--sale) + 8px) 0 0 0;
    }
    figure {
      width: min(calc(100% - 2 * var(--gut)), 420px);
      padding: 0;
    }
    .ficha {
      align-self: stretch;
      height: auto;
      padding: 20px var(--gut) 28px;
    }
    .ficha dl div {
      padding-left: 10px;
      gap: 4px;
    }
    .ficha dd {
      font-size: 14px;
    }
  }

  /* Entrada al cargar: el texto sube por partes, la máquina aparece y las cifras de la ficha
     llegan una a una. Discreta, y solo si el sistema no pide menos movimiento. */
  @media (prefers-reduced-motion: no-preference) {
    .texto > * {
      animation: sube 0.7s var(--ease) both;
    }
    .texto > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .texto > :nth-child(3) {
      animation-delay: 0.16s;
    }
    .texto > :nth-child(4) {
      animation-delay: 0.24s;
    }
    .texto > :nth-child(5) {
      animation-delay: 0.32s;
    }
    figure img {
      animation: entra 1.1s var(--ease) 0.1s both;
    }
    .nombre {
      animation: sube 0.6s var(--ease) 0.5s both;
    }
    .ficha dl div {
      animation: sube 0.6s var(--ease) calc(0.6s + var(--i) * 0.1s) both;
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
