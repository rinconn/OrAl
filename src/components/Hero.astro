---
// Portada: una sola composición. La foto de la fábrica, grande, sale por la derecha y por abajo;
// el final del titular la pisa por delante, sobre el cielo. Solo marca y dos caminos.
---

<section class="hero">
  <figure class="foto">
    <img
      src="/img/empresa/fabrica-daganzo.webp"
      srcset="/img/empresa/fabrica-daganzo.webp 900w, /img/empresa/fabrica-daganzo-1900.webp 1900w"
      sizes="(max-width: 1024px) 100vw, 90vw"
      alt="Fábrica de Orto Alresa en Daganzo (Madrid)"
      width="1900"
      height="1266"
      fetchpriority="high"
    />
    <figcaption>Nuestra fábrica · Daganzo, Madrid</figcaption>
  </figure>

  <div class="wrap lienzo">
    <p class="eyebrow">Centrifugación de laboratorio · Desde 1949</p>

    <h1 aria-label="Expertos en centrifugación">
      <span class="ligera" aria-hidden="true">
        Expertos en
      </span>
      <span class="grande" aria-hidden="true">
        centrifu
      </span>
      <span class="grande" aria-hidden="true">
        ga<i>ción</i>
      </span>
    </h1>

    <div class="pie">
      <p class="lead">
        Centrífugas diseñadas y fabricadas para ofrecer precisión, fiabilidad y rendimiento en los entornos de
        laboratorio más exigentes.
      </p>
      <div class="ctas">
        <a class="cta principal" href="#gama">
          Ver la gama
        </a>
        <a class="cta" href="#distribuidores">
          Soy distribuidor
        </a>
      </div>
    </div>

    <p class="why">
      <b>Antes:</b> texto a un lado y la máquina dentro de un recuadro al otro, con cifras en fila como un catálogo.
      <b>Ahora:</b> una sola composición: la fábrica de Daganzo en grande y el titular por delante. Solo marca y dos
      caminos.
    </p>
  </div>
</section>

<style>
  .hero {
    --alto: clamp(560px, calc(100svh - 96px), 980px);
    position: relative;
    min-height: var(--alto);
    overflow: hidden;
    background: #fff;
    isolation: isolate;
  }

  /* La fábrica: foto grande que llega al borde derecho y al pie, sin marco. Empieza antes de la
     mitad, así el final del titular queda encima, sobre el cielo de la foto. */
  .foto {
    position: absolute;
    z-index: 0;
    margin: 0;
    left: 40%;
    right: 0;
    top: 22%;
    bottom: 0;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
  }
  .foto figcaption {
    position: absolute;
    right: var(--gut);
    bottom: 100%;
    padding-bottom: 12px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink);
  }

  .lienzo {
    position: relative;
    z-index: 1;
    min-height: var(--alto);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    padding-block: clamp(32px, 6vh, 64px);
  }

  .eyebrow {
    margin: 0;
    color: var(--body);
  }

  /* Titular: "Expertos en" pequeño y ligero; "centrifugación" partida en dos líneas enormes que
     pisan la máquina por delante */
  h1 {
    margin-top: clamp(16px, 3vh, 32px);
    line-height: 0.8;
  }
  h1 span {
    display: block;
  }
  .ligera {
    font-weight: 300;
    font-size: clamp(28px, 2.8vw, 44px);
    line-height: 1;
    margin-bottom: 0.25em;
    padding-left: 0.08em;
  }
  .grande {
    font-weight: 700;
    font-size: min(12.4vw, 21vh, 190px);
    letter-spacing: -0.035em;
  }
  /* La segunda línea entra un poco: rompe la columna */
  .grande + .grande {
    padding-left: 0.62em;
  }
  h1 i {
    font-style: normal;
    color: var(--red);
  }

  .pie {
    grid-row: 4;
    max-width: 380px;
  }
  .lead {
    margin: 0;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.5;
    color: var(--body);
  }
  .ctas {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
  }
  /* Botones: uno rojo, alto y limpio; el otro solo texto con raya que crece al pasar el ratón */
  .cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--ink);
    padding-block: 6px;
  }
  .cta::after {
    content: '→';
    font-weight: 300;
    transition: transform 0.3s var(--ease);
  }
  .cta:not(.principal)::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(0.35);
    transition: transform 0.35s var(--ease);
  }
  .cta:not(.principal):hover::before,
  .cta:not(.principal):focus-visible::before {
    transform: scaleX(1);
  }
  .principal {
    background: var(--red);
    color: #fff;
    padding: 18px 28px;
    transition: background 0.2s var(--ease);
  }
  .principal:hover {
    background: var(--red-d);
  }
  .cta:hover::after,
  .cta:focus-visible::after {
    transform: translateX(6px);
  }

  .why {
    position: absolute;
    left: var(--gut);
    bottom: 8px;
    margin: 0;
  }

  /* Portátiles estrechos: la foto empieza algo más a la derecha para no tapar el titular */
  @media (min-width: 1025px) and (max-width: 1279px) {
    .foto {
      left: 46%;
    }
  }

  /* Tableta y móvil: eyebrow, titular, frase y botones; debajo la fábrica a todo el ancho */
  @media (max-width: 1024px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding-top: clamp(28px, 5vw, 48px);
    }
    .lienzo {
      display: contents;
    }
    .lienzo > * {
      padding-inline: var(--gut);
    }
    .eyebrow {
      font-size: 12px;
      letter-spacing: 0.08em;
    }
    .grande {
      font-size: min(23vw, 190px);
    }
    .pie {
      margin-top: 28px;
      max-width: calc(520px + 2 * var(--gut));
    }
    .foto {
      order: 1;
      position: relative;
      inset: auto;
      margin-top: 40px;
    }
    .foto img {
      height: auto;
      aspect-ratio: 4 / 3;
      object-position: 30% 0;
    }
    .foto figcaption {
      position: static;
      padding: 12px var(--gut) 32px;
      font-size: 12px;
    }
    .why {
      order: 3;
      position: static;
      margin: 0 var(--gut) 24px;
      padding: 14px 18px;
    }
  }

  /* Entrada: el titular sube por líneas y la foto aparece subiendo despacio */
  @media (prefers-reduced-motion: no-preference) {
    .eyebrow,
    h1 span,
    .pie {
      animation: sube 0.8s var(--ease) both;
    }
    h1 span:nth-child(1) {
      animation-delay: 0.08s;
    }
    h1 span:nth-child(2) {
      animation-delay: 0.16s;
    }
    h1 span:nth-child(3) {
      animation-delay: 0.24s;
    }
    .pie {
      animation-delay: 0.4s;
    }
    .foto {
      animation: entra 1.4s var(--ease) 0.1s both;
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }
</style>
