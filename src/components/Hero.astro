---
// Portada: una foto real de laboratorio a pantalla completa, con el titular, quiénes sois, los dos caminos
// (producto y distribuidor) y las cuatro razones para fiarse encima. La foto es de la propia empresa (lab-114).
import { cifras } from '../data/cifras';
---

<section class="hero">
  <img
    class="foto"
    src="/img/fotos/portada-laboratorio.webp"
    srcset="/img/fotos/portada-laboratorio-1200.webp 1200w, /img/fotos/portada-laboratorio.webp 2400w"
    sizes="100vw"
    alt=""
    width="2400"
    height="1600"
    fetchpriority="high"
    decoding="async"
  />

  <div class="wrap contenido">
    <div class="texto">
      <h1>
        Expertos en{' '}
        <b>
          centrifuga<i>ción</i>
        </b>
      </h1>
      <p class="lead">
        Desde 1949 diseñamos y fabricamos centrífugas de laboratorio en Daganzo (Madrid) y las llevamos a todo el mundo
        a través de una red de distribuidores especializados.
      </p>
      <div class="ctas">
        <a class="btn red" href="#gama">
          Ver la gama
        </a>
        <a class="btn ghost" href="#distribuidores">
          Soy distribuidor
        </a>
      </div>
    </div>

    <ul class="cifras">
      {cifras.map((c) => (
        <li>
          <b>{c.valor}</b>
          {c.texto}
        </li>
      ))}
    </ul>

    <p class="why">
      <b>Antes:</b> un carrusel de 7 novedades, con el titular cortado bajo el menú. <b>Ahora:</b> una sola foto real de
      laboratorio a pantalla completa, con el titular, los dos caminos y las cuatro razones para fiarse encima. Sin
      cajas ni recortes: entra por la vista y se entiende en un segundo.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #1d2124;
    color: #fff;
    isolation: isolate;
  }
  /* La foto ocupa toda la portada; la mano y la máquina quedan a la derecha, el texto sobre la zona desenfocada */
  .foto {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }
  /* Velo oscuro solo donde va el texto, para que se lea; la parte de la mano queda casi limpia */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(14, 16, 18, 0.82) 0%, rgba(14, 16, 18, 0.62) 42%, rgba(14, 16, 18, 0.12) 78%),
      linear-gradient(0deg, rgba(14, 16, 18, 0.6) 0%, rgba(14, 16, 18, 0) 32%);
  }

  .contenido {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: min(calc(100svh - 96px), 880px);
    padding-block: clamp(64px, 11vh, 120px) clamp(32px, 5vh, 48px);
  }
  h1 {
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.94;
  }
  h1 b {
    display: block;
  }
  h1 i {
    font-style: normal;
    color: var(--red);
  }
  .lead {
    margin-top: clamp(22px, 3vh, 32px);
    font-size: var(--t-sub);
    max-width: 36ch;
    color: rgba(255, 255, 255, 0.86);
  }
  .ctas {
    margin-top: clamp(28px, 4vh, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ctas .btn::after {
    content: '»';
    transition: transform 0.25s var(--ease);
  }
  .ctas .btn:hover::after {
    transform: translateX(5px);
  }
  .ctas .btn.ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
  }
  .ctas .btn.ghost:hover {
    background: #fff;
    border-color: #fff;
    color: var(--ink);
  }

  /* Las cuatro razones al pie, sobre una línea fina */
  .cifras {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    margin: 48px 0 0;
    padding: 24px 0 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 15px;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.72);
  }
  .cifras li {
    display: flex;
    flex-direction: column;
    padding: 0 clamp(20px, 3vw, 48px);
    border-left: 1px solid rgba(255, 255, 255, 0.22);
  }
  .cifras li:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .cifras b {
    font-size: clamp(20px, 1.8vw, 28px);
    color: #fff;
    white-space: nowrap;
  }

  /* Entrada al cargar: la foto se asienta despacio y el texto sube por partes */
  @media (prefers-reduced-motion: no-preference) {
    .foto {
      animation: asienta 2.2s var(--ease) both;
    }
    .texto > *,
    .cifras {
      animation: sube 0.8s var(--ease) both;
    }
    .texto > :nth-child(2) {
      animation-delay: 0.1s;
    }
    .texto > :nth-child(3) {
      animation-delay: 0.2s;
    }
    .cifras {
      animation-delay: 0.35s;
    }
  }
  @keyframes asienta {
    from {
      transform: scale(1.06);
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* Móvil: la mano queda arriba, a la vista, y el texto abajo sobre el velo */
  @media (max-width: 1024px) {
    /* La foto ocupa la mitad de arriba, con la mano a la vista, y se funde con el fondo oscuro del texto */
    .foto {
      height: 60%;
      object-position: 82% 50%;
    }
    .hero::before {
      background: linear-gradient(0deg, #1d2124 0%, #1d2124 42%, rgba(29, 33, 36, 0.55) 52%, rgba(29, 33, 36, 0) 75%);
    }
    .contenido {
      min-height: calc(100svh - 72px);
      justify-content: flex-end;
      padding-block: 46svh 32px;
    }
    .cifras {
      grid-template-columns: 1fr 1fr;
      gap: 18px 0;
      margin-top: 36px;
    }
    .cifras li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
