---
// Portada como un cartel: "centrifugación" a todo el ancho y, delante, una centrífuga real que se va turnando con
// otras cuatro de la gama. Debajo, quiénes sois, los dos caminos (producto y distribuidor) y el selector de máquinas.
// La máquina es el hueco reservado al futuro modelo 3D de la Digicen 22: el visor ocupará su sitio.
import { cifras } from '../data/cifras';
import { productos } from '../data/productos';

// Una máquina por familia (dos en Clínica). Medidas de la tabla de versiones de cada serie, Catálogo General 2025:
// "alto" sirve para dibujarlas a escala entre sí (la más alta, Dilitcen 22 R, 430 mm, ocupa todo el alto).
const vitrina = [
  { slug: 'digicen-22', ancho: 410, alto: 320 },
  { slug: 'dilitcen-22-r', ancho: 720, alto: 430 },
  { slug: 'digtor-22-c', ancho: 530, alto: 420 },
  { slug: 'cyto-22', ancho: 410, alto: 320 },
  { slug: 'plasma-22', ancho: 270, alto: 270 },
].map((m) => {
  const p = productos.find((x) => x.slug === m.slug);
  if (!p) throw new Error(`Falta ${m.slug} en productos.ts`);
  return { ...m, nombre: p.nombre, rpm: p.rpm, xg: p.xg, capacidad: p.capacidad };
});
const MAS_ALTA = 430;
---

<section class="hero" data-vitrina>
  <div class="wrap cartel">
    <div class="escena">
      <h1>
        <span class="previo">Expertos en</span>
        <span class="palabra">
          centrifuga<i>ción</i>
        </span>
      </h1>

      <div class="maquinas" data-maquinas>
        {vitrina.map((m, i) => (
          <img
            class:list={['maquina', { on: i === 0 }]}
            src={`/img/productos/hero-${m.slug}.webp`}
            alt={`Centrífuga ${m.nombre}`}
            style={`--h:${m.alto / MAS_ALTA}`}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
            draggable="false"
            data-maquina
          />
        ))}
      </div>
    </div>

    <ul class="cifras">
      {cifras.map((c) => (
        <li>
          <b>{c.valor}</b>
          {c.texto}
        </li>
      ))}
    </ul>

    <div class="intro">
      <p class="lead">
        Desde 1949 diseñamos y fabricamos centrífugas de laboratorio en Daganzo (Madrid) y las llevamos a todo el mundo
        a través de una red de distribuidores especializados.
      </p>
      <div class="ctas">
        <a class="btn red" href="#gama">
          Ver la gama
        </a>
        <a class="btn ghost" href="#distribuidores">
          Soy distribuidor
        </a>
      </div>
    </div>

    <div class="equipo">
      <div class="fichas">
        {vitrina.map((m, i) => (
          <div
            class:list={['ficha', { on: i === 0 }]}
            id={`vitrina-${m.slug}`}
            role="tabpanel"
            aria-labelledby={`tab-${m.slug}`}
            data-panel
            inert={i !== 0}
          >
            <dl>
              <div>
                <dt>{m.rpm}</dt>
                <dd>rpm</dd>
              </div>
              <div>
                <dt>{m.xg}</dt>
                <dd>xg</dd>
              </div>
              <div>
                <dt>{m.capacidad}</dt>
                <dd>capacidad</dd>
              </div>
              <div>
                <dt>{m.ancho} mm</dt>
                <dd>de ancho</dd>
              </div>
            </dl>
            <a class="arrow" href={`#${m.slug}`}>
              Ver {m.nombre}
            </a>
          </div>
        ))}
      </div>

      <div class="selector" role="tablist" aria-label="Centrífugas de la gama">
        {vitrina.map((m, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${m.slug}`}
            aria-controls={`vitrina-${m.slug}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab
          >
            {m.nombre}
          </button>
        ))}
      </div>
    </div>

    <p class="why">
      <b>Antes:</b> un carrusel de 7 novedades, con el titular cortado bajo el menú. <b>Ahora:</b> una portada como un
      cartel: la palabra que os define a todo el ancho y, delante, cinco centrífugas reales de la gama que se turnan
      solas, a escala entre sí y con sus cifras del catálogo. El visitante puede elegir cuál ver.
    </p>
  </div>
</section>

<script>
  // Vitrina: cada máquina se queda unos segundos y pasa a la siguiente. La raya roja sobre su nombre marca el
  // tiempo; al acabar su animación (animationend) se cambia de máquina, así que pararla es solo pausar la raya
  // (ratón encima, foco dentro o portada fuera de pantalla). Si el visitante elige una, deja de turnarse.
  // Con "reducir movimiento" la raya no se anima y la máquina se queda quieta.
  for (const v of document.querySelectorAll<HTMLElement>('[data-vitrina]')) {
    const tabs = [...v.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const paneles = [...v.querySelectorAll<HTMLElement>('[data-panel]')];
    const fotos = [...v.querySelectorAll<HTMLImageElement>('[data-maquina]')];
    let actual = 0;

    const ir = (n: number, foco = false) => {
      const i = (n + tabs.length) % tabs.length;
      if (i === actual) return;
      actual = i;
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i));
        t.tabIndex = j === i ? 0 : -1;
      });
      paneles.forEach((p, j) => {
        p.classList.toggle('on', j === i);
        p.inert = j !== i;
      });
      fotos.forEach((f, j) => f.classList.toggle('on', j === i));
      if (foco) tabs[i].focus();
    };
    const elegir = (n: number, foco = false) => {
      v.classList.add('manual');
      ir(n, foco);
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => elegir(i));
      t.addEventListener('animationend', () => {
        if (!v.classList.contains('manual')) ir(actual + 1);
      });
      t.addEventListener('keydown', (e) => {
        const paso = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
        if (paso) {
          e.preventDefault();
          elegir(actual + paso, true);
        }
      });
    });

    // En móvil se cambia de máquina deslizando el dedo sobre ella
    const maquinas = v.querySelector<HTMLElement>('[data-maquinas]');
    let x0: number | null = null;
    maquinas?.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    maquinas?.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) elegir(actual + (dx < 0 ? 1 : -1));
    });

    // La raya solo corre mientras la portada se ve
    new IntersectionObserver(([e]) => v.classList.toggle('fuera', !e.isIntersecting), { threshold: 0.4 }).observe(v);

    // Las otras máquinas se descargan cuando la página ya ha terminado de cargar
    const precarga = () => fotos.forEach((f) => (f.loading = 'eager'));
    if (document.readyState === 'complete') precarga();
    else addEventListener('load', precarga, { once: true });
  }
</script>

<style>
  .hero {
    --fondo: #e9ebec;
    --cambio: 0.8s;
    --turno: 6s;
    position: relative;
    overflow: hidden;
    background: var(--fondo);
  }

  /* Escritorio: arriba la escena (titular gigante y máquina delante), debajo tres columnas:
     presentación y botones · cifras de la máquina · selector. Las cuatro razones, arriba a la derecha. */
  .cartel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: minmax(0, 1fr) auto;
    grid-template-areas:
      'escena escena'
      'intro equipo';
    column-gap: clamp(32px, 5vw, 80px);
    min-height: min(calc(100svh - 96px), 900px);
    padding-bottom: clamp(32px, 5vh, 56px);
  }

  .escena {
    grid-area: escena;
    position: relative;
    min-height: 420px;
    container-type: inline-size;
  }
  h1 {
    position: relative;
    z-index: 0;
    padding-top: clamp(40px, 7vh, 72px);
    line-height: 0.82;
    letter-spacing: -0.02em;
  }
  .previo {
    display: block;
    font-weight: 300;
    font-size: clamp(32px, 4.4cqi, 60px);
    line-height: 1;
    letter-spacing: -0.01em;
    margin-bottom: 0.3em;
  }
  /* La palabra ocupa todo el ancho de la retícula, sea cual sea la pantalla */
  .palabra {
    display: block;
    font-weight: 700;
    font-size: 17.2cqi;
    white-space: nowrap;
    color: var(--ink);
  }
  .palabra i {
    font-style: normal;
    color: var(--red);
  }

  /* La máquina se planta delante de la palabra, apoyada en el suelo de la escena */
  .maquinas {
    position: absolute;
    z-index: 1;
    left: 30%;
    right: 0;
    top: 20%;
    bottom: 0;
    touch-action: pan-y;
  }
  /* Todas a escala entre sí: la altura de cada foto es proporcional a la altura real del equipo */
  .maquina {
    position: absolute;
    left: 50%;
    bottom: 0;
    height: calc(var(--h) * 100%);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom;
    translate: -50% 0;
    filter: drop-shadow(0 16px 10px rgba(30, 34, 38, 0.2));
    user-select: none;
  }

  /* Las cuatro razones para fiarse, en una línea arriba a la derecha, a la altura de "Expertos en" */
  .cifras {
    position: absolute;
    top: clamp(40px, 7vh, 72px);
    right: var(--gut);
    display: flex;
    gap: clamp(16px, 2vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.2;
    color: var(--body);
  }
  .cifras li {
    display: flex;
    flex-direction: column;
  }
  .cifras b {
    font-size: clamp(18px, 1.5vw, 22px);
    color: var(--ink);
    white-space: nowrap;
  }

  .intro {
    grid-area: intro;
    padding-top: clamp(24px, 4vh, 40px);
  }
  .lead {
    font-size: var(--t-sub);
    max-width: 36ch;
    color: var(--body);
  }
  .ctas {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ctas .btn::after {
    content: '»';
    color: var(--red);
    transition: transform 0.25s var(--ease);
  }
  .ctas .btn.red::after {
    color: #fff;
  }
  .ctas .btn:hover::after {
    transform: translateX(5px);
  }
  .ctas .btn.ghost {
    background: transparent;
  }

  /* Cifras de la máquina que se ve y, debajo, el selector */
  .equipo {
    grid-area: equipo;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: clamp(24px, 4vh, 40px);
  }
  .fichas {
    display: grid;
  }
  .ficha {
    grid-area: 1 / 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .ficha dl {
    margin: 0;
    display: flex;
    gap: clamp(20px, 3vw, 44px);
  }
  .ficha dt {
    font-weight: 700;
    font-size: clamp(20px, 1.7vw, 26px);
    line-height: 1.1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .ficha dd {
    margin: 2px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  .ficha .arrow {
    white-space: nowrap;
  }

  /* Selector: los nombres bajo una raya fina; la raya de la activa se llena de rojo mientras le toca */
  .selector {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    margin-top: 24px;
  }
  .selector button {
    position: relative;
    padding: 12px 0 0;
    border: 0;
    border-top: 2px solid rgba(26, 26, 26, 0.14);
    background: none;
    font: inherit;
    font-size: 16px;
    text-align: left;
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.25s var(--ease);
  }
  .selector button::before {
    content: '';
    position: absolute;
    left: 0;
    top: -2px;
    height: 2px;
    width: 100%;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
  }
  .selector button:hover,
  .selector [aria-selected='true'] {
    color: var(--ink);
  }
  .selector [aria-selected='true'] {
    font-weight: 700;
  }
  .selector [aria-selected='true']::before {
    transform: scaleX(1);
  }

  /* Cambio de máquina: la que se va sale hacia la izquierda y la nueva entra desde la derecha */
  .ficha,
  .maquina {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--cambio) var(--ease),
      transform var(--cambio) var(--ease),
      visibility 0s linear var(--cambio);
  }
  .ficha {
    transform: translateY(8px);
  }
  .maquina {
    transform: translateX(-56px);
  }
  .ficha.on,
  .maquina.on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0.1s, 0.1s, 0s;
  }

  .why {
    grid-column: 1 / -1;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Cuenta atrás de cada máquina en su raya roja; se pausa con el ratón encima, el foco dentro o fuera de pantalla */
    .hero:not(.manual) .selector [aria-selected='true']::before {
      animation: turno var(--turno) linear both;
    }
    .hero:has(.equipo:hover, .maquinas:hover) .selector [aria-selected='true']::before,
    .hero:focus-within .selector [aria-selected='true']::before,
    .hero.fuera .selector [aria-selected='true']::before {
      animation-play-state: paused;
    }
    .maquina.on {
      animation: entra-maquina var(--cambio) var(--ease) 0.1s both;
    }

    /* Entrada al cargar: la palabra sube, la máquina llega desde la derecha y el resto aparece después */
    .previo,
    .palabra {
      animation: sube 0.9s var(--ease) both;
    }
    .palabra {
      animation-delay: 0.08s;
    }
    .maquinas {
      animation: llega 1.1s var(--ease) 0.25s both;
    }
    .cifras,
    .intro,
    .equipo {
      animation: sube 0.7s var(--ease) 0.45s both;
    }
  }
  @keyframes turno {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes entra-maquina {
    from {
      opacity: 0;
      transform: translateX(56px);
    }
  }
  @keyframes llega {
    from {
      opacity: 0;
      transform: translateX(80px);
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* Pantallas medianas: las razones bajan junto a los botones para no chocar con el titular */
  @media (max-width: 1220px) {
    .cifras {
      position: static;
      grid-column: 1 / -1;
      order: 3;
      margin-top: 32px;
      padding-top: 20px;
      border-top: 1px solid rgba(26, 26, 26, 0.14);
    }
    .cartel {
      grid-template-areas:
        'escena escena'
        'intro equipo'
        'cifras cifras';
      grid-template-rows: minmax(0, 1fr) auto auto;
    }
    .cifras {
      grid-area: cifras;
    }
  }

  /* Tableta y móvil: todo en una columna. Palabra, máquina, presentación, la máquina en cifras y las razones */
  @media (max-width: 1024px) {
    .cartel {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas:
        'escena'
        'selector'
        'intro'
        'fichas'
        'cifras';
      min-height: 0;
    }
    /* En móvil el selector va justo debajo de la máquina, y sus cifras después de los botones */
    .equipo {
      display: contents;
    }
    .selector {
      grid-area: selector;
    }
    .fichas {
      grid-area: fichas;
      padding-top: 36px;
    }
    .escena {
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    h1 {
      padding-top: 32px;
    }
    .previo {
      font-size: clamp(26px, 7cqi, 44px);
    }
    .maquinas {
      position: relative;
      left: auto;
      top: auto;
      height: clamp(240px, 70cqi, 460px);
      margin-top: calc(-1 * clamp(28px, 8cqi, 64px));
    }
    .intro {
      padding-top: 28px;
    }
    .ficha {
      flex-direction: column;
      align-items: flex-start;
    }
    .ficha dl {
      display: grid;
      grid-template-columns: repeat(2, auto);
      justify-content: start;
      gap: 14px 40px;
    }
    /* El selector se desliza de lado si no cabe */
    .selector {
      display: flex;
      gap: 18px;
      margin-inline: calc(var(--gut) * -1);
      padding-inline: var(--gut);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .selector::-webkit-scrollbar {
      display: none;
    }
    .selector button {
      flex: none;
      min-width: 108px;
    }
    .cifras {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px 24px;
    }
  }
</style>
