---
// Portada: una sola composición. La Digicen 22, enorme, entra desde la derecha y pasa por debajo del menú;
// el titular la pisa por delante. Solo marca y producto: el resto de argumentos va más abajo.
// La máquina ocupa el hueco del futuro modelo 3D: el visor irá en este mismo sitio.

// Catálogo General 2025, Serie Digicen 22 (pág. 52)
const equipo = { nombre: 'Digicen 22', datos: ['16.500 rpm', '26.480 × g'] };
---

<section class="hero">
  <img
    class="maquina"
    src="/img/productos/digicen-22.webp"
    srcset="/img/productos/digicen-22.webp 1400w, /img/productos/digicen-22-2200.webp 2200w"
    sizes="(max-width: 1024px) 118vw, 60vw"
    alt="Centrífuga Digicen 22 con la tapa abierta y el rotor a la vista"
    width="1400"
    height="1830"
    fetchpriority="high"
  />

  <div class="wrap lienzo">
    <p class="eyebrow">Centrifugación de laboratorio · Desde 1949</p>

    <h1 aria-label="Expertos en centrifugación">
      <span class="ligera" aria-hidden="true">
        Expertos en
      </span>
      <span class="grande" aria-hidden="true">
        centrifu
      </span>
      <span class="grande" aria-hidden="true">
        ga<i>ción</i>
      </span>
    </h1>

    <div class="pie">
      <p class="lead">
        Centrífugas diseñadas y fabricadas para ofrecer precisión, fiabilidad y rendimiento en los entornos de
        laboratorio más exigentes.
      </p>
      <div class="ctas">
        <a class="cta principal" href="#gama">
          Ver la gama
        </a>
        <a class="cta" href="#distribuidores">
          Soy distribuidor
        </a>
      </div>
    </div>

    <div class="sello">
      <a class="dato" href="#gama">
        <b>{equipo.nombre}</b>
        {equipo.datos.map((d) => (
          <span>{d}</span>
        ))}
      </a>
      <figure class="fabrica">
        <img
          src="/img/empresa/fabrica-daganzo.webp"
          alt="Fábrica de Orto Alresa en Daganzo (Madrid)"
          width="900"
          height="600"
        />
        <figcaption>Fabricadas en Daganzo, Madrid</figcaption>
      </figure>
    </div>

    <p class="why">
      <b>Antes:</b> texto a un lado y la máquina dentro de un recuadro al otro, con cifras en fila como un catálogo.
      <b>Ahora:</b> una sola composición: la Digicen 22 enorme, pasando bajo el menú, y el titular por delante. Solo
      marca, producto y dos caminos.
    </p>
  </div>
</section>

<style>
  .hero {
    --alto: clamp(560px, calc(100svh - 96px), 980px);
    position: relative;
    min-height: var(--alto);
    overflow: hidden;
    background: #fff;
    isolation: isolate;
  }

  /* La máquina: más alta que la portada, recortada por arriba (pasa bajo el menú) y algo por la derecha.
     Empieza pasada la mitad e invade el centro. Sin caja ni fondo: es la foto recortada sobre blanco. */
  .maquina {
    position: absolute;
    z-index: 0;
    right: -4vw;
    bottom: 3vh;
    height: calc(var(--alto) * 1.28);
    width: auto;
    max-width: none;
    pointer-events: none;
    filter: drop-shadow(0 20px 18px rgba(0, 0, 0, 0.12));
  }

  .lienzo {
    position: relative;
    z-index: 1;
    min-height: var(--alto);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    padding-block: clamp(32px, 6vh, 64px);
  }

  .eyebrow {
    margin: 0;
    color: var(--body);
  }

  /* Titular: "Expertos en" pequeño y ligero; "centrifugación" partida en dos líneas enormes que
     pisan la máquina por delante */
  h1 {
    margin-top: clamp(16px, 3vh, 32px);
    line-height: 0.8;
  }
  h1 span {
    display: block;
  }
  .ligera {
    font-weight: 300;
    font-size: clamp(28px, 2.8vw, 44px);
    line-height: 1;
    margin-bottom: 0.25em;
    padding-left: 0.08em;
  }
  .grande {
    font-weight: 700;
    font-size: min(12.4vw, 21vh, 190px);
    letter-spacing: -0.035em;
  }
  /* La segunda línea entra un poco: rompe la columna */
  .grande + .grande {
    padding-left: 0.62em;
  }
  h1 i {
    font-style: normal;
    color: var(--red);
  }

  .pie {
    grid-row: 4;
    max-width: 380px;
  }
  .lead {
    margin: 0;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.5;
    color: var(--body);
  }
  .ctas {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
  }
  /* Botones: uno rojo, alto y limpio; el otro solo texto con raya que crece al pasar el ratón */
  .cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--ink);
    padding-block: 6px;
  }
  .cta::after {
    content: '→';
    font-weight: 300;
    transition: transform 0.3s var(--ease);
  }
  .cta:not(.principal)::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(0.35);
    transition: transform 0.35s var(--ease);
  }
  .cta:not(.principal):hover::before,
  .cta:not(.principal):focus-visible::before {
    transform: scaleX(1);
  }
  .principal {
    background: var(--red);
    color: #fff;
    padding: 18px 28px;
    transition: background 0.2s var(--ease);
  }
  .principal:hover {
    background: var(--red-d);
  }
  .cta:hover::after,
  .cta:focus-visible::after {
    transform: translateX(6px);
  }

  /* Un solo dato de la máquina, pequeño, junto a su pie */
  /* Junto al pie de la máquina: su dato y, debajo, la fábrica donde se hace, en pequeño y
     pisando la máquina por delante */
  .sello {
    position: absolute;
    left: calc(50% - 150px);
    bottom: clamp(32px, 6vh, 64px);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .fabrica {
    margin: 0;
    width: clamp(180px, 16vw, 260px);
  }
  .fabrica img {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.45);
  }
  .fabrica figcaption {
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .dato {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 15px;
    color: var(--muted);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .dato b {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    color: var(--ink);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .dato b::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--red);
  }
  .dato:hover b {
    color: var(--red);
  }

  .why {
    position: absolute;
    left: var(--gut);
    bottom: 8px;
    margin: 0;
  }

  /* Portátiles estrechos: la máquina algo más a la derecha para que no choque con el titular,
     y su dato fuera (no cabe sin pisarla); la fábrica se queda */
  @media (min-width: 1025px) and (max-width: 1279px) {
    .maquina {
      right: -12vw;
    }
    .sello {
      left: calc(50% - 30px);
    }
    .fabrica {
      width: 170px;
    }
    .dato {
      display: none;
    }
  }

  /* Tableta y móvil: eyebrow, titular, frase y botones; debajo la máquina enorme, saliéndose por la
     derecha, y su dato */
  @media (max-width: 1024px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding-top: clamp(28px, 5vw, 48px);
    }
    .lienzo {
      display: contents;
    }
    .lienzo > * {
      padding-inline: var(--gut);
    }
    .eyebrow {
      font-size: 12px;
      letter-spacing: 0.08em;
    }
    .grande {
      font-size: min(23vw, 190px);
    }
    .pie {
      margin-top: 28px;
      max-width: calc(520px + 2 * var(--gut));
    }
    .maquina {
      order: 1;
      position: relative;
      right: auto;
      bottom: auto;
      height: auto;
      width: min(118vw, 820px);
      margin: 8px 0 0 auto;
      translate: 14% 0;
    }
    .sello {
      order: 2;
      position: static;
      padding-block: 8px 32px;
    }
    .fabrica {
      margin-top: 20px;
      width: min(100%, 360px);
    }
    .dato {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 16px;
    }
    .dato b {
      margin: 0;
    }
    .why {
      order: 3;
      position: static;
      margin: 0 var(--gut) 24px;
      padding: 14px 18px;
    }
  }

  /* Entrada: el titular sube por líneas y la máquina aparece subiendo despacio */
  @media (prefers-reduced-motion: no-preference) {
    .eyebrow,
    h1 span,
    .pie,
    .sello {
      animation: sube 0.8s var(--ease) both;
    }
    h1 span:nth-child(1) {
      animation-delay: 0.08s;
    }
    h1 span:nth-child(2) {
      animation-delay: 0.16s;
    }
    h1 span:nth-child(3) {
      animation-delay: 0.24s;
    }
    .pie {
      animation-delay: 0.4s;
    }
    .sello {
      animation-delay: 0.9s;
    }
    .maquina {
      animation: entra 1.4s var(--ease) 0.1s both;
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }
</style>
