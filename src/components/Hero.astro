---
// Portada: un rotor girando a toda velocidad, con estelas rojas y el buje nítido, a pantalla completa (foto de Orto Alresa), con el titular, quiénes sois, los dos caminos
// (producto y distribuidor) y las cuatro razones para fiarse encima, cada una con su icono. Al cargar, la foto se
// aclara y se asienta despacio; nada sigue al ratón.
import { cifras } from '../data/cifras';
---

<section class="hero" data-hero>
  <div class="fondo" aria-hidden="true">
    <img
      class="foto"
      src="/img/fotos/portada-rotor.webp"
      srcset="/img/fotos/portada-rotor-960.webp 960w, /img/fotos/portada-rotor.webp 1440w"
      sizes="100vw"
      alt=""
      width="1440"
      height="960"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="wrap contenido">
    <div class="texto">
      <h1>
        Expertos en{' '}
        <b>
          centrifuga<i>ción</i>
        </b>
      </h1>
      <p class="lead">
        Desde 1949 diseñamos y fabricamos centrífugas de laboratorio en Daganzo (Madrid) y las llevamos a todo el mundo
        a través de una red de distribuidores especializados.
      </p>
      <div class="ctas">
        <a class="btn red" href="#gama">
          Ver la gama
        </a>
        <a class="btn ghost" href="#distribuidores">
          Soy distribuidor
        </a>
      </div>
    </div>

    <ul class="cifras v-a">
      {cifras.map((c) => (
        <li>
          <span class="ico">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {c.icono === 'reloj' && (
                <>
                  <circle cx="12" cy="12" r="9" />
                  <g class="mueve">
                    <path d="M12 12V6.5M12 12l3.5 2" />
                  </g>
                </>
              )}
              {c.icono === 'camion' && (
                <g class="mueve">
                  <path d="M2.5 6.5h10.5v9.5H2.5zM13 9.5h4l3.5 3.5v3H13" />
                  <circle cx="6.5" cy="17.5" r="1.8" />
                  <circle cx="16.5" cy="17.5" r="1.8" />
                </g>
              )}
              {c.icono === 'calendario' && (
                <>
                  <rect x="3" y="5" width="18" height="16" rx="1.5" />
                  <path d="M3 10h18M8 3v4M16 3v4" />
                  <path class="traza" d="M8.5 15.5l2.5 2.5 4.5-4.5" />
                </>
              )}
              {c.icono === 'sello' && (
                <>
                  <g class="mueve">
                    <circle cx="12" cy="10" r="6.5" />
                  </g>
                  <path d="M8.3 15.4 7 21.5l5-2.2 5 2.2-1.3-6.1" />
                  <path class="traza" d="M9.4 10.2l1.8 1.8 3.4-3.6" />
                </>
              )}
            </svg>
          </span>
          <b>{c.valor}</b>
          <span class="txt">{c.texto}</span>
        </li>
      ))}
    </ul>

    <p class="why">
      <b>Antes:</b> un carrusel de 7 novedades, con el titular cortado bajo el menú. <b>Ahora:</b> una sola foto real de
      laboratorio a pantalla completa, con el titular, los dos caminos y las cuatro razones para fiarse encima. Sin
      cajas ni recortes: entra por la vista y se entiende en un segundo.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #111315;
    color: #fff;
    isolation: isolate;
  }

  /* Fondo: el rotor desde arriba; el buje y los tubos quedan a la derecha y el texto va sobre los guantes de la izquierda */
  .fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 45%;
    transform-origin: 66% 47%;
  }
  /* Velo oscuro donde va el texto, para que se lea; el buje y la derecha quedan limpios */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(10, 11, 12, 0.88) 0%, rgba(10, 11, 12, 0.66) 38%, rgba(10, 11, 12, 0.08) 72%),
      linear-gradient(0deg, rgba(10, 11, 12, 0.7) 0%, rgba(10, 11, 12, 0) 34%);
  }

  .contenido {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: min(calc(100svh - 96px), 880px);
    padding-block: clamp(64px, 11vh, 120px) clamp(32px, 5vh, 48px);
  }
  h1 {
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.94;
  }
  h1 b {
    display: block;
  }
  h1 i {
    font-style: normal;
    color: var(--red);
  }
  .lead {
    margin-top: clamp(22px, 3vh, 32px);
    font-size: var(--t-sub);
    max-width: 36ch;
    color: rgba(255, 255, 255, 0.84);
  }

  /* Botones: al pasar el ratón cruza un destello, el rojo se vuelve cristal y la » avanza; el blanco se rellena de izquierda a derecha */
  .ctas {
    margin-top: clamp(28px, 4vh, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ctas .btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition:
      color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      background-color 0.35s var(--ease),
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .ctas .btn::after {
    content: '»';
    transition: transform 0.35s var(--ease);
  }
  .ctas .btn:hover {
    transform: translateY(-2px);
  }
  .ctas .btn:hover::after {
    transform: translateX(6px);
  }
  /* "Ver la gama" se vuelve cristal rojo: se transparenta la foto, con brillo en el borde de arriba */
  .ctas .btn.red:hover {
    background: rgba(221, 4, 10, 0.62);
    border-color: rgba(255, 255, 255, 0.28);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    backdrop-filter: blur(12px) saturate(160%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 14px 32px -12px rgba(221, 4, 10, 0.7);
  }
  .ctas .btn.red::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.35) 50%, transparent 70%);
    translate: -110% 0;
  }
  .ctas .btn.red:hover::before {
    translate: 110% 0;
    transition: translate 0.7s var(--ease);
  }
  .ctas .btn.ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.06);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .ctas .btn.ghost::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .ctas .btn.ghost:hover {
    color: var(--ink);
    border-color: #fff;
    background: transparent;
  }
  .ctas .btn.ghost:hover::before {
    transform: scaleX(1);
  }

  /* Las cuatro razones al pie, cada una con su icono dibujado a mano. Al pasar el ratón, la raya roja de la web crece
     encima, la tarjeta sube y el icono se mueve: el reloj da la vuelta, el camión arranca y el visto se dibuja */
  .cifras {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.72);
  }
  .cifras li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 16px;
    align-items: center;
    padding: 18px 20px;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      background-color 0.35s var(--ease),
      color 0.3s var(--ease);
  }
  .cifras b {
    align-self: end;
    font-size: clamp(20px, 1.8vw, 28px);
    line-height: 1.1;
    color: #fff;
    white-space: nowrap;
  }
  .cifras .txt {
    align-self: start;
  }
  .ico {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
  }
  .ico svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .ico .mueve {
    transform-box: view-box;
    transform-origin: 12px 12px;
  }
  .ico .traza {
    stroke-dasharray: 12;
  }
  .cifras li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    height: 3px;
    width: 0;
    background: var(--red);
    transition: width 0.4s var(--ease);
  }
  .cifras li::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 18px;
    height: 18px;
    background: rgba(255, 255, 255, 0.22);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
    transition: background 0.3s var(--ease);
  }
  .cifras li:hover {
    color: #fff;
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -20px rgba(0, 0, 0, 0.8);
  }
  .cifras li:hover::before {
    width: calc(100% + 2px);
  }
  .cifras li:hover::after {
    background: var(--red);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cifras li:nth-child(1):hover .mueve {
      animation: vuelta 1.1s var(--ease);
    }
    .cifras li:nth-child(2):hover .mueve {
      animation: arranca 0.9s var(--ease);
    }
    .cifras li:nth-child(4):hover .mueve {
      animation: late 0.6s var(--ease);
    }
    .cifras li:hover .traza {
      animation: traza 0.6s 0.1s var(--ease) both;
    }
  }
  @keyframes vuelta {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes arranca {
    30% {
      transform: translateX(-2px);
    }
    65% {
      transform: translateX(4px);
    }
  }
  @keyframes late {
    50% {
      transform: scale(1.12);
    }
  }
  @keyframes traza {
    from {
      stroke-dashoffset: 12;
    }
  }

  /* A · Cristal: placas esmeriladas sobre la foto, icono en círculo rojo */
  .v-a li {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .v-a li:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .v-a .ico {
    border-radius: 50%;
    background: var(--red);
    color: #fff;
  }

  /* B · Línea: sin cajas, sobre una línea fina, con el icono en rojo encima de cada cifra */
  .v-b {
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }
  .v-b li {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    row-gap: 2px;
    padding: 22px clamp(20px, 3vw, 40px) 4px;
  }
  .v-b li:first-child {
    padding-left: 0;
  }
  .v-b li + li {
    border-left: 1px solid rgba(255, 255, 255, 0.22);
  }
  .v-b li::after {
    display: none;
  }
  .v-b li:hover {
    box-shadow: none;
  }
  .v-b .ico {
    grid-row: auto;
    width: auto;
    height: auto;
    justify-content: start;
    margin-bottom: 10px;
    color: var(--red);
  }
  .v-b .ico svg {
    width: 30px;
    height: 30px;
  }

  /* C · Tarjeta: las tarjetas oscuras de la web, borde de 2 px, esquina que se vuelve roja */
  .v-c li {
    background: rgba(22, 25, 28, 0.86);
    border: 2px solid #3b4045;
  }
  .v-c li::before {
    top: -2px;
    left: -2px;
    height: 4px;
  }
  .v-c li::after {
    width: 22px;
    height: 22px;
    background: #3b4045;
  }
  .v-c li:hover::before {
    width: calc(100% + 4px);
  }
  .v-c .ico {
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--red);
  }

  /* Entrada: la foto se aclara y se asienta despacio, sin sacudidas; el texto se descubre línea a línea desde abajo */
  @media (prefers-reduced-motion: no-preference) {
    .foto {
      animation: asienta 2.4s cubic-bezier(0.22, 0.7, 0.2, 1) both;
    }
    .texto > *,
    .cifras {
      animation: sube 0.9s var(--ease) both;
    }
    h1 {
      animation-name: descubre;
    }
    .texto > :nth-child(2) {
      animation-delay: 0.25s;
    }
    .texto > :nth-child(3) {
      animation-delay: 0.38s;
    }
    .cifras {
      animation-delay: 0.55s;
    }
  }
  @keyframes asienta {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    40% {
      opacity: 1;
    }
  }
  @keyframes descubre {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(24px);
    }
    to {
      clip-path: inset(0 0 -10% 0);
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* Móvil: la foto ocupa la mitad de arriba, con el buje a la vista, y se funde con el fondo oscuro del texto */
  @media (max-width: 1024px) {
    .foto {
      inset: 0;
      width: 100%;
      height: 58%;
      object-position: 82% 50%;
    }
    .hero::before {
      background: linear-gradient(0deg, #111315 0%, #111315 44%, rgba(17, 19, 21, 0.5) 54%, rgba(17, 19, 21, 0) 74%);
    }
    .contenido {
      min-height: calc(100svh - 72px);
      justify-content: flex-end;
      padding-block: 46svh 32px;
    }
    .cifras {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 36px;
    }
    .cifras li {
      column-gap: 12px;
      padding: 14px;
    }
    .ico {
      width: 40px;
      height: 40px;
    }
    .ico svg {
      width: 22px;
      height: 22px;
    }
    .cifras b {
      font-size: 20px;
    }
    .cifras .txt {
      font-size: 13px;
    }
    .v-b {
      gap: 0;
    }
    .v-b li {
      padding: 18px 14px 6px;
    }
    .v-b li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
