---
// Portada: un rotor girando a toda velocidad, con estelas rojas y el buje nítido, a pantalla completa (foto de Orto Alresa), con el titular, quiénes sois, los dos caminos
// (producto y distribuidor) y las cuatro razones para fiarse encima, cada una con su icono de la marca. Al cargar, la foto se
// aclara y se asienta despacio; nada sigue al ratón.
import { cifras } from '../data/cifras';
import { idioma, ruta, textos } from '../i18n';

const lang = idioma(Astro.currentLocale);
const t = textos(lang).hero;
---

<section class="hero" data-hero>
  <div class="fondo" aria-hidden="true">
    <img
      class="foto"
      src="/img/fotos/portada-rotor.webp"
      srcset="/img/fotos/portada-rotor-960.webp 960w, /img/fotos/portada-rotor.webp 1440w"
      sizes="100vw"
      alt=""
      width="1440"
      height="960"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="wrap contenido">
    <div class="texto">
      <h1>
        {t.titulo[0]}
        <b>
          {t.titulo[1]}
          <i>{t.titulo[2]}</i>
        </b>
      </h1>
      <p class="lead">{t.lead}</p>
      <div class="ctas">
        <a class="btn red" href={ruta(lang, '/centrifugas/')}>
          {t.gama}
        </a>
        <a class="btn ghost" href="#distribuidores">
          {t.distribuidor}
        </a>
      </div>
    </div>

    <ul class="cifras">
      {cifras.map((c) => (
        <li>
          <span class="ico">
            <i style={`--ico: url(/img/iconos/${c.icono}.svg)`} />
          </span>
          <b>{t.cifras[c.clave].valor}</b>
          <span class="txt">{t.cifras[c.clave].texto}</span>
          <span class="luz" aria-hidden="true" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #111315;
    color: #fff;
    isolation: isolate;
  }

  /* Fondo: el rotor desde arriba; el buje y los tubos quedan a la derecha y el texto va sobre los guantes de la izquierda */
  .fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 45%;
    transform-origin: 66% 47%;
  }
  /* Velo oscuro donde va el texto, para que se lea; el buje y la derecha quedan limpios */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(10, 11, 12, 0.88) 0%, rgba(10, 11, 12, 0.66) 38%, rgba(10, 11, 12, 0.08) 72%),
      linear-gradient(0deg, rgba(10, 11, 12, 0.7) 0%, rgba(10, 11, 12, 0) 34%);
  }

  .contenido {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: min(calc(100svh - 96px), 880px);
    padding-block: clamp(64px, 11vh, 120px) clamp(32px, 5vh, 48px);
  }
  h1 {
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.94;
  }
  h1 b {
    display: block;
  }
  h1 i {
    font-style: normal;
    color: var(--red);
  }
  .lead {
    margin-top: clamp(22px, 3vh, 32px);
    font-size: var(--t-sub);
    max-width: 36ch;
    color: rgba(255, 255, 255, 0.84);
  }

  /* Botones: al pasar el ratón cruza un destello, el rojo se vuelve cristal y la » avanza; el blanco se rellena de izquierda a derecha */
  .ctas {
    margin-top: clamp(28px, 4vh, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ctas .btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition:
      color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      background-color 0.35s var(--ease),
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .ctas .btn::after {
    content: '»';
    transition: transform 0.35s var(--ease);
  }
  /* "Ver la gama" se vuelve cristal rojo: se transparenta la foto, con brillo en el borde de arriba */
  .ctas .btn.red::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.35) 50%, transparent 70%);
    translate: -110% 0;
  }
  .ctas .btn.ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.06);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .ctas .btn.ghost::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }

  /* Las cuatro razones al pie, cada una con un icono de la marca. Al pasar el ratón, la raya roja de la web crece
     encima, la tarjeta sube y el icono da un pequeño salto */
  .cifras {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.72);
  }
  .cifras li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 16px;
    align-items: center;
    padding: 18px 20px;
  }
  .cifras b {
    align-self: end;
    font-size: clamp(20px, 1.8vw, 28px);
    line-height: 1.1;
    color: #fff;
    white-space: nowrap;
  }
  .cifras .txt {
    align-self: start;
  }
  .ico {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    transition: box-shadow 0.45s var(--ease);
  }
  /* Iconos de la marca (los de la web actual), recortados en blanco sobre el círculo rojo */
  .ico i {
    width: 26px;
    height: 26px;
    background: currentColor;
    -webkit-mask: var(--ico) center / contain no-repeat;
    mask: var(--ico) center / contain no-repeat;
  }
  .cifras li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    height: 3px;
    width: 0;
    background: var(--red);
    transition: width 0.4s var(--ease);
  }
  .cifras li::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 18px;
    height: 18px;
    background: rgba(255, 255, 255, 0.22);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
    transition: background 0.3s var(--ease);
  }
  @keyframes late {
    40% {
      transform: scale(1.14) rotate(-6deg);
    }
    70% {
      transform: scale(0.96) rotate(2deg);
    }
  }

  /* Placas de cristal esmerilado sobre la foto, con el icono en un círculo rojo. Al pasar el ratón cruza un destello
     de luz, como en "Ver la gama", y el borde y el icono se encienden con un rojo neón muy suave */
  .cifras li {
    overflow: hidden;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.45s var(--ease),
      border-color 0.45s var(--ease),
      color 0.3s var(--ease);
  }
  .luz {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.2) 50%, transparent 70%);
    translate: -110% 0;
    pointer-events: none;
  }

  /* Los efectos al pasar el ratón, solo con ratón: en el móvil un toque no deja la tarjeta encendida */
  @media (hover: hover) {
    .ctas .btn:hover {
      transform: translateY(-2px);
    }
    .ctas .btn:hover::after {
      transform: translateX(6px);
    }
    .ctas .btn.red:hover {
      background: rgba(221, 4, 10, 0.62);
      border-color: rgba(255, 255, 255, 0.28);
      -webkit-backdrop-filter: blur(12px) saturate(160%);
      backdrop-filter: blur(12px) saturate(160%);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.35),
        0 0 22px -4px rgba(255, 40, 40, 0.55),
        0 14px 32px -12px rgba(221, 4, 10, 0.7);
    }
    .ctas .btn.red:hover::before {
      translate: 110% 0;
      transition: translate 0.7s var(--ease);
    }
    .ctas .btn.ghost:hover {
      color: var(--ink);
      border-color: #fff;
      background: transparent;
    }
    .ctas .btn.ghost:hover::before {
      transform: scaleX(1);
    }
    .cifras li:hover {
      color: #fff;
      transform: translateY(-4px);
      border-color: rgba(255, 64, 64, 0.5);
      box-shadow:
        0 0 22px -6px rgba(221, 4, 10, 0.55),
        inset 0 0 18px -10px rgba(255, 64, 64, 0.5),
        0 18px 36px -20px rgba(0, 0, 0, 0.8);
    }
    .cifras li:hover::before {
      width: calc(100% + 2px);
    }
    .cifras li:hover::after {
      background: var(--red);
    }
    .cifras li:hover .ico {
      box-shadow: 0 0 16px -2px rgba(255, 40, 40, 0.6);
    }
  }
  /* El destello y el movimiento de los iconos, solo si no se pide menos movimiento */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .cifras li:hover .luz {
      translate: 110% 0;
      transition: translate 0.9s var(--ease);
    }
    .cifras li:hover .ico i {
      animation: late 0.6s var(--ease);
    }
  }

  /* Entrada: la foto se aclara y se asienta despacio, sin sacudidas; el texto se descubre línea a línea desde abajo */
  @media (prefers-reduced-motion: no-preference) {
    .foto {
      animation: asienta 2.4s cubic-bezier(0.22, 0.7, 0.2, 1) both;
    }
    .texto > *,
    .cifras {
      animation: sube 0.9s var(--ease) both;
    }
    h1 {
      animation-name: descubre;
    }
    .texto > :nth-child(2) {
      animation-delay: 0.25s;
    }
    .texto > :nth-child(3) {
      animation-delay: 0.38s;
    }
    .cifras {
      animation-delay: 0.55s;
    }
  }
  @keyframes asienta {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    25% {
      opacity: 1;
    }
  }
  @keyframes descubre {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(24px);
    }
    to {
      clip-path: inset(0 0 -10% 0);
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* Móvil: la foto ocupa la mitad de arriba, con el buje a la vista, y se funde con el fondo oscuro del texto */
  @media (max-width: 1024px) {
    .foto {
      inset: 0;
      width: 100%;
      height: 58%;
      object-position: 82% 50%;
    }
    .hero::before {
      background: linear-gradient(0deg, #111315 0%, #111315 44%, rgba(17, 19, 21, 0.5) 54%, rgba(17, 19, 21, 0) 74%);
    }
    .contenido {
      min-height: calc(100svh - 72px);
      justify-content: flex-end;
      padding-block: 46svh 32px;
    }
    .cifras {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 36px;
    }
    .cifras li {
      column-gap: 12px;
      padding: 14px;
    }
    .ico {
      width: 40px;
      height: 40px;
    }
    .ico i {
      width: 22px;
      height: 22px;
    }
    .cifras b {
      font-size: 20px;
    }
    .cifras .txt {
      font-size: 13px;
    }
  }
</style>
