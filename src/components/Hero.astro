---
// Portada: manos con guantes cargando tubos en un rotor RT 267, a pantalla completa (foto de Orto Alresa), con el titular, quiénes sois, los dos caminos
// (producto y distribuidor) y las cuatro razones para fiarse encima. Al cargar, la foto gira y frena como un rotor;
// después sigue al ratón con un brillo suave.
import { cifras } from '../data/cifras';
---

<section class="hero" data-hero>
  <div class="fondo" aria-hidden="true">
    <img
      class="foto"
      src="/img/fotos/portada-rotor.webp"
      srcset="/img/fotos/portada-rotor-960.webp 960w, /img/fotos/portada-rotor.webp 1440w"
      sizes="100vw"
      alt=""
      width="1440"
      height="960"
      fetchpriority="high"
      decoding="async"
    />
    <span class="brillo"></span>
  </div>

  <div class="wrap contenido">
    <div class="texto">
      <h1>
        Expertos en{' '}
        <b>
          centrifuga<i>ción</i>
        </b>
      </h1>
      <p class="lead">
        Desde 1949 diseñamos y fabricamos centrífugas de laboratorio en Daganzo (Madrid) y las llevamos a todo el mundo
        a través de una red de distribuidores especializados.
      </p>
      <div class="ctas">
        <a class="btn red" href="#gama">
          Ver la gama
        </a>
        <a class="btn ghost" href="#distribuidores">
          Soy distribuidor
        </a>
      </div>
    </div>

    <ul class="cifras">
      {cifras.map((c) => (
        <li>
          <b>{c.valor}</b>
          {c.texto}
        </li>
      ))}
    </ul>

    <p class="why">
      <b>Antes:</b> un carrusel de 7 novedades, con el titular cortado bajo el menú. <b>Ahora:</b> una sola foto real de
      laboratorio a pantalla completa, con el titular, los dos caminos y las cuatro razones para fiarse encima. Sin
      cajas ni recortes: entra por la vista y se entiende en un segundo.
    </p>
  </div>
</section>

<script>
  // El fondo sigue al ratón: la foto se desplaza unos píxeles y un brillo suave va donde está el puntero.
  // Se suaviza en cada fotograma para que nunca dé saltos. Solo con ratón y si no se pide menos movimiento.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    let x = 0.5;
    let y = 0.5;
    let tx = 0.5;
    let ty = 0.5;
    let raf = 0;
    const paso = () => {
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      hero.style.setProperty('--mx', x.toFixed(4));
      hero.style.setProperty('--my', y.toFixed(4));
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.0005 ? requestAnimationFrame(paso) : 0;
    };
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      tx = (e.clientX - r.left) / r.width;
      ty = (e.clientY - r.top) / r.height;
      hero.classList.add('vivo');
      if (!raf) raf = requestAnimationFrame(paso);
    });
    hero.addEventListener('pointerleave', () => {
      tx = 0.5;
      ty = 0.5;
      hero.classList.remove('vivo');
      if (!raf) raf = requestAnimationFrame(paso);
    });
  }
</script>

<style>
  .hero {
    --mx: 0.5;
    --my: 0.5;
    position: relative;
    overflow: hidden;
    background: #111315;
    color: #fff;
    isolation: isolate;
  }

  /* Fondo: el rotor desde arriba; el buje y los tubos quedan a la derecha y el texto va sobre los guantes de la izquierda */
  .fondo {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .foto {
    position: absolute;
    inset: -24px;
    width: calc(100% + 48px);
    height: calc(100% + 48px);
    max-width: none;
    object-fit: cover;
    object-position: 50% 45%;
    /* Sigue al ratón, como mucho 24 px a cada lado */
    translate: calc((0.5 - var(--mx)) * 48px) calc((0.5 - var(--my)) * 32px);
    transform-origin: 74% 46%;
  }
  /* Brillo que sigue al puntero: ilumina el metal y los tapones rojos al pasar */
  .brillo {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      560px circle at calc(var(--mx) * 100%) calc(var(--my) * 100%),
      rgba(255, 255, 255, 0.16),
      transparent 70%
    );
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .hero.vivo .brillo {
    opacity: 1;
  }
  /* Velo oscuro donde va el texto, para que se lea; el buje y la derecha quedan limpios */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(10, 11, 12, 0.88) 0%, rgba(10, 11, 12, 0.66) 38%, rgba(10, 11, 12, 0.08) 72%),
      linear-gradient(0deg, rgba(10, 11, 12, 0.7) 0%, rgba(10, 11, 12, 0) 34%);
  }

  .contenido {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: min(calc(100svh - 96px), 880px);
    padding-block: clamp(64px, 11vh, 120px) clamp(32px, 5vh, 48px);
  }
  h1 {
    font-weight: 300;
    font-size: var(--t-titulo);
    line-height: 0.94;
  }
  h1 b {
    display: block;
  }
  h1 i {
    font-style: normal;
    color: var(--red);
  }
  .lead {
    margin-top: clamp(22px, 3vh, 32px);
    font-size: var(--t-sub);
    max-width: 36ch;
    color: rgba(255, 255, 255, 0.84);
  }

  /* Botones: al pasar el ratón cruza un destello y la » avanza; el blanco se rellena de izquierda a derecha */
  .ctas {
    margin-top: clamp(28px, 4vh, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ctas .btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition:
      color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      background-color 0.35s var(--ease),
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .ctas .btn::after {
    content: '»';
    transition: transform 0.35s var(--ease);
  }
  .ctas .btn:hover {
    transform: translateY(-2px);
  }
  .ctas .btn:hover::after {
    transform: translateX(6px);
  }
  .ctas .btn.red:hover {
    box-shadow: 0 14px 32px -12px rgba(221, 4, 10, 0.7);
  }
  .ctas .btn.red::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.35) 50%, transparent 70%);
    translate: -110% 0;
  }
  .ctas .btn.red:hover::before {
    translate: 110% 0;
    transition: translate 0.7s var(--ease);
  }
  .ctas .btn.ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
    background: transparent;
  }
  .ctas .btn.ghost::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .ctas .btn.ghost:hover {
    color: var(--ink);
    border-color: #fff;
    background: transparent;
  }
  .ctas .btn.ghost:hover::before {
    transform: scaleX(1);
  }

  /* Las cuatro razones al pie, sobre una línea fina. Al pasar el ratón, la raya roja de la web crece sobre la que se
     señala y la cifra sube un poco */
  .cifras {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 15px;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.7);
  }
  .cifras li {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 24px clamp(20px, 3vw, 48px) 0;
    transition: color 0.3s var(--ease);
  }
  .cifras li:first-child {
    padding-left: 0;
  }
  .cifras li + li::after {
    content: '';
    position: absolute;
    left: 0;
    top: 24px;
    bottom: 0;
    width: 1px;
    background: rgba(255, 255, 255, 0.22);
  }
  .cifras li::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--red);
    transition: width 0.45s var(--ease);
  }
  .cifras b {
    font-size: clamp(20px, 1.8vw, 28px);
    color: #fff;
    white-space: nowrap;
    transition: transform 0.35s var(--ease);
  }
  .cifras li:hover {
    color: #fff;
  }
  .cifras li:hover::before {
    width: 100%;
  }
  .cifras li:hover b {
    transform: translateY(-3px);
  }

  /* Entrada: el rotor llega girando y frena hasta pararse, como al final de un ciclo; el texto se descubre línea a
     línea desde abajo */
  @media (prefers-reduced-motion: no-preference) {
    .foto {
      animation: frena 2.6s cubic-bezier(0.16, 0.84, 0.24, 1) both;
    }
    .texto > *,
    .cifras {
      animation: sube 0.9s var(--ease) both;
    }
    h1 {
      animation-name: descubre;
    }
    .texto > :nth-child(2) {
      animation-delay: 0.25s;
    }
    .texto > :nth-child(3) {
      animation-delay: 0.38s;
    }
    .cifras {
      animation-delay: 0.55s;
    }
  }
  @keyframes frena {
    from {
      transform: rotate(-28deg) scale(1.55);
      filter: blur(6px) brightness(0.6);
    }
    55% {
      filter: blur(0) brightness(1);
    }
    to {
      transform: none;
    }
  }
  @keyframes descubre {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(24px);
    }
    to {
      clip-path: inset(0 0 -10% 0);
    }
  }
  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* Móvil: la foto ocupa la mitad de arriba, con el buje a la vista, y se funde con el fondo oscuro del texto */
  @media (max-width: 1024px) {
    .foto {
      inset: 0;
      width: 100%;
      height: 58%;
      object-position: 100% 50%;
      translate: none;
    }
    .hero::before {
      background: linear-gradient(0deg, #111315 0%, #111315 44%, rgba(17, 19, 21, 0.5) 54%, rgba(17, 19, 21, 0) 74%);
    }
    .contenido {
      min-height: calc(100svh - 72px);
      justify-content: flex-end;
      padding-block: 46svh 32px;
    }
    .cifras {
      grid-template-columns: 1fr 1fr;
      row-gap: 4px;
      margin-top: 36px;
    }
    .cifras li:nth-child(3) {
      padding-left: 0;
    }
    .cifras li:nth-child(3)::after {
      display: none;
    }
  }
</style>
